+void Menu::BuildItems()
+{
+  for (auto& items : m_items)
+    items.clear();
+
+  auto& settings = m_items[static_cast<int>(Category::Settings)];
+  // Emulation settings for every game (each game can have its own: Triangle on it).
+  settings.push_back({"Language", PS4Lang::Current().name, -1, -1, SET_LANGUAGE});
+  const auto& categories = PS4Settings::Categories();
+  constexpr const char* GROUP_HELP[] = {"Picture, resolution, frame rate",
+                                        "Filtering, anti-aliasing, effects",
+                                        "CPU clock, speed features, profiler",
+                                        "Game volume, audio",
+                                        "Logs, freeze reports, profiler - on or off"};
+  for (size_t i = 0; i < categories.size(); i++)
+  {
+    settings.push_back({categories[i], i < std::size(GROUP_HELP) ? GROUP_HELP[i] : "", -1, -1,
+                        SET_GROUP + static_cast<int>(i)});
+  }
+  settings.push_back({"Sound Effects", m_prefs.sounds ? "On" : "Off", -1, -1, SET_SOUNDS});
+  settings.push_back({"Volume", std::to_string(m_prefs.volume), -1, -1, SET_VOLUME});
+  settings.push_back({"Menu Style", StyleName(), -1, -1, SET_STYLE});
+  settings.push_back({"Clock", m_prefs.clock ? "On" : "Off", -1, -1, SET_CLOCK});
+  settings.push_back({"Controls", "Remap the GameCube and Wii buttons", -1, -1, SET_CONTROLS});
+  settings.push_back({"RetroAchievements", "Earn achievements (retroachievements.org)", -1, -1,
+                      SET_ACHIEVEMENTS});
+  settings.push_back({"Wii Menu", "The Wii Menu and the Mii Channel, from Nintendo", -1, -1,
+                      SET_WIIMENU});
+  settings.push_back({"Game Folder", GamesFolder(), -1, -1, SET_GAMES_DIR});
+  settings.push_back({"Network Shares", "Games on a PC or NAS (NFS, SMB)", -1, -1, SET_SHARES});
+  settings.push_back({"Game Settings Center", "Recommended settings per game, from GitHub", -1, -1,
+                      SET_CENTER});
+  settings.push_back({"Download Covers", "Box art from GameTDB for your games", -1, -1,
+                      SET_COVERS});
+  settings.push_back({"Check for Updates", "Installed: v" + m_version, -1, -1, SET_UPDATE_CHECK});
+  settings.push_back({"Automatic Updates", m_prefs.auto_update ? "On" : "Off", -1, -1,
+                      SET_AUTO_UPDATE});
+  settings.push_back({"Reset All Settings", "Every setting back to the defaults", -1, -1,
+                      SET_RESET_ALL});
+  settings.push_back({"About", "", -1, -1, SET_ABOUT});
+
+  auto& games = m_items[static_cast<int>(Category::Games)];
+  // m_games is in title order; the other orders keep it among equals.
+  std::vector<int> order(m_games.size());
+  for (size_t i = 0; i < order.size(); i++)
+    order[i] = static_cast<int>(i);
+  if (m_prefs.sort == "recent")
+  {
+    std::stable_sort(order.begin(), order.end(), [this](int a, int b) {
+      return Played(m_games[a].path) > Played(m_games[b].path);
+    });
+  }
+  else if (m_prefs.sort == "platform")
+  {
+    std::stable_sort(order.begin(), order.end(),
+                     [this](int a, int b) { return !m_games[a].wii && m_games[b].wii; });
+  }
+  for (const int i : order)
+  {
+    const Game& game = m_games[i];
+    std::string detail = game.id;
+    const std::string played = PS4PlayTime::Text(PlayTime(game));
+    if (!played.empty())
+      detail += (detail.empty() ? "" : "  -  ") + played;
+    const std::string achieved = AchievementText(game);
+    if (!achieved.empty())
+      detail += (detail.empty() ? "" : "  -  ") + achieved;
+    if (game.discs > 1)
+      detail += "  -  " + std::to_string(game.discs) + " discs";
+    if (!m_prefs.default_game.empty() && game.path == m_prefs.default_game)
+      detail += "  -  Starts when Dolphin opens";
+    games.push_back({game.title, detail, i, -1, -1});
+  }
+  if (games.empty())
+    games.push_back({"No games found", "Copy games to " + GamesFolder() + ", then press Square"});
+
+  {
+    // Achievements: the account, then every game with a saved list (most recently played first).
+    auto& achievements = m_items[static_cast<int>(Category::Achievements)];
+    const std::string user = RaGet("Username"), token = RaGet("ApiToken");
+    m_ra_user = user;
+    m_ra_logged_in = !token.empty() && !user.empty();
+    achievements.push_back({"RetroAchievements",
+                            token.empty() ? "Not logged in - press Cross to log in" :
+                                            "Logged in as " + user,
+                            -1, -1, SET_ACHIEVEMENTS});
+    std::vector<std::pair<int64_t, Item>> found;
+    for (const std::string& key : PS4Achievements::SavedKeys(m_data_dir))
+    {
+      PS4Achievements::List list;
+      if (!PS4Achievements::Load(m_data_dir, key, &list))
+        continue;
+      std::string title = list.game;
+      for (const Game& game : m_games)
+      {
+        if (PS4Achievements::FileKey(game.id.empty() ? game.title : game.id) == key)
+          title = game.title;
+      }
+      Item item{title.empty() ? key : title,
+                std::to_string(list.unlocked) + " / " + std::to_string(list.total) +
+                    " achievements  -  " + std::to_string(list.points) + " / " +
+                    std::to_string(list.points_total) + " points"};
+      item.ach_key = key;
+      item.icon = BadgeTexture(PS4Achievements::GameBadgePath(m_data_dir, list.badge));
+      found.push_back({list.saved, item});
+    }
+    std::stable_sort(found.begin(), found.end(),
+                     [](const auto& a, const auto& b) { return a.first > b.first; });
+    for (auto& [saved, item] : found)
+      achievements.push_back(std::move(item));
+    if (found.empty())
+    {
+      achievements.push_back({"No achievements yet",
+                              "Log in, then play a game RetroAchievements supports", -1, -1,
+                              SET_ACHIEVEMENTS});
+    }
+  }
+
+  auto& cards = m_items[static_cast<int>(Category::MemoryCards)];
+  for (size_t i = 0; i < m_cards.size(); i++)
+  {
+    const PS4MemoryCards::Card& card = m_cards[i];
+    const size_t saves = card.saves.size();
+    std::string detail = std::to_string(saves) + (saves == 1 ? " save" : " saves") + "  -  " +
+                         std::to_string(card.blocks) + " blocks";
+    if (card.name == m_slot_a)
+      detail = "In Slot A  -  " + detail;
+    Item item{card.name, detail};
+    item.card = static_cast<int>(i);
+    cards.push_back(item);
+  }
+  Item new_card{"New Memory Card", "An empty card for new saves"};
+  new_card.card = CARD_NEW;
+  cards.push_back(new_card);
+  for (int c = 0; c < CATEGORY_COUNT; c++)
+  {
+    m_selected[c] = std::clamp(m_selected[c], 0, std::max(0, static_cast<int>(m_items[c].size()) - 1));
+  }
+
+  auto& themes = m_items[static_cast<int>(Category::Themes)];
+  for (size_t i = 0; i < std::size(THEMES); i++)
+  {
+    const bool active = m_prefs.wallpaper.empty() && m_prefs.theme == THEMES[i].name;
+    themes.push_back({THEMES[i].name, active ? "In use" : "Color theme", -1, static_cast<int>(i)});
+  }
+  for (size_t i = 0; i < m_wallpapers.size(); i++)
+  {
+    const bool active = m_prefs.wallpaper == m_wallpapers[i];
+    themes.push_back({std::filesystem::path(m_wallpapers[i]).stem().string(),
+                      active ? "In use" : "Wallpaper", -1, -2 - static_cast<int>(i)});
+  }
+}
