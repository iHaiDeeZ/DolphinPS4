+// Triangle > Patches.
+void Menu::OpenPatchesList(const Game& game)
+{
+  m_panel = {};
+  m_panel.open = true;
+  m_panel.title = "Patches";
+  m_patches.clear();
+  m_patches_game = game.id;
+  m_patches_revision = game.revision;
+  const Common::IniFile global = SConfig::LoadDefaultGameIni(game.id, game.revision);
+  const Common::IniFile local = SConfig::LoadLocalGameIni(game.id, game.revision);
+  PatchEngine::LoadPatchSection("OnFrame", &m_patches, global, local);
+  m_patch_status = "Checking...";
+  // Dolphin's newest patch list for this game (its GameSettings files on GitHub).
+  if (!m_patch_dl_busy && game.id.size() >= 3)
+  {
+    if (m_patch_dl_thread.joinable())
+      m_patch_dl_thread.join();
+    m_patch_dl_busy = true;
+    m_patch_dl_done = false;
+    const std::string id = game.id;
+    m_patch_dl_thread = std::thread([this, id] {
+      std::vector<std::pair<std::string, std::string>> files;
+      bool ok = false;
+      Common::HttpRequest http{std::chrono::seconds{10}};
+      for (const std::string& name : {id.substr(0, 3), id})
+      {
+        const std::string url =
+            "https://raw.githubusercontent.com/dolphin-emu/dolphin/master/Data/Sys/GameSettings/" +
+            name + ".ini";
+        const auto response = http.Get(url, {}, Common::HttpRequest::AllowedReturnCodes::All);
+        const int code = http.GetLastResponseCode();
+        if (response && (code == 200 || code == 404))
+          ok = true;
+        if (response && code == 200)
+          files.emplace_back(name, std::string(response->begin(), response->end()));
+      }
+      m_patch_dl_files = std::move(files);
+      m_patch_dl_ok = ok;
+      m_patch_dl_done = true;
+    });
+  }
+  BuildPatchRows();
+  m_panel.selected = 0;
+  MoveSettingRow(0);
+}
+
+// The fetched list arrived: patches this version doesn't have join the list, as Dolphin ships
+// them (on or off), kept with the user's own patches so the game uses them.
+void Menu::UpdatePatchDownload()
+{
+  if (!m_patch_dl_done.exchange(false))
+    return;
+  if (m_patch_dl_thread.joinable())
+    m_patch_dl_thread.join();
+  m_patch_dl_busy = false;
+  if (!m_patch_dl_ok)
+  {
+    m_patch_status = "Offline";
+  }
+  else
+  {
+    const std::string dir = m_data_dir + "/patches-cache/";
+    File::CreateFullPath(dir);
+    Common::IniFile online;
+    for (const auto& [name, text] : m_patch_dl_files)
+    {
+      const std::string path = dir + name + ".ini";
+      File::WriteStringToFile(path, text);
+      online.Load(path, true);
+    }
+    std::vector<PatchEngine::Patch> fetched;
+    PatchEngine::LoadPatchSection("OnFrame", &fetched, online, Common::IniFile());
+    size_t added = 0;
+    for (PatchEngine::Patch patch : fetched)
+    {
+      const bool known = std::any_of(m_patches.begin(), m_patches.end(),
+                                     [&](const PatchEngine::Patch& p) { return p.name == patch.name; });
+      if (known)
+        continue;
+      patch.user_defined = true;
+      patch.default_enabled = false;
+      // patch.enabled stays Dolphin's own choice for it (on for its fixes).
+      m_patches.push_back(std::move(patch));
+      added++;
+    }
+    if (added > 0)
+      SavePatches();
+    m_patch_status = added > 0 ? std::to_string(added) + " new from Dolphin" : "Up to date";
+    Log("patches: " + m_patches_game + ": " + m_patch_status);
+  }
+  if (m_panel.open && m_panel.title == "Patches")
+    BuildPatchRows();
+}
+
+void Menu::BuildPatchRows()
+{
+  std::vector<SettingRow> rows;
+  rows.push_back({"Latest from Dolphin", m_patch_dl_busy ? "Checking..." : m_patch_status,
+                  "patchdl"});
+  if (!m_patches.empty())
+    rows.push_back({"Patches", "", "", true});
+  for (size_t i = 0; i < m_patches.size(); i++)
+  {
+    SettingRow row{m_patches[i].name, m_patches[i].enabled ? "On" : "Off",
+                   "patch:" + std::to_string(i)};
