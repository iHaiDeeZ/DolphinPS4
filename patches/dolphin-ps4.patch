+  if (pipe_count != 0 && processed >= GATHER_PIPE_SIZE &&
+      processed + GATHER_PIPE_SIZE <= GATHER_PIPE_EXTRA_SIZE)
+  {
+    u8 spill[GATHER_PIPE_SIZE];
+    __builtin_memcpy(spill, m_gather_pipe + processed, GATHER_PIPE_SIZE);
+    __builtin_memcpy(m_gather_pipe, spill, GATHER_PIPE_SIZE);
+  }
+  else if (pipe_count != 0)
+#endif
+    memmove(m_gather_pipe, m_gather_pipe + processed, pipe_count);
   SetGatherPipeCount(pipe_count);
 }
 
