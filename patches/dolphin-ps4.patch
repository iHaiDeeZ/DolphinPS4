+// A BootMii backup stores each 0x800-byte page followed by its 0x40 bytes of ECC data.
+bool NANDImporter::PS4ReadNAND(u64 offset, u8* out, size_t size) const
+{
+  constexpr u64 PAGE = 0x800, PAGE_WITH_ECC = 0x840;
+  while (size > 0)
+  {
+    const u64 page = offset / PAGE, in_page = offset % PAGE;
+    const size_t take = static_cast<size_t>(std::min<u64>(size, PAGE - in_page));
+    if (!m_ps4_file.Seek(static_cast<s64>(page * PAGE_WITH_ECC + in_page), File::SeekOrigin::Begin) ||
+        !m_ps4_file.ReadBytes(out, take))
+    {
+      return false;
+    }
+    offset += take;
+    out += take;
+    size -= take;
+  }
+  return true;
+}
