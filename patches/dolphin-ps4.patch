+struct RealFunctions
+{
+  PS4_RECORDED(PS4_DECLARE_REAL)
+  PS4_DRAINED(PS4_DECLARE_REAL)
+};
+#undef PS4_DECLARE_REAL
+RealFunctions s_real;
+
+// ---------------------------------------------------------------------------------------------
+// The queue: a single-producer (video thread), single-consumer (worker) ring of records
+// {u32 size, u32 op, payload}, 16-byte aligned, never wrapping inside a record.
+constexpr size_t RING_SIZE = 16u << 20;
+constexpr size_t RING_MASK = RING_SIZE - 1;
+
+struct Header
+{
+  u32 size;
+  u32 op;
+};
+
+u8* s_ring = nullptr;
+alignas(64) std::atomic<u64> s_write{0};  // published by the producer
+alignas(64) std::atomic<u64> s_read{0};   // published by the consumer
+alignas(64) u64 s_reserve = 0;            // producer-local
+u32 s_pending = 0;                        // size of the record being written
+std::atomic<bool> s_sleeping{false};
+std::atomic<bool> s_stop{false};
+std::mutex s_wake_mutex;
+std::condition_variable s_wake;
+std::thread s_worker;
+bool s_active = false;
+
+void WakeWorker()
+{
+  if (s_sleeping.load(std::memory_order_seq_cst))
+  {
+    std::lock_guard lk(s_wake_mutex);
+    s_wake.notify_one();
+  }
+}
+
+void Pause(u32& spins)
+{
+  if (++spins < 64)
+  {
+    __builtin_ia32_pause();
+  }
+  else if (spins < 256)
+  {
+    std::this_thread::yield();
+  }
+  else
+  {
+    const timespec ts{0, 20000};
+    nanosleep(&ts, nullptr);
+  }
+}
+
+void WaitForSpace(size_t size)
+{
+  u32 spins = 0;
+  while (s_reserve + size - s_read.load(std::memory_order_acquire) > RING_SIZE)
+  {
+    WakeWorker();
+    Pause(spins);
+  }
+}
+
+constexpr size_t Align16(size_t size)
+{
+  return (size + 15) & ~size_t(15);
+}
+
+// Starts a record with `payload` bytes; finish with Commit().
+u8* Begin(Op op, size_t payload)
+{
+  const size_t size = Align16(sizeof(Header) + payload);
+  size_t offset = s_reserve & RING_MASK;
+  if (offset + size > RING_SIZE)
+  {
+    const size_t pad = RING_SIZE - offset;
+    WaitForSpace(pad);
+    auto* h = reinterpret_cast<Header*>(s_ring + offset);
+    h->size = static_cast<u32>(pad);
+    h->op = OP_PAD;
+    s_reserve += pad;
+    s_write.store(s_reserve, std::memory_order_seq_cst);
+    offset = 0;
+  }
+  WaitForSpace(size);
+  auto* h = reinterpret_cast<Header*>(s_ring + offset);
+  h->size = static_cast<u32>(size);
+  h->op = op;
+  s_pending = static_cast<u32>(size);
+  return reinterpret_cast<u8*>(h + 1);
+}
+
+void ExecuteInline();
+
+void Commit()
+{
+  s_reserve += s_pending;
+  s_write.store(s_reserve, std::memory_order_seq_cst);
+  if (ps4_vk_thread_mode == 2)
+  {
+    ExecuteInline();
+    return;
+  }
+  WakeWorker();
+  if (ps4_vk_thread_mode == 1)
+    PS4CommandRecorderDrain();
+}
+
+// Writes a payload made of a fixed struct followed by arrays.
+class Writer
+{
+public:
+  explicit Writer(u8* p) : m_p(p) {}
+  template <typename T>
+  void Put(const T& v)
+  {
+    std::memcpy(m_p, &v, sizeof(T));
+    m_p += sizeof(T);
+  }
+  template <typename T>
+  void PutArray(const T* v, u32 count)
+  {
+    if (count)
+      std::memcpy(m_p, v, sizeof(T) * count);
+    m_p += sizeof(T) * count;
+  }
+
+private:
+  u8* m_p;
+};
+
+class Reader
+{
+public:
+  explicit Reader(const u8* p) : m_p(p) {}
+  template <typename T>
+  T Get()
+  {
+    T v;
+    std::memcpy(&v, m_p, sizeof(T));
+    m_p += sizeof(T);
+    return v;
+  }
+  template <typename T>
+  const T* GetArray(u32 count)
+  {
+    const T* v = reinterpret_cast<const T*>(m_p);
+    m_p += sizeof(T) * count;
+    return v;
+  }
+
+private:
+  const u8* m_p;
+};
+
+// ---------------------------------------------------------------------------------------------
+// Replay (worker thread).
+void Execute(const Header* h)
+{
+  Reader r(reinterpret_cast<const u8*>(h + 1));
+  switch (h->op)
+  {
+  case OP_PAD:
+    break;
+  case OP_BeginCommandBuffer:
+  {
+    const auto cb = r.Get<VkCommandBuffer>();
+    VkCommandBufferBeginInfo info = {VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO, nullptr,
+                                     r.Get<VkCommandBufferUsageFlags>(), nullptr};
+    const VkResult res = s_real.real_vkBeginCommandBuffer(cb, &info);
+    if (res != VK_SUCCESS)
+      ERROR_LOG_FMT(VIDEO, "vk_thread: vkBeginCommandBuffer failed: {}", static_cast<int>(res));
+    break;
+  }
+  case OP_EndCommandBuffer:
+  {
+    const VkResult res = s_real.real_vkEndCommandBuffer(r.Get<VkCommandBuffer>());
+    if (res != VK_SUCCESS)
+      ERROR_LOG_FMT(VIDEO, "vk_thread: vkEndCommandBuffer failed: {}", static_cast<int>(res));
+    break;
+  }
+  case OP_ResetCommandPool:
+  {
+    const auto device = r.Get<VkDevice>();
+    const auto pool = r.Get<VkCommandPool>();
+    s_real.real_vkResetCommandPool(device, pool, r.Get<VkCommandPoolResetFlags>());
+    break;
+  }
+  case OP_ResetFences:
+  {
+    const auto device = r.Get<VkDevice>();
+    const u32 count = r.Get<u32>();
+    s_real.real_vkResetFences(device, count, r.GetArray<VkFence>(count));
+    break;
+  }
+  case OP_QueueSubmit:
+  {
+    const auto queue = r.Get<VkQueue>();
+    const auto fence = r.Get<VkFence>();
+    const u32 count = r.Get<u32>();
+    VkSubmitInfo submits[4];
+    for (u32 i = 0; i < count && i < 4; i++)
+    {
+      VkSubmitInfo& s = submits[i];
+      s = {VK_STRUCTURE_TYPE_SUBMIT_INFO};
+      s.waitSemaphoreCount = r.Get<u32>();
+      s.pWaitSemaphores = r.GetArray<VkSemaphore>(s.waitSemaphoreCount);
+      s.pWaitDstStageMask = r.GetArray<VkPipelineStageFlags>(s.waitSemaphoreCount);
+      s.commandBufferCount = r.Get<u32>();
+      s.pCommandBuffers = r.GetArray<VkCommandBuffer>(s.commandBufferCount);
+      s.signalSemaphoreCount = r.Get<u32>();
+      s.pSignalSemaphores = r.GetArray<VkSemaphore>(s.signalSemaphoreCount);
+    }
+    const VkResult res = s_real.real_vkQueueSubmit(queue, count, submits, fence);
+    if (res != VK_SUCCESS)
+      ERROR_LOG_FMT(VIDEO, "vk_thread: vkQueueSubmit failed: {}", static_cast<int>(res));
+    break;
+  }
+  case OP_CmdBindPipeline:
+  {
+    const auto cb = r.Get<VkCommandBuffer>();
+    const auto point = r.Get<VkPipelineBindPoint>();
+    s_real.real_vkCmdBindPipeline(cb, point, r.Get<VkPipeline>());
+    break;
+  }
+  case OP_CmdBindDescriptorSets:
+  {
+    const auto cb = r.Get<VkCommandBuffer>();
+    const auto point = r.Get<VkPipelineBindPoint>();
+    const auto layout = r.Get<VkPipelineLayout>();
+    const u32 first = r.Get<u32>();
+    const u32 count = r.Get<u32>();
+    const u32 dynamic_count = r.Get<u32>();
+    const VkDescriptorSet* sets = r.GetArray<VkDescriptorSet>(count);
+    const u32* offsets = r.GetArray<u32>(dynamic_count);
+    s_real.real_vkCmdBindDescriptorSets(cb, point, layout, first, count, sets, dynamic_count,
+                                        offsets);
+    break;
+  }
+  case OP_CmdBindVertexBuffers:
+  {
+    const auto cb = r.Get<VkCommandBuffer>();
+    const u32 first = r.Get<u32>();
+    const u32 count = r.Get<u32>();
+    const VkBuffer* buffers = r.GetArray<VkBuffer>(count);
+    const VkDeviceSize* offsets = r.GetArray<VkDeviceSize>(count);
+    s_real.real_vkCmdBindVertexBuffers(cb, first, count, buffers, offsets);
+    break;
+  }
+  case OP_CmdBindIndexBuffer:
+  {
+    const auto cb = r.Get<VkCommandBuffer>();
+    const auto buffer = r.Get<VkBuffer>();
+    const auto offset = r.Get<VkDeviceSize>();
+    s_real.real_vkCmdBindIndexBuffer(cb, buffer, offset, r.Get<VkIndexType>());
+    break;
+  }
+  case OP_CmdDraw:
+  {
+    const auto cb = r.Get<VkCommandBuffer>();
+    const u32 a = r.Get<u32>(), b = r.Get<u32>(), c = r.Get<u32>(), d = r.Get<u32>();
+    s_real.real_vkCmdDraw(cb, a, b, c, d);
+    break;
+  }
+  case OP_CmdDrawIndexed:
+  {
+    const auto cb = r.Get<VkCommandBuffer>();
+    const u32 a = r.Get<u32>(), b = r.Get<u32>(), c = r.Get<u32>();
+    const s32 d = r.Get<s32>();
+    const u32 e = r.Get<u32>();
+    s_real.real_vkCmdDrawIndexed(cb, a, b, c, d, e);
+    break;
+  }
+  case OP_CmdDispatch:
+  {
+    const auto cb = r.Get<VkCommandBuffer>();
+    const u32 x = r.Get<u32>(), y = r.Get<u32>(), z = r.Get<u32>();
+    s_real.real_vkCmdDispatch(cb, x, y, z);
+    break;
+  }
+  case OP_CmdSetViewport:
+  {
+    const auto cb = r.Get<VkCommandBuffer>();
+    const u32 first = r.Get<u32>();
+    const u32 count = r.Get<u32>();
+    s_real.real_vkCmdSetViewport(cb, first, count, r.GetArray<VkViewport>(count));
+    break;
+  }
+  case OP_CmdSetScissor:
+  {
+    const auto cb = r.Get<VkCommandBuffer>();
+    const u32 first = r.Get<u32>();
+    const u32 count = r.Get<u32>();
+    s_real.real_vkCmdSetScissor(cb, first, count, r.GetArray<VkRect2D>(count));
+    break;
+  }
+  case OP_CmdBeginRenderPass:
+  {
+    const auto cb = r.Get<VkCommandBuffer>();
+    VkRenderPassBeginInfo info = {VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO};
+    info.renderPass = r.Get<VkRenderPass>();
+    info.framebuffer = r.Get<VkFramebuffer>();
+    info.renderArea = r.Get<VkRect2D>();
+    info.clearValueCount = r.Get<u32>();
+    const auto contents = r.Get<VkSubpassContents>();
+    info.pClearValues = r.GetArray<VkClearValue>(info.clearValueCount);
+    s_real.real_vkCmdBeginRenderPass(cb, &info, contents);
+    break;
+  }
+  case OP_CmdEndRenderPass:
+    s_real.real_vkCmdEndRenderPass(r.Get<VkCommandBuffer>());
+    break;
+  case OP_CmdPipelineBarrier:
+  {
+    const auto cb = r.Get<VkCommandBuffer>();
+    const auto src = r.Get<VkPipelineStageFlags>();
+    const auto dst = r.Get<VkPipelineStageFlags>();
+    const auto flags = r.Get<VkDependencyFlags>();
+    const u32 nm = r.Get<u32>(), nb = r.Get<u32>(), ni = r.Get<u32>();
+    const auto* m = r.GetArray<VkMemoryBarrier>(nm);
+    const auto* b = r.GetArray<VkBufferMemoryBarrier>(nb);
+    const auto* i = r.GetArray<VkImageMemoryBarrier>(ni);
+    s_real.real_vkCmdPipelineBarrier(cb, src, dst, flags, nm, m, nb, b, ni, i);
+    break;
+  }
+  case OP_CmdClearAttachments:
+  {
+    const auto cb = r.Get<VkCommandBuffer>();
+    const u32 na = r.Get<u32>(), nr = r.Get<u32>();
+    const auto* a = r.GetArray<VkClearAttachment>(na);
+    const auto* rects = r.GetArray<VkClearRect>(nr);
+    s_real.real_vkCmdClearAttachments(cb, na, a, nr, rects);
+    break;
+  }
+  case OP_CmdUpdateBuffer:
+  {
+    const auto cb = r.Get<VkCommandBuffer>();
+    const auto buffer = r.Get<VkBuffer>();
+    const auto offset = r.Get<VkDeviceSize>();
+    const auto size = r.Get<VkDeviceSize>();
+    s_real.real_vkCmdUpdateBuffer(cb, buffer, offset, size,
+                                  r.GetArray<u8>(static_cast<u32>(size)));
+    break;
+  }
+  case OP_CmdResetQueryPool:
+  {
+    const auto cb = r.Get<VkCommandBuffer>();
+    const auto pool = r.Get<VkQueryPool>();
+    const u32 first = r.Get<u32>(), count = r.Get<u32>();
+    s_real.real_vkCmdResetQueryPool(cb, pool, first, count);
+    break;
+  }
+  case OP_CmdBeginQuery:
+  {
+    const auto cb = r.Get<VkCommandBuffer>();
+    const auto pool = r.Get<VkQueryPool>();
+    const u32 query = r.Get<u32>();
+    s_real.real_vkCmdBeginQuery(cb, pool, query, r.Get<VkQueryControlFlags>());
+    break;
+  }
+  case OP_CmdEndQuery:
+  {
+    const auto cb = r.Get<VkCommandBuffer>();
+    const auto pool = r.Get<VkQueryPool>();
+    s_real.real_vkCmdEndQuery(cb, pool, r.Get<u32>());
+    break;
+  }
+  case OP_CmdCopyBufferToImage:
+  {
+    const auto cb = r.Get<VkCommandBuffer>();
+    const auto src = r.Get<VkBuffer>();
+    const auto dst = r.Get<VkImage>();
+    const auto layout = r.Get<VkImageLayout>();
+    const u32 n = r.Get<u32>();
+    s_real.real_vkCmdCopyBufferToImage(cb, src, dst, layout, n, r.GetArray<VkBufferImageCopy>(n));
+    break;
+  }
+  case OP_CmdCopyImageToBuffer:
+  {
+    const auto cb = r.Get<VkCommandBuffer>();
+    const auto src = r.Get<VkImage>();
+    const auto layout = r.Get<VkImageLayout>();
+    const auto dst = r.Get<VkBuffer>();
+    const u32 n = r.Get<u32>();
+    s_real.real_vkCmdCopyImageToBuffer(cb, src, layout, dst, n, r.GetArray<VkBufferImageCopy>(n));
+    break;
+  }
+  case OP_CmdCopyImage:
+  {
+    const auto cb = r.Get<VkCommandBuffer>();
+    const auto src = r.Get<VkImage>();
+    const auto src_layout = r.Get<VkImageLayout>();
+    const auto dst = r.Get<VkImage>();
+    const auto dst_layout = r.Get<VkImageLayout>();
+    const u32 n = r.Get<u32>();
+    s_real.real_vkCmdCopyImage(cb, src, src_layout, dst, dst_layout, n,
+                               r.GetArray<VkImageCopy>(n));
+    break;
+  }
+  case OP_CmdCopyBuffer:
+  {
+    const auto cb = r.Get<VkCommandBuffer>();
+    const auto src = r.Get<VkBuffer>();
+    const auto dst = r.Get<VkBuffer>();
+    const u32 n = r.Get<u32>();
+    s_real.real_vkCmdCopyBuffer(cb, src, dst, n, r.GetArray<VkBufferCopy>(n));
+    break;
+  }
+  case OP_CmdBlitImage:
+  {
+    const auto cb = r.Get<VkCommandBuffer>();
+    const auto src = r.Get<VkImage>();
+    const auto src_layout = r.Get<VkImageLayout>();
+    const auto dst = r.Get<VkImage>();
+    const auto dst_layout = r.Get<VkImageLayout>();
+    const auto filter = r.Get<VkFilter>();
+    const u32 n = r.Get<u32>();
+    s_real.real_vkCmdBlitImage(cb, src, src_layout, dst, dst_layout, n,
+                               r.GetArray<VkImageBlit>(n), filter);
+    break;
+  }
+  case OP_CmdResolveImage:
+  {
+    const auto cb = r.Get<VkCommandBuffer>();
+    const auto src = r.Get<VkImage>();
+    const auto src_layout = r.Get<VkImageLayout>();
+    const auto dst = r.Get<VkImage>();
+    const auto dst_layout = r.Get<VkImageLayout>();
+    const u32 n = r.Get<u32>();
+    s_real.real_vkCmdResolveImage(cb, src, src_layout, dst, dst_layout, n,
+                                  r.GetArray<VkImageResolve>(n));
+    break;
+  }
+  default:
+    ERROR_LOG_FMT(VIDEO, "vk_thread: unknown record {}", h->op);
+    break;
+  }
+}
+
+void ExecuteInline()
+{
+  u64 read = s_read.load(std::memory_order_relaxed);
+  const u64 write = s_write.load(std::memory_order_relaxed);
+  while (read != write)
+  {
+    const auto* h = reinterpret_cast<const Header*>(s_ring + (read & RING_MASK));
+    Execute(h);
+    read += h->size;
+  }
+  s_read.store(read, std::memory_order_release);
+}
+
+void WorkerLoop()
+{
+  Common::SetCurrentThreadName("VK record thread");
+  {
+    const auto [affinity, priority] = Common::PS4SetCurrentThreadCoreAndPriority(
+        ps4_vk_thread_core, 0);
+    char line[128];
+    snprintf(line, sizeof(line), "vk_thread: worker on core %d (result 0x%x)", ps4_vk_thread_core,
+             affinity);
+    ps4_boot_trace(line);
+  }
+  u64 read = s_read.load(std::memory_order_relaxed);
+  for (;;)
+  {
+    u64 write = s_write.load(std::memory_order_acquire);
+    if (read == write)
+    {
+      if (s_stop.load(std::memory_order_acquire))
+        break;
+      // Spin briefly (the video thread usually queues the next call within microseconds), then
+      // sleep. Timed waits: a lost wakeup costs at most a millisecond.
+      u32 spins = 0;
+      while (spins < 2000 && s_write.load(std::memory_order_acquire) == read)
+      {
+        __builtin_ia32_pause();
+        spins++;
+      }
+      if (s_write.load(std::memory_order_acquire) == read)
+      {
+        std::unique_lock lk(s_wake_mutex);
+        s_sleeping.store(true, std::memory_order_seq_cst);
+        if (s_write.load(std::memory_order_seq_cst) == read && !s_stop.load())
+          s_wake.wait_for(lk, std::chrono::milliseconds(1));
+        s_sleeping.store(false, std::memory_order_relaxed);
+      }
+      continue;
+    }
+    while (read != write)
+    {
+      const auto* h = reinterpret_cast<const Header*>(s_ring + (read & RING_MASK));
+      Execute(h);
+      read += h->size;
+      s_read.store(read, std::memory_order_release);
+    }
+  }
+}
