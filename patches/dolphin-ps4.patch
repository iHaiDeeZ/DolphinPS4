+// The unlock pop-up: slides in at the top right, stays 5 s, slides out; the next one follows.
+bool DrawPopup(ImDrawList* dl, ImFont* bold, ImFont* regular, float s, Clock::time_point now)
+{
+  if (s_popups.empty())
+    return false;
+  if (!s_popup_showing)
+  {
+    s_popup_showing = true;
+    s_popup_start = now;
+  }
+  const float t = std::chrono::duration<float>(now - s_popup_start).count();
+  constexpr float SHOW = 5.5f;
+  if (t > SHOW)
+  {
+    s_popups.erase(s_popups.begin());
+    s_popup_showing = false;
+    return !s_popups.empty();
+  }
+  const Popup& popup = s_popups.front();
+  const float in = std::clamp(t / 0.35f, 0.0f, 1.0f), out = std::clamp((SHOW - t) / 0.35f, 0.0f, 1.0f);
+  const float k = std::min(in, out);
+  const float ease = 1.0f - (1.0f - k) * (1.0f - k) * (1.0f - k);
+  const ImVec2 size = ImGui::GetIO().DisplaySize;
+  const float w = 640 * s, h = 128 * s;
+  const float x = size.x - 50 * s - w + (1.0f - ease) * (w + 80 * s), y = 50 * s;
+  const int a = static_cast<int>(255 * k);
+  const ImU32 gold = IM_COL32(255, 200, 70, a);
+  dl->AddRectFilled(ImVec2(x, y), ImVec2(x + w, y + h), IM_COL32(8, 20, 46, static_cast<int>(235 * k)),
+                    18 * s);
+  dl->AddRect(ImVec2(x, y), ImVec2(x + w, y + h),
+              popup.hardcore ? gold : IM_COL32(91, 184, 255, a), 18 * s, 0, 2.5f * s);
+  float tx = x + 28 * s;
+  if (AbstractTexture* badge = BadgeTexture(popup.badge))
+  {
+    const float b = 88 * s;
+    dl->AddImageRounded(ImTextureRef(*badge), ImVec2(x + 20 * s, y + 20 * s),
+                        ImVec2(x + 20 * s + b, y + 20 * s + b), ImVec2(0, 0), ImVec2(1, 1),
+                        IM_COL32(255, 255, 255, a), 10 * s);
+    tx = x + 20 * s + b + 22 * s;
+  }
+  const float tw = w - (tx - x) - 24 * s;
+  dl->AddText(regular, 24 * s, ImVec2(tx, y + 18 * s), gold,
+              (std::string(PS4Lang::T("Achievement Unlocked")) + "  -  " +
+               std::to_string(popup.points) + " " + PS4Lang::T("points"))
+                  .c_str());
+  dl->AddText(bold, 32 * s, ImVec2(tx, y + 46 * s), IM_COL32(255, 255, 255, a),
+              FitText(popup.title, 34).c_str(), nullptr, tw);
+  dl->AddText(regular, 22 * s, ImVec2(tx, y + 88 * s), IM_COL32(255, 255, 255, static_cast<int>(170 * k)),
+              FitText(popup.description, 52).c_str());
+  return true;
+}
+
+void DrawGlyph(ImDrawList* dl, Glyph glyph, ImVec2 c, float r, float a)
+{
+  const ImU32 ring = IM_COL32(255, 255, 255, static_cast<int>(60 * a));
+  auto colour = [a](int rr, int g, int b) {
+    return IM_COL32(rr, g, b, static_cast<int>(255 * a));
+  };
+  switch (glyph)
+  {
+  case Glyph::Cross:
+    dl->AddCircleFilled(c, r, ring, 28);
+    dl->AddLine(ImVec2(c.x - r * 0.45f, c.y - r * 0.45f), ImVec2(c.x + r * 0.45f, c.y + r * 0.45f),
+                colour(120, 170, 255), r * 0.22f);
+    dl->AddLine(ImVec2(c.x - r * 0.45f, c.y + r * 0.45f), ImVec2(c.x + r * 0.45f, c.y - r * 0.45f),
+                colour(120, 170, 255), r * 0.22f);
+    break;
+  case Glyph::Square:
+    dl->AddCircleFilled(c, r, ring, 28);
+    dl->AddRect(ImVec2(c.x - r * 0.42f, c.y - r * 0.42f), ImVec2(c.x + r * 0.42f, c.y + r * 0.42f),
+                colour(255, 140, 200), 0.0f, 0, r * 0.2f);
+    break;
+  case Glyph::Circle:
+    dl->AddCircleFilled(c, r, ring, 28);
+    dl->AddCircle(c, r * 0.48f, colour(255, 100, 110), 24, r * 0.2f);
+    break;
+  case Glyph::LeftRight:
+  case Glyph::UpDown:
+  {
+    // A D-pad with the two arrows in use lit.
+    const float s = r * 0.42f;
+    const ImU32 dim = IM_COL32(255, 255, 255, static_cast<int>(70 * a));
+    const ImU32 lit = colour(255, 255, 255);
+    const bool lr = glyph == Glyph::LeftRight;
+    dl->AddRectFilled(ImVec2(c.x - s * 0.5f, c.y - r), ImVec2(c.x + s * 0.5f, c.y - s * 0.5f),
+                      lr ? dim : lit, 2.0f);
+    dl->AddRectFilled(ImVec2(c.x - s * 0.5f, c.y + s * 0.5f), ImVec2(c.x + s * 0.5f, c.y + r),
+                      lr ? dim : lit, 2.0f);
+    dl->AddRectFilled(ImVec2(c.x - r, c.y - s * 0.5f), ImVec2(c.x - s * 0.5f, c.y + s * 0.5f),
+                      lr ? lit : dim, 2.0f);
+    dl->AddRectFilled(ImVec2(c.x + s * 0.5f, c.y - s * 0.5f), ImVec2(c.x + r, c.y + s * 0.5f),
+                      lr ? lit : dim, 2.0f);
+    break;
+  }
+  case Glyph::L3R3:
+  {
+    // The DualShock 4's L3 and R3 (stick presses, as in the launcher's lists) with a "+".
+    ImFont* font = ps4_overlay_font ? ps4_overlay_font : ImGui::GetFont();
+    float h = r * 2.0f;
+    const float plus_w = r * 0.9f;
+    float w = PS4Glyphs::Width("L3", h) + plus_w + PS4Glyphs::Width("R3", h);
+    if (w > r * 4.8f && w > 0.0f)
+    {
+      h *= r * 4.8f / w;
+      w = r * 4.8f;
+    }
+    float x = c.x - w * 0.5f;
+    x += PS4Glyphs::Draw(dl, font, "L3", x, c.y, h, a);
+    const float plus = r * 0.2f, px = x + plus_w * 0.5f;
+    dl->AddLine(ImVec2(px - plus, c.y), ImVec2(px + plus, c.y), colour(255, 255, 255), r * 0.12f);
+    dl->AddLine(ImVec2(px, c.y - plus), ImVec2(px, c.y + plus), colour(255, 255, 255), r * 0.12f);
+    x += plus_w;
+    PS4Glyphs::Draw(dl, font, "R3", x, c.y, h, a);
+    break;
+  }
+  }
+}
