diff --git a/Source/Core/Common/GL/GLInterface/Piglet.cpp b/Source/Core/Common/GL/GLInterface/Piglet.cpp
new file mode 100644
index 0000000..ecee95e
--- /dev/null
+++ b/Source/Core/Common/GL/GLInterface/Piglet.cpp
@@ -0,0 +1,371 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "Common/GL/GLInterface/Piglet.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <string>
+
+#include <sys/mman.h>
+#include <sys/stat.h>
+
+#include <orbis/Pigletv2VSH.h>
+#include <orbis/libkernel.h>
+
+#include "Common/CommonTypes.h"
+#include "Common/Logging/Log.h"
+
+// /data/DolphinPS4/boot-trace.log (DolphinPS4 port/ps4_crashlog.cpp, linked into the app).
+extern "C" void ps4_boot_trace(const char* stage);
+// ps4.ini gpu_cmdbuf_mb, set by DolphinNoGUI before the video backend starts.
+extern "C" int ps4_gpu_cmdbuf_mb;
+int ps4_gpu_cmdbuf_mb = 8;
+
+// Piglet is loaded at run time and every function is looked up with sceKernelDlsym, so the app
+// has no load-time dependency on the (devkit) Piglet module. <EGL/egl.h> (via Pigletv2VSH.h) is
+// only used for types and constants.
+namespace
+{
+using PigletWindow = OrbisPglWindow;
+
+struct EGLFunctions
+{
+  EGLDisplay (*GetDisplay)(EGLNativeDisplayType);
+  EGLBoolean (*Initialize)(EGLDisplay, EGLint*, EGLint*);
+  EGLBoolean (*BindAPI)(EGLenum);
+  EGLBoolean (*ChooseConfig)(EGLDisplay, const EGLint*, EGLConfig*, EGLint, EGLint*);
+  EGLSurface (*CreateWindowSurface)(EGLDisplay, EGLConfig, EGLNativeWindowType, const EGLint*);
+  EGLContext (*CreateContext)(EGLDisplay, EGLConfig, EGLContext, const EGLint*);
+  EGLBoolean (*MakeCurrent)(EGLDisplay, EGLSurface, EGLSurface, EGLContext);
+  EGLBoolean (*SwapBuffers)(EGLDisplay, EGLSurface);
+  EGLBoolean (*SwapInterval)(EGLDisplay, EGLint);
+  EGLBoolean (*DestroySurface)(EGLDisplay, EGLSurface);
+  EGLBoolean (*DestroyContext)(EGLDisplay, EGLContext);
+  EGLBoolean (*Terminate)(EGLDisplay);
+  EGLint (*GetError)();
+  __eglMustCastToProperFunctionPointerType (*GetProcAddress)(const char*);
+  int (*SetConfiguration)(OrbisPglConfig*);
+};
+
+constexpr char PIGLET_MODULE[] = "libScePigletv2VSH.sprx";
+constexpr char SHACC_MODULE[] = "libSceShaccVSH.sprx";
+
+int32_t s_piglet_module = -1;
+int32_t s_shacc_module = -1;
+EGLFunctions s_egl;
+PigletWindow s_window = {0, 1920, 1080, 0};  // uID, uWidth, uHeight, uPadding
+
+bool FileExists(const std::string& path)
+{
+  struct stat st;
+  return stat(path.c_str(), &st) == 0;
+}
+
+// GoldHEN SDK (https://github.com/GoldHEN/GoldHEN_Plugins_SDK, MIT) syscall 500: lift the
+// sandbox while loading modules from outside the package, if the console refuses otherwise.
+int64_t GoldHENCommand(uint64_t command, void* data)
+{
+  int64_t result;
+  __asm__ volatile("syscall"
+                   : "=a"(result)
+                   : "a"(uint64_t{500}), "D"(command), "S"(data)
+                   : "rcx", "r11", "rdx", "r8", "r9", "r10", "memory", "cc");
+  return result;
+}
+
+bool LoadModules(const std::string& dir)
+{
+  const std::string piglet = dir + "/" + PIGLET_MODULE;
+  const std::string shacc = dir + "/" + SHACC_MODULE;
+  s_piglet_module =
+      static_cast<int32_t>(sceKernelLoadStartModule(piglet.c_str(), 0, nullptr, 0, nullptr, nullptr));
+  if (s_piglet_module < 0)
+    return false;
+  s_shacc_module =
+      static_cast<int32_t>(sceKernelLoadStartModule(shacc.c_str(), 0, nullptr, 0, nullptr, nullptr));
+  if (s_shacc_module < 0)
+  {
+    sceKernelStopUnloadModule(s_piglet_module, 0, nullptr, 0, nullptr, nullptr);
+    s_piglet_module = -1;
+    return false;
+  }
+  return true;
+}
+
+// Enables the runtime shader compiler in the 4.74 devkit Piglet (offsets from RetroArch for PS4).
+bool PatchPiglet()
+{
+  OrbisKernelModule handles[256];
+  size_t count = 0;
+  if (sceKernelGetModuleList(handles, 256, &count) != 0)
+    return false;
+  for (size_t i = 0; i < count; i++)
+  {
+    OrbisKernelModuleInfo info;
+    std::memset(&info, 0, sizeof(info));
+    info.size = sizeof(info);
+    if (sceKernelGetModuleInfo(handles[i], &info) != 0 || std::strcmp(info.name, PIGLET_MODULE) != 0)
+      continue;
+    auto* const base = static_cast<u8*>(info.segmentInfo[0].address);
+    if (sceKernelMprotect(base, info.segmentInfo[0].size, PROT_READ | PROT_WRITE | PROT_EXEC) != 0)
+      return false;
+    const u8 set_eax_to_1[] = {0x31, 0xC0, 0xFF, 0xC0, 0x90};
+    std::memcpy(base + 0x5451F, set_eax_to_1, sizeof(set_eax_to_1));
+    base[0xB2DEC] = 0;
+    base[0xB2DED] = 0;
+    base[0xB2DEE] = 1;
+    base[0xB2E21] = 1;
+    std::memcpy(base + 0xB2E24, &s_shacc_module, sizeof(s_shacc_module));
+    return true;
+  }
+  return false;
+}
+
+template <typename T>
+bool Resolve(T& function, const char* name)
+{
+  void* address = nullptr;
+  if (sceKernelDlsym(s_piglet_module, name, &address) != 0 || !address)
+  {
+    ERROR_LOG_FMT(VIDEO, "Piglet: missing {}", name);
+    return false;
+  }
+  function = reinterpret_cast<T>(address);
+  return true;
+}
+
+// Loads and configures Piglet once per process.
+bool InitPiglet()
+{
+  if (s_piglet_module >= 0)
+    return true;
+
+  std::string dir;
+  for (const char* candidate : {"/app0/sce_module", "/data/DolphinPS4/modules"})
+  {
+    if (FileExists(std::string(candidate) + "/" + SHACC_MODULE))
+    {
+      dir = candidate;
+      break;
+    }
+  }
+  if (dir.empty())
+  {
+    ERROR_LOG_FMT(VIDEO, "Piglet: {} not found in /app0/sce_module or /data/DolphinPS4/modules",
+                  SHACC_MODULE);
+    return false;
+  }
+  if (!LoadModules(dir))
+  {
+    u8 backup[128] = {};
+    GoldHENCommand(2, backup);  // jailbreak
+    const bool loaded = LoadModules(dir);
+    GoldHENCommand(3, backup);  // restore
+    if (!loaded)
+    {
+      ERROR_LOG_FMT(VIDEO, "Piglet: could not load the modules from {}", dir);
+      return false;
+    }
+  }
+  if (!PatchPiglet())
+  {
+    ERROR_LOG_FMT(VIDEO, "Piglet: could not enable the shader compiler");
+    return false;
+  }
+
+  bool ok = Resolve(s_egl.GetDisplay, "eglGetDisplay") &&
+            Resolve(s_egl.Initialize, "eglInitialize") && Resolve(s_egl.BindAPI, "eglBindAPI") &&
+            Resolve(s_egl.ChooseConfig, "eglChooseConfig") &&
+            Resolve(s_egl.CreateWindowSurface, "eglCreateWindowSurface") &&
+            Resolve(s_egl.CreateContext, "eglCreateContext") &&
+            Resolve(s_egl.MakeCurrent, "eglMakeCurrent") &&
+            Resolve(s_egl.SwapBuffers, "eglSwapBuffers") &&
+            Resolve(s_egl.SwapInterval, "eglSwapInterval") &&
+            Resolve(s_egl.DestroySurface, "eglDestroySurface") &&
+            Resolve(s_egl.DestroyContext, "eglDestroyContext") &&
+            Resolve(s_egl.Terminate, "eglTerminate") && Resolve(s_egl.GetError, "eglGetError") &&
+            Resolve(s_egl.GetProcAddress, "eglGetProcAddress") &&
+            Resolve(s_egl.SetConfiguration, "scePigletSetConfigurationVSH");
+  if (!ok)
+    return false;
+
+  // RetroArch for PS4's configuration (graphics memory from flexible memory), which is known to
+  // get a display on retail consoles, with slightly larger pools. Keep them small: GL buffers and
+  // more come from "FMEM", flexible memory Piglet maps on demand *beyond* these pools, and it ran
+  // out (ftruncate ENOMEM with 6 MiB left) whenever the pools took most of the 255 MiB.
+  // Dolphin's own large mappings come from the system flexible pool (port/ps4_runtime.cpp
+  // __wrap_mmap), so nearly all regular flexible memory is left to Piglet.
+  constexpr size_t MiB = 1024 * 1024;
+  size_t flexible = 0;
+  using AvailableFlexibleFn = int32_t (*)(size_t*);
+  reinterpret_cast<AvailableFlexibleFn>(&sceKernelAvailableFlexibleMemorySize)(&flexible);
+  const size_t system_shared = 32 * MiB;
+  const size_t video = 64 * MiB;
+  char trace[160];
+  snprintf(trace, sizeof(trace),
+           "Piglet: %zu MiB flexible memory free, %zu MiB video + %zu MiB system shared memory",
+           flexible / MiB, video / MiB, system_shared / MiB);
+  ps4_boot_trace(trace);
+  INFO_LOG_FMT(VIDEO, "{}", trace);
+
+  OrbisPglConfig config;
+  std::memset(&config, 0, sizeof(config));
+  config.size = sizeof(config);
+  config.flags = ORBIS_PGL_FLAGS_USE_COMPOSITE_EXT | ORBIS_PGL_FLAGS_USE_FLEXIBLE_MEMORY | 0x60;
+  config.processOrder = 1;
+  config.systemSharedMemorySize = static_cast<uint32_t>(system_shared);
+  config.videoSharedMemorySize = static_cast<uint32_t>(video);
+  config.maxMappedFlexibleMemory = 0xFFFFFFFF;
+  // Piglet records a frame's GPU commands into this buffer and drops what doesn't fit ("Out of
+  // commandbuffer memory"): with RetroArch's 1 MiB, Sonic Adventure DX lost its menus and parts
+  // of each level. ps4.ini gpu_cmdbuf_mb (default 8).
+  config.drawCommandBufferSize = static_cast<uint32_t>(ps4_gpu_cmdbuf_mb) * 0x100000;
+  config.lcueResourceBufferSize = 0x1000000;
+  config.dbgPosCmd_0x40 = s_window.uWidth;
+  config.dbgPosCmd_0x44 = s_window.uHeight;
+  config.unk_0x5C = 2;
+  if (!s_egl.SetConfiguration(&config))
+  {
+    ERROR_LOG_FMT(VIDEO, "Piglet: scePigletSetConfigurationVSH failed");
+    return false;
+  }
+
+  // Compiled shader cache, like RetroArch (optional).
+  struct ShaderCacheConfig
+  {
+    uint32_t version;
+    uint32_t unknown[2];
+    char cache_dir[128];
+  } cache_config{};
+  static_assert(sizeof(ShaderCacheConfig) == 0x8C);
+  int (*set_shader_cache)(const void*) = nullptr;
+  if (sceKernelDlsym(s_piglet_module, "scePigletSetShaderCacheConfiguration",
+                     reinterpret_cast<void**>(&set_shader_cache)) == 0 &&
+      set_shader_cache)
+  {
+    mkdir("/data/DolphinPS4/User/Cache", 0777);
+    mkdir("/data/DolphinPS4/User/Cache/Piglet", 0777);
+    // The structure is 0x10C bytes in RetroArch's declaration; pass a zeroed buffer that size.
+    char buffer[0x10C] = {};
+    cache_config.version = 0x00010064;
+    snprintf(cache_config.cache_dir, sizeof(cache_config.cache_dir), "%s",
+             "/data/DolphinPS4/User/Cache/Piglet/");
+    std::memcpy(buffer, &cache_config, sizeof(cache_config));
+    if (!set_shader_cache(buffer))
+      WARN_LOG_FMT(VIDEO, "Piglet: scePigletSetShaderCacheConfiguration failed");
+  }
+  INFO_LOG_FMT(VIDEO, "Piglet: modules loaded from {}", dir);
+  return true;
+}
+}  // namespace
+
+GLContextPiglet::~GLContextPiglet()
+{
+  if (!m_display)
+    return;
+  s_egl.MakeCurrent(m_display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+  if (m_context)
+    s_egl.DestroyContext(m_display, m_context);
+  if (m_surface)
+    s_egl.DestroySurface(m_display, m_surface);
+}
+
+bool GLContextPiglet::IsHeadless() const
+{
+  return false;
+}
+
+bool GLContextPiglet::Initialize(const WindowSystemInfo& wsi, bool stereo, bool core)
+{
+  if (!InitPiglet())
+    return false;
+
+  m_display = s_egl.GetDisplay(EGL_DEFAULT_DISPLAY);
+  EGLint major = 0, minor = 0;
+  if (!m_display || !s_egl.Initialize(m_display, &major, &minor))
+  {
+    ERROR_LOG_FMT(VIDEO, "Piglet: eglInitialize failed ({:#x})", s_egl.GetError());
+    return false;
+  }
+  s_egl.BindAPI(EGL_OPENGL_ES_API);
+
+  const EGLint attribs[] = {EGL_RED_SIZE,        8,
+                            EGL_GREEN_SIZE,      8,
+                            EGL_BLUE_SIZE,       8,
+                            EGL_ALPHA_SIZE,      8,
+                            EGL_DEPTH_SIZE,      0,
+                            EGL_STENCIL_SIZE,    0,
+                            EGL_RENDERABLE_TYPE, EGL_OPENGL_ES2_BIT,
+                            EGL_SURFACE_TYPE,    EGL_WINDOW_BIT,
+                            EGL_NONE};
+  EGLConfig config = nullptr;
+  EGLint num_configs = 0;
+  if (!s_egl.ChooseConfig(m_display, attribs, &config, 1, &num_configs) || num_configs == 0)
+  {
+    ERROR_LOG_FMT(VIDEO, "Piglet: no RGBA8 config ({:#x})", s_egl.GetError());
+    return false;
+  }
+
+  m_surface = s_egl.CreateWindowSurface(m_display, config, &s_window, nullptr);
+  if (!m_surface)
+  {
+    ERROR_LOG_FMT(VIDEO, "Piglet: eglCreateWindowSurface failed ({:#x})", s_egl.GetError());
+    return false;
+  }
+
+  // Piglet's version string says ES 2.0, but the context implements ES 3.0.
+  const EGLint context_attribs[] = {EGL_CONTEXT_CLIENT_VERSION, 3, EGL_NONE};
+  m_context = s_egl.CreateContext(m_display, config, EGL_NO_CONTEXT, context_attribs);
+  if (!m_context)
+  {
+    ERROR_LOG_FMT(VIDEO, "Piglet: eglCreateContext failed ({:#x})", s_egl.GetError());
+    return false;
+  }
+
+  m_opengl_mode = Mode::OpenGLES;
+  m_backbuffer_width = s_window.uWidth;
+  m_backbuffer_height = s_window.uHeight;
+  if (!MakeCurrent())
+    return false;
+  // A swap interval of 1 makes eglSwapBuffers block forever on PS4 (love-ps4).
+  s_egl.SwapInterval(m_display, 0);
+  size_t flexible = 0;
+  using AvailableFlexibleFn = int32_t (*)(size_t*);
+  reinterpret_cast<AvailableFlexibleFn>(&sceKernelAvailableFlexibleMemorySize)(&flexible);
+  char trace[96];
+  snprintf(trace, sizeof(trace), "Piglet: context ready, %zu MiB flexible memory free",
+           flexible / (1024 * 1024));
+  ps4_boot_trace(trace);
+  return true;
+}
+
+bool GLContextPiglet::MakeCurrent()
+{
+  return s_egl.MakeCurrent(m_display, m_surface, m_surface, m_context);
+}
+
+bool GLContextPiglet::ClearCurrent()
+{
+  return s_egl.MakeCurrent(m_display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+}
+
+void GLContextPiglet::Swap()
+{
+  s_egl.SwapBuffers(m_display, m_surface);
+}
+
+void GLContextPiglet::SwapInterval(int interval)
+{
+  // Ignored: see Initialize().
+}
+
+void* GLContextPiglet::GetFuncAddress(const std::string& name)
+{
+  void* address = nullptr;
+  if (sceKernelDlsym(s_piglet_module, name.c_str(), &address) == 0 && address)
+    return address;
+  return reinterpret_cast<void*>(s_egl.GetProcAddress(name.c_str()));
+}
