+++ b/Source/Core/Common/GL/GLInterface/Piglet.h
@@ -0,0 +1,35 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <string>
+
+#include "Common/GL/GLContext.h"
+
+// PS4: OpenGL ES through Piglet, the system's GLES implementation. Piglet reports "OpenGL ES 2.0"
+// but implements OpenGL ES 3.0 (verified on hardware); runtime GLSL compilation needs the devkit
+// Piglet + shader compiler modules (libScePigletv2VSH.sprx, libSceShaccVSH.sprx).
+class GLContextPiglet final : public GLContext
+{
+public:
+  ~GLContextPiglet() override;
+
+  bool IsHeadless() const override;
+
+  bool MakeCurrent() override;
+  bool ClearCurrent() override;
+
+  void Swap() override;
+  void SwapInterval(int interval) override;
+
+  void* GetFuncAddress(const std::string& name) override;
+
+protected:
+  bool Initialize(const WindowSystemInfo& wsi, bool stereo, bool core) override;
+
+private:
+  void* m_display = nullptr;
+  void* m_surface = nullptr;
+  void* m_context = nullptr;
+};
