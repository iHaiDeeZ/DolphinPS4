+
+#include "Core/PowerPC/JitPS4/JitAsm.h"
+
+#include <climits>
+#include <utility>
+
+#include "Common/CommonTypes.h"
+#include "Common/JitRegister.h"
+#include "Common/x64ABI.h"
+#include "Common/x64Emitter.h"
+#include "Core/Config/MainSettings.h"
