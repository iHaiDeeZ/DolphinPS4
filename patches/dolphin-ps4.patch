+// A GameCube memory card, upright, centred on c (h tall): the body, its label and the notch.
+void DrawMemoryCardIcon(ImDrawList* dl, ImVec2 c, float h, ImU32 body, ImU32 label)
+{
+  const float w = h * 0.72f;
+  const ImVec2 a(c.x - w * 0.5f, c.y - h * 0.5f), b(c.x + w * 0.5f, c.y + h * 0.5f);
+  dl->AddRectFilled(a, b, body, h * 0.08f);
+  dl->AddRectFilled(ImVec2(a.x + w * 0.14f, a.y + h * 0.16f), ImVec2(b.x - w * 0.14f, c.y + h * 0.1f),
+                    label, h * 0.04f);
+  // The connector edge at the bottom.
+  for (int i = 0; i < 4; i++)
+  {
+    const float x = a.x + w * (0.2f + i * 0.17f);
+    dl->AddRectFilled(ImVec2(x, b.y - h * 0.14f), ImVec2(x + w * 0.09f, b.y - h * 0.04f), label);
+  }
+}
