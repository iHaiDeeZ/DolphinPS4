+const Theme& Menu::CurrentTheme() const
+{
+  // The GameCube and Wii menu styles have their own colours on every tab.
+  if (m_prefs.style == "gamecube")
+    return THEMES[1];  // GameCube Indigo
+  if (m_prefs.style == "wii")
+    return THEMES[2];  // Wii White
+  for (const Theme& theme : THEMES)
+  {
+    if (m_prefs.theme == theme.name)
+      return theme;
+  }
+  return THEMES[0];
+}
