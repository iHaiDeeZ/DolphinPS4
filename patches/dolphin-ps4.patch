+void Menu::OpenControlsList(PS4Controls::Device device, const std::string& game_id)
+{
+  m_panel = {};
+  m_panel.open = true;
+  m_panel.title = PS4Controls::DeviceName(device);
+  m_controls_device = static_cast<int>(device);
+  m_controls_game = game_id;
+  PS4Controls::EditGame(PS4Controls::HasGameProfile(game_id) ? game_id : "");
+  BuildControlRows();
+  m_panel.selected = 0;
+}
+
+void Menu::BuildControlRows()
+{
+  const auto device = static_cast<PS4Controls::Device>(m_controls_device);
+  std::vector<SettingRow> rows;
+  const auto& bindings = PS4Controls::Bindings(device);
+  if (!m_controls_game.empty())
+  {
+    rows.push_back({"Apply To",
+                    PS4Controls::HasGameProfile(m_controls_game) ? "This Game" : "All Games",
+                    "__ctlscope__", false, true});
+  }
+  for (size_t i = 0; i < bindings.size(); i++)
+  {
+    const std::string value = PS4Controls::Get(device, bindings[i]);
+    SettingRow row{bindings[i].label,
+                   bindings[i].stick_group ? value : PS4Controls::Describe(value),
+                   "ctl:" + std::to_string(i)};
+    row.glyph = value;
+    rows.push_back(std::move(row));
+  }
+  rows.push_back({"", "", "", true});
+  rows.push_back({"Reset to Default", "", "__ctlreset__"});
+  m_panel.rows = std::move(rows);
+}
+
+void Menu::OpenCheatsList(const Game& game)
+{
+  m_panel = {};
+  m_panel.open = true;
+  m_panel.title = "Cheats";
+  m_cheats_game = game.id;
+  m_cheats.Load(game.id, game.revision);
+  BuildCheatRows();
+  if (m_panel.rows.empty())
+    m_panel.lines = {"", "No cheats for this game.", "",
+                     "Dolphin's cheat database has none for " + game.id + "."};
+  m_panel.selected = 0;
+  MoveSettingRow(0);
+}
+
+// Riivolution: mods as on a Wii's SD card, in User/Load/Riivolution (its riivolution folder with
+// the XMLs, and the mod's own folders). The choices go in riivolution/config/<ID4>.xml, the file
+// Riivolution and Dolphin on PC use; the game process applies them (MainNoGUI).
+// The list the game saved the last time it ran with RetroAchievements (PS4Achievements).
+void Menu::OpenAchievementList(const Game& game)
+{
+  OpenAchievementKey(game.id.empty() ? game.title : game.id);
+}
+
+void Menu::OpenAchievementKey(const std::string& key)
+{
+  m_ach_view = {};
+  PS4Achievements::Load(m_data_dir, key, &m_ach_view);
+  m_panel = {};
+  m_panel.open = true;
+  m_panel.setting = SET_ACHVIEW;
+  m_panel.title = "Achievements";
+  std::vector<SettingRow> rows;
+  SettingRow summary;
+  summary.label = std::to_string(m_ach_view.unlocked) + " of " + std::to_string(m_ach_view.total) +
+                  " unlocked  -  " + std::to_string(m_ach_view.points) + " / " +
+                  std::to_string(m_ach_view.points_total) + " points" +
+                  (m_ach_view.hardcore ? "  -  Hardcore" : "");
+  summary.header = true;
+  rows.push_back(summary);
+  for (int pass = 0; pass < 2; pass++)
+  {
+    const bool unlocked = pass == 0;
+    bool any = false;
+    for (size_t i = 0; i < m_ach_view.entries.size(); i++)
+    {
+      const PS4Achievements::Entry& entry = m_ach_view.entries[i];
+      if (entry.unlocked != unlocked)
+        continue;
+      if (!any)
+      {
+        SettingRow header;
+        header.label = unlocked ? "Unlocked" : "Locked";
+        header.header = true;
+        rows.push_back(header);
+        any = true;
+      }
+      SettingRow row;
+      row.label = entry.title.size() > 40 ? entry.title.substr(0, 37) + "..." : entry.title;
+      row.value = std::to_string(entry.points) + " pts";
+      row.key = "ach:" + std::to_string(i);
+      row.note = unlocked;  // gold points: earned
+      row.icon = BadgeTexture(PS4Achievements::BadgePath(m_data_dir, entry.badge, !unlocked));
+      rows.push_back(row);
+    }
+  }
+  m_panel.rows = std::move(rows);
+  m_panel.selected = 0;
+  MoveSettingRow(0);
+}
