+    clock_gettime(CLOCK_MONOTONIC, &t0);
+    ac_ps4_wait_submission(flip.seq);
+    clock_gettime(CLOCK_MONOTONIC, &t1);
+    const int r = sceVideoOutSubmitFlip(s_video, static_cast<int>(flip.image), flip.mode, flip.arg);
+    clock_gettime(CLOCK_MONOTONIC, &t2);
