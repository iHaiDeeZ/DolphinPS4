+
+namespace PS4Jit
+{
+
+using namespace Gen;
+
+extern "C" int ps4_fifo_batch;  // VideoCommon/Fifo.cpp (ps4.ini fifo_batch)
+extern "C" int ps4_fifo_defer;  // VideoCommon/Fifo.cpp (ps4.ini fifo_defer)
+extern "C" void ps4_boot_trace(const char* line);  // DolphinPS4 port/ps4_crashlog.cpp
+extern "C" int ps4_gp_fuse;     // ps4.ini jit_gp_fuse (DolphinNoGUI)
+extern "C" int ps4_jit_accurate_singles;  // ps4.ini jit_accurate_singles (DolphinNoGUI)
+extern "C" int ps4_lazy_lfs;    // ps4.ini jit_lazy_lfs (DolphinNoGUI)
+// ps4.ini jit_inline_dispatch (Dolphin Lab): indirect block exits look their target up themselves.
+extern "C" int ps4_jit_inline_dispatch;
+// ps4.ini jit_lazy_pc (Dolphin Lab): a block exit to a known address stores the PC only on its way
+// to the dispatcher or the timing code, not when it jumps straight into the next block (which sets
+// it itself wherever it is read: exception exits, slow memory accesses, its own timing check).
+// 2-3% of the JIT's instructions in profiles were these stores.
+extern "C" int ps4_jit_lazy_pc;
+extern "C" int ps4_jit_tlb_inline;  // ps4.ini jit_tlb_inline (DolphinNoGUI): EmuCodeBlock.cpp
+extern "C" int ps4_lfs_forward;  // ps4.ini jit_lfs_forward (DolphinNoGUI)
+using namespace PowerPC;
+
+// Dolphin's PowerPC->x86_64 JIT dynamic recompiler
+// Written mostly by ector (hrydgard)
+// Features:
+// * Basic block linking
+// * Fast dispatcher
+
+// Unfeatures:
+// * Does not recompile all instructions - sometimes falls back to inserting a CALL to the
+// corresponding Interpreter function.
+
+// Open questions
+// * Should there be any statically allocated registers? r3, r4, r5, r8, r0 come to mind.. maybe sp
+// * Does it make sense to finish off the remaining non-jitted instructions? Seems we are hitting
+// diminishing returns.
+
+// Other considerations
+//
+// We support block linking. Reserve space at the exits of every block for a full 5-byte jmp. Save
+// 16-bit offsets
+// from the starts of each block, marking the exits so that they can be nicely patched at any time.
+//
+// Blocks do NOT use call/ret, they only jmp to each other and to the dispatcher when necessary.
+//
+// All blocks that can be precompiled will be precompiled. Code will be memory protected - any write
+// will mark
+// the region as non-compilable, and all links to the page will be torn out and replaced with
+// dispatcher jmps.
+//
+// Alternatively, icbi instruction SHOULD mark where we can't compile
+//
+// Seldom-happening events is handled by adding a decrement of a counter to all blr instructions
+// (which are
+// expensive anyway since we need to return to dispatcher, except when they can be predicted).
+
+// TODO: SERIOUS synchronization problem with the video backend setting tokens and breakpoints in
+// dual core mode!!!
+//       Somewhat fixed by disabling idle skipping when certain interrupts are enabled
+//       This is no permanent reliable fix
+// TODO: Zeldas go whacko when you hang the gfx thread
+
+// Idea - Accurate exception handling
+// Compute register state at a certain instruction by running the JIT in "dry mode", and stopping at
+// the right place.
+// Not likely to be done :P
+
+// Optimization Ideas -
+/*
+  * Assume SP is in main RAM (in Wii mode too?) - partly done
+  * Assume all floating point loads and double precision loads+stores are to/from main ram
+    (single precision stores can be used in write gather pipe, specialized fast check added)
+  * AMD only - use movaps instead of movapd when loading ps from memory?
+  * HLE functions like floorf, sin, memcpy, etc - they can be much faster
+  * ABI optimizations - drop F0-F13 on blr, for example. Watch out for context switching.
+    CR2-CR4 are non-volatile, rest of CR is volatile -> dropped on blr.
+  R5-R12 are volatile -> dropped on blr.
+  * classic inlining across calls.
+  * Track which registers a block clobbers without using, then take advantage of this knowledge
+    when compiling a block that links to that block.
+  * Track more dependencies between instructions, e.g. avoiding PPC_FP code, single/double
+    conversion, movddup on non-paired singles, etc where possible.
+  * Support loads/stores directly from xmm registers in jit_util and the backpatcher; this might
+    help AMD a lot since gpr/xmm transfers are slower there.
+  * Smarter register allocation in general; maybe learn to drop values once we know they won't be
+    used again before being overwritten?
+  * More flexible reordering; there's limits to how far we can go because of exception handling
+    and such, but it's currently limited to integer ops only. This can definitely be made better.
+*/
+
+JitPS4::JitPS4(Core::System& system)
+    : JitBase(system), QuantizedMemoryRoutines(*this)
+{
+}
+
+JitPS4::~JitPS4() = default;
+
+bool JitPS4::HandleFault(uintptr_t access_address, SContext* ctx)
+{
+  const uintptr_t stack_guard = reinterpret_cast<uintptr_t>(m_stack_guard);
+  // In the trap region?
+  if (m_enable_blr_optimization && access_address >= stack_guard &&
+      access_address < stack_guard + GUARD_SIZE)
+  {
+    return HandleStackFault();
+  }
+
+  // This generates some fairly heavy trampolines, but it doesn't really hurt.
+  // Only instructions that access I/O will get these, and there won't be that
+  // many of them in a typical program/game.
+
+  auto& memory = m_system.GetMemory();
+
+  if (memory.IsAddressInFastmemArea(reinterpret_cast<u8*>(access_address)))
+  {
+    auto& ppc_state = m_system.GetPPCState();
+    const uintptr_t memory_base = reinterpret_cast<uintptr_t>(
+        ppc_state.msr.DR ? memory.GetLogicalBase() : memory.GetPhysicalBase());
+
+    if (access_address < memory_base || access_address >= memory_base + 0x1'0000'0000)
+    {
+      WARN_LOG_FMT(DYNA_REC,
+                   "JitPS4 address calculation overflowed! Please report if this happens a lot. "
+                   "PC {:#018x}, access address {:#018x}, memory base {:#018x}, MSR.DR {}",
+                   ctx->CTX_PC, access_address, memory_base, ppc_state.msr.DR);
+    }
+
+    return BackPatch(ctx);
+  }
+
+  return false;
+}
+
+bool JitPS4::BackPatch(SContext* ctx)
+{
+  u8* codePtr = reinterpret_cast<u8*>(ctx->CTX_PC);
+
+  if (!IsInSpace(codePtr))
+    return false;  // this will become a regular crash real soon after this
+
+  auto it = m_back_patch_info.find(codePtr);
+  if (it == m_back_patch_info.end())
+  {
+    PanicAlertFmt("BackPatch: no register use entry for address {}", fmt::ptr(codePtr));
+    return false;
+  }
+
+  TrampolineInfo& info = it->second;
+
+  u8* exceptionHandler = nullptr;
+  if (jo.memcheck)
+  {
+    auto it2 = m_exception_handler_at_loc.find(codePtr);
+    if (it2 != m_exception_handler_at_loc.end())
+      exceptionHandler = it2->second;
+  }
+
+  // In the trampoline code, we jump back into the block at the beginning
+  // of the next instruction. The next instruction comes immediately
+  // after the backpatched operation, or BACKPATCH_SIZE bytes after the start
+  // of the backpatched operation, whichever comes last. (The JIT inserts NOPs
+  // into the original code if necessary to ensure there is enough space
+  // to insert the backpatch jump.)
+
+  js.generatingTrampoline = true;
+  js.trampolineExceptionHandler = exceptionHandler;
+  js.compilerPC = info.pc;
+
+  // Generate the trampoline.
+  const u8* trampoline = trampolines.GenerateTrampoline(info);
+  js.generatingTrampoline = false;
+  js.trampolineExceptionHandler = nullptr;
+
+  u8* start = info.start;
+
+  // Patch the original memory operation.
+  XEmitter emitter(start, start + info.len);
+  emitter.JMP(trampoline);
+  // NOPs become dead code
+  const u8* end = info.start + info.len;
+  for (const u8* i = emitter.GetCodePtr(); i < end; ++i)
+    emitter.INT3();
+
+  // Rewind time to just before the start of the write block. If we swapped memory
+  // before faulting (eg: the store+swap was not an atomic op like MOVBE), let's
+  // swap it back so that the swap can happen again (this double swap isn't ideal but
+  // only happens the first time we fault).
+  if (info.nonAtomicSwapStoreSrc != Gen::INVALID_REG)
+  {
+    u64* ptr = ContextRN(ctx, info.nonAtomicSwapStoreSrc);
+    switch (info.accessSize << 3)
+    {
+    case 8:
+      // No need to swap a byte
+      break;
+    case 16:
+      *ptr = Common::swap16(static_cast<u16>(*ptr));
+      break;
+    case 32:
+      *ptr = Common::swap32(static_cast<u32>(*ptr));
+      break;
+    case 64:
+      *ptr = Common::swap64(static_cast<u64>(*ptr));
+      break;
+    default:
+      DEBUG_ASSERT(false);
+      break;
+    }
+  }
+
+  // This is special code to undo the LEA in SafeLoadToReg if it clobbered the address
+  // register in the case where reg_value shared the same location as opAddress.
+  if (info.offsetAddedToAddress)
+  {
+    u64* ptr = ContextRN(ctx, info.op_arg.GetSimpleReg());
+    *ptr = static_cast<u32>(*ptr - info.offset);
+  }
+
+  ctx->CTX_PC = reinterpret_cast<u64>(trampoline);
+
+  return true;
+}
+
+extern "C" int ps4_jit_pin[4];  // ps4.ini jit_pin (DolphinNoGUI/MainNoGUI.cpp)
+
+// jit_join counts (boot-trace at shutdown): branches joined, refused here, fallen back.
+static u64 s_join_bound, s_join_refused, s_join_fallback, s_join_moves;
+
+#ifdef DOLPHIN_PS4_HOST
+// The PC test bench (scripts/build-host-oracle.sh): no ps4.ini and no PS4 port, so the switches
+// come from the environment and the trace goes to stderr.
+extern "C" int ps4_jit_join, ps4_jit_cache;
+extern "C" void ps4_boot_trace(const char* line)
+{
+  fprintf(stderr, "[trace] %s\n", line);
+}
+// PS4JIT_PROF=1: a sampling profile of the bench window (20-50 s): every 0.5 ms of CPU time
+// (ITIMER_PROF), the interrupted thread and instruction address; written to /tmp/ps4jit-prof.txt
+// with /proc/self/maps (scripts: hostprof.py).
+namespace
+{
+struct ProfSample
+{
+  pid_t tid;
+  u64 rip;
+};
+constexpr size_t PROF_MAX = 1 << 20;
+ProfSample* s_prof = nullptr;
+std::atomic<size_t> s_prof_count{0};
+std::atomic<bool> s_prof_on{false};
+
+void ProfHandler(int, siginfo_t*, void* context)
+{
+  if (!s_prof_on.load(std::memory_order_relaxed))
+    return;
+  const size_t i = s_prof_count.fetch_add(1, std::memory_order_relaxed);
+  if (i < PROF_MAX)
+  {
+    s_prof[i].tid = static_cast<pid_t>(syscall(SYS_gettid));
+    s_prof[i].rip = static_cast<ucontext_t*>(context)->uc_mcontext.gregs[REG_RIP];
+  }
+}
+
+// High-resolution sampling of the CPU thread alone (perf_event_open, 20 kHz of its own CPU time,
+// user space only), written for the JIT analysis scripts (jitana: samples.log, jitcode.bin,
+// mem1.bin, the perf map) to /tmp/ps4jit-ana.
+int s_perf_fd = -1;
+void* s_perf_ring = nullptr;
+constexpr size_t PERF_PAGES = 8192;  // 32 MiB: 100 s of samples
+pid_t s_perf_tid = 0;
+
+pid_t FindThread(const char* wanted)
+{
+  pid_t found = 0;
+  if (DIR* dir = opendir("/proc/self/task"))
+  {
+    while (dirent* entry = readdir(dir))
+    {
+      char path[64], name[64] = {};
+      snprintf(path, sizeof(path), "/proc/self/task/%s/comm", entry->d_name);
+      if (FILE* f = fopen(path, "r"))
+      {
+        if (fgets(name, sizeof(name), f) && strncmp(name, wanted, strlen(wanted)) == 0)
+          found = atoi(entry->d_name);
+        fclose(f);
+      }
+    }
+    closedir(dir);
+  }
+  return found;
+}
+
+void PerfStart()
+{
+  s_perf_tid = FindThread("CPU thread");
+  perf_event_attr pe{};
+  pe.type = PERF_TYPE_SOFTWARE;
+  pe.size = sizeof(pe);
+  pe.config = PERF_COUNT_SW_TASK_CLOCK;
+  pe.sample_period = 50000;  // ns
+  pe.sample_type = PERF_SAMPLE_IP;
+  pe.exclude_kernel = 1;
+  pe.exclude_hv = 1;
+  pe.disabled = 1;
+  s_perf_fd = static_cast<int>(syscall(SYS_perf_event_open, &pe, s_perf_tid, -1, -1, 0));
+  if (s_perf_fd < 0)
+  {
+    fprintf(stderr, "[bench] perf_event_open failed\n");
+    return;
+  }
+  s_perf_ring = mmap(nullptr, (1 + PERF_PAGES) * 4096, PROT_READ | PROT_WRITE, MAP_SHARED,
+                     s_perf_fd, 0);
+  ioctl(s_perf_fd, PERF_EVENT_IOC_ENABLE, 0);
+}
+
+void PerfStop(JitPS4& jit)
+{
+  if (s_perf_fd < 0)
+    return;
+  ioctl(s_perf_fd, PERF_EVENT_IOC_DISABLE, 0);
+  auto* meta = static_cast<perf_event_mmap_page*>(s_perf_ring);
+  const u8* data = static_cast<const u8*>(s_perf_ring) + 4096;
+  const u64 size = PERF_PAGES * 4096;
+  const u64 head = meta->data_head;
+  std::map<u64, u64> buckets;  // 128-byte buckets of JIT code
+  std::map<u64, u64> others;
+  u64 total = 0;
+  for (u64 at = meta->data_tail; at < head;)
+  {
+    perf_event_header h;
+    for (size_t k = 0; k < sizeof(h); k++)
+      reinterpret_cast<u8*>(&h)[k] = data[(at + k) % size];
+    if (h.type == PERF_RECORD_SAMPLE)
+    {
+      u64 ip = 0;
+      for (size_t k = 0; k < 8; k++)
+        reinterpret_cast<u8*>(&ip)[k] = data[(at + sizeof(h) + k) % size];
+      total++;
+      buckets[ip & ~u64(127)]++;
+    }
+    at += h.size ? h.size : 8;
+  }
+  mkdir("/tmp/ps4jit-ana", 0755);
+  if (FILE* out = fopen("/tmp/ps4jit-ana/samples.log", "w"))
+  {
+    fprintf(out, "== 20 s, CPU thread: %llu samples, 0 in eboot code (0%%)\n",
+            static_cast<unsigned long long>(total));
+    for (const auto& [bucket, count] : buckets)
+    {
+      fprintf(out, "   %.4f%% jit 0x%llx\n", 100.0 * count / std::max<u64>(total, 1),
+              static_cast<unsigned long long>(bucket));
+    }
+    fclose(out);
+  }
+  // The JIT's code (64 KiB chunks that hold anything), and MEM1.
+  if (FILE* out = fopen("/tmp/ps4jit-ana/jitcode.bin", "wb"))
+  {
+    for (const auto& [start, length] :
+         {std::pair<const u8*, size_t>{jit.GetRegionStart(), jit.GetRegionSize()},
+          std::pair<const u8*, size_t>{jit.PS4FarRegionStart(), jit.PS4FarRegionSize()}})
+    {
+      // Chunks on 64 KiB boundaries (the scripts look code up that way).
+      const u8* first = reinterpret_cast<const u8*>(
+          (reinterpret_cast<uintptr_t>(start) + 0xFFFF) & ~uintptr_t(0xFFFF));
+      for (size_t off = first - start; off + 0x10000 <= length; off += 0x10000)
+      {
+        const u8* chunk = start + off;
+        bool used = false;
+        for (size_t k = 0; k < 0x10000 && !used; k += 64)
+          used = chunk[k] != 0 || chunk[k + 8] != 0;
+        if (!used)
+          continue;
+        const u64 header[2] = {reinterpret_cast<u64>(chunk), 0x10000};
+        fwrite(header, sizeof(header), 1, out);
+        fwrite(chunk, 0x10000, 1, out);
+      }
+    }
+    fclose(out);
+  }
+  if (FILE* out = fopen("/tmp/ps4jit-ana/mem1.bin", "wb"))
+  {
+    auto& memory = jit.m_system.GetMemory();
+    fwrite(memory.GetRAM(), memory.GetRamSizeReal(), 1, out);
+    fclose(out);
+  }
+  fprintf(stderr, "[bench] perf profile: %llu CPU thread samples in /tmp/ps4jit-ana\n",
+          static_cast<unsigned long long>(total));
+}
+
+void ProfStart()
+{
+  s_prof = static_cast<ProfSample*>(calloc(PROF_MAX, sizeof(ProfSample)));
+  struct sigaction action{};
+  action.sa_sigaction = ProfHandler;
+  action.sa_flags = SA_SIGINFO | SA_RESTART;
+  sigaction(SIGPROF, &action, nullptr);
+  itimerval timer{};
+  timer.it_interval.tv_usec = 500;
+  timer.it_value.tv_usec = 500;
+  setitimer(ITIMER_PROF, &timer, nullptr);
+  s_prof_on = true;
+}
+
+void ProfStop()
+{
+  s_prof_on = false;
+  itimerval timer{};
+  setitimer(ITIMER_PROF, &timer, nullptr);
+  FILE* out = fopen("/tmp/ps4jit-prof.txt", "w");
+  if (!out)
+    return;
+  const size_t n = std::min(s_prof_count.load(), PROF_MAX);
+  for (size_t i = 0; i < n; i++)
+    fprintf(out, "%d %llx\n", s_prof[i].tid, static_cast<unsigned long long>(s_prof[i].rip));
+  // Thread names and the memory map, for the analysis.
+  if (DIR* dir = opendir("/proc/self/task"))
+  {
+    while (dirent* entry = readdir(dir))
+    {
+      if (entry->d_name[0] == '.')
+        continue;
+      char path[64], name[64] = {};
+      snprintf(path, sizeof(path), "/proc/self/task/%s/comm", entry->d_name);
+      if (FILE* f = fopen(path, "r"))
+      {
+        if (fgets(name, sizeof(name), f))
+          name[strcspn(name, "\n")] = 0;
+        fclose(f);
+      }
+      fprintf(out, "thread %s %s\n", entry->d_name, name);
+    }
+    closedir(dir);
+  }
+  if (FILE* maps = fopen("/proc/self/maps", "r"))
+  {
+    char line[512];
+    while (fgets(line, sizeof(line), maps))
+      fprintf(out, "map %s", line);
+    fclose(maps);
+  }
+  fclose(out);
+  fprintf(stderr, "[bench] profile: %zu samples in /tmp/ps4jit-prof.txt\n", n);
+}
+}  // namespace
+
+#endif
+
+// jit_trace (Dolphin Lab, PPCAnalyst OPTION_PS4_TRACE) learns in two phases, like IA-32 EL's hot code
+// translation: a newly compiled block counts its runs and where its exits go; after PS4_TRACE_RUNS
+// runs it asks to be compiled again (JitPS4::PS4Retrace), following the conditional branches that
+// left to their target in at least 70% of its runs - the hot path then stays in one block, and the
+// recompiled block counts nothing. (PC test bench: PS4JIT_COUNT=1 counts every block for
+// /tmp/ps4jit-ana/blocks.txt: "B address instructions runs", "E destination count source".)
+constexpr u64 PS4_TRACE_RUNS = 1000;
+struct CountExit
+{
+  u32 destination;
+  u32 source;
+  u64 count = 0, base = 0;
+};
+struct CountBlock
+{
+  u32 address = 0, instructions = 0;
+  u64 runs = 0, base = 0;
+  std::vector<std::unique_ptr<CountExit>> exits;
+};
+std::mutex s_count_mutex;
+std::vector<std::unique_ptr<CountBlock>> s_count_blocks;
+bool s_count_on = false;    // PC test bench: count every block, never retrace
+bool s_trace_learn = false;  // jit_trace: new blocks count, then retrace
+extern "C" int ps4_jit_trace;
+extern "C" bool (*ps4_trace_taken)(u32 src, u32 dest);
+std::unordered_set<u64> s_trace_taken;    // src << 32 | dest: usually taken
+std::unordered_set<u32> s_traced_blocks;  // retraced: compiled without counting
+bool TraceTaken(u32 src, u32 dest)
+{
+  return s_trace_taken.contains((u64(src) << 32) | dest);
+}
+
+#ifdef DOLPHIN_PS4_HOST
+
+void CountSnapshot()
+{
+  std::lock_guard lock(s_count_mutex);
+  for (auto& b : s_count_blocks)
+  {
+    b->base = b->runs;
+    for (auto& e : b->exits)
+      e->base = e->count;
+  }
+}
+
+void CountDump()
+{
+  std::lock_guard lock(s_count_mutex);
+  mkdir("/tmp/ps4jit-ana", 0755);
+  FILE* out = fopen("/tmp/ps4jit-ana/blocks.txt", "w");
+  if (!out)
+    return;
+  for (auto& b : s_count_blocks)
+  {
+    const u64 runs = b->runs - b->base;
+    if (runs == 0)
+      continue;
+    fprintf(out, "B %08x %u %llu\n", b->address, b->instructions,
+            static_cast<unsigned long long>(runs));
+    for (auto& e : b->exits)
+    {
+      if (e->count != e->base)
+      {
+        fprintf(out, "E %08x %llu %08x\n", e->destination,
+                static_cast<unsigned long long>(e->count - e->base), e->source);
+      }
+    }
+  }
+  fclose(out);
+  fprintf(stderr, "[bench] block counts in /tmp/ps4jit-ana/blocks.txt\n");
+}
+
+// The PS4 JIT's switches, with the PS4's defaults (defined in PS4-only files there).
+extern "C" {
+int ps4_fifo_batch = 0, ps4_fifo_defer = 0, ps4_gp_fuse = 1, ps4_jit_accurate_singles = 1,
+    ps4_jit_fcmp_merge = 1, ps4_jit_gp_dynamic = 1, ps4_jit_inline_dispatch = 1,
+    ps4_jit_lazy_pc = 1, ps4_jit_msr_link = 1, ps4_jit_round_operands = 1,
+    ps4_jit_round_results = 1, ps4_jit_tlb_inline = 1, ps4_lazy_lfs = 1, ps4_lfs_forward = 1;
+int ps4_jit_pin[4] = {-1, -1, -1, -1};
+}
+// PS4JIT_TRACE=<blocks.txt of an earlier PS4JIT_COUNT run>: jit_trace from that profile. A branch
+// counts as usually taken when it left to its target in at least PS4JIT_TRACE_P (0.7) of the runs
+// of the blocks holding it.
+void LoadTraceProfile(const char* path)
+{
+  struct Block
+  {
+    u32 start, length;
+    u64 runs;
+  };
+  std::vector<Block> blocks;
+  std::map<u64, u64> taken;
+  FILE* f = fopen(path, "r");
+  if (!f)
+    return;
+  char kind;
+  unsigned a, b, c;
+  unsigned long long n;
+  char line[128];
+  while (fgets(line, sizeof(line), f))
+  {
+    if (sscanf(line, "B %x %u %llu", &a, &b, &n) == 3)
+      blocks.push_back({a, b, n});
+    else if (sscanf(line, "E %x %llu %x", &a, &n, &c) == 3 && a != 0xFFFFFFFF)
+      taken[(u64(c) << 32) | a] += n;
+  }
+  fclose(f);
+  (void)kind;
+  const double threshold = getenv("PS4JIT_TRACE_P") ? atof(getenv("PS4JIT_TRACE_P")) : 0.7;
+  for (const auto& [key, count] : taken)
+  {
+    const u32 src = static_cast<u32>(key >> 32);
+    u64 reach = 0;
+    for (const Block& block : blocks)
+    {
+      if (src >= block.start && src < block.start + 4 * block.length)
+        reach += block.runs;
+    }
+    if (reach && count >= threshold * reach)
+      s_trace_taken.insert(key);
+  }
+  ps4_jit_trace = 1;
+  ps4_trace_taken = TraceTaken;
+  fprintf(stderr, "[bench] jit_trace: %zu usually-taken branches from %s\n", s_trace_taken.size(),
+          path);
+}
+
+extern "C" const char* ps4_boot_disc_path()
+{
+  const char* disc = getenv("PS4JIT_DISC");
+  return disc ? disc : "";
+}
+#endif
+
+void JitPS4::Init()
+{
+#ifdef DOLPHIN_PS4_HOST
+  // PS4JIT_VERIFY=1: the recompiler check. PS4JIT_JOIN=0: no jit_join. PS4JIT_CACHE=1: the code
+  // cache (off by default here: it lives in /data/DolphinPS4).
+  m_ps4_bench_start = std::chrono::steady_clock::now();
+  m_ps4_bench_thread = pthread_self();
+  s_count_on = getenv("PS4JIT_COUNT") != nullptr;
+  // PS4JIT_TRACE=auto: jit_trace as on the PS4; PS4JIT_TRACE=<blocks.txt>: from that profile.
+  if (const char* profile = getenv("PS4JIT_TRACE"))
+  {
+    if (strcmp(profile, "auto") == 0)
+      ps4_jit_trace = 1;
+    else
+      LoadTraceProfile(profile);
+  }
+  else
+  {
+    ps4_jit_trace = 0;
+  }
+  // Every 10 s: the CPU thread's CPU time and the emulated cycles so far (the run is stopped from
+  // outside, and some games don't shut down cleanly here).
+  if (getenv("PS4JIT_BENCH"))
+  {
+    std::thread([this, thread = m_ps4_bench_thread] {
+      clockid_t clock;
+      if (pthread_getcpuclockid(thread, &clock) != 0)
+        return;
+      const bool profile = getenv("PS4JIT_PROF") != nullptr;
+      for (int n = 1;; n++)
+      {
+        std::this_thread::sleep_for(std::chrono::seconds(10));
+        if (profile && n == 2)
+          PerfStart();
+        if (profile && n == 5)
+          PerfStop(*this);
+        if (s_count_on && n == 2)
+          CountSnapshot();
+        if (s_count_on && n == 5)
+          CountDump();
+        timespec cpu{};
+        clock_gettime(clock, &cpu);
+        fprintf(stderr, "[bench] %d s: %u frames (%u XFB copies), CPU thread %.3f s, %.0f M cycles\n", n * 10,
+                ps4_bench_frames.load(), ps4_bench_xfb_copies.load(), cpu.tv_sec + cpu.tv_nsec / 1e9,
+                m_system.GetCoreTiming().GetTicks() / 1e6);
+      }
+    }).detach();
+  }
+  if (const char* v = getenv("PS4JIT_VERIFY"))
+    ps4_jit_verify = atoi(v);
+  if (const char* v = getenv("PS4JIT_JOIN"))
+    ps4_jit_join = atoi(v);
+  // PS4JIT_SINGLES=0: jit_accurate_singles=off (Float Rounding off).
+  if (const char* v = getenv("PS4JIT_SINGLES"))
+  {
+    ps4_jit_accurate_singles = atoi(v);
+    ps4_jit_round_results = ps4_jit_round_operands = ps4_jit_accurate_singles;
+  }
+  // PS4JIT_PIN=1,31,3,30: jit_pin.
+  if (const char* v = getenv("PS4JIT_PIN"))
+  {
+    for (int k = 0; k < 4; k++)
+      ps4_jit_pin[k] = -1;
+    int k = 0;
+    for (const char* p = v; *p && k < 4;)
+    {
+      ps4_jit_pin[k++] = atoi(p);
+      while (*p && *p != ',')
+        p++;
+      if (*p == ',')
+        p++;
+    }
+  }
+  ps4_jit_cache = getenv("PS4JIT_CACHE") ? atoi(getenv("PS4JIT_CACHE")) : 0;
+#endif
+  s_ps4_active = this;
+  // jit_trace: the analyzer asks which branches are usually taken; new blocks learn it.
+  s_trace_learn = ps4_jit_trace && !s_count_on && s_trace_taken.empty();
+  if (ps4_jit_trace)
+    ps4_trace_taken = TraceTaken;
+  m_code_cache.Start();
+  InitFastmemArena();
+
+  RefreshConfig();
+
+  // Deferred FIFO flushes broke the games that need MMU emulation (Spider-Man 2 and Call of Duty
+  // 2: Big Red One: the GPU command stream lost its place a few seconds in and the game froze),
+  // so they're off for those games; the other command-stream shortcuts stay on.
+  if (m_system.IsMMUMode() && ps4_fifo_defer)
+  {
+    ps4_fifo_defer = 0;
+    ps4_boot_trace("fifo_defer: off (the game needs MMU emulation)");
+  }
+
+  EnableBlockLink();
+
+  jo.optimizeGatherPipe = true;
+  // ps4.ini jit_accurate_singles=off (per game): single-precision results are not rounded back
+  // through single precision, and multiplies skip the 25-bit operand rounding. Dolphin: "Most
+  // games don't need these. Zelda requires it" - on Jaguar each rounding is a slow
+  // cvtsd2ss/cvtss2sd round trip on the dependency chain.
+  jo.accurateSinglePrecision = ps4_jit_accurate_singles != 0;
+  js.fastmemLoadStore = nullptr;
+  js.compilerPC = 0;
+
+  gpr.SetEmitter(this);
+  fpr.SetEmitter(this);
+
+  const size_t routines_size = asm_routines.CODE_SIZE;
+  const size_t trampolines_size = jo.memcheck ? TRAMPOLINE_CODE_SIZE_MMU : TRAMPOLINE_CODE_SIZE;
+  const size_t farcode_size = jo.memcheck ? FARCODE_SIZE_MMU : FARCODE_SIZE;
+  const size_t constpool_size = m_const_pool.CONST_POOL_SIZE;
+  AllocCodeSpace(CODE_SIZE + routines_size + trampolines_size + farcode_size + constpool_size);
+  AddChildCodeSpace(&asm_routines, routines_size);
+  AddChildCodeSpace(&trampolines, trampolines_size);
+  AddChildCodeSpace(&m_far_code, farcode_size);
+  m_const_pool.Init(AllocChildCodeSpace(constpool_size), constpool_size);
+  ResetCodePtr();
+
+  InitBLROptimization();
+
+  m_stack_guard = nullptr;
+
+  blocks.Init();
+  {
+    // jit_pin (see RegCache::SetPinned): before the dispatcher is generated - it stores and
+    // reloads these. Not with MMU emulation (revertable register bindings).
+    static constexpr X64Reg PIN_HOSTS[] = {R12, R13, R14, R15};
+    m_ps4_pins.clear();
+    gpr.ClearPinned();
+    std::string pins;
+    // (With the recompiler check too: the pinned registers are written to ppcState for it.)
+    for (int k = 0; k < 4 && !jo.memcheck; k++)
+    {
+      if (ps4_jit_pin[k] < 0 || ps4_jit_pin[k] > 31)
+        continue;
+      m_ps4_pins.emplace_back(static_cast<u32>(ps4_jit_pin[k]), PIN_HOSTS[m_ps4_pins.size()]);
+      gpr.SetPinned(ps4_jit_pin[k], m_ps4_pins.back().second);
+      pins += " r" + std::to_string(ps4_jit_pin[k]);
+    }
+    if (!pins.empty())
+      ps4_boot_trace(("jit: pinned guest registers" + pins + " (R12-R15)").c_str());
+  }
+  asm_routines.Init();
+
+  // important: do this *after* generating the global asm routines, because we can't use farcode in
+  // them.
+  // it'll crash because the farcode functions get cleared on JIT clears.
+  m_far_code.Init();
+  Clear();
+
+  code_block.m_stats = &js.st;
+  code_block.m_gpa = &js.gpa;
+  code_block.m_fpa = &js.fpa;
+  EnableOptimization();
+
+  ResetFreeMemoryRanges();
+}
+
+void JitPS4::ClearCache()
+{
+  {
+    // Every full reset is a visible stutter (all code compiled again): in the boot trace.
+    static int s_clears = 0;
+    char line[64];
+    snprintf(line, sizeof(line), "jit: code cache cleared (%d)", ++s_clears);
+    ps4_boot_trace(line);
+  }
+  blocks.Clear();
+  blocks.ClearRangesToFree();
+  trampolines.ClearCodeSpace();
+  m_far_code.ClearCodeSpace();
+  m_const_pool.Clear();
+  ClearCodeSpace();
+  Clear();
+  RefreshConfig();
+  asm_routines.Regenerate();
+  ResetFreeMemoryRanges();
+  Host_JitCacheInvalidation();
+}
+
+void JitPS4::FreeRanges()
+{
+  // Check if any code blocks have been freed in the block cache and transfer this information to
+  // the local rangesets to allow overwriting them with new code.
+  for (const auto& [from, to] : blocks.GetRangesToFreeNear())
+    m_free_ranges_near.insert(from, to);
+  for (const auto& [from, to] : blocks.GetRangesToFreeFar())
+    m_free_ranges_far.insert(from, to);
+  blocks.ClearRangesToFree();
+}
+
+void JitPS4::ResetFreeMemoryRanges()
+{
+  // Set the entire near and far code regions as unused.
+  m_free_ranges_near.clear();
+  m_free_ranges_near.insert(region, region + region_size);
+  m_free_ranges_far.clear();
+  m_free_ranges_far.insert(m_far_code.GetWritableCodePtr(), m_far_code.GetWritableCodeEnd());
+}
+
+void JitPS4::Shutdown()
+{
+  if (ps4_jit_verify)
+    VerifySummary();
+  {
+    char line[160];
+    snprintf(line, sizeof(line),
+             "jit join: %llu branches joined (%llu bytes of moves), %llu refused, %llu fell back",
+             static_cast<unsigned long long>(s_join_bound),
+             static_cast<unsigned long long>(s_join_moves),
+             static_cast<unsigned long long>(s_join_refused),
+             static_cast<unsigned long long>(s_join_fallback));
+    ps4_boot_trace(line);
+  }
+#ifdef DOLPHIN_PS4_HOST
+  // The PC test bench's measure: emulated CPU cycles per second of real time.
+  {
+    const double seconds =
+        std::chrono::duration<double>(std::chrono::steady_clock::now() - m_ps4_bench_start).count();
+    const u64 ticks = m_system.GetCoreTiming().GetTicks();
+    // The CPU thread's own CPU time (the JIT's code runs there).
+    timespec cpu{};
+    clockid_t clock;
+    if (pthread_getcpuclockid(m_ps4_bench_thread, &clock) == 0 && clock_gettime(clock, &cpu) == 0)
+    {
+      fprintf(stderr, "[bench] CPU thread %.2f s of CPU time\n", cpu.tv_sec + cpu.tv_nsec / 1e9);
+    }
+    fprintf(stderr, "[bench] %.0f million emulated cycles in %.1f s: %.1f M/s\n", ticks / 1e6,
+            seconds, ticks / 1e6 / seconds);
+  }
+#endif
+  m_code_cache.Stop();
+  if (s_ps4_active == this)
+    s_ps4_active = nullptr;
+  FreeCodeSpace();
+
+  auto& memory = m_system.GetMemory();
+  memory.ShutdownFastmemArena();
+
+  blocks.Shutdown();
+  m_far_code.Shutdown();
+  m_const_pool.Shutdown();
+}
+
+void JitPS4::PS4StorePinned()
+{
+  for (const auto& [guest, host] : m_ps4_pins)
+    MOV(32, PPCSTATE_GPR(guest), R(host));
+}
+
+void JitPS4::PS4LoadPinned()
+{
+  for (const auto& [guest, host] : m_ps4_pins)
+    MOV(32, R(host), PPCSTATE_GPR(guest));
+}
+
+void JitPS4::FallBackToInterpreter(UGeckoInstruction inst)
+{
+  FlushCarry();
+  gpr.Flush(BitSet32(0xFFFFFFFF), RegCache::FlushMode::Full,
+            RegCache::IgnoreDiscardedRegisters::Yes);
+  fpr.Flush(BitSet32(0xFFFFFFFF), RegCache::FlushMode::Full,
+            RegCache::IgnoreDiscardedRegisters::Yes);
+
+  if (js.op->canEndBlock)
+  {
+    MOV(32, PPCSTATE(pc), Imm32(js.compilerPC));
+    MOV(32, PPCSTATE(npc), Imm32(js.compilerPC + 4));
+  }
+
+  Interpreter::Instruction instr = Interpreter::GetInterpreterOp(inst);
+  PS4StorePinned();  // the interpreter reads and writes ppcState
+  ABI_PushRegistersAndAdjustStack({}, 0);
+  ABI_CallFunctionPC(instr, &m_system.GetInterpreter(), inst.hex);
+  ABI_PopRegistersAndAdjustStack({}, 0);
+  PS4LoadPinned();
+
+  // If the instruction wrote to any registers which were marked as discarded,
+  // we must mark them as no longer discarded
+  gpr.Reset(js.op->regsOut);
+  fpr.Reset(js.op->GetFregsOut());
+
+  // We must also update constant propagation
+  m_constant_propagation.ClearGPRs(js.op->regsOut);
+
+  if (js.op->opinfo->flags & FL_SET_MSR)
+    EmitUpdateMembase();
+
+  if (js.op->canEndBlock)
+  {
+    if (js.isLastInstruction)
+    {
+      MOV(32, R(RSCRATCH), PPCSTATE(npc));
+      MOV(32, PPCSTATE(pc), R(RSCRATCH));
+      WriteExceptionExit();
+    }
+    else
+    {
+      MOV(32, R(RSCRATCH), PPCSTATE(npc));
+      CMP(32, R(RSCRATCH), Imm32(js.compilerPC + 4));
+      FixupBranch c = J_CC(CC_Z);
+      MOV(32, PPCSTATE(pc), R(RSCRATCH));
+      WriteExceptionExit();
+      SetJumpTarget(c);
+    }
+  }
+  else if (ShouldHandleFPExceptionForInstruction(js.op))
+  {
+    TEST(32, PPCSTATE(Exceptions), Imm32(EXCEPTION_PROGRAM));
+    FixupBranch exception = J_CC(CC_NZ, Jump::Near);
+
+    SwitchToFarCode();
+    SetJumpTarget(exception);
+
+    RCForkGuard gpr_guard = gpr.Fork();
+    RCForkGuard fpr_guard = fpr.Fork();
+
+    gpr.Flush();
+    fpr.Flush();
+
+    MOV(32, PPCSTATE(pc), Imm32(js.op->address));
+    WriteExceptionExit();
+    SwitchToNearCode();
+  }
+}
+
+void JitPS4::HLEFunction(u32 hook_index)
+{
+  gpr.Flush();
+  fpr.Flush();
+  PS4StorePinned();
+  ABI_PushRegistersAndAdjustStack({}, 0);
+  ABI_CallFunctionCCP(HLE::ExecuteFromJIT, js.compilerPC, hook_index, &m_system);
+  ABI_PopRegistersAndAdjustStack({}, 0);
+  PS4LoadPinned();
+}
+
+void JitPS4::DoNothing(UGeckoInstruction _inst)
+{
+  // Yup, just don't do anything.
+}
+
+// sync / isync / tlbsync: apply page table changes deferred by tlbie (MMU::InvalidateTLBEntry).
+void JitPS4::PS4SyncPageTable(UGeckoInstruction inst)
+{
+  gpr.Flush(BitSet32::AllTrue(32), RegCache::FlushMode::Full,
+            RegCache::IgnoreDiscardedRegisters::Yes);
+  fpr.Flush(BitSet32::AllTrue(32), RegCache::FlushMode::Full,
+            RegCache::IgnoreDiscardedRegisters::Yes);
+  CMP(8, PPCSTATE(pagetable_update_pending), Imm8(0));
+  FixupBranch not_pending = J_CC(CC_E);
+  ABI_CallFunctionP(&PowerPC::MMU::PageTableUpdatedFromJit, &m_system.GetMMU());
+  SetJumpTarget(not_pending);
+}
+
+// PS4: lfs -> stfs forwarding. Games copy single-precision data with lfs/stfs (Crash Bandicoot:
+// The Wrath of Cortex sends its vertices to the gather pipe that way, ~9% of the CPU thread).
+// Each lfs converts single -> double and each stfs converts back (bit-exactly, which takes about
+// 20 x86 instructions per value on this path). When the stored register still holds what an lfs
+// in this block loaded, the stfs can store the loaded bits themselves: lfs keeps its 32 bits in
+// ppcState, stfs reloads them. Bit-exact by construction (the original memory contents).
+void JitPS4::PS4AnalyzeRawSingles(u32 num_instructions)
+{
+  m_ps4_raw_single.assign(num_instructions, 0);
+  m_ps4_raw_only.assign(num_instructions, BitSet32{});
+  if (!ps4_lfs_forward)
+    return;
+  const auto is_lfs = [](UGeckoInstruction inst) {
+    // lfs, lfsu, lfsx, lfsux. lfs/lfsu with rA = 0 fall back to the interpreter (lfXXX).
+    if (inst.OPCD == 48 || inst.OPCD == 49)
+      return inst.RA != 0;
+    return inst.OPCD == 31 && (inst.SUBOP10 == 535 || inst.SUBOP10 == 567);
+  };
+  const auto is_stfs = [](UGeckoInstruction inst) {
+    // stfs, stfsu, stfsx, stfsux
+    return inst.OPCD == 52 || inst.OPCD == 53 ||
+           (inst.OPCD == 31 && (inst.SUBOP10 == 663 || inst.SUBOP10 == 695));
+  };
+  s32 producer[32];
+  for (s32& p : producer)
+    p = -1;
+  for (u32 i = 0; i < num_instructions; i++)
+  {
+    const PPCAnalyst::CodeOp& op = m_code_buffer[i];
+    // jit_join: a branch inside the block lands here - its registers come from elsewhere too.
+    if (op.ps4_join)
+    {
+      for (s32& p : producer)
+        p = -1;
+    }
+    if (op.skip)
+    {
+      if (op.fregOut >= 0)
+        producer[op.fregOut] = -1;
+      continue;
+    }
+    if (is_stfs(op.inst) && producer[op.inst.RS] >= 0)
+    {
+      m_ps4_raw_single[i] |= 2;
+      m_ps4_raw_single[producer[op.inst.RS]] |= 1;
+    }
+    if (op.fregOut >= 0)
+      producer[op.fregOut] = is_lfs(op.inst) ? static_cast<s32>(i) : -1;
+  }
+
+  // Lazy lfs (flag 4): an lfs whose value is only ever stored by forwarded stfs before the
+  // register is overwritten, in this block, with nothing in between that could leave the block or
+  // flush registers, needs no single -> double conversion at all: the register cache entry is
+  // discarded until the overwrite. (Crash Bandicoot's vertex loops: 6 of 8 loads per vertex.)
+  m_ps4_raw_only.assign(num_instructions, BitSet32{});
+  if (!ps4_lazy_lfs || jo.memcheck || jo.fp_exceptions || jo.div_by_zero_exceptions)
+    return;
+  for (u32 i = 0; i < num_instructions; i++)
+  {
+    const PPCAnalyst::CodeOp& load = m_code_buffer[i];
+    if (load.skip || !is_lfs(load.inst) || !(m_ps4_raw_single[i] & 1) ||
+        js.fifoWriteAddresses.contains(load.address))
+    {
+      continue;
+    }
+    const u32 d = load.inst.RD;
+    u32 overwrite = 0;
+    bool ok = true;
+    for (u32 k = i + 1; k < num_instructions && ok; k++)
+    {
+      const PPCAnalyst::CodeOp& op = m_code_buffer[k];
+      if (op.skip || op.canEndBlock || op.ps4_join ||
+          (op.opinfo->flags & (FL_PROGRAMEXCEPTION | FL_FLOAT_EXCEPTION |
+                               FL_FLOAT_DIV)) ||
+          js.fifoWriteAddresses.contains(op.address) ||
+          (op.inst.OPCD == 31 && op.inst.SUBOP10 == 854) ||  // eieio
+          HLE::TryReplaceFunction(m_ppc_symbol_db, op.address, PowerPC::CoreMode::JIT))
+      {
+        ok = false;
+        break;
+      }
+      if (op.fregsIn[d])
+      {
+        // Only stores of the loaded bits may read it.
+        if (!(is_stfs(op.inst) && op.inst.RS == d && (m_ps4_raw_single[k] & 2)))
+          ok = false;
+        else if (op.fregOut == static_cast<s32>(d))
+          ok = false;
+        continue;
+      }
+      if (op.fregOut == static_cast<s32>(d))
+      {
+        overwrite = k;
+        break;
+      }
+    }
+    if (!ok || overwrite == 0)
+      continue;
+    m_ps4_raw_single[i] |= 4;
+    for (u32 k = i + 1; k <= overwrite; k++)
+      m_ps4_raw_only[k][d] = true;
+  }
+}
+
+// jit_join: whether a conditional forward branch to code further down the block can jump there
+// with the registers where they are: no pinned registers, no MMU (revertable bindings), the carry
+// flag in ppcState, no gather pipe writes waiting for their pointer update, and no register whose
+// value is nowhere (the state there must be one the target's code can be reached from).
+bool JitPS4::PS4CanJoin(const PPCAnalyst::CodeOp& branch) const
+{
+  if (branch.ps4_join_to == 0)
+    return false;
+  const bool ok = m_ps4_pins.empty() && !jo.memcheck && js.carryFlag == CarryFlag::InPPCState &&
+                  js.ps4_gp_pending == 0 && gpr.IsAllUnlocked() && fpr.IsAllUnlocked() &&
+                  !gpr.PS4HasDiscarded() && !fpr.PS4HasDiscarded();
+  if (!ok)
+    s_join_refused++;
+  return ok;
+}
+
+void JitPS4::PS4JoinTaken(const PPCAnalyst::CodeOp& branch, Gen::FixupBranch taken)
+{
+  m_ps4_joins.push_back({branch.ps4_join_to, branch.branchTo, taken, gpr.PS4Save(), fpr.PS4Save(),
+                         m_constant_propagation, js.downcountAmount,
+                         js.firstFPInstructionFound, js.constantGqrValid});
+}
+
+// The instruction at `index` is where branches inside the block land. The code reaching it from
+// above (not taken) first gets to a state the taken branches can reach too: no gather pipe writes
+// waiting, the carry flag in ppcState, no constant a taken branch doesn't know as well. Each taken
+// branch then gets a stub in far code that moves its registers to where this code has them and
+// jumps here.
+void JitPS4::PS4BindJoins(u32 index)
+{
+  if (std::none_of(m_ps4_joins.begin(), m_ps4_joins.end(),
+                   [index](const PS4PendingJoin& join) { return join.target_index == index; }))
+  {
+    return;
+  }
+  PS4CommitGatherPipe(true);
+  if (js.carryFlag != CarryFlag::InPPCState)
+    FlushCarry();
+  bool first_fp = js.firstFPInstructionFound;
+  BitSet8 constant_gqr_valid = js.constantGqrValid;
+  for (preg_t r = 0; r < 32; r++)
+  {
+    if (!m_constant_propagation.HasGPR(r))
+      continue;
+    bool shared = true;
+    for (const PS4PendingJoin& join : m_ps4_joins)
+    {
+      if (join.target_index == index &&
+          !(join.constants.HasGPR(r) &&
+            join.constants.GetGPR(r) == m_constant_propagation.GetGPR(r)))
+      {
+        shared = false;
+      }
+    }
+    if (shared)
+      continue;
+    // Only known as a constant here: written to ppcState if it's nowhere else, then forgotten.
+    if (!gpr.PS4Reg(r).IsInHostRegister() && !gpr.PS4Reg(r).IsInDefaultLocation())
+      gpr.Flush(BitSet32{static_cast<int>(r)}, RegCache::FlushMode::Undirty);
+    m_constant_propagation.ClearGPR(r);
+  }
+  for (const PS4PendingJoin& join : m_ps4_joins)
+  {
+    if (join.target_index == index)
+    {
+      first_fp &= join.first_fp;
+      constant_gqr_valid &= join.constant_gqr_valid;
+    }
+  }
+  // An FP instruction after this checks the FP enable bit again if a taken branch skipped the
+  // check; GQR values only stay known if known on every way here.
+  js.firstFPInstructionFound = first_fp;
+  js.constantGqrValid = constant_gqr_valid;
+
+  const u8* join_point = GetCodePtr();
+  for (auto it = m_ps4_joins.begin(); it != m_ps4_joins.end();)
+  {
+    if (it->target_index != index)
+    {
+      ++it;
+      continue;
+    }
+    SwitchToFarCode();
+    SetJumpTarget(it->taken);
+    const u8* stub = GetCodePtr();
+    PS4JoinMove(*it);
+    s_join_bound++;
+    s_join_moves += GetCodePtr() - stub;
+    // The instructions the branch skipped are counted in js.downcountAmount (the block's exits
+    // subtract it): give their cycles back.
+    if (js.downcountAmount > it->downcount)
+      ADD(32, PPCSTATE(downcount), Imm32(js.downcountAmount - it->downcount));
+    JMP(join_point, true);
+    SwitchToNearCode();
+    it = m_ps4_joins.erase(it);
+  }
+}
+
+// From the state where the branch left (join.*_state) to the cache's current state: first every
+// value the target's code expects in ppcState, or that changes host register, is written there;
+// then the host registers the target's code expects are loaded. (Values only move through
+// ppcState, so no host register is overwritten before it's read. No register is discarded at
+// either end: PS4CanJoin, and a discarded register here is dead here.)
+void JitPS4::PS4JoinMove(const PS4PendingJoin& join)
+{
+  for (preg_t r = 0; r < 32; r++)
+  {
+    const PPCCachedReg& from = join.gpr_state.regs[r];
+    const PPCCachedReg& to = gpr.PS4Reg(r);
+    const X64Reg from_host = from.IsInHostRegister() ? from.GetHostRegister() : INVALID_REG;
+    const X64Reg to_host = to.IsInHostRegister() ? to.GetHostRegister() : INVALID_REG;
+    if (!from.IsInDefaultLocation() &&
+        (to.IsInDefaultLocation() || (to_host != INVALID_REG && to_host != from_host)))
+    {
+      if (from_host != INVALID_REG)
+        MOV(32, gpr.PS4Home(r), R(from_host));
+      else if (join.constants.HasGPR(r))
+        MOV(32, gpr.PS4Home(r), Imm32(join.constants.GetGPR(r)));
+    }
+  }
+  for (preg_t r = 0; r < 32; r++)
+  {
+    const PPCCachedReg& from = join.fpr_state.regs[r];
+    const PPCCachedReg& to = fpr.PS4Reg(r);
+    const X64Reg from_host = from.IsInHostRegister() ? from.GetHostRegister() : INVALID_REG;
+    const X64Reg to_host = to.IsInHostRegister() ? to.GetHostRegister() : INVALID_REG;
+    if (!from.IsInDefaultLocation() && from_host != INVALID_REG &&
+        (to.IsInDefaultLocation() || (to_host != INVALID_REG && to_host != from_host)))
+    {
+      MOVAPD(fpr.PS4Home(r), from_host);
+    }
+  }
+  for (preg_t r = 0; r < 32; r++)
+  {
+    const PPCCachedReg& from = join.gpr_state.regs[r];
+    const PPCCachedReg& to = gpr.PS4Reg(r);
+    if (!to.IsInHostRegister() ||
+        (from.IsInHostRegister() && from.GetHostRegister() == to.GetHostRegister()))
+    {
+      continue;
+    }
+    if (join.constants.HasGPR(r))
+      MOV(32, R(to.GetHostRegister()), Imm32(join.constants.GetGPR(r)));
+    else
+      MOV(32, R(to.GetHostRegister()), gpr.PS4Home(r));
+  }
+  for (preg_t r = 0; r < 32; r++)
+  {
+    const PPCCachedReg& from = join.fpr_state.regs[r];
+    const PPCCachedReg& to = fpr.PS4Reg(r);
+    if (!to.IsInHostRegister() ||
+        (from.IsInHostRegister() && from.GetHostRegister() == to.GetHostRegister()))
+    {
+      continue;
+    }
+    MOVAPD(to.GetHostRegister(), fpr.PS4Home(r));
+  }
+}
+
+// The branch's target never started its own code in this block: the taken branch leaves the
+// block as it did before jit_join, from the state it left in.
+void JitPS4::PS4JoinFallback(const PS4PendingJoin& join)
+{
+  const RegCache::PS4State gpr_now = gpr.PS4Save();
+  const RegCache::PS4State fpr_now = fpr.PS4Save();
+  const JitCommon::ConstantPropagation constants_now = m_constant_propagation;
+  const u32 downcount_now = js.downcountAmount;
+  const CarryFlag carry_now = js.carryFlag;
+  const u32 gp_pending_now = js.ps4_gp_pending;
+  SwitchToFarCode();
+  SetJumpTarget(join.taken);
+  gpr.PS4Restore(join.gpr_state);
+  fpr.PS4Restore(join.fpr_state);
+  m_constant_propagation = join.constants;
+  js.downcountAmount = join.downcount;
+  js.carryFlag = CarryFlag::InPPCState;
+  js.ps4_gp_pending = 0;
+  gpr.Flush();
+  fpr.Flush();
+  WriteExit(join.target_address);
+  gpr.PS4Restore(gpr_now);
+  fpr.PS4Restore(fpr_now);
+  m_constant_propagation = constants_now;
+  js.downcountAmount = downcount_now;
+  js.carryFlag = carry_now;
+  js.ps4_gp_pending = gp_pending_now;
+  SwitchToNearCode();
+}
+
+void JitPS4::PS4JoinFallbacks(u32 first_index, u32 last_index)
+{
+  for (auto it = m_ps4_joins.begin(); it != m_ps4_joins.end();)
+  {
+    if (it->target_index < first_index || it->target_index > last_index)
+    {
+      ++it;
+      continue;
+    }
+    PS4JoinFallback(*it);
+    s_join_fallback++;
+    it = m_ps4_joins.erase(it);
+  }
+}
+
+u8 JitPS4::PS4RawSingleFlags() const
+{
+  const size_t index = static_cast<size_t>(js.op - m_code_buffer.data());
+  return index < m_ps4_raw_single.size() ? m_ps4_raw_single[index] : 0;
+}
+
+// PS4: gather pipe write fusion. Each gather pipe store used to load gather_pipe_ptr, store, add
+// and store the pointer back - so every write waited for the previous write's pointer store
+// (store-to-load forwarding, ~5 cycles each on Jaguar; 9 writes per vertex in Crash Bandicoot's
+// vertex loops). Now a run of writes stores at [gather_pipe_ptr + compile-time offset] and the
+// pointer is advanced once (this function) before anything that may read it: any instruction that
+// could call C code or leave the block (PS4CanDeferGatherPipeCommit is false), the gather pipe
+// check, and every block exit (Cleanup, without resetting: exits are emitted out of line).
+void JitPS4::PS4CommitGatherPipe(bool reset)
+{
+  if (js.ps4_gp_pending == 0)
+    return;
+  ADD(64, PPCSTATE(gather_pipe_ptr), Imm32(js.ps4_gp_pending));
+  if (reset)
+    js.ps4_gp_pending = 0;
+}
+
+// Instructions that can run with a pointer update pending: simple integer arithmetic (no calls,
+// no exceptions, no exits) and stores that go to the gather pipe at a known address.
+bool JitPS4::PS4CanDeferGatherPipeCommit(const PPCAnalyst::CodeOp& op)
+{
+  if (op.skip || jo.memcheck || !jo.optimizeGatherPipe)
+    return false;
+  // HLE hooks call C code before the instruction.
+  if (HLE::TryReplaceFunction(m_ppc_symbol_db, op.address, PowerPC::CoreMode::JIT))
+    return false;
+  const UGeckoInstruction inst = op.inst;
+  switch (inst.OPCD)
+  {
+  case 7:   // mulli
+  case 14:  // addi
+  case 15:  // addis
+  case 21:  // rlwinmx
+  case 24:  // ori
+  case 25:  // oris
+  case 26:  // xori
+  case 27:  // xoris
+  case 28:  // andi.
+  case 29:  // andis.
+    return true;
+  case 31:
+    switch (inst.SUBOP10)
+    {
+    case 266:  // add
+    case 40:   // subf
+    case 444:  // or
+    case 28:   // and
+    case 316:  // xor
+    case 235:  // mullw
+      return !inst.OE;
+    default:
+      return false;
+    }
+  case 36:  // stw
+  case 37:  // stwu
+  case 38:  // stb
+  case 39:  // stbu
+  case 44:  // sth
+  case 45:  // sthu
+  case 52:  // stfs
+  case 53:  // stfsu
+  case 54:  // stfd
+  case 55:  // stfdu
+  {
+    if (inst.RA != 0 && !gpr.IsImm(inst.RA))
+      return false;
+    const u32 address =
+        (inst.RA ? gpr.Imm32(inst.RA) : 0) + static_cast<u32>(static_cast<s32>(inst.SIMM_16));
+    return m_mmu.IsOptimizableGatherPipeWrite(address);
+  }
+  default:
+    return false;
+  }
+}
+
+bool JitPS4::Cleanup()
+{
+  bool did_something = false;
+
+  PS4CommitGatherPipe(false);
+
+  if (jo.optimizeGatherPipe && js.fifoBytesSinceCheck > 0)
+  {
+    MOV(64, R(RSCRATCH), PPCSTATE(gather_pipe_ptr));
+    SUB(64, R(RSCRATCH), PPCSTATE(gather_pipe_base_ptr));
+    // fifo_defer=on: flush at 128 bytes; at most 127 + 256 + 8 bytes are then pending inside a
+    // block, under the gather pipe buffer's 512.
+    CMP(64, R(RSCRATCH), Imm32(ps4_fifo_defer ? 128 : GPFifo::GATHER_PIPE_SIZE));
+    FixupBranch exit = J_CC(CC_L);
+    ABI_PushRegistersAndAdjustStack({}, 0);
+    ABI_CallFunctionP(GPFifo::UpdateGatherPipe, &m_system.GetGPFifo());
+    ABI_PopRegistersAndAdjustStack({}, 0);
+    SetJumpTarget(exit);
+    did_something = true;
+  }
+
+  if (m_ppc_state.feature_flags & FEATURE_FLAG_PERFMON)
+  {
+    ABI_PushRegistersAndAdjustStack({}, 0);
+    ABI_CallFunctionCCCP(PowerPC::UpdatePerformanceMonitor, js.downcountAmount, js.numLoadStoreInst,
+                         js.numFloatingPointInst, &m_ppc_state);
+    ABI_PopRegistersAndAdjustStack({}, 0);
+    did_something = true;
+  }
+
+  return did_something;
+}
+
+void JitPS4::FakeBLCall(u32 after)
+{
+  if (!m_enable_blr_optimization)
+    return;
+
+  // We may need to fake the BLR stack on inlined CALL instructions.
+  // Else we can't return to this location any more.
+  MOV(64, R(RSCRATCH2), Imm64(u64(m_ppc_state.feature_flags) << 32 | after));
+  PUSH(RSCRATCH2);
+  FixupBranch skip_exit = CALL();
+  POP(RSCRATCH2);
+  JustWriteExit(after, false, 0);
+  SetJumpTarget(skip_exit);
+}
+
+void JitPS4::EmitUpdateMembase()
+{
+  MOV(64, R(RMEM), PPCSTATE(mem_ptr));
+}
+
+void JitPS4::MSRUpdated(const OpArg& msr, X64Reg scratch_reg)
+{
+  ASSERT(!msr.IsSimpleReg(scratch_reg));
+
+  constexpr u32 dr_bit = 1 << UReg_MSR{}.DR.StartBit();
+
+  // Update mem_ptr
+  auto& memory = m_system.GetMemory();
+  if (msr.IsImm())
+  {
+    MOV(64, R(RMEM),
+        ImmPtr(UReg_MSR(msr.Imm32()).DR ? memory.GetLogicalBase() : memory.GetPhysicalBase()));
+  }
+  else
+  {
+    MOV(64, R(RMEM), ImmPtr(memory.GetLogicalBase()));
+    MOV(64, R(scratch_reg), ImmPtr(memory.GetPhysicalBase()));
+    TEST(32, msr, Imm32(dr_bit));
+    CMOVcc(64, RMEM, R(scratch_reg), CC_Z);
+  }
+  MOV(64, PPCSTATE(mem_ptr), R(RMEM));
+
+  // Update feature_flags
+  static_assert(UReg_MSR{}.DR.StartBit() == 4);
+  static_assert(UReg_MSR{}.IR.StartBit() == 5);
+  static_assert(FEATURE_FLAG_MSR_DR == 1 << 0);
+  static_assert(FEATURE_FLAG_MSR_IR == 1 << 1);
+  const u32 other_feature_flags = m_ppc_state.feature_flags & ~0x3;
+  if (msr.IsImm())
+  {
+    MOV(32, PPCSTATE(feature_flags), Imm32(other_feature_flags | ((msr.Imm32() >> 4) & 0x3)));
+  }
+  else
+  {
+    MOV(32, R(scratch_reg), msr);
+    SHR(32, R(scratch_reg), Imm8(4));
+    AND(32, R(scratch_reg), Imm32(0x3));
+    if (other_feature_flags != 0)
+      OR(32, R(scratch_reg), Imm32(other_feature_flags));
+    MOV(32, PPCSTATE(feature_flags), R(scratch_reg));
+  }
+
+  // Call PageTableUpdatedFromJit if needed
+  if (!msr.IsImm() || UReg_MSR(msr.Imm32()).DR)
+  {
+    gpr.Flush();
+    fpr.Flush();
+    FixupBranch dr_unset;
+    if (!msr.IsImm())
+    {
+      TEST(32, msr, Imm32(dr_bit));
+      dr_unset = J_CC(CC_Z);
+    }
+    CMP(8, PPCSTATE(pagetable_update_pending), Imm8(0));
+    FixupBranch update_not_pending = J_CC(CC_E);
+    ABI_CallFunctionP(&PowerPC::MMU::PageTableUpdatedFromJit, &m_system.GetMMU());
+    SetJumpTarget(update_not_pending);
+    if (!msr.IsImm())
+      SetJumpTarget(dr_unset);
+  }
+}
+
+// jit_trace: a learning block ran PS4_TRACE_RUNS times. Its usually-taken branches are noted, and
+// the block is invalidated - it is still running, but its code stays until the next compile, which
+// only happens after it has left. The next time it's reached it is compiled again as a trace, and
+// counts nothing.
+void JitPS4::PS4Retrace(JitPS4* jit, void* counted)
+{
+  const auto* block = static_cast<const CountBlock*>(counted);
+  for (const auto& exit : block->exits)
+  {
+    if (exit->destination != 0xFFFFFFFF && exit->count * 10 >= block->runs * 7)
+      s_trace_taken.insert((u64(exit->source) << 32) | exit->destination);
+  }
+  s_traced_blocks.insert(block->address);
+  // The old code is never reused: the BLR optimization may still return into it (a recursive
+  // function's outer call), so its memory stays as it is - once per retraced block.
+  jit->FreeRanges();  // what other blocks gave back until now is still freed
+  jit->m_system.GetJitInterface().InvalidateICache(block->address, 4, true);
+  jit->blocks.ClearRangesToFree();
+}
+
+void JitPS4::PS4VerifyExit(std::optional<u32> destination)
+{
+  // jit_trace (learning) / PS4JIT_COUNT: count where this exit goes.
+  if (m_ps4_count_block && (destination || s_count_on))
+  {
+    auto exit = std::make_unique<CountExit>();
+    exit->destination = destination ? *destination : 0xFFFFFFFF;
+    exit->source = js.skipInstructions ? js.op[1].address : js.compilerPC;
+    const u64* counter = &exit->count;
+    {
+      std::lock_guard lock(s_count_mutex);
+      static_cast<CountBlock*>(m_ps4_count_block)->exits.push_back(std::move(exit));
+    }
+    PUSH(RSCRATCH2);
+    MOV(64, R(RSCRATCH2), ImmPtr(counter));
+    ADD(64, MatR(RSCRATCH2), Imm8(1));
+    POP(RSCRATCH2);
+  }
+  // Recompiler check: every register is in ppcState here (the exits flush first; pinned registers
+  // are written there for the check).
+  if (!ps4_jit_verify)
+    return;
+  ABI_PushRegistersAndAdjustStack(BitSet32{RSCRATCH, RSCRATCH2}, 0);
+  PS4StorePinned();
+  if (destination)
+    ABI_CallFunctionPC(VerifyExitFromJit, this, *destination);
+  else
+    ABI_CallFunctionPR(VerifyExitFromJit, this, RSCRATCH);
+  ABI_PopRegistersAndAdjustStack(BitSet32{RSCRATCH, RSCRATCH2}, 0);
+}
+
+void JitPS4::WriteExit(u32 destination, bool bl, u32 after)
+{
+  if (!m_enable_blr_optimization)
+    bl = false;
+
+  PS4VerifyExit(destination);
+  Cleanup();
+
+  if (bl)
+  {
+    MOV(64, R(RSCRATCH2), Imm64(u64(m_ppc_state.feature_flags) << 32 | after));
+    PUSH(RSCRATCH2);
+  }
+
+  SUB(32, PPCSTATE(downcount), Imm32(js.downcountAmount));
+
+  JustWriteExit(destination, bl, after);
+}
+
+void JitPS4::JustWriteExit(u32 destination, bool bl, u32 after)
+{
+  // If nobody has taken care of this yet (this can be removed when all branches are done)
+  JitBlock* b = js.curBlock;
+  JitBlock::LinkData linkData;
+  linkData.exitAddress = destination;
+  linkData.linkStatus = false;
+  linkData.call = bl;
+
+  if (ps4_jit_lazy_pc)
+  {
+    // The downcount flags of the SUB before this survive the MOVs: they only set the PC.
+    FixupBranch timing = J_CC(CC_LE, Jump::Near);
+    SwitchToFarCode();
+    // Unlinked: store the PC, then the dispatcher (a CALL here keeps bl's return address).
+    linkData.unlinkedTarget = GetCodePtr();
+    MOV(32, PPCSTATE(pc), Imm32(destination));
+    JMP(asm_routines.dispatcher_no_timing_check, true);
+    // Out of cycles: store the PC, then the timing code.
+    SetJumpTarget(timing);
+    MOV(32, PPCSTATE(pc), Imm32(destination));
+    FixupBranch after_timing;
+    if (bl)
+    {
+      CALL(asm_routines.do_timing);
+      after_timing = J(Jump::Near);
+    }
+    else
+    {
+      JMP(asm_routines.do_timing, true);
+    }
+    SwitchToNearCode();
+
+    linkData.exitPtrs = GetWritableCodePtr();
+    if (bl)
+    {
+      CALL(linkData.unlinkedTarget);
+      SetJumpTarget(after_timing);
+      POP(RSCRATCH);
+      b->linkData.push_back(linkData);
+      JustWriteExit(after, false, 0);
+      return;
+    }
+    // Near JMP: linking rewrites it in place (see the padding note below).
+    JMP(linkData.unlinkedTarget, true);
+    b->linkData.push_back(linkData);
+    return;
+  }
+
+  MOV(32, PPCSTATE(pc), Imm32(destination));
+
+  // Perform downcount flag check, followed by the requested exit
+  if (bl)
+  {
+    FixupBranch do_timing = J_CC(CC_LE, Jump::Near);
+    SwitchToFarCode();
+    SetJumpTarget(do_timing);
+    CALL(asm_routines.do_timing);
+    FixupBranch after_fixup = J(Jump::Near);
+    SwitchToNearCode();
+
+    linkData.exitPtrs = GetWritableCodePtr();
+    CALL(asm_routines.dispatcher_no_timing_check);
+
+    SetJumpTarget(after_fixup);
+    POP(RSCRATCH);
+    JustWriteExit(after, false, 0);
+  }
+  else
+  {
+    J_CC(CC_LE, asm_routines.do_timing);
+
+    linkData.exitPtrs = GetWritableCodePtr();
+    // Padding required for correctness, as the JMP length might differ between dispatcher and
+    // linked block: if this wrote a Short JMP but then JitBlockCache::WriteLinkBlock wrote a Near
+    // JMP, the latter would overwrite other instructions.
+    JMP(asm_routines.dispatcher_no_timing_check, true);
+  }
+
+  b->linkData.push_back(linkData);
+}
+
+void JitPS4::WriteExitDestInRSCRATCH(bool bl, u32 after)
+{
+  if (!m_enable_blr_optimization)
+    bl = false;
+  PS4VerifyExit(std::nullopt);
+  MOV(32, PPCSTATE(pc), R(RSCRATCH));
+  Cleanup();
+
+  if (bl)
+  {
+    MOV(64, R(RSCRATCH2), Imm64(u64(m_ppc_state.feature_flags) << 32 | after));
+    PUSH(RSCRATCH2);
+  }
+
+  SUB(32, PPCSTATE(downcount), Imm32(js.downcountAmount));
+  // Dolphin Lab (PS4): indirect exits (bctr, bctrl, blr without a predicted return) look their
+  // target up here - the dispatcher's own one-read lookup, inline - and jump through their own
+  // indirect branch: one shared jmp in the dispatcher for every computed target was mispredicted
+  // by the CPU most of the time. Out of cycles: the dispatcher (the flags of the SUB above);
+  // not found: the dispatcher's lookup, which compiles the block.
+  if (ps4_jit_inline_dispatch && !GetBlockCache()->GetEntryPoints())
+  {
+    FixupBranch out_of_cycles = J_CC(CC_LE, Jump::Near);
+    // Cleanup() may have used RSCRATCH: the target PC again (MOV keeps the flags).
+    MOV(32, R(RSCRATCH), PPCSTATE(pc));
+    MOV(32, R(RSCRATCH2), R(RSCRATCH));
+    AND(32, R(RSCRATCH2), Imm32(JitBaseBlockCache::FAST_BLOCK_MAP_FALLBACK_MASK << 2));
+    SHL(64, R(RSCRATCH), Imm8(32));
+    if (m_ppc_state.feature_flags != 0)
+      OR(64, R(RSCRATCH), Imm32(static_cast<u32>(m_ppc_state.feature_flags)));
+    MOV(64, R(RSCRATCH_EXTRA), ImmPtr(GetBlockCache()->GetDispatchTable()));
+    LEA(64, RSCRATCH2, MComplex(RSCRATCH_EXTRA, RSCRATCH2, SCALE_4, 0));
+    CMP(64, R(RSCRATCH), MatR(RSCRATCH2));
+    FixupBranch not_found = J_CC(CC_NE, Jump::Near);
+    if (bl)
+    {
+      CALLptr(MDisp(RSCRATCH2, 8));
+      FixupBranch returned = J(Jump::Near);
+      SetJumpTarget(out_of_cycles);
+      CALL(asm_routines.dispatcher);
+      FixupBranch returned2 = J(Jump::Near);
+      SetJumpTarget(not_found);
+      CALL(asm_routines.dispatcher_no_timing_check);
+      SetJumpTarget(returned);
+      SetJumpTarget(returned2);
+      POP(RSCRATCH);
+      JustWriteExit(after, false, 0);
+    }
+    else
+    {
+      JMPptr(MDisp(RSCRATCH2, 8));
+      SetJumpTarget(out_of_cycles);
+      JMP(asm_routines.dispatcher, true);
+      SetJumpTarget(not_found);
+      JMP(asm_routines.dispatcher_no_timing_check, true);
+    }
+    return;
+  }
+  if (bl)
+  {
+    CALL(asm_routines.dispatcher);
+    POP(RSCRATCH);
+    JustWriteExit(after, false, 0);
+  }
+  else
+  {
+    JMP(asm_routines.dispatcher);
+  }
+}
+
+void JitPS4::WriteBLRExit()
+{
+  if (!m_enable_blr_optimization)
+  {
+    WriteExitDestInRSCRATCH();
+    return;
+  }
+  PS4VerifyExit(std::nullopt);
+  MOV(32, PPCSTATE(pc), R(RSCRATCH));
+  bool disturbed = Cleanup();
+  if (disturbed)
+    MOV(32, R(RSCRATCH), PPCSTATE(pc));
+  if (m_ppc_state.feature_flags != 0)
+  {
+    MOV(32, R(RSCRATCH2), Imm32(m_ppc_state.feature_flags));
+    SHL(64, R(RSCRATCH2), Imm8(32));
+    OR(64, R(RSCRATCH), R(RSCRATCH2));
+  }
+  MOV(32, R(RSCRATCH2), Imm32(js.downcountAmount));
+  CMP(64, R(RSCRATCH), MDisp(RSP, 8));
+  J_CC(CC_NE, asm_routines.dispatcher_mispredicted_blr);
+  SUB(32, PPCSTATE(downcount), R(RSCRATCH2));
+  RET();
+}
+
+void JitPS4::WriteRfiExitDestInRSCRATCH()
+{
+  MOV(32, PPCSTATE(pc), R(RSCRATCH));
+  MOV(32, PPCSTATE(npc), R(RSCRATCH));
+  Cleanup();
+  ABI_PushRegistersAndAdjustStack({}, 0);
+  ABI_CallFunctionP(PowerPC::CheckExceptionsFromJIT, &m_system.GetPowerPC());
+  ABI_PopRegistersAndAdjustStack({}, 0);
+  EmitUpdateMembase();
+  SUB(32, PPCSTATE(downcount), Imm32(js.downcountAmount));
+  JMP(asm_routines.dispatcher);
+}
+
+void JitPS4::WriteIdleExit(u32 destination)
+{
+  PS4VerifyExit(destination);
+  ABI_PushRegistersAndAdjustStack({}, 0);
+  ABI_CallFunction(CoreTiming::GlobalIdle);
+  ABI_PopRegistersAndAdjustStack({}, 0);
+  MOV(32, PPCSTATE(pc), Imm32(destination));
+  WriteExceptionExit();
+}
