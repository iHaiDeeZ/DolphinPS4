+#include "Common/IniFile.h"
+#include "Core/ActionReplay.h"
+#include "Core/ConfigManager.h"
+#include "Core/GeckoCode.h"
+#include "Core/GeckoCodeConfig.h"
+
+namespace PS4Cheats
+{
+struct List::Codes
+{
+  std::vector<ActionReplay::ARCode> ar;
+  std::vector<Gecko::GeckoCode> gecko;
+};
+
+List::List() : m_codes(new Codes)
+{
+}
+
+List::~List()
+{
+  delete m_codes;
+}
+
+void List::Load(const std::string& game_id, uint16_t revision)
+{
+  m_game_id = game_id;
+  m_revision = revision;
+  const Common::IniFile global = SConfig::LoadDefaultGameIni(game_id, revision);
+  const Common::IniFile local = SConfig::LoadLocalGameIni(game_id, revision);
+  m_codes->ar = ActionReplay::LoadCodes(global, local);
+  m_codes->gecko = Gecko::LoadCodes(global, local);
+}
+
+std::vector<Entry> List::Entries() const
+{
+  std::vector<Entry> entries;
+  for (const ActionReplay::ARCode& code : m_codes->ar)
+    entries.push_back({code.name, code.enabled, false});
+  for (const Gecko::GeckoCode& code : m_codes->gecko)
+    entries.push_back({code.name, code.enabled, true});
+  return entries;
+}
+
+void List::Toggle(size_t i)
+{
+  if (i < m_codes->ar.size())
+    m_codes->ar[i].enabled = !m_codes->ar[i].enabled;
+  else if (i - m_codes->ar.size() < m_codes->gecko.size())
+    m_codes->gecko[i - m_codes->ar.size()].enabled = !m_codes->gecko[i - m_codes->ar.size()].enabled;
+  else
+    return;
+  Save();
+}
+
+void List::SetAll(bool enabled)
+{
+  for (auto& code : m_codes->ar)
+    code.enabled = enabled;
+  for (auto& code : m_codes->gecko)
+    code.enabled = enabled;
+  Save();
+}
+
+// The choices go to the game's own INI (User/GameSettings/<ID>.ini), as in Dolphin.
+void List::Save() const
+{
+  Common::IniFile local = SConfig::LoadLocalGameIni(m_game_id, m_revision);
+  ActionReplay::SaveCodes(&local, m_codes->ar);
+  Gecko::SaveCodes(local, m_codes->gecko);
+  File::CreateFullPath(File::GetUserPath(D_GAMESETTINGS_IDX));
+  local.Save(File::GetUserPath(D_GAMESETTINGS_IDX) + m_game_id + ".ini");
+}
+
+void List::ApplyToRunningGame() const
+{
+  ActionReplay::ApplyCodes(m_codes->ar, m_game_id, m_revision);
+  Gecko::SetActiveCodes(m_codes->gecko, m_game_id, m_revision);
+}
+}  // namespace PS4Cheats
