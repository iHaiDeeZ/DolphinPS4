diff --git a/Source/Core/DolphinNoGUI/PS4Cheats.cpp b/Source/Core/DolphinNoGUI/PS4Cheats.cpp
new file mode 100755
index 0000000..588b816
--- /dev/null
+++ b/Source/Core/DolphinNoGUI/PS4Cheats.cpp
@@ -0,0 +1,124 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "DolphinNoGUI/PS4Cheats.h"
+
+#include <algorithm>
+
+#include "Common/FileUtil.h"
+#include "Common/IniFile.h"
+#include "Core/ActionReplay.h"
+#include "Core/ConfigManager.h"
+#include "Core/GeckoCode.h"
+#include "Core/GeckoCodeConfig.h"
+
+namespace PS4Cheats
+{
+struct List::Codes
+{
+  std::vector<ActionReplay::ARCode> ar;
+  std::vector<Gecko::GeckoCode> gecko;
+};
+
+List::List() : m_codes(new Codes)
+{
+}
+
+List::Download List::FetchOnline(const std::string& game_id)
+{
+  Download result;
+  auto fetched = Gecko::DownloadCodes(game_id);
+  if (!fetched)
+  {
+    result.http_code = fetched.error();
+    return result;
+  }
+  result.ok = true;
+  auto codes = std::make_shared<std::vector<Gecko::GeckoCode>>(std::move(*fetched));
+  for (const auto& code : *codes)
+    result.names.push_back(code.name);
+  result.codes = codes;
+  return result;
+}
+
+size_t List::AddDownloaded(const Download& download)
+{
+  if (!download.ok || !download.codes)
+    return 0;
+  const auto& codes = *static_cast<const std::vector<Gecko::GeckoCode>*>(download.codes.get());
+  size_t added = 0;
+  for (Gecko::GeckoCode code : codes)
+  {
+    if (std::find(m_codes->gecko.begin(), m_codes->gecko.end(), code) != m_codes->gecko.end())
+      continue;
+    code.user_defined = true;  // kept in User/GameSettings/<ID>.ini like Dolphin's download
+    code.enabled = false;
+    m_codes->gecko.push_back(std::move(code));
+    added++;
+  }
+  if (added)
+    Save();
+  return added;
+}
+
+List::~List()
+{
+  delete m_codes;
+}
+
+void List::Load(const std::string& game_id, uint16_t revision)
+{
+  m_game_id = game_id;
+  m_revision = revision;
+  const Common::IniFile global = SConfig::LoadDefaultGameIni(game_id, revision);
+  const Common::IniFile local = SConfig::LoadLocalGameIni(game_id, revision);
+  m_codes->ar = ActionReplay::LoadCodes(global, local);
+  m_codes->gecko = Gecko::LoadCodes(global, local);
+}
+
+std::vector<Entry> List::Entries() const
+{
+  std::vector<Entry> entries;
+  for (const ActionReplay::ARCode& code : m_codes->ar)
+    entries.push_back({code.name, code.enabled, false});
+  for (const Gecko::GeckoCode& code : m_codes->gecko)
+    entries.push_back({code.name, code.enabled, true});
+  return entries;
+}
+
+void List::Toggle(size_t i)
+{
+  if (i < m_codes->ar.size())
+    m_codes->ar[i].enabled = !m_codes->ar[i].enabled;
+  else if (i - m_codes->ar.size() < m_codes->gecko.size())
+    m_codes->gecko[i - m_codes->ar.size()].enabled = !m_codes->gecko[i - m_codes->ar.size()].enabled;
+  else
+    return;
+  Save();
+}
+
+void List::SetAll(bool enabled)
+{
+  for (auto& code : m_codes->ar)
+    code.enabled = enabled;
+  for (auto& code : m_codes->gecko)
+    code.enabled = enabled;
+  Save();
+}
+
+// The choices go to the game's own INI (User/GameSettings/<ID>.ini), as in Dolphin.
+void List::Save() const
+{
+  Common::IniFile local = SConfig::LoadLocalGameIni(m_game_id, m_revision);
+  ActionReplay::SaveCodes(&local, m_codes->ar);
+  Gecko::SaveCodes(local, m_codes->gecko);
+  File::CreateFullPath(File::GetUserPath(D_GAMESETTINGS_IDX));
+  local.Save(File::GetUserPath(D_GAMESETTINGS_IDX) + m_game_id + ".ini");
+}
+
+void List::ApplyToRunningGame() const
+{
+  ActionReplay::ApplyCodes(m_codes->ar, m_game_id, m_revision);
+  Gecko::SetActiveCodes(m_codes->gecko, m_game_id, m_revision);
+}
+}  // namespace PS4Cheats
diff --git a/Source/Core/DolphinNoGUI/PS4Cheats.h b/Source/Core/DolphinNoGUI/PS4Cheats.h
new file mode 100755
index 0000000..276a9b6
--- /dev/null
+++ b/Source/Core/DolphinNoGUI/PS4Cheats.h
@@ -0,0 +1,63 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// PS4 cheats: the Action Replay and Gecko codes Dolphin ships for each game (Sys/GameSettings)
+// plus the user's own, switched on and off from the XMB or the in-game menu. The choices are
+// saved in the user's game settings (User/GameSettings/<ID>.ini), as Dolphin's cheat manager
+// does.
+
+#pragma once
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace PS4Cheats
+{
+struct Entry
+{
+  std::string name;
+  bool enabled;
+  bool gecko;  // Gecko code (else Action Replay)
+};
+
+class List
+{
+public:
+  List();
+  ~List();
+  List(const List&) = delete;
+  List& operator=(const List&) = delete;
+
+  void Load(const std::string& game_id, uint16_t revision);
+  std::vector<Entry> Entries() const;
+  // Switches entry i on/off and saves the choice.
+  void Toggle(size_t i);
+  // Switches every code on or off and saves the choice.
+  void SetAll(bool enabled);
+  // Game process: makes the current choices active in the running game.
+  void ApplyToRunningGame() const;
+
+  // Online codes (the WiiRD database mirror Dolphin uses): fetched on any thread (network), then
+  // added on the menu's thread - the new ones, off, saved with the user's own codes.
+  struct Download
+  {
+    bool ok = false;
+    int http_code = 0;
+    std::vector<std::string> names;  // fetched codes, for counting
+    std::shared_ptr<void> codes;     // std::vector<Gecko::GeckoCode>
+  };
+  static Download FetchOnline(const std::string& game_id);
+  // Returns how many were new.
+  size_t AddDownloaded(const Download& download);
+
+private:
+  void Save() const;
+
+  struct Codes;
+  Codes* m_codes;
+  std::string m_game_id;
+  uint16_t m_revision = 0;
+};
+}  // namespace PS4Cheats
