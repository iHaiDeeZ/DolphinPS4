+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// Network shares on the PS4: games read straight from an NFS export or an SMB (Windows) share, so
+// the library isn't limited by the console's own storage. libnfs and libsmb2 are user-space
+// clients (no kernel support needed); scripts/build-netlibs.sh builds them.
+//
+// A share is a URL:
+//   nfs://<server>/<export>[/<folder>]            (NFS v3; add ?version=4 for NFS v4)
+//   smb://[<user>[:<password>]@]<server>/<share>[/<folder>]   (SMB 2/3; no user: Guest)
+// and a file in it is that URL plus its path ("nfs://192.168.0.10/games/Melee.rvz"). Such paths
+// work wherever Dolphin opens a file to read (File::IOFile, File::DirectIOFile, File::Exists /
+// GetSize / IsDirectory): disc images in every format read from the network as they would from
+// the disk. Read-only.
+
+#pragma once
+
+#include <cstdio>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "Common/CommonTypes.h"
+
+namespace Common::NetFS
+{
+bool IsNetPath(std::string_view path);
+
+// The configured shares (each one connection root: its server, export or share, and folder).
+// A path inside one of them connects at that root; any other network path at its own folder.
+void SetShares(std::vector<std::string> roots);
+
+// The URL with its password hidden ("smb://me:***@pc/games"), for logs and the menus.
+std::string Redact(const std::string& url);
+
+// The last error (connection, open, read), for the menus and logs.
+std::string LastError();
+
+struct Entry
+{
+  std::string name;
+  bool directory = false;
+  u64 size = 0;
+};
+// The files and folders in a network folder (without "." and ".."). False: unreachable.
+bool List(const std::string& url, std::vector<Entry>* entries);
+
+// Whether the path exists, its size and whether it is a folder (cached for a few seconds).
+bool Stat(const std::string& url, u64* size, bool* directory);
+
+// Handles for File::DirectIOFile: numbers no real file descriptor reaches.
+bool IsHandle(int handle);
+int OpenHandle(const std::string& url);  // -1: can't be opened
+bool ReadAt(int handle, u64 offset, u8* out, u64 size);  // thread safe
+u64 HandleSize(int handle);
+int DuplicateHandle(int handle);
+void CloseHandle(int handle);
+
+// A read-only stdio stream for File::IOFile (nullptr: can't be opened).
+std::FILE* OpenStream(const std::string& url);
+}  // namespace Common::NetFS
