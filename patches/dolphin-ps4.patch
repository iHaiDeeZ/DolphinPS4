+// Wii style background: the Wii Menu's white with fine lines, and its grey bar at the bottom.
+void Menu::DrawWiiBackground()
+{
+  ImDrawList* dl = ImGui::GetBackgroundDrawList();
+  dl->AddRectFilledMultiColor(ImVec2(0, 0), ImVec2(W, H), Rgba(0xFFFFFF), Rgba(0xFFFFFF),
+                              Rgba(0xDDE3EA), Rgba(0xDDE3EA));
+  for (float y = 0.0f; y < H - 120.0f; y += 6.0f)
+    dl->AddLine(ImVec2(0, y), ImVec2(W, y), Rgba(0x9AA6B4, 0.05f), 1.0f);
+  // A slow light sweep across the screen.
+  const float sweep = std::fmod(m_time * 60.0f, W + 800.0f) - 400.0f;
+  dl->AddRectFilledMultiColor(ImVec2(sweep - 300, 0), ImVec2(sweep, H - 120), Rgba(0xFFFFFF, 0.0f),
+                              Rgba(0xFFFFFF, 0.35f), Rgba(0xFFFFFF, 0.35f), Rgba(0xFFFFFF, 0.0f));
+  dl->AddRectFilledMultiColor(ImVec2(sweep, 0), ImVec2(sweep + 300, H - 120), Rgba(0xFFFFFF, 0.35f),
+                              Rgba(0xFFFFFF, 0.0f), Rgba(0xFFFFFF, 0.0f), Rgba(0xFFFFFF, 0.35f));
+  const float bar = H - 120.0f;
+  dl->AddRectFilledMultiColor(ImVec2(0, bar), ImVec2(W, H), Rgba(0xEEF1F4), Rgba(0xEEF1F4),
+                              Rgba(0xC6CED7), Rgba(0xC6CED7));
+  dl->AddLine(ImVec2(0, bar), ImVec2(W, bar), Rgba(0x34BEED, 0.7f), 3.0f);
+  dl->AddLine(ImVec2(0, bar + 3), ImVec2(W, bar + 3), Rgba(0xFFFFFF, 0.9f), 2.0f);
+}
