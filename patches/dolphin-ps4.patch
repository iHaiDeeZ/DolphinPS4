+AbstractTexture* PS4BezelImage()
+{
+  const std::string id = SConfig::GetInstance().GetGameID();
+  if (id == s_bezel_image_for)
+    return s_bezel_image.get();
+  s_bezel_image_for = id;
+  s_bezel_image.reset();
+  const std::string dir = "/data/DolphinPS4/bezels/";
+  std::vector<std::string> paths;
+  if (!id.empty())
+  {
+    paths.push_back(dir + id + ".png");
+    if (id.size() > 3)
+      paths.push_back(dir + id.substr(0, 3) + ".png");
+  }
+  paths.push_back(dir + "default.png");
+  for (const std::string& path : paths)
+  {
+    std::ifstream file(path, std::ios::binary);
+    if (!file)
+      continue;
+    const std::vector<u8> png((std::istreambuf_iterator<char>(file)),
+                              std::istreambuf_iterator<char>());
+    Common::UniqueBuffer<u8> pixels;
+    u32 width = 0, height = 0;
+    if (!Common::LoadPNG(png, &pixels, &width, &height) || width == 0 || height == 0)
+    {
+      ps4_boot_trace(("bezel: can't read " + path).c_str());
+      continue;
+    }
+    TextureConfig config(width, height, 1, 1, 1, AbstractTextureFormat::RGBA8, 0,
+                         AbstractTextureType::Texture_2DArray);
+    s_bezel_image = g_gfx->CreateTexture(config, "PS4 bezel");
+    if (!s_bezel_image)
