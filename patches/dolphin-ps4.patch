+// The game being started is a Wii one (a Wii disc, a .wad, or Wii homebrew); set before Dolphin
+// starts.
+static bool s_wii_game = false;
+
+// A game sees exactly the controllers that are there: player 1's port / Wii Remote always, and
+// one more for each other signed-in user with a DualShock 4. A player who joins mid-game gets
+// the next port (Dolphin checks the ports at every controller poll; a Wii Remote connects when
+// its player presses a button); one who signs out is unplugged.
+// A Wii game sees both by default (like a Wii with a GameCube controller plugged in; games such as
+// Mario Kart Wii and Smash Bros. Brawl take either). Controller in Wii Games keeps just one.
+void Platform::ApplyPS4Players()
+{
+  const int players = std::clamp(ps4_pad_count, 1, 4);
+  const std::string wii_input = s_wii_game ? GetPS4Option("wii_input", "both") : "both";
+  for (int i = 0; i < 4; i++)
+  {
+    const auto si = i < players && wii_input != "wiimote" ? SerialInterface::SIDEVICE_GC_CONTROLLER :
+                                                            SerialInterface::SIDEVICE_NONE;
+    if (Config::Get(Config::GetInfoForSIDevice(i)) != si)
+      Config::SetBase(Config::GetInfoForSIDevice(i), si);
+    const auto source =
+        i < players && wii_input != "gamecube" ? WiimoteSource::Emulated : WiimoteSource::None;
+    if (Config::Get(Config::GetInfoForWiimoteSource(i)) != source)
+      Config::SetBase(Config::GetInfoForWiimoteSource(i), source);
+  }
+  BootTrace(fmt::format("players: {} (GameCube ports / Wii Remotes in use), Wii game input: {}",
+                        players, s_wii_game ? wii_input : "-")
+                .c_str());
+}
