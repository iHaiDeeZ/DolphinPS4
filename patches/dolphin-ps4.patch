   return Create(m_file);
 }
 
+#ifdef __ORBIS__
+extern "C" int ps4_disc_cache;  // ps4.ini disc_cache (DolphinNoGUI/MainNoGUI.cpp)
+int ps4_disc_cache = 0;
+extern "C" unsigned long long ps4_disc_cache_hits, ps4_disc_cache_misses;
+unsigned long long ps4_disc_cache_hits = 0, ps4_disc_cache_misses = 0;
+
+bool PlainFileReader::CachedRead(u64 offset, u64 nbytes, u8* out_ptr)
+{
+  constexpr u64 PIECE = 256 * 1024;
+  constexpr size_t PIECES = 64;
+  std::lock_guard lock(m_cache_mutex);
+  if (m_cache.empty())
+    m_cache.resize(PIECES);
+  while (nbytes > 0)
+  {
+    const u64 start = offset & ~(PIECE - 1);
+    CachePiece* piece = nullptr;
+    for (CachePiece& p : m_cache)
+    {
+      if (p.start == start)
+      {
+        piece = &p;
+        break;
+      }
+    }
+    if (piece)
+    {
+      ps4_disc_cache_hits++;
+    }
+    else
+    {
+      ps4_disc_cache_misses++;
+      piece = &*std::min_element(m_cache.begin(), m_cache.end(),
+                                 [](const CachePiece& a, const CachePiece& b) {
+                                   return a.last_use < b.last_use;
+                                 });
+      const u64 size = std::min(PIECE, m_size - start);
+      piece->data.resize(size);
+      piece->start = ~0ull;
+      if (!m_file.OffsetRead(start, piece->data.data(), size))
+        return false;
+      piece->start = start;
+    }
+    piece->last_use = ++m_cache_clock;
+    const u64 in_piece = offset - start;
+    if (in_piece >= piece->data.size())
+      return false;  // past the end of the file
+    const u64 take = std::min(nbytes, piece->data.size() - in_piece);
+    std::copy_n(piece->data.data() + in_piece, take, out_ptr);
+    offset += take;
+    out_ptr += take;
+    nbytes -= take;
+  }
+  return true;
+}
+#endif
+
 bool PlainFileReader::Read(u64 offset, u64 nbytes, u8* out_ptr)
 {
+#ifdef __ORBIS__
+  // Big reads (a game loading a whole file) go straight to the drive: the cache is for the small
+  // scattered ones.
+  if (ps4_disc_cache && nbytes < 512 * 1024 && offset < m_size)
+    return CachedRead(offset, nbytes, out_ptr);
+#endif
   return m_file.OffsetRead(offset, out_ptr, nbytes);
 }
 
