+// The game's progress, Xbox style (host thread). False: the game's achievements aren't loaded
+// (yet) - the caller tries again.
+bool ShowProgressBanner()
+{
+  PS4Achievements::List list;
+  if (!CaptureAchievements(&list))
+    return false;
+  std::string badge;
+  if (DemoMode())
+  {
+    std::lock_guard lock(s_mutex);
+    s_badge_pixels["G"] = DemoBadge(0, false);
+    s_badge_textures.erase("G");
+    badge = "G";
+  }
+#ifdef USE_RETRO_ACHIEVEMENTS
+  else
+  {
+    auto& manager = AchievementManager::GetInstance();
+    std::lock_guard lock(manager.GetLock());
+    if (manager.PS4HasGameBadge())
+    {
+      CopyBadge("G", manager.GetGameBadge());
+      badge = "G";
+    }
+  }
+#endif
+  Banner banner;
+  banner.title = list.game.empty() ? SConfig::GetInstance().GetTitleName() : list.game;
+  banner.line = std::to_string(list.unlocked) + " of " + std::to_string(list.total) +
+                " achievements   " + std::to_string(list.points) + " / " +
+                std::to_string(list.points_total) + " points" +
+                (list.hardcore ? "   Hardcore" : "");
+  banner.badge = badge;
+  banner.progress =
+      list.total ? static_cast<float>(list.unlocked) / static_cast<float>(list.total) : 0.0f;
+  Log("achievements: banner: " + banner.title + " - " + banner.line);
+  std::lock_guard lock(s_mutex);
+  s_banners.push_back(std::move(banner));
