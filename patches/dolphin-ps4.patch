+      {"40", "40"}, {"30", "30"}, {"20", "20"}, {"10", "10"}, {"0", "0"}},
+     "100", true, "Volume of the games' sound."},
+    {"wii_extension", "Wii Extension", "System", {{"nunchuk", "Nunchuk"}, {"none", "None"}},
+     "nunchuk", false,
