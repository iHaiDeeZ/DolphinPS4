+#ifdef USE_RETRO_ACHIEVEMENTS
+void CopyBadge(const std::string& key, const AchievementManager::Badge& badge)
+{
+  if (badge.width == 0 || badge.height == 0 ||
+      badge.data.size() < static_cast<size_t>(badge.width) * badge.height * 4)
+    return;
+  BadgePixels pixels;
+  pixels.width = badge.width;
+  pixels.height = badge.height;
+  pixels.rgba.assign(badge.data.data(), badge.data.data() + badge.width * badge.height * 4);
+  std::lock_guard lock(s_mutex);
+  s_badge_pixels[key] = std::move(pixels);
+  s_badge_textures.erase(key);  // made again from the new picture
+}
+
+void SavePng(const std::string& path, const AchievementManager::Badge& badge)
+{
+  if (path.empty() || badge.width == 0 || access(path.c_str(), F_OK) == 0 ||
+      badge.data.size() < static_cast<size_t>(badge.width) * badge.height * 4)
+    return;
+  Common::SavePNG(path, badge.data.data(), Common::ImageByteFormat::RGBA, badge.width,
+                  badge.height, badge.width * 4);
+}
+#endif
+
+// The page's badges (host thread): copied for the video thread to draw.
+void CopyPageBadges()
+{
+  if (DemoMode())
+  {
+    std::lock_guard lock(s_mutex);
+    for (const PS4Achievements::Entry& entry : s_ach.entries)
+    {
+      const std::string key = (entry.unlocked ? "U" : "L") + std::to_string(entry.id);
+      if (!s_badge_pixels.contains(key))
+        s_badge_pixels[key] = DemoBadge(entry.id, !entry.unlocked);
+    }
+    return;
+  }
+#ifdef USE_RETRO_ACHIEVEMENTS
+  auto& manager = AchievementManager::GetInstance();
+  std::lock_guard lock(manager.GetLock());
+  for (const PS4Achievements::Entry& entry : s_ach.entries)
+  {
+    const bool locked = !entry.unlocked;
+    CopyBadge((locked ? "L" : "U") + std::to_string(entry.id),
+              manager.GetAchievementBadge(entry.id, locked));
+  }
+#endif
+}
+
+// Saved for the XMB (Triangle on the game -> Achievements, the Achievements category), with
+// the badge pictures it doesn't have yet.
+void SaveAchievements()
+{
+  PS4Achievements::List list;
+  if (!CaptureAchievements(&list))
+    return;
+  if (DemoMode())
+  {
+    PS4Achievements::Save("DEMO", list);
+    const std::string data_dir = PS4Achievements::DataDir();
+    mkdir((data_dir + "/achievements/badges").c_str(), 0777);
+    const auto save = [](const std::string& path, const BadgePixels& p) {
+      if (!path.empty() && access(path.c_str(), F_OK) != 0)
+      {
+        Common::SavePNG(path, p.rgba.data(), Common::ImageByteFormat::RGBA, p.width, p.height,
+                        p.width * 4);
+      }
+    };
+    save(PS4Achievements::GameBadgePath(data_dir, list.badge), DemoBadge(0, false));
+    for (const PS4Achievements::Entry& entry : list.entries)
+    {
+      save(PS4Achievements::BadgePath(data_dir, entry.badge, false), DemoBadge(entry.id, false));
+      save(PS4Achievements::BadgePath(data_dir, entry.badge, true), DemoBadge(entry.id, true));
+    }
+    return;
+  }
+  PS4Achievements::Save(PlayKey(), list);
+#ifdef USE_RETRO_ACHIEVEMENTS
+  const std::string data_dir = PS4Achievements::DataDir();
+  if (data_dir.empty())
+    return;
+  mkdir((data_dir + "/achievements/badges").c_str(), 0777);
+  auto& manager = AchievementManager::GetInstance();
+  std::lock_guard lock(manager.GetLock());
+  if (manager.PS4HasGameBadge())
+    SavePng(PS4Achievements::GameBadgePath(data_dir, list.badge), manager.GetGameBadge());
+  for (const PS4Achievements::Entry& entry : list.entries)
+  {
+    for (const bool locked : {false, true})
+    {
+      if (manager.PS4HasAchievementBadge(entry.id, locked))
+      {
+        SavePng(PS4Achievements::BadgePath(data_dir, entry.badge, locked),
+                manager.GetAchievementBadge(entry.id, locked));
+      }
+    }
+  }
+#endif
+}
