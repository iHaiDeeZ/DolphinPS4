+
+void Menu::AddShare(std::string address)
+{
+  while (!address.empty() && (address.back() == ' ' || address.back() == '/'))
+    address.pop_back();
+  while (!address.empty() && address.front() == ' ')
+    address.erase(address.begin());
+  if (!Common::NetFS::IsNetPath(address) || address.size() <= 6)
+  {
+    m_share_status = "Not an nfs:// or smb:// address";
+    return;
+  }
+  std::vector<std::string> shares = PS4XMB::NetworkShares(m_data_dir);
+  if (std::find(shares.begin(), shares.end(), address) == shares.end())
+    shares.push_back(address);
+  PS4XMB::SaveNetworkShares(m_data_dir, shares);
+  Common::NetFS::SetShares(shares);
+  std::vector<Common::NetFS::Entry> entries;
+  const bool reached = Common::NetFS::List(address, &entries);
+  Log("network shares: added " + Common::NetFS::Redact(address) +
+      (reached ? " (" + std::to_string(entries.size()) + " entries)" :
+                 " - " + Common::NetFS::LastError()));
+  m_share_status = reached ? "Connected" : Common::NetFS::LastError();
+  RefreshGames();
+}
