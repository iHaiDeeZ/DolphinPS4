+void Menu::BuildCenterRows()
+{
+  std::vector<SettingRow> rows;
+  rows.push_back({"Source", "GitHub: iHaiDeeZ/DolphinPS4", "center:info"});
+  std::string updated = "Copy in the app";
+  if (m_center_fetched_copy)
+  {
+    struct stat st;
+    if (stat((m_data_dir + "/game-settings.ini").c_str(), &st) == 0)
+      updated = DateText(static_cast<int64_t>(st.st_mtime));
+  }
+  rows.push_back({"Last Update", updated, "center:info"});
+  rows.push_back({"Games Covered", std::to_string(m_center.size()), "center:info"});
+  {
+    std::lock_guard lock(m_center_mutex);
+    rows.push_back({"Update Now", m_settings_busy ? "Updating..." : m_center_status, "center:update"});
+  }
+  rows.push_back({"Your Games", "", "", true});
+  size_t mine = 0;
+  for (size_t i = 0; i < m_games.size(); i++)
+  {
+    if (!CenterFor(m_games[i].id))
+      continue;
+    SettingRow row{m_games[i].title, CenterChoiceLabel(m_games[i].id),
+                   "center:game:" + std::to_string(i)};
+    row.tag = PS4Center::Choice(m_games[i].id) == "no" ? -1 : 1;
+    rows.push_back(std::move(row));
+    mine++;
+  }
+  if (mine == 0)
+    rows.push_back({"None of your games yet", "", "", true});
