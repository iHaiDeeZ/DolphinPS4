+// A badge's texture, made from its copied pixels the first time it is drawn (s_mutex held).
+AbstractTexture* BadgeTexture(const std::string& key)
+{
+  if (key.empty() || !g_gfx)
+    return nullptr;
+  const auto made = s_badge_textures.find(key);
+  if (made != s_badge_textures.end())
+    return made->second.get();
+  const auto pixels = s_badge_pixels.find(key);
+  if (pixels == s_badge_pixels.end())
+    return nullptr;
+  const BadgePixels& p = pixels->second;
+  TextureConfig config(p.width, p.height, 1, 1, 1, AbstractTextureFormat::RGBA8, 0,
+                       AbstractTextureType::Texture_2DArray);
+  std::unique_ptr<AbstractTexture> texture = g_gfx->CreateTexture(config);
+  if (texture)
+    texture->Load(0, p.width, p.height, p.width, p.rgba.data(), p.rgba.size());
+  AbstractTexture* result = texture.get();
+  s_badge_textures[key] = std::move(texture);
+  return result;
+}
+
+// A trophy cup (the achievement's points: bronze, silver, gold, platinum).
+void DrawTrophy(ImDrawList* dl, ImVec2 c, float s, ImU32 color)
+{
+  const float r = s * 0.5f;
+  const float w = r * 0.56f, top = c.y - r * 0.78f, mid = c.y - r * 0.3f;
+  dl->PathArcTo(ImVec2(c.x, mid), w, 0.0f, 3.14159265f, 20);
+  dl->PathLineTo(ImVec2(c.x - w, top));
+  dl->PathLineTo(ImVec2(c.x + w, top));
+  dl->PathFillConvex(color);
+  dl->AddCircle(ImVec2(c.x - w, c.y - r * 0.5f), r * 0.24f, color, 16, r * 0.1f);
+  dl->AddCircle(ImVec2(c.x + w, c.y - r * 0.5f), r * 0.24f, color, 16, r * 0.1f);
+  dl->AddRectFilled(ImVec2(c.x - r * 0.09f, c.y + r * 0.2f), ImVec2(c.x + r * 0.09f, c.y + r * 0.6f),
+                    color);
+  dl->AddRectFilled(ImVec2(c.x - r * 0.42f, c.y + r * 0.58f), ImVec2(c.x + r * 0.42f, c.y + r * 0.82f),
+                    color, r * 0.08f);
+}
+
+// The text cut to a width, with "...".
+std::string Ellipsize(ImFont* font, float size, const std::string& text, float width)
+{
+  if (font->CalcTextSizeA(size, FLT_MAX, 0, text.c_str()).x <= width)
+    return text;
+  std::string cut = text;
+  while (!cut.empty() && font->CalcTextSizeA(size, FLT_MAX, 0, (cut + "...").c_str()).x > width)
+  {
+    cut.pop_back();
+    while (!cut.empty() && (static_cast<unsigned char>(cut.back()) & 0xC0) == 0x80)
+      cut.pop_back();  // a whole UTF-8 character
+  }
+  return cut + "...";
+}
+
+// An achievement as on the PS3's trophy list: badge, name, description, status, type, trophy.
+void DrawAchievementRow(ImDrawList* dl, const Row& row, float x0, float y, float panel_w, float s,
+                        float a, bool sel, ImFont* bold, ImFont* regular)
+{
+  const int alpha = static_cast<int>(255 * a);
+  const float b = 84 * s;
+  float tx = x0 + 60 * s;
+  if (AbstractTexture* badge = BadgeTexture(row.badge))
+  {
+    dl->AddImageRounded(ImTextureRef(*badge), ImVec2(tx, y + 6 * s), ImVec2(tx + b, y + 6 * s + b),
+                        ImVec2(0, 0), ImVec2(1, 1),
+                        IM_COL32(255, 255, 255, row.locked ? alpha * 3 / 4 : alpha), 8 * s);
+  }
+  else
+  {
+    dl->AddRectFilled(ImVec2(tx, y + 6 * s), ImVec2(tx + b, y + 6 * s + b),
+                      IM_COL32(40, 50, 70, alpha), 8 * s);
+  }
+  tx += b + 20 * s;
+  const float right = x0 + panel_w - 130 * s;
+  const float width = right - tx;
+  const ImU32 white = IM_COL32(255, 255, 255, row.locked ? alpha * 7 / 10 : alpha);
+  const ImU32 dim = IM_COL32(255, 255, 255, static_cast<int>(150 * a));
+  dl->AddText(bold, (sel ? 31 : 29) * s, ImVec2(tx, y + 6 * s), white,
+              Ellipsize(bold, (sel ? 31 : 29) * s, row.label, width).c_str());
+  dl->AddText(regular, 22 * s, ImVec2(tx, y + 42 * s), dim,
+              Ellipsize(regular, 22 * s, row.sub, width).c_str());
+  // Status, then the type and rarity tags.
+  const ImU32 gold = IM_COL32(255, 200, 70, alpha);
+  float sx = tx;
+  const float ss = 21 * s, sy = y + 70 * s;
+  dl->AddText(regular, ss, ImVec2(sx, sy), row.locked ? dim : gold, row.status.c_str());
+  sx += regular->CalcTextSizeA(ss, FLT_MAX, 0, row.status.c_str()).x + 16 * s;
+  const char* type = PS4Achievements::TypeName(row.ach_type);
+  if (*type)
+  {
+    const ImU32 fill = row.ach_type == 1 ? IM_COL32(200, 60, 70, static_cast<int>(220 * a)) :
+                       row.ach_type == 3 ? IM_COL32(200, 150, 30, static_cast<int>(220 * a)) :
+                                           IM_COL32(50, 120, 220, static_cast<int>(220 * a));
+    const float tw = bold->CalcTextSizeA(18 * s, FLT_MAX, 0, type).x;
+    dl->AddRectFilled(ImVec2(sx, sy), ImVec2(sx + tw + 18 * s, sy + 24 * s), fill, 12 * s);
+    dl->AddText(bold, 18 * s, ImVec2(sx + 9 * s, sy + 3 * s), IM_COL32(255, 255, 255, alpha), type);
+    sx += tw + 30 * s;
+  }
+  if (row.rarity >= 0.0f && sx < right - 60 * s)
+  {
+    char rarity[32];
+    snprintf(rarity, sizeof(rarity), "%.1f%%", row.rarity);
+    dl->AddText(regular, ss, ImVec2(sx, sy), dim, rarity);
+  }
+  // The trophy and the points.
+  static const ImU32 TIERS[] = {IM_COL32(205, 127, 50, 255), IM_COL32(205, 127, 50, 255),
+                                IM_COL32(200, 205, 215, 255), IM_COL32(255, 200, 70, 255),
+                                IM_COL32(170, 215, 255, 255)};
+  ImU32 tier = TIERS[std::clamp(row.tier, 0, 4)];
+  const int tier_alpha = row.locked ? static_cast<int>(90 * a) : alpha;
+  tier = (tier & 0x00FFFFFF) | (static_cast<ImU32>(tier_alpha) << 24);
+  const float cx = x0 + panel_w - 85 * s;
+  DrawTrophy(dl, ImVec2(cx, y + 34 * s), 46 * s, tier);
+  const float pw = regular->CalcTextSizeA(22 * s, FLT_MAX, 0, row.value.c_str()).x;
+  dl->AddText(regular, 22 * s, ImVec2(cx - pw * 0.5f, y + 66 * s), row.locked ? dim : white,
+              row.value.c_str());
+}
+
+float Smooth(float x)
+{
+  x = std::clamp(x, 0.0f, 1.0f);
+  return x * x * (3.0f - 2.0f * x);
+}
+
+// The Xbox-style banner at the bottom centre: the circle pops in, the bar opens to the right of
+// it, the text fades in; 6 s later it closes the same way.
+bool DrawBanner(ImDrawList* dl, ImFont* bold, ImFont* regular, float s, Clock::time_point now)
+{
+  if (s_banners.empty())
+    return false;
+  if (!s_banner_showing)
+  {
+    s_banner_showing = true;
+    s_banner_start = now;
+  }
+  constexpr float SHOW = 6.0f;
+  const float t = std::chrono::duration<float>(now - s_banner_start).count();
+  if (t > SHOW)
+  {
+    s_banners.erase(s_banners.begin());
+    s_banner_showing = false;
+    return !s_banners.empty();
+  }
+  const Banner& banner = s_banners.front();
+  {
+    static const Banner* s_logged = nullptr;
+    if (s_logged != &banner)
+    {
+      s_logged = &banner;
+      Log("achievements: banner drawn");
+    }
+  }
+  const ImVec2 size = ImGui::GetIO().DisplaySize;
+  const float circle = std::min(Smooth(t / 0.3f), Smooth((SHOW - t) / 0.3f));
+  const float open = std::min(Smooth((t - 0.25f) / 0.45f), Smooth((SHOW - 0.3f - t) / 0.45f));
+  const float text_a = std::min(Smooth((t - 0.55f) / 0.3f), Smooth((SHOW - 0.55f - t) / 0.25f));
+  const float h = 104 * s;
+  const float title_w = bold->CalcTextSizeA(32 * s, FLT_MAX, 0, banner.title.c_str()).x;
+  const float line_w = regular->CalcTextSizeA(24 * s, FLT_MAX, 0, banner.line.c_str()).x;
+  const float full = std::min(size.x - 200 * s,
+                              std::max(520 * s, h + 30 * s + std::max(title_w, line_w) + 48 * s));
+  const float w = h + (full - h) * open;
+  const float x = size.x * 0.5f - full * 0.5f, y = size.y - 140 * s - h;
+  // The bar (it opens from behind the circle).
+  if (open > 0.0f)
+  {
+    dl->AddRectFilled(ImVec2(x, y), ImVec2(x + w, y + h),
+                      IM_COL32(28, 30, 34, static_cast<int>(238 * std::max(open, 0.2f))), h * 0.5f);
+    dl->PushClipRect(ImVec2(x + h * 0.5f, y), ImVec2(x + w - 10 * s, y + h), true);
+    const int ta = static_cast<int>(255 * text_a);
+    const float tx = x + h + 26 * s;
+    dl->AddText(bold, 32 * s, ImVec2(tx, y + 16 * s), IM_COL32(255, 255, 255, ta),
+                Ellipsize(bold, 32 * s, banner.title, full - h - 70 * s).c_str());
+    dl->AddText(regular, 24 * s, ImVec2(tx, y + 56 * s), IM_COL32(200, 205, 215, ta),
+                Ellipsize(regular, 24 * s, banner.line, full - h - 70 * s).c_str());
+    if (banner.progress >= 0.0f)
+    {
+      const float bx0 = tx, bx1 = x + full - 46 * s, by = y + h - 16 * s;
+      dl->AddRectFilled(ImVec2(bx0, by), ImVec2(bx1, by + 5 * s),
+                        IM_COL32(255, 255, 255, static_cast<int>(50 * text_a)), 3 * s);
+      if (banner.progress > 0.0f)
+      {
+        dl->AddRectFilled(ImVec2(bx0, by),
+                          ImVec2(bx0 + (bx1 - bx0) * std::min(banner.progress, 1.0f), by + 5 * s),
+                          IM_COL32(16, 190, 90, ta), 3 * s);
+      }
+    }
+    dl->PopClipRect();
+  }
+  // The circle: the game's badge, or a trophy.
+  const ImVec2 c(x + h * 0.5f, y + h * 0.5f);
+  const float r = h * 0.5f * (0.6f + 0.4f * circle);
+  const int ca = static_cast<int>(255 * circle);
+  dl->AddCircleFilled(c, r, IM_COL32(16, 124, 16, ca), 48);
+  if (AbstractTexture* badge = BadgeTexture(banner.badge))
+  {
+    const float b = r - 7 * s;
+    dl->AddImageRounded(ImTextureRef(*badge), ImVec2(c.x - b, c.y - b), ImVec2(c.x + b, c.y + b),
+                        ImVec2(0, 0), ImVec2(1, 1), IM_COL32(255, 255, 255, ca), b);
+  }
+  else
+  {
+    DrawTrophy(dl, c, r * 1.1f, IM_COL32(255, 255, 255, ca));
+  }
+  return true;
+}
