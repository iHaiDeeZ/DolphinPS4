+extern "C" void ps4_probe_center_pixel(const char* name, const AbstractTexture* texture)
+{
+  GLint prev_read = 0;
+  glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &prev_read);
+  while (glGetError() != GL_NO_ERROR)
+  {
+  }
