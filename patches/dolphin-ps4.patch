+        if (m_fences[previous])
+          glDeleteSync(m_fences[previous]);
+        m_fences[previous] = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+      }
+      // Before rewriting this group, wait until the GPU has finished with it.
+      GLsync& fence = m_fences[m_next / GROUP];
+      if (fence)
+      {
+        glClientWaitSync(fence, GL_SYNC_FLUSH_COMMANDS_BIT, 1000000000ULL);
+        glDeleteSync(fence);
+        fence = nullptr;
+      }
+    }
+    const GLuint buffer = m_buffers[m_next];
+    m_next = (m_next + 1) % m_count;
+    m_used = true;
+    glBindBuffer(GL_UNIFORM_BUFFER, buffer);
+    // An unsynchronized map is cheap on Piglet (~1 us), glBufferSubData is not (~37 us); the
+    // fences above already guarantee the GPU is done with this buffer. But gameplay scenes then
+    // render with missing and stray geometry, with or without GL_MAP_INVALIDATE_RANGE_BIT (Piglet
