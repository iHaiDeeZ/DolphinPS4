+// Draining wrappers: wait for the worker, then call RADV directly.
+VKAPI_ATTR VkResult VKAPI_CALL Drain_vkWaitForFences(VkDevice d, uint32_t n, const VkFence* f,
+                                                     VkBool32 all, uint64_t timeout)
+{
+  PS4CommandRecorderDrain();
+  timespec t0, t1;
+  clock_gettime(CLOCK_MONOTONIC, &t0);
+  const VkResult result = s_real.real_vkWaitForFences(d, n, f, all, timeout);
+  clock_gettime(CLOCK_MONOTONIC, &t1);
+  ps4_wait_add(3, (t1.tv_sec - t0.tv_sec) * 1000000000ll + (t1.tv_nsec - t0.tv_nsec));
+  return result;
+}
