+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// The PS4 in-game menu: L3+R3 pauses the game and shows an XMB-style overlay (resume, save and
+// load states, aspect ratio, FPS counter, quit to the XMB). Its logic runs on the host thread
+// (PlatformPS4's main loop); it is drawn by Dolphin's on-screen ImGui layer on the video thread,
+// which keeps redrawing the paused frame while the menu is open (VideoCommon/Fifo.cpp).
+
+#pragma once
+
+namespace Core
+{
+class System;
+}
+
+namespace PS4IngameMenu
+{
+// Called by PlatformPS4's main loop (~60 times a second).
+void Poll(Core::System& system);
+// Installs the overlay drawing hook (VideoCommon/OnScreenUI.cpp).
+void Install();
+// "Quit Game" was chosen: the app restarts into the XMB instead of closing.
+bool ReturnToXMB();
+}  // namespace PS4IngameMenu
diff --git a/Source/Core/DolphinNoGUI/PS4Net.cpp b/Source/Core/DolphinNoGUI/PS4Net.cpp
new file mode 100755
index 0000000..023f183
--- /dev/null
+++ b/Source/Core/DolphinNoGUI/PS4Net.cpp
@@ -0,0 +1,245 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "DolphinNoGUI/PS4Net.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+
+#include <curl/curl.h>
+#include <orbis/Net.h>
+#include <orbis/Sysmodule.h>
+
+extern "C" void ps4_boot_trace(const char* line);  // port/ps4_crashlog.cpp
+
+namespace PS4Net
+{
+namespace
+{
+std::mutex s_init_mutex;
+int s_pool = -1;
+
+void Log(const std::string& text)
+{
+  fprintf(stderr, "[net] %s\n", text.c_str());
+  ps4_boot_trace(("net: " + text).c_str());
+}
+
+// libSceNet and curl, once per process.
+bool Init(std::string* error)
+{
+  std::lock_guard lock(s_init_mutex);
+  if (s_pool >= 0)
+    return true;
+  sceSysmoduleLoadModuleInternal(ORBIS_SYSMODULE_INTERNAL_NET);
+  const int init = sceNetInit();
+  s_pool = sceNetPoolCreate("dolphin-net", 64 * 1024, 0);
+  char line[96];
+  snprintf(line, sizeof(line), "init %#x, pool %#x", static_cast<unsigned>(init),
+           static_cast<unsigned>(s_pool));
+  Log(line);
+  curl_global_init(CURL_GLOBAL_DEFAULT);
+  if (s_pool < 0)
+  {
+    *error = "the PS4 network is not available";
+    return false;
+  }
+  return true;
+}
+
+// "https://host[:port]/path" -> host, port.
+bool SplitUrl(const std::string& url, std::string* host, int* port)
+{
+  const size_t scheme = url.find("://");
+  if (scheme == std::string::npos)
+    return false;
+  const size_t start = scheme + 3;
+  const size_t end = url.find_first_of("/?#", start);
+  std::string authority = url.substr(start, end == std::string::npos ? std::string::npos :
+                                                                        end - start);
+  const size_t at = authority.rfind('@');
+  if (at != std::string::npos)
+    authority = authority.substr(at + 1);
+  *port = url.compare(0, 5, "https") == 0 ? 443 : 80;
+  const size_t colon = authority.rfind(':');
+  if (colon != std::string::npos)
+  {
+    *port = std::atoi(authority.c_str() + colon + 1);
+    authority = authority.substr(0, colon);
+  }
+  *host = authority;
+  return !host->empty() && *port > 0;
+}
+
+struct Transfer
+{
+  CURL* curl = nullptr;
+  const Sink* sink = nullptr;
+  const Progress* progress = nullptr;
+  bool stopped = false;
+  std::string notes;  // curl's own connection notes, logged when a request fails
+};
+
+int Debug(CURL*, curl_infotype type, char* data, size_t size, void* user)
+{
+  auto* transfer = static_cast<Transfer*>(user);
+  if (type == CURLINFO_TEXT && transfer->notes.size() < 4096)
+    transfer->notes.append(data, size);
+  return 0;
+}
+
+size_t Write(char* data, size_t size, size_t count, void* user)
+{
+  auto* transfer = static_cast<Transfer*>(user);
+  long status = 0;
+  curl_easy_getinfo(transfer->curl, CURLINFO_RESPONSE_CODE, &status);
+  if (status < 200 || status >= 300)
+    return size * count;  // a redirect's or an error page's body
+  if (!(*transfer->sink)(data, size * count))
+  {
+    transfer->stopped = true;
+    return 0;
+  }
+  return size * count;
+}
+
+int XferInfo(void* user, curl_off_t total, curl_off_t now, curl_off_t, curl_off_t)
+{
+  auto* transfer = static_cast<Transfer*>(user);
+  long status = 0;
+  curl_easy_getinfo(transfer->curl, CURLINFO_RESPONSE_CODE, &status);
+  if (status < 200 || status >= 300 || !*transfer->progress)
+    return 0;
+  if (!(*transfer->progress)(static_cast<uint64_t>(now), static_cast<uint64_t>(total)))
+  {
+    transfer->stopped = true;
+    return 1;
+  }
+  return 0;
+}
+}  // namespace
+
+std::string Resolve(const std::string& host, std::string* error)
+{
+  if (!Init(error))
+    return {};
+  const OrbisNetId resolver = sceNetResolverCreate("dolphin-net", s_pool, 0);
+  if (resolver < 0)
+  {
+    *error = "the PS4 network is not available";
+    return {};
+  }
+  OrbisNetInAddr address = {};
+  const int result =
+      sceNetResolverStartNtoa(resolver, host.c_str(), &address, 5 * 1000 * 1000, 2, 0);
+  sceNetResolverDestroy(resolver);
+  if (result < 0)
+  {
+    char line[160];
+    snprintf(line, sizeof(line), "could not look up %s (%#x): is the PS4 online?", host.c_str(),
+             static_cast<unsigned>(result));
+    *error = line;
+    return {};
+  }
+  const uint32_t a = address.s_addr;  // network byte order
+  char text[32];
+  snprintf(text, sizeof(text), "%u.%u.%u.%u", a & 0xFF, (a >> 8) & 0xFF, (a >> 16) & 0xFF,
+           (a >> 24) & 0xFF);
+  return text;
+}
+
+long Get(const Request& request, const Sink& sink, const Progress& progress, std::string* error)
+{
+  if (!Init(error))
+    return 0;
+  std::string url = request.url;
+  for (int hop = 0; hop < 6; hop++)
+  {
+    std::string host;
+    int port = 0;
+    if (!SplitUrl(url, &host, &port))
+    {
+      *error = "bad address: " + url;
+      return 0;
+    }
+    const std::string address = Resolve(host, error);
+    if (address.empty())
+      return 0;
+
+    CURL* curl = curl_easy_init();
+    Transfer transfer{curl, &sink, &progress};
+    const std::string resolve = host + ":" + std::to_string(port) + ":" + address;
+    curl_slist* resolves = curl_slist_append(nullptr, resolve.c_str());
+    curl_slist* headers = nullptr;
+    for (const std::string& header : request.headers)
+      headers = curl_slist_append(headers, header.c_str());
+    char detail[CURL_ERROR_SIZE] = {};
+    curl_easy_setopt(curl, CURLOPT_URL, url.c_str());
+    curl_easy_setopt(curl, CURLOPT_RESOLVE, resolves);
+    curl_easy_setopt(curl, CURLOPT_HTTPHEADER, headers);
+    curl_easy_setopt(curl, CURLOPT_USERAGENT, "Dolphin-PS4");
+    curl_easy_setopt(curl, CURLOPT_CAINFO, request.ca_file.c_str());
+    curl_easy_setopt(curl, CURLOPT_SSL_VERIFYPEER, 1L);
+    curl_easy_setopt(curl, CURLOPT_SSL_VERIFYHOST, 2L);
+    curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 0L);  // each hop is looked up here
+    curl_easy_setopt(curl, CURLOPT_CONNECTTIMEOUT, 15L);
+    curl_easy_setopt(curl, CURLOPT_TIMEOUT, request.timeout_seconds);
+    // A stalled download (no data for a minute) ends instead of hanging.
+    curl_easy_setopt(curl, CURLOPT_LOW_SPEED_LIMIT, 1L);
+    curl_easy_setopt(curl, CURLOPT_LOW_SPEED_TIME, 60L);
+    curl_easy_setopt(curl, CURLOPT_NOSIGNAL, 1L);
+    curl_easy_setopt(curl, CURLOPT_ERRORBUFFER, detail);
+    curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, Write);
+    curl_easy_setopt(curl, CURLOPT_WRITEDATA, &transfer);
+    curl_easy_setopt(curl, CURLOPT_XFERINFOFUNCTION, XferInfo);
+    curl_easy_setopt(curl, CURLOPT_XFERINFODATA, &transfer);
+    curl_easy_setopt(curl, CURLOPT_NOPROGRESS, 0L);
+    curl_easy_setopt(curl, CURLOPT_VERBOSE, 1L);
+    curl_easy_setopt(curl, CURLOPT_DEBUGFUNCTION, Debug);
+    curl_easy_setopt(curl, CURLOPT_DEBUGDATA, &transfer);
+
+    const CURLcode code = curl_easy_perform(curl);
+    long status = 0;
+    curl_easy_getinfo(curl, CURLINFO_RESPONSE_CODE, &status);
+    char* location = nullptr;
+    curl_easy_getinfo(curl, CURLINFO_REDIRECT_URL, &location);
+    const std::string next = location ? location : "";
+    curl_slist_free_all(headers);
+    curl_slist_free_all(resolves);
+    curl_easy_cleanup(curl);
+
+    if (transfer.stopped)
+    {
+      *error = "cancelled";
+      return 0;
+    }
+    if (code != CURLE_OK)
+    {
+      *error = std::string(curl_easy_strerror(code)) + (detail[0] ? std::string(": ") + detail : "");
+      Log(host + ": " + *error);
+      size_t start = 0;
+      while (start < transfer.notes.size())
+      {
+        const size_t end = transfer.notes.find('\n', start);
+        const std::string line = transfer.notes.substr(
+            start, end == std::string::npos ? std::string::npos : end - start);
+        if (!line.empty())
+          Log("  curl: " + line);
+        if (end == std::string::npos)
+          break;
+        start = end + 1;
+      }
+      return 0;
+    }
+    if (status >= 300 && status < 400 && !next.empty())
+    {
+      url = next;
+      continue;
+    }
+    return status;
+  }
+  *error = "too many redirects";
+  return 0;
+}
+}  // namespace PS4Net
diff --git a/Source/Core/DolphinNoGUI/PS4Net.h b/Source/Core/DolphinNoGUI/PS4Net.h
new file mode 100755
index 0000000..c539699
--- /dev/null
+++ b/Source/Core/DolphinNoGUI/PS4Net.h
@@ -0,0 +1,35 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// HTTPS for the XMB (box art, updates): curl with the PS4's own host name lookup, since the C
+// library has no DNS configuration on the PS4. Every host, including those reached through
+// redirects, is looked up with libSceNet's resolver and handed to curl.
+
+#pragma once
+
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <vector>
+
+namespace PS4Net
+{
+// The host's IPv4 address as text, or empty with *error set.
+std::string Resolve(const std::string& host, std::string* error);
+
+struct Request
+{
+  std::string url;
+  std::vector<std::string> headers;  // "Name: value"
+  std::string ca_file;               // certificate bundle; the check is always on
+  long timeout_seconds = 30;         // for the whole transfer (0: none)
+};
+
+// Receives the body of the final (2xx) answer; false stops the transfer.
+using Sink = std::function<bool(const char* data, size_t size)>;
+// Bytes received of the expected total (0 if unknown); false cancels.
+using Progress = std::function<bool(uint64_t done, uint64_t total)>;
+
+// GET with redirects followed (up to 5). Returns the final HTTP status, or 0 with *error set.
+long Get(const Request& request, const Sink& sink, const Progress& progress, std::string* error);
+}  // namespace PS4Net
