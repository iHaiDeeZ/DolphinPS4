+
+extern "C" long long ps4_map_count, ps4_unmap_count, ps4_map_internal_bytes;  // MemArenaPS4
+extern "C" long long ps4_pt_groups_mapped, ps4_pt_groups_refused;              // Memmap.cpp
+extern "C" double ps4_thread_cpu_seconds(int slot);  // port/ps4_sampler.cpp
+// cpu_clock=auto (MainNoGUI.cpp): current clock in percent (0 = off) and its range.
+extern "C" int ps4_auto_clock, ps4_auto_clock_min, ps4_auto_clock_max;
+int ps4_auto_clock = 0, ps4_auto_clock_min = 60, ps4_auto_clock_max = 100;
