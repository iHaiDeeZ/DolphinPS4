+
+bool IsNetPath(std::string_view path)
+{
+  return StartsWithNoCase(path, "nfs://") || StartsWithNoCase(path, "smb://");
+}
+
+void SetShares(std::vector<std::string> roots)
+{
+  std::lock_guard lock(s_mutex);
+  s_shares = std::move(roots);
+  s_stats.clear();
+}
+
+std::string Redact(const std::string& url)
+{
+  const size_t scheme = url.find("://");
+  if (scheme == std::string::npos)
+    return url;
+  const size_t host_end = url.find('/', scheme + 3);
+  const size_t at = url.rfind('@', host_end);
+  if (at == std::string::npos || at < scheme)
+    return url;
+  const size_t colon = url.find(':', scheme + 3);
+  if (colon == std::string::npos || colon > at)
+    return url;
+  return url.substr(0, colon + 1) + "***" + url.substr(at);
+}
+
+std::string LastError()
+{
+  std::lock_guard lock(s_mutex);
+  return s_last_error;
+}
+
+bool List(const std::string& url, std::vector<Entry>* entries)
+{
+  entries->clear();
+  const std::optional<Location> location = Resolve(url, true);
+  if (!location)
+  {
+    Fail(url, "not a network address (nfs://server/export or smb://server/share)");
+    return false;
+  }
+  Connection* c = Acquire(*location, url);
+  if (!c)
+    return false;
+  bool ok = true;
+  if (c->kind == Kind::NFS)
+  {
+    nfsdir* dir = nullptr;
+    if (nfs_opendir(c->nfs, location->path.c_str(), &dir) != 0)
+    {
+      Fail(url, std::string("can't list: ") + nfs_get_error(c->nfs));
+      ok = false;
+    }
+    else
+    {
+      while (nfsdirent* entry = nfs_readdir(c->nfs, dir))
+      {
+        const bool directory = entry->type == NF3DIR || S_ISDIR(entry->mode);
+        entries->push_back({entry->name, directory, entry->size});
+      }
+      nfs_closedir(c->nfs, dir);
+    }
+  }
+  else
+  {
+    smb2dir* dir = smb2_opendir(c->smb, location->path.c_str());
+    if (!dir)
+    {
+      Fail(url, std::string("can't list: ") + smb2_get_error(c->smb));
+      ok = false;
+    }
+    else
+    {
+      while (smb2dirent* entry = smb2_readdir(c->smb, dir))
+      {
+        entries->push_back(
+            {entry->name, entry->st.smb2_type == SMB2_TYPE_DIRECTORY, entry->st.smb2_size});
+      }
+      smb2_closedir(c->smb, dir);
+    }
+  }
+  Release(c, false);
+  std::erase_if(*entries, [](const Entry& e) { return e.name == "." || e.name == ".."; });
+  // What the listing says about each entry saves a request per file while the library is read.
+  const std::string base = TrimSlashes(url);
+  for (const Entry& entry : *entries)
+    RememberStat(base + "/" + entry.name, true, entry.directory, entry.size);
+  return ok;
+}
+
+bool Stat(const std::string& url, u64* size, bool* directory)
+{
+  const std::string key = TrimSlashes(url);
+  {
+    std::lock_guard lock(s_mutex);
+    const auto it = s_stats.find(key);
+    if (it != s_stats.end() && Clock::now() - it->second.when < STAT_LIFETIME)
+    {
+      *size = it->second.size;
+      *directory = it->second.directory;
+      return it->second.exists;
+    }
+  }
+  const std::optional<Location> location = Resolve(url, false);
+  if (!location)
+    return false;
+  Connection* c = Acquire(*location, url);
+  if (!c)
+    return false;
+  int result;
+  if (c->kind == Kind::NFS)
+  {
+    nfs_stat_64 st{};
+    result = nfs_stat64(c->nfs, location->path.c_str(), &st);
+    *size = st.nfs_size;
+    *directory = S_ISDIR(st.nfs_mode);
+  }
+  else
+  {
+    smb2_stat_64 st{};
+    result = smb2_stat(c->smb, location->path.c_str(), &st);
+    *size = st.smb2_size;
+    *directory = st.smb2_type == SMB2_TYPE_DIRECTORY;
+  }
+  // Missing: a normal answer. Anything else: the connection may be gone.
+  Release(c, result < 0 && result != -ENOENT && result != -ENOTDIR);
+  const bool exists = result == 0;
+  if (!exists)
+  {
+    *size = 0;
+    *directory = false;
+  }
+  RememberStat(url, exists, *directory, *size);
+  return exists;
+}
+
+bool IsHandle(int handle)
+{
+  return handle >= HANDLE_BASE;
+}
+
+int OpenHandle(const std::string& url)
+{
+  const std::optional<Location> location = Resolve(url, false);
+  if (!location)
+  {
+    Fail(url, "not a network address");
+    return -1;
+  }
+  auto stream = std::make_shared<Stream>();
+  stream->url = url;
+  stream->location = *location;
+  if (!OpenFile(*stream))
+    return -1;
+  RememberStat(url, true, false, stream->size);
+  std::lock_guard lock(s_mutex);
+  const int handle = s_next_handle++;
+  s_handles[handle] = std::move(stream);
+  return handle;
+}
+
+bool ReadAt(int handle, u64 offset, u8* out, u64 size)
+{
+  const std::shared_ptr<Stream> stream = FindHandle(handle);
+  if (!stream)
+    return false;
+  std::lock_guard lock(stream->mutex);
+  return Read(*stream, offset, out, size);
+}
+
+u64 HandleSize(int handle)
+{
+  const std::shared_ptr<Stream> stream = FindHandle(handle);
+  return stream ? stream->size : 0;
+}
+
+int DuplicateHandle(int handle)
+{
+  std::lock_guard lock(s_mutex);
+  const auto it = s_handles.find(handle);
+  if (it == s_handles.end())
+    return -1;
+  const int copy = s_next_handle++;
+  s_handles[copy] = it->second;
+  return copy;
+}
+
+void CloseHandle(int handle)
+{
+  std::shared_ptr<Stream> stream;
+  {
+    std::lock_guard lock(s_mutex);
+    const auto it = s_handles.find(handle);
+    if (it == s_handles.end())
+      return;
+    stream = std::move(it->second);
+    s_handles.erase(it);
+  }
+  // The last handle of the file closes it.
+  if (stream.use_count() == 1)
+  {
+    std::lock_guard lock(stream->mutex);
+    CloseFile(*stream, false);
+  }
+}
+
+std::FILE* OpenStream(const std::string& url)
+{
+  const int handle = OpenHandle(url);
+  if (handle < 0)
+    return nullptr;
+  Cookie* cookie = new Cookie{handle};
+  std::FILE* file =
+      fopencookie(cookie, "rb", cookie_io_functions_t{CookieRead, nullptr, CookieSeek, CookieClose});
+  if (!file)
+  {
+    CloseHandle(handle);
+    delete cookie;
+  }
+  return file;
+}
+}  // namespace Common::NetFS
