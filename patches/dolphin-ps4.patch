+void Menu::DrawLibraryCards(ImDrawList* dl, float alpha)
+{
+  const Theme& theme = CurrentTheme();
+  const int c = static_cast<int>(Category::MemoryCards);
+  const auto& items = m_items[c];
+  const int selected = m_selected[c];
+  Text(dl, m_bold, 50, ImVec2(90, 150), Rgba(theme.text, alpha), "Memory Cards");
+  Text(dl, m_bold, 26, ImVec2(92, 214), Rgba(theme.wave, alpha * 0.85f), "Slot A: " + m_slot_a, false);
+
+  // The cards, top to bottom (the list scrolls with the selection).
+  constexpr float LIST_X = 90.0f, LIST_W = 600.0f, ROW_H = 118.0f, TOP = 280.0f, BOTTOM = 960.0f;
+  const float visible = (BOTTOM - TOP) / ROW_H;
+  const float scroll = std::clamp(m_item_pos[c] - visible * 0.5f + 0.5f, 0.0f,
+                                  std::max(0.0f, static_cast<float>(items.size()) - visible));
+  dl->PushClipRect(ImVec2(0, TOP - 20), ImVec2(W, BOTTOM + 10), true);
+  for (int i = 0; i < static_cast<int>(items.size()); i++)
+  {
+    const Item& item = items[i];
+    const float y = TOP + (static_cast<float>(i) - scroll) * ROW_H;
+    if (y < TOP - ROW_H || y > BOTTOM)
+      continue;
+    const bool sel = i == selected;
+    const ImVec2 r0(LIST_X, y), r1(LIST_X + LIST_W, y + ROW_H - 18);
+    dl->AddRectFilled(r0, r1, sel ? Rgba(theme.wave, alpha * 0.20f) : Rgba(0x000000, alpha * 0.25f), 14.0f);
+    dl->AddRect(r0, r1, sel ? Rgba(theme.wave, alpha) : Rgba(theme.text, alpha * 0.12f), 14.0f, 0,
+                sel ? 2.5f : 1.5f);
+    const ImVec2 icon(LIST_X + 58, y + (ROW_H - 18) * 0.5f);
+    if (item.card == CARD_NEW)
+    {
+      dl->AddCircle(icon, 28, Rgba(theme.text, alpha), 40, 3.5f);
+      dl->AddLine(ImVec2(icon.x - 13, icon.y), ImVec2(icon.x + 13, icon.y), Rgba(theme.text, alpha), 4.0f);
+      dl->AddLine(ImVec2(icon.x, icon.y - 13), ImVec2(icon.x, icon.y + 13), Rgba(theme.text, alpha), 4.0f);
+    }
+    else
+    {
+      const bool in_slot = m_cards[item.card].name == m_slot_a;
+      DrawMemoryCardIcon(dl, icon, 72, in_slot ? Rgba(theme.wave, alpha) : Rgba(0x8A90A0, alpha),
+                         Rgba(0xFFFFFF, alpha * 0.85f));
+    }
+    Text(dl, m_bold, 32, ImVec2(LIST_X + 110, y + 14), Rgba(theme.text, alpha), item.label);
+    std::string detail = item.detail;
+    if (item.card >= 0)
+    {
+      const auto& card = m_cards[item.card];
+      const size_t saves = card.saves.size();
+      detail = std::to_string(saves) + (saves == 1 ? " save" : " saves") + "  -  " +
+               std::to_string(card.blocks) + " blocks";
+      if (card.name == m_slot_a)
+      {
+        // A green SLOT A tag.
+        const float tw = TextWidth(m_bold, 22, "SLOT A");
+        const ImVec2 t0(LIST_X + LIST_W - tw - 54, y + 18), t1(LIST_X + LIST_W - 24, y + 52);
+        dl->AddRectFilled(t0, t1, Rgba(0x28AA5A, alpha * 0.9f), 17.0f);
+        Text(dl, m_bold, 22, ImVec2(t0.x + 15, t0.y + 4), Rgba(0xFFFFFF, alpha), "SLOT A", false);
+      }
+    }
+    Text(dl, m_font, 25, ImVec2(LIST_X + 110, y + 58), Rgba(theme.text, alpha * 0.72f), detail);
+  }
+  dl->PopClipRect();
+
+  // The selected card's saves on the right.
+  constexpr float PANE_X = 760.0f, PANE_R = W - 90.0f;
+  dl->AddRectFilled(ImVec2(PANE_X, TOP - 20), ImVec2(PANE_R, BOTTOM - 8), Rgba(0x000000, alpha * 0.28f), 18.0f);
+  dl->AddRect(ImVec2(PANE_X, TOP - 20), ImVec2(PANE_R, BOTTOM - 8), Rgba(theme.text, alpha * 0.10f), 18.0f, 0, 1.5f);
+  if (items.empty())
+    return;
+  const Item& item = items[selected];
+  if (item.card == CARD_NEW)
+  {
+    const char* lines[] = {"A new, empty memory card.",
+                           "",
+                           "Put it in Slot A to start fresh saves - for a second",
+                           "playthrough, or to share the console with someone.",
+                           "Your other cards and their saves stay as they are,",
+                           "and you can switch back at any time.",
+                           "",
+                           "Press Cross to create it."};
+    float y = TOP + 20;
+    for (const char* line : lines)
+    {
+      Text(dl, m_font, 30, ImVec2(PANE_X + 40, y), Rgba(theme.text, alpha * 0.85f), line);
+      y += 46;
+    }
+    return;
+  }
+  const PS4MemoryCards::Card& card = m_cards[item.card];
+  Text(dl, m_bold, 32, ImVec2(PANE_X + 40, TOP + 4), Rgba(theme.text, alpha), "Saves on " + card.name);
+  if (card.saves.empty())
+  {
+    Text(dl, m_font, 28, ImVec2(PANE_X + 40, TOP + 70), Rgba(theme.text, alpha * 0.7f),
+         "No saves yet. Put the card in Slot A and save in a game.");
+    return;
+  }
+  const float row_h = 82.0f;
+  const int fits = static_cast<int>((BOTTOM - TOP - 140) / row_h);
+  const int shown = std::min(fits, static_cast<int>(card.saves.size()));
+  for (int i = 0; i < shown; i++)
+  {
+    const PS4MemoryCards::Save& save = card.saves[i];
+    const float y = TOP + 64 + i * row_h;
+    const ImVec2 i0(PANE_X + 40, y), i1(PANE_X + 104, y + 64);
+    const ImTextureID icon = SaveIcon(item.card, i);
+    if (icon != ImTextureID{})
+    {
+      dl->AddImage(ImTextureRef(icon), i0, i1, ImVec2(0, 0), ImVec2(1, 1),
+                   IM_COL32(255, 255, 255, static_cast<int>(alpha * 255)));
+    }
+    else
+    {
+      dl->AddRectFilled(i0, i1, Rgba(0x8A90A0, alpha * 0.5f), 8.0f);
+    }
+    std::string title = save.title;
+    while (title.size() > 4 && TextWidth(m_bold, 28, title) > PANE_R - PANE_X - 470)
+      title = title.substr(0, title.size() - 4) + "...";
+    Text(dl, m_bold, 28, ImVec2(PANE_X + 124, y + 2), Rgba(theme.text, alpha), title);
+    std::string desc = save.description;
+    while (desc.size() > 4 && TextWidth(m_font, 23, desc) > PANE_R - PANE_X - 470)
+      desc = desc.substr(0, desc.size() - 4) + "...";
+    Text(dl, m_font, 23, ImVec2(PANE_X + 124, y + 38), Rgba(theme.text, alpha * 0.65f), desc);
+    const std::string blocks = std::to_string(save.blocks) + (save.blocks == 1 ? " block" : " blocks");
+    const std::string date = DateText(save.modified);
+    Text(dl, m_font, 24, ImVec2(PANE_R - 40 - TextWidth(m_font, 24, blocks), y + 4),
+         Rgba(theme.text, alpha * 0.8f), blocks);
+    Text(dl, m_font, 22, ImVec2(PANE_R - 40 - TextWidth(m_font, 22, date), y + 38),
+         Rgba(theme.text, alpha * 0.55f), date);
+  }
+  if (static_cast<int>(card.saves.size()) > shown)
+  {
+    const std::string more = "+ " + std::to_string(card.saves.size() - shown) +
+                             " more - press Cross to see them all";
+    Text(dl, m_font, 26, ImVec2(PANE_X + 40, TOP + 64 + shown * row_h + 6),
+         Rgba(theme.wave, alpha * 0.9f), more);
+  }
+}
