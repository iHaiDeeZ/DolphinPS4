+void Menu::LoadAssets()
+{
+  ImGuiIO& io = ImGui::GetIO();
+  const std::string fonts = m_assets_dir + "/xmb/fonts/";
+  m_font = io.Fonts->AddFontFromFileTTF((fonts + "Nunito-Regular.ttf").c_str(), 32.0f);
+  m_bold = io.Fonts->AddFontFromFileTTF((fonts + "Nunito-ExtraBold.ttf").c_str(), 32.0f);
+  if (!m_font)
+    m_font = io.Fonts->AddFontDefault();
+  if (!m_bold)
+    m_bold = m_font;
+
+  for (const char* name :
+       {"move", "category", "confirm", "back", "launch", "error", "menu", "intro"})
+  {
+    // A sound in data_dir/themes/sounds replaces the built-in one.
+    std::unique_ptr<Sound> sound = LoadWav(m_data_dir + "/themes/sounds/" + name + ".wav");
+    if (!sound)
+      sound = LoadWav(m_assets_dir + "/xmb/sounds/" + name + ".wav");
+    if (sound)
+      m_sounds[name] = std::move(sound);
+    else
+      Log(std::string("sound not loaded: ") + name);
+  }
+  Log("sounds loaded: " + std::to_string(m_sounds.size()));
+
+  const std::string resources = m_assets_dir + "/Sys/Resources/";
+  m_icon_gc = LoadPngTexture(resources + "Platform_Gamecube@4x.png");
+  m_icon_wii = LoadPngTexture(resources + "Platform_Wii@4x.png");
+  m_logo = LoadPngTexture(resources + "dolphin_logo@2x.png");
+  m_intro_dolphin =
+      LoadPngTexture(m_assets_dir + "/xmb/intro-dolphin.png", &m_intro_dolphin_aspect);
+  m_intro_title = LoadPngTexture(m_assets_dir + "/xmb/intro-title.png", &m_intro_title_aspect);
+  LoadCovers();
+  LoadBanners();
+
+  std::error_code error;
+  for (const auto& entry :
+       std::filesystem::directory_iterator(m_data_dir + "/themes", error))
+  {
+    std::string name = entry.path().filename().string();
+    std::string lower = name;
+    std::transform(lower.begin(), lower.end(), lower.begin(), ::tolower);
+    if (lower.size() > 4 && lower.compare(lower.size() - 4, 4, ".png") == 0)
+      m_wallpapers.push_back(name);
+  }
+  std::sort(m_wallpapers.begin(), m_wallpapers.end());
+}
+
+// Banners from the discs (GameCube; Wii discs carry none Dolphin can read without a NAND).
+void Menu::LoadBanners()
+{
+  for (Game& game : m_games)
+  {
+    std::unique_ptr<DiscIO::VolumeDisc> disc = DiscIO::CreateDisc(game.path);
+    if (!disc)
+      continue;
+    game.wii = disc->GetVolumeType() == DiscIO::Platform::WiiDisc;
+    if (game.wii)
+      continue;
+    u32 width = 0, height = 0;
+    const std::vector<u32> banner = disc->GetBanner(&width, &height);
+    if (banner.empty() || width == 0 || height == 0)
+      continue;
+    std::vector<u8> rgba(banner.size() * 4);
+    for (size_t i = 0; i < banner.size(); i++)
+    {
+      const u32 argb = banner[i];
+      rgba[i * 4] = (argb >> 16) & 0xFF;
+      rgba[i * 4 + 1] = (argb >> 8) & 0xFF;
+      rgba[i * 4 + 2] = argb & 0xFF;
+      rgba[i * 4 + 3] = argb >> 24;
+    }
+    game.banner = m_display.CreateTexture(rgba.data(), width, height);
+    game.banner_aspect = static_cast<float>(width) / static_cast<float>(height);
+  }
+}
