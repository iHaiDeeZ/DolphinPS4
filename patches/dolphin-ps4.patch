+  for (size_t i = 0; i < (sizeof(PixelShaderConstants) - pixel_end) / sizeof(u32); i++)
+    out.Write("\tuint ps4_pad{};\n", i);
+  out.Write("{}", s_shader_uniforms);
+  out.Write("}};\n\n");
