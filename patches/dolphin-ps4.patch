+EmuCodeBlock::PS4TlbProbe EmuCodeBlock::PS4SoftTlbProbe(X64Reg reg_addr, BitSet32 avoid,
+                                                        BitSet32 registers_in_use, bool write,
+                                                        int access_size, bool dr)
+{
+  static_assert(sizeof(PowerPC::MMU::SoftTlbEntry) == 16);
+  static_assert(offsetof(PowerPC::MMU::SoftTlbEntry, host) == 8);
+  PS4TlbProbe probe;
+  // Two registers that are neither the address nor the value; saved if they are live.
+  avoid[reg_addr] = true;
+  X64Reg picked[2];
+  int count = 0;
+  for (const X64Reg r : {RSCRATCH, RSCRATCH2, RSCRATCH_EXTRA, RSI, RDI, R8, R9, R10, R11})
+  {
+    if (count < 2 && !avoid[r])
+      picked[count++] = r;
+  }
+  if (count < 2)
+    return probe;
+  probe.active = true;
+  probe.host = picked[0];
+  probe.other = picked[1];
+  probe.push_host = registers_in_use[probe.host];
+  probe.push_other = registers_in_use[probe.other];
+  if (probe.push_host)
+    PUSH(probe.host);
+  if (probe.push_other)
+    PUSH(probe.other);
+  const X64Reg entry = probe.other, tag = probe.host;
+  // entry = &table[(address >> 12) & (SIZE - 1)]
+  MOV(32, R(entry), R(reg_addr));
+  SHR(32, R(entry), Imm8(PowerPC::HW_PAGE_INDEX_SHIFT));
+  AND(32, R(entry), Imm32(PowerPC::MMU::SOFT_TLB_SIZE - 1));
+  SHL(32, R(entry), Imm8(4));
+  MOV(64, R(tag), ImmPtr(m_jit.m_mmu.PS4SoftTlbData(write)));
+  ADD(64, R(entry), R(tag));
+  // The tag MMU::SoftTlbFill wrote: page number | DR | valid.
+  MOV(32, R(tag), R(reg_addr));
+  SHR(32, R(tag), Imm8(PowerPC::HW_PAGE_INDEX_SHIFT));
+  OR(32, R(tag), Imm32(0x200000u | (dr ? 0x100000u : 0u)));
+  CMP(32, R(tag), MatR(entry));
+  probe.miss[probe.misses++] = J_CC(CC_NE, Jump::Near);
+  // Within the page (an access across two pages takes the C path), then host = page + offset.
+  MOV(32, R(tag), R(reg_addr));
+  AND(32, R(tag), Imm32(PowerPC::HW_PAGE_MASK));
+  if (access_size > 8)
+  {
+    CMP(32, R(tag), Imm32(PowerPC::HW_PAGE_SIZE - access_size / 8));
+    probe.miss[probe.misses++] = J_CC(CC_A, Jump::Near);
+  }
+  ADD(64, R(tag), MDisp(entry, 8));
+  return probe;
+}
