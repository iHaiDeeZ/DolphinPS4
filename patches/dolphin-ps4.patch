diff --git a/Source/Core/InputCommon/ControllerInterface/PS4Pad/PS4Pad.cpp b/Source/Core/InputCommon/ControllerInterface/PS4Pad/PS4Pad.cpp
new file mode 100644
index 0000000..1f1d6a7
--- /dev/null
+++ b/Source/Core/InputCommon/ControllerInterface/PS4Pad/PS4Pad.cpp
@@ -0,0 +1,272 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "InputCommon/ControllerInterface/PS4Pad/PS4Pad.h"
+
+#include <algorithm>
+#include <cstring>
+#include <map>
+#include <string>
+#include <vector>
+
+#include <orbis/Pad.h>
+#include <orbis/UserService.h>
+
+#include "Common/CommonTypes.h"
+#include "Common/Logging/Log.h"
+#include "InputCommon/ControllerInterface/ControllerInterface.h"
+
+// The in-game menu (DolphinNoGUI/PS4IngameMenu.cpp) reads the first DualShock 4 itself; while
+// it is open, and until its buttons are released, the game sees a neutral pad.
+extern "C" int ps4_pad_handle;
+int ps4_pad_handle = -1;
+extern "C" int ps4_pad_block;
+int ps4_pad_block = 0;
+// Players with a DualShock 4 (signed-in users, up to 4): DolphinNoGUI turns on that many
+// GameCube ports / Wii Remotes.
+extern "C" int ps4_pad_count;
+int ps4_pad_count = 0;
+
+namespace ciface::PS4Pad
+{
+constexpr std::string_view SOURCE_NAME = "PS4";
+constexpr int32_t INVALID_USER = -1;
+constexpr int MAX_PLAYERS = 4;
+
+// Open pads by user. They stay open while the user is signed in, across device refreshes (a
+// player joining or leaving), so the first player's handle - read directly by the in-game menu -
+// stays valid.
+std::map<int32_t, int32_t> s_handles;
+
+class Device final : public Core::Device
+{
+private:
+  class Button final : public Input
+  {
+  public:
+    Button(const char* name, const u32& buttons, u32 mask)
+        : m_name(name), m_buttons(buttons), m_mask(mask)
+    {
+    }
+    std::string GetName() const override { return m_name; }
+    ControlState GetState() const override { return (m_buttons & m_mask) != 0; }
+
+  private:
+    const char* const m_name;
+    const u32& m_buttons;
+    const u32 m_mask;
+  };
+
+  // A trigger (0..255) or one direction of a stick axis (0..255, centered at 128).
+  class Axis final : public Input
+  {
+  public:
+    Axis(const char* name, const u8& value, bool is_trigger, bool negative)
+        : m_name(name), m_value(value), m_is_trigger(is_trigger), m_negative(negative)
+    {
+    }
+    std::string GetName() const override { return m_name; }
+    ControlState GetState() const override
+    {
+      if (m_is_trigger)
+        return m_value / 255.0;
+      const ControlState centered = (m_value - 127.5) / 127.5;
+      return m_negative ? -centered : centered;
+    }
+
+  private:
+    const char* const m_name;
+    const u8& m_value;
+    const bool m_is_trigger;
+    const bool m_negative;
+  };
+
+  class Motor final : public Output
+  {
+  public:
+    Motor(const char* name, Device& device, bool large) : m_name(name), m_device(device), m_large(large)
+    {
+    }
+    std::string GetName() const override { return m_name; }
+    void SetState(ControlState state) override { m_device.SetMotor(m_large, state); }
+
+  private:
+    const char* const m_name;
+    Device& m_device;
+    const bool m_large;
+  };
+
+public:
+  Device(int32_t user_id, int32_t handle) : m_user_id(user_id), m_handle(handle)
+  {
+    // clang-format off
+    AddInput(new Button("Cross",         m_buttons, ORBIS_PAD_BUTTON_CROSS));
+    AddInput(new Button("Circle",        m_buttons, ORBIS_PAD_BUTTON_CIRCLE));
+    AddInput(new Button("Square",        m_buttons, ORBIS_PAD_BUTTON_SQUARE));
+    AddInput(new Button("Triangle",      m_buttons, ORBIS_PAD_BUTTON_TRIANGLE));
+    AddInput(new Button("L1",            m_buttons, ORBIS_PAD_BUTTON_L1));
+    AddInput(new Button("R1",            m_buttons, ORBIS_PAD_BUTTON_R1));
+    AddInput(new Button("L2 Click",      m_buttons, ORBIS_PAD_BUTTON_L2));
+    AddInput(new Button("R2 Click",      m_buttons, ORBIS_PAD_BUTTON_R2));
+    AddInput(new Button("L3",            m_buttons, ORBIS_PAD_BUTTON_L3));
+    AddInput(new Button("R3",            m_buttons, ORBIS_PAD_BUTTON_R3));
+    AddInput(new Button("Options",       m_buttons, ORBIS_PAD_BUTTON_OPTIONS));
+    AddInput(new Button("Touchpad",      m_buttons, ORBIS_PAD_BUTTON_TOUCH_PAD));
+    AddInput(new Button("Pad N",         m_buttons, ORBIS_PAD_BUTTON_UP));
+    AddInput(new Button("Pad S",         m_buttons, ORBIS_PAD_BUTTON_DOWN));
+    AddInput(new Button("Pad W",         m_buttons, ORBIS_PAD_BUTTON_LEFT));
+    AddInput(new Button("Pad E",         m_buttons, ORBIS_PAD_BUTTON_RIGHT));
+
+    AddInput(new Axis("L2",              m_state.analogButtons.l2, true, false));
+    AddInput(new Axis("R2",              m_state.analogButtons.r2, true, false));
+    // Stick Y grows downwards (0 = up): "Y-" (up) is the lower half of the value range.
+    AddInput(new Axis("Left X-",         m_state.leftStick.x, false, true));
+    AddInput(new Axis("Left X+",         m_state.leftStick.x, false, false));
+    AddInput(new Axis("Left Y-",         m_state.leftStick.y, false, true));
+    AddInput(new Axis("Left Y+",         m_state.leftStick.y, false, false));
+    AddInput(new Axis("Right X-",        m_state.rightStick.x, false, true));
+    AddInput(new Axis("Right X+",        m_state.rightStick.x, false, false));
+    AddInput(new Axis("Right Y-",        m_state.rightStick.y, false, true));
+    AddInput(new Axis("Right Y+",        m_state.rightStick.y, false, false));
+
+    AddOutput(new Motor("Motor L",       *this, true));
+    AddOutput(new Motor("Motor R",       *this, false));
+    // clang-format on
+  }
+
+  ~Device() override
+  {
+    // The pad itself stays open (s_handles); it is closed when its user signs out.
+    OrbisPadVibeParam off = {0, 0};
+    scePadSetVibration(m_handle, &off);
+  }
+
+  std::string GetName() const override { return "DualShock 4"; }
+  std::string GetSource() const override { return std::string(SOURCE_NAME); }
+  int32_t GetUserId() const { return m_user_id; }
+
+  Core::DeviceRemoval UpdateInput() override
+  {
+    OrbisPadData data;
+    std::memset(&data, 0, sizeof(data));
+    if (!ps4_pad_block && scePadReadState(m_handle, &data) == 0 && data.connected)
+    {
+      m_state = data;
+      m_buttons = data.buttons;
+    }
+    else
+    {
+      // Disconnected (or the user signed out): report a neutral pad.
+      m_buttons = 0;
+      m_state.leftStick = {128, 128};
+      m_state.rightStick = {128, 128};
+      m_state.analogButtons = {0, 0};
+    }
+    return Core::DeviceRemoval::Keep;
+  }
+
+  void SetMotor(bool large, ControlState state)
+  {
+    const u8 value = static_cast<u8>(std::clamp(state, 0.0, 1.0) * 255);
+    if (large)
+      m_vibration.lgMotor = value;
+    else
+      m_vibration.smMotor = value;
+    scePadSetVibration(m_handle, &m_vibration);
+  }
+
+private:
+  const int32_t m_user_id;
+  const int32_t m_handle;
+  OrbisPadData m_state{};
+  u32 m_buttons = 0;
+  OrbisPadVibeParam m_vibration{0, 0};
+};
+
+class InputBackend final : public ciface::InputBackend
+{
+public:
+  explicit InputBackend(ControllerInterface* controller_interface)
+      : ciface::InputBackend(controller_interface)
+  {
+    int32_t result = sceUserServiceInitialize(nullptr);
+    // Already initialized by another part of the app is fine.
+    if (result != 0 && result != static_cast<int32_t>(0x80960003))
+      WARN_LOG_FMT(CONTROLLERINTERFACE, "sceUserServiceInitialize: {:#x}", static_cast<u32>(result));
+    result = scePadInit();
+    if (result != 0)
+      ERROR_LOG_FMT(CONTROLLERINTERFACE, "scePadInit: {:#x}", static_cast<u32>(result));
+  }
+
+  void PopulateDevices() override
+  {
+    GetControllerInterface().RemoveDevice(
+        [](const auto* device) { return device->GetSource() == SOURCE_NAME; });
+
+    // Players in order: the user who started the app first (player 1, who also has the in-game
+    // menu), then the other signed-in users in sign-in order. Each one's DualShock 4 becomes
+    // "PS4/<player - 1>/DualShock 4" (the controller mappings, DolphinNoGUI/PS4Controls.cpp).
+    int32_t initial = INVALID_USER;
+    sceUserServiceGetInitialUser(&initial);
+    OrbisUserServiceLoginUserIdList users;
+    std::memset(&users, 0xFF, sizeof(users));
+    if (sceUserServiceGetLoginUserIdList(&users) != 0)
+      std::memset(&users, 0xFF, sizeof(users));
+    std::vector<int32_t> players;
+    if (initial != INVALID_USER)
+      players.push_back(initial);
+    for (const int32_t user : users.userId)
+    {
+      if (user != INVALID_USER && user != initial && players.size() < MAX_PLAYERS)
+        players.push_back(user);
+    }
+
+    // Users who signed out: close their pads.
+    for (auto it = s_handles.begin(); it != s_handles.end();)
+    {
+      if (std::find(players.begin(), players.end(), it->first) == players.end())
+      {
+        INFO_LOG_FMT(CONTROLLERINTERFACE, "DualShock 4 of user {:#x} closed",
+                     static_cast<u32>(it->first));
+        if (ps4_pad_handle == it->second)
+          ps4_pad_handle = -1;
+        scePadClose(it->second);
+        it = s_handles.erase(it);
+      }
+      else
+      {
+        ++it;
+      }
+    }
+
+    int count = 0;
+    for (const int32_t user : players)
+    {
+      auto it = s_handles.find(user);
+      if (it == s_handles.end())
+      {
+        const int32_t handle = scePadOpen(user, ORBIS_PAD_PORT_TYPE_STANDARD, 0, nullptr);
+        if (handle < 0)
+        {
+          WARN_LOG_FMT(CONTROLLERINTERFACE, "scePadOpen(user {:#x}): {:#x}",
+                       static_cast<u32>(user), static_cast<u32>(handle));
+          continue;
+        }
+        INFO_LOG_FMT(CONTROLLERINTERFACE, "DualShock 4 of user {:#x} opened (handle {})",
+                     static_cast<u32>(user), handle);
+        it = s_handles.emplace(user, handle).first;
+      }
+      if (count == 0)
+        ps4_pad_handle = it->second;
+      GetControllerInterface().AddDevice(std::make_shared<Device>(user, it->second));
+      count++;
+    }
+    ps4_pad_count = count;
+  }
+};
+
+std::unique_ptr<ciface::InputBackend> CreateInputBackend(ControllerInterface* controller_interface)
+{
+  return std::make_unique<InputBackend>(controller_interface);
+}
+}  // namespace ciface::PS4Pad
