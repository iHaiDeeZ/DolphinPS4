+// Rewind checkpoints: a state every minute of play while a rewind hotkey is set (polled while
+// the game runs and the menu is closed). Old checkpoint files of this game go at the start.
+void RewindTick(Core::System& system)
+{
+  const auto now = Clock::now();
+  const float dt =
+      std::clamp(std::chrono::duration<float>(now - s_rewind_tick).count(), 0.0f, 1.0f);
+  s_rewind_tick = now;
+  const std::string game = SConfig::GetInstance().GetGameID();
+  if (game.empty())
+    return;
+  const auto path = [&game](size_t n) {
+    return File::GetUserPath(D_STATESAVES_IDX) + game + ".rewind" + std::to_string(n);
+  };
+  if (!s_rewind_cleaned)
+  {
+    s_rewind_cleaned = true;
+    for (size_t n = 0; n <= MAX_CHECKPOINTS; n++)
+      File::Delete(path(n));
+  }
+  const std::string key = PS4Settings::Get("hotkey_rewind");
+  if (key.empty() || key == "off")
+  {
+    s_checkpoint_clock = 0.0f;
+    ps4_film_record = 0;
+    return;
+  }
+  if (s_rewind_pending)
+  {
+    if (now >= s_rewind_load_at)
+    {
+      s_rewind_pending = false;
+      s_rewind_loading = true;
+      State::LoadAs(system, s_rewind_target);
+    }
+    return;
+  }
+  if (s_rewind_loading)
+    return;
+  ps4_film_record = 1;
+#ifdef USE_RETRO_ACHIEVEMENTS
+  if (AchievementManager::GetInstance().IsHardcoreModeActive())
+    return;
+#endif
+  if (s_checkpoint_saving)
+  {
+    if (ps4_state_busy == 0)
+      s_checkpoint_saving = false;
+    return;
+  }
+  s_checkpoint_clock += dt;
+  if (s_checkpoint_clock < CHECKPOINT_SECONDS || ps4_state_busy > 0)
+    return;
+  s_checkpoint_clock = 0.0f;
+  if (s_checkpoints.size() >= MAX_CHECKPOINTS)
+  {
+    File::Delete(s_checkpoints.back());
+    s_checkpoints.pop_back();
+    if (!s_checkpoint_times.empty())
+      s_checkpoint_times.pop_back();
+  }
+  // A file name none of the kept checkpoints uses.
+  std::string file;
+  for (size_t n = 0; n <= MAX_CHECKPOINTS && file.empty(); n++)
+  {
+    if (std::find(s_checkpoints.begin(), s_checkpoints.end(), path(n)) == s_checkpoints.end())
+      file = path(n);
+  }
+  s_checkpoints.insert(s_checkpoints.begin(), file);
+  s_checkpoint_times.insert(s_checkpoint_times.begin(),
+                            std::chrono::duration_cast<std::chrono::milliseconds>(
+                                Clock::now().time_since_epoch())
+                                .count());
+  s_checkpoint_saving = true;
+  Log("rewind: checkpoint " + file);
+  State::SaveAs(system, file);
+}
+
+// Profiler on: once per session, 20 s into the game, its functions found and the Nintendo SDK
+// ones named from Dolphin's signature database (Sys/totaldb.dsy), written to
+// /data/DolphinPS4/symbols-<ID>.txt ("address size name"): the profiles' hot code by name.
+// The Profiler's list of the game's functions (symbols-<ID>.txt), made the first time the menu
+// opens: the scan stops the game for about a second, which at a fixed time in gameplay showed up
+// as a hitch in every profiled session (Bully, Melee, Donald Duck).
+void SymbolsDump(Core::System& system)
+{
+  static bool s_done = false;
+  if (s_done)
+    return;
+  if (PS4Settings::Get("profiler", s_game_id) == "off")
+    return;
+  s_done = true;
+  const std::string game = SConfig::GetInstance().GetGameID();
+  const auto start = Clock::now();
+  size_t count = 0, named = 0;
+  {
+    const Core::CPUThreadGuard guard(system);
+    auto& db = system.GetPPCSymbolDB();
+    auto& memory = system.GetMemory();
+    PPCAnalyst::FindFunctions(guard, Memory::MEM1_BASE_ADDR,
+                              Memory::MEM1_BASE_ADDR + memory.GetRamSizeReal(), &db);
+    SignatureDB signatures(SignatureDB::HandlerType::DSY);
+    if (signatures.Load(File::GetSysDirectory() + TOTALDB))
+      signatures.Apply(guard, &db);
+    std::string text;
+    db.ForEachSymbol([&](const Common::Symbol& symbol) {
+      char line[64];
+      snprintf(line, sizeof(line), "%08x %u ", symbol.address, symbol.size);
+      text += std::string(line) + symbol.name + "\n";
+      count++;
+      if (symbol.name.rfind("zz_", 0) != 0)
+        named++;
+    });
+    File::WriteStringToFile("/data/DolphinPS4/symbols-" + game + ".txt", text);
+  }
+  const int ms = static_cast<int>(
+      std::chrono::duration_cast<std::chrono::milliseconds>(Clock::now() - start).count());
+  Log("symbols: " + std::to_string(count) + " functions, " + std::to_string(named) +
+      " named from the SDK database (" + std::to_string(ms) + " ms)");
+}
+
+void Activate(Core::System& system)
+{
+  if (s_page != Page::Main)
+  {
+    if (s_page == Page::Settings && s_settings_selected >= 0 &&
+        s_settings_selected < static_cast<int>(s_row_keys.size()) &&
+        PS4Settings::IsHotkey(s_row_keys[s_settings_selected]))
+    {
+      StartCapture(s_row_keys[s_settings_selected]);
+      return;
+    }
+    ChangeSetting(s_settings_selected, 1);
+    return;
+  }
+  switch (s_main_items[s_main_selected])
+  {
+  case MAIN_WII_EXTENSION:
+  case MAIN_WII_SIDEWAYS:
+  case MAIN_WII_TILT:
+  case MAIN_WII_TOUCH:
+    ToggleWiiRemote(s_main_items[s_main_selected], 1);
+    break;
+  case MAIN_RESUME:
+    Close(system);
+    break;
+  case MAIN_SAVE:
+    if (ps4_state_busy > 0)
+    {
+      Toast("Still saving, please wait...");
+      break;
+    }
+    Log("saving state " + std::to_string(s_slot));
+    s_saving_slot = s_slot;
+    State::Save(system, static_cast<u32>(s_slot));
+    Toast("Saving to slot " + std::to_string(s_slot) + "...");
+    break;
+  case MAIN_LOAD:
+    if (ps4_state_busy > 0)
+    {
+      Toast("Still saving, please wait...");
+      break;
+    }
+#ifdef USE_RETRO_ACHIEVEMENTS
+    if (AchievementManager::GetInstance().IsHardcoreModeActive())
+    {
+      Toast("Hardcore Mode is on: no loading states. Turn it off in the game list: Settings -> "
+            "RetroAchievements",
+            6000);
+      break;
+    }
+#endif
+    {
+      // Only states this version can load: a refused one leaves the game as it was, and the menu
+      // stays open with the reason.
+      std::string made_by;
+      const State::PS4Slot status = State::PS4CheckSlot(static_cast<u32>(s_slot), &made_by);
+      if (status != State::PS4Slot::Ready)
+      {
+        Log("slot " + std::to_string(s_slot) + " not loadable (" + std::to_string(int(status)) +
+            ", made by \"" + made_by + "\")");
+        Toast(SlotProblem(s_slot, status, made_by), 4500);
+        break;
+      }
+      Log("loading state " + std::to_string(s_slot) + " (made by " + made_by + ")");
+      s_loading_slot = s_slot;
+      State::Load(system, static_cast<u32>(s_slot));
+      Log("load requested " + std::to_string(s_slot));
+      Close(system);
+      break;
+    }
+  case MAIN_SETTINGS:
+    s_page = Page::Settings;
+    s_settings_selected = 0;
+    break;
+  case MAIN_CONTROLS:
+    s_page = Page::Controls;
+    s_settings_selected = s_wii ? 1 : 0;  // Wii: Extension (row 0 is the section title)
+    break;
+  case MAIN_ACHIEVEMENTS:
+    s_page = Page::Achievements;
+    s_ach_loaded = CaptureAchievements(&s_ach);
+    if (s_ach_loaded)
+      CopyPageBadges();
+    s_settings_selected = 0;
+    break;
+  case MAIN_CHEATS:
+    s_page = Page::Cheats;
+    s_cheats.Load(s_game_id, SConfig::GetInstance().GetRevision());
+    s_settings_selected = 0;
+    BuildRows();
+    // Row 0 is Download Codes; with codes, start on Enable All.
+    if (s_row_keys.size() > 1 && !s_row_keys[1].empty())
+      s_settings_selected = 1;
+    break;
+  case MAIN_RESTART:
+    // The same clean stop as Quit Game (memory cards and the NAND are written as the game saves);
+    // the app then restarts into this game instead of the menu: a fresh boot, like a console reset.
+    s_restart = true;
+    QuitToXMB(system, "restart the game");
+    break;
+  case MAIN_QUIT:
+    QuitToXMB(system, "quit to the XMB");
+    break;
+  }
+}
