+extern "C" unsigned long long ps4_soft_tlb_hits, ps4_soft_tlb_misses;           // MMU.cpp
+extern "C" unsigned long long ps4_soft_tlb_flushes, ps4_soft_tlb_sr_flushes, ps4_soft_tlb_page_inv,
+    ps4_soft_tlb_fills;  // MMU.cpp
+extern "C" long long ps4_compile_internal_bytes, ps4_link_internal_bytes;  // ProgramShaderCache
+#include "Core/System.h"
+
+// The signed-in users (defined below; the main loop watches them for players joining).
+std::array<int32_t, 4> PS4LoginUsers();
+
+extern "C" int sceSystemServiceLoadExec(const char* path, char* const argv[]);
+extern "C" void ps4_boot_trace(const char* stage);
+extern "C" void ps4_dump_thread_stacks(const char* path, const char* reason);  // ps4_sampler.cpp
+// Settings > Diagnostics (PS4Settings.cpp): Performance Log (VideoCommon/Present.cpp) and Freeze
+// Reports (stall, slow start and hang stack dumps, below).
+extern "C" int ps4_perf_log;
+extern "C" int ps4_profile_auto;               // DolphinNoGUI/PS4Settings.cpp
+extern "C" void ps4_sampler_set_enabled(int on);  // DolphinPS4 port/ps4_sampler.cpp
+extern "C" {
+int ps4_freeze_reports = 1;
+}
+extern "C" int ps4_jit_in_system_pool;           // DolphinPS4 port/ps4_runtime.cpp
+extern "C" unsigned long long ps4_fault_count;
+
+#ifdef HAS_VULKAN
+// port/mesa/ac_ps4_drm.c (RADV on GNM).
+extern "C" void ac_ps4_get_gpu_busy(uint64_t* busy_ticks, uint64_t* span_ticks);
+extern "C" uint64_t ac_ps4_flip_ns[3];  // port/mesa/ac_ps4_drm.c: time in ac_ps4_submit_flip
+extern "C" void ac_ps4_get_stats(uint64_t* submitted, uint64_t* completed, uint64_t* bo_bytes,
+                                 uint64_t* bo_count);
+#endif
+
+// Defined below, at file scope (Common/FileUtil.cpp and PS4XMB.cpp use them too).
+extern "C" const char* ps4_self_path();
+extern "C" void ps4_update_started_ok();
+extern "C" void ps4_return_to_menu();
+extern "C" void ps4_relaunch_game();
+extern "C" void ps4_sampler_shutdown();  // port/ps4_sampler.cpp: the profiler stops for good
+extern "C" void ps4_log_injected_modules(const char* when);  // port/ps4_sampler.cpp
+// The version this program was packaged as: scripts/package-dolphin.sh writes it over the
+// "00.00" (a downloaded update must know it isn't the installed program).
+extern "C" const char ps4_built_version[];
+extern "C" __attribute__((used)) const char ps4_built_version[] = "DOLPHINPS4-VERSION:00.00";
+
+namespace
+{
+constexpr char PS4_DATA_DIR_PATH[] = "/data/DolphinPS4";
+
+// /data/DolphinPS4/ps4.ini: "key=value" lines, editable over FTP between runs. Lines after a
+// "[GAMEID]" header (a full game ID like G4BE08, or its first 3 characters for every region) only
+// apply to that game; they override the global lines (ApplyGameOptions).
+std::map<std::string, std::string> s_options;
+std::map<std::string, std::map<std::string, std::string>> s_game_options;
+
+// ps4.ini's global options as read (before settings.ini): the menus' defaults.
+std::map<std::string, std::string> s_ps4_global;
+
+// The version in ps4_built_version (empty in a build that wasn't packaged).
+std::string BuiltVersion()
+{
+  const volatile char* text = ps4_built_version;
+  std::string version;
+  for (size_t i = 19; text[i] != '\0'; i++)
+    version += text[i];
+  return version == "00.00" ? std::string() : version;
+}
+
+std::string FirstLine(const std::string& path)
+{
+  std::ifstream file(path);
+  std::string line;
+  std::getline(file, line);
+  while (!line.empty() && (line.back() == '\r' || line.back() == ' '))
+    line.pop_back();
+  return line;
+}
+
+// Updates unpacked by the XMB's updater (data/app: eboot.bin, xmb/, Sys/).
+const std::string UPDATE_DIR = std::string(PS4_DATA_DIR_PATH) + "/app";
+const std::string UPDATE_PENDING = std::string(PS4_DATA_DIR_PATH) + "/app-starting.txt";
+bool s_running_update = false;
+
+std::string AssetsDir()
+{
+  return s_running_update ? UPDATE_DIR : std::string("/app0");
+}
+
+// The app version (APP_VER of /app0/sce_sys/param.sfo), for the logs and the XMB's About.
+std::string AppVersion()
+{
+  const std::string built = BuiltVersion();
+  if (!built.empty())
+    return built;
+  // Written by scripts/package-dolphin.sh (param.sfo may not be readable from the sandbox).
+  {
+    std::ifstream version("/app0/xmb/version.txt");
+    std::string line;
+    if (std::getline(version, line) && !line.empty())
+    {
+      while (!line.empty() && (line.back() == '\r' || line.back() == ' '))
+        line.pop_back();
+      return line;
+    }
+  }
+  std::ifstream file("/app0/sce_sys/param.sfo", std::ios::binary);
+  const std::string sfo((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());
+  auto u32_at = [&](size_t at) {
+    u32 value = 0;
+    if (at + 4 <= sfo.size())
+      std::memcpy(&value, sfo.data() + at, 4);
+    return value;
+  };
+  if (sfo.size() < 20 || sfo.compare(0, 4, std::string("\0PSF", 4)) != 0)
+    return "?";
+  const u32 keys = u32_at(8), data = u32_at(12), count = u32_at(16);
+  for (u32 i = 0; i < count; i++)
+  {
+    const size_t entry = 20 + i * 16;
+    if (entry + 16 > sfo.size())
+      break;
+    u16 key_offset = 0;
+    std::memcpy(&key_offset, sfo.data() + entry, 2);
+    const size_t key_at = keys + key_offset;
+    if (key_at >= sfo.size() || std::strcmp(sfo.c_str() + key_at, "APP_VER") != 0)
+      continue;
+    const size_t value_at = data + u32_at(entry + 12);
+    if (value_at < sfo.size())
+      return std::string(sfo.c_str() + value_at);
+  }
+  return "?";
+}
+
+// Reads one options file into s_options / s_game_options (later files override earlier ones).
+// sections_only: only its [GAME ID] sections (the game settings center can't change globals).
+void LoadOptionsFile(const std::string& path, bool sections_only = false)
+{
+  FILE* file = fopen(path.c_str(), "r");
+  if (!file)
+    return;
+  char line[256];
+  std::string section;
+  while (fgets(line, sizeof(line), file))
+  {
+    std::string text = line;
+    while (!text.empty() && (text.back() == '\n' || text.back() == '\r' || text.back() == ' '))
+      text.pop_back();
+    if (text.size() > 2 && text.front() == '[' && text.back() == ']')
+    {
+      section = text.substr(1, text.size() - 2);
+      continue;
+    }
+    const size_t equals = text.find('=');
+    if (text.empty() || text[0] == '#' || text[0] == ';' || equals == std::string::npos)
+      continue;
+    if (section.empty())
+    {
+      if (!sections_only)
+        s_options[text.substr(0, equals)] = text.substr(equals + 1);
+    }
+    else
+    {
+      s_game_options[section][text.substr(0, equals)] = text.substr(equals + 1);
+    }
+  }
+  fclose(file);
+}
+
+// The game settings center (xmb/game-settings.ini): the best settings per game. The menu fetches
+// it from GitHub at every start (PS4XMB.cpp); that copy is used when it's a settings center file,
+// else the one in the package.
+std::string s_game_settings_source;
+// The center's per-game sections, kept apart from ps4.ini's so a player's No can leave them out.
+std::map<std::string, std::map<std::string, std::string>> s_center_options;
+// The players' answers to "Use the recommended settings?": game ID -> "yes" / "no" (none yet:
+// used - the menu asks before a game's first start; a game started without the menu uses them).
+const std::string CENTER_CHOICES = std::string(PS4_DATA_DIR_PATH) + "/game-settings-choices.ini";
+std::map<std::string, std::string> s_center_choices;
+
+void LoadCenterChoices()
+{
+  s_center_choices.clear();
+  if (FILE* file = fopen(CENTER_CHOICES.c_str(), "r"))
+  {
+    char line[128];
+    while (fgets(line, sizeof(line), file))
+    {
+      std::string text = line;
+      while (!text.empty() && (text.back() == '\n' || text.back() == '\r' || text.back() == ' '))
+        text.pop_back();
+      const size_t equals = text.find('=');
+      if (!text.empty() && text[0] != '#' && equals != std::string::npos)
+        s_center_choices[text.substr(0, equals)] = text.substr(equals + 1);
+    }
+    fclose(file);
+  }
+}
+
+bool CenterUsed(const std::string& game_id)
+{
+  const auto it = s_center_choices.find(game_id);
+  return it == s_center_choices.end() || it->second != "no";
+}
+
+bool IsGameSettingsFile(const std::string& path)
+{
+  FILE* file = fopen(path.c_str(), "r");
+  if (!file)
+    return false;
+  char line[128] = {};
+  const bool ok = fgets(line, sizeof(line), file) &&
+                  std::string(line).rfind("# Dolphin for PS4 - game settings center", 0) == 0;
+  fclose(file);
+  return ok;
+}
+
+// The built-in defaults shipped with the app (tuned global values), the game settings center's
+// per-game sections, then the user's /data/DolphinPS4/ps4.ini on top.
+void LoadOptions()
+{
+  LoadOptionsFile(AssetsDir() + "/xmb/ps4-defaults.ini");
+  const std::string fetched = std::string(PS4_DATA_DIR_PATH) + "/game-settings.ini";
+  s_game_settings_source =
+      IsGameSettingsFile(fetched) ? fetched : AssetsDir() + "/xmb/game-settings.ini";
+  {
+    // Into s_center_options instead of s_game_options.
+    auto others = std::move(s_game_options);
+    s_game_options.clear();
+    LoadOptionsFile(s_game_settings_source, true);
+    s_center_options = std::move(s_game_options);
+    s_game_options = std::move(others);
+  }
+  LoadCenterChoices();
+  LoadOptionsFile(std::string(PS4_DATA_DIR_PATH) + "/ps4.ini");
+}
+
+// A game's per-game value of an option (3-character section, then the full ID), or empty.
+std::string GameOption(const std::string& game_id, const std::string& key)
+{
+  std::string value;
+  // The settings center first (when the player uses it for this game), then ps4.ini's sections.
+  if (CenterUsed(game_id))
+  {
+    for (const std::string& id : {game_id.substr(0, 3), game_id})
+    {
+      const auto section = s_center_options.find(id);
+      if (section == s_center_options.end())
+        continue;
+      const auto it = section->second.find(key);
+      if (it != section->second.end())
+        value = it->second;
+    }
+  }
+  for (const std::string& id : {game_id.substr(0, 3), game_id})
+  {
+    const auto section = s_game_options.find(id);
+    if (section == s_game_options.end())
+      continue;
+    const auto it = section->second.find(key);
+    if (it != section->second.end())
+      value = it->second;
+  }
+  return value;
+}
+
