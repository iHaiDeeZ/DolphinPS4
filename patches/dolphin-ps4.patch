@@ -0,0 +1,36 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include "Common/CommonTypes.h"
+
+// Setting "Recompiler Check" (jit_verify): 1 = on (DolphinNoGUI/MainNoGUI.cpp).
+extern "C" int ps4_jit_verify;
+
+namespace PS4Jit
+{
+class JitPS4;
+
+// Recompiler check: every compiled block, the first few times it runs, is replayed in Dolphin's
+// interpreter first - on a copy of the registers, its memory writes kept in an overlay
+// (MMU::PS4Shadow) - and at the block's exit what the compiled code did is compared with the
+// interpreter: the exit address, every register and every memory write. Differences go to
+// boot-trace.log ("jit check: ..."). Blocks that touch hardware, the GPU pipe or the caches, or
+// that HLE replaces, can't be replayed and are skipped. Floating point is compared with a small
+// tolerance (Float Rounding and other accuracy settings round differently on purpose).
+// For testing recompiler changes: slow while new code is being checked.
+class Verifier
+{
+public:
+  static void Begin(JitPS4& jit, u32 pc);
+  static void Exit(JitPS4& jit, u32 destination);
+};
+
+// The totals so far, to boot-trace.log (also when the JIT shuts down).
+void VerifySummary();
+
+// Called from the compiled code (JitPS4::DoJit and the block exits).
+void VerifyBeginFromJit(JitPS4* jit, u32 pc);
+void VerifyExitFromJit(JitPS4* jit, u32 destination);
+}  // namespace PS4Jit
