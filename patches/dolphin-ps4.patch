+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "Common/PS4NetFS.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cerrno>
+#include <chrono>
+#include <cstring>
+#include <fcntl.h>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <optional>
+#include <netdb.h>
+#include <poll.h>
+#include <signal.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <nfsc/libnfs.h>
+#include <nfsc/libnfs-raw.h>
+#include <nfsc/libnfs-raw-nfs.h>
+#include <smb2/smb2.h>
+#include <smb2/libsmb2.h>
+
+extern "C" void ps4_boot_trace(const char* line);  // port/ps4_crashlog.cpp
+
+namespace Common::NetFS
+{
+namespace
+{
+using Clock = std::chrono::steady_clock;
+
+// DirectIOFile handles from here up: far above any real file descriptor.
+constexpr int HANDLE_BASE = 0x40000000;
+// Reads smaller than this go through a per-file read-ahead buffer of this size (disc formats read
+// a header, then blocks of 32 KiB - 2 MiB; one network round trip per MiB instead of per block).
+constexpr size_t READ_AHEAD = 1 << 20;
+constexpr auto STAT_LIFETIME = std::chrono::seconds(10);
+constexpr auto IDLE_LIFETIME = std::chrono::seconds(120);
+constexpr size_t IDLE_PER_SERVER = 2;
+
+enum class Kind
+{
+  NFS,
+  SMB,
+};
+
+// Where a path connects: the connection (server and export, or server and share) and the path
+// inside it ("/dir/file" for NFS, "dir/file" for SMB).
+struct Location
+{
+  Kind kind;
+  std::string key;
+  std::string path;
+};
+
+struct Connection
+{
+  Kind kind = Kind::NFS;
+  std::string key;
+  nfs_context* nfs = nullptr;
+  smb2_context* smb = nullptr;
+  bool busy = false;
+  Clock::time_point idle_since;
+
+  ~Connection()
+  {
+    if (nfs)
+      nfs_destroy_context(nfs);
+    if (smb)
+    {
+      smb2_disconnect_share(smb);
+      smb2_destroy_context(smb);
+    }
+  }
+};
+
+struct StatResult
+{
+  bool exists = false;
+  bool directory = false;
+  u64 size = 0;
+  Clock::time_point when;
+};
+
+struct Stream
+{
+  std::mutex mutex;  // one read at a time (copied DirectIOFiles share it)
+  std::string url;
+  Location location;
+  Connection* connection = nullptr;
+  nfsfh* nfs_file = nullptr;
+  smb2fh* smb_file = nullptr;
+  u64 size = 0;
+  std::vector<u8> cache;
+  u64 cache_at = 0;
+  size_t cache_length = 0;
+};
+
+std::mutex s_mutex;  // everything below
+std::vector<std::string> s_shares;
+std::vector<std::unique_ptr<Connection>> s_pool;
+std::map<std::string, StatResult> s_stats;
+std::map<int, std::shared_ptr<Stream>> s_handles;
+int s_next_handle = HANDLE_BASE;
+std::string s_last_error;
+
+void Log(const std::string& text)
+{
+  ps4_boot_trace(("netfs: " + text).c_str());
+}
+
+void Fail(const std::string& url, const std::string& what)
+{
+  const std::string text = Redact(url) + ": " + what;
+  Log(text);
+  std::lock_guard lock(s_mutex);
+  s_last_error = text;
+}
+
+bool StartsWithNoCase(std::string_view text, std::string_view prefix)
+{
+  if (text.size() < prefix.size())
+    return false;
+  for (size_t i = 0; i < prefix.size(); i++)
+  {
+    if (std::tolower(static_cast<unsigned char>(text[i])) != prefix[i])
+      return false;
+  }
+  return true;
+}
+
+std::string TrimSlashes(std::string url)
+{
+  const size_t scheme = url.find("://");
+  while (url.size() > scheme + 3 && url.back() == '/')
+    url.pop_back();
+  return url;
+}
+
+// %XX escapes (user names and passwords: "me%40home").
+std::string Decode(const std::string& text)
+{
+  std::string out;
+  for (size_t i = 0; i < text.size(); i++)
+  {
+    if (text[i] == '%' && i + 2 < text.size() && std::isxdigit(static_cast<unsigned char>(text[i + 1])) &&
+        std::isxdigit(static_cast<unsigned char>(text[i + 2])))
+    {
+      out += static_cast<char>(std::stoi(text.substr(i + 1, 2), nullptr, 16));
+      i += 2;
+    }
+    else
+    {
+      out += text[i];
+    }
+  }
+  return out;
+}
+
+// folder: the path is a folder to list (an NFS path outside the configured shares connects at it).
+std::optional<Location> Resolve(const std::string& raw, bool folder)
+{
+  const std::string url = TrimSlashes(raw);
+  const size_t host_end = url.find('/', 6);
+  if (StartsWithNoCase(url, "smb://"))
+  {
+    // One connection per share: smb://[user@]server/share; the rest is the path in it.
+    if (host_end == std::string::npos)
+      return std::nullopt;
+    const size_t share_end = url.find('/', host_end + 1);
+    Location location{Kind::SMB, url.substr(0, share_end), ""};
+    if (share_end != std::string::npos)
+      location.path = url.substr(share_end + 1);
+    return location;
+  }
+  if (!StartsWithNoCase(url, "nfs://") || host_end == std::string::npos)
+    return std::nullopt;
+  // NFS: the export can be any number of folders deep, so a path inside a configured share connects
+  // at that share; other paths at their own folder (or the folder they are in).
+  std::string root;
+  {
+    std::lock_guard lock(s_mutex);
+    for (const std::string& configured : s_shares)
+    {
+      const std::string share = TrimSlashes(configured);
+      if (share.size() > root.size() && url.compare(0, share.size(), share) == 0 &&
+          (url.size() == share.size() || url[share.size()] == '/'))
+      {
+        root = share;
+      }
+    }
+  }
+  if (root.empty())
+  {
+    const size_t slash = url.rfind('/');
+    root = folder ? url : url.substr(0, slash);
+    if (root.size() <= host_end)
+      return std::nullopt;
+  }
+  Location location{Kind::NFS, root, url.substr(root.size())};
+  if (location.path.empty())
+    location.path = "/";
+  return location;
+}
+
+// Whether something answers on one of the ports within the time: a switched-off PC fails in
+// moments instead of the 6-9 seconds the clients wait (the menu reads the shares when it opens).
+bool Reachable(const std::string& host, const std::vector<int>& ports, int milliseconds)
+{
+  std::vector<pollfd> sockets;
+  for (const int port : ports)
+  {
+    addrinfo hints{};
+    hints.ai_family = AF_INET;
+    hints.ai_socktype = SOCK_STREAM;
+    addrinfo* found = nullptr;
+    if (getaddrinfo(host.c_str(), std::to_string(port).c_str(), &hints, &found) != 0 || !found)
+      return false;
+    const int fd = socket(found->ai_family, SOCK_STREAM, 0);
+    if (fd >= 0)
+    {
+      fcntl(fd, F_SETFL, fcntl(fd, F_GETFL, 0) | O_NONBLOCK);
+      if (connect(fd, found->ai_addr, found->ai_addrlen) == 0 || errno == EINPROGRESS)
+        sockets.push_back({fd, POLLOUT, 0});
+      else
+        close(fd);
+    }
+    freeaddrinfo(found);
+  }
+  bool reached = false;
+  const auto deadline = Clock::now() + std::chrono::milliseconds(milliseconds);
+  while (!reached && !sockets.empty() && Clock::now() < deadline)
+  {
+    const int left = static_cast<int>(
+        std::chrono::duration_cast<std::chrono::milliseconds>(deadline - Clock::now()).count());
+    if (poll(sockets.data(), sockets.size(), std::max(left, 1)) <= 0)
+      break;
+    for (auto it = sockets.begin(); it != sockets.end();)
+    {
+      if (!it->revents)
+      {
+        ++it;
+        continue;
+      }
+      int failure = 0;
+      socklen_t length = sizeof(failure);
+      getsockopt(it->fd, SOL_SOCKET, SO_ERROR, &failure, &length);
+      reached |= failure == 0;
+      close(it->fd);
+      it = sockets.erase(it);
+    }
+  }
+  for (const pollfd& socket : sockets)
+    close(socket.fd);
+  return reached;
+}
+
+// "server:port" -> server, port (or the default).
+std::pair<std::string, int> HostAndPort(const std::string& authority, int default_port)
+{
+  const size_t colon = authority.rfind(':');
+  if (colon == std::string::npos)
+    return {authority, default_port};
+  return {authority.substr(0, colon), std::atoi(authority.c_str() + colon + 1)};
+}
+
+std::unique_ptr<Connection> Connect(const Location& location, std::string* error)
+{
+  // Writing to a connection the server closed raises SIGPIPE, which ends the whole program by
+  // default (a PC or NAS restarting mid-game). Ignored, the write fails and the read reconnects.
+  static std::once_flag s_sigpipe;
+  std::call_once(s_sigpipe, [] { signal(SIGPIPE, SIG_IGN); });
+  auto connection = std::make_unique<Connection>();
+  connection->kind = location.kind;
+  connection->key = location.key;
+  if (location.kind == Kind::NFS)
+  {
+    nfs_context* nfs = nfs_init_context();
+    if (!nfs)
+    {
+      *error = "out of memory";
+      return nullptr;
+    }
+    connection->nfs = nfs;
+    nfs_set_timeout(nfs, 8000);
+    nfs_url* url = nfs_parse_url_dir(nfs, location.key.c_str());
+    if (!url)
+    {
+      *error = std::string("bad address: ") + nfs_get_error(nfs);
+      return nullptr;
+    }
+    // NFS answers on 2049 (v4, and v3 on most servers) or its port mapper on 111.
+    if (!Reachable(url->server, url->port ? std::vector<int>{url->port} : std::vector<int>{2049, 111},
+                   2000))
+    {
+      *error = std::string("no answer from ") + url->server + " (is it on, and NFS running?)";
+      nfs_destroy_url(url);
+      return nullptr;
+    }
+    const int result = nfs_mount(nfs, url->server, url->path);
+    nfs_destroy_url(url);
+    if (result != 0)
+    {
+      *error = std::string("can't connect: ") + nfs_get_error(nfs);
+      return nullptr;
+    }
+    return connection;
+  }
+
+  // smb://[[domain;]user[:password]@]server[:port]/share
+  const std::string rest = location.key.substr(6);
+  const size_t slash = rest.find('/');
+  const std::string authority = rest.substr(0, slash);
+  const std::string share = slash == std::string::npos ? "" : rest.substr(slash + 1);
+  const size_t at = authority.rfind('@');
+  const std::string server = at == std::string::npos ? authority : authority.substr(at + 1);
+  std::string user, password, domain;
+  if (at != std::string::npos)
+  {
+    const std::string info = authority.substr(0, at);
+    const size_t colon = info.find(':');
+    user = Decode(info.substr(0, colon));
+    if (colon != std::string::npos)
+      password = Decode(info.substr(colon + 1));
+    if (const size_t semicolon = user.find(';'); semicolon != std::string::npos)
+    {
+      domain = user.substr(0, semicolon);
+      user = user.substr(semicolon + 1);
+    }
+  }
+  if (user.empty())
+    user = "Guest";
+  if (share.empty())
+  {
+    *error = "no share name (smb://server/share)";
+    return nullptr;
+  }
+  const auto [host, port] = HostAndPort(server, 445);
+  if (!Reachable(host, {port}, 2000))
+  {
+    *error = "no answer from " + host + " (is it on, and the folder shared?)";
+    return nullptr;
+  }
+  smb2_context* smb = smb2_init_context();
+  if (!smb)
+  {
+    *error = "out of memory";
+    return nullptr;
+  }
+  connection->smb = smb;
+  smb2_set_security_mode(smb, SMB2_NEGOTIATE_SIGNING_ENABLED);
+  smb2_set_timeout(smb, 10);
+  smb2_set_user(smb, user.c_str());
+  smb2_set_password(smb, password.c_str());
+  if (!domain.empty())
+    smb2_set_domain(smb, domain.c_str());
+  if (smb2_connect_share(smb, server.c_str(), share.c_str(), user.c_str()) < 0)
+  {
+    *error = std::string("can't connect: ") + smb2_get_error(smb);
+    smb2_destroy_context(smb);
+    connection->smb = nullptr;
+    return nullptr;
+  }
+  return connection;
+}
+
+// A connection for this location, only for the caller until Release.
+Connection* Acquire(const Location& location, const std::string& url)
+{
+  {
+    std::lock_guard lock(s_mutex);
+    for (const auto& connection : s_pool)
+    {
+      if (!connection->busy && connection->key == location.key)
+      {
+        connection->busy = true;
+        return connection.get();
+      }
+    }
+  }
+  std::string error;
+  std::unique_ptr<Connection> connection = Connect(location, &error);
+  if (!connection)
+  {
+    Fail(url, error);
+    return nullptr;
+  }
+  Log("connected to " + Redact(location.key));
+  std::lock_guard lock(s_mutex);
+  connection->busy = true;
+  s_pool.push_back(std::move(connection));
+  return s_pool.back().get();
+}
+
+// Back to the pool; broken: closed instead (the server went away: the next use reconnects).
+void Release(Connection* connection, bool broken)
+{
+  std::vector<std::unique_ptr<Connection>> closing;
+  {
+    std::lock_guard lock(s_mutex);
+    const auto now = Clock::now();
+    connection->busy = false;
+    connection->idle_since = now;
+    std::map<std::string, size_t> idle;
+    for (auto it = s_pool.rbegin(); it != s_pool.rend(); ++it)
+    {
+      Connection& c = **it;
+      if (c.busy)
+        continue;
+      if ((&c == connection && broken) || now - c.idle_since > IDLE_LIFETIME ||
+          ++idle[c.key] > IDLE_PER_SERVER)
+      {
+        closing.push_back(std::move(*it));
+      }
+    }
+    std::erase_if(s_pool, [](const std::unique_ptr<Connection>& c) { return !c; });
+  }
+}
+
+void RememberStat(const std::string& url, bool exists, bool directory, u64 size)
+{
+  std::lock_guard lock(s_mutex);
+  if (s_stats.size() > 20000)
+    s_stats.clear();
+  s_stats[TrimSlashes(url)] = {exists, directory, size, Clock::now()};
+}
+
+bool OpenFile(Stream& stream)
+{
+  stream.connection = Acquire(stream.location, stream.url);
+  if (!stream.connection)
+    return false;
+  Connection& c = *stream.connection;
+  const char* path = stream.location.path.c_str();
+  if (c.kind == Kind::NFS)
+  {
+    if (nfs_open(c.nfs, path, O_RDONLY, &stream.nfs_file) != 0)
+    {
+      Fail(stream.url, std::string("can't open: ") + nfs_get_error(c.nfs));
+      Release(stream.connection, false);
+      stream.connection = nullptr;
+      return false;
+    }
+    nfs_stat_64 st{};
+    if (nfs_fstat64(c.nfs, stream.nfs_file, &st) == 0 || nfs_stat64(c.nfs, path, &st) == 0)
+      stream.size = st.nfs_size;
+  }
+  else
+  {
+    stream.smb_file = smb2_open(c.smb, path, O_RDONLY);
+    if (!stream.smb_file)
+    {
+      Fail(stream.url, std::string("can't open: ") + smb2_get_error(c.smb));
+      Release(stream.connection, false);
+      stream.connection = nullptr;
+      return false;
+    }
+    // Some servers don't answer a handle's size (impacket): then the path's.
+    smb2_stat_64 st{};
+    const int by_handle = smb2_fstat(c.smb, stream.smb_file, &st);
+    if (by_handle < 0 || st.smb2_size == 0)
+    {
+      Log("size by handle failed (" + std::to_string(by_handle) + "): by path");
+      st = {};
+      smb2_stat(c.smb, path, &st);
+    }
+    stream.size = st.smb2_size;
+  }
+  return true;
+}
+
+void CloseFile(Stream& stream, bool broken)
+{
+  if (!stream.connection)
+    return;
+  Connection& c = *stream.connection;
+  if (!broken)
+  {
+    if (stream.nfs_file)
+      nfs_close(c.nfs, stream.nfs_file);
+    if (stream.smb_file)
+      smb2_close(c.smb, stream.smb_file);
+  }
+  stream.nfs_file = nullptr;
+  stream.smb_file = nullptr;
+  Release(stream.connection, broken);
+  stream.connection = nullptr;
+}
+
+bool RawRead(Stream& stream, u64 offset, u8* out, u64 size)
+{
+  if (!stream.connection)
+    return false;
+  Connection& c = *stream.connection;
+  while (size > 0)
+  {
+    int result;
+    if (c.kind == Kind::NFS)
+    {
+      const u64 chunk = std::min<u64>(size, std::max<size_t>(nfs_get_readmax(c.nfs), 32768));
+      result = nfs_pread(c.nfs, stream.nfs_file, out, chunk, offset);
+      if (result < 0)
+        Fail(stream.url, std::string("read failed: ") + nfs_get_error(c.nfs));
+    }
+    else
+    {
+      const u64 chunk = std::min<u64>(size, std::max<u32>(smb2_get_max_read_size(c.smb), 65536));
+      result = smb2_pread(c.smb, stream.smb_file, out, static_cast<u32>(chunk), offset);
+      if (result < 0)
+        Fail(stream.url, std::string("read failed: ") + smb2_get_error(c.smb));
+    }
+    if (result <= 0)
+      return false;
+    out += result;
+    offset += result;
+    size -= result;
+  }
+  return true;
+}
+
+// A read; when it fails, the connection is dropped and the file opened again once (a server that
+// restarted, a dropped Wi-Fi link).
+bool Fetch(Stream& stream, u64 offset, u8* out, u64 size)
+{
+  if (RawRead(stream, offset, out, size))
+    return true;
+  CloseFile(stream, true);
+  if (!OpenFile(stream))
+    return false;
+  Log("reconnected for " + Redact(stream.url));
+  return RawRead(stream, offset, out, size);
+}
+
+bool Read(Stream& stream, u64 offset, u8* out, u64 size)
+{
+  if (offset > stream.size || size > stream.size - offset)
+    return false;
+  while (size > 0)
+  {
+    if (offset >= stream.cache_at && offset < stream.cache_at + stream.cache_length)
+    {
+      const u64 n = std::min<u64>(size, stream.cache_at + stream.cache_length - offset);
+      std::memcpy(out, stream.cache.data() + (offset - stream.cache_at), n);
+      out += n;
+      offset += n;
+      size -= n;
+      continue;
+    }
+    if (size >= READ_AHEAD)
+      return Fetch(stream, offset, out, size);
+    const u64 n = std::min<u64>(READ_AHEAD, stream.size - offset);
+    stream.cache.resize(READ_AHEAD);
+    stream.cache_length = 0;
+    if (!Fetch(stream, offset, stream.cache.data(), n))
+      return false;
+    stream.cache_at = offset;
+    stream.cache_length = n;
+  }
+  return true;
+}
+
+std::shared_ptr<Stream> FindHandle(int handle)
+{
+  std::lock_guard lock(s_mutex);
+  const auto it = s_handles.find(handle);
+  return it == s_handles.end() ? nullptr : it->second;
+}
+
+// The FILE* for File::IOFile.
+struct Cookie
+{
+  int handle;
+  u64 position = 0;
+};
+
+ssize_t CookieRead(void* cookie, char* out, size_t size)
+{
+  Cookie& c = *static_cast<Cookie*>(cookie);
+  const u64 total = HandleSize(c.handle);
+  if (c.position >= total)
+    return 0;
+  const u64 n = std::min<u64>(size, total - c.position);
+  if (!ReadAt(c.handle, c.position, reinterpret_cast<u8*>(out), n))
+  {
+    errno = EIO;
+    return -1;
+  }
+  c.position += n;
+  return static_cast<ssize_t>(n);
+}
+
+int CookieSeek(void* cookie, off_t* offset, int whence)
+{
+  Cookie& c = *static_cast<Cookie*>(cookie);
+  const s64 base = whence == SEEK_SET ? 0 :
+                   whence == SEEK_CUR ? static_cast<s64>(c.position) :
+                                        static_cast<s64>(HandleSize(c.handle));
+  const s64 position = base + *offset;
+  if (position < 0)
+  {
+    errno = EINVAL;
+    return -1;
+  }
+  c.position = static_cast<u64>(position);
+  *offset = position;
+  return 0;
+}
+
+int CookieClose(void* cookie)
+{
+  Cookie* c = static_cast<Cookie*>(cookie);
+  CloseHandle(c->handle);
+  delete c;
+  return 0;
+}
