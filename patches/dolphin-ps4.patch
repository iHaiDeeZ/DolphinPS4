+// Riivolution: mods as on a Wii's SD card, in User/Load/Riivolution (its riivolution folder with
+// the XMLs, and the mod's own folders). The choices go in riivolution/config/<ID4>.xml, the file
+// Riivolution and Dolphin on PC use; the game process applies them (MainNoGUI).
+// The list the game saved the last time it ran with RetroAchievements (PS4Achievements).
+void Menu::OpenAchievementList(const Game& game)
+{
+  OpenAchievementKey(game.id.empty() ? game.title : game.id);
+}
+
+void Menu::OpenAchievementKey(const std::string& key)
+{
+  m_ach_view = {};
+  PS4Achievements::Load(m_data_dir, key, &m_ach_view);
+  m_panel = {};
+  m_panel.open = true;
+  m_panel.setting = SET_ACHVIEW;
+  m_panel.title = "Achievements";
+  std::vector<SettingRow> rows;
+  SettingRow summary;
+  summary.label = std::to_string(m_ach_view.unlocked) + " of " + std::to_string(m_ach_view.total) +
+                  " unlocked  -  " + std::to_string(m_ach_view.points) + " / " +
+                  std::to_string(m_ach_view.points_total) + " points" +
+                  (m_ach_view.hardcore ? "  -  Hardcore" : "");
+  summary.header = true;
+  rows.push_back(summary);
+  for (int pass = 0; pass < 2; pass++)
+  {
+    const bool unlocked = pass == 0;
+    bool any = false;
+    for (size_t i = 0; i < m_ach_view.entries.size(); i++)
+    {
+      const PS4Achievements::Entry& entry = m_ach_view.entries[i];
+      if (entry.unlocked != unlocked)
+        continue;
+      if (!any)
+      {
+        SettingRow header;
+        header.label = unlocked ? "Unlocked" : "Locked";
+        header.header = true;
+        rows.push_back(header);
+        any = true;
+      }
+      SettingRow row;
+      row.label = entry.title.size() > 40 ? entry.title.substr(0, 37) + "..." : entry.title;
+      row.value = std::to_string(entry.points) + " pts";
+      row.key = "ach:" + std::to_string(i);
+      row.note = unlocked;  // gold points: earned
+      row.icon = BadgeTexture(PS4Achievements::BadgePath(m_data_dir, entry.badge, !unlocked));
+      rows.push_back(row);
+    }
+  }
+  m_panel.rows = std::move(rows);
+  m_panel.selected = 0;
+  MoveSettingRow(0);
+}
+
+void Menu::OpenRiivolutionList(const Game& game)
+{
+  m_panel = {};
+  m_panel.open = true;
+  m_panel.title = "Riivolution Patches";
+  m_riivolution.clear();
+  m_riivolution_game = game.id;
+  const std::string root = m_data_dir + "/User/Load/Riivolution/";
+  std::optional<DiscIO::Riivolution::Config> config;
+  if (game.id.size() == 4 || game.id.size() == 6)
+  {
+    config = DiscIO::Riivolution::ParseConfigFile(root + "riivolution/config/" +
+                                                  game.id.substr(0, 4) + ".xml");
+  }
+  for (const std::string& path : Common::DoFileSearch({root + "riivolution"}, {".xml"}))
+  {
+    auto parsed = DiscIO::Riivolution::ParseFile(path);
+    if (!parsed || !parsed->IsValidForGame(game.id, game.revision, 0))
+      continue;
+    if (config)
+      DiscIO::Riivolution::ApplyConfigDefaults(&*parsed, *config);
+    m_riivolution.push_back(std::move(*parsed));
+  }
+  BuildRiivolutionRows();
+  if (m_panel.rows.empty())
+  {
+    m_panel.lines = {"", "No Riivolution mods for this game.", "",
+                     "Copy the mod's SD card files", "(its riivolution folder and the rest) to",
+                     "/data/DolphinPS4/User/Load/Riivolution/"};
+  }
+  m_panel.selected = 0;
+  MoveSettingRow(0);
+}
+
+void Menu::BuildRiivolutionRows()
+{
+  std::vector<SettingRow> rows;
+  for (size_t d = 0; d < m_riivolution.size(); d++)
+  {
+    const auto& disc = m_riivolution[d];
+    for (size_t s = 0; s < disc.m_sections.size(); s++)
+    {
+      const auto& section = disc.m_sections[s];
+      if (section.m_options.empty())
+        continue;
+      rows.push_back({section.m_name, "", "", true});
+      for (size_t o = 0; o < section.m_options.size(); o++)
+      {
+        const auto& option = section.m_options[o];
+        const u32 choice = option.m_selected_choice;
+        SettingRow row{option.m_name,
+                       choice == 0 || choice > option.m_choices.size() ?
+                           "Off" :
+                           option.m_choices[choice - 1].m_name,
+                       "riiv:" + std::to_string(d) + ":" + std::to_string(s) + ":" +
+                           std::to_string(o)};
+        row.tag = choice == 0 ? -1 : 1;
+        rows.push_back(std::move(row));
+      }
+    }
+  }
+  m_panel.rows = std::move(rows);
+}
+
+void Menu::SaveRiivolutionConfig()
+{
+  const std::string& id = m_riivolution_game;
+  if (!(id.size() == 4 || id.size() == 6))
+    return;
+  DiscIO::Riivolution::Config config;
+  for (const auto& disc : m_riivolution)
+  {
+    for (const auto& section : disc.m_sections)
+    {
+      for (const auto& option : section.m_options)
+      {
+        config.m_options.push_back(
+            {option.m_id.empty() ? section.m_name + option.m_name : option.m_id,
+             option.m_selected_choice});
+      }
+    }
+  }
+  const std::string dir = m_data_dir + "/User/Load/Riivolution/riivolution/config/";
+  File::CreateFullPath(dir);
+  DiscIO::Riivolution::WriteConfigFile(dir + id.substr(0, 4) + ".xml", config);
+  Log("riivolution: choices saved for " + id);
+}
