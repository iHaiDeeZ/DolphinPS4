+// The XFB's middle part with the screen's shape (the blur covers the whole screen).
+MathUtil::Rectangle<int> PS4FillCrop(const MathUtil::Rectangle<int>& source, int screen_w,
+                                     int screen_h)
+{
+  MathUtil::Rectangle<int> crop = source;
+  const float src_aspect = static_cast<float>(source.GetWidth()) / std::max(1, source.GetHeight());
+  const float dst_aspect = static_cast<float>(screen_w) / std::max(1, screen_h);
+  if (src_aspect < dst_aspect)
+  {
+    const int h = static_cast<int>(source.GetWidth() / dst_aspect);
+    crop.top = source.top + (source.GetHeight() - h) / 2;
+    crop.bottom = crop.top + h;
+  }
+  else
+  {
+    const int w = static_cast<int>(source.GetHeight() * dst_aspect);
+    crop.left = source.left + (source.GetWidth() - w) / 2;
+    crop.right = crop.left + w;
+  }
+  return crop;
+}
