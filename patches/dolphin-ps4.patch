+const std::vector<const char*> CATEGORIES = {"Video", "Graphics", "Performance", "System",
+                                             "Diagnostics", "Hotkeys"};
+
+// Hotkey buttons and their names in settings.ini ("L1 + Square"); ORBIS_PAD_BUTTON_* values.
+constexpr std::pair<uint32_t, const char*> HOTKEY_BUTTONS[] = {
+    {0x00000400, "L1"},       {0x00000800, "R1"},     {0x00000100, "L2"},
+    {0x00000200, "R2"},       {0x00000002, "L3"},     {0x00000004, "R3"},
+    {0x00004000, "Cross"},    {0x00002000, "Circle"}, {0x00008000, "Square"},
+    {0x00001000, "Triangle"}, {0x00000010, "Up"},     {0x00000040, "Down"},
+    {0x00000080, "Left"},     {0x00000020, "Right"},  {0x00000008, "Options"},
+    {0x00100000, "Touchpad"}};
+
+std::mutex s_mutex;
+std::string s_path;
+std::map<std::string, std::map<std::string, std::string>> s_sections;  // "global", game IDs
+std::function<std::string(const std::string&)> s_base;
+std::function<std::string(const std::string&, const std::string&)> s_game_base;
+
+std::string Trim(std::string text)
+{
+  while (!text.empty() && (text.back() == '\r' || text.back() == '\n' || text.back() == ' '))
+    text.pop_back();
+  return text;
+}
+
+std::string Fallback(const std::string& key)
+{
+  if (s_base)
+  {
+    const std::string base = s_base(key);
+    if (!base.empty())
+      return base;
+  }
+  const Setting* setting = Find(key);
+  return setting ? setting->fallback : "";
+}
+
+// Kept per game by the in-game menu, whether or not the game has its own settings.
+bool AlwaysPerGame(const std::string& key)
+{
+  return key == "wii_extension" || key == "wii_sideways" || key == "wii_upright" ||
+         key == "wii_tilt" || key == "wii_touchpad";
+}
+
+std::string GetLocked(const std::string& key, const std::string& game_id)
+{
+  if (!game_id.empty() && AlwaysPerGame(key))
+  {
+    auto game = s_sections.find(game_id);
+    if (game != s_sections.end())
+    {
+      auto value = game->second.find(key);
+      if (value != game->second.end())
+        return value->second;
+    }
+  }
+  if (!game_id.empty())
+  {
+    auto game = s_sections.find(game_id);
+    if (game != s_sections.end() && game->second.count("custom") &&
+        game->second.at("custom") == "on")
+    {
+      auto value = game->second.find(key);
+      if (value != game->second.end())
+        return value->second;
+    }
+    if (s_game_base)
+    {
+      const std::string base = s_game_base(game_id, key);
+      if (!base.empty())
+        return base;
+    }
+  }
+  auto global = s_sections.find("global");
+  if (global != s_sections.end())
+  {
+    auto value = global->second.find(key);
+    if (value != global->second.end())
+      return value->second;
+  }
+  return Fallback(key);
+}
+}  // namespace
+
+const std::vector<Setting>& All()
+{
+  return SETTINGS;
+}
+
+const std::vector<const char*>& Categories()
+{
+  return CATEGORIES;
+}
+
+const Setting* Find(const std::string& key)
+{
+  for (const Setting& setting : SETTINGS)
+  {
+    if (key == setting.key)
+      return &setting;
+  }
+  return nullptr;
+}
+
+// The data folder (settings.ini's), for playtime.ini.
+static std::string s_data_dir;
+
+void Load(const std::string& data_dir)
+{
+  std::lock_guard lock(s_mutex);
+  s_data_dir = data_dir;
+  s_path = data_dir + "/settings.ini";
+  s_sections.clear();
+  std::ifstream file(s_path);
+  std::string line, section = "global";
+  while (std::getline(file, line))
+  {
+    line = Trim(line);
+    if (line.empty() || line[0] == '#' || line[0] == ';')
+      continue;
+    if (line.front() == '[' && line.back() == ']')
+    {
+      section = line.substr(1, line.size() - 2);
+      continue;
+    }
+    const size_t eq = line.find('=');
+    if (eq != std::string::npos)
+      s_sections[section][line.substr(0, eq)] = line.substr(eq + 1);
+  }
+}
+
+void Save()
+{
+  std::lock_guard lock(s_mutex);
+  if (s_path.empty())
+    return;
+  std::ofstream file(s_path, std::ios::trunc);
+  file << "# Dolphin for PS4 settings, written by the XMB and the in-game menu.\n"
+          "# [global] applies to every game; a [GAMEID] section with custom=on overrides it.\n";
+  auto write = [&](const std::string& name, const std::map<std::string, std::string>& values) {
+    file << "\n[" << name << "]\n";
+    for (const auto& [key, value] : values)
+      file << key << "=" << value << "\n";
+  };
+  if (s_sections.count("global"))
+    write("global", s_sections["global"]);
+  for (const auto& [name, values] : s_sections)
+  {
+    if (name != "global")
+      write(name, values);
+  }
+}
+
+void SetBaseLookup(std::function<std::string(const std::string&)> lookup)
+{
+  std::lock_guard lock(s_mutex);
+  s_base = std::move(lookup);
+}
+
+void SetGameBaseLookup(std::function<std::string(const std::string&, const std::string&)> lookup)
+{
+  std::lock_guard lock(s_mutex);
+  s_game_base = std::move(lookup);
+}
+
+std::string Get(const std::string& key, const std::string& game_id)
+{
+  std::lock_guard lock(s_mutex);
+  return GetLocked(key, IsHotkey(key) ? std::string() : game_id);
+}
+
+void Set(const std::string& key, const std::string& value, const std::string& game_id)
+{
+  {
+    std::lock_guard lock(s_mutex);
+    s_sections[game_id.empty() || IsHotkey(key) ? "global" : game_id][key] = value;
+  }
+  Save();
+}
+
+std::vector<std::pair<std::string, std::string>> GlobalValues()
+{
+  std::lock_guard lock(s_mutex);
+  std::vector<std::pair<std::string, std::string>> values;
+  auto global = s_sections.find("global");
+  if (global != s_sections.end())
+    values.assign(global->second.begin(), global->second.end());
+  return values;
+}
+
+std::vector<std::pair<std::string, std::string>> GameValues(const std::string& game_id)
+{
+  std::lock_guard lock(s_mutex);
+  std::vector<std::pair<std::string, std::string>> values;
+  auto game = s_sections.find(game_id);
+  if (game != s_sections.end())
+  {
+    for (const auto& [key, value] : game->second)
+    {
+      if (key != "custom")
+        values.emplace_back(key, value);
+    }
+  }
+  return values;
+}
+
+bool HasGameValue(const std::string& key, const std::string& game_id)
+{
+  std::lock_guard lock(s_mutex);
+  return !game_id.empty() && s_game_base && !s_game_base(game_id, key).empty();
+}
+
+bool IsCustom(const std::string& game_id)
+{
+  std::lock_guard lock(s_mutex);
+  auto game = s_sections.find(game_id);
+  return game != s_sections.end() && game->second.count("custom") &&
+         game->second.at("custom") == "on";
+}
+
+void SetCustom(const std::string& game_id, bool custom)
+{
+  if (game_id.empty())
+    return;
+  {
+    std::lock_guard lock(s_mutex);
+    auto& section = s_sections[game_id];
+    if (custom && section.size() <= 1)
+    {
+      // First time: start from what the game uses now (its recommended settings included; the
+      // global values alone dropped them).
+      for (const Setting& setting : SETTINGS)
+        section[setting.key] = GetLocked(setting.key, game_id);
+    }
+    section["custom"] = custom ? "on" : "off";
+  }
+  Save();
+}
+
+void ResetGlobal(const std::string& key)
+{
+  {
+    std::lock_guard lock(s_mutex);
+    auto global = s_sections.find("global");
+    if (global != s_sections.end())
+      global->second.erase(key);
+  }
+  Save();
+}
+
+void ResetGame(const std::string& game_id)
+{
+  {
+    std::lock_guard lock(s_mutex);
+    s_sections.erase(game_id);
+  }
+  Save();
+}
+
+void ResetAll()
+{
+  {
+    std::lock_guard lock(s_mutex);
+    s_sections.clear();
+  }
+  Save();
+}
+
+std::string LabelOf(const Setting& setting, const std::string& value)
+{
+  for (const Choice& choice : setting.choices)
+  {
+    if (value == choice.value)
+      return choice.label;
+  }
+  return value;
+}
+
+bool IsHotkey(const std::string& key)
+{
+  return key.rfind("hotkey_", 0) == 0;
+}
+
+uint32_t HotkeyButtons()
+{
+  uint32_t all = 0;
+  for (const auto& [bit, name] : HOTKEY_BUTTONS)
+    all |= bit;
+  return all;
+}
+
+uint32_t HotkeyMask(const std::string& value)
+{
+  uint32_t mask = 0;
+  size_t start = 0;
+  while (start < value.size())
+  {
+    size_t end = value.find('+', start);
+    if (end == std::string::npos)
+      end = value.size();
+    std::string part = value.substr(start, end - start);
+    while (!part.empty() && part.front() == ' ')
+      part.erase(part.begin());
+    while (!part.empty() && part.back() == ' ')
+      part.pop_back();
+    bool known = false;
+    for (const auto& [bit, name] : HOTKEY_BUTTONS)
+    {
+      if (part == name)
+      {
+        mask |= bit;
+        known = true;
+      }
+    }
+    if (!known)
+      return 0;  // "off", or something this version doesn't know
+    start = end + 1;
+  }
+  return mask;
+}
+
+std::string HotkeyName(uint32_t mask)
+{
+  std::string name;
+  for (const auto& [bit, button] : HOTKEY_BUTTONS)
+  {
+    if (mask & bit)
+      name += (name.empty() ? "" : " + ") + std::string(button);
+  }
+  return name.empty() ? "off" : name;
+}
+
+std::string Step(const Setting& setting, const std::string& value, int direction)
+{
+  const int count = static_cast<int>(setting.choices.size());
+  int index = 0;
+  for (int i = 0; i < count; i++)
+  {
+    if (value == setting.choices[i].value)
+      index = i;
+  }
+  index = (index + direction % count + count) % count;
+  return setting.choices[index].value;
+}
+
+// Diagnostics: each switch's own value; what applies also needs All Diagnostics on.
+std::map<std::string, bool> s_diagnostics;
+std::string s_profiler_mode = "auto";
+
+bool DiagnosticRaw(const std::string& key)
+{
+  const auto it = s_diagnostics.find(key);
+  if (it != s_diagnostics.end())
+    return it->second;
+  const Setting* setting = Find(key);
+  return setting && std::string(setting->fallback) == "on";
+}
+
+void ApplyDiagnostics()
+{
+  ps4_perf_log = DiagnosticOn("perf_log") ? 1 : 0;
+  ps4_freeze_reports = DiagnosticOn("freeze_reports") ? 1 : 0;
+  // Profiler: Always needs All Diagnostics; Automatic doesn't (it only runs on slow stretches).
+  ps4_sampler_set_enabled(DiagnosticOn("profiler") ? 1 : 0);
+  ps4_profile_auto = s_profiler_mode == "auto" ? 1 : 0;
+  // Dolphin's own log (dolphin.log): the listeners stay registered, only their output stops.
+  const bool emu_log = DiagnosticOn("emu_log");
+  auto* log_manager = Common::Log::LogManager::GetInstance();
+  if (log_manager)
+  {
+    log_manager->EnableListener(Common::Log::LogListener::CONSOLE_LISTENER, emu_log);
+    log_manager->EnableListener(Common::Log::LogListener::FILE_LISTENER, emu_log);
+  }
+}
+
+bool DiagnosticOn(const std::string& key)
+{
+  // The performance log (a line every 2 s) and freeze reports cost nothing worth saving: always
+  // on unless switched off themselves, so a slow or stuck game has a log without asking.
+  if (key == "perf_log" || key == "freeze_reports")
+    return DiagnosticRaw(key);
+  return DiagnosticRaw("diagnostics_all") && DiagnosticRaw(key);
+}
+
+void ApplyLive(const std::string& key, const std::string& value)
+{
+  const bool on = value == "on";
+  if (key == "diagnostics_all" || key == "perf_log" || key == "freeze_reports" ||
+      key == "emu_log" || key == "profiler")
+  {
+    s_diagnostics[key] = on;
+    if (key == "profiler")
+      s_profiler_mode = value;
+    ApplyDiagnostics();
+  }
+  else if (key == "aspect")
+  {
+    Config::SetBase(Config::GFX_ASPECT_RATIO, value == "wide"     ? AspectMode::ForceWide :
+                                              value == "standard" ? AspectMode::ForceStandard :
+                                              value == "stretch"  ? AspectMode::Stretch :
+                                                                    AspectMode::Auto);
+  }
+  else if (key == "zoom")
+    ps4_zoom_letterbox = value == "letterbox";
+  else if (key == "widescreen_hack")
+    Config::SetBase(Config::GFX_WIDESCREEN_HACK, on);
+  else if (key == "crop")
+    Config::SetBase(Config::GFX_CROP_TO_ASPECT_RATIO, on);
+  else if (key == "resolution")
+    Config::SetBase(Config::GFX_EFB_SCALE, std::clamp(std::atoi(value.c_str()), 1, 4));
+  else if (key == "fps_limit")
+    ps4_fps_limit = value == "auto" ? -1 : std::max(0, std::atoi(value.c_str()));
+  else if (key == "vsync")
+    Config::SetBase(Config::GFX_VSYNC, on);
+  else if (key == "show_fps")
+    ps4_show_fps = on;
+  else if (key == "bezel")
+    ps4_bezel_mode = value == "blur" ? 1 : value == "image" ? 2 : 0;
+  else if (key == "texture_filtering")
+  {
+    Config::SetBase(Config::GFX_ENHANCE_FORCE_TEXTURE_FILTERING,
+                    value == "linear"  ? TextureFilteringMode::Linear :
+                    value == "nearest" ? TextureFilteringMode::Nearest :
+                                         TextureFilteringMode::Default);
+  }
+  else if (key == "anisotropy")
+  {
+    const int x = std::atoi(value.c_str());
+    Config::SetBase(Config::GFX_ENHANCE_MAX_ANISOTROPY,
+                    x >= 16 ? AnisotropicFilteringMode::Force16x :
+                    x >= 8  ? AnisotropicFilteringMode::Force8x :
+                    x >= 4  ? AnisotropicFilteringMode::Force4x :
+                    x >= 2  ? AnisotropicFilteringMode::Force2x :
+                    x >= 1  ? AnisotropicFilteringMode::Force1x :
+                              AnisotropicFilteringMode::Default);
+  }
+  else if (key == "antialiasing")
+  {
+    Config::SetBase(Config::GFX_MSAA, static_cast<u32>(std::clamp(std::atoi(value.c_str()), 1, 4)));
+    Config::SetBase(Config::GFX_SSAA, false);
+  }
+  else if (key == "disable_fog")
+    Config::SetBase(Config::GFX_DISABLE_FOG, on);
+  else if (key == "copy_filter")
+    Config::SetBase(Config::GFX_ENHANCE_DISABLE_COPY_FILTER, value == "off");
+  else if (key == "efb_copies")
+    Config::SetBase(Config::GFX_HACK_SKIP_EFB_COPY_TO_RAM, value != "ram");
+  else if (key == "efb_access")
+    Config::SetBase(Config::GFX_HACK_EFB_ACCESS_ENABLE, on);
+  else if (key == "manual_texture_sampling")
+    Config::SetBase(Config::GFX_HACK_FAST_TEXTURE_SAMPLING, !on);
+  else if (key == "cpu_clock")
+  {
+    if (value == "auto")
+    {
+      if (ps4_auto_clock <= 0)
+        ps4_auto_clock = 100;  // the governor takes over from 100%
+      Config::SetBase(Config::MAIN_OVERCLOCK_ENABLE, false);
+      Config::SetBase(Config::MAIN_OVERCLOCK, 1.0f);
+    }
+    else
+    {
+      const int clock = std::clamp(std::atoi(value.c_str()), 20, 200);
+      ps4_auto_clock = 0;
+      Config::SetBase(Config::MAIN_OVERCLOCK_ENABLE, clock != 100);
+      Config::SetBase(Config::MAIN_OVERCLOCK, clock / 100.0f);
+    }
+  }
+  else if (key == "perf_overlay")
+  {
+    Config::SetBase(Config::GFX_SHOW_FTIMES, on);
+    Config::SetBase(Config::GFX_SHOW_SPEED, on);
+  }
+  else if (key == "volume")
+    Config::SetBase(Config::MAIN_AUDIO_VOLUME, std::clamp(std::atoi(value.c_str()), 0, 100));
+}
+}  // namespace PS4Settings
+
+namespace PS4PlayTime
+{
+namespace
+{
+std::mutex s_play_mutex;
+
+std::string PlayTimePath()
+{
+  std::lock_guard lock(PS4Settings::s_mutex);
+  return PS4Settings::s_data_dir.empty() ? std::string() : PS4Settings::s_data_dir + "/playtime.ini";
+}
+
+std::map<std::string, int64_t> ReadAll(const std::string& path)
+{
+  std::map<std::string, int64_t> times;
+  std::ifstream file(path);
+  std::string line;
+  while (std::getline(file, line))
+  {
+    while (!line.empty() && (line.back() == '\r' || line.back() == ' '))
+      line.pop_back();
+    const size_t space = line.find(' ');
+    if (space != std::string::npos && space > 0)
+      times[line.substr(space + 1)] = std::atoll(line.c_str());
+  }
+  return times;
+}
+}  // namespace
+
+int64_t Seconds(const std::string& game)
+{
+  if (game.empty())
+    return 0;
+  std::lock_guard lock(s_play_mutex);
+  const auto times = ReadAll(PlayTimePath());
+  const auto it = times.find(game);
+  return it == times.end() ? 0 : it->second;
+}
+
+void Add(const std::string& game, int64_t seconds)
+{
+  if (game.empty() || seconds <= 0)
+    return;
+  std::lock_guard lock(s_play_mutex);
+  const std::string path = PlayTimePath();
+  if (path.empty())
+    return;
+  auto times = ReadAll(path);
+  times[game] += seconds;
+  // Written beside it, flushed to the disc, then renamed over it: a power cut leaves the old or
+  // the new file, never an empty one.
+  const std::string temp = path + ".tmp";
+  {
+    std::ofstream file(temp, std::ios::trunc);
+    for (const auto& [name, total] : times)
+      file << total << ' ' << name << '\n';
+  }
+  const int fd = open(temp.c_str(), O_RDONLY);
+  if (fd >= 0)
+  {
+    fsync(fd);
+    close(fd);
+  }
+  std::rename(temp.c_str(), path.c_str());
+}
+
+std::string Text(int64_t seconds)
+{
+  if (seconds <= 0)
+    return {};
+  if (seconds < 60)
+    return "Less than a minute";
+  const int64_t minutes = seconds / 60;
+  if (minutes < 60)
+    return std::to_string(minutes) + " min";
+  const int64_t hours = minutes / 60;
+  return std::to_string(hours) + " h" + (minutes % 60 ? " " + std::to_string(minutes % 60) + " min" : "");
+}
+}  // namespace PS4PlayTime
+
+namespace PS4Achievements
+{
+std::string FileKey(const std::string& game)
+{
+  std::string name;
+  for (const char c : game)
+    name += std::isalnum(static_cast<unsigned char>(c)) ? c : '_';
+  return name;
+}
+
+const char* TypeName(int type)
+{
+  switch (type)
+  {
+  case 1:
+    return "Missable";
+  case 2:
+    return "Progression";
+  case 3:
+    return "Win Condition";
+  default:
+    return "";
+  }
+}
+
+std::string DataDir()
+{
+  std::lock_guard lock(PS4Settings::s_mutex);
+  return PS4Settings::s_data_dir;
+}
+
+std::string BadgePath(const std::string& data_dir, const std::string& badge, bool locked)
+{
+  if (data_dir.empty() || badge.empty())
+    return {};
+  return data_dir + "/achievements/badges/" + FileKey(badge) + (locked ? "_lock.png" : ".png");
+}
+
+std::string GameBadgePath(const std::string& data_dir, const std::string& badge)
+{
+  if (data_dir.empty() || badge.empty())
+    return {};
+  return data_dir + "/achievements/badges/game_" + FileKey(badge) + ".png";
+}
+
+std::vector<std::string> SavedKeys(const std::string& data_dir)
+{
+  std::vector<std::string> keys;
+  std::error_code error;
+  for (const auto& entry :
+       std::filesystem::directory_iterator(data_dir + "/achievements", error))
+  {
+    const std::filesystem::path path = entry.path();
+    if (path.extension() == ".txt")
+      keys.push_back(path.stem().string());
+  }
+  return keys;
+}
+
+namespace
+{
+// One line per field: tabs and line breaks inside texts become spaces.
+std::string Clean(std::string text)
+{
+  for (char& c : text)
+  {
+    if (c == '\t' || c == '\n' || c == '\r')
+      c = ' ';
+  }
+  return text;
+}
+
+std::string FilePath(const std::string& data_dir, const std::string& game)
+{
+  const std::string name = FileKey(game);
+  if (data_dir.empty() || name.empty())
+    return {};
+  return data_dir + "/achievements/" + name + ".txt";
+}
+
+std::vector<std::string> Fields(const std::string& line)
+{
+  std::vector<std::string> fields;
+  size_t start = 0;
+  while (true)
+  {
+    const size_t tab = line.find('\t', start);
+    fields.push_back(line.substr(start, tab == std::string::npos ? std::string::npos : tab - start));
+    if (tab == std::string::npos)
+      break;
+    start = tab + 1;
+  }
+  return fields;
+}
+}  // namespace
+
+void Save(const std::string& game, const List& list)
+{
+  std::string data_dir;
+  {
+    std::lock_guard lock(PS4Settings::s_mutex);
+    data_dir = PS4Settings::s_data_dir;
+  }
+  const std::string path = FilePath(data_dir, game);
+  if (path.empty())
+    return;
+  mkdir((data_dir + "/achievements").c_str(), 0777);
+  const std::string temp = path + ".tmp";
+  {
+    std::ofstream file(temp, std::ios::trunc);
+    file << "game\t" << Clean(list.game) << '\t' << Clean(list.badge) << '\n';
+    file << "summary\t" << list.unlocked << '\t' << list.total << '\t' << list.points << '\t'
+         << list.points_total << '\t' << (list.hardcore ? 1 : 0) << '\t'
+         << static_cast<int64_t>(std::time(nullptr)) << '\n';
+    for (const Entry& entry : list.entries)
+    {
+      file << "a\t" << (entry.unlocked ? 1 : 0) << '\t' << entry.points << '\t' << entry.unlock_time
+           << '\t' << Clean(entry.title) << '\t' << Clean(entry.description) << '\t'
+           << Clean(entry.progress) << '\t' << Clean(entry.badge) << '\t' << entry.id << '\t'
+           << entry.type << '\t' << entry.rarity << '\n';
+    }
+  }
+  const int fd = open(temp.c_str(), O_RDONLY);
+  if (fd >= 0)
+  {
+    fsync(fd);
+    close(fd);
+  }
+  std::rename(temp.c_str(), path.c_str());
+}
+
+bool Load(const std::string& data_dir, const std::string& game, List* list)
+{
+  const std::string path = FilePath(data_dir, game);
+  if (path.empty())
+    return false;
+  std::ifstream file(path);
+  if (!file)
+    return false;
+  List result;
+  std::string line;
+  while (std::getline(file, line))
+  {
+    while (!line.empty() && line.back() == '\r')
+      line.pop_back();
+    const std::vector<std::string> f = Fields(line);
+    if (f[0] == "game" && f.size() >= 2)
+    {
+      result.game = f[1];
+      if (f.size() >= 3)
+        result.badge = f[2];
+    }
+    else if (f[0] == "summary" && f.size() >= 7)
+    {
+      result.unlocked = static_cast<uint32_t>(std::atol(f[1].c_str()));
+      result.total = static_cast<uint32_t>(std::atol(f[2].c_str()));
+      result.points = static_cast<uint32_t>(std::atol(f[3].c_str()));
+      result.points_total = static_cast<uint32_t>(std::atol(f[4].c_str()));
+      result.hardcore = f[5] == "1";
+      result.saved = std::atoll(f[6].c_str());
+    }
+    else if (f[0] == "a" && f.size() >= 7)
+    {
+      Entry entry;
+      entry.unlocked = f[1] == "1";
+      entry.points = static_cast<uint32_t>(std::atol(f[2].c_str()));
+      entry.unlock_time = std::atoll(f[3].c_str());
+      entry.title = f[4];
+      entry.description = f[5];
+      entry.progress = f[6];
+      if (f.size() >= 9)
+      {
+        entry.badge = f[7];
+        entry.id = static_cast<uint32_t>(std::atol(f[8].c_str()));
+      }
+      if (f.size() >= 11)
+      {
+        entry.type = std::atoi(f[9].c_str());
+        entry.rarity = static_cast<float>(std::atof(f[10].c_str()));
+      }
+      result.entries.push_back(std::move(entry));
+    }
+  }
+  if (list)
+    *list = std::move(result);
+  return true;
+}
+}  // namespace PS4Achievements
diff --git a/Source/Core/DolphinNoGUI/PS4Settings.h b/Source/Core/DolphinNoGUI/PS4Settings.h
new file mode 100755
index 0000000..a1db2f7
--- /dev/null
+++ b/Source/Core/DolphinNoGUI/PS4Settings.h
@@ -0,0 +1,141 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// PS4 user settings, shared by the XMB (PS4XMB.cpp) and the in-game menu (PS4IngameMenu.cpp).
+// The user's choices are kept in /data/DolphinPS4/settings.ini: a [global] section and one
+// section per game ID for games set to "custom". A setting the user never changed falls back to
+// ps4.ini (the port's tuned defaults), then to the built-in fallback below.
+//
+// Precedence when a game starts (PlatformPS4.cpp): ps4.ini global < settings.ini [global] <
+// ps4.ini per-game compatibility sections < settings.ini [GAMEID] (custom games only).
+
+#pragma once
+
+#include <functional>
+#include <string>
+#include <vector>
+
+namespace PS4Settings
+{
+struct Choice
+{
+  const char* value;  // stored in settings.ini / ps4.ini
+  const char* label;  // shown in the menus
+};
+
+struct Setting
+{
+  const char* key;
+  const char* label;
+  const char* category;
+  std::vector<Choice> choices;
+  const char* fallback;  // when neither settings.ini nor ps4.ini has a value
+  bool live;             // takes effect while a game runs (else: next game start)
+  const char* help;
+};
+
+const std::vector<Setting>& All();
+const std::vector<const char*>& Categories();
+const Setting* Find(const std::string& key);
+
+// settings.ini
+void Load(const std::string& data_dir);
+void Save();
+
+// ps4.ini lookup for unset settings (PlatformPS4: its global options).
+void SetBaseLookup(std::function<std::string(const std::string& key)> lookup);
+// A game's built-in / ps4.ini per-game value (compatibility fixes), or empty. Ranks above the
+// user's global settings, below the game's own custom values.
+void SetGameBaseLookup(
+    std::function<std::string(const std::string& game_id, const std::string& key)> lookup);
+
+// Effective value: the game's own (custom games), else global, else ps4.ini, else fallback.
+std::string Get(const std::string& key, const std::string& game_id = {});
+// Stores a value globally (game_id empty) or for a custom game.
+void Set(const std::string& key, const std::string& value, const std::string& game_id = {});
+// The user's global choices (only what was changed) / a custom game's own values.
+std::vector<std::pair<std::string, std::string>> GlobalValues();
+std::vector<std::pair<std::string, std::string>> GameValues(const std::string& game_id);
+bool IsCustom(const std::string& game_id);
+// The game's own value of a setting decides over the global one (the game settings center or
+// a ps4.ini section sets it for this game): a global change wouldn't show in this game.
+bool HasGameValue(const std::string& key, const std::string& game_id);
+// Custom on: the game starts with a copy of the effective global values.
+void SetCustom(const std::string& game_id, bool custom);
+
+// Back to the defaults (ps4.ini's tuned values): one global setting, a game (it follows the
+// global settings again), or everything.
+void ResetGlobal(const std::string& key);
+void ResetGame(const std::string& game_id);
+void ResetAll();
+
+// Label of a value for display ("16:9" for "wide").
+std::string LabelOf(const Setting& setting, const std::string& value);
+// Next / previous choice (wrapping).
+std::string Step(const Setting& setting, const std::string& value, int direction);
+
+// Hotkeys: two or more DualShock 4 buttons pressed together ("L1 + Square"), the same for every
+// game. Mask of ORBIS_PAD_BUTTON_* (0 for Off or an unreadable value), and back.
+bool IsHotkey(const std::string& key);
+uint32_t HotkeyMask(const std::string& value);
+std::string HotkeyName(uint32_t mask);
+uint32_t HotkeyButtons();
+
+// Game process only: applies a live setting to the running emulator (Config / port globals).
+void ApplyLive(const std::string& key, const std::string& value);
+// A Diagnostics switch as applied (its own value and All Diagnostics), after ApplyLive.
+bool DiagnosticOn(const std::string& key);
+}  // namespace PS4Settings
+
+// Total play time per game: data_dir/playtime.ini, "<seconds> <game ID>" per line (the file path
+// for a game without an ID). Counted while a game runs, not paused and not in the in-game menu.
+namespace PS4PlayTime
+{
+int64_t Seconds(const std::string& game);
+void Add(const std::string& game, int64_t seconds);
+// "3 h 12 min", "12 min", "Less than a minute"; empty for 0.
+std::string Text(int64_t seconds);
+}  // namespace PS4PlayTime
+
+// RetroAchievements: the running game saves its achievement list (achievements/<game>.txt, every
+// minute and when it quits), so the XMB can show it without signing in or going online.
+namespace PS4Achievements
+{
+struct Entry
+{
+  std::string title;
+  std::string description;
+  std::string progress;  // "3/10" for measured achievements
+  std::string badge;     // RetroAchievements badge name (badges/<badge>.png, <badge>_lock.png)
+  uint32_t id = 0;
+  int type = 0;          // 0 standard, 1 missable, 2 progression, 3 win condition
+  float rarity = -1.0f;  // % of players who have it (-1: unknown)
+  uint32_t points = 0;
+  bool unlocked = false;
+  int64_t unlock_time = 0;
+};
+struct List
+{
+  std::string game;
+  std::string badge;  // the game's icon (badges/game_<badge>.png)
+  uint32_t unlocked = 0, total = 0, points = 0, points_total = 0;
+  bool hardcore = false;
+  int64_t saved = 0;
+  std::vector<Entry> entries;
+};
+// The game process (the settings' data folder).
+void Save(const std::string& game, const List& list);
+// The XMB: false when the game hasn't been played with RetroAchievements yet.
+bool Load(const std::string& data_dir, const std::string& game, List* list);
+// The file name a game's list is saved under (letters and digits; others become '_').
+std::string FileKey(const std::string& game);
+// Every game with a saved list (FileKey names).
+std::vector<std::string> SavedKeys(const std::string& data_dir);
+// Badge pictures, saved by the game process: "" for no badge name.
+std::string BadgePath(const std::string& data_dir, const std::string& badge, bool locked);
+std::string GameBadgePath(const std::string& data_dir, const std::string& badge);
+// The settings' data folder (the game process).
+std::string DataDir();
+// "Progression", "Win Condition", "Missable" ("" for a standard one).
+const char* TypeName(int type);
+}  // namespace PS4Achievements
diff --git a/Source/Core/DolphinNoGUI/PS4Updater.cpp b/Source/Core/DolphinNoGUI/PS4Updater.cpp
new file mode 100755
index 0000000..ea080cf
--- /dev/null
+++ b/Source/Core/DolphinNoGUI/PS4Updater.cpp
@@ -0,0 +1,383 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "DolphinNoGUI/PS4Updater.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <vector>
+
+#include <mbedtls/sha256.h>
+#include <picojson.h>
+
+#include "DolphinNoGUI/PS4Net.h"
+
+extern "C" void ps4_boot_trace(const char* line);  // port/ps4_crashlog.cpp
+extern "C" const char* ps4_app_version();     // PlatformPS4.cpp: this program's version
+
+namespace PS4Updater
+{
+namespace
+{
+// The releases, newest first. Dolphin Lab (versions 50.xx) follows the experimental channel - the
+// newest release tagged "lab-v<version>", published as pre-releases; the normal app (04.xx) the
+// newest release that is not a pre-release. One program serves both apps.
+constexpr const char* LATEST_RELEASE =
+    "https://api.github.com/repos/iHaiDeeZ/DolphinPS4/releases?per_page=40";
+
+bool LabChannel()
+{
+  return std::atof(ps4_app_version()) >= 50.0;
+}
+
+void Log(const std::string& text)
+{
+  fprintf(stderr, "[update] %s\n", text.c_str());
+  ps4_boot_trace(("update: " + text).c_str());
+}
+
+std::string Hex(const unsigned char* data, size_t size)
+{
+  static const char digits[] = "0123456789abcdef";
+  std::string text;
+  for (size_t i = 0; i < size; i++)
+  {
+    text += digits[data[i] >> 4];
+    text += digits[data[i] & 15];
+  }
+  return text;
+}
+
+std::string Lower(std::string text)
+{
+  for (char& c : text)
+    c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+  return text;
+}
+
+bool EndsWith(const std::string& text, const std::string& end)
+{
+  return text.size() >= end.size() && text.compare(text.size() - end.size(), end.size(), end) == 0;
+}
+}  // namespace
+
+Release CheckLatest(const std::string& ca_file)
+{
+  Release release;
+  std::string body, error;
+  PS4Net::Request request;
+  request.url = LATEST_RELEASE;
+  request.headers = {"Accept: application/vnd.github+json", "X-GitHub-Api-Version: 2022-11-28"};
+  request.ca_file = ca_file;
+  request.timeout_seconds = 30;
+  const long status = PS4Net::Get(
+      request,
+      [&body](const char* data, size_t size) {
+        body.append(data, size);
+        return body.size() < 4 * 1024 * 1024;
+      },
+      {}, &error);
+  if (status != 200)
+  {
+    release.error = status == 0 ? error : "GitHub answered " + std::to_string(status);
+    Log("check failed: " + release.error);
+    return release;
+  }
+
+  picojson::value json;
+  const std::string parse_error = picojson::parse(json, body);
+  if (!parse_error.empty() || !json.is<picojson::array>())
+  {
+    release.error = "unexpected answer from GitHub";
+    Log("check failed: " + release.error + " " + parse_error);
+    return release;
+  }
+  // The list (newest first): the first release of this app's channel.
+  const bool lab = LabChannel();
+  const picojson::object* found = nullptr;
+  if (json.is<picojson::array>())
+  {
+    for (const picojson::value& item : json.get<picojson::array>())
+    {
+      if (!item.is<picojson::object>())
+        continue;
+      const auto& object = item.get<picojson::object>();
+      const auto tag_it = object.find("tag_name");
+      if (tag_it == object.end() || !tag_it->second.is<std::string>())
+        continue;
+      const std::string& name = tag_it->second.get<std::string>();
+      const auto pre = object.find("prerelease");
+      const bool prerelease = pre != object.end() && pre->second.is<bool>() && pre->second.get<bool>();
+      const auto draft = object.find("draft");
+      if (draft != object.end() && draft->second.is<bool>() && draft->second.get<bool>())
+        continue;
+      if (lab ? name.rfind("lab-v", 0) == 0 : (!prerelease && name.rfind("v", 0) == 0))
+      {
+        found = &object;
+        break;
+      }
+    }
+  }
+  if (!found)
+  {
+    release.error = lab ? "no Dolphin Lab release on GitHub yet" : "no release on GitHub yet";
+    Log("check failed: " + release.error);
+    return release;
+  }
+  const picojson::object& root = *found;
+  auto text = [](const picojson::object& object, const char* key) {
+    const auto it = object.find(key);
+    return it != object.end() && it->second.is<std::string>() ? it->second.get<std::string>() :
+                                                                 std::string();
+  };
+  std::string tag = text(root, "tag_name");
+  if (tag.rfind("lab-v", 0) == 0)
+    tag.erase(0, 5);
+  else if (tag.rfind("v", 0) == 0)
+    tag.erase(0, 1);
+  release.version = tag;
+  release.title = text(root, "name");
+
+  const auto assets = root.find("assets");
+  if (assets != root.end() && assets->second.is<picojson::array>())
+  {
+    for (const picojson::value& value : assets->second.get<picojson::array>())
+    {
+      if (!value.is<picojson::object>())
+        continue;
+      const picojson::object& asset = value.get<picojson::object>();
+      const std::string name = text(asset, "name");
+      const auto size = asset.find("size");
+      const uint64_t bytes = size != asset.end() && size->second.is<double>() ?
+                                 static_cast<uint64_t>(size->second.get<double>()) :
+                                 0;
+      const std::string digest = text(asset, "digest");
+      const std::string sha256 = digest.compare(0, 7, "sha256:") == 0 ? Lower(digest.substr(7)) : "";
+      if (EndsWith(Lower(name), "-update.tar") && release.update_url.empty())
+      {
+        release.update_name = name;
+        release.update_url = text(asset, "browser_download_url");
+        release.update_size = bytes;
+        release.update_sha256 = sha256;
+      }
+      else if (EndsWith(Lower(name), ".pkg") && release.url.empty())
+      {
+        release.package = name;
+        release.url = text(asset, "browser_download_url");
+        release.size = bytes;
+        release.sha256 = sha256;
+      }
+    }
+  }
+  if (release.update_sha256.size() != 64)
+  {
+    // Without GitHub's checksum the archive couldn't be checked: the package is offered instead.
+    release.update_url.clear();
+  }
+  if (release.version.empty() || release.url.empty())
+  {
+    release.error = "the latest release has no package";
+  }
+  else if (release.sha256.size() != 64)
+  {
+    // Without GitHub's checksum the download couldn't be checked: don't offer it.
+    release.error = "the latest release has no checksum";
+  }
+  else
+  {
+    release.ok = true;
+  }
+  Log("latest release " + release.version + " (" + release.package + ", " +
+      std::to_string(release.size) + " bytes" +
+      (release.update_url.empty() ? "" :
+                                    "; " + release.update_name + ", " +
+                                        std::to_string(release.update_size) + " bytes") +
+      ")" + (release.ok ? "" : ": " + release.error));
+  return release;
+}
+
+int CompareVersions(const std::string& a, const std::string& b)
+{
+  auto parts = [](const std::string& text) {
+    std::vector<long> numbers;
+    size_t i = 0;
+    while (i < text.size())
+    {
+      if (std::isdigit(static_cast<unsigned char>(text[i])))
+      {
+        char* end = nullptr;
+        numbers.push_back(std::strtol(text.c_str() + i, &end, 10));
+        i = static_cast<size_t>(end - text.c_str());
+      }
+      else
+      {
+        i++;
+      }
+    }
+    return numbers;
+  };
+  const std::vector<long> x = parts(a), y = parts(b);
+  for (size_t i = 0; i < std::max(x.size(), y.size()); i++)
+  {
+    const long p = i < x.size() ? x[i] : 0, q = i < y.size() ? y[i] : 0;
+    if (p != q)
+      return p < q ? -1 : 1;
+  }
+  return 0;
+}
+
+bool Download(const Release& release, const std::string& path, const std::string& ca_file,
+              const std::function<bool(uint64_t, uint64_t)>& progress, std::string* error)
+{
+  const std::string part = path + ".part";
+  FILE* file = fopen(part.c_str(), "wb");
+  if (!file)
+  {
+    *error = "can't write " + part;
+    return false;
+  }
+  mbedtls_sha256_context sha;
+  mbedtls_sha256_init(&sha);
+  mbedtls_sha256_starts_ret(&sha, 0);
+  uint64_t written = 0;
+  bool write_failed = false;
+
+  PS4Net::Request request;
+  request.url = release.url;
+  request.ca_file = ca_file;
+  request.timeout_seconds = 0;  // a large file on a slow line; stalls end it instead
+  const long status = PS4Net::Get(
+      request,
+      [&](const char* data, size_t size) {
+        if (fwrite(data, 1, size, file) != size)
+        {
+          write_failed = true;
+          return false;
+        }
+        mbedtls_sha256_update_ret(&sha, reinterpret_cast<const unsigned char*>(data), size);
+        written += size;
+        return true;
+      },
+      [&](uint64_t done, uint64_t total) {
+        return progress(done, total ? total : release.size);
+      },
+      error);
+  fclose(file);
+  unsigned char digest[32];
+  mbedtls_sha256_finish_ret(&sha, digest);
+  mbedtls_sha256_free(&sha);
+
+  if (write_failed)
+    *error = "couldn't write the package (is the PS4's storage full?)";
+  else if (status != 200 && error->empty())
+    *error = "GitHub answered " + std::to_string(status);
+  else if (status == 200 && written != release.size)
+    *error = "the download is incomplete";
+  else if (status == 200 && Hex(digest, sizeof(digest)) != release.sha256)
+    *error = "the download doesn't match GitHub's checksum";
+  if (status != 200 || write_failed || !error->empty())
+  {
+    std::remove(part.c_str());
+    Log("download failed: " + *error);
+    return false;
+  }
+  std::remove(path.c_str());
+  if (std::rename(part.c_str(), path.c_str()) != 0)
+  {
+    *error = "can't rename " + part;
+    std::remove(part.c_str());
+    return false;
+  }
+  Log("downloaded " + path + " (" + std::to_string(written) + " bytes, checksum OK)");
+  return true;
+}
+
+bool ExtractTar(const std::string& tar, const std::string& dir, std::string* error)
+{
+  FILE* in = fopen(tar.c_str(), "rb");
+  if (!in)
+  {
+    *error = "can't open " + tar;
+    return false;
+  }
+  std::vector<char> buffer(1 << 20);
+  bool ok = true;
+  int files = 0;
+  while (ok)
+  {
+    unsigned char header[512];
+    if (fread(header, 1, sizeof(header), in) != sizeof(header))
+    {
+      *error = "the archive is cut short";
+      ok = false;
+      break;
+    }
+    if (std::all_of(header, header + sizeof(header), [](unsigned char c) { return c == 0; }))
+      break;  // the end
+    auto field = [&](size_t at, size_t length) {
+      const char* begin = reinterpret_cast<const char*>(header + at);
+      return std::string(begin, strnlen(begin, length));
+    };
+    std::string name = field(0, 100);
+    const std::string prefix = field(345, 155);
+    if (!prefix.empty())
+      name = prefix + "/" + name;
+    const uint64_t size = std::strtoull(field(124, 12).c_str(), nullptr, 8);
+    const char type = static_cast<char>(header[156]);
+    while (name.rfind("./", 0) == 0)
+      name.erase(0, 2);
+    if (name.empty() || name[0] == '/' || name.find("..") != std::string::npos)
+    {
+      *error = "the archive has an unsafe path: " + name;
+      ok = false;
+      break;
+    }
+    const std::string path = dir + "/" + name;
+    if (type == '5')
+    {
+      std::error_code ec;
+      std::filesystem::create_directories(path, ec);
+      continue;
+    }
+    if (type != '0' && type != '\0')
+    {
+      // Anything else (links, extended headers) is skipped with its data.
+      fseek(in, static_cast<long>((size + 511) / 512 * 512), SEEK_CUR);
+      continue;
+    }
+    std::error_code ec;
+    std::filesystem::create_directories(std::filesystem::path(path).parent_path(), ec);
+    FILE* out = fopen(path.c_str(), "wb");
+    if (!out)
+    {
+      *error = "can't write " + path;
+      ok = false;
+      break;
+    }
+    uint64_t left = size;
+    while (left > 0 && ok)
+    {
+      const size_t chunk = static_cast<size_t>(std::min<uint64_t>(left, buffer.size()));
+      if (fread(buffer.data(), 1, chunk, in) != chunk || fwrite(buffer.data(), 1, chunk, out) != chunk)
+      {
+        *error = "can't unpack " + name;
+        ok = false;
+      }
+      left -= chunk;
+    }
+    fclose(out);
+    files++;
+    const uint64_t padding = (512 - size % 512) % 512;
+    if (ok && padding)
+      fseek(in, static_cast<long>(padding), SEEK_CUR);
+  }
+  fclose(in);
+  if (ok)
+    Log("unpacked " + std::to_string(files) + " files into " + dir);
+  return ok;
+}
+}  // namespace PS4Updater
diff --git a/Source/Core/DolphinNoGUI/PS4Updater.h b/Source/Core/DolphinNoGUI/PS4Updater.h
new file mode 100755
index 0000000..914dbb5
--- /dev/null
+++ b/Source/Core/DolphinNoGUI/PS4Updater.h
@@ -0,0 +1,58 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// Updates from the project's GitHub releases: the latest release is compared with the running
+// version, and its files are downloaded (the connection's certificate checked, each file checked
+// against the SHA-256 GitHub publishes for it).
+//
+// A release has the full package (.pkg) and, from v03.07, an update archive
+// (DolphinPS4-v<version>-update.tar: eboot.bin, xmb/ and Sys/). The archive is unpacked into
+// /data/DolphinPS4/app, and the installed app starts the newer program from there
+// (PlatformPS4.cpp, StartDownloadedUpdate), the way the PS4 Homebrew Store updates itself. A
+// release without one: the package goes to /data/pkg for the user's package installer.
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <functional>
+#include <string>
+
+namespace PS4Updater
+{
+struct Release
+{
+  bool ok = false;
+  std::string error;
+  std::string version;    // "02.99" (the tag without its "v")
+  std::string title;      // the release's name
+  std::string package;    // file name of the .pkg asset
+  std::string url;        // its download address
+  uint64_t size = 0;
+  std::string sha256;     // lower-case hex
+  // The update archive, if the release has one.
+  std::string update_name;
+  std::string update_url;
+  uint64_t update_size = 0;
+  std::string update_sha256;
+};
+
+// The latest release on GitHub.
+Release CheckLatest(const std::string& ca_file);
+
+// <0 if a is older than b, 0 if equal, >0 if newer ("02.99" < "03.00" < "03.10").
+int CompareVersions(const std::string& a, const std::string& b);
+
+// Downloads the release's package to path (through path + ".part"), checking its size and
+// SHA-256. progress(done, total) may return false to cancel. Returns false with *error set.
+bool Download(const Release& release, const std::string& path, const std::string& ca_file,
+              const std::function<bool(uint64_t, uint64_t)>& progress, std::string* error);
+
+// Unpacks a tar archive (ustar: plain files and folders) into dir. Returns false with *error set.
+bool ExtractTar(const std::string& tar, const std::string& dir, std::string* error);
+
+// There is no Install(): the running app can't install over itself. With the app already
+// installed the PS4's installer refuses the package, and the system's overwrite call
+// (sceAppInstUtilAppPrepareOverwritePkg) uninstalls the running app on the spot (v03.03).
+// The checked package goes to /data/pkg for the user's package installer instead.
+}  // namespace PS4Updater
