+ImTextureID Menu::LoadPngTexture(const std::string& path, float* aspect)
+{
+  const std::string data = ReadFile(path);
+  if (data.empty())
+    return ImTextureID{};
+  Common::UniqueBuffer<u8> pixels;
+  u32 width = 0, height = 0;
+  if (!Common::LoadPNG(std::span(reinterpret_cast<const u8*>(data.data()), data.size()), &pixels,
+                       &width, &height))
+  {
+    Log("not a PNG: " + path);
+    return ImTextureID{};
+  }
+  if (aspect)
+    *aspect = static_cast<float>(width) / static_cast<float>(height);
+  // Shrunk to what the menus draw (covers are at most ~460 pixels tall): full-size GameTDB covers
+  // took several MB of GPU memory each, and a large library ran out (crash at every start).
+  constexpr u32 MAX_SIDE = 512;
+  if (width > MAX_SIDE || height > MAX_SIDE)
+  {
+    const u32 factor = (std::max(width, height) + MAX_SIDE - 1) / MAX_SIDE;
+    const u32 w = std::max(1u, width / factor), h = std::max(1u, height / factor);
+    std::vector<u8> small(static_cast<size_t>(w) * h * 4);
+    for (u32 y = 0; y < h; y++)
+    {
+      for (u32 x = 0; x < w; x++)
+      {
+        u32 sum[4] = {};
+        for (u32 dy = 0; dy < factor; dy++)
+        {
+          const u8* row = pixels.data() + (static_cast<size_t>(y * factor + dy) * width + x * factor) * 4;
+          for (u32 dx = 0; dx < factor; dx++)
+          {
+            for (int c = 0; c < 4; c++)
+              sum[c] += row[dx * 4 + c];
+          }
+        }
+        for (int c = 0; c < 4; c++)
+          small[(static_cast<size_t>(y) * w + x) * 4 + c] = static_cast<u8>(sum[c] / (factor * factor));
+      }
+    }
+    return m_display.CreateTexture(small.data(), w, h);
+  }
+  return m_display.CreateTexture(pixels.data(), width, height);
+}
