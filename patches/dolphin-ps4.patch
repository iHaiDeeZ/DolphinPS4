+{
+  OP_PAD,
+  OP_BeginCommandBuffer,
+  OP_EndCommandBuffer,
+  OP_ResetCommandPool,
+  OP_ResetFences,
+  OP_QueueSubmit,
+  OP_CmdBindPipeline,
+  OP_CmdBindDescriptorSets,
+  OP_CmdBindVertexBuffers,
+  OP_CmdBindIndexBuffer,
+  OP_CmdDraw,
+  OP_CmdDrawIndexed,
+  OP_CmdDispatch,
+  OP_CmdSetViewport,
+  OP_CmdSetScissor,
+  OP_CmdBeginRenderPass,
+  OP_CmdEndRenderPass,
+  OP_CmdPipelineBarrier,
+  OP_CmdClearAttachments,
+  OP_CmdUpdateBuffer,
+  OP_CmdResetQueryPool,
+  OP_CmdBeginQuery,
+  OP_CmdEndQuery,
+  OP_CmdCopyBufferToImage,
+  OP_CmdCopyImageToBuffer,
+  OP_CmdCopyImage,
+  OP_CmdCopyBuffer,
+  OP_CmdBlitImage,
+  OP_CmdResolveImage,
+};
