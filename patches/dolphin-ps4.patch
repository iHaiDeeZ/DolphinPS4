+// Set when the console won't run code from memory Dolphin writes (no JIT): PS4IngameMenu tells
+// the player, the game runs on the cached interpreter.
+extern "C" int ps4_jit_unavailable;
+int ps4_jit_unavailable = 0;
+extern "C" int ps4_move_connected(int32_t user_id);  // InputCommon/.../PS4Pad/PS4Pad.cpp
+extern "C" int ps4_move_enabled;  // InputCommon/.../PS4Pad/PS4Pad.cpp
+extern "C" char ps4_profile_tag[32];  // port/ps4_sampler.cpp: profile file names
+
+// PS4XMB.cpp, at its first frame, and before a game starts: a downloaded update works.
+extern "C" void ps4_update_started_ok()
+{
+  std::remove(UPDATE_PENDING.c_str());
+}
