+// ps4.ini uniform_merge: 0 off, 1 on, 2 auto (on when the range test passes).
+extern "C" int ps4_uniform_merge_mode;
+int ps4_uniform_merge_mode = 2;
+extern "C" int ps4_uniform_merged;               // ProgramShaderCache.cpp
+extern "C" unsigned ps4_uniform_merged_vs_offset();  // ProgramShaderCache.cpp
+
+static void PS4ChooseUniformUpload()
+{
+  const GLuint program = PS4BenchProgram(
+      "#version 300 es\nvoid main() { gl_PointSize = 1.0; gl_Position = vec4(0.0, 0.0, 0.0, "
+      "1.0); }\n",
+      "#version 300 es\nprecision mediump float;\nlayout(std140) uniform B { vec4 color; };\n"
+      "out vec4 c;\nvoid main() { c = color; }\n");
+  bool merged_ok = false;
+  if (program)
+  {
+    glUniformBlockBinding(program, glGetUniformBlockIndex(program, "B"), 6);
+    GLuint texture = 0, fbo = 0, buffer = 0, vao = 0;
+    glGenTextures(1, &texture);
+    glBindTexture(GL_TEXTURE_2D, texture);
+    glTexStorage2D(GL_TEXTURE_2D, 1, GL_RGBA8, 1, 1);
+    glGenFramebuffers(1, &fbo);
+    glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, texture, 0);
+    glGenBuffers(1, &buffer);
+    glBindBuffer(GL_UNIFORM_BUFFER, buffer);
+    glBufferData(GL_UNIFORM_BUFFER, 8192, nullptr, GL_DYNAMIC_DRAW);
+    glGenVertexArrays(1, &vao);
+    glBindVertexArray(vao);
+    const GLboolean scissor = glIsEnabled(GL_SCISSOR_TEST);
+    const GLboolean depth = glIsEnabled(GL_DEPTH_TEST);
+    const GLboolean blend = glIsEnabled(GL_BLEND);
+    const GLboolean cull = glIsEnabled(GL_CULL_FACE);
+    glDisable(GL_SCISSOR_TEST);
+    glDisable(GL_DEPTH_TEST);
+    glDisable(GL_BLEND);
+    glDisable(GL_CULL_FACE);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    if (glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE)
+    {
+      PS4TestUniformRange(program, buffer, fbo, 0);
+      PS4TestUniformRange(program, buffer, fbo, 256);
+      PS4TestUniformRange(program, buffer, fbo, 1536);
+      merged_ok = PS4TestUniformRange(program, buffer, fbo, ps4_uniform_merged_vs_offset());
+    }
+    // Leave the state as Dolphin set it (it relies on the scissor test staying enabled).
+    if (scissor)
+      glEnable(GL_SCISSOR_TEST);
+    if (depth)
+      glEnable(GL_DEPTH_TEST);
+    if (blend)
+      glEnable(GL_BLEND);
+    if (cull)
+      glEnable(GL_CULL_FACE);
+    glBindBufferBase(GL_UNIFORM_BUFFER, 6, 0);
+    glBindBuffer(GL_UNIFORM_BUFFER, 0);
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    glBindVertexArray(0);
+    glUseProgram(0);
+    glDeleteVertexArrays(1, &vao);
+    glDeleteBuffers(1, &buffer);
+    glDeleteFramebuffers(1, &fbo);
+    glDeleteTextures(1, &texture);
+    glDeleteProgram(program);
+  }
+  ps4_uniform_merged = ps4_uniform_merge_mode == 1 || (ps4_uniform_merge_mode == 2 && merged_ok);
+  ps4_boot_trace(ps4_uniform_merged ? "uniform upload: merged pixel + vertex constants" :
+                                      "uniform upload: separate buffers per block");
+}
