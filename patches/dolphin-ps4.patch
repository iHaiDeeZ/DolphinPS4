+
+void Menu::BuildSharesRows()
+{
+  const std::vector<std::string> shares = PS4XMB::NetworkShares(m_data_dir);
+  std::vector<SettingRow> rows;
+  rows.push_back({"Shares", "", "", true});
+  for (size_t i = 0; i < shares.size(); i++)
+  {
+    std::string base = shares[i];
+    while (!base.empty() && base.back() == '/')
+      base.pop_back();
+    size_t games = 0;
+    for (const Game& game : m_games)
+      games += game.path.compare(0, base.size() + 1, base + "/") == 0;
+    std::string value = static_cast<int>(i) == m_share_remove ? "Press again to remove" :
+                        games == 1                            ? "1 game" :
+                                                                std::to_string(games) + " games";
+    rows.push_back({Common::NetFS::Redact(shares[i]), value, "share:#" + std::to_string(i)});
+  }
+  if (shares.empty())
+    rows.push_back({"No shares yet", "", "share:none"});
+  rows.push_back({"Add", "", "", true});
+  rows.push_back({"Add NFS Share", "nfs://", "share:nfs"});
+  rows.push_back({"Add SMB Share", "smb://", "share:smb"});
+  rows.push_back({"Rescan", m_share_status, "share:rescan"});
+  m_panel.rows = std::move(rows);
+  m_panel.lines = {"Games are read over the network (PC, NAS): nothing is copied to the PS4.",
+                   "NFS: nfs://192.168.0.10/export/games (NFS 4: add ?version=4)",
+                   "SMB: smb://user:password@192.168.0.10/share/games (no user: Guest)",
+                   "Cross twice on a share removes it. A wired connection is best."};
