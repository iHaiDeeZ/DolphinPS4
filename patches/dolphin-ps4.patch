+    x = static_cast<int>(texture->GetWidth() / 2);
+    y = static_cast<int>(texture->GetHeight() / 2);
+    glGenFramebuffers(1, &fbo);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, fbo);
+    if (gltex->GetGLTarget() == GL_TEXTURE_2D_ARRAY)
+    {
+      glFramebufferTextureLayer(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                                gltex->GetGLTextureId(), 0, 0);
