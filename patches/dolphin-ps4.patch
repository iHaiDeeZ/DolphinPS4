+std::string AchievementBrief(std::string* message = nullptr)
+{
+  std::string brief, text;
+#ifdef USE_RETRO_ACHIEVEMENTS
+  {
+    std::lock_guard lock(s_mutex);
+    brief = s_ach_brief;
+    text = s_ach_message;
+  }
+  if (brief.empty())
+  {
+    if (!Config::Get(Config::RA_ENABLED))
+    {
+      brief = "Off";
+      text = "RetroAchievements is off: turn it on in the game list (Settings -> "
+             "RetroAchievements -> Achievements).";
+    }
+    else if (Config::Get(Config::RA_API_TOKEN).empty())
+    {
+      brief = "Not logged in";
+      text = "Not logged in to RetroAchievements: log in from the game list (Settings -> "
+             "RetroAchievements).";
+    }
+    else
+    {
+      brief = "Loading...";
+      text = "Loading this game's achievements from RetroAchievements...";
+    }
+  }
+#else
+  brief = "Not available";
+  text = "This build has no RetroAchievements.";
+#endif
+  if (message)
+    *message = text;
+  return brief;
