+int s_demo = -1;  // -1: not checked yet
+PS4Achievements::List s_demo_list;
+Clock::time_point s_demo_last;
+
+bool DemoMode()
+{
+  if (s_demo < 0)
+  {
+    const std::string data_dir = PS4Achievements::DataDir();
+    s_demo = !data_dir.empty() && access((data_dir + "/achievements-demo").c_str(), F_OK) == 0;
+    if (s_demo)
+    {
+      static const struct
+      {
+        const char* title;
+        const char* description;
+        uint32_t points;
+        int type;
+        float rarity;
+      } DEMO[] = {
+          {"First Steps", "Start the demo", 1, 2, 98.5f},
+          {"Warming Up", "Play for 25 seconds", 5, 0, 81.2f},
+          {"Collector", "Find 10 hidden orbs", 10, 0, 45.0f, },
+          {"Sharpshooter", "Hit 50 targets in a row", 10, 0, 23.4f},
+          {"Speed Runner", "Finish a stage in under 2 minutes", 25, 0, 8.7f},
+          {"Don't Look Back", "Open the sealed door before it closes for good", 10, 1, 12.1f},
+          {"Halfway There", "Reach the middle of the adventure", 10, 2, 40.3f},
+          {"Untouchable", "Beat a boss without taking damage", 25, 0, 4.2f},
+          {"Treasure Hunter", "Open every chest", 25, 0, 2.9f},
+          {"The End", "Finish the adventure", 25, 3, 18.6f},
+          {"Completionist", "Unlock everything else", 50, 0, 0.8f},
+          {"Thank You", "Watch the credits to the end", 5, 0, 15.0f},
+      };
+      s_demo_list = {};
+      s_demo_list.game = "Achievement Demo";
+      s_demo_list.badge = "demo";
+      int id = 1;
+      for (const auto& d : DEMO)
+      {
+        PS4Achievements::Entry entry;
+        entry.title = d.title;
+        entry.description = d.description;
+        entry.points = d.points;
+        entry.type = d.type;
+        entry.rarity = d.rarity;
+        entry.id = static_cast<uint32_t>(900000 + id);
+        entry.badge = "demo" + std::to_string(id);
+        entry.unlocked = id <= 2;
+        entry.unlock_time = entry.unlocked ? static_cast<int64_t>(std::time(nullptr)) : 0;
+        if (id == 3)
+          entry.progress = "3/10";
+        s_demo_list.entries.push_back(std::move(entry));
+        id++;
+      }
+      s_demo_last = Clock::now();
+      ps4_boot_trace("achievements: demo mode");
+    }
+  }
+  return s_demo > 0;
+}
