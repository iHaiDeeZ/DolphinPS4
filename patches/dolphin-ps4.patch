+#ifdef __ORBIS__
+// PS4: lfs -> stfs forwarding. Games copy single-precision data with lfs/stfs (Crash Bandicoot:
+// The Wrath of Cortex sends its vertices to the gather pipe that way, ~9% of the CPU thread).
+// Each lfs converts single -> double and each stfs converts back (bit-exactly, which takes about
+// 20 x86 instructions per value on this path). When the stored register still holds what an lfs
+// in this block loaded, the stfs can store the loaded bits themselves: lfs keeps its 32 bits in
+// ppcState, stfs reloads them. Bit-exact by construction (the original memory contents).
+void Jit64::PS4AnalyzeRawSingles(u32 num_instructions)
+{
+  m_ps4_raw_single.assign(num_instructions, 0);
+  m_ps4_raw_only.assign(num_instructions, BitSet32{});
+  if (bJITLoadStoreFloatingOff || !ps4_lfs_forward)
+    return;
+  const auto is_lfs = [](UGeckoInstruction inst) {
+    // lfs, lfsu, lfsx, lfsux. lfs/lfsu with rA = 0 fall back to the interpreter (lfXXX).
+    if (inst.OPCD == 48 || inst.OPCD == 49)
+      return inst.RA != 0;
+    return inst.OPCD == 31 && (inst.SUBOP10 == 535 || inst.SUBOP10 == 567);
+  };
+  const auto is_stfs = [](UGeckoInstruction inst) {
+    // stfs, stfsu, stfsx, stfsux
+    return inst.OPCD == 52 || inst.OPCD == 53 ||
+           (inst.OPCD == 31 && (inst.SUBOP10 == 663 || inst.SUBOP10 == 695));
+  };
+  s32 producer[32];
+  for (s32& p : producer)
+    p = -1;
+  for (u32 i = 0; i < num_instructions; i++)
+  {
+    const PPCAnalyst::CodeOp& op = m_code_buffer[i];
+    if (op.skip)
+    {
+      if (op.fregOut >= 0)
+        producer[op.fregOut] = -1;
+      continue;
+    }
+    if (is_stfs(op.inst) && producer[op.inst.RS] >= 0)
+    {
+      m_ps4_raw_single[i] |= 2;
+      m_ps4_raw_single[producer[op.inst.RS]] |= 1;
+    }
+    if (op.fregOut >= 0)
+      producer[op.fregOut] = is_lfs(op.inst) ? static_cast<s32>(i) : -1;
+  }
+
+  // Lazy lfs (flag 4): an lfs whose value is only ever stored by forwarded stfs before the
+  // register is overwritten, in this block, with nothing in between that could leave the block or
+  // flush registers, needs no single -> double conversion at all: the register cache entry is
+  // discarded until the overwrite. (Crash Bandicoot's vertex loops: 6 of 8 loads per vertex.)
+  m_ps4_raw_only.assign(num_instructions, BitSet32{});
+  if (!ps4_lazy_lfs || jo.memcheck || jo.fp_exceptions || jo.div_by_zero_exceptions ||
+      IsDebuggingEnabled() || bJITRegisterCacheOff)
+  {
+    return;
+  }
+  for (u32 i = 0; i < num_instructions; i++)
+  {
+    const PPCAnalyst::CodeOp& load = m_code_buffer[i];
+    if (load.skip || !is_lfs(load.inst) || !(m_ps4_raw_single[i] & 1) ||
+        js.fifoWriteAddresses.contains(load.address))
+    {
+      continue;
+    }
+    const u32 d = load.inst.RD;
+    u32 overwrite = 0;
+    bool ok = true;
+    for (u32 k = i + 1; k < num_instructions && ok; k++)
+    {
+      const PPCAnalyst::CodeOp& op = m_code_buffer[k];
+      if (op.skip || op.canEndBlock ||
+          (op.opinfo->flags & (FL_PROGRAMEXCEPTION | FL_FLOAT_EXCEPTION |
+                               FL_FLOAT_DIV)) ||
+          js.fifoWriteAddresses.contains(op.address) ||
+          (op.inst.OPCD == 31 && op.inst.SUBOP10 == 854) ||  // eieio
+          HLE::TryReplaceFunction(m_ppc_symbol_db, op.address, PowerPC::CoreMode::JIT))
+      {
+        ok = false;
+        break;
+      }
+      if (op.fregsIn[d])
+      {
+        // Only stores of the loaded bits may read it.
+        if (!(is_stfs(op.inst) && op.inst.RS == d && (m_ps4_raw_single[k] & 2)))
+          ok = false;
+        else if (op.fregOut == static_cast<s32>(d))
+          ok = false;
+        continue;
+      }
+      if (op.fregOut == static_cast<s32>(d))
+      {
+        overwrite = k;
+        break;
+      }
+    }
+    if (!ok || overwrite == 0)
+      continue;
+    m_ps4_raw_single[i] |= 4;
+    for (u32 k = i + 1; k <= overwrite; k++)
+      m_ps4_raw_only[k][d] = true;
+  }
+}
+
+u8 Jit64::PS4RawSingleFlags() const
+{
+  const size_t index = static_cast<size_t>(js.op - m_code_buffer.data());
+  return index < m_ps4_raw_single.size() ? m_ps4_raw_single[index] : 0;
+}
+#endif
+
+#ifdef __ORBIS__
+// PS4: gather pipe write fusion. Each gather pipe store used to load gather_pipe_ptr, store, add
+// and store the pointer back - so every write waited for the previous write's pointer store
+// (store-to-load forwarding, ~5 cycles each on Jaguar; 9 writes per vertex in Crash Bandicoot's
+// vertex loops). Now a run of writes stores at [gather_pipe_ptr + compile-time offset] and the
+// pointer is advanced once (this function) before anything that may read it: any instruction that
+// could call C code or leave the block (PS4CanDeferGatherPipeCommit is false), the gather pipe
+// check, and every block exit (Cleanup, without resetting: exits are emitted out of line).
+void Jit64::PS4CommitGatherPipe(bool reset)
+{
+  if (js.ps4_gp_pending == 0)
+    return;
+  ADD(64, PPCSTATE(gather_pipe_ptr), Imm32(js.ps4_gp_pending));
+  if (reset)
+    js.ps4_gp_pending = 0;
+}
+
+// Instructions that can run with a pointer update pending: simple integer arithmetic (no calls,
+// no exceptions, no exits) and stores that go to the gather pipe at a known address.
+bool Jit64::PS4CanDeferGatherPipeCommit(const PPCAnalyst::CodeOp& op)
+{
+  if (op.skip || jo.memcheck || !jo.optimizeGatherPipe || bJITOff || bJITLoadStoreOff ||
+      bJITLoadStoreFloatingOff || bJITIntegerOff || IsDebuggingEnabled())
+    return false;
+  // HLE hooks call C code before the instruction.
+  if (HLE::TryReplaceFunction(m_ppc_symbol_db, op.address, PowerPC::CoreMode::JIT))
+    return false;
+  const UGeckoInstruction inst = op.inst;
+  switch (inst.OPCD)
+  {
+  case 7:   // mulli
+  case 14:  // addi
+  case 15:  // addis
+  case 21:  // rlwinmx
+  case 24:  // ori
+  case 25:  // oris
+  case 26:  // xori
+  case 27:  // xoris
+  case 28:  // andi.
+  case 29:  // andis.
+    return true;
+  case 31:
+    switch (inst.SUBOP10)
+    {
+    case 266:  // add
+    case 40:   // subf
+    case 444:  // or
+    case 28:   // and
+    case 316:  // xor
+    case 235:  // mullw
+      return !inst.OE;
+    default:
+      return false;
+    }
+  case 36:  // stw
+  case 37:  // stwu
+  case 38:  // stb
+  case 39:  // stbu
+  case 44:  // sth
+  case 45:  // sthu
+  case 52:  // stfs
+  case 53:  // stfsu
+  case 54:  // stfd
+  case 55:  // stfdu
+  {
+    if (inst.RA != 0 && !gpr.IsImm(inst.RA))
+      return false;
