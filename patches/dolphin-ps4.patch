+
+void Menu::BuildSettingRows()
+{
+  std::vector<SettingRow> rows;
+  const std::string& game = m_panel.game_id;
+  if (!game.empty())
+  {
+    rows.push_back({"Apply To", PS4Settings::IsCustom(game) ? "This Game" : "All Games", "", false,
+                    true});
+  }
+  for (const char* category : PS4Settings::Categories())
+  {
+    if (!m_panel.category.empty() && m_panel.category != category)
+      continue;
+    if (m_panel.category.empty())
+      rows.push_back({category, "", "", true});
+    for (const PS4Settings::Setting& setting : PS4Settings::All())
+    {
+      if (std::string(setting.category) != category)
+        continue;
+      rows.push_back({setting.label,
+                      PS4Settings::LabelOf(setting, PS4Settings::Get(setting.key, game)),
+                      setting.key, false, false, !setting.live});
+    }
+  }
+  rows.push_back({"", "", "", true});
+  rows.push_back({game.empty() ? "Reset to Defaults" : "Reset This Game", "", "__reset__"});
+  m_panel.rows = std::move(rows);
+}
+
+// Moves the selection by direction (0: onto the nearest selectable row), skipping headers.
+void Menu::MoveSettingRow(int direction)
+{
+  const int count = static_cast<int>(m_panel.rows.size());
+  int row = std::clamp(m_panel.selected + direction, 0, std::max(0, count - 1));
+  const int step = direction < 0 ? -1 : 1;
+  while (row >= 0 && row < count && m_panel.rows[row].header)
+    row += step;
+  if (row >= 0 && row < count)
+    m_panel.selected = row;
+}
+
+void Menu::ChangeSettingRow(int direction)
+{
+  if (m_panel.selected < 0 || m_panel.selected >= static_cast<int>(m_panel.rows.size()))
+    return;
+  const SettingRow& row = m_panel.rows[m_panel.selected];
+  const std::string& game = m_panel.game_id;
+  if (m_panel.setting == SET_GAMES_DIR)
+  {
+    if (direction <= 0)
+      return;  // Cross only (Left / Right do nothing here)
+    if (row.key.rfind("dir:", 0) == 0)
+    {
+      OpenFolderBrowser(row.key.substr(4));
+    }
+    else if (row.key == "usedir")
+    {
+      m_prefs.games_dir = m_browse_dir == m_data_dir + "/games" ? "" : m_browse_dir;
+      m_prefs.Save(m_data_dir + "/xmb.ini");
+      m_panel.open = false;
+      RefreshGames();
+      Play("confirm");
+    }
+    return;
+  }
+  if (row.key.rfind("ctl:", 0) == 0 || row.key == "__ctlreset__")
+  {
+    const auto device = static_cast<PS4Controls::Device>(m_controls_device);
+    if (row.key == "__ctlreset__")
+    {
+      if (direction > 0)
+        PS4Controls::ResetToDefault(device);
+      BuildControlRows();
+      return;
+    }
+    const auto& binding = PS4Controls::Bindings(device)[std::atoi(row.key.c_str() + 4)];
+    if (binding.stick_group)
+    {
+      // Sticks: Left Stick / Right Stick / D-Pad.
+      const auto choices = PS4Controls::StickChoices();
+      const std::string current = PS4Controls::Get(device, binding);
+      int index = 0;
+      for (size_t i = 0; i < choices.size(); i++)
+      {
+        if (choices[i] == current)
+          index = static_cast<int>(i);
+      }
+      const int count = static_cast<int>(choices.size());
+      index = ((index + direction) % count + count) % count;
+      PS4Controls::Set(device, binding, choices[index]);
+      BuildControlRows();
+    }
+    else if (direction > 0)
+    {
+      // Buttons: wait for the next press (UpdateCapture).
+      m_capture = true;
+      m_capture_released = false;
+      m_capture_time = 0.0f;
+      m_capture_row = m_panel.selected;
+    }
+    return;
+  }
+  if (row.key.rfind("cheat:", 0) == 0)
+  {
+    m_cheats.Toggle(static_cast<size_t>(std::atoi(row.key.c_str() + 6)));
+    BuildCheatRows();
+    return;
+  }
+  if (row.key.rfind("cheatall:", 0) == 0)
+  {
+    m_cheats.SetAll(row.key == "cheatall:on");
+    BuildCheatRows();
+    return;
+  }
+  if (row.scope)
+  {
+    PS4Settings::SetCustom(game, !PS4Settings::IsCustom(game));
+  }
+  else if (row.key == "__reset__")
+  {
+    // A game: it follows the global settings again. A category: its global values go back to
+    // ps4.ini's tuned defaults.
+    if (direction <= 0)
+      return;
+    if (!game.empty())
+    {
+      PS4Settings::ResetGame(game);
+    }
+    else
+    {
+      for (const PS4Settings::Setting& setting : PS4Settings::All())
+      {
+        if (m_panel.category == setting.category)
+          PS4Settings::ResetGlobal(setting.key);
+      }
+    }
+  }
+  else if (!row.key.empty())
+  {
+    const PS4Settings::Setting* setting = PS4Settings::Find(row.key);
+    if (!setting)
+      return;
+    // A game following the global settings: changing one of its values makes it custom.
+    if (!game.empty() && !PS4Settings::IsCustom(game))
+      PS4Settings::SetCustom(game, true);
+    PS4Settings::Set(row.key, PS4Settings::Step(*setting, PS4Settings::Get(row.key, game), direction),
+                     game);
+  }
+  BuildSettingRows();
+}
