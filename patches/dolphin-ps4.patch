+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// PS4 cheats: the Action Replay and Gecko codes Dolphin ships for each game (Sys/GameSettings)
+// plus the user's own, switched on and off from the XMB or the in-game menu. The choices are
+// saved in the user's game settings (User/GameSettings/<ID>.ini), as Dolphin's cheat manager
+// does.
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace PS4Cheats
+{
+struct Entry
+{
+  std::string name;
+  bool enabled;
+  bool gecko;  // Gecko code (else Action Replay)
+};
+
+class List
+{
+public:
+  List();
+  ~List();
+  List(const List&) = delete;
+  List& operator=(const List&) = delete;
+
+  void Load(const std::string& game_id, uint16_t revision);
+  std::vector<Entry> Entries() const;
+  // Switches entry i on/off and saves the choice.
+  void Toggle(size_t i);
+  // Switches every code on or off and saves the choice.
+  void SetAll(bool enabled);
+  // Game process: makes the current choices active in the running game.
+  void ApplyToRunningGame() const;
+
+private:
+  void Save() const;
+
+  struct Codes;
+  Codes* m_codes;
+  std::string m_game_id;
+  uint16_t m_revision = 0;
+};
+}  // namespace PS4Cheats
diff --git a/Source/Core/DolphinNoGUI/PS4Controls.cpp b/Source/Core/DolphinNoGUI/PS4Controls.cpp
new file mode 100755
index 0000000..f5b7d92
--- /dev/null
+++ b/Source/Core/DolphinNoGUI/PS4Controls.cpp
@@ -0,0 +1,403 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "DolphinNoGUI/PS4Controls.h"
+
+#include <cstdio>
+#include <string>
+#include <tuple>
+#include <sys/stat.h>
+
+#include <orbis/Pad.h>
+
+#include "Common/IniFile.h"
+
+namespace PS4Controls
+{
+namespace
+{
+constexpr char GCPAD_DEFAULTS[] = R"([GCPad1]
+Device = PS4/0/DualShock 4
+Buttons/A = Cross
+Buttons/B = Square
+Buttons/X = Circle
+Buttons/Y = Triangle
+Buttons/Z = R1
+Buttons/Start = Options
+Main Stick/Up = `Left Y-`
+Main Stick/Down = `Left Y+`
+Main Stick/Left = `Left X-`
+Main Stick/Right = `Left X+`
+C-Stick/Up = `Right Y-`
+C-Stick/Down = `Right Y+`
+C-Stick/Left = `Right X-`
+C-Stick/Right = `Right X+`
+Triggers/L = L2
+Triggers/R = R2
+Triggers/L-Analog = L2
+Triggers/R-Analog = R2
+D-Pad/Up = `Pad N`
+D-Pad/Down = `Pad S`
+D-Pad/Left = `Pad W`
+D-Pad/Right = `Pad E`
+Rumble/Motor = `Motor L`
+)";
+
+constexpr char WIIMOTE_DEFAULTS[] = R"([Wiimote1]
+Device = PS4/0/DualShock 4
+Buttons/A = Cross
+Buttons/B = R2
+Buttons/1 = Square
+Buttons/2 = Triangle
+Buttons/- = L1
+Buttons/+ = Options
+Buttons/Home = Touchpad
+D-Pad/Up = `Pad N`
+D-Pad/Down = `Pad S`
+D-Pad/Left = `Pad W`
+D-Pad/Right = `Pad E`
+IR/Up = `Right Y-`
+IR/Down = `Right Y+`
+IR/Left = `Right X-`
+IR/Right = `Right X+`
+Shake/X = R3
+Shake/Y = R3
+Shake/Z = R3
+Rumble/Motor = `Motor L`
+Extension = Nunchuk
+Nunchuk/Buttons/C = L1
+Nunchuk/Buttons/Z = L2
+Nunchuk/Stick/Up = `Left Y-`
+Nunchuk/Stick/Down = `Left Y+`
+Nunchuk/Stick/Left = `Left X-`
+Nunchuk/Stick/Right = `Left X+`
+)";
+
+const std::vector<Binding> GC_BINDINGS = {
+    {"Buttons/A", "A", false},
+    {"Buttons/B", "B", false},
+    {"Buttons/X", "X", false},
+    {"Buttons/Y", "Y", false},
+    {"Buttons/Z", "Z", false},
+    {"Buttons/Start", "Start", false},
+    {"Triggers/L", "L (click)", false},
+    {"Triggers/R", "R (click)", false},
+    {"Triggers/L-Analog", "L (analog)", false},
+    {"Triggers/R-Analog", "R (analog)", false},
+    {"Main Stick", "Control Stick", true},
+    {"C-Stick", "C-Stick", true},
+    {"D-Pad/Up", "D-Pad Up", false},
+    {"D-Pad/Down", "D-Pad Down", false},
+    {"D-Pad/Left", "D-Pad Left", false},
+    {"D-Pad/Right", "D-Pad Right", false},
+};
+
+const std::vector<Binding> WII_BINDINGS = {
+    {"Buttons/A", "A", false},
+    {"Buttons/B", "B", false},
+    {"Buttons/1", "1", false},
+    {"Buttons/2", "2", false},
+    {"Buttons/-", "- (Minus)", false},
+    {"Buttons/+", "+ (Plus)", false},
+    {"Buttons/Home", "Home", false},
+    {"Shake", "Shake (spin)", false},
+    {"IR", "Pointer", true},
+    {"D-Pad/Up", "D-Pad Up", false},
+    {"D-Pad/Down", "D-Pad Down", false},
+    {"D-Pad/Left", "D-Pad Left", false},
+    {"D-Pad/Right", "D-Pad Right", false},
+    {"Nunchuk/Buttons/C", "Nunchuk C", false},
+    {"Nunchuk/Buttons/Z", "Nunchuk Z", false},
+    {"Nunchuk/Stick", "Nunchuk Stick", true},
+};
+
+std::string s_user_dir = "/data/DolphinPS4/User";
+
+std::string Path(Device device)
+{
+  return s_user_dir + (device == Device::GameCube ? "/Config/GCPadNew.ini" :
+                                                    "/Config/WiimoteNew.ini");
+}
+
+const char* Section(Device device)
+{
+  return device == Device::GameCube ? "GCPad1" : "Wiimote1";
+}
+
+// The four directions of a stick group, for each choice.
+struct StickChoice
+{
+  const char* name;
+  const char* up;
+  const char* down;
+  const char* left;
+  const char* right;
+};
+constexpr StickChoice STICKS[] = {
+    {"Left Stick", "`Left Y-`", "`Left Y+`", "`Left X-`", "`Left X+`"},
+    {"Right Stick", "`Right Y-`", "`Right Y+`", "`Right X-`", "`Right X+`"},
+    {"D-Pad", "`Pad N`", "`Pad S`", "`Pad W`", "`Pad E`"},
+};
+
+void WriteIfMissing(const std::string& path, const char* contents)
+{
+  struct stat st;
+  if (stat(path.c_str(), &st) == 0)
+    return;
+  if (FILE* file = fopen(path.c_str(), "w"))
+  {
+    fputs(contents, file);
+    fclose(file);
+  }
+}
+
+std::string Strip(std::string text)
+{
+  std::string out;
+  for (char c : text)
+  {
+    if (c != '`')
+      out += c;
+  }
+  return out;
+}
+}  // namespace
+
+const std::vector<Binding>& Bindings(Device device)
+{
+  return device == Device::GameCube ? GC_BINDINGS : WII_BINDINGS;
+}
+
+const char* DefaultsText(Device device)
+{
+  return device == Device::GameCube ? GCPAD_DEFAULTS : WIIMOTE_DEFAULTS;
+}
+
+const char* DeviceName(Device device)
+{
+  return device == Device::GameCube ? "GameCube Controller" : "Wii Remote + Nunchuk";
+}
+
+void SetUserDirectory(const std::string& user_dir)
+{
+  s_user_dir = user_dir;
+}
+
+void WriteDefaultsIfMissing()
+{
+  mkdir(s_user_dir.c_str(), 0777);
+  mkdir((s_user_dir + "/Config").c_str(), 0777);
+  WriteIfMissing(Path(Device::GameCube), GCPAD_DEFAULTS);
+  WriteIfMissing(Path(Device::Wii), WIIMOTE_DEFAULTS);
+  // The GameCube L / R clicks came from the DualShock 4's digital L2 / R2, which switch on early
+  // in the pull; Dolphin then reports the analog trigger as fully pressed (MixedTriggers), so half
+  // a press was a full one. Driven by the analog triggers instead, they click at Dolphin's
+  // threshold (90%) and the analog value follows the trigger until then. Older files are
+  // updated where they still have the old default.
+  {
+    Common::IniFile ini;
+    ini.Load(Path(Device::GameCube));
+    Common::IniFile::Section* section = ini.GetOrCreateSection(Section(Device::GameCube));
+    bool changed = false;
+    for (const auto& [key, old_value, new_value] :
+         {std::tuple{"Triggers/L", "`L2 Click`", "L2"}, std::tuple{"Triggers/R", "`R2 Click`", "R2"}})
+    {
+      std::string value;
+      if (section->Get(key, &value) && value == old_value)
+      {
+        section->Set(key, std::string(new_value));
+        changed = true;
+      }
+    }
+    if (changed)
+      ini.Save(Path(Device::GameCube));
+  }
+  SyncPlayers(Device::GameCube);
+  SyncPlayers(Device::Wii);
+}
+
+std::string Get(Device device, const Binding& binding)
+{
+  Common::IniFile ini;
+  ini.Load(Path(device));
+  Common::IniFile::Section* section = ini.GetOrCreateSection(Section(device));
+  std::string value;
+  if (binding.stick_group)
+  {
+    std::string up, left;
+    section->Get(std::string(binding.key) + "/Up", &up);
+    section->Get(std::string(binding.key) + "/Left", &left);
+    for (const StickChoice& choice : STICKS)
+    {
+      if (up == choice.up && left == choice.left)
+        return choice.name;
+    }
+    return "Custom";
+  }
+  const std::string key = std::string(binding.key) == "Shake" ? "Shake/X" : binding.key;
+  section->Get(key, &value);
+  return value;
+}
+
+std::string Describe(const std::string& expression)
+{
+  const std::string name = Strip(expression);
+  if (name.empty())
+    return "None";
+  struct Name
+  {
+    const char* raw;
+    const char* shown;
+  };
+  constexpr Name NAMES[] = {
+      {"Pad N", "D-Pad Up"},           {"Pad S", "D-Pad Down"},
+      {"Pad W", "D-Pad Left"},         {"Pad E", "D-Pad Right"},
+      {"Left Y-", "Left Stick Up"},    {"Left Y+", "Left Stick Down"},
+      {"Left X-", "Left Stick Left"},  {"Left X+", "Left Stick Right"},
+      {"Right Y-", "Right Stick Up"},  {"Right Y+", "Right Stick Down"},
+      {"Right X-", "Right Stick Left"}, {"Right X+", "Right Stick Right"},
+      {"L2 Click", "L2"},              {"R2 Click", "R2"},
+      {"L2", "L2 (analog)"},           {"R2", "R2 (analog)"},
+  };
+  for (const Name& n : NAMES)
+  {
+    if (name == n.raw)
+      return n.shown;
+  }
+  return name;
+}
+
+void Set(Device device, const Binding& binding, const std::string& expression)
+{
+  Common::IniFile ini;
+  ini.Load(Path(device));
+  Common::IniFile::Section* section = ini.GetOrCreateSection(Section(device));
+  if (binding.stick_group)
+  {
+    for (const StickChoice& choice : STICKS)
+    {
+      if (expression != choice.name)
+        continue;
+      const std::string prefix = binding.key;
+      section->Set(prefix + "/Up", std::string(choice.up));
+      section->Set(prefix + "/Down", std::string(choice.down));
+      section->Set(prefix + "/Left", std::string(choice.left));
+      section->Set(prefix + "/Right", std::string(choice.right));
+    }
+  }
+  else if (std::string(binding.key) == "Shake")
+  {
+    section->Set("Shake/X", expression);
+    section->Set("Shake/Y", expression);
+    section->Set("Shake/Z", expression);
+  }
+  else
+  {
+    section->Set(binding.key, expression);
+  }
+  ini.Save(Path(device));
+  SyncPlayers(device);
+}
+
+std::vector<std::string> StickChoices()
+{
+  std::vector<std::string> choices;
+  for (const StickChoice& choice : STICKS)
+    choices.push_back(choice.name);
+  return choices;
+}
+
+void ResetToDefault(Device device)
+{
+  if (FILE* file = fopen(Path(device).c_str(), "w"))
+  {
+    fputs(DefaultsText(device), file);
+    fclose(file);
+  }
+  SyncPlayers(device);
+}
+
+void SetWiiAttachment(const std::string& extension, bool sideways)
+{
+  Common::IniFile ini;
+  ini.Load(Path(Device::Wii));
+  Common::IniFile::Section* section = ini.GetOrCreateSection(Section(Device::Wii));
+  section->Set("Extension", std::string(extension == "none" ? "None" : "Nunchuk"));
+  section->Set("Options/Sideways Wiimote", std::string(sideways ? "True" : "False"));
+  ini.Save(Path(Device::Wii));
+  SyncPlayers(Device::Wii);
+}
+
+void SyncPlayers(Device device)
+{
+  Common::IniFile ini;
+  ini.Load(Path(device));
+  const Common::IniFile::Section* first = ini.GetSection(Section(device));
+  if (!first)
+    return;
+  const auto values = first->GetValues();  // a copy: the sections below are rewritten
+  const std::string base = device == Device::GameCube ? "GCPad" : "Wiimote";
+  for (int player = 2; player <= 4; player++)
+  {
+    const std::string name = base + std::to_string(player);
+    ini.DeleteSection(name);
+    Common::IniFile::Section* section = ini.GetOrCreateSection(name);
+    for (const auto& [key, value] : values)
+      section->Set(key, value);
+    section->Set("Device", "PS4/" + std::to_string(player - 1) + "/DualShock 4");
+  }
+  ini.Save(Path(device));
+}
+
+bool IsAtRest(const OrbisPadData& now)
+{
+  auto centred = [](uint8_t v) { return v > 78 && v < 178; };
+  return now.buttons == 0 && now.analogButtons.l2 < 40 && now.analogButtons.r2 < 40 &&
+         centred(now.leftStick.x) && centred(now.leftStick.y) && centred(now.rightStick.x) &&
+         centred(now.rightStick.y);
+}
+
+std::string Capture(const OrbisPadData& now, bool for_analog_trigger)
+{
+  struct ButtonName
+  {
+    uint32_t bit;
+    const char* name;
+  };
+  constexpr ButtonName BUTTONS[] = {
+      {ORBIS_PAD_BUTTON_CROSS, "Cross"},       {ORBIS_PAD_BUTTON_CIRCLE, "Circle"},
+      {ORBIS_PAD_BUTTON_SQUARE, "Square"},     {ORBIS_PAD_BUTTON_TRIANGLE, "Triangle"},
+      {ORBIS_PAD_BUTTON_L1, "L1"},             {ORBIS_PAD_BUTTON_R1, "R1"},
+      {ORBIS_PAD_BUTTON_L3, "L3"},             {ORBIS_PAD_BUTTON_R3, "R3"},
+      {ORBIS_PAD_BUTTON_OPTIONS, "Options"},   {ORBIS_PAD_BUTTON_TOUCH_PAD, "Touchpad"},
+      {ORBIS_PAD_BUTTON_UP, "`Pad N`"},        {ORBIS_PAD_BUTTON_DOWN, "`Pad S`"},
+      {ORBIS_PAD_BUTTON_LEFT, "`Pad W`"},      {ORBIS_PAD_BUTTON_RIGHT, "`Pad E`"},
+  };
+  if ((now.buttons & ORBIS_PAD_BUTTON_L2) || now.analogButtons.l2 > 180)
+    return for_analog_trigger ? "L2" : "`L2 Click`";
+  if ((now.buttons & ORBIS_PAD_BUTTON_R2) || now.analogButtons.r2 > 180)
+    return for_analog_trigger ? "R2" : "`R2 Click`";
+  for (const ButtonName& button : BUTTONS)
+  {
+    if (now.buttons & button.bit)
+      return button.name;
+  }
+  if (now.leftStick.x < 40)
+    return "`Left X-`";
+  if (now.leftStick.x > 215)
+    return "`Left X+`";
+  if (now.leftStick.y < 40)
+    return "`Left Y-`";
+  if (now.leftStick.y > 215)
+    return "`Left Y+`";
+  if (now.rightStick.x < 40)
+    return "`Right X-`";
+  if (now.rightStick.x > 215)
+    return "`Right X+`";
+  if (now.rightStick.y < 40)
+    return "`Right Y-`";
+  if (now.rightStick.y > 215)
+    return "`Right Y+`";
+  return {};
+}
+}  // namespace PS4Controls
diff --git a/Source/Core/DolphinNoGUI/PS4Controls.h b/Source/Core/DolphinNoGUI/PS4Controls.h
new file mode 100755
index 0000000..76fb2d3
--- /dev/null
+++ b/Source/Core/DolphinNoGUI/PS4Controls.h
@@ -0,0 +1,59 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// PS4 controller mappings: the DualShock 4 as a GameCube controller (User/Config/GCPadNew.ini)
+// and as a Wii Remote with a Nunchuk (User/Config/WiimoteNew.ini), in Dolphin's own format.
+// The XMB remaps them; the defaults are the port's tuned layout.
+
+#pragma once
+
+#include <string>
+#include <vector>
+
+struct OrbisPadData;
+
+namespace PS4Controls
+{
+enum class Device
+{
+  GameCube,
+  Wii,
+};
+
+// One mappable input. A stick group ("Main Stick") maps all four directions to one DualShock 4
+// stick or the D-pad at once; the others take a single button, trigger or stick direction.
+struct Binding
+{
+  const char* key;    // Dolphin's key ("Buttons/A"); for a stick group the key prefix
+  const char* label;  // shown in the menus
+  bool stick_group;
+};
+
+const std::vector<Binding>& Bindings(Device device);
+const char* DefaultsText(Device device);  // the default INI file contents
+const char* DeviceName(Device device);
+
+// user_dir: /data/DolphinPS4/User
+void SetUserDirectory(const std::string& user_dir);
+// Writes the default files if they don't exist yet.
+void WriteDefaultsIfMissing();
+
+// The binding's expression ("Cross", "`Left X-`") and how it's shown ("Cross", "Left Stick Left").
+std::string Get(Device device, const Binding& binding);
+std::string Describe(const std::string& expression);
+void Set(Device device, const Binding& binding, const std::string& expression);
+// Stick groups: "Left Stick", "Right Stick" or "D-Pad".
+std::vector<std::string> StickChoices();
+void ResetToDefault(Device device);
+// The Wii Remote's extension ("nunchuk" or "none") and sideways orientation.
+void SetWiiAttachment(const std::string& extension, bool sideways);
+// Players 2-4 (GCPad2-4, Wiimote2-4): player 1's mapping, each on their own DualShock 4
+// ("PS4/<player - 1>/DualShock 4"). Done after every change to player 1's mapping.
+void SyncPlayers(Device device);
+
+// Capture: the expression for the first input that differs from the resting state (a button
+// pressed, a trigger pulled or a stick pushed), or empty if nothing is pressed yet.
+std::string Capture(const OrbisPadData& now, bool for_analog_trigger);
+// True when nothing on the pad is pressed (to wait before a capture).
+bool IsAtRest(const OrbisPadData& now);
+}  // namespace PS4Controls
diff --git a/Source/Core/DolphinNoGUI/PS4Covers.cpp b/Source/Core/DolphinNoGUI/PS4Covers.cpp
