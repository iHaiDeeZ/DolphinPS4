+void Menu::BuildControlRows()
+{
+  const auto device = static_cast<PS4Controls::Device>(m_controls_device);
+  std::vector<SettingRow> rows;
+  const auto& bindings = PS4Controls::Bindings(device);
+  for (size_t i = 0; i < bindings.size(); i++)
+  {
+    const std::string value = PS4Controls::Get(device, bindings[i]);
+    SettingRow row{bindings[i].label,
+                   bindings[i].stick_group ? value : PS4Controls::Describe(value),
+                   "ctl:" + std::to_string(i)};
+    row.glyph = value;
+    rows.push_back(std::move(row));
+  }
+  rows.push_back({"", "", "", true});
+  rows.push_back({"Reset to Default", "", "__ctlreset__"});
+  m_panel.rows = std::move(rows);
+}
+
+void Menu::OpenCheatsList(const Game& game)
+{
+  m_panel = {};
+  m_panel.open = true;
+  m_panel.title = "Cheats";
+  m_cheats_game = game.id;
+  m_cheats.Load(game.id, game.revision);
+  BuildCheatRows();
+  if (m_panel.rows.empty())
+    m_panel.lines = {"", "No cheats for this game.", "",
+                     "Dolphin's cheat database has none for " + game.id + "."};
+  m_panel.selected = 0;
+  MoveSettingRow(0);
+}
+
+void Menu::BuildCheatRows()
+{
+  std::vector<SettingRow> rows;
+  const auto entries = m_cheats.Entries();
+  if (!entries.empty())
+  {
+    rows.push_back({"Enable All", "", "cheatall:on"});
+    rows.push_back({"Disable All", "", "cheatall:off"});
+  }
+  bool last_gecko = false;
+  for (size_t i = 0; i < entries.size(); i++)
+  {
+    if (i == 0 || entries[i].gecko != last_gecko)
+      rows.push_back({entries[i].gecko ? "Gecko Codes" : "Action Replay Codes", "", "", true});
+    last_gecko = entries[i].gecko;
+    SettingRow row{entries[i].name, "", "cheat:" + std::to_string(i)};
+    row.tag = entries[i].enabled ? 1 : -1;
+    rows.push_back(std::move(row));
+  }
+  m_panel.rows = std::move(rows);
+}
+
+// A button capture for the selected controls row: waits until the pad is at rest, then takes the
+// next press (5 s without one cancels).
+void Menu::UpdateCapture(float dt)
+{
+  if (!m_capture)
+    return;
+  m_capture_time += dt;
+  OrbisPadData data = {};
+  if (!m_input.Raw(&data))
+    return;
+  if (!m_capture_released)
+  {
+    m_capture_released = PS4Controls::IsAtRest(data);
+    return;
+  }
+  if (m_capture_time > 5.0f)
+  {
+    m_capture = false;
+    Play("back");
+    return;
+  }
+  const auto device = static_cast<PS4Controls::Device>(m_controls_device);
+  const std::string& key = m_panel.rows[m_capture_row].key;
+  const auto& binding = PS4Controls::Bindings(device)[std::atoi(key.c_str() + 4)];
+  const bool analog = std::string(binding.key).rfind("Triggers/", 0) == 0;
+  const std::string expression = PS4Controls::Capture(data, analog);
+  if (expression.empty())
+    return;
+  PS4Controls::Set(device, binding, expression);
+  BuildControlRows();
+  m_capture = false;
+  // Swallow the press: the menu sees the pad again once it is released.
+  m_input.Poll(0.0f);
+  Play("confirm");
+}
+
+void Menu::StartCoverDownload()
+{
+  if (m_cover_thread.joinable())
+    return;  // already running
+  m_cover_cancel = false;
+  m_cover_done = false;
+  {
+    std::lock_guard lock(m_cover_mutex);
+    m_cover_status = "Connecting to GameTDB...";
+  }
+  std::vector<std::string> ids;
+  for (const Game& game : m_games)
+    ids.push_back(game.id);
+  m_cover_thread = std::thread([this, ids] {
+    const PS4Covers::Result result = PS4Covers::Download(
+        ids, m_data_dir + "/covers", m_assets_dir + "/xmb/cacert.pem",
+        [this](int done, int total, const std::string& id) {
+          std::lock_guard lock(m_cover_mutex);
+          m_cover_status = id.empty() ? "Finishing..." :
+                                        "Downloading " + std::to_string(done + 1) + " of " +
+                                            std::to_string(total) + ": " + id;
+        },
+        m_cover_cancel);
+    std::lock_guard lock(m_cover_mutex);
+    m_cover_result = result;
+    m_cover_done = true;
+  });
+}
+
+// Shows the download's progress in the panel; at the end, loads the new covers.
+void Menu::UpdateCoverDownload()
+{
+  if (!m_cover_thread.joinable())
+    return;
+  std::string status;
+  {
+    std::lock_guard lock(m_cover_mutex);
+    status = m_cover_status;
+  }
+  if (!m_cover_done)
+  {
+    if (m_panel.open && m_panel.setting == SET_COVERS)
+      m_panel.lines = {"", status, "", "Circle closes this; the download goes on."};
+    return;
+  }
+  m_cover_thread.join();
+  const PS4Covers::Result result = m_cover_result;
+  LoadCovers();
+  Log("covers: " + std::to_string(result.downloaded) + " downloaded, " +
+      std::to_string(result.already) + " already there, " + std::to_string(result.not_found) +
+      " not on GameTDB, " + std::to_string(result.failed) + " failed " + result.error);
+  if (m_panel.open && m_panel.setting == SET_COVERS)
+  {
+    m_panel.lines = {"",
+                     "Downloaded: " + std::to_string(result.downloaded),
+                     "Already there: " + std::to_string(result.already),
+                     "Not on GameTDB: " + std::to_string(result.not_found)};
+    if (result.failed > 0)
+    {
+      m_panel.lines.push_back("Failed: " + std::to_string(result.failed));
+      m_panel.lines.push_back(result.error);
+    }
+    m_panel.lines.push_back("");
+    m_panel.lines.push_back("Your own pictures: " + m_data_dir + "/covers/<GAMEID>.png");
+  }
+  if (m_panel.open && m_panel.setting == SET_COVERS)
+    Play(result.failed > 0 ? "error" : "confirm");
+}
+
+// Box art: data_dir/covers/<game ID>.png (downloaded or the user's own).
+void Menu::LoadCovers()
+{
+  for (Game& game : m_games)
+  {
+    if (game.id.empty())
+      continue;
+    if (game.cover != ImTextureID{})
+      continue;
+    float aspect = 0.7f;
+    const ImTextureID cover = LoadPngTexture(m_data_dir + "/covers/" + game.id + ".png", &aspect);
+    if (cover != ImTextureID{})
+    {
+      game.cover = cover;
+      game.cover_aspect = aspect;
+    }
+  }
+}
+
+void Menu::ApplySettingOption(int setting, int option)
+{
+  switch (setting)
+  {
+  case SET_SOUNDS:
+    m_prefs.sounds = option == 0;
+    break;
+  case SET_VOLUME:
+    m_prefs.volume = 100 - option * 10;
+    break;
+  case SET_CLOCK:
+    m_prefs.clock = option == 0;
+    break;
+  case SET_AUTO_UPDATE:
+    m_prefs.auto_update = option == 0;
+    break;
+  case SET_RESET_ALL:
+    if (option == 1)
+      PS4Settings::ResetAll();
+    return;
+  case SET_CONTROLS:
+    OpenControlsList(option == 0 ? PS4Controls::Device::GameCube : PS4Controls::Device::Wii);
+    return;
+  default:
+    return;
+  }
+  ApplyPreferences();
+  BuildItems();
+}
+
+void Menu::HandleInput(uint32_t pressed)
+{
+  if (m_launch >= 0 || pressed == 0)
+    return;
+
+  if (m_capture)
+    return;  // a button capture takes the pad (UpdateCapture)
+  if (m_panel.open)
+  {
+    if (pressed & BTN_CIRCLE)
+    {
+      if (m_panel.setting == SET_UPDATE && m_update_state == UpdateState::Downloading)
+        m_update_cancel = true;
+      if (m_panel.setting == SET_UPDATE && m_update_state == UpdateState::Finished)
+        return;  // the app is closing for the install
+      m_controls_device = -1;
+      m_panel.open = false;
+      Play("back");
+      return;
+    }
+    if (!m_panel.rows.empty())
+    {
+      // Settings list: Up/Down pick, Left/Right (or Cross) change the value.
+      if (pressed & BTN_UP)
+      {
+        MoveSettingRow(-1);
+        Play("move");
+      }
+      if (pressed & BTN_DOWN)
+      {
+        MoveSettingRow(1);
+        Play("move");
+      }
+      if (pressed & (BTN_LEFT | BTN_RIGHT | BTN_CROSS))
+      {
+        ChangeSettingRow((pressed & BTN_LEFT) ? -1 : 1);
+        Play("category");
+      }
+      return;
+    }
+    if (m_panel.options.empty())
+    {
+      if (pressed & BTN_CROSS)
+      {
+        m_panel.open = false;
+        Play("back");
+      }
+      return;
+    }
+    const int count = static_cast<int>(m_panel.options.size());
+    if ((pressed & BTN_UP) && m_panel.selected > 0)
+    {
+      m_panel.selected--;
+      Play("move");
+    }
+    if ((pressed & BTN_DOWN) && m_panel.selected < count - 1)
+    {
+      m_panel.selected++;
+      Play("move");
+    }
+    if ((pressed & BTN_CROSS) && m_panel.setting == SET_UPDATE)
+    {
+      const std::string& choice = m_panel.options[m_panel.selected];
+      if (choice == "Yes")
+      {
+        StartUpdateDownload();
+        Play("confirm");
+      }
+      else if (choice == "Cancel")
+      {
+        m_update_cancel = true;
+        Play("back");
+      }
+      else if (choice == "OK" && m_update_state == UpdateState::Finished)
+      {
+        m_update_close_in = 0.0f;
+        Play("confirm");
+      }
+      else
+      {
+        m_panel.open = false;
+        Play("back");
+      }
+      return;
+    }
+    if (pressed & BTN_CROSS)
+    {
+      if (m_panel.setting == SET_CONTROLS)
+      {
+        ApplySettingOption(m_panel.setting, m_panel.selected);
+        Play("confirm");
+        return;
+      }
+      if (m_panel.setting >= 0)
+      {
+        ApplySettingOption(m_panel.setting, m_panel.selected);
+      }
+      else if (m_panel.title == "Game" && m_panel.selected == 0)
+      {
+        m_panel.open = false;
+        HandleInput(BTN_CROSS);  // start it, as Cross on the game does
+        return;
+      }
+      else if (m_panel.title == "Game" && m_panel.selected == 1)
+      {
+        const Item& item = m_items[m_category][m_selected[m_category]];
+        OpenSettingsList({}, m_games[item.game].id);
+        Play("confirm");
+        return;
+      }
+      else if (m_panel.title == "Game" && m_panel.selected == 2)
+      {
+        const Item& item = m_items[m_category][m_selected[m_category]];
+        OpenCheatsList(m_games[item.game]);
+        Play("confirm");
+        return;
+      }
+      else if (m_panel.title == "Game" && m_panel.selected == 3)
+      {
+        const Item& item = m_items[m_category][m_selected[m_category]];
+        const Game& game = m_games[item.game];
+        m_panel.title = "Information";
+        m_panel.options.clear();
+        m_panel.lines = {game.title,
+                         "",
+                         std::string("Platform: ") + (game.wii ? "Wii" : "GameCube"),
+                         "Game ID: " + game.id,
+                         "Discs: " + std::to_string(game.discs),
+                         "File: " + std::filesystem::path(game.path).filename().string()};
+        Play("confirm");
+        return;
+      }
+      m_panel.open = false;
+      Play("confirm");
+    }
+    return;
+  }
+
+  auto& items = m_items[m_category];
+  int& selected = m_selected[m_category];
+  if ((pressed & BTN_LEFT) && m_category > 0)
+  {
+    m_category--;
+    Play("category");
+  }
+  else if ((pressed & BTN_RIGHT) && m_category < CATEGORY_COUNT - 1)
+  {
+    m_category++;
+    Play("category");
+  }
+  else if ((pressed & BTN_UP) && selected > 0)
+  {
+    selected--;
+    Play("move");
+  }
+  else if ((pressed & BTN_DOWN) && selected < static_cast<int>(items.size()) - 1)
+  {
+    selected++;
+    Play("move");
+  }
+  else if ((pressed & BTN_L1) && selected > 0)
+  {
+    selected = std::max(0, selected - 5);
+    Play("move");
+  }
+  else if ((pressed & BTN_R1) && selected < static_cast<int>(items.size()) - 1)
+  {
+    selected = std::min(static_cast<int>(items.size()) - 1, selected + 5);
+    Play("move");
+  }
+  else if (pressed & BTN_CROSS)
+  {
+    if (items.empty())
+      return;
+    const Item& item = items[selected];
+    if (item.game >= 0)
+    {
+      m_launch = item.game;
+      m_launch_time = 0.0f;
+      m_prefs.last_game = m_games[item.game].path;
+      m_prefs.Save(m_data_dir + "/xmb.ini");
+      Play("launch");
+    }
+    else if (item.setting >= 0)
+    {
+      OpenSettingPanel(item.setting);
+      Play("menu");
+    }
+    else if (item.theme != -1)
+    {
+      if (item.theme >= 0)
+      {
+        m_prefs.theme = THEMES[item.theme].name;
+        m_prefs.wallpaper.clear();
+      }
+      else
+      {
+        m_prefs.wallpaper = m_wallpapers[-2 - item.theme];
+      }
+      ApplyPreferences();
+      BuildItems();
+      Play("confirm");
+    }
+    else
+    {
+      Play("error");
+    }
+  }
+  else if ((pressed & BTN_SQUARE) && m_category == static_cast<int>(Category::Games))
+  {
+    RefreshGames();
+    Play("confirm");
+  }
+  else if (pressed & BTN_TRIANGLE)
+  {
+    if (!items.empty() && items[selected].game >= 0)
+    {
+      m_panel = {};
+      m_panel.open = true;
+      m_panel.title = "Game";
+      m_panel.options = {"Start", "Game Settings", "Cheats", "Information"};
+      Play("menu");
+    }
+  }
+  else if (pressed & BTN_CIRCLE)
+  {
+    Play("back");
+  }
+}
