+// ---------------------------------------------------------------------------------------------
+// Play Online (Wiimmfi): the Wiimmfi Patcher (Open Shop Channel) runs with the game's disc in the
+// drive; it patches the game to use Wiimmfi's servers and starts it.
+
+void Menu::StartWiimmfiDownload()
+{
+  if (m_wiimmfi_thread.joinable())
+    return;
+  m_wiimmfi_busy = true;
+  m_wiimmfi_error.clear();
+  const std::string ca = m_assets_dir + "/xmb/cacert.pem";
+  const std::string target = WiimmfiPatcherPath();
+  m_wiimmfi_thread = std::thread([this, ca, target] {
+    std::vector<uint8_t> zip;
+    PS4Net::Request request;
+    request.url = "https://hbb1.oscwii.org/api/contents/wiimmfipatcher/wiimmfipatcher.zip";
+    request.ca_file = ca;
+    request.timeout_seconds = 60;
+    std::string error;
+    const long status = PS4Net::Get(
+        request,
+        [&](const char* data, size_t size) {
+          zip.insert(zip.end(), data, data + size);
+          return zip.size() < 16 * 1024 * 1024;
+        },
+        {}, &error);
+    std::string problem;
+    if (status != 200 || zip.empty())
+    {
+      problem = "Download failed: " + (error.empty() ? "HTTP " + std::to_string(status) : error);
+    }
+    else
+    {
+      void* reader = mz_zip_reader_create();
+      std::vector<uint8_t> dol;
+      if (mz_zip_reader_open_buffer(reader, zip.data(), static_cast<int32_t>(zip.size()), 0) ==
+              MZ_OK &&
+          mz_zip_reader_locate_entry(reader, "apps/wiimmfipatcher/boot.dol", 1) == MZ_OK)
+      {
+        mz_zip_file* info = nullptr;
+        if (mz_zip_reader_entry_get_info(reader, &info) == MZ_OK && info &&
+            info->uncompressed_size > 0 && info->uncompressed_size < 8 * 1024 * 1024)
+        {
+          dol.resize(static_cast<size_t>(info->uncompressed_size));
+          if (!Common::ReadFileFromZip(reader, &dol))
+            dol.clear();
+        }
+      }
+      mz_zip_reader_close(reader);
+      mz_zip_reader_delete(&reader);
+      if (dol.empty())
+      {
+        problem = "The download has no apps/wiimmfipatcher/boot.dol";
+      }
+      else
+      {
+        File::CreateFullPath(target);
+        if (!File::WriteStringToFile(target, std::string(dol.begin(), dol.end())))
+          problem = "Couldn't save " + target;
+      }
+    }
+    m_wiimmfi_error = problem;
+    m_wiimmfi_busy = false;
+  });
+}
+
+void Menu::UpdateWiimmfiDownload()
+{
