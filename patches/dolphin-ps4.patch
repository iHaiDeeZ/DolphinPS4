+    std::lock_guard lock(s_flip_mutex);
+    s_flip_queue_items.push_back({ac_ps4_last_submission(), static_cast<u32>(image_index),
+                                  static_cast<int>(mode), static_cast<s64>(arg)});
+  }
+  s_flip_cv.notify_one();
+}
