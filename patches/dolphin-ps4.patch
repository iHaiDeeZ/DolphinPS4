+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// PS4 launcher (XMB) display: a minimal Vulkan renderer on Mesa's RADV (linked in) that draws
+// Dear ImGui into three 1920x1080 linear images registered with VideoOut, flipped behind the
+// GPU work like Dolphin's own PS4 swap chain (VideoBackends/Vulkan/VKSwapChain.cpp).
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+#include <imgui.h>
+
+namespace PS4XMB
+{
+class Display
+{
+public:
+  static constexpr uint32_t WIDTH = 1920;
+  static constexpr uint32_t HEIGHT = 1080;
+
+  // Creates the Vulkan device, the VideoOut buffers and ImGui's renderer; ImGui's context must
+  // exist. Returns false (and logs) on failure.
+  bool Initialize();
+  void Shutdown();
+
+  void BeginFrame();
+  // Renders ImGui's draw data and queues the flip.
+  void EndFrame();
+
+  // An RGBA8 texture for ImGui::Image / ImDrawList::AddImage (0 on failure).
+  ImTextureID CreateTexture(const void* rgba, uint32_t width, uint32_t height);
+  void DestroyTexture(ImTextureID texture);
+};
+}  // namespace PS4XMB
