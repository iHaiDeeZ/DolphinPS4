+    snprintf(line, sizeof(line), "vk present %d: image %u, %s flip %llu\n", s_traced, image_index,
+             gpu_flip ? "GPU-side" : "CPU", static_cast<unsigned long long>(s_flips_submitted));
+    ps4_boot_trace(line);
+    s_traced++;
+  }
