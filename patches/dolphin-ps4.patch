+#ifdef __ORBIS__
+// FPS / speed counter for the PS4 port, drawn into the bound backbuffer with scissored clears
+// (no shaders, textures or fonts involved): seven-segment digits, the FPS in white and the
+// emulation speed in percent in yellow. Restores the state it touches.
+extern "C" void ps4_draw_counter(int width, int height, float fps, float speed_percent)
+{
+  GLint box[4] = {};
+  GLfloat clear[4] = {};
+  GLboolean mask[4] = {};
+  const GLboolean scissor = glIsEnabled(GL_SCISSOR_TEST);
+  glGetIntegerv(GL_SCISSOR_BOX, box);
+  glGetFloatv(GL_COLOR_CLEAR_VALUE, clear);
+  glGetBooleanv(GL_COLOR_WRITEMASK, mask);
+  glEnable(GL_SCISSOR_TEST);
+  glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+
+  const auto rect = [height](int x, int y, int w, int h, float r, float g, float b) {
+    glScissor(x, height - y - h, w, h);
+    glClearColor(r, g, b, 1.0f);
+    glClear(GL_COLOR_BUFFER_BIT);
+  };
+  // Segments a..g: top, top right, bottom right, bottom, bottom left, top left, middle.
+  static constexpr u8 digits[10] = {0x3F, 0x06, 0x5B, 0x4F, 0x66, 0x6D, 0x7D, 0x07, 0x7F, 0x6F};
+  const int u = std::max(2, height / 200);  // segment thickness
+  const int dw = 4 * u, dh = 7 * u, advance = dw + 2 * u;
+
+  char fps_text[16], speed_text[16];
+  snprintf(fps_text, sizeof(fps_text), "%.1f", fps);
+  snprintf(speed_text, sizeof(speed_text), "%d", static_cast<int>(speed_percent + 0.5f));
+  const int chars = static_cast<int>(std::strlen(fps_text) + std::strlen(speed_text)) + 1;
+  const int x0 = 6 * u, y0 = 6 * u;
+  rect(x0 - 2 * u, y0 - 2 * u, chars * advance + 3 * u, dh + 4 * u, 0.0f, 0.0f, 0.0f);
+
+  int x = x0;
+  const auto draw_text = [&](const char* text, float r, float g, float b) {
+    for (const char* c = text; *c; c++, x += advance)
+    {
+      if (*c == '.')
+      {
+        rect(x + u, y0 + dh - u, u, u, r, g, b);
+        x -= advance / 2;
+        continue;
+      }
+      if (*c < '0' || *c > '9')
+        continue;
+      const u8 s = digits[*c - '0'];
+      const int half = dh / 2;
+      if (s & 0x01) rect(x, y0, dw, u, r, g, b);                     // a
+      if (s & 0x02) rect(x + dw - u, y0, u, half + 1, r, g, b);      // b
+      if (s & 0x04) rect(x + dw - u, y0 + half, u, dh - half, r, g, b);  // c
+      if (s & 0x08) rect(x, y0 + dh - u, dw, u, r, g, b);            // d
+      if (s & 0x10) rect(x, y0 + half, u, dh - half, r, g, b);       // e
+      if (s & 0x20) rect(x, y0, u, half + 1, r, g, b);               // f
+      if (s & 0x40) rect(x, y0 + half - u / 2, dw, u, r, g, b);      // g
+    }
+  };
+  draw_text(fps_text, 1.0f, 1.0f, 1.0f);
+  x += advance / 2;
+  draw_text(speed_text, 1.0f, 0.85f, 0.1f);
+
+  glScissor(box[0], box[1], box[2], box[3]);
+  if (!scissor)
+    glDisable(GL_SCISSOR_TEST);
+  glClearColor(clear[0], clear[1], clear[2], clear[3]);
+  glColorMask(mask[0], mask[1], mask[2], mask[3]);
+}
+#endif
