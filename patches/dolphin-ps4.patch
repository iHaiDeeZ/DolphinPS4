+
+const std::vector<const char*> CATEGORIES = {"Video", "Graphics", "Performance", "System",
+                                             "Diagnostics"};
+
+std::mutex s_mutex;
+std::string s_path;
+std::map<std::string, std::map<std::string, std::string>> s_sections;  // "global", game IDs
+std::function<std::string(const std::string&)> s_base;
+std::function<std::string(const std::string&, const std::string&)> s_game_base;
+
+std::string Trim(std::string text)
+{
+  while (!text.empty() && (text.back() == '\r' || text.back() == '\n' || text.back() == ' '))
+    text.pop_back();
+  return text;
+}
+
+std::string Fallback(const std::string& key)
+{
+  if (s_base)
+  {
+    const std::string base = s_base(key);
+    if (!base.empty())
+      return base;
+  }
+  const Setting* setting = Find(key);
+  return setting ? setting->fallback : "";
+}
+
+// Kept per game by the in-game menu, whether or not the game has its own settings.
+bool AlwaysPerGame(const std::string& key)
+{
+  return key == "wii_extension" || key == "wii_sideways";
+}
+
+std::string GetLocked(const std::string& key, const std::string& game_id)
+{
+  if (!game_id.empty() && AlwaysPerGame(key))
+  {
+    auto game = s_sections.find(game_id);
+    if (game != s_sections.end())
+    {
+      auto value = game->second.find(key);
+      if (value != game->second.end())
+        return value->second;
+    }
+  }
+  if (!game_id.empty())
+  {
+    auto game = s_sections.find(game_id);
+    if (game != s_sections.end() && game->second.count("custom") &&
+        game->second.at("custom") == "on")
+    {
+      auto value = game->second.find(key);
+      if (value != game->second.end())
+        return value->second;
+    }
+    if (s_game_base)
+    {
+      const std::string base = s_game_base(game_id, key);
+      if (!base.empty())
+        return base;
+    }
+  }
+  auto global = s_sections.find("global");
+  if (global != s_sections.end())
+  {
+    auto value = global->second.find(key);
+    if (value != global->second.end())
+      return value->second;
+  }
+  return Fallback(key);
+}
+}  // namespace
+
+const std::vector<Setting>& All()
+{
+  return SETTINGS;
+}
+
+const std::vector<const char*>& Categories()
+{
+  return CATEGORIES;
+}
+
+const Setting* Find(const std::string& key)
+{
+  for (const Setting& setting : SETTINGS)
+  {
+    if (key == setting.key)
+      return &setting;
+  }
+  return nullptr;
+}
+
+void Load(const std::string& data_dir)
+{
+  std::lock_guard lock(s_mutex);
+  s_path = data_dir + "/settings.ini";
+  s_sections.clear();
+  std::ifstream file(s_path);
+  std::string line, section = "global";
+  while (std::getline(file, line))
+  {
+    line = Trim(line);
+    if (line.empty() || line[0] == '#' || line[0] == ';')
+      continue;
+    if (line.front() == '[' && line.back() == ']')
+    {
+      section = line.substr(1, line.size() - 2);
+      continue;
+    }
+    const size_t eq = line.find('=');
+    if (eq != std::string::npos)
+      s_sections[section][line.substr(0, eq)] = line.substr(eq + 1);
+  }
+}
+
+void Save()
+{
+  std::lock_guard lock(s_mutex);
+  if (s_path.empty())
+    return;
+  std::ofstream file(s_path, std::ios::trunc);
+  file << "# Dolphin for PS4 settings, written by the XMB and the in-game menu.\n"
+          "# [global] applies to every game; a [GAMEID] section with custom=on overrides it.\n";
+  auto write = [&](const std::string& name, const std::map<std::string, std::string>& values) {
+    file << "\n[" << name << "]\n";
+    for (const auto& [key, value] : values)
+      file << key << "=" << value << "\n";
+  };
+  if (s_sections.count("global"))
+    write("global", s_sections["global"]);
+  for (const auto& [name, values] : s_sections)
+  {
+    if (name != "global")
+      write(name, values);
+  }
+}
+
+void SetBaseLookup(std::function<std::string(const std::string&)> lookup)
+{
+  std::lock_guard lock(s_mutex);
+  s_base = std::move(lookup);
+}
+
+void SetGameBaseLookup(std::function<std::string(const std::string&, const std::string&)> lookup)
+{
+  std::lock_guard lock(s_mutex);
+  s_game_base = std::move(lookup);
+}
+
+std::string Get(const std::string& key, const std::string& game_id)
+{
+  std::lock_guard lock(s_mutex);
+  return GetLocked(key, game_id);
+}
+
+void Set(const std::string& key, const std::string& value, const std::string& game_id)
+{
+  {
+    std::lock_guard lock(s_mutex);
+    s_sections[game_id.empty() ? "global" : game_id][key] = value;
+  }
+  Save();
+}
+
+std::vector<std::pair<std::string, std::string>> GlobalValues()
+{
+  std::lock_guard lock(s_mutex);
+  std::vector<std::pair<std::string, std::string>> values;
+  auto global = s_sections.find("global");
+  if (global != s_sections.end())
+    values.assign(global->second.begin(), global->second.end());
+  return values;
+}
+
+std::vector<std::pair<std::string, std::string>> GameValues(const std::string& game_id)
+{
+  std::lock_guard lock(s_mutex);
+  std::vector<std::pair<std::string, std::string>> values;
+  auto game = s_sections.find(game_id);
+  if (game != s_sections.end())
+  {
+    for (const auto& [key, value] : game->second)
+    {
+      if (key != "custom")
+        values.emplace_back(key, value);
+    }
+  }
+  return values;
+}
+
+bool IsCustom(const std::string& game_id)
+{
+  std::lock_guard lock(s_mutex);
+  auto game = s_sections.find(game_id);
+  return game != s_sections.end() && game->second.count("custom") &&
+         game->second.at("custom") == "on";
+}
+
+void SetCustom(const std::string& game_id, bool custom)
+{
+  if (game_id.empty())
+    return;
+  {
+    std::lock_guard lock(s_mutex);
+    auto& section = s_sections[game_id];
+    if (custom && section.size() <= 1)
+    {
+      // First time: start from what the game uses now.
+      for (const Setting& setting : SETTINGS)
+        section[setting.key] = GetLocked(setting.key, {});
+    }
+    section["custom"] = custom ? "on" : "off";
+  }
+  Save();
+}
+
+void ResetGlobal(const std::string& key)
+{
+  {
+    std::lock_guard lock(s_mutex);
+    auto global = s_sections.find("global");
+    if (global != s_sections.end())
+      global->second.erase(key);
+  }
+  Save();
+}
+
+void ResetGame(const std::string& game_id)
+{
+  {
+    std::lock_guard lock(s_mutex);
+    s_sections.erase(game_id);
+  }
+  Save();
+}
+
+void ResetAll()
+{
+  {
+    std::lock_guard lock(s_mutex);
+    s_sections.clear();
+  }
+  Save();
+}
+
+std::string LabelOf(const Setting& setting, const std::string& value)
+{
+  for (const Choice& choice : setting.choices)
+  {
+    if (value == choice.value)
+      return choice.label;
+  }
+  return value;
+}
+
+std::string Step(const Setting& setting, const std::string& value, int direction)
+{
+  const int count = static_cast<int>(setting.choices.size());
+  int index = 0;
+  for (int i = 0; i < count; i++)
+  {
+    if (value == setting.choices[i].value)
+      index = i;
+  }
+  index = (index + direction % count + count) % count;
+  return setting.choices[index].value;
+}
+
+// Diagnostics: each switch's own value; what applies also needs All Diagnostics on.
+std::map<std::string, bool> s_diagnostics;
+
+bool DiagnosticRaw(const std::string& key)
+{
+  const auto it = s_diagnostics.find(key);
+  if (it != s_diagnostics.end())
+    return it->second;
+  const Setting* setting = Find(key);
+  return setting && std::string(setting->fallback) == "on";
+}
+
+void ApplyDiagnostics()
+{
+  ps4_perf_log = DiagnosticOn("perf_log") ? 1 : 0;
+  ps4_freeze_reports = DiagnosticOn("freeze_reports") ? 1 : 0;
+  ps4_sampler_set_enabled(DiagnosticOn("profile") ? 1 : 0);
+  // Dolphin's own log (dolphin.log): the listeners stay registered, only their output stops.
+  const bool emu_log = DiagnosticOn("emu_log");
+  auto* log_manager = Common::Log::LogManager::GetInstance();
+  if (log_manager)
+  {
+    log_manager->EnableListener(Common::Log::LogListener::CONSOLE_LISTENER, emu_log);
+    log_manager->EnableListener(Common::Log::LogListener::FILE_LISTENER, emu_log);
+  }
+}
+
+bool DiagnosticOn(const std::string& key)
+{
+  return DiagnosticRaw("diagnostics_all") && DiagnosticRaw(key);
+}
+
+void ApplyLive(const std::string& key, const std::string& value)
+{
+  const bool on = value == "on";
+  if (key == "diagnostics_all" || key == "perf_log" || key == "freeze_reports" ||
+      key == "emu_log" || key == "profile")
+  {
+    s_diagnostics[key] = on;
+    ApplyDiagnostics();
+  }
+  else if (key == "aspect")
+  {
+    Config::SetBase(Config::GFX_ASPECT_RATIO, value == "wide"     ? AspectMode::ForceWide :
+                                              value == "standard" ? AspectMode::ForceStandard :
+                                              value == "stretch"  ? AspectMode::Stretch :
+                                                                    AspectMode::Auto);
+  }
+  else if (key == "zoom")
+    ps4_zoom_letterbox = value == "letterbox";
+  else if (key == "widescreen_hack")
+    Config::SetBase(Config::GFX_WIDESCREEN_HACK, on);
+  else if (key == "crop")
+    Config::SetBase(Config::GFX_CROP_TO_ASPECT_RATIO, on);
+  else if (key == "resolution")
+    Config::SetBase(Config::GFX_EFB_SCALE, std::clamp(std::atoi(value.c_str()), 1, 4));
+  else if (key == "fps_limit")
+    ps4_fps_limit = value == "auto" ? -1 : std::max(0, std::atoi(value.c_str()));
+  else if (key == "vsync")
+    Config::SetBase(Config::GFX_VSYNC, on);
+  else if (key == "show_fps")
+    ps4_show_fps = on;
+  else if (key == "texture_filtering")
+  {
+    Config::SetBase(Config::GFX_ENHANCE_FORCE_TEXTURE_FILTERING,
+                    value == "linear"  ? TextureFilteringMode::Linear :
+                    value == "nearest" ? TextureFilteringMode::Nearest :
+                                         TextureFilteringMode::Default);
+  }
+  else if (key == "anisotropy")
+  {
+    const int x = std::atoi(value.c_str());
+    Config::SetBase(Config::GFX_ENHANCE_MAX_ANISOTROPY,
+                    x >= 16 ? AnisotropicFilteringMode::Force16x :
+                    x >= 8  ? AnisotropicFilteringMode::Force8x :
+                    x >= 4  ? AnisotropicFilteringMode::Force4x :
+                    x >= 2  ? AnisotropicFilteringMode::Force2x :
+                    x >= 1  ? AnisotropicFilteringMode::Force1x :
+                              AnisotropicFilteringMode::Default);
+  }
+  else if (key == "antialiasing")
+  {
+    Config::SetBase(Config::GFX_MSAA, static_cast<u32>(std::clamp(std::atoi(value.c_str()), 1, 4)));
+    Config::SetBase(Config::GFX_SSAA, false);
+  }
+  else if (key == "disable_fog")
+    Config::SetBase(Config::GFX_DISABLE_FOG, on);
+  else if (key == "copy_filter")
+    Config::SetBase(Config::GFX_ENHANCE_DISABLE_COPY_FILTER, value == "off");
+  else if (key == "efb_copies")
+    Config::SetBase(Config::GFX_HACK_SKIP_EFB_COPY_TO_RAM, value != "ram");
+  else if (key == "efb_access")
+    Config::SetBase(Config::GFX_HACK_EFB_ACCESS_ENABLE, on);
+  else if (key == "manual_texture_sampling")
+    Config::SetBase(Config::GFX_HACK_FAST_TEXTURE_SAMPLING, !on);
+  else if (key == "cpu_clock")
+  {
+    if (value == "auto")
+    {
+      if (ps4_auto_clock <= 0)
+        ps4_auto_clock = 100;  // the governor takes over from 100%
+      Config::SetBase(Config::MAIN_OVERCLOCK_ENABLE, false);
+      Config::SetBase(Config::MAIN_OVERCLOCK, 1.0f);
+    }
+    else
+    {
+      const int clock = std::clamp(std::atoi(value.c_str()), 20, 200);
+      ps4_auto_clock = 0;
+      Config::SetBase(Config::MAIN_OVERCLOCK_ENABLE, clock != 100);
+      Config::SetBase(Config::MAIN_OVERCLOCK, clock / 100.0f);
+    }
+  }
+  else if (key == "perf_overlay")
+  {
+    Config::SetBase(Config::GFX_SHOW_FTIMES, on);
+    Config::SetBase(Config::GFX_SHOW_SPEED, on);
+  }
+  else if (key == "volume")
+    Config::SetBase(Config::MAIN_AUDIO_VOLUME, std::clamp(std::atoi(value.c_str()), 0, 100));
+}
+}  // namespace PS4Settings
diff --git a/Source/Core/DolphinNoGUI/PS4Settings.h b/Source/Core/DolphinNoGUI/PS4Settings.h
new file mode 100755
