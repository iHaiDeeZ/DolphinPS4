+void JitPS4::Run()
+{
+  ProtectStack();
+  m_system.GetJitInterface().UpdateMembase();
+
+  CompiledCode pExecAddr = (CompiledCode)asm_routines.enter_code;
+  pExecAddr();
+
+  UnprotectStack();
+}
