+// Base vertex emulation (see GLVertexFormat::SetBaseVertex): point the pipeline's VAO at the
+// draw's first vertex.
+static void PS4ApplyBaseVertex(const AbstractPipeline* pipeline, u32 base_vertex)
+{
+  const GLVertexFormat* format = static_cast<const OGLPipeline*>(pipeline)->GetVertexFormat();
+  if (!format)
