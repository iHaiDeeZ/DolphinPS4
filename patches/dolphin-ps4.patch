+// Hotkey capture (Settings -> Hotkeys, Cross): the buttons held together, taken when they are
+// all released; Circle alone cancels.
+std::string s_capture_key;
+uint32_t s_capture_seen = 0;
+bool s_capture_armed = false;
+Clock::time_point s_capture_start;
+
+void StartCapture(const std::string& key)
+{
+  s_capture_key = key;
+  s_capture_seen = 0;
+  s_capture_armed = false;
+  s_capture_start = Clock::now();
+  Toast("Hold the buttons together, then let go", 8000);
+}
+
+void UpdateCapture(uint32_t held)
+{
+  held &= PS4Settings::HotkeyButtons();
+  if (!s_capture_armed)
+  {
+    s_capture_armed = held == 0;  // Cross, which started this, released first
+    return;
+  }
+  if (Clock::now() - s_capture_start > std::chrono::seconds(10))
+  {
+    s_capture_key.clear();
+    Toast("Hotkey unchanged");
+    return;
+  }
+  if (held)
+  {
+    s_capture_seen |= held;
+    return;
+  }
+  if (!s_capture_seen)
+    return;
+  const uint32_t mask = s_capture_seen;
+  s_capture_seen = 0;
+  if (mask == ORBIS_PAD_BUTTON_CIRCLE)
+  {
+    s_capture_key.clear();
+    Toast("Hotkey unchanged");
+    return;
+  }
+  if (__builtin_popcount(mask) < 2)
+  {
+    s_capture_start = Clock::now();
+    Toast("Two or more buttons together", 4000);
+    return;
+  }
+  if (mask == (ORBIS_PAD_BUTTON_L3 | ORBIS_PAD_BUTTON_R3))
+  {
+    s_capture_start = Clock::now();
+    Toast("L3 + R3 opens this menu: try other buttons", 4000);
+    return;
+  }
+  const std::string name = PS4Settings::HotkeyName(mask);
+  PS4Settings::Set(s_capture_key, name, {});
+  const PS4Settings::Setting* setting = PS4Settings::Find(s_capture_key);
+  Toast((setting ? std::string(setting->label) : s_capture_key) + ": " + name);
+  Log("hotkey " + s_capture_key + "=" + name);
+  s_capture_key.clear();
+  BuildRows();
+}
+
+// While a game runs (menu closed): Save State / Load State on their hotkeys, current slot.
+void CheckHotkeys(Core::System& system, uint32_t held, uint32_t pressed)
+{
+  static std::string s_save_text, s_load_text, s_rewind_text;
+  static uint32_t s_save_mask = 0, s_load_mask = 0, s_rewind_mask = 0;
+  const std::string save = PS4Settings::Get("hotkey_save");
+  const std::string load = PS4Settings::Get("hotkey_load");
+  const std::string rewind = PS4Settings::Get("hotkey_rewind");
+  if (rewind != s_rewind_text)
+  {
+    s_rewind_text = rewind;
+    s_rewind_mask = PS4Settings::HotkeyMask(rewind);
+  }
+  if (save != s_save_text)
+  {
+    s_save_text = save;
+    s_save_mask = PS4Settings::HotkeyMask(save);
+  }
+  if (load != s_load_text)
+  {
+    s_load_text = load;
+    s_load_mask = PS4Settings::HotkeyMask(load);
+  }
+  const auto fired = [&](uint32_t mask) {
+    return __builtin_popcount(mask) >= 2 && (held & mask) == mask && (pressed & mask);
+  };
+  if (fired(s_rewind_mask))
+  {
+    ps4_pad_block = 1;
+#ifdef USE_RETRO_ACHIEVEMENTS
+    if (AchievementManager::GetInstance().IsHardcoreModeActive())
+    {
+      Toast("Hardcore Mode is on: no rewinding.", 4000);
+      return;
+    }
+#endif
+    if (ps4_state_busy > 0)
+    {
+      Toast("Still saving, please wait...");
+      return;
+    }
+    // Pressed again soon after a rewind: one checkpoint further back.
+    const bool further = s_rewound && Clock::now() - s_last_rewind < std::chrono::seconds(6);
+    const size_t index = further ? 1 : 0;
+    if (s_checkpoints.empty())
+    {
+      Toast("No checkpoint yet: the first one is taken after a minute of play", 4000);
+      return;
+    }
+    if (index >= s_checkpoints.size())
+    {
+      Toast("No older checkpoint", 3000);
+      return;
+    }
+    if (s_rewind_pending || s_rewind_loading)
+      return;
+    // The checkpoints after the one loaded are from a future that no longer happens.
+    s_checkpoints.erase(s_checkpoints.begin(), s_checkpoints.begin() + index);
+    s_checkpoint_times.erase(s_checkpoint_times.begin(), s_checkpoint_times.begin() + index);
+    const long long now_ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                                 Clock::now().time_since_epoch())
+                                 .count();
+    s_rewind_target = s_checkpoints.front();
+    s_rewind_target_ms = s_checkpoint_times.front();
+    // The film plays back faster for a longer way back (about 1-2 s), then the checkpoint loads.
+    const float span = static_cast<float>(now_ms - s_rewind_target_ms) / 1000.0f;
+    const float play = std::clamp(0.8f + span * 0.02f, 0.9f, 2.2f);
+    Log("rewind: " + s_rewind_target + " (" + std::to_string(static_cast<int>(span)) + " s back, " +
+        std::to_string(s_checkpoints.size()) + " checkpoints)");
+    s_rewound = true;
+    s_last_rewind = Clock::now();
+    s_checkpoint_clock = 0.0f;
+    s_rewind_pending = true;
+    s_rewind_load_at = Clock::now() + std::chrono::milliseconds(static_cast<int>(play * 1000));
+    ps4_film_record = 2;  // hold the film while it plays
+    {
+      std::lock_guard lock(s_mutex);
+      s_rewind_fx = true;
+      s_rewind_fx_start = Clock::now();
+      s_rewind_fx_end = s_rewind_fx_start + std::chrono::seconds(30);  // until the load is done
+      s_rewind_play_from_ms = now_ms;
+      s_rewind_play_to_ms = s_rewind_target_ms;
+      s_rewind_play_len = play;
+    }
+    return;
+  }
+  if (fired(s_save_mask))
+  {
+    ps4_pad_block = 1;  // the game sees a neutral pad until the buttons are released
+    if (ps4_state_busy > 0)
+    {
+      Toast("Still saving, please wait...");
+      return;
+    }
+    Log("hotkey: saving state " + std::to_string(s_slot));
+    s_saving_slot = s_slot;
+    State::Save(system, static_cast<u32>(s_slot));
+    Toast("Saving to slot " + std::to_string(s_slot) + "...");
+  }
+  else if (fired(s_load_mask))
+  {
+    ps4_pad_block = 1;
+#ifdef USE_RETRO_ACHIEVEMENTS
+    if (AchievementManager::GetInstance().IsHardcoreModeActive())
+    {
+      Toast("Hardcore Mode is on: no loading states. Turn it off in the game list: Settings -> "
+            "RetroAchievements",
+            6000);
+      return;
+    }
+#endif
+    if (ps4_state_busy > 0)
+    {
+      Toast("Still saving, please wait...");
+      return;
+    }
+    std::string made_by;
+    const State::PS4Slot status = State::PS4CheckSlot(static_cast<u32>(s_slot), &made_by);
+    if (status != State::PS4Slot::Ready)
+    {
+      Toast(SlotProblem(s_slot, status, made_by), 4500);
+      return;
+    }
+    Log("hotkey: loading state " + std::to_string(s_slot));
+    s_loading_slot = s_slot;
+    State::Load(system, static_cast<u32>(s_slot));
+    Toast("Loading slot " + std::to_string(s_slot) + "...");
+  }
+}
