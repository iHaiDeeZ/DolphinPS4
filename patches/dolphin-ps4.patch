+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// Parallelism oracle (Dolphin for PS4 lab, design study "Two Cores, One Gekko"): measures how much
+// of the guest's instruction stream could have run on a second core, at function granularity,
+// if speculation were perfect. Runs inside the interpreter and only when the environment variable
+// DOLPHIN_ORACLE_OUT names a report file.
+//
+// Model: when the guest calls a function, a second core starts the code after the call (the
+// continuation) right away, from the register state at the call. The continuation runs until it
+// reads a register or memory word the function wrote (a true dependence), touches a device, or
+// has run as long as the function (the two cores can only overlap while the function runs).
+// Registers whose value at the return equals their value at the call are not dependences
+// (value validation); a second variant also predicts a function's return value as the value it
+// returned last time. With two cores only one continuation can run at a time, so the report
+// picks the best set of non-overlapping overlaps.
+
+#pragma once
+
+#include "Common/CommonTypes.h"
+
+union UGeckoInstruction;
+struct GekkoOPInfo;
+
+namespace PowerPC
+{
+struct PowerPCState;
+}
+
+namespace ParallelismOracle
+{
+extern bool g_active;
+
+// The interpreter, around every instruction it executes.
+void BeforeInstruction(const PowerPC::PowerPCState& ppc, UGeckoInstruction inst,
+                       const GekkoOPInfo* opinfo);
+void AfterInstruction(const PowerPC::PowerPCState& ppc);
+// The MMU, for every guest load or store (effective address).
+void OnMemory(u32 address, u32 size, bool write);
+}  // namespace ParallelismOracle
