+
+// RetroAchievements' login at the game's start (its network thread).
+void OnAchievementLogin(int result, const char* text)
+{
+  std::string message;
+  if (result == 0)
+    message = std::string("RetroAchievements: logged in as ") + text;
+  else if (result == RC_INVALID_CREDENTIALS || result == RC_EXPIRED_TOKEN ||
+           result == RC_ACCESS_DENIED)
+    message = "RetroAchievements: the login expired - log in again in Settings";
+  else if (result == RC_NO_RESPONSE)
+    message = "RetroAchievements: no answer from the server (is the PS4 online?)";
+  else
+    message = std::string("RetroAchievements: couldn't log in (") +
+              (text && *text ? text : std::to_string(result).c_str()) + ")";
+  if (result != 0)
+  {
+    std::lock_guard lock(s_mutex);
+    s_banners.push_back({"RetroAchievements", message.substr(std::string("RetroAchievements: ").size()),
+                         "", -1.0f});
+  }
+  Log(message + " [" + std::to_string(result) + "]");
+}
+
+// RetroAchievements' answer for the game's achievements (its network thread).
+void OnAchievementGame(int result, const char* text)
+{
+  std::string brief, message;
+  if (result == 0)
+  {
+    s_ach_game_ready = true;  // the banner, once its badge had a moment to arrive
+  }
+  else if (result == RC_API_FAILURE)
+  {
+    brief = "Version refused";
+    message = "RetroAchievements didn't accept this Dolphin version for achievements.";
+  }
+  else if (result == RC_LOGIN_REQUIRED || result == RC_INVALID_CREDENTIALS ||
+           result == RC_EXPIRED_TOKEN)
+  {
+    brief = "Log in again";
+    message = "The RetroAchievements login expired: log in again in the game list "
+              "(Settings -> RetroAchievements).";
+  }
+  else
+  {
+    brief = "Not supported";
+    message = "RetroAchievements has no achievements for this game" +
+              (text && *text ? std::string(" (") + text + ")." : std::string("."));
+  }
+  if (!message.empty())
+  {
+    std::lock_guard lock(s_mutex);
+    s_banners.push_back({"RetroAchievements", brief + ": " + message, "", -1.0f});
+  }
+  {
+    std::lock_guard lock(s_mutex);
+    s_ach_brief = brief;
+    s_ach_message = message;
+  }
+  Log("achievements: game " + std::to_string(result) + " " + (text ? text : ""));
+}
+#endif
