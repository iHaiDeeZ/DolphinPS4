+#include "DolphinNoGUI/PS4Glyphs.h"
+#include "DolphinNoGUI/PS4Settings.h"
+#include "DolphinNoGUI/PS4Updater.h"
+#include "DolphinNoGUI/PS4XMBDisplay.h"
+
+extern "C" void ps4_boot_trace(const char* line);  // port/ps4_crashlog.cpp
+
+namespace PS4XMB
+{
+namespace
+{
+using Clock = std::chrono::steady_clock;
+constexpr float W = static_cast<float>(Display::WIDTH);
+constexpr float H = static_cast<float>(Display::HEIGHT);
+
+// The XMB's own log (/data/DolphinPS4/xmb.log): dolphin.log and the boot trace start over when
+// the app restarts into a game.
+FILE* s_log = nullptr;
+
+void Log(const std::string& text)
+{
+  fprintf(stderr, "[xmb] %s\n", text.c_str());
+  ps4_boot_trace(("xmb: " + text).c_str());
+  if (s_log)
+  {
+    fprintf(s_log, "%s\n", text.c_str());
+    fflush(s_log);
+  }
+}
