+// Title, platform / last played line and the Play button, centred on cx from y down.
+void Menu::DrawGameInfo(ImDrawList* dl, const Game& game, float cx, float y, float alpha)
+{
+  const Theme& theme = CurrentTheme();
+  const float title_size = TextWidth(m_bold, 44, game.title) > 860.0f ? 34.0f : 44.0f;
+  const float tw = std::min(TextWidth(m_bold, title_size, game.title), 900.0f);
+  Text(dl, m_bold, title_size, ImVec2(cx - tw * 0.5f, y), Rgba(theme.text, alpha), game.title);
+  std::string info = std::string(game.wii ? "Wii" : "GameCube") + "  -  " + PlayedText(Played(game.path));
+  const std::string played = PS4PlayTime::Text(PlayTime(game));
+  if (!played.empty())
+    info += "  -  " + played;
+  if (game.discs > 1)
+    info += "  -  " + std::to_string(game.discs) + " discs";
+  const float iw = TextWidth(m_font, 26, info);
+  Text(dl, m_font, 26, ImVec2(cx - iw * 0.5f, y + 58), Rgba(theme.text, alpha * 0.72f), info);
+  const float bw = 210.0f, bh = 60.0f, by = y + 104;
+  const float pulse = 0.85f + 0.15f * std::sin(m_time * 3.0f);
+  const ImVec2 b0(cx - bw * 0.5f, by), b1(cx + bw * 0.5f, by + bh);
+  dl->AddRectFilled(b0, b1, Rgba(theme.wave, alpha * 0.18f * pulse), 14.0f);
+  dl->AddRect(b0, b1, Rgba(theme.wave, alpha * 0.95f), 14.0f, 0, 2.5f);
+  const float cw = PS4Glyphs::Width("Cross", 36);
+  const float pw = TextWidth(m_bold, 30, "Play");
+  const float px = cx - (cw + 14 + pw) * 0.5f;
+  PS4Glyphs::Draw(dl, m_bold, "Cross", px, by + bh * 0.5f, 36, alpha);
+  Text(dl, m_bold, 30, ImVec2(px + cw + 14, by + 12), Rgba(theme.text, alpha), "Play");
+}
+
+// GameCube style background: deep indigo, cubes drifting up and turning slowly.
+void Menu::DrawGameCubeBackground()
+{
+  ImDrawList* dl = ImGui::GetBackgroundDrawList();
+  dl->AddRectFilledMultiColor(ImVec2(0, 0), ImVec2(W, H * 0.55f), Rgba(0x120C2E), Rgba(0x1A1146),
+                              Rgba(0x2A1C66), Rgba(0x1E1450));
+  dl->AddRectFilledMultiColor(ImVec2(0, H * 0.55f), ImVec2(W, H), Rgba(0x1E1450), Rgba(0x2A1C66),
+                              Rgba(0x0A0718), Rgba(0x07050F));
+  // A soft light behind the cube.
+  for (int i = 8; i >= 1; i--)
+    dl->AddCircleFilled(ImVec2(W * 0.66f, 470), 60.0f * i, Rgba(0x6A4CFF, 0.018f), 48);
+  for (int i = 0; i < 14; i++)
+  {
+    const float seed = static_cast<float>(i) * 12.9898f;
+    const float fx = std::fmod(std::abs(std::sin(seed) * 43758.5453f), 1.0f);
+    const float speed = 14.0f + 18.0f * std::fmod(std::abs(std::sin(seed * 1.7f) * 9631.3f), 1.0f);
+    const float size = 14.0f + 26.0f * std::fmod(std::abs(std::sin(seed * 2.3f) * 7123.1f), 1.0f);
+    const float span = H + 200.0f;
+    const float y = H + 100.0f - std::fmod(m_time * speed + fx * span, span);
+    const float x = 60.0f + fx * (W - 120.0f) + 30.0f * std::sin(m_time * 0.3f + seed);
+    BoxFace faces[6];
+    for (BoxFace& face : faces)
+    {
+      face.top = Rgba(0x8C6CFF, 0.30f);
+      face.bottom = Rgba(0x5B3FC4, 0.22f);
+    }
+    DrawBox(dl, ImVec2(x, y), size, size, size, m_time * 0.4f + seed, m_time * 0.27f + seed * 0.5f,
+            900.0f, faces, 1.0f, Rgba(0xB9A6FF, 0.25f));
+  }
+}
+
+// GameCube style: the games in a list on the left; the selected one's cover on a cube that turns
+// a quarter to bring the next cover round.
+void Menu::DrawGameCubeGames(ImDrawList* dl, float alpha, float dt)
+{
+  const Theme& theme = CurrentTheme();
+  const int c = static_cast<int>(Category::Games);
+  const auto& items = m_items[c];
+  const int count = static_cast<int>(items.size());
+  if (count == 0 || items[0].game < 0)
+  {
+    DrawLibraryGames(dl, alpha);  // the "no games yet" message
+    return;
+  }
+  const int selected = m_selected[c];
+  const float pos = m_item_pos[c];
+
+  // The list.
+  constexpr float LIST_X = 90.0f, LIST_W = 640.0f, ROW_H = 66.0f, MID_Y = 540.0f;
+  dl->PushClipRect(ImVec2(0, 150), ImVec2(LIST_X + LIST_W + 40, 950), true);
+  {
+    const float hy = MID_Y + (static_cast<float>(selected) - pos) * ROW_H;
+    const ImVec2 h0(LIST_X - 14, hy - 8), h1(LIST_X + LIST_W, hy + ROW_H - 10);
+    dl->AddRectFilled(ImVec2(h0.x - 6, h0.y - 6), ImVec2(h1.x + 6, h1.y + 6),
+                      Rgba(0x6A4CFF, alpha * 0.12f), 18.0f);
+    dl->AddRectFilledMultiColor(h0, h1, Rgba(0x6A4CFF, alpha * 0.55f), Rgba(0x6A4CFF, alpha * 0.15f),
+                                Rgba(0x6A4CFF, alpha * 0.15f), Rgba(0x6A4CFF, alpha * 0.55f));
+    dl->AddRect(h0, h1, Rgba(0xB9A6FF, alpha * 0.9f), 12.0f, 0, 2.0f);
+  }
+  for (int i = 0; i < count; i++)
+  {
+    const float d = static_cast<float>(i) - pos;
+    const float y = MID_Y + d * ROW_H;
+    if (y < 120.0f || y > 980.0f)
+      continue;
+    const Game& game = m_games[items[i].game];
+    const float focus = std::max(0.0f, 1.0f - std::abs(d));
+    const float fade = std::clamp(1.0f - (std::abs(d) - 4.0f) / 3.0f, 0.0f, 1.0f);
+    const float size = 28.0f + 6.0f * focus;
+    const std::string tag = game.wii ? "Wii" : "GC";
+    Text(dl, m_bold, 20, ImVec2(LIST_X + 8 * focus, y + 14), Rgba(0xB9A6FF, alpha * fade * 0.9f), tag,
+         false);
+    Text(dl, i == selected ? m_bold : m_font, size, ImVec2(LIST_X + 54 + 10 * focus, y + 6),
+         Rgba(theme.text, alpha * fade * (0.6f + 0.4f * focus)), game.title, false);
+  }
+  dl->PopClipRect();
+
+  // The cube: a quarter turn when the selection changes, then a slow sway.
+  if (m_cube_selected != selected)
+  {
+    if (m_cube_selected >= 0 && m_cube_selected < count)
+    {
+      m_cube_previous = m_cube_selected;
+      m_cube_turn = selected > m_cube_selected ? 1.0f : -1.0f;
+    }
+    m_cube_selected = selected;
+  }
+  Approach(m_cube_turn, 0.0f, 7.0f, dt);
+  const Game& game = m_games[items[selected].game];
+  const float aspect = game.cover != ImTextureID{} ? std::clamp(game.cover_aspect, 0.55f, 1.0f) : 0.7f;
+  const float hy = 230.0f, hx = hy * aspect, hz = hx;
+  const ImVec2 center(W * 0.66f, 450.0f + 8.0f * std::sin(m_time * 1.1f));
+  BoxFace faces[6];
+  for (BoxFace& face : faces)
+  {
+    face.top = Rgba(0x7A5CF0);
+    face.bottom = Rgba(0x3A2890);
+  }
+  faces[4].top = faces[4].bottom = Rgba(0x9C84FF);
+  faces[0].texture = game.cover;
+  if (m_cube_previous >= 0 && m_cube_previous < count && std::abs(m_cube_turn) > 0.01f)
+  {
+    const ImTextureID previous = m_games[items[m_cube_previous].game].cover;
+    faces[m_cube_turn > 0.0f ? 2 : 3].texture = previous;
+  }
+  const float ry = m_cube_turn * 1.5707963f + 0.30f * std::sin(m_time * 0.5f);
+  const float rx = -0.12f + 0.05f * std::sin(m_time * 0.37f);
+  // Shadow on the floor.
+  dl->AddCircleFilled(ImVec2(center.x, center.y + hy + 70), hx * 1.1f, Rgba(0x000000, alpha * 0.25f),
+                      40);
+  DrawBox(dl, center, hx, hy, hz, ry, rx, 1500.0f, faces, alpha, Rgba(0xD8CCFF, 0.55f));
+  if (game.cover == ImTextureID{})
+  {
+    const float tw = std::min(TextWidth(m_bold, 30, game.title), hx * 1.8f);
+    Text(dl, m_bold, 30, ImVec2(center.x - tw * 0.5f, center.y - 15), Rgba(0xFFFFFF, alpha * 0.9f),
+         game.title);
+  }
+  DrawGameInfo(dl, game, center.x, 780.0f, alpha);
+}
+
+// Wii style: channel tiles, four by three per page; the pages slide sideways.
+void Menu::DrawWiiGames(ImDrawList* dl, float alpha, float dt)
+{
+  const Theme& theme = CurrentTheme();
+  const int c = static_cast<int>(Category::Games);
+  const auto& items = m_items[c];
+  const int count = static_cast<int>(items.size());
+  if (count == 0 || items[0].game < 0)
+  {
+    DrawLibraryGames(dl, alpha);
+    return;
+  }
+  const int selected = m_selected[c];
+  constexpr int COLS = 4, ROWS = 3, PER_PAGE = COLS * ROWS;
+  constexpr float TW = 372.0f, TH = 206.0f, GAP = 26.0f, TOP = 262.0f;
+  const float left = (W - (COLS * TW + (COLS - 1) * GAP)) * 0.5f;
+  const int page = selected / PER_PAGE, pages = (count + PER_PAGE - 1) / PER_PAGE;
+  Approach(m_wii_page, static_cast<float>(page), 9.0f, dt);
+
+  // The selected channel's name above the grid.
+  const Game& sel_game = m_games[items[selected].game];
+  {
+    const float size = TextWidth(m_bold, 44, sel_game.title) > W - 300 ? 34.0f : 44.0f;
+    Text(dl, m_bold, size, ImVec2(left, 150), Rgba(theme.text, alpha), sel_game.title);
+    std::string info = std::string(sel_game.wii ? "Wii" : "GameCube") + "  -  " +
+                       PlayedText(Played(sel_game.path));
+    const std::string played = PS4PlayTime::Text(PlayTime(sel_game));
+    if (!played.empty())
+      info += "  -  " + played;
+    Text(dl, m_font, 26, ImVec2(left + 2, 206), Rgba(theme.text, alpha * 0.72f), info);
+  }
+
+  auto tile_pos = [&](int i, float page_pos) {
+    const int p = i / PER_PAGE, r = (i % PER_PAGE) / COLS, col = i % COLS;
+    return ImVec2(left + col * (TW + GAP) + (static_cast<float>(p) - page_pos) * W,
+                  TOP + r * (TH + GAP));
+  };
+  const ImVec2 target = tile_pos(selected, static_cast<float>(page));
+  if (m_wii_frame.x < 0.0f)
+    m_wii_frame = target;
+  Approach(m_wii_frame.x, target.x, 16.0f, dt);
+  Approach(m_wii_frame.y, target.y, 16.0f, dt);
+
+  for (int i = 0; i < count; i++)
+  {
+    ImVec2 p0 = tile_pos(i, m_wii_page);
+    if (p0.x > W || p0.x + TW < 0.0f)
+      continue;
+    const Game& game = m_games[items[i].game];
+    const bool sel = i == selected;
+    float grow = sel ? 0.035f + 0.008f * std::sin(m_time * 3.0f) : 0.0f;
+    const ImVec2 mid(p0.x + TW * 0.5f, p0.y + TH * 0.5f);
+    const ImVec2 a(mid.x - TW * 0.5f * (1 + grow), mid.y - TH * 0.5f * (1 + grow));
+    const ImVec2 b(mid.x + TW * 0.5f * (1 + grow), mid.y + TH * 0.5f * (1 + grow));
+    // The tile: white glass, the cover's colours behind the art, the art itself.
+    dl->AddRectFilled(ImVec2(a.x + 6, a.y + 8), ImVec2(b.x + 6, b.y + 8), Rgba(0x000000, alpha * 0.25f),
+                      20.0f);
+    dl->AddRectFilledMultiColor(a, b, Rgba(0xFFFFFF, alpha * 0.95f), Rgba(0xFFFFFF, alpha * 0.95f),
+                                Rgba(0xDCE3EA, alpha * 0.95f), Rgba(0xDCE3EA, alpha * 0.95f));
+    if (game.cover != ImTextureID{})
+    {
+      const float ca = std::clamp(game.cover_aspect, 0.55f, 1.0f);
+      const float band = std::clamp(ca * TH / TW, 0.2f, 1.0f);  // the cover's middle, tile-shaped
+      dl->AddImageRounded(ImTextureRef(game.cover), a, b, ImVec2(0, 0.5f - band * 0.5f),
+                          ImVec2(1, 0.5f + band * 0.5f), IM_COL32(255, 255, 255, static_cast<int>(alpha * 90)),
+                          18.0f);
+      const float ah = (b.y - a.y) - 22.0f, aw = ah * ca;
+      dl->AddImage(ImTextureRef(game.cover), ImVec2(mid.x - aw * 0.5f, mid.y - ah * 0.5f),
+                   ImVec2(mid.x + aw * 0.5f, mid.y + ah * 0.5f), ImVec2(0, 0), ImVec2(1, 1),
+                   IM_COL32(255, 255, 255, static_cast<int>(alpha * 255)));
+    }
+    else
+    {
+      const ImTextureID platform = game.wii ? m_icon_wii : m_icon_gc;
+      if (platform != ImTextureID{})
+      {
+        dl->AddImage(ImTextureRef(platform), ImVec2(mid.x - 44, a.y + 26), ImVec2(mid.x + 44, a.y + 114),
+                     ImVec2(0, 0), ImVec2(1, 1), IM_COL32(70, 80, 95, static_cast<int>(alpha * 255)));
+      }
+      const float tw = std::min(TextWidth(m_bold, 24, game.title), TW - 30);
+      Text(dl, m_bold, 24, ImVec2(mid.x - tw * 0.5f, b.y - 60), Rgba(0x3A4250, alpha), game.title);
+    }
+    dl->AddRect(a, b, sel ? Rgba(theme.wave, alpha) : Rgba(0xB8C2CC, alpha * 0.9f), 20.0f, 0,
+                sel ? 3.0f : 2.0f);
+  }
+  // The selection frame glides from tile to tile.
+  {
+    const ImVec2 f0(m_wii_frame.x - 10, m_wii_frame.y - 10), f1(m_wii_frame.x + TW + 10, m_wii_frame.y + TH + 10);
+    const float pulse = 0.6f + 0.4f * std::sin(m_time * 3.0f);
+    for (int i = 3; i >= 1; i--)
+    {
+      const float g = i * 5.0f;
+      dl->AddRect(ImVec2(f0.x - g, f0.y - g), ImVec2(f1.x + g, f1.y + g),
+                  Rgba(theme.wave, alpha * 0.10f * (4 - i) * pulse), 26.0f + g, 0, 4.0f);
+    }
+    dl->AddRect(f0, f1, Rgba(theme.wave, alpha * 0.95f), 26.0f, 0, 4.0f);
+  }
+  // Page arrows and dots, as on the Wii Menu.
+  const float arrow_y = TOP + (ROWS * TH + (ROWS - 1) * GAP) * 0.5f;
+  if (page > 0)
+  {
+    const ImVec2 c0(left * 0.5f, arrow_y);
+    dl->AddCircleFilled(c0, 34, Rgba(0xFFFFFF, alpha * 0.85f), 40);
+    dl->AddTriangleFilled(ImVec2(c0.x + 9, c0.y - 15), ImVec2(c0.x + 9, c0.y + 15), ImVec2(c0.x - 13, c0.y),
+                          Rgba(theme.wave, alpha));
+  }
+  if (page < pages - 1)
+  {
+    const ImVec2 c0(W - left * 0.5f, arrow_y);
+    dl->AddCircleFilled(c0, 34, Rgba(0xFFFFFF, alpha * 0.85f), 40);
+    dl->AddTriangleFilled(ImVec2(c0.x - 9, c0.y - 15), ImVec2(c0.x - 9, c0.y + 15), ImVec2(c0.x + 13, c0.y),
+                          Rgba(theme.wave, alpha));
+  }
+  if (pages > 1)
+  {
+    const float dots_w = pages * 26.0f;
+    for (int i = 0; i < pages; i++)
+    {
+      const float on = std::max(0.0f, 1.0f - std::abs(static_cast<float>(i) - m_wii_page));
+      dl->AddCircleFilled(ImVec2(W * 0.5f - dots_w * 0.5f + i * 26.0f + 13.0f, 948.0f), 6.0f + 3.0f * on,
+                          Rgba(theme.text, alpha * (0.35f + 0.65f * on)), 20);
+    }
+  }
+}
+
+void Menu::DrawLibraryCards(ImDrawList* dl, float alpha)
+{
+  const Theme& theme = CurrentTheme();
+  const int c = static_cast<int>(Category::MemoryCards);
+  const auto& items = m_items[c];
+  const int selected = m_selected[c];
+  Text(dl, m_bold, 50, ImVec2(90, 150), Rgba(theme.text, alpha), "Memory Cards");
+  Text(dl, m_bold, 26, ImVec2(92, 214), Rgba(theme.wave, alpha * 0.85f), "Slot A: " + m_slot_a, false);
+
+  // The cards, top to bottom (the list scrolls with the selection).
+  constexpr float LIST_X = 90.0f, LIST_W = 600.0f, ROW_H = 118.0f, TOP = 280.0f, BOTTOM = 960.0f;
+  const float visible = (BOTTOM - TOP) / ROW_H;
+  const float scroll = std::clamp(m_item_pos[c] - visible * 0.5f + 0.5f, 0.0f,
+                                  std::max(0.0f, static_cast<float>(items.size()) - visible));
+  dl->PushClipRect(ImVec2(0, TOP - 20), ImVec2(W, BOTTOM + 10), true);
+  dl->ChannelsSplit(3);
+  for (int i = 0; i < static_cast<int>(items.size()); i++)
+  {
+    const Item& item = items[i];
+    const float y = TOP + (static_cast<float>(i) - scroll) * ROW_H;
+    if (y < TOP - ROW_H || y > BOTTOM)
+      continue;
+    const bool sel = i == selected;
+    const ImVec2 r0(LIST_X, y), r1(LIST_X + LIST_W, y + ROW_H - 18);
+    dl->ChannelsSetCurrent(0);
+    RowBox(dl, r0, r1, false, alpha);
+    dl->ChannelsSetCurrent(2);
+    (void)sel;
+    const ImVec2 icon(LIST_X + 58, y + (ROW_H - 18) * 0.5f);
+    if (item.card == CARD_NEW)
+    {
+      dl->AddCircle(icon, 28, Rgba(theme.text, alpha), 40, 3.5f);
+      dl->AddLine(ImVec2(icon.x - 13, icon.y), ImVec2(icon.x + 13, icon.y), Rgba(theme.text, alpha), 4.0f);
+      dl->AddLine(ImVec2(icon.x, icon.y - 13), ImVec2(icon.x, icon.y + 13), Rgba(theme.text, alpha), 4.0f);
+    }
+    else
+    {
+      const bool in_slot = m_cards[item.card].name == m_slot_a;
+      DrawMemoryCardIcon(dl, icon, 72, in_slot ? Rgba(theme.wave, alpha) : Rgba(0x8A90A0, alpha),
+                         Rgba(0xFFFFFF, alpha * 0.85f));
+    }
+    Text(dl, m_bold, 32, ImVec2(LIST_X + 110, y + 14), Rgba(theme.text, alpha), item.label);
+    std::string detail = item.detail;
+    if (item.card >= 0)
+    {
+      const auto& card = m_cards[item.card];
+      const size_t saves = card.saves.size();
+      detail = std::to_string(saves) + (saves == 1 ? " save" : " saves") + "  -  " +
+               std::to_string(card.blocks) + " blocks";
+      if (card.name == m_slot_a)
+      {
+        // A green SLOT A tag.
+        const float tw = TextWidth(m_bold, 22, "SLOT A");
+        const ImVec2 t0(LIST_X + LIST_W - tw - 54, y + 18), t1(LIST_X + LIST_W - 24, y + 52);
+        dl->AddRectFilled(t0, t1, Rgba(0x28AA5A, alpha * 0.9f), 17.0f);
+        Text(dl, m_bold, 22, ImVec2(t0.x + 15, t0.y + 4), Rgba(0xFFFFFF, alpha), "SLOT A", false);
+      }
+    }
+    Text(dl, m_font, 25, ImVec2(LIST_X + 110, y + 58), Rgba(theme.text, alpha * 0.72f), detail);
+  }
+  if (!items.empty())
+  {
+    dl->ChannelsSetCurrent(1);
+    const float hy = TOP + (m_item_pos[c] - scroll) * ROW_H;
+    RowBox(dl, ImVec2(LIST_X - 6, hy - 5), ImVec2(LIST_X + LIST_W + 6, hy + ROW_H - 13), true, alpha);
+  }
+  dl->ChannelsMerge();
+  dl->PopClipRect();
+
+  // The selected card's saves on the right.
+  constexpr float PANE_X = 760.0f, PANE_R = W - 90.0f;
+  dl->AddRectFilled(ImVec2(PANE_X, TOP - 20), ImVec2(PANE_R, BOTTOM - 8), Rgba(0x000000, alpha * 0.28f), 18.0f);
+  dl->AddRect(ImVec2(PANE_X, TOP - 20), ImVec2(PANE_R, BOTTOM - 8), Rgba(theme.text, alpha * 0.10f), 18.0f, 0, 1.5f);
+  if (items.empty())
+    return;
+  const Item& item = items[selected];
+  if (item.card == CARD_NEW)
+  {
+    const char* lines[] = {"A new, empty memory card.",
+                           "",
+                           "Put it in Slot A to start fresh saves - for a second",
+                           "playthrough, or to share the console with someone.",
+                           "Your other cards and their saves stay as they are,",
+                           "and you can switch back at any time.",
+                           "",
+                           "Press Cross to create it."};
+    float y = TOP + 20;
+    for (const char* line : lines)
+    {
+      Text(dl, m_font, 30, ImVec2(PANE_X + 40, y), Rgba(theme.text, alpha * 0.85f), line);
+      y += 46;
+    }
+    return;
+  }
+  const PS4MemoryCards::Card& card = m_cards[item.card];
+  Text(dl, m_bold, 32, ImVec2(PANE_X + 40, TOP + 4), Rgba(theme.text, alpha), "Saves on " + card.name);
+  if (card.saves.empty())
+  {
+    Text(dl, m_font, 28, ImVec2(PANE_X + 40, TOP + 70), Rgba(theme.text, alpha * 0.7f),
+         "No saves yet. Put the card in Slot A and save in a game.");
+    return;
+  }
+  const float row_h = 82.0f;
+  const int fits = static_cast<int>((BOTTOM - TOP - 140) / row_h);
+  const int shown = std::min(fits, static_cast<int>(card.saves.size()));
+  for (int i = 0; i < shown; i++)
+  {
+    const PS4MemoryCards::Save& save = card.saves[i];
+    const float y = TOP + 64 + i * row_h;
+    const ImVec2 i0(PANE_X + 40, y), i1(PANE_X + 104, y + 64);
+    const ImTextureID icon = SaveIcon(item.card, i);
+    if (icon != ImTextureID{})
+    {
+      dl->AddImage(ImTextureRef(icon), i0, i1, ImVec2(0, 0), ImVec2(1, 1),
+                   IM_COL32(255, 255, 255, static_cast<int>(alpha * 255)));
+    }
+    else
+    {
+      dl->AddRectFilled(i0, i1, Rgba(0x8A90A0, alpha * 0.5f), 8.0f);
+    }
+    std::string title = save.title;
+    while (title.size() > 4 && TextWidth(m_bold, 28, title) > PANE_R - PANE_X - 470)
+      title = title.substr(0, title.size() - 4) + "...";
+    Text(dl, m_bold, 28, ImVec2(PANE_X + 124, y + 2), Rgba(theme.text, alpha), title);
+    std::string desc = save.description;
+    while (desc.size() > 4 && TextWidth(m_font, 23, desc) > PANE_R - PANE_X - 470)
+      desc = desc.substr(0, desc.size() - 4) + "...";
+    Text(dl, m_font, 23, ImVec2(PANE_X + 124, y + 38), Rgba(theme.text, alpha * 0.65f), desc);
+    const std::string blocks = std::to_string(save.blocks) + (save.blocks == 1 ? " block" : " blocks");
+    const std::string date = DateText(save.modified);
+    Text(dl, m_font, 24, ImVec2(PANE_R - 40 - TextWidth(m_font, 24, blocks), y + 4),
+         Rgba(theme.text, alpha * 0.8f), blocks);
+    Text(dl, m_font, 22, ImVec2(PANE_R - 40 - TextWidth(m_font, 22, date), y + 38),
+         Rgba(theme.text, alpha * 0.55f), date);
+  }
+  if (static_cast<int>(card.saves.size()) > shown)
+  {
+    const std::string more = "+ " + std::to_string(card.saves.size() - shown) +
+                             " more - press Cross to see them all";
+    Text(dl, m_font, 26, ImVec2(PANE_X + 40, TOP + 64 + shown * row_h + 6),
+         Rgba(theme.wave, alpha * 0.9f), more);
+  }
+}
