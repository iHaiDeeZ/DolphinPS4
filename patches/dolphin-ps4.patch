+// Wii games: the Wii Remote's Nunchuk, how it is held and what tilts it, changed in the running
+// game (the game sees the Nunchuk plugged in or out, as on a Wii) and kept for this game.
+void ToggleWiiRemote(int item, int direction)
+{
+  std::string key, value;
+  if (item == MAIN_WII_EXTENSION)
+  {
+    key = "wii_extension";
+    value = PS4Settings::Get(key, s_game_id) == "none" ? "nunchuk" : "none";
+    PS4Settings::Set(key, value, s_game_id);
+  }
+  else if (item == MAIN_WII_SIDEWAYS)
+  {
+    // Pointed at the TV -> sideways -> like a wheel (sideways and upright).
+    const int now = PS4Settings::Get("wii_sideways", s_game_id) != "on" ? 0 :
+                    PS4Settings::Get("wii_upright", s_game_id) == "on"  ? 2 :
+                                                                          1;
+    const int next = (now + direction + 3) % 3;
+    PS4Settings::Set("wii_sideways", next == 0 ? "off" : "on", s_game_id);
+    PS4Settings::Set("wii_upright", next == 2 ? "on" : "off", s_game_id);
+    key = "wii_hold";
+    value = next == 0 ? "pointed" : next == 1 ? "sideways" : "wheel";
+  }
+  else if (item == MAIN_WII_TOUCH)
+  {
+    static const char* const MODES[] = {"off", "pointer", "swing"};
+    const std::string touch = PS4Settings::Get("wii_touchpad", s_game_id);
+    const int now = touch == "pointer" ? 1 : touch == "swing" ? 2 : 0;
+    key = "wii_touchpad";
+    value = MODES[(now + direction + 3) % 3];
+    PS4Settings::Set(key, value, s_game_id);
+  }
+  else
+  {
+    static const char* const MODES[] = {"both", "motion", "stick"};
+    const std::string tilt = PS4Settings::Get("wii_tilt", s_game_id);
+    const int now = tilt == "motion" ? 1 : tilt == "stick" ? 2 : 0;
+    key = "wii_tilt";
+    value = MODES[(now + direction + 3) % 3];
+    PS4Settings::Set(key, value, s_game_id);
+  }
+  const bool nunchuk = PS4Settings::Get("wii_extension", s_game_id) != "none";
+  const bool sideways = PS4Settings::Get("wii_sideways", s_game_id) == "on";
+  const bool upright = PS4Settings::Get("wii_upright", s_game_id) == "on";
+  // The controller files too: what Dolphin reads when the layout is reloaded (Controls page).
+  PS4Controls::SetWiiTilt(PS4Settings::Get("wii_tilt", s_game_id), false);
+  PS4Controls::SetWiiAttachment(nunchuk ? "nunchuk" : "none", sideways, upright);
+  if (key == "wii_tilt" || key == "wii_touchpad")
+  {
+    // New bindings (the accelerometer, the stick, the touchpad): Dolphin reads the layout again.
+    if (key == "wii_tilt")
+      PS4Controls::SetWiiTilt(value, true);
+    else
+      PS4Controls::SetWiiTouchpad(value, true);
+    const auto lock = ControllerEmu::EmulatedController::GetStateLock();
+    Wiimote::LoadConfig();
+  }
+  else
+  {
+    // Every player's Wii Remote at once (the layout files already hold it for all four).
+    const auto lock = ControllerEmu::EmulatedController::GetStateLock();
+    for (int player = 0; player < 4; player++)
+    {
+      auto* attachments = static_cast<ControllerEmu::Attachments*>(
+          Wiimote::GetWiimoteGroup(player, WiimoteEmu::WiimoteGroup::Attachments));
+      attachments->SetSelectedAttachment(nunchuk ? WiimoteEmu::ExtensionNumber::NUNCHUK :
+                                                   WiimoteEmu::ExtensionNumber::NONE);
+      auto* options = Wiimote::GetWiimoteGroup(player, WiimoteEmu::WiimoteGroup::Options);
+      for (auto& setting : options->numeric_settings)
+      {
+        if (std::string(setting->GetININame()) == "Sideways Wiimote")
+          static_cast<ControllerEmu::NumericSetting<bool>*>(setting.get())->SetValue(sideways);
+        else if (std::string(setting->GetININame()) == "Upright Wiimote")
+          static_cast<ControllerEmu::NumericSetting<bool>*>(setting.get())->SetValue(upright);
+      }
+    }
+  }
+  Toast(key == "wii_extension" ? (nunchuk ? "Nunchuk plugged in" : "Nunchuk unplugged") :
+        key == "wii_touchpad" ?
+            (value == "pointer" ? "Touchpad: your finger aims" :
+             value == "swing"   ? "Touchpad: swipe to swing the Wii Remote" :
+                                  "Touchpad off") :
+        key == "wii_tilt" ?
+            (value == "stick"  ? "Tilt with the left stick" :
+             value == "motion" ? "Tilt by moving the controller" :
+                                 "Tilt with motion and the left stick") :
+        !sideways ? "Wii Remote pointed at the TV" :
+        upright   ? "Wii Remote held like a wheel" :
+                    "Wii Remote held sideways");
+  Log("wii remote: " + key + "=" + value + " (" + s_game_id + ")");
+}
