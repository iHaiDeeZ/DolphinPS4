+// A raised box: a shadow, a two-tone body, a light top edge, a dark bottom edge and a border.
+void BevelBox(ImDrawList* dl, ImVec2 a, ImVec2 b, ImU32 top, ImU32 bottom, ImU32 edge, float rounding,
+              float alpha, float s, bool raised)
+{
+  const float lift = (raised ? 7.0f : 3.0f) * s;
+  dl->AddRectFilled(ImVec2(a.x + 3 * s, a.y + lift), ImVec2(b.x + 3 * s, b.y + lift),
+                    IM_COL32(0, 0, 0, static_cast<int>(alpha * (raised ? 110 : 50))), rounding);
+  const float h = b.y - a.y;
+  dl->AddRectFilled(a, b, bottom, rounding);
+  dl->AddRectFilled(a, ImVec2(b.x, a.y + h * 0.4f), top, rounding, ImDrawFlags_RoundCornersTop);
+  dl->AddRectFilledMultiColor(ImVec2(a.x, a.y + h * 0.4f), ImVec2(b.x, a.y + h * 0.65f), top, top,
+                              IM_COL32(0, 0, 0, 0), IM_COL32(0, 0, 0, 0));
+  dl->AddLine(ImVec2(a.x + rounding, a.y + 1.5f * s), ImVec2(b.x - rounding, a.y + 1.5f * s),
+              IM_COL32(255, 255, 255, static_cast<int>(alpha * (raised ? 170 : 45))), 2.0f * s);
+  dl->AddLine(ImVec2(a.x + rounding, b.y - 1.5f * s), ImVec2(b.x - rounding, b.y - 1.5f * s),
+              IM_COL32(0, 0, 0, static_cast<int>(alpha * (raised ? 130 : 60))), 2.0f * s);
+  dl->AddRect(a, b, edge, rounding, 0, (raised ? 2.5f : 1.2f) * s);
+}
