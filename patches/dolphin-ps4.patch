+++ b/Source/Core/InputCommon/ControllerInterface/PS4Pad/PS4Pad.cpp
@@ -0,0 +1,667 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "InputCommon/ControllerInterface/PS4Pad/PS4Pad.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <map>
+#include <unistd.h>
+#include <fcntl.h>
+#include <string>
+#include <vector>
+
+#include <cstdio>
+
+#include <orbis/Pad.h>
+#include <orbis/Sysmodule.h>
+#include <orbis/UserService.h>
+
+#include "Common/CommonTypes.h"
+#include "Common/Logging/Log.h"
+#include "InputCommon/ControllerInterface/ControllerInterface.h"
+
+// The in-game menu (DolphinNoGUI/PS4IngameMenu.cpp) reads the first DualShock 4 itself; while
+// it is open, and until its buttons are released, the game sees a neutral pad.
+extern "C" int ps4_pad_handle;
+int ps4_pad_handle = -1;
+extern "C" int ps4_pad_block;
+int ps4_pad_block = 0;
+// Set by PlatformPS4 before the game starts: a Wii game with Wii Remote Controller on Auto. The
+// PS Move library is touched only then (v03.20 started it for every game and crashed at boot).
+extern "C" int ps4_move_enabled;
+int ps4_move_enabled = 0;
+// Players with a DualShock 4 (signed-in users, up to 4): DolphinNoGUI turns on that many
+// GameCube ports / Wii Remotes.
+extern "C" int ps4_pad_count;
+int ps4_pad_count = 0;
+
+// libScePad / libSceMove calls the OpenOrbis headers only have as stubs (no parameters). The
+// Move's state layout follows shadPS4 (src/core/libraries/move/move.h).
+extern "C" int32_t ps4_pad_set_motion(int32_t handle, bool enable) __asm__("scePadSetMotionSensorState");
+extern "C" int32_t sceMoveInit();
+extern "C" int32_t sceMoveOpen(int32_t user_id, int32_t type, int32_t index);
+extern "C" int32_t sceMoveClose(int32_t handle);
+extern "C" int32_t sceMoveReadStateLatest(int32_t handle, void* data);
+extern "C" int32_t sceMoveSetLightSphere(int32_t handle, uint8_t r, uint8_t g, uint8_t b);
+extern "C" int32_t sceMoveSetVibration(int32_t handle, uint8_t motor);
+extern "C" void ps4_boot_trace(const char* line);
+
+namespace
+{
+struct MoveState
+{
+  float accelerometer[3];
+  float gyro[3];
+  uint16_t buttons;
+  uint16_t trigger;
+  uint16_t extension[7];
+  uint8_t custom[5];
+  int64_t timestamp;
+  int32_t count;
+  float temperature;
+  uint8_t spare[64];  // in case the system's structure is larger than shadPS4's
+};
+
+// The Move's buttons (as on the PS3's Move): bits of MoveState::buttons.
+constexpr uint16_t MOVE_SELECT = 1 << 0, MOVE_T = 1 << 1, MOVE_MOVE = 1 << 2, MOVE_START = 1 << 3,
+                   MOVE_TRIANGLE = 1 << 4, MOVE_CIRCLE = 1 << 5, MOVE_CROSS = 1 << 6,
+                   MOVE_SQUARE = 1 << 7;
+constexpr double GRAVITY = 9.80665;
+}  // namespace
+
+// Settings -> System -> Wii Remote (PS4Controls.cpp): is player's PS Move on? Opens it if so.
+extern "C" int ps4_move_connected(int32_t user_id);
+
+namespace ciface::PS4Pad
+{
+constexpr std::string_view SOURCE_NAME = "PS4";
+constexpr int32_t INVALID_USER = -1;
+constexpr int MAX_PLAYERS = 4;
+
+// Open pads by user. They stay open while the user is signed in, across device refreshes (a
+// player joining or leaving), so the first player's handle - read directly by the in-game menu -
+// stays valid.
+std::map<int32_t, int32_t> s_handles;
+
+class Device final : public Core::Device
+{
+private:
+  class Button final : public Input
+  {
+  public:
+    Button(const char* name, const u32& buttons, u32 mask)
+        : m_name(name), m_buttons(buttons), m_mask(mask)
+    {
+    }
+    std::string GetName() const override { return m_name; }
+    ControlState GetState() const override { return (m_buttons & m_mask) != 0; }
+
+  private:
+    const char* const m_name;
+    const u32& m_buttons;
+    const u32 m_mask;
+  };
+
+  // A trigger (0..255) or one direction of a stick axis (0..255, centered at 128).
+  class Axis final : public Input
+  {
+  public:
+    Axis(const char* name, const u8& value, bool is_trigger, bool negative)
+        : m_name(name), m_value(value), m_is_trigger(is_trigger), m_negative(negative)
+    {
+    }
+    std::string GetName() const override { return m_name; }
+    ControlState GetState() const override
+    {
+      if (m_is_trigger)
+        return m_value / 255.0;
+      const ControlState centered = (m_value - 127.5) / 127.5;
+      return m_negative ? -centered : centered;
+    }
+
+  private:
+    const char* const m_name;
+    const u8& m_value;
+    const bool m_is_trigger;
+    const bool m_negative;
+  };
+
+  // One direction of a motion sensor axis: its positive part, scaled to Dolphin's units (m/s^2
+  // for acceleration, rad/s for rotation). Dolphin's IMU groups subtract opposite directions.
+  class Motion final : public Input
+  {
+  public:
+    Motion(const char* name, const float& value, double scale)
+        : m_name(name), m_value(value), m_scale(scale)
+    {
+    }
+    std::string GetName() const override { return m_name; }
+    ControlState GetState() const override { return std::max(0.0, m_value * m_scale); }
+    bool IsDetectable() const override { return false; }
+
+  private:
+    const char* const m_name;
+    const float& m_value;
+    const double m_scale;
+  };
+
+  class Motor final : public Output
+  {
+  public:
+    Motor(const char* name, Device& device, bool large) : m_name(name), m_device(device), m_large(large)
+    {
+    }
+    std::string GetName() const override { return m_name; }
+    void SetState(ControlState state) override { m_device.SetMotor(m_large, state); }
+
+  private:
+    const char* const m_name;
+    Device& m_device;
+    const bool m_large;
+  };
+
+public:
+  Device(int32_t user_id, int32_t handle) : m_user_id(user_id), m_handle(handle)
+  {
+    // clang-format off
+    AddInput(new Button("Cross",         m_buttons, ORBIS_PAD_BUTTON_CROSS));
+    AddInput(new Button("Circle",        m_buttons, ORBIS_PAD_BUTTON_CIRCLE));
+    AddInput(new Button("Square",        m_buttons, ORBIS_PAD_BUTTON_SQUARE));
+    AddInput(new Button("Triangle",      m_buttons, ORBIS_PAD_BUTTON_TRIANGLE));
+    AddInput(new Button("L1",            m_buttons, ORBIS_PAD_BUTTON_L1));
+    AddInput(new Button("R1",            m_buttons, ORBIS_PAD_BUTTON_R1));
+    AddInput(new Button("L2 Click",      m_buttons, ORBIS_PAD_BUTTON_L2));
+    AddInput(new Button("R2 Click",      m_buttons, ORBIS_PAD_BUTTON_R2));
+    AddInput(new Button("L3",            m_buttons, ORBIS_PAD_BUTTON_L3));
+    AddInput(new Button("R3",            m_buttons, ORBIS_PAD_BUTTON_R3));
+    AddInput(new Button("Options",       m_buttons, ORBIS_PAD_BUTTON_OPTIONS));
+    AddInput(new Button("Touchpad",      m_buttons, ORBIS_PAD_BUTTON_TOUCH_PAD));
+    AddInput(new Button("Pad N",         m_buttons, ORBIS_PAD_BUTTON_UP));
+    AddInput(new Button("Pad S",         m_buttons, ORBIS_PAD_BUTTON_DOWN));
+    AddInput(new Button("Pad W",         m_buttons, ORBIS_PAD_BUTTON_LEFT));
+    AddInput(new Button("Pad E",         m_buttons, ORBIS_PAD_BUTTON_RIGHT));
+
+    AddInput(new Axis("L2",              m_state.analogButtons.l2, true, false));
+    AddInput(new Axis("R2",              m_state.analogButtons.r2, true, false));
+    // Stick Y grows downwards (0 = up): "Y-" (up) is the lower half of the value range.
+    AddInput(new Axis("Left X-",         m_state.leftStick.x, false, true));
+    AddInput(new Axis("Left X+",         m_state.leftStick.x, false, false));
+    AddInput(new Axis("Left Y-",         m_state.leftStick.y, false, true));
+    AddInput(new Axis("Left Y+",         m_state.leftStick.y, false, false));
+    AddInput(new Axis("Right X-",        m_state.rightStick.x, false, true));
+    AddInput(new Axis("Right X+",        m_state.rightStick.x, false, false));
+    AddInput(new Axis("Right Y-",        m_state.rightStick.y, false, true));
+    AddInput(new Axis("Right Y+",        m_state.rightStick.y, false, false));
+
+    AddOutput(new Motor("Motor L",       *this, true));
+    AddOutput(new Motor("Motor R",       *this, false));
+
+    // Motion, for the Wii Remote (Settings -> System -> Motion Controls): the pad held like a
+    // remote pointing at the TV. libScePad: x right, y up, z towards the player; acceleration in
+    // g, rotation in rad/s (right-handed). OpenOrbis's OrbisPadData has the two vectors in the
+    // wrong order: Sony's ScePadData is orientation, acceleration, angular velocity, so "vel" holds
+    // the acceleration and "acell" the rotation (read the other way, a pad at rest showed zero
+    // acceleration).
+    m_motion_result = ps4_pad_set_motion(m_handle, true);
+    {
+      char line[96];
+      snprintf(line, sizeof(line), "DualShock 4 motion sensors on: %#x", static_cast<unsigned>(m_motion_result));
+      ps4_boot_trace(line);
+    }
+    AddInput(new Motion("Accel Up",       m_state.vel.y, GRAVITY));
+    AddInput(new Motion("Accel Down",     m_state.vel.y, -GRAVITY));
+    AddInput(new Motion("Accel Left",     m_state.vel.x, -GRAVITY));
+    AddInput(new Motion("Accel Right",    m_state.vel.x, GRAVITY));
+    AddInput(new Motion("Accel Forward",  m_state.vel.z, -GRAVITY));
+    AddInput(new Motion("Accel Backward", m_state.vel.z, GRAVITY));
+    AddInput(new Motion("Gyro Pitch Up",   m_state.acell.x, 1.0));
+    AddInput(new Motion("Gyro Pitch Down", m_state.acell.x, -1.0));
+    AddInput(new Motion("Gyro Roll Left",  m_state.acell.z, 1.0));
+    AddInput(new Motion("Gyro Roll Right", m_state.acell.z, -1.0));
+    AddInput(new Motion("Gyro Yaw Left",   m_state.acell.y, 1.0));
+    AddInput(new Motion("Gyro Yaw Right",  m_state.acell.y, -1.0));
+    // clang-format on
+  }
+
+  ~Device() override
+  {
+    // The pad itself stays open (s_handles); it is closed when its user signs out.
+    OrbisPadVibeParam off = {0, 0};
+    scePadSetVibration(m_handle, &off);
+  }
+
+  std::string GetName() const override { return "DualShock 4"; }
+  std::string GetSource() const override { return std::string(SOURCE_NAME); }
+  int32_t GetUserId() const { return m_user_id; }
+
+  Core::DeviceRemoval UpdateInput() override
+  {
+    OrbisPadData data;
+    std::memset(&data, 0, sizeof(data));
+    // scePadReadState: the latest state, motion included (verified on an official DualShock 4;
+    // copies without motion sensors report a fixed 0 0 -0.5). v03.30-v03.32 used scePadRead,
+    // which often returned nothing for half a second at a time: the pad looked frozen.
+    const bool have = !ps4_pad_block && scePadReadState(m_handle, &data) == 0 && data.connected;
+    if (have)
+    {
+      m_state = data;
+      m_buttons = data.buttons;
+      // Real motion sensors jitter even lying still; copies without them report fixed numbers
+      // (0 0 -0.5, no rotation). Until a reading moves, the pad looks like one lying still
+      // (gravity straight down, no rotation): the motion pointer then stays put and the right
+      // stick aims, instead of the copy's fake gravity tipping the pointer off the screen.
+      if (!m_motion_real)
+      {
+        if (m_reads > 0 &&
+            (data.vel.x != m_prev_motion[0] || data.vel.y != m_prev_motion[1] ||
+             data.vel.z != m_prev_motion[2] || data.acell.x != m_prev_motion[3] ||
+             data.acell.y != m_prev_motion[4] || data.acell.z != m_prev_motion[5]))
+        {
+          m_motion_real = true;
+          ps4_boot_trace("DualShock 4 motion sensors: working (motion pointer and tilt)");
+        }
+        m_prev_motion[0] = data.vel.x;
+        m_prev_motion[1] = data.vel.y;
+        m_prev_motion[2] = data.vel.z;
+        m_prev_motion[3] = data.acell.x;
+        m_prev_motion[4] = data.acell.y;
+        m_prev_motion[5] = data.acell.z;
+        if (!m_motion_real)
+        {
+          if (m_reads == 600)
+            ps4_boot_trace("DualShock 4 motion sensors: no readings (a copy?): the right stick aims");
+          m_state.vel.x = 0.0f;
+          m_state.vel.y = 1.0f;
+          m_state.vel.z = 0.0f;
+          m_state.acell.x = 0.0f;
+          m_state.acell.y = 0.0f;
+          m_state.acell.z = 0.0f;
+        }
+      }
+      // The sensors refused at open (the pad still settling)? Once more on the first reads.
+      if (m_motion_result != 0 && m_reads == 10)
+      {
+        m_motion_result = ps4_pad_set_motion(m_handle, true);
+        char line[96];
+        snprintf(line, sizeof(line), "DualShock 4 motion sensors on (retry): %#x",
+                 static_cast<unsigned>(m_motion_result));
+        ps4_boot_trace(line);
+      }
+      // Motion samples in the boot trace whenever the readings move (up to 10 lines, at most two
+      // a second). Verified on an official DualShock 4: x right, y up (about 1.0 lying flat), z
+      // towards the player, rotation in rad/s - SDL's layout, mapped the same way. Copies without
+      // motion sensors report a fixed 0 0 -0.5 and never move.
+      const float moved = std::abs(data.vel.x - m_logged_accel[0]) +
+                          std::abs(data.vel.y - m_logged_accel[1]) +
+                          std::abs(data.vel.z - m_logged_accel[2]) + std::abs(data.acell.x) +
+                          std::abs(data.acell.y) + std::abs(data.acell.z);
+      ++m_reads;
+      if (m_motion_logged < 10 && m_reads - m_last_logged_read >= 30 &&
+          (m_motion_logged == 0 || moved > 0.15f))
+      {
+        m_motion_logged++;
+        m_last_logged_read = m_reads;
+        m_logged_accel[0] = data.vel.x;
+        m_logged_accel[1] = data.vel.y;
+        m_logged_accel[2] = data.vel.z;
+        char line[200];
+        snprintf(line, sizeof(line),
+                 "DualShock 4 motion: accel %.2f %.2f %.2f, gyro %.2f %.2f %.2f, orientation %.2f %.2f "
+                 "%.2f %.2f",
+                 data.vel.x, data.vel.y, data.vel.z, data.acell.x, data.acell.y, data.acell.z,
+                 data.quat.x, data.quat.y, data.quat.z, data.quat.w);
+        ps4_boot_trace(line);
+      }
+    }
+    else
+    {
+      // Disconnected (or the user signed out): report a neutral pad.
+      m_buttons = 0;
+      m_state.leftStick = {128, 128};
+      m_state.rightStick = {128, 128};
+      m_state.analogButtons = {0, 0};
+    }
+    return Core::DeviceRemoval::Keep;
+  }
+
+  void SetMotor(bool large, ControlState state)
+  {
+    const u8 value = static_cast<u8>(std::clamp(state, 0.0, 1.0) * 255);
+    if (large)
+      m_vibration.lgMotor = value;
+    else
+      m_vibration.smMotor = value;
+    scePadSetVibration(m_handle, &m_vibration);
+  }
+
+private:
+  const int32_t m_user_id;
+  const int32_t m_handle;
+  OrbisPadData m_state{};
+  // Motion sensors seen moving (a pad without them reports fixed numbers), and the last readings.
+  bool m_motion_real = false;
+  float m_prev_motion[6]{};
+  u32 m_buttons = 0;
+  OrbisPadVibeParam m_vibration{0, 0};
+  int m_reads = 0;
+  int m_motion_logged = 0;
+  int m_last_logged_read = 0;
+  int32_t m_motion_result = 0;
+  float m_logged_accel[3] = {};
+};
+
+// A PlayStation Move motion controller, as a Wii Remote: buttons, the analog T trigger, motion
+// (the pointer comes from its gyroscope: Dolphin's "IMU point"). Named per player ("PS Move 1")
+// so the Wii Remote mappings can refer to it (PS4Controls.cpp).
+class MoveDevice final : public Core::Device
+{
+  class Button final : public Input
+  {
+  public:
+    Button(const char* name, const uint16_t& buttons, uint16_t mask)
+        : m_name(name), m_buttons(buttons), m_mask(mask)
+    {
+    }
+    std::string GetName() const override { return m_name; }
+    ControlState GetState() const override { return (m_buttons & m_mask) != 0; }
+
+  private:
+    const char* const m_name;
+    const uint16_t& m_buttons;
+    const uint16_t m_mask;
+  };
+  class Trigger final : public Input
+  {
+  public:
+    explicit Trigger(const uint16_t& value) : m_value(value) {}
+    std::string GetName() const override { return "T"; }
+    ControlState GetState() const override { return std::min(m_value, uint16_t(255)) / 255.0; }
+
+  private:
+    const uint16_t& m_value;
+  };
+  class Motion final : public Input
+  {
+  public:
+    Motion(const char* name, const float& value, double scale)
+        : m_name(name), m_value(value), m_scale(scale)
+    {
+    }
+    std::string GetName() const override { return m_name; }
+    ControlState GetState() const override { return std::max(0.0, m_value * m_scale); }
+    bool IsDetectable() const override { return false; }
+
+  private:
+    const char* const m_name;
+    const float& m_value;
+    const double m_scale;
+  };
+  class Rumble final : public Output
+  {
+  public:
+    explicit Rumble(int32_t handle) : m_handle(handle) {}
+    std::string GetName() const override { return "Motor"; }
+    void SetState(ControlState state) override
+    {
+      sceMoveSetVibration(m_handle, static_cast<uint8_t>(std::clamp(state, 0.0, 1.0) * 255));
+    }
+
+  private:
+    const int32_t m_handle;
+  };
+
+public:
+  MoveDevice(int32_t handle, int player) : m_handle(handle), m_name("PS Move " + std::to_string(player))
+  {
+    // clang-format off
+    AddInput(new Button("Move",     m_state.buttons, MOVE_MOVE));
+    AddInput(new Trigger(m_state.trigger));
+    AddInput(new Button("T Click",  m_state.buttons, MOVE_T));
+    AddInput(new Button("Cross",    m_state.buttons, MOVE_CROSS));
+    AddInput(new Button("Circle",   m_state.buttons, MOVE_CIRCLE));
+    AddInput(new Button("Square",   m_state.buttons, MOVE_SQUARE));
+    AddInput(new Button("Triangle", m_state.buttons, MOVE_TRIANGLE));
+    AddInput(new Button("Start",    m_state.buttons, MOVE_START));
+    AddInput(new Button("Select",   m_state.buttons, MOVE_SELECT));
+    // Held like a Wii Remote, the ball towards the TV, buttons up. Move axes as libScePad's with
+    // the controller upright: x right, y towards the ball, z out of the button face.
+    AddInput(new Motion("Accel Up",       m_state.accelerometer[2], GRAVITY));
+    AddInput(new Motion("Accel Down",     m_state.accelerometer[2], -GRAVITY));
+    AddInput(new Motion("Accel Left",     m_state.accelerometer[0], -GRAVITY));
+    AddInput(new Motion("Accel Right",    m_state.accelerometer[0], GRAVITY));
+    AddInput(new Motion("Accel Forward",  m_state.accelerometer[1], GRAVITY));
+    AddInput(new Motion("Accel Backward", m_state.accelerometer[1], -GRAVITY));
+    AddInput(new Motion("Gyro Pitch Up",   m_state.gyro[0], 1.0));
+    AddInput(new Motion("Gyro Pitch Down", m_state.gyro[0], -1.0));
+    AddInput(new Motion("Gyro Roll Left",  m_state.gyro[1], -1.0));
+    AddInput(new Motion("Gyro Roll Right", m_state.gyro[1], 1.0));
+    AddInput(new Motion("Gyro Yaw Left",   m_state.gyro[2], 1.0));
+    AddInput(new Motion("Gyro Yaw Right",  m_state.gyro[2], -1.0));
+    AddOutput(new Rumble(m_handle));
+    // clang-format on
+    // The ball in the player's colour (Wii Remote LEDs: blue, red, green, pink).
+    static const uint8_t COLOURS[4][3] = {{0, 90, 255}, {255, 40, 40}, {40, 220, 80}, {255, 80, 200}};
+    const uint8_t* colour = COLOURS[(player - 1) & 3];
+    sceMoveSetLightSphere(m_handle, colour[0], colour[1], colour[2]);
+  }
+
+  std::string GetName() const override { return m_name; }
+  std::string GetSource() const override { return std::string(SOURCE_NAME); }
+
+  Core::DeviceRemoval UpdateInput() override
+  {
+    MoveState state;
+    std::memset(&state, 0, sizeof(state));
+    if (!ps4_pad_block && sceMoveReadStateLatest(m_handle, &state) == 0)
+    {
+      if (state.buttons != m_logged_buttons && m_button_logs < 20)
+      {
+        // Which bit is which button on real hardware (the first presses, in the boot trace).
+        m_button_logs++;
+        m_logged_buttons = state.buttons;
+        char line[96];
+        snprintf(line, sizeof(line), "%s buttons %#06x trigger %u", m_name.c_str(), state.buttons,
+                 state.trigger);
+        ps4_boot_trace(line);
+      }
+      if (m_motion_logs < 3 && ++m_reads % 120 == 0)
+      {
+        m_motion_logs++;
+        char line[200];
+        snprintf(line, sizeof(line), "%s motion: accel %.2f %.2f %.2f, gyro %.2f %.2f %.2f",
+                 m_name.c_str(), state.accelerometer[0], state.accelerometer[1],
+                 state.accelerometer[2], state.gyro[0], state.gyro[1], state.gyro[2]);
+        ps4_boot_trace(line);
+      }
+      m_state = state;
+    }
+    else
+    {
+      m_state.buttons = 0;
+      m_state.trigger = 0;
+    }
+    return Core::DeviceRemoval::Keep;
+  }
+
+private:
+  const int32_t m_handle;
+  const std::string m_name;
+  MoveState m_state{};
+  uint16_t m_logged_buttons = 0;
+  int m_button_logs = 0;
+  int m_reads = 0;
+  int m_motion_logs = 0;
+};
+
+// Move handles by user, open while the user is signed in (like s_handles).
+static std::map<int32_t, int32_t> s_move_handles;
+
+static int32_t MoveHandle(int32_t user)
+{
+  if (const auto it = s_move_handles.find(user); it != s_move_handles.end())
+    return it->second;
+  if (!ps4_move_enabled)
+    return -1;
+  // libSceMove is linked into the app (loaded with it), so no sceSysmoduleLoadModule. Each step is
+  // traced first, so a crash inside the library shows where.
+  static int s_init = 1;
+  if (s_init == 1)
+  {
+    // sceMoveInit killed the app on some consoles (a firmware 12.02 report: CE-34878-0 at every
+    // Wii game start with Wii Remote Controller on Auto). A marker file is left while it runs: if
+    // the app dies inside it, the next start finds the marker and leaves PS Move alone for good.
+    static const char* const MARKER = "/data/DolphinPS4/ps-move-init-crashed";
+    if (access(MARKER, F_OK) == 0)
+    {
+      ps4_boot_trace("PS Move: off (sceMoveInit ended the app before; delete "
+                     "/data/DolphinPS4/ps-move-init-crashed to try again)");
+      s_init = -1;
+      return -1;
+    }
+    const int marker = open(MARKER, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+    if (marker >= 0)
+    {
+      fsync(marker);
+      close(marker);
+    }
+    ps4_boot_trace("PS Move: init");
+    s_init = sceMoveInit();
+    unlink(MARKER);
+    char line[64];
+    snprintf(line, sizeof(line), "PS Move: init %#x", static_cast<unsigned>(s_init));
+    ps4_boot_trace(line);
+  }
+  if (s_init != 0)
+    return -1;
+  char line[64];
+  snprintf(line, sizeof(line), "PS Move: open user %#x", static_cast<unsigned>(user));
+  ps4_boot_trace(line);
+  const int32_t handle = sceMoveOpen(user, 0, 0);
+  snprintf(line, sizeof(line), "PS Move: handle %#x", static_cast<unsigned>(handle));
+  ps4_boot_trace(line);
+  if (handle >= 0)
+    s_move_handles[user] = handle;
+  return handle;
+}
+
+static bool MoveConnected(int32_t handle)
+{
+  MoveState state;
+  return handle >= 0 && sceMoveReadStateLatest(handle, &state) == 0;
+}
+
+class InputBackend final : public ciface::InputBackend
+{
+public:
+  explicit InputBackend(ControllerInterface* controller_interface)
+      : ciface::InputBackend(controller_interface)
+  {
+    int32_t result = sceUserServiceInitialize(nullptr);
+    // Already initialized by another part of the app is fine.
+    if (result != 0 && result != static_cast<int32_t>(0x80960003))
+      WARN_LOG_FMT(CONTROLLERINTERFACE, "sceUserServiceInitialize: {:#x}", static_cast<u32>(result));
+    result = scePadInit();
+    if (result != 0)
+      ERROR_LOG_FMT(CONTROLLERINTERFACE, "scePadInit: {:#x}", static_cast<u32>(result));
+  }
+
+  void PopulateDevices() override
+  {
+    GetControllerInterface().RemoveDevice(
+        [](const auto* device) { return device->GetSource() == SOURCE_NAME; });
+
+    // Players in order: the user who started the app first (player 1, who also has the in-game
+    // menu), then the other signed-in users in sign-in order. Each one's DualShock 4 becomes
+    // "PS4/<player - 1>/DualShock 4" (the controller mappings, DolphinNoGUI/PS4Controls.cpp).
+    int32_t initial = INVALID_USER;
+    sceUserServiceGetInitialUser(&initial);
+    OrbisUserServiceLoginUserIdList users;
+    std::memset(&users, 0xFF, sizeof(users));
+    if (sceUserServiceGetLoginUserIdList(&users) != 0)
+      std::memset(&users, 0xFF, sizeof(users));
+    std::vector<int32_t> players;
+    if (initial != INVALID_USER)
+      players.push_back(initial);
+    for (const int32_t user : users.userId)
+    {
+      if (user != INVALID_USER && user != initial && players.size() < MAX_PLAYERS)
+        players.push_back(user);
+    }
+
+    // Users who signed out: close their pads.
+    for (auto it = s_handles.begin(); it != s_handles.end();)
+    {
+      if (std::find(players.begin(), players.end(), it->first) == players.end())
+      {
+        INFO_LOG_FMT(CONTROLLERINTERFACE, "DualShock 4 of user {:#x} closed",
+                     static_cast<u32>(it->first));
+        if (ps4_pad_handle == it->second)
+          ps4_pad_handle = -1;
+        scePadClose(it->second);
+        it = s_handles.erase(it);
+      }
+      else
+      {
+        ++it;
+      }
+    }
+
+    int count = 0;
+    for (const int32_t user : players)
+    {
+      auto it = s_handles.find(user);
+      if (it == s_handles.end())
+      {
+        const int32_t handle = scePadOpen(user, ORBIS_PAD_PORT_TYPE_STANDARD, 0, nullptr);
+        if (handle < 0)
+        {
+          WARN_LOG_FMT(CONTROLLERINTERFACE, "scePadOpen(user {:#x}): {:#x}",
+                       static_cast<u32>(user), static_cast<u32>(handle));
+          char line[96];
+          snprintf(line, sizeof(line), "controllers: user %#x has no DualShock 4 (scePadOpen %#x)",
+                   static_cast<unsigned>(user), static_cast<unsigned>(handle));
+          ps4_boot_trace(line);
+          continue;
+        }
+        INFO_LOG_FMT(CONTROLLERINTERFACE, "DualShock 4 of user {:#x} opened (handle {})",
+                     static_cast<u32>(user), handle);
+        it = s_handles.emplace(user, handle).first;
+      }
+      if (count == 0)
+        ps4_pad_handle = it->second;
+      GetControllerInterface().AddDevice(std::make_shared<Device>(user, it->second));
+      count++;
+    }
+    ps4_pad_count = count;
+    {
+      char line[96];
+      snprintf(line, sizeof(line), "controllers: %zu signed-in users, %d DualShock 4 open",
+               players.size(), count);
+      ps4_boot_trace(line);
+    }
+    // PS Move controllers (turned on before the game starts), one per player.
+    for (size_t player = 0; player < players.size(); player++)
+    {
+      const int32_t handle = MoveHandle(players[player]);
+      if (MoveConnected(handle))
+      {
+        GetControllerInterface().AddDevice(
+            std::make_shared<MoveDevice>(handle, static_cast<int>(player) + 1));
+        INFO_LOG_FMT(CONTROLLERINTERFACE, "PS Move of player {} found", player + 1);
+      }
+    }
+  }
+};
+
+std::unique_ptr<ciface::InputBackend> CreateInputBackend(ControllerInterface* controller_interface)
+{
+  return std::make_unique<InputBackend>(controller_interface);
+}
+}  // namespace ciface::PS4Pad
+
+extern "C" int ps4_move_connected(int32_t user_id)
+{
+  return ciface::PS4Pad::MoveConnected(ciface::PS4Pad::MoveHandle(user_id)) ? 1 : 0;
+}
