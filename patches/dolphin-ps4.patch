+// The demo's badges: a coloured disc with a star (grey when locked).
+BadgePixels DemoBadge(uint32_t id, bool locked)
+{
+  static const u32 COLOURS[] = {0x3C8CFF, 0xFFB43C, 0x50C878, 0xE05A5A, 0xA06CFF, 0x3CC8C8};
+  const u32 c = COLOURS[id % std::size(COLOURS)];
+  BadgePixels p;
+  p.width = p.height = 64;
+  p.rgba.resize(64 * 64 * 4);
+  for (int y = 0; y < 64; y++)
+  {
+    for (int x = 0; x < 64; x++)
+    {
+      const float dx = (x - 31.5f) / 31.5f, dy = (y - 31.5f) / 31.5f;
+      const float r = std::sqrt(dx * dx + dy * dy);
+      const float angle = std::atan2(dy, dx);
+      const float star = 0.38f + 0.2f * std::cos(5.0f * angle + 1.5708f);
+      float k = r > 1.0f ? 0.0f : 1.0f - 0.35f * r;
+      if (r < star)
+        k = 1.25f;
+      int rr = static_cast<int>(((c >> 16) & 0xFF) * k), g = static_cast<int>(((c >> 8) & 0xFF) * k),
+          b = static_cast<int>((c & 0xFF) * k);
+      if (locked)
+        rr = g = b = (rr * 30 + g * 59 + b * 11) / 140;
+      u8* out = &p.rgba[(y * 64 + x) * 4];
+      out[0] = static_cast<u8>(std::min(rr, 255));
+      out[1] = static_cast<u8>(std::min(g, 255));
+      out[2] = static_cast<u8>(std::min(b, 255));
+      out[3] = r > 1.0f ? 0 : 255;
+    }
+  }
+  return p;
+}
+
+// The game's achievements from RetroAchievements (false: none loaded - not logged in, or a game
+// RetroAchievements doesn't know).
+bool CaptureAchievements(PS4Achievements::List* out)
+{
+  if (DemoMode())
+  {
+    PS4Achievements::List list = s_demo_list;
+    list.total = static_cast<uint32_t>(list.entries.size());
+    list.unlocked = 0;
+    list.points = list.points_total = 0;
+    for (const PS4Achievements::Entry& entry : list.entries)
+    {
+      list.points_total += entry.points;
+      if (entry.unlocked)
+      {
+        list.unlocked++;
+        list.points += entry.points;
+      }
+    }
+    *out = std::move(list);
+    return true;
+  }
+#ifdef USE_RETRO_ACHIEVEMENTS
+  auto& manager = AchievementManager::GetInstance();
+  std::lock_guard lock(manager.GetLock());
+  rc_client_t* client = manager.GetClient();
+  if (!client || !rc_client_is_game_loaded(client))
+    return false;
+  PS4Achievements::List list;
+  rc_client_user_game_summary_t summary{};
+  rc_client_get_user_game_summary(client, &summary);
+  const rc_client_game_t* game = rc_client_get_game_info(client);
+  list.game = game && game->title ? game->title : "";
+  list.badge = game ? game->badge_name : "";
+  list.unlocked = summary.num_unlocked_achievements;
+  list.total = summary.num_core_achievements;
+  list.points = summary.points_unlocked;
+  list.points_total = summary.points_core;
+  list.hardcore = rc_client_get_hardcore_enabled(client) != 0;
+  rc_client_achievement_list_t* achievements = rc_client_create_achievement_list(
+      client, RC_CLIENT_ACHIEVEMENT_CATEGORY_CORE, RC_CLIENT_ACHIEVEMENT_LIST_GROUPING_LOCK_STATE);
+  if (achievements)
+  {
+    for (uint32_t b = 0; b < achievements->num_buckets; b++)
+    {
+      const rc_client_achievement_bucket_t& bucket = achievements->buckets[b];
+      for (uint32_t i = 0; i < bucket.num_achievements; i++)
+      {
+        const rc_client_achievement_t* a = bucket.achievements[i];
+        PS4Achievements::Entry entry;
+        entry.title = a->title ? a->title : "";
+        entry.description = a->description ? a->description : "";
+        entry.progress = a->measured_progress;
+        entry.points = a->points;
+        entry.unlocked = a->state == RC_CLIENT_ACHIEVEMENT_STATE_UNLOCKED;
+        entry.unlock_time = static_cast<int64_t>(a->unlock_time);
+        entry.badge = a->badge_name;
+        entry.id = a->id;
+        entry.type = a->type;
+        entry.rarity = list.hardcore ? a->rarity_hardcore : a->rarity;
+        list.entries.push_back(std::move(entry));
+      }
+    }
+    rc_client_destroy_achievement_list(achievements);
+  }
+  *out = std::move(list);
+  return true;
+#else
+  (void)out;
+  return false;
+#endif
+}
