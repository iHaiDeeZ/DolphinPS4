+// A clean stop writes the memory cards; the app then restarts into the XMB (PlatformPS4).
+void QuitToXMB(Core::System& system, const char* why)
+{
+  FlushPlayTime();
+  SaveAchievements();
+  Log(why);
+  s_quit = true;
+  s_quit_time = Clock::now();
+  {
+    std::lock_guard lock(s_mutex);
+    s_open = false;
+  }
+  s_watch = false;
+  Core::Stop(system);
+}
+
+// Hotkey capture (Settings -> Hotkeys, Cross): the buttons held together, taken when they are
+// all released; Circle alone cancels.
+std::string s_capture_key;
+uint32_t s_capture_seen = 0;
+bool s_capture_armed = false;
+Clock::time_point s_capture_start;
+
+void StartCapture(const std::string& key)
+{
+  s_capture_key = key;
+  s_capture_seen = 0;
+  s_capture_armed = false;
+  s_capture_start = Clock::now();
+  Toast("Hold the buttons together, then let go", 8000);
+}
+
+void UpdateCapture(uint32_t held)
+{
+  held &= PS4Settings::HotkeyButtons();
+  if (!s_capture_armed)
+  {
+    s_capture_armed = held == 0;  // Cross, which started this, released first
+    return;
+  }
+  if (Clock::now() - s_capture_start > std::chrono::seconds(10))
+  {
+    s_capture_key.clear();
+    Toast("Hotkey unchanged");
+    return;
+  }
+  if (held)
+  {
+    s_capture_seen |= held;
+    return;
+  }
+  if (!s_capture_seen)
+    return;
+  const uint32_t mask = s_capture_seen;
+  s_capture_seen = 0;
+  if (mask == ORBIS_PAD_BUTTON_CIRCLE)
+  {
+    s_capture_key.clear();
+    Toast("Hotkey unchanged");
+    return;
+  }
+  if (__builtin_popcount(mask) < 2)
+  {
+    s_capture_start = Clock::now();
+    Toast("Two or more buttons together", 4000);
+    return;
+  }
+  if (mask == (ORBIS_PAD_BUTTON_L3 | ORBIS_PAD_BUTTON_R3))
+  {
+    s_capture_start = Clock::now();
+    Toast("L3 + R3 opens this menu: try other buttons", 4000);
+    return;
+  }
+  const std::string name = PS4Settings::HotkeyName(mask);
+  PS4Settings::Set(s_capture_key, name, {});
+  const PS4Settings::Setting* setting = PS4Settings::Find(s_capture_key);
+  Toast((setting ? std::string(setting->label) : s_capture_key) + ": " + name);
+  Log("hotkey " + s_capture_key + "=" + name);
+  s_capture_key.clear();
+  BuildRows();
+}
+
+// While a game runs (menu closed): Save State / Load State on their hotkeys, current slot.
+void CheckHotkeys(Core::System& system, uint32_t held, uint32_t pressed)
+{
+  static std::string s_save_text, s_load_text;
+  static uint32_t s_save_mask = 0, s_load_mask = 0;
+  const std::string save = PS4Settings::Get("hotkey_save");
+  const std::string load = PS4Settings::Get("hotkey_load");
+  if (save != s_save_text)
+  {
+    s_save_text = save;
+    s_save_mask = PS4Settings::HotkeyMask(save);
+  }
+  if (load != s_load_text)
+  {
+    s_load_text = load;
+    s_load_mask = PS4Settings::HotkeyMask(load);
+  }
+  const auto fired = [&](uint32_t mask) {
+    return __builtin_popcount(mask) >= 2 && (held & mask) == mask && (pressed & mask);
+  };
+  if (fired(s_save_mask))
+  {
+    ps4_pad_block = 1;  // the game sees a neutral pad until the buttons are released
+    if (ps4_state_busy > 0)
+    {
+      Toast("Still saving, please wait...");
+      return;
+    }
+    Log("hotkey: saving state " + std::to_string(s_slot));
+    s_saving_slot = s_slot;
+    State::Save(system, static_cast<u32>(s_slot));
+    Toast("Saving to slot " + std::to_string(s_slot) + "...");
+  }
+  else if (fired(s_load_mask))
+  {
+    ps4_pad_block = 1;
+#ifdef USE_RETRO_ACHIEVEMENTS
+    if (AchievementManager::GetInstance().IsHardcoreModeActive())
+    {
+      Toast("Hardcore Mode is on: no loading states. Turn it off in the game list: Settings -> "
+            "RetroAchievements",
+            6000);
+      return;
+    }
+#endif
+    if (ps4_state_busy > 0)
+    {
+      Toast("Still saving, please wait...");
+      return;
+    }
+    std::string made_by;
+    const State::PS4Slot status = State::PS4CheckSlot(static_cast<u32>(s_slot), &made_by);
+    if (status != State::PS4Slot::Ready)
+    {
+      Toast(SlotProblem(s_slot, status, made_by), 4500);
+      return;
+    }
+    Log("hotkey: loading state " + std::to_string(s_slot));
+    s_loading_slot = s_slot;
+    State::Load(system, static_cast<u32>(s_slot));
+    Toast("Loading slot " + std::to_string(s_slot) + "...");
+  }
+}
+
+void Activate(Core::System& system)
+{
+  if (s_page != Page::Main)
+  {
+    if (s_page == Page::Settings && s_settings_selected >= 0 &&
+        s_settings_selected < static_cast<int>(s_row_keys.size()) &&
+        PS4Settings::IsHotkey(s_row_keys[s_settings_selected]))
+    {
+      StartCapture(s_row_keys[s_settings_selected]);
+      return;
+    }
+    ChangeSetting(s_settings_selected, 1);
+    return;
+  }
+  switch (s_main_items[s_main_selected])
+  {
+  case MAIN_WII_EXTENSION:
+  case MAIN_WII_SIDEWAYS:
+  case MAIN_WII_TILT:
+    ToggleWiiRemote(s_main_items[s_main_selected]);
+    break;
+  case MAIN_RESUME:
+    Close(system);
+    break;
+  case MAIN_SAVE:
+    if (ps4_state_busy > 0)
+    {
+      Toast("Still saving, please wait...");
+      break;
+    }
+    Log("saving state " + std::to_string(s_slot));
+    s_saving_slot = s_slot;
+    State::Save(system, static_cast<u32>(s_slot));
+    Toast("Saving to slot " + std::to_string(s_slot) + "...");
+    break;
+  case MAIN_LOAD:
+    if (ps4_state_busy > 0)
+    {
+      Toast("Still saving, please wait...");
+      break;
+    }
+#ifdef USE_RETRO_ACHIEVEMENTS
+    if (AchievementManager::GetInstance().IsHardcoreModeActive())
+    {
+      Toast("Hardcore Mode is on: no loading states. Turn it off in the game list: Settings -> "
+            "RetroAchievements",
+            6000);
+      break;
+    }
+#endif
+    {
+      // Only states this version can load: a refused one leaves the game as it was, and the menu
+      // stays open with the reason.
+      std::string made_by;
+      const State::PS4Slot status = State::PS4CheckSlot(static_cast<u32>(s_slot), &made_by);
+      if (status != State::PS4Slot::Ready)
+      {
+        Log("slot " + std::to_string(s_slot) + " not loadable (" + std::to_string(int(status)) +
+            ", made by \"" + made_by + "\")");
+        Toast(SlotProblem(s_slot, status, made_by), 4500);
+        break;
+      }
+      Log("loading state " + std::to_string(s_slot) + " (made by " + made_by + ")");
+      s_loading_slot = s_slot;
+      State::Load(system, static_cast<u32>(s_slot));
+      Log("load requested " + std::to_string(s_slot));
+      Close(system);
+      break;
+    }
+  case MAIN_SETTINGS:
+    s_page = Page::Settings;
+    s_settings_selected = 0;
+    break;
+  case MAIN_CONTROLS:
+    s_page = Page::Controls;
+    s_settings_selected = 0;
+    break;
+  case MAIN_ACHIEVEMENTS:
+    s_page = Page::Achievements;
+    s_ach_loaded = CaptureAchievements(&s_ach);
+    if (s_ach_loaded)
+      CopyPageBadges();
+    s_settings_selected = 0;
+    break;
+  case MAIN_CHEATS:
+    s_page = Page::Cheats;
+    s_cheats.Load(s_game_id, SConfig::GetInstance().GetRevision());
+    s_settings_selected = 0;
+    BuildRows();
+    // First selectable row (row 0 is the first header).
+    SelectableMove(1);
+    if (!s_row_keys.empty() && s_row_keys[s_settings_selected].empty())
+      s_settings_selected = 0;
+    break;
+  case MAIN_RESTART:
+    // The same clean stop as Quit Game (memory cards and the NAND are written as the game saves);
+    // the app then restarts into this game instead of the menu: a fresh boot, like a console reset.
+    s_restart = true;
+    QuitToXMB(system, "restart the game");
+    break;
+  case MAIN_QUIT:
+    QuitToXMB(system, "quit to the XMB");
+    break;
+  }
+}
