+
+// The game stopped without the in-game menu's Quit Game: data_dir/last-stop.txt for the menu
+// (PS4XMB.cpp shows it once, then removes it): the panel's title, then its lines. The game's part
+// is prepared at its start, so the crash handler (a signal handler) only open()s and write()s.
+char s_stop_game[512] = {};
+// The app is restarting into the menu or closing (OnExit): a crash now is a thread of the
+// process being replaced - no note, and no crash report; the restart in progress finishes.
+volatile int s_exiting = 0;
+char s_stop_path[512] = {};
+char s_to_menu_path[512] = {};
+
+void SetStopGame(const std::string& title, const std::string& id)
+{
+  snprintf(s_stop_game, sizeof(s_stop_game), "%s%s%s\n", title.c_str(),
+           id.empty() ? "" : "  -  ", id.c_str());
+  snprintf(s_stop_path, sizeof(s_stop_path), "%s/last-stop.txt", PS4_DATA_DIR_PATH);
+  snprintf(s_to_menu_path, sizeof(s_to_menu_path), "%s/to-menu.txt", PS4_DATA_DIR_PATH);
+  ps4_self_path();  // its path made now: the crash handler mustn't allocate
+}
+
+void WriteStopNote(const char* title, const char* what, const char* where)
+{
+  if (!s_stop_game[0])
+    return;
+  const int fd = open(s_stop_path, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+  if (fd < 0)
+    return;
+  const auto put = [fd](const char* text) {
+    if (text)
+      write(fd, text, strlen(text));
+  };
+  put(title);
+  put("\n\n");
+  put(s_stop_game);
+  put("\n");
+  put(what);
+  put("\n\n");
+  put(where);
+  put("\n");
+  close(fd);
+  // Back to the game list, not into the default game again (to-menu.txt).
+  const int menu = open(s_to_menu_path, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+  if (menu >= 0)
+    close(menu);
+}
+
+// The game didn't start (MainNoGUI): its own note, kept by OnExit.
+bool s_boot_failed = false;
+
+void OnExit()
+{
+  s_exiting = 1;
+  ps4_sampler_shutdown();
+  // The raw exit syscall isn't allowed for apps: ask the system to close us, or restart into the
+  // XMB when the in-game menu's "Quit Game" stopped the emulation.
+  fflush(stderr);
+  if (PS4IngameMenu::RestartGame())
+  {
+    ps4_relaunch_game();
+    sceSystemServiceLoadExec(ps4_self_path(), nullptr);
+  }
+  if (PS4IngameMenu::ReturnToXMB())
+  {
+    ps4_return_to_menu();
+    sceSystemServiceLoadExec(ps4_self_path(), nullptr);
+  }
+  if (s_stop_game[0] && s_boot_failed && Platform::GetPS4Option("xmb", "on") == "on")
+  {
+    Platform::BootTrace("the game didn't start: back to the menu");
+    sceSystemServiceLoadExec(ps4_self_path(), nullptr);
+  }
+  if (s_stop_game[0] && Platform::GetPS4Option("xmb", "on") == "on")
+  {
+    // The emulation ended by itself (an error, or the game ended): back to the game list with why.
+    Platform::BootTrace("the game stopped by itself: back to the menu");
+    WriteStopNote("Game Stopped", "The game stopped unexpectedly.",
+                  "Details are in dolphin.log and boot-trace.log (in /data/DolphinPS4).");
+    sceSystemServiceLoadExec(ps4_self_path(), nullptr);
+  }
+  sceSystemServiceLoadExec("exit", nullptr);
+  for (;;)
+    sceKernelUsleep(100000);
+}
