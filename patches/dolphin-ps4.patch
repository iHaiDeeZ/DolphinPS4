+u32 s_sqrt_errno_offset = 0;  // errno = r13 + this (s16)
+u32 s_sqrt_nan_address = 0;   // the single-precision NaN returned for negative inputs
+
+void SetErrno(const Core::CPUThreadGuard& guard, u32 value)
+{
+  auto& ppc = guard.GetSystem().GetPPCState();
+  PowerPC::MMU::HostWrite<u32>(guard, value, ppc.gpr[13] + s_sqrt_errno_offset);
+}
+}  // namespace
+
+void FdlibmSqrt(const Core::CPUThreadGuard& guard)
+{
+  auto& ppc = guard.GetSystem().GetPPCState();
+  const u64 bits = ppc.ps[1].PS0AsU64();
+  const u32 hx = static_cast<u32>(bits >> 32);
+  const u32 lx = static_cast<u32>(bits);
+  constexpr u32 GAME_EDOM = 33;  // MSL errno for a domain error
+  if ((hx & 0x7ff00000) == 0x7ff00000)
+  {
+    // Inf or NaN: x*x + x, errno = EDOM. NaN -> the same NaN quieted; +inf -> +inf; -inf ->
+    // inf + -inf = the PowerPC default NaN (positive, unlike x86's).
+    u64 result;
+    if ((bits & 0x000fffffffffffffULL) != 0)
+      result = bits | 0x0008000000000000ULL;
+    else if (static_cast<s32>(hx) > 0)
+      result = bits;
+    else
+      result = 0x7ff8000000000000ULL;
+    SetErrno(guard, GAME_EDOM);
+    ppc.ps[1].SetPS0(result);
+  }
+  else if (static_cast<s32>(hx) <= 0 && (((hx & 0x7fffffff) | lx) == 0))
+  {
+    // +-0: returned as it is.
+  }
+  else if (static_cast<s32>(hx) < 0)
+  {
+    // Negative: errno = EDOM, the NaN constant (lfs: both halves of f1).
+    SetErrno(guard, GAME_EDOM);
+    const u32 single = PowerPC::MMU::HostRead<u32>(guard, s_sqrt_nan_address);
+    float f;
+    std::memcpy(&f, &single, 4);
+    u64 as_double;
+    const double d = static_cast<double>(f);
+    std::memcpy(&as_double, &d, 8);
+    // A float NaN widens with its payload; keep the quiet bit as the conversion does.
+    ppc.ps[1].SetBoth(as_double, as_double);
+  }
+  else
+  {
+    // Positive (normal or denormal): correctly rounded, round to nearest, denormals kept.
+    const unsigned saved = _mm_getcsr();
+    _mm_setcsr((saved & ~0xE040u) | 0x1F80u);  // RC = nearest, FTZ/DAZ off, exceptions masked
+    double x;
+    std::memcpy(&x, &bits, 8);
+    const double r = _mm_cvtsd_f64(_mm_sqrt_sd(_mm_set_sd(x), _mm_set_sd(x)));
+    _mm_setcsr(saved);
+    u64 out;
+    std::memcpy(&out, &r, 8);
+    ppc.ps[1].SetPS0(out);
+  }
+  ppc.npc = ppc.spr[SPR_LR];
+}
+
+namespace
+{
+// Every place in MEM1 and MEM2 that holds the function (normally one).
+std::vector<u32> FindFdlibmSqrt(Core::System& system)
+{
+  std::vector<u32> found;
+  auto& memory = system.GetMemory();
+  auto scan = [&](const u8* base, u32 size, u32 guest_base) {
+    if (!base)
+      return;
+    for (u32 offset = 0; offset + 146 * 4 <= size; offset += 4)
+    {
+      u32 first;
+      std::memcpy(&first, base + offset, 4);
+      if (Common::swap32(first) != FDLIBM_SQRT_CODE[0])
+        continue;
+      bool match = true;
+      for (u32 i = 1; i < 146 && match; i++)
+      {
+        u32 word;
+        std::memcpy(&word, base + offset + i * 4, 4);
+        word = Common::swap32(word);
+        match = (word & FDLIBM_SQRT_CODE[i * 2 + 1]) ==
+                (FDLIBM_SQRT_CODE[i * 2] & FDLIBM_SQRT_CODE[i * 2 + 1]);
+      }
+      if (match)
+        found.push_back(guest_base + offset);
+    }
+  };
+  scan(memory.GetRAM(), memory.GetRamSizeReal(), 0x80000000);
+  scan(memory.GetEXRAM(), memory.GetExRamSizeReal(), 0x90000000);
+  return found;
+}
+
+template <size_t N>
+bool CodeMatches(Core::System& system, u32 address, const std::array<u32, N>& code)
+{
+  auto& memory = system.GetMemory();
+  const u32 offset = address & 0x01FFFFFF;
+  if (offset + N * 4 > memory.GetRamSizeReal())
+    return false;
+  for (size_t i = 0; i < N; i++)
+  {
+    u32 word;
+    std::memcpy(&word, memory.GetRAM() + offset + i * 4, 4);
+    if (Common::swap32(word) != code[i])
+      return false;
+  }
+  return true;
+}
+}  // namespace
+
+const std::array<PS4Hook, 4> HOOKS = {{
+    {"PS4_Crash_cb5c4", CrashLoopCB5C4},
+    {"PS4_Crash_cb694", CrashLoopCB694},
+    {"PS4_Crash_caf2c", CrashLoopCAF2C},
+    {"PS4_fdlibm_sqrt", FdlibmSqrt},
+}};
+
+void PatchGame(Core::System& system)
+{
+  if (!ps4_game_hle)
+    return;
+  // Every game: fdlibm's square root, wherever it is.
+  if (!ps4_game_hle_only[0] || strcmp(ps4_game_hle_only, "PS4_fdlibm_sqrt") == 0)
+  {
+    const std::vector<u32> sites = FindFdlibmSqrt(system);
+    for (const u32 address : sites)
+    {
+      // Straight from RAM (no CPU thread guard here at boot); FindFdlibmSqrt read it the same way.
+      auto& memory = system.GetMemory();
+      const u8* base = (address >> 28) == 0x9 ? memory.GetEXRAM() + (address & 0x0FFFFFFF) :
+                                                memory.GetRAM() + (address & 0x01FFFFFF);
+      const auto low = [&](u32 offset) {
+        u32 word;
+        std::memcpy(&word, base + offset, 4);
+        return Common::swap32(word) & 0xFFFF;
+      };
+      const u32 errno1 = low(0x28), errno2 = low(0x58);
+      if (errno1 != errno2)
+        continue;
+      s_sqrt_errno_offset = static_cast<u32>(static_cast<s32>(static_cast<s16>(errno1)));
+      s_sqrt_nan_address = (low(0x54) << 16) + static_cast<u32>(static_cast<s32>(static_cast<s16>(low(0x5c))));
+      HLE::Patch(system, address, "PS4_fdlibm_sqrt");
+      char line[160];
+      snprintf(line, sizeof(line), "game HLE: fdlibm sqrt at %08x (errno r13%+d, NaN at %08x)",
+               address, static_cast<s32>(s_sqrt_errno_offset), s_sqrt_nan_address);
+      ps4_boot_trace(line);
+    }
+    if (sites.empty())
+      ps4_boot_trace("game HLE: no fdlibm sqrt found");
+  }
+  const std::string game_id = SConfig::GetInstance().GetGameID();
+  if (game_id != "GCBE7D")
+    return;
+  struct Site
+  {
+    u32 address;
+    const char* name;
+    bool ok;
+  };
+  const Site sites[] = {
+      {CRASH_CB5C4, "PS4_Crash_cb5c4", CodeMatches(system, CRASH_CB5C4, CRASH_CB5C4_CODE)},
+      {CRASH_CB694, "PS4_Crash_cb694", CodeMatches(system, CRASH_CB694, CRASH_CB694_CODE)},
+      {CRASH_CAF2C, "PS4_Crash_caf2c", CodeMatches(system, CRASH_CAF2C, CRASH_CAF2C_CODE)},
+  };
+  for (const Site& site : sites)
+  {
+    if (ps4_game_hle_only[0] && strcmp(ps4_game_hle_only, site.name) != 0)
+      continue;
+    if (site.ok)
+      HLE::Patch(system, site.address, site.name);
+    char line[160];
+    snprintf(line, sizeof(line), "game HLE: %s at %08x %s", site.name, site.address,
+             site.ok ? "installed" : "NOT installed (code differs)");
+    ps4_boot_trace(line);
+  }
+}
+}  // namespace HLE_PS4Games
