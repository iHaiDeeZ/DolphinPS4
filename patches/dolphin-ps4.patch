+// The film's frames taken after newer_than_ms and up to up_to_ms, newest first (video thread).
+int ps4_film_frames(long long newer_than_ms, long long up_to_ms, void** textures, long long* times,
+                    int max)
+{
+  std::vector<const PS4FilmFrame*> frames;
+  for (const PS4FilmFrame& frame : s_film)
+  {
+    if (frame.texture && frame.time_ms > newer_than_ms && frame.time_ms <= up_to_ms)
+      frames.push_back(&frame);
+  }
+  std::sort(frames.begin(), frames.end(),
+            [](const PS4FilmFrame* a, const PS4FilmFrame* b) { return a->time_ms > b->time_ms; });
+  int n = 0;
+  for (const PS4FilmFrame* frame : frames)
+  {
+    if (n >= max)
+      break;
+    textures[n] = frame->texture.get();
+    times[n] = frame->time_ms;
+    n++;
+  }
+  return n;
