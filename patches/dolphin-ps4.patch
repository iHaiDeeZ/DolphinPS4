+// "Slot 2 was saved by ..." for a state that this version can't load.
+std::string SlotProblem(int slot, State::PS4Slot status, const std::string& made_by)
+{
+  const std::string name = "Slot " + std::to_string(slot);
+  switch (status)
+  {
+  case State::PS4Slot::Empty:
+    return name + " is empty";
+  case State::PS4Slot::OtherGame:
+    return name + " belongs to another game";
+  case State::PS4Slot::OtherVersion:
+    if (made_by.starts_with("Dolphin for PS4 v"))
+      return name + " was saved by " + made_by + " and can't be loaded by this version";
+    if (made_by.find("[ps4]") != std::string::npos)
+      return name + " was saved by an older Dolphin for PS4 and can't be loaded";
+    return name + " was saved by another Dolphin version and can't be loaded";
+  case State::PS4Slot::Damaged:
+    return name + " is damaged and can't be loaded";
+  case State::PS4Slot::Broken:
+    return name + " couldn't be loaded - back to the game list";
+  case State::PS4Slot::Ready:
+    break;
+  }
+  return "Loaded slot " + std::to_string(slot);
+}
+
+// The slot as shown on the Save State and Load State rows.
+std::string SlotLabel(int slot)
+{
+  std::string label = "Slot " + std::to_string(slot);
+  switch (State::PS4CheckSlot(static_cast<u32>(slot)))
+  {
+  case State::PS4Slot::Empty:
+    return label + " (Empty)";
+  case State::PS4Slot::OtherGame:
+  case State::PS4Slot::OtherVersion:
+    return label + " (Other Version)";
+  case State::PS4Slot::Damaged:
+  case State::PS4Slot::Broken:
+    return label + " (Damaged)";
+  case State::PS4Slot::Ready:
+    break;
+  }
+  return label;
+}
