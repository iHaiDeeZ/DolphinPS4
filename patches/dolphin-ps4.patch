+      if (seconds >= 1.0)
+      {
+        const double rate = s_frames / seconds;
+        if (rate < 52.0)
+        {
+          s_high = 0;
+          if (++s_low >= 2 && s_cap != 30)
+          {
+            s_cap = 30;
+            ps4_boot_trace("frame rate limit auto: 30");
+          }
+        }
+        else if (rate >= 57.0)
+        {
+          s_low = 0;
+          if (++s_high >= 3 && s_cap != 0)
+          {
+            s_cap = 0;
+            ps4_boot_trace("frame rate limit auto: 60");
+          }
+        }
+        else
+        {
+          s_low = s_high = 0;
+        }
+        s_frames = 0;
+        s_window = now;
+      }
+      limit = s_cap;
