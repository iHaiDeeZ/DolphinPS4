+constexpr u32 PS4_MAX_SWAP_IMAGES = 8;
+u32 s_swap_images = 3;
+constexpr u32 PS4_WIDTH = 1920, PS4_HEIGHT = 1080;
+constexpr VkDeviceSize PS4_FRAMEBUFFER_ALIGN = 2 << 20;  // VideoOut buffer alignment
