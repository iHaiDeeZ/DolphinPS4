+// The signed-in users, to notice a player joining or leaving (cheap; checked about once a
+// second by the main loop).
+std::array<int32_t, 4> PS4LoginUsers()
+{
+  OrbisUserServiceLoginUserIdList users;
+  std::memset(&users, 0xFF, sizeof(users));
+  sceUserServiceGetLoginUserIdList(&users);
+  std::array<int32_t, 4> out;
+  for (size_t i = 0; i < out.size(); i++)
+    out[i] = users.userId[i];
+  return out;
+}
+
+// A downloaded update (PS4Updater.h) newer than the installed package: the installed program
+// starts it with sceSystemServiceLoadExec, as the PS4 Homebrew Store starts its updates. The
+// update knows itself by its built-in version. app-starting.txt is written before the switch and
+// removed once the update shows its menu (or starts a game); still there at the next start, the
+// update didn't work: it's set aside and the installed version runs. An installed package as new
+// as the update replaces it.
+// L1 held while the app starts: the menu instead of the default game (player 1's DualShock 4).
+static bool MenuButtonHeld()
+{
+  int32_t user = -1;
+  sceUserServiceInitialize(nullptr);
+  if (sceUserServiceGetInitialUser(&user) != 0 || user < 0)
+    return false;
+  scePadInit();
+  const int pad = scePadOpen(user, ORBIS_PAD_PORT_TYPE_STANDARD, 0, nullptr);
+  if (pad < 0)
+    return false;
+  bool held = false;
+  // The first reads can come back empty right after opening: a few tries over ~0.2 s.
+  for (int i = 0; i < 10 && !held; i++)
+  {
+    OrbisPadData data = {};
+    if (scePadReadState(pad, &data) == 0 && data.connected)
+      held = (data.buttons & ORBIS_PAD_BUTTON_L1) != 0;
+    sceKernelUsleep(20000);
+  }
+  scePadClose(pad);
+  return held;
+}
+
+// Dolphin's JIT writes the game's code as x86 code into memory mapped read/write/execute and runs
+// it. GoldHEN allows that; a console whose jailbreak doesn't crashes on the first translated block
+// (a PS4 Pro report, v03.10: SIGSEGV at the start of the JIT area). port/ps4_runtime.cpp tries
+// each way of mapping such memory once at start-up (a fault comes back there instead of crashing)
+// and maps Dolphin's executable memory the first way that worked; the results go to the boot trace.
+extern "C" int ps4_exec_probe();
+
+static bool ExecutableMemoryWorks()
+{
+  return ps4_exec_probe() >= 0;
+}
+
+static void StartDownloadedUpdate()
+{
+  const std::string update = FirstLine(UPDATE_DIR + "/xmb/version.txt");
+  if (update.empty())
+    return;
+  const std::string built = BuiltVersion();
+  const std::string installed = FirstLine("/app0/xmb/version.txt");
+  if (!built.empty() && built == update && built != installed)
+  {
+    s_running_update = true;
+    Platform::BootTrace(("running the downloaded update v" + update + " (installed: v" + installed + ")").c_str());
+    return;
+  }
+  std::error_code ec;
+  if (PS4Updater::CompareVersions(update, installed) <= 0)
+  {
+    File::DeleteDirRecursively(UPDATE_DIR);
+    std::remove(UPDATE_PENDING.c_str());
+    Platform::BootTrace(("removed the downloaded update v" + update + ": the installed v" + installed +
+               " is as new").c_str());
+    return;
+  }
+  const std::string failed = std::string(PS4_DATA_DIR_PATH) + "/app-failed";
+  if (FILE* pending = fopen(UPDATE_PENDING.c_str(), "r"))
+  {
+    fclose(pending);
+    std::remove(UPDATE_PENDING.c_str());
+    File::DeleteDirRecursively(failed);
+    std::filesystem::rename(UPDATE_DIR, failed, ec);
+    Platform::BootTrace(("the downloaded update v" + update + " didn't start last time: set aside in " +
+               failed + ", running the installed v" + installed).c_str());
+    return;
+  }
+  if (FILE* pending = fopen(UPDATE_PENDING.c_str(), "w"))
+  {
+    fprintf(pending, "%s\n", update.c_str());
+    fclose(pending);
+  }
+  Platform::BootTrace(("starting the downloaded update v" + update + " (installed: v" + installed + ")").c_str());
+  fflush(stderr);
+  const std::string eboot = UPDATE_DIR + "/eboot.bin";
+  // Too early for the usual module loading: without libSceSystemService loaded the call below
+  // kills the app with PRX_NOT_RESOLVED_FUNCTION (v03.07).
+  LoadSystemModules();
+  const int result = sceSystemServiceLoadExec(eboot.c_str(), nullptr);
+  // Still here: it couldn't be started.
+  std::remove(UPDATE_PENDING.c_str());
+  File::DeleteDirRecursively(failed);
+  std::filesystem::rename(UPDATE_DIR, failed, ec);
+  char text[160];
+  snprintf(text, sizeof(text),
+           "sceSystemServiceLoadExec(%s) failed (%#x): running the installed version", eboot.c_str(),
+           static_cast<unsigned>(result));
+  Platform::BootTrace(text);
+}
+
+std::vector<std::string> Platform::GetPS4Arguments()
+{
+  BootTrace("main");
+  // GoldHEN plugins and other code loaded into the app (they can hook what Dolphin relies on).
+  ps4_log_injected_modules("at start");
+  mkdir(PS4_DATA_DIR_PATH, 0777);
+  mkdir((std::string(PS4_DATA_DIR_PATH) + "/games").c_str(), 0777);
+
+  // stdout/stderr go nowhere on PS4: send them to a file, unbuffered so it survives a crash.
+  // (Not freopen: the OpenOrbis libc's freopen frees the static stderr FILE and output is lost.)
+  const int log_fd =
+      open((std::string(PS4_DATA_DIR_PATH) +
+            (access((std::string(PS4_DATA_DIR_PATH) + "/launch.txt").c_str(), F_OK) == 0 ?
+                 "/dolphin.log" :      // starting a game (launch.txt from the XMB)
+                 "/xmb-stderr.log"))  // the XMB: keeps the last game's log
+               .c_str(),
+           O_WRONLY | O_CREAT | O_TRUNC, 0666);
+  if (log_fd >= 0)
+  {
+    dup2(log_fd, STDOUT_FILENO);
+    dup2(log_fd, STDERR_FILENO);
+    close(log_fd);
+  }
+  setvbuf(stdout, nullptr, _IONBF, 0);
+  setvbuf(stderr, nullptr, _IONBF, 0);
+  atexit(OnExit);
+  BootTrace("log opened");
+  StartDownloadedUpdate();
+
+  BootTrace(("app version " + AppVersion()).c_str());
+  {
+    OrbisKernelSwVersion firmware = {};
+    firmware.Size = sizeof(firmware);
+    if (sceKernelGetSystemSwVersion(&firmware) == 0)
+      BootTrace(("firmware " + std::string(firmware.VersionString)).c_str());
+  }
+  LoadOptions();
+  // No JIT on this console: the cached interpreter and the software vertex loader, which need no
+  // executable memory. Slow, but the games run.
+  if (!ExecutableMemoryWorks())
+  {
+    ps4_jit_unavailable = 1;
+    s_options["cpu_core"] = "cachedinterpreter";
+    s_options["vertex_loader"] = "software";
+    BootTrace("executable memory refused by this console (jailbreak without RWX): "
+              "cached interpreter, software vertex loader");
+  }
+  // The menus' settings (settings.ini) over ps4.ini's global options; settings never changed in
+  // the menus keep ps4.ini's values (PS4Settings.h has the full order).
+  s_ps4_global = s_options;
+  PS4Settings::Load(PS4_DATA_DIR_PATH);
+  PS4Lang::Load(AssetsDir(), PS4Settings::Get("language"));
+  PS4Settings::SetBaseLookup([](const std::string& key) {
+    const auto it = s_ps4_global.find(key);
+    return it == s_ps4_global.end() ? std::string() : it->second;
+  });
+  PS4Settings::SetGameBaseLookup(
+      [](const std::string& game_id, const std::string& key) { return GameOption(game_id, key); });
+  for (const auto& [key, value] : PS4Settings::GlobalValues())
+    s_options[key] = value;
+  for (const auto& [key, value] : s_options)
+    BootTrace(("option " + key + "=" + value).c_str());
+  BootTrace(("game settings center: " + s_game_settings_source).c_str());
+  ps4_jit_in_system_pool = GetPS4Option("jit_memory", "system") == "system" ? 1 : 0;
+
+  const std::string user_dir = std::string(PS4_DATA_DIR_PATH) + "/User";
+  WriteDefaultConfig(user_dir);
+  std::vector<std::string> args = {"dolphin-emu-nogui", "--platform=ps4", "--user=" + user_dir};
+  // The XMB (PS4XMB.cpp) runs first. The game it picks is written to launch.txt and the app
+  // restarts itself into Dolphin, so the menu and the emulator never share a process; the
+  // restarted app finds launch.txt and boots that game. ps4.ini xmb=off: the old automatic
+  // start (boot.txt or the first game).
+  std::string game;
+  const std::string launch_path = std::string(PS4_DATA_DIR_PATH) + "/launch.txt";
+  if (FILE* file = fopen(launch_path.c_str(), "r"))
+  {
+    char line[1024] = {};
+    if (fgets(line, sizeof(line), file))
+      game = line;
+    char second[1024] = {};
+    if (fgets(second, sizeof(second), file))
+    {
+      std::string extra = second;
+      while (!extra.empty() && (extra.back() == '\n' || extra.back() == '\r'))
+        extra.pop_back();
+      if (extra.rfind("disc=", 0) == 0)
+      {
+        s_launch_disc = extra.substr(5);
+        s_options["launch_disc"] = s_launch_disc;
+        BootTrace(("launch disc: " + s_launch_disc).c_str());
+      }
+    }
+    fclose(file);
+    std::remove(launch_path.c_str());
+    while (!game.empty() && (game.back() == '\n' || game.back() == '\r'))
+      game.pop_back();
+    BootTrace(("launch: " + game).c_str());
+    ps4_update_started_ok();  // this program got as far as starting a game
+    // The controller setup below asks libSceUserService for the players: without its module
+    // loaded that call kills the app with PRX_NOT_RESOLVED_FUNCTION (every game start in v03.20 -
+    // v03.23).
+    LoadSystemModules();
+  }
+  else if (GetPS4Option("xmb", "on") == "on")
+  {
+    LoadSystemModules();
+    // Set as Default ISO: opened from the home screen, the app starts that game instead of the
+    // menu. L1 held while it starts: the menu after all.
+    const bool to_menu = std::remove(TO_MENU.c_str()) == 0;
+    const std::string default_game = PS4XMB::DefaultGame(PS4_DATA_DIR_PATH);
+    if (!to_menu && !default_game.empty())
+    {
+      std::error_code ec;
+      if (!std::filesystem::exists(default_game, ec))
+        BootTrace(("default game not found: " + default_game).c_str());
+      else if (MenuButtonHeld())
+        BootTrace("default game skipped (L1 held): the menu");
+      else
+      {
+        BootTrace(("default game: " + default_game).c_str());
+        game = default_game;
+        ps4_update_started_ok();  // a downloaded update got as far as starting a game
+      }
+    }
+    if (game.empty())
+    {
+      // The XMB scans the games folder itself (again on a refresh or a new folder).
+      const PS4XMB::ScanFunction scan = [](const std::string& games_dir) {
+        std::vector<PS4XMB::LibraryDisc> library;
+        for (const LibraryEntry& entry : ScanLibrary(games_dir))
+          library.push_back({entry.path, entry.game_id, entry.revision, entry.disc, entry.title,
+                             entry.wad, entry.homebrew, entry.wii});
+        return library;
+      };
+      game = PS4XMB::Run(scan, PS4_DATA_DIR_PATH, AssetsDir(), AppVersion());
+      if (game == PS4XMB::RESTART_APP)
+      {
+        // An update was unpacked (the installed program starts it, StartDownloadedUpdate) or the
+        // language changed: back to the menu.
+        BootTrace("xmb: restarting");
+        fflush(stderr);
+        ps4_return_to_menu();
+        sceSystemServiceLoadExec("/app0/eboot.bin", nullptr);
+        for (;;)
+          sceKernelUsleep(100000);
+      }
+      if (game == PS4XMB::EXIT_APP)
+      {
+        // An update is installing in the background: the app closes so it can be replaced.
+        BootTrace("xmb: closing the app for an update");
+        fflush(stderr);
+        sceSystemServiceLoadExec("exit", nullptr);
+        for (;;)
+          sceKernelUsleep(100000);
+      }
+      if (game.empty())
+      {
+        // The menu couldn't start: the old automatic start, so the app stays usable.
+        BootTrace("xmb: unavailable, starting boot.txt / the first game");
+        game = FindGame();
+      }
+      else if (FILE* file = fopen(launch_path.c_str(), "w"))
+      {
+        fprintf(file, "%s\n", game.c_str());
+        fclose(file);
+        BootTrace("xmb: restarting into the game");
+        fflush(stderr);
+        const int result = sceSystemServiceLoadExec(ps4_self_path(), nullptr);
+        // Still here: the restart failed. Start the game in this process instead.
+        char text[96];
+        snprintf(text, sizeof(text), "xmb: sceSystemServiceLoadExec failed (%#x), booting here",
+                 static_cast<unsigned>(result));
+        BootTrace(text);
+        std::remove(launch_path.c_str());
+      }
+    }
+  }
+  else
+  {
+    game = FindGame();
+  }
+  if (game.empty())
+  {
+    fprintf(stderr, "[dolphin] no game: put one in %s/games or its path in %s/boot.txt\n",
+            PS4_DATA_DIR_PATH, PS4_DATA_DIR_PATH);
+  }
+  else
+  {
+    s_booted_game = game;
+    // An installed Wii title (the XMB's Wii Menu page: the Wii Menu, the Mii Channel).
+    if (game.rfind("nand:", 0) == 0)
+    {
+      BootTrace(("boot: Wii title " + game.substr(5)).c_str());
+      args.push_back("--nand_title=" + game.substr(5));
+    }
+    else
+    for (const std::string& disc : FindAllDiscs(game))
+    {
+      if (s_boot_disc.empty())
+        s_boot_disc = disc;
+      fprintf(stderr, "[dolphin] booting %s\n", disc.c_str());
+      BootTrace(("boot: " + disc).c_str());
+      args.push_back("--exec=" + disc);
+    }
+    // Per-game ps4.ini sections: the game's 3-character ID first, then its full ID.
+    for (const LibraryEntry& entry : GameLibrary())
+    {
+      if (std::filesystem::path(entry.path) != std::filesystem::path(game) ||
+          entry.game_id.size() < 3)
+        continue;
+      snprintf(ps4_profile_tag, sizeof(ps4_profile_tag), "%s", entry.game_id.c_str());
+      // The game settings center's recommended settings (unless the player said No), then
+      // ps4.ini's per-game sections.
+      const bool center_used = CenterUsed(entry.game_id);
+      for (const std::string& id : {entry.game_id.substr(0, 3), entry.game_id})
+      {
+        const auto section = s_center_options.find(id);
+        if (section == s_center_options.end())
+          continue;
+        if (!center_used)
+        {
+          BootTrace(("game settings center: [" + id + "] not used (player's choice)").c_str());
+          continue;
+        }
+        for (const auto& [key, value] : section->second)
+        {
+          s_options[key] = value;
+          BootTrace(("center [" + id + "] " + key + "=" + value).c_str());
+        }
+      }
+      for (const std::string& id : {entry.game_id.substr(0, 3), entry.game_id})
+      {
+        const auto section = s_game_options.find(id);
+        if (section == s_game_options.end())
+          continue;
+        for (const auto& [key, value] : section->second)
+        {
+          s_options[key] = value;
+          BootTrace(("option [" + id + "] " + key + "=" + value).c_str());
+        }
+      }
+      // The game's own menu settings, when it is set to custom.
+      if (PS4Settings::IsCustom(entry.game_id))
+      {
+        for (const auto& [key, value] : PS4Settings::GameValues(entry.game_id))
+        {
+          s_options[key] = value;
+          BootTrace(("setting [" + entry.game_id + "] " + key + "=" + value).c_str());
+        }
+      }
+      break;
+    }
+  }
+  // Dolphin Lab: ps4.ini lab_profile=on profiles every game (its own samples-<ID>.log), whatever
+  // the game settings center or the game's own settings say about diagnostics.
+  if (GetPS4Option("lab_profile", "off") == "on")
+  {
+    s_options["profiler"] = "on";
+    s_options["diagnostics_all"] = "on";
+    BootTrace("lab_profile: profiling this game");
+  }
+  // A Wii game (a Wii disc, a .wad or Wii homebrew)? The Wii settings apply only to those.
+  std::string controls_game;
+  for (const LibraryEntry& entry : GameLibrary())
+  {
+    if (std::filesystem::path(entry.path) != std::filesystem::path(game) &&
+        (s_launch_disc.empty() ||
+         std::filesystem::path(entry.path) != std::filesystem::path(s_launch_disc)))
+      continue;
+    controls_game = entry.game_id;
+    SetStopGame(entry.title.empty() ? std::filesystem::path(entry.path).stem().string() :
+                                      entry.title,
+                entry.game_id);
+    s_wii_game = entry.wad || (entry.homebrew ? entry.wii :
+                                                !entry.game_id.empty() &&
+                                                    (entry.game_id[0] == 'R' || entry.game_id[0] == 'S'));
+    break;
+  }
+  if (game.rfind("nand:", 0) == 0)
+    s_wii_game = true;  // a Wii title: the Wii Remote settings apply
+  if (!s_stop_game[0] && !game.empty())
+    SetStopGame(std::filesystem::path(game).stem().string(), {});
+  if (s_wii_game)
+  {
+    // Online play's certificates: from the installed IOS13 if they aren't there yet.
+    const std::string wii_root = std::string(PS4_DATA_DIR_PATH) + "/User/Wii";
+    if (access((wii_root + "/clientca.pem").c_str(), F_OK) != 0 &&
+        access((wii_root + "/title/00000001/0000000d/content/title.tmd").c_str(), F_OK) == 0)
+    {
+      BootTrace(DiscIO::NANDImporter().ExtractCertificates() ?
+                    "wii online: certificates extracted from IOS13" :
+                    "wii online: couldn't extract the certificates from IOS13");
+    }
+  }
+  BootTrace(s_wii_game ? "Wii game: Wii controller settings applied" :
+                         "GameCube game: Wii settings left alone");
+  // The game's own controller layout (Triangle on it -> Controls -> This Game), else the normal.
+  BootTrace(PS4Controls::UseGameProfile(controls_game) ?
+                ("controls: " + controls_game + "'s own layout").c_str() :
+                "controls: the normal layout");
+  // The Wii Remote's attachment and orientation for this game (WiimoteNew.ini, read by Dolphin
+  // when it starts).
+  if (s_wii_game)
+  {
+    PS4Controls::SetWiiTilt(GetPS4Option("wii_tilt", "both"), false);
+    PS4Controls::SetWiiAttachment(GetPS4Option("wii_extension", "nunchuk"),
+                                  GetPS4Option("wii_sideways", "off") == "on",
+                                  GetPS4Option("wii_upright", "off") == "on");
+  }
+  // PS Move controllers (players in the order PS4Pad uses: the user who started the app, then
+  // the others) and motion controls for the Wii Remote. The Move is looked for only in Wii games
+  // with Wii Remote Controller on Auto.
+  if (s_wii_game)
+  {
+    std::array<bool, 4> moves{};
+    ps4_move_enabled = GetPS4Option("wii_controller", "ds4") == "auto";
+    int32_t initial = -1;
+    sceUserServiceGetInitialUser(&initial);
+    std::vector<int32_t> players;
+    if (initial >= 0)
+      players.push_back(initial);
+    for (const int32_t user : PS4LoginUsers())
+    {
+      if (user >= 0 && user != initial && players.size() < 4)
+        players.push_back(user);
+    }
+    std::string found;
+    for (size_t i = 0; i < players.size() && ps4_move_enabled; i++)
+    {
+      moves[i] = ps4_move_connected(players[i]) != 0;
+      if (moves[i])
+        found += " " + std::to_string(i + 1);
+    }
+    if (ps4_move_enabled)
+      BootTrace(("PS Move: players with one on:" + (found.empty() ? std::string(" none") : found)).c_str());
+    PS4Controls::SetWiiTouchpad(GetPS4Option("wii_touchpad", "off"));
+    PS4Controls::SetWiiMotion(GetPS4Option("wii_controller", "ds4"),
+                              GetPS4Option("motion_controls", "on") == "on", moves,
+                              GetPS4Option("wii_pointer", "motion") == "motion");
+  }
+  // Speed Features: Compatible turns off the command-stream shortcuts (freezes and missing menu
+  // items in Crash Tag Team Racing and FIFA Street 2 came from them).
+  if (GetPS4Option("speed_mode", "fast") == "compatible")
+  {
+    for (const char* key :
+         {"fifo_defer", "jit_gp_fuse", "jit_lazy_lfs", "fifo_batch", "gpu_lazy_flush"})
+      s_options[key] = "off";
+    BootTrace("speed features: compatible");
+  }
+  return args;
+}
+
+// The game settings center for the menu (PS4XMB.cpp): the players' answers.
+namespace PS4Center
+{
+std::string Choice(const std::string& game_id)
+{
+  const auto it = s_center_choices.find(game_id);
+  return it == s_center_choices.end() ? std::string() : it->second;
+}
+
+void SetChoice(const std::string& game_id, bool use)
+{
+  s_center_choices[game_id] = use ? "yes" : "no";
+  const std::string temp = CENTER_CHOICES + ".new";
+  if (FILE* file = fopen(temp.c_str(), "w"))
+  {
+    fprintf(file, "# Dolphin for PS4: the game settings center, used (yes) or not (no) per game\n");
+    for (const auto& [id, choice] : s_center_choices)
+      fprintf(file, "%s=%s\n", id.c_str(), choice.c_str());
+    fflush(file);
+    fsync(fileno(file));
+    fclose(file);
+    std::rename(temp.c_str(), CENTER_CHOICES.c_str());
+  }
+}
+
+// After a new copy was downloaded: the menu's per-game values follow it.
+void Reload()
+{
+  // Only the center: the global options and ps4.ini's sections stay as they were loaded.
+  const std::string fetched = std::string(PS4_DATA_DIR_PATH) + "/game-settings.ini";
+  s_game_settings_source =
+      IsGameSettingsFile(fetched) ? fetched : AssetsDir() + "/xmb/game-settings.ini";
+  auto others = std::move(s_game_options);
+  s_game_options.clear();
+  LoadOptionsFile(s_game_settings_source, true);
+  s_center_options = std::move(s_game_options);
+  s_game_options = std::move(others);
+}
+}  // namespace PS4Center
