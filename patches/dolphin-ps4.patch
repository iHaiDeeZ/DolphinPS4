+  bool tall = false;
+  float bar = -1.0f;
+  std::string bar_text;
+  if (s_page == Page::Main)
+  {
+    const std::string slot = SlotLabel(s_slot);
+    for (const int item : s_main_items)
+    {
+      switch (item)
+      {
+      case MAIN_RESUME:
+        rows.push_back({"Resume Game"});
+        break;
+      case MAIN_SAVE:
+        rows.push_back({"Save State", slot});
+        break;
+      case MAIN_CONTROLS:
+        rows.push_back({"Controller"});
+        break;
+      case MAIN_LOAD:
+        rows.push_back({"Load State", slot});
+        break;
+      case MAIN_WII_EXTENSION:
+        rows.push_back({"Wii Extension",
+                        PS4Settings::Get("wii_extension", s_game_id) == "none" ? "None" :
+                                                                                 "Nunchuk"});
+        break;
+      case MAIN_WII_SIDEWAYS:
+        rows.push_back({"Hold Wii Remote",
+                        PS4Settings::Get("wii_sideways", s_game_id) != "on" ? "Pointed at TV" :
+                        PS4Settings::Get("wii_upright", s_game_id) == "on"  ? "Like a Wheel" :
+                                                                              "Sideways"});
+        break;
+      case MAIN_WII_TILT:
+      {
+        const std::string tilt = PS4Settings::Get("wii_tilt", s_game_id);
+        rows.push_back({"Tilt With", tilt == "stick"  ? "Left Stick" :
+                                     tilt == "motion" ? "Motion" :
+                                                        "Motion + Stick"});
+        break;
+      }
+      case MAIN_WII_TOUCH:
+      {
+        const std::string touch = PS4Settings::Get("wii_touchpad", s_game_id);
+        rows.push_back({"Touchpad", touch == "pointer" ? "Pointer" :
+                                    touch == "swing"   ? "Swing" :
+                                                         "Off"});
+        break;
+      }
+      case MAIN_SETTINGS:
+        rows.push_back({"Settings"});
+        break;
+      case MAIN_CHEATS:
+        rows.push_back({"Cheats"});
+        break;
+      case MAIN_ACHIEVEMENTS:
+        rows.push_back({"Achievements",
+                        s_ach_loaded ?
+                            std::to_string(s_ach.unlocked) + " / " + std::to_string(s_ach.total) :
+                            AchievementBrief()});
+        break;
+      case MAIN_RESTART:
+        rows.push_back({"Restart Game"});
+        break;
+      case MAIN_QUIT:
+        rows.push_back({"Quit Game"});
+        break;
+      }
+    }
+    selected = s_main_selected;
+    subtitle = "PAUSED";
+    hints = {{Glyph::Cross, "Select"}};
+    const int item = s_main_items.empty() ? MAIN_RESUME : s_main_items[s_main_selected];
+    if (item == MAIN_SAVE || item == MAIN_LOAD)
+      hints.push_back({Glyph::LeftRight, "Slot"});
+    if (item == MAIN_WII_EXTENSION || item == MAIN_WII_SIDEWAYS || item == MAIN_WII_TILT ||
+        item == MAIN_WII_TOUCH)
+      hints.push_back({Glyph::LeftRight, "Change"});
+    hints.push_back({Glyph::Circle, "Resume"});
+    hints.push_back({Glyph::L3R3, "Resume"});
+  }
+  else if (s_page == Page::Controls)
+  {
+    // The layout the running game uses: its own (if it has one) or the normal one.
+    const bool own = PS4Controls::HasGameProfile(s_game_id);
+    PS4Controls::EditGame(own ? s_game_id : std::string());
+    const auto device = s_wii ? PS4Controls::Device::Wii : PS4Controls::Device::GameCube;
+    if (s_wii)
+    {
+      // How the Wii Remote is used in this game (kept for this game).
+      rows.push_back({"Wii Remote", "", true});
+      keys.push_back("");
+      rows.push_back({"Extension",
+                      PS4Settings::Get("wii_extension", s_game_id) == "none" ? "None" : "Nunchuk"});
+      keys.push_back("wii:extension");
+      rows.push_back({"Hold Wii Remote",
+                      PS4Settings::Get("wii_sideways", s_game_id) != "on" ? "Pointed at TV" :
+                      PS4Settings::Get("wii_upright", s_game_id) == "on"  ? "Like a Wheel" :
+                                                                            "Sideways"});
+      keys.push_back("wii:hold");
+      const std::string tilt = PS4Settings::Get("wii_tilt", s_game_id);
+      rows.push_back({"Tilt With", tilt == "stick"  ? "Left Stick" :
+                                   tilt == "motion" ? "Motion" :
+                                                      "Motion + Stick"});
+      keys.push_back("wii:tilt");
+      const std::string touch = PS4Settings::Get("wii_touchpad", s_game_id);
+      rows.push_back({"Touchpad", touch == "pointer" ? "Pointer" :
+                                  touch == "swing"   ? "Swing" :
+                                                       "Off"});
+      keys.push_back("wii:touch");
+      rows.push_back({"Button Mapping", "", true});
+      keys.push_back("");
+    }
+    rows.push_back({"Apply To", own ? "This Game" : "All Games"});
+    keys.push_back("__ctlscope__");
+    rows.push_back({s_wii ? "Wii Remote Buttons" : "GameCube Controller", "", true});
+    keys.push_back("");
+    const auto& bindings = PS4Controls::Bindings(device);
+    for (size_t i = 0; i < bindings.size(); i++)
+    {
+      const std::string value = PS4Controls::Get(device, bindings[i]);
+      std::string shown = bindings[i].stick_group ? value : PS4Controls::Describe(value);
+      if (s_ctl_capture_row == static_cast<int>(rows.size()))
+        shown = "Press a button...";
+      rows.push_back({bindings[i].label, shown});
+      keys.push_back("ctl:" + std::to_string(i));
+    }
+    rows.push_back({"", "", true});
+    keys.push_back("");
+    rows.push_back({"Reset to Default", ""});
+    keys.push_back("__ctlreset__");
+    selected = s_settings_selected;
+    subtitle = own ? "CONTROLLER - THIS GAME" : "CONTROLLER - ALL GAMES";
+    const bool wii_row = selected >= 0 && selected < static_cast<int>(keys.size()) &&
+                         keys[selected].rfind("wii:", 0) == 0;
+    if (wii_row)
+      hints = {{Glyph::LeftRight, "Change"}, {Glyph::UpDown, "Move"}, {Glyph::Circle, "Back"}};
+    else
+      hints = {{Glyph::Cross, "Change"}, {Glyph::Square, "Clear"}, {Glyph::UpDown, "Move"},
+               {Glyph::Circle, "Back"}};
+  }
+  else if (s_page == Page::Achievements)
+  {
+    tall = true;
+    if (!s_ach_loaded)
+    {
+      std::string message;
+      AchievementBrief(&message);
+      rows.push_back({message, "", true});
+      keys.push_back("");
+    }
+    else
+    {
+      for (size_t i = 0; i < s_ach.entries.size(); i++)
+      {
+        const PS4Achievements::Entry& entry = s_ach.entries[i];
+        Row row{entry.title, std::to_string(entry.points) + " pts"};
+        row.sub = entry.description;
+        row.locked = !entry.unlocked;
+        row.ach_type = entry.type;
+        row.tier = TrophyTier(entry.points);
+        row.rarity = entry.rarity;
+        if (entry.unlocked)
+        {
+          row.status = entry.unlock_time > 0 ? "Unlocked " + ShortDate(entry.unlock_time) :
+                                               std::string("Unlocked");
+        }
+        else
+        {
+          row.status = entry.progress.empty() ? std::string("Locked") :
+                                                "Locked  -  " + entry.progress;
+        }
+        row.badge = (entry.unlocked ? "U" : "L") + std::to_string(entry.id);
+        rows.push_back(row);
+        keys.push_back("ach:" + std::to_string(i));
+      }
+      if (s_ach.entries.empty())
+      {
+        rows.push_back({"No achievements for this game", "", true});
+        keys.push_back("");
+      }
+      const uint32_t percent = s_ach.total ? s_ach.unlocked * 100 / s_ach.total : 0;
+      bar = s_ach.total ? static_cast<float>(s_ach.unlocked) / static_cast<float>(s_ach.total) : 0.0f;
+      bar_text = std::to_string(percent) + "%   " + std::to_string(s_ach.unlocked) + " / " +
+                 std::to_string(s_ach.total) + " unlocked   " + std::to_string(s_ach.points) +
+                 " / " + std::to_string(s_ach.points_total) + " points" +
+                 (s_ach.hardcore ? "   Hardcore" : "");
+    }
+    selected = s_settings_selected;
+    subtitle = "ACHIEVEMENTS";
+    hints = {{Glyph::UpDown, "Move"}, {Glyph::Circle, "Back"}};
+  }
+  else if (s_page == Page::Cheats)
+  {
+    const auto entries = s_cheats.Entries();
+    rows.push_back({"Download Codes", s_cheat_dl_busy ? "Downloading..." : s_cheat_dl_status});
+    keys.push_back("cheatdl");
+    if (!entries.empty())
+    {
+      rows.push_back({"Enable All"});
+      keys.push_back("cheatall:on");
+      rows.push_back({"Disable All"});
+      keys.push_back("cheatall:off");
+    }
+    bool last_gecko = false;
+    for (size_t i = 0; i < entries.size(); i++)
+    {
+      if (i == 0 || entries[i].gecko != last_gecko)
+      {
+        rows.push_back({entries[i].gecko ? "Gecko Codes" : "Action Replay Codes", "", true});
+        keys.push_back("");
+      }
+      last_gecko = entries[i].gecko;
+      Row row{entries[i].name};
+      row.tag = entries[i].enabled ? 1 : -1;
+      rows.push_back(row);
+      keys.push_back("cheat:" + std::to_string(i));
+    }
+    if (entries.empty())
+    {
+      rows.push_back({"No cheats for this game", "", true});
+      keys.push_back("");
+    }
+    selected = s_settings_selected;
+    subtitle = "CHEATS";
+    if (selected >= 0 && selected < static_cast<int>(keys.size()) && keys[selected] == "cheatdl")
+      hints = {{Glyph::Cross, "Download"}, {Glyph::UpDown, "Move"}, {Glyph::Circle, "Back"}};
+    else
+      hints = {{Glyph::Cross, "On/Off"}, {Glyph::UpDown, "Move"}, {Glyph::Circle, "Back"}};
+  }
+  else
+  {
+    const bool custom = Custom();
+    rows.push_back({"Apply To", custom ? "This Game" : "All Games"});
+    keys.push_back("");
+    for (const char* category : PS4Settings::Categories())
+    {
+      rows.push_back({category, "", true});
+      keys.push_back("");
+      for (const PS4Settings::Setting& setting : PS4Settings::All())
+      {
+        if (std::string(setting.category) != category)
+          continue;
+        const std::string value = PS4Settings::Get(setting.key, s_game_id);
+        rows.push_back({setting.label, PS4Settings::LabelOf(setting, value), false,
+                        !setting.live});
+        keys.push_back(setting.key);
+      }
+    }
+    rows.push_back({"", "", true});
+    keys.push_back("");
+    rows.push_back({custom ? "Reset This Game" : "Reset to Defaults", ""});
+    keys.push_back("__reset__");
+    selected = s_settings_selected;
+    subtitle = custom ? "SETTINGS - THIS GAME" : "SETTINGS - ALL GAMES";
+    hints = {{Glyph::LeftRight, "Change"}, {Glyph::UpDown, "Move"}, {Glyph::Circle, "Back"}};
+  }
+  std::string detail;
+  if (s_page == Page::Achievements && selected >= 0 && selected < static_cast<int>(keys.size()) &&
+      keys[selected].rfind("ach:", 0) == 0)
+  {
+    const size_t index = static_cast<size_t>(std::atoi(keys[selected].c_str() + 4));
+    if (index < s_ach.entries.size())
+    {
+      const PS4Achievements::Entry& entry = s_ach.entries[index];
+      detail = entry.description;
+      switch (entry.type)
+      {
+      case 1:
+        detail += "  -  Missable: can be missed for good in a playthrough.";
+        break;
+      case 2:
+        detail += "  -  Progression: earned along the way to the end.";
+        break;
+      case 3:
+        detail += "  -  Win Condition: earned for finishing the game.";
+        break;
+      default:
+        break;
+      }
+      if (entry.rarity >= 0.0f)
+      {
+        char rarity[64];
+        snprintf(rarity, sizeof(rarity), "  %.1f%% of players have it.", entry.rarity);
+        detail += rarity;
+      }
+    }
+  }
+  s_row_keys = std::move(keys);
+  std::lock_guard lock(s_mutex);
+  s_detail = std::move(detail);
+  s_tall = tall;
+  s_bar = bar;
+  s_bar_text = std::move(bar_text);
+  s_rows = std::move(rows);
+  s_selected = selected;
+  s_subtitle = subtitle;
+  s_hints = std::move(hints);
+}
+
+void Toast(const std::string& text, int ms = 2200)
+{
+  std::lock_guard lock(s_mutex);
+  s_toast = text;
+  s_toast_start = Clock::now();
+  s_toast_until = s_toast_start + std::chrono::milliseconds(ms);
+}
+
+// Host thread, s_mutex not held (Core calls wait for the video thread, which takes s_mutex).
+void Close(Core::System& system)
+{
+  {
+    std::lock_guard lock(s_mutex);
+    s_open = false;
+  }
+  s_watch = false;
+  ps4_pad_block = 1;  // the game sees a neutral pad until the buttons are released
+  Core::SetState(system, Core::State::Running);
+  Log("closed");
+}
+
+void SymbolsDump(Core::System& system);
+extern "C" void ps4_jit_cache_save();  // Core/PowerPC/JitPS4/CodeCache.cpp
+
+void Open(Core::System& system)
+{
+  s_game_id = SConfig::GetInstance().GetGameID();
+  SymbolsDump(system);
+  {
+    // New compiled code to the hard drive while the game waits anyway (PS4 JIT code cache).
+    const Core::CPUThreadGuard guard(system);
+    ps4_jit_cache_save();
+  }
+  std::string title = SConfig::GetInstance().GetTitleName();
+  if (title.empty())
+    title = s_game_id;
+  s_page = Page::Main;
+  s_main_selected = 0;
+  s_wii = system.IsWii();
+  // Everything about the controller (Wii Remote options, button mapping) is on its own page.
+  s_main_items = {MAIN_RESUME, MAIN_SAVE, MAIN_LOAD, MAIN_CONTROLS, MAIN_SETTINGS, MAIN_CHEATS};
+  s_ach = {};
+  s_ach_loaded = CaptureAchievements(&s_ach);
+  if (s_ach_loaded)
+    SaveAchievements();
+#ifdef USE_RETRO_ACHIEVEMENTS
+  s_main_items.push_back(MAIN_ACHIEVEMENTS);
+#else
+  if (s_ach_loaded)
+    s_main_items.push_back(MAIN_ACHIEVEMENTS);
+#endif
+  s_main_items.insert(s_main_items.end(), {MAIN_RESTART, MAIN_QUIT});
+  {
+    // What the slots look like for this game (a report of "empty" slots after an update).
+    static const char* const NAMES[] = {"ready", "empty", "other game", "other version",
+                                        "damaged", "broken"};
+    std::string slots = "save states for " + s_game_id + ":";
+    for (int slot = 1; slot <= 8; slot++)
+    {
+      std::string made_by;
+      const auto status = State::PS4CheckSlot(static_cast<u32>(slot), &made_by);
+      if (status == State::PS4Slot::Empty)
+        continue;
+      const int index = static_cast<int>(status);
+      slots += " " + std::to_string(slot) + "=" +
+               (index >= 0 && index < 6 ? NAMES[index] : "?") +
+               (made_by.empty() ? "" : " (" + made_by + ")");
+    }
+    Log(slots);
+  }
+  BuildRows();
+  FlushPlayTime();
+  const std::string played = PS4PlayTime::Text(PS4PlayTime::Seconds(PlayKey()));
+  {
+    std::lock_guard lock(s_mutex);
+    s_playtime = played.empty() ? std::string() : "Play time: " + played;
+    s_title = std::move(title);
+    s_open = true;
+  }
+  ps4_pad_block = 1;
+  Core::SetState(system, Core::State::Paused);
+  s_watch = true;
+  Log("opened");
+}
+
+// Controls page: the running game reads the edited layout again (Dolphin's controller
+// configuration reloaded from the files).
+void ApplyControls()
+{
+  PS4Controls::RefreshLive(s_game_id);
+  const auto lock = ControllerEmu::EmulatedController::GetStateLock();
+  Pad::LoadConfig();
+  if (s_wii)
+    Wiimote::LoadConfig();
+}
+
+// Square on a button: its mapping cleared (the button then does nothing).
+void ClearControl(int row)
+{
+  if (row < 0 || row >= static_cast<int>(s_row_keys.size()) ||
+      s_row_keys[row].rfind("ctl:", 0) != 0)
+    return;
+  const auto device = s_wii ? PS4Controls::Device::Wii : PS4Controls::Device::GameCube;
+  PS4Controls::EditGame(PS4Controls::HasGameProfile(s_game_id) ? s_game_id : std::string());
+  const auto& binding = PS4Controls::Bindings(device)[std::atoi(s_row_keys[row].c_str() + 4)];
+  if (binding.stick_group)
+    return;
+  PS4Controls::Set(device, binding, "");
+  ApplyControls();
+  Toast(std::string(binding.label) + ": cleared");
+  Log(std::string("controls: cleared ") + binding.label);
+}
+
+void ToggleWiiRemote(int item, int direction);
+
+void ChangeControl(int row, int direction)
+{
+  const std::string& key = s_row_keys[row];
+  const auto device = s_wii ? PS4Controls::Device::Wii : PS4Controls::Device::GameCube;
+  if (key.rfind("wii:", 0) == 0)
+  {
+    ToggleWiiRemote(key == "wii:extension" ? MAIN_WII_EXTENSION :
+                    key == "wii:hold"      ? MAIN_WII_SIDEWAYS :
+                    key == "wii:touch"     ? MAIN_WII_TOUCH :
+                                             MAIN_WII_TILT,
+                    direction);
+    return;
+  }
+  if (key == "__ctlscope__")
+  {
+    // This Game: its own layout, starting from the current one. All Games: the normal one back.
+    if (PS4Controls::HasGameProfile(s_game_id))
+    {
+      PS4Controls::DeleteGameProfile(s_game_id);
+      PS4Controls::RestoreGlobal();
+      Toast("Controls: the normal layout");
+    }
+    else
+    {
+      PS4Controls::CreateGameProfile(s_game_id);
+      PS4Controls::UseGameProfile(s_game_id);
+      Toast("Controls: this game's own layout");
+    }
+    ApplyControls();
+    Log("controls: " + s_game_id +
+        (PS4Controls::HasGameProfile(s_game_id) ? " own layout" : " normal layout"));
+    return;
+  }
+  PS4Controls::EditGame(PS4Controls::HasGameProfile(s_game_id) ? s_game_id : std::string());
+  if (key == "__ctlreset__")
+  {
+    if (direction <= 0)
+      return;
+    PS4Controls::ResetToDefault(device);
+    ApplyControls();
+    Toast("Controls: back to the default layout");
+    return;
+  }
+  if (key.rfind("ctl:", 0) != 0)
+    return;
+  const auto& binding = PS4Controls::Bindings(device)[std::atoi(key.c_str() + 4)];
+  if (binding.stick_group)
+  {
+    const auto choices = PS4Controls::StickChoices();
+    const std::string current = PS4Controls::Get(device, binding);
+    int index = 0;
+    for (size_t i = 0; i < choices.size(); i++)
+    {
+      if (choices[i] == current)
+        index = static_cast<int>(i);
+    }
+    const int count = static_cast<int>(choices.size());
+    index = ((index + direction) % count + count) % count;
+    PS4Controls::Set(device, binding, choices[index]);
+    ApplyControls();
+    return;
+  }
+  if (direction > 0)
+  {
+    // Buttons: the next press (UpdateControlCapture).
+    s_ctl_capture_row = row;
+    s_ctl_capture_armed = false;
+    s_ctl_capture_start = Clock::now();
+  }
+}
+
+// A button capture for a Controls row: waits until the pad is at rest, then takes the next press
+// (6 s without one cancels).
+void UpdateControlCapture(const OrbisPadData& data)
+{
+  if (!s_ctl_capture_armed)
+  {
+    s_ctl_capture_armed = PS4Controls::IsAtRest(data);
+    return;
+  }
+  if (Clock::now() - s_ctl_capture_start > std::chrono::seconds(6))
+  {
+    s_ctl_capture_row = -1;
+    BuildRows();
+    return;
+  }
+  const int row = s_ctl_capture_row;
+  if (row < 0 || row >= static_cast<int>(s_row_keys.size()) || s_row_keys[row].rfind("ctl:", 0) != 0)
+  {
+    s_ctl_capture_row = -1;
+    return;
+  }
+  const auto device = s_wii ? PS4Controls::Device::Wii : PS4Controls::Device::GameCube;
+  const auto& binding = PS4Controls::Bindings(device)[std::atoi(s_row_keys[row].c_str() + 4)];
+  const bool analog = std::string(binding.key).rfind("Triggers/", 0) == 0;
+  const std::string expression = PS4Controls::Capture(data, analog);
+  if (expression.empty())
+    return;
+  PS4Controls::Set(device, binding, expression);
+  ApplyControls();
+  s_ctl_capture_row = -1;
+  Toast(std::string(binding.label) + ": " + PS4Controls::Describe(expression));
+  Log("controls: " + std::string(binding.key) + "=" + expression);
+  BuildRows();
+}
+
+// Changes the setting on a settings row (direction -1/+1) and saves it.
+void ChangeSetting(int row, int direction)
+{
+  if (row < 0 || row >= static_cast<int>(s_row_keys.size()) || s_page == Page::Achievements)
+    return;
+  if (s_page == Page::Controls)
+  {
+    ChangeControl(row, direction);
+    BuildRows();
+    return;
+  }
+  if (s_page == Page::Cheats)
+  {
+    const std::string& key = s_row_keys[row];
+    if (key == "cheatdl")
+    {
+      if (direction <= 0 || s_cheat_dl_busy)
+        return;
+      s_cheat_dl_busy = true;
+      s_cheat_dl_done = false;
+      const std::string game = s_game_id;
+      Log("cheats: downloading codes for " + game);
+      std::thread([game] {
+        s_cheat_dl = PS4Cheats::List::FetchOnline(game);
+        s_cheat_dl_done = true;
+      }).detach();
+      return;
+    }
+    if (key.rfind("cheatall:", 0) == 0)
+    {
+      const bool on = key == "cheatall:on";
+      s_cheats.SetAll(on);
+      s_cheats.ApplyToRunningGame();
+      Toast(on ? "All cheats on" : "All cheats off");
+      Log(on ? "cheats: all on" : "cheats: all off");
+      return;
+    }
+    if (key.rfind("cheat:", 0) != 0)
+      return;
+    const size_t index = static_cast<size_t>(std::atoi(key.c_str() + 6));
+    s_cheats.Toggle(index);
+    s_cheats.ApplyToRunningGame();
+    const auto entries = s_cheats.Entries();
+    if (index < entries.size())
+    {
+      Toast(entries[index].name + (entries[index].enabled ? ": on" : ": off"));
+      Log("cheat " + entries[index].name + (entries[index].enabled ? " on" : " off"));
+    }
+    return;
+  }
+  if (row == 0)
+  {
+    // Apply To: this game (its own copy of the settings) or all games (global).
+    const bool custom = !Custom();
+    PS4Settings::SetCustom(s_game_id, custom);
+    if (!custom)
+    {
+      // Back to the global values: apply them to the running game.
+      for (const PS4Settings::Setting& setting : PS4Settings::All())
+      {
+        if (setting.live)
+          PS4Settings::ApplyLive(setting.key, PS4Settings::Get(setting.key, s_game_id));
+      }
+    }
+    Toast(custom ? "Settings for this game only" : "This game follows the global settings");
+    Log(custom ? "settings: custom for " + s_game_id : "settings: global for " + s_game_id);
+    return;
+  }
+  const std::string key = s_row_keys[row];
+  if (key == "__reset__")
+  {
+    // This game: back to the global settings. All games: back to ps4.ini's tuned defaults.
+    if (direction <= 0)
+      return;  // Cross or Right only
+    const bool custom = Custom();
+    if (custom)
+    {
+      PS4Settings::ResetGame(s_game_id);
+    }
+    else
+    {
+      for (const PS4Settings::Setting& setting : PS4Settings::All())
+        PS4Settings::ResetGlobal(setting.key);
+    }
+    for (const PS4Settings::Setting& setting : PS4Settings::All())
+    {
+      if (setting.live)
+        PS4Settings::ApplyLive(setting.key, PS4Settings::Get(setting.key, s_game_id));
+    }
+    Toast(custom ? "This game uses the global settings again" : "Settings reset to defaults");
+    Log(custom ? "settings: reset " + s_game_id : "settings: reset global");
+    return;
+  }
+  const PS4Settings::Setting* setting = PS4Settings::Find(key);
+  if (!setting)
+    return;
+  const std::string value =
+      PS4Settings::Step(*setting, PS4Settings::Get(key, s_game_id), direction);
+  // The game's recommended settings decide this one for this game: a global change wouldn't
+  // show here (Diagnostics stayed Off after Mario Kart Wii's recommended settings), so the
+  // game gets its own settings, starting from what it uses now.
+  const bool hidden = !Custom() && PS4Settings::HasGameValue(key, s_game_id);
+  if (hidden)
+    PS4Settings::SetCustom(s_game_id, true);
+  PS4Settings::Set(key, value, Custom() ? s_game_id : std::string());
+  if (setting->live)
+    PS4Settings::ApplyLive(key, value);
+  else
+    Toast(std::string(setting->label) + ": next time a game starts");
+  if (hidden && setting->live)
+    Toast(std::string(setting->label) + ": saved for this game");
+  Log("setting " + key + "=" + value + (Custom() ? " (" + s_game_id + ")" : " (global)"));
+}
