+    // the submit), or here once everything recorded has been submitted.
+    if (!PS4CommandRecorderQueueCall(&PS4QueueThreadFlip, image_index, static_cast<u64>(mode),
+                                     static_cast<u64>(arg), 0))
+    {
+      PS4CommandRecorderDrain();
+      PS4QueueThreadFlip(image_index, static_cast<u64>(mode), static_cast<u64>(arg), 0);
+    }
+    s_flips_submitted++;
+    return;
+  }
