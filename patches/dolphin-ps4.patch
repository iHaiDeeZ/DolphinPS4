+// Bumped whenever the file layout or what a block's code may refer to changes.
+constexpr u32 FORMAT_VERSION = 2;
+constexpr u32 FILE_MAGIC = 0x434A5044;  // "DPJC"
+// Kept in memory and on disk at most. Big games fill 64 MiB (WWE '13: ~95 MiB of blocks); the
+// file is read and written block by block, so this is all the memory it takes.
+constexpr size_t MAX_BYTES = 128 * 1024 * 1024;
+// One block's saved code and relocations at most (a damaged file stops loading there).
+constexpr u32 MAX_BLOB_BYTES = 4 * 1024 * 1024;
+
+enum Section : u8
+{
+  NEAR = 0,
+  FAR = 1,
+  ASM = 2,  // the JIT's shared routines (dispatcher, quantizers...), same layout every run
+  CONSTANT = 3,
+  REGION = 4,  // an emulator object (CodeCache::m_regions)
+  NONE = 255,
+};
+
+// A saved block: BlobHeader, then num_ranges pairs of u32 (the guest code's physical address
+// ranges), BlobConst, BlobReloc, BlobLink and BlobBackPatch arrays, num_ops u32 (the block's
+// instruction addresses; bit 0: the JIT knew it writes to the GPU FIFO), then the near and the
+// far code bytes as compiled (before linking or backpatching).
+struct BlobHeader
+{
+  u32 em_address;
+  u32 physical_address;
+  u32 feature_flags;
+  u32 original_size;
+  u64 guest_hash;
+  u32 entry_offset;
+  u32 near_size;
+  u32 far_size;
+  u16 num_ranges;
+  u16 num_consts;
+  u16 num_relocs;
+  u16 num_links;
+  u16 num_backpatches;
+  u16 num_ops;
+  // What the JIT had learned about the block's start when it compiled it (KNOW_*).
+  u32 knowledge;
+  u32 reserved;
+};
+// The JIT learns these while a game runs (JitInterface::CompileExceptionCheck) and then compiles
+// the block again; a saved copy made before it knew must not come back.
+constexpr u32 KNOW_PAIRED_QUANTIZE = 1;  // its GQRs aren't constant
+constexpr u32 KNOW_NO_SPECULATION = 2;   // no speculative constants
+constexpr u32 OP_FIFO_WRITE = 1;
+struct BlobConst
+{
+  u64 source;  // the constant's address in the emulator (.rodata/.data: the same every run)
+  u32 element_size;
+  u32 num_elements;
+};
+struct BlobReloc
+{
+  u32 site;  // where the address is written, in its section
+  u8 section;
+  u8 abs64;  // 8-byte address (else a 32-bit displacement)
+  s8 extra;  // instruction bytes after a displacement
+  u8 target_section;
+  u32 target_id;  // the constant or region
+  u64 target_offset;
+};
+struct BlobLink
+{
+  u32 exit_address;
+  u32 ptr_offset;
+  u32 stub_offset;
+  u8 call;
+  u8 ptr_section;
+  u8 stub_section;
+  u8 reserved;
+};
+struct BlobBackPatch
+{
+  u32 key_offset;
+  u32 start_offset;
+  u8 key_section;
+  u8 start_section;
+  u8 reserved[6];
+  TrampolineInfo info;
+};
+static_assert(std::is_trivially_copyable_v<TrampolineInfo>);
+
+struct FileHeader
+{
+  u32 magic;
+  u32 version;
+  u64 config;
+  u32 count;
+  u32 reserved;
+};
+
+class Writer
+{
+public:
+  explicit Writer(std::vector<u8>* out) : m_out(out) {}
+  template <typename T>
+  void Put(const T& value)
+  {
+    const u8* p = reinterpret_cast<const u8*>(&value);
+    m_out->insert(m_out->end(), p, p + sizeof(T));
+  }
+  void Bytes(const u8* p, size_t n) { m_out->insert(m_out->end(), p, p + n); }
+
+private:
+  std::vector<u8>* m_out;
+};
+
+class Reader
+{
+public:
+  Reader(const u8* p, size_t n) : m_p(p), m_end(p + n) {}
+  template <typename T>
+  bool Get(T* value)
+  {
+    if (size_t(m_end - m_p) < sizeof(T))
+      return false;
+    std::memcpy(value, m_p, sizeof(T));
+    m_p += sizeof(T);
+    return true;
+  }
+  const u8* Skip(size_t n)
+  {
+    if (size_t(m_end - m_p) < n)
+      return nullptr;
+    const u8* p = m_p;
+    m_p += n;
+    return p;
+  }
+
+private:
+  const u8* m_p;
+  const u8* m_end;
+};
+
+u64 Fnv(u64 hash, const void* data, size_t size)
+{
+  const u8* p = static_cast<const u8*>(data);
+  for (size_t i = 0; i < size; i++)
+    hash = (hash ^ p[i]) * 0x100000001B3ull;
+  return hash;
+}
+
+template <typename T>
+u64 Mix(u64 hash, const T& value)
+{
+  return Fnv(hash, &value, sizeof(T));
+}
+
+void Trace(const std::string& line)
+{
+  ps4_boot_trace(("code cache: " + line).c_str());
+}
+
+// The parsed parts of a blob.
+struct Parsed
+{
+  BlobHeader header;
+  const u32* ranges;
+  const BlobConst* consts;
+  const BlobReloc* relocs;
+  const BlobLink* links;
+  const BlobBackPatch* backpatches;
+  const u32* ops;
+  const u8* near_code;
+  const u8* far_code;
+};
+
+// The arrays are copied out with memcpy before use (the blob has no alignment guarantee), so the
+// pointers here are only start positions.
+bool Parse(const std::vector<u8>& blob, Parsed* out)
+{
+  Reader r(blob.data(), blob.size());
+  if (!r.Get(&out->header))
+    return false;
+  const BlobHeader& h = out->header;
+  out->ranges = reinterpret_cast<const u32*>(r.Skip(h.num_ranges * 8));
+  out->consts = reinterpret_cast<const BlobConst*>(r.Skip(h.num_consts * sizeof(BlobConst)));
+  out->relocs = reinterpret_cast<const BlobReloc*>(r.Skip(h.num_relocs * sizeof(BlobReloc)));
+  out->links = reinterpret_cast<const BlobLink*>(r.Skip(h.num_links * sizeof(BlobLink)));
+  out->backpatches =
+      reinterpret_cast<const BlobBackPatch*>(r.Skip(h.num_backpatches * sizeof(BlobBackPatch)));
+  out->ops = reinterpret_cast<const u32*>(r.Skip(h.num_ops * 4));
+  out->near_code = r.Skip(h.near_size);
+  out->far_code = r.Skip(h.far_size);
+  return (h.num_ranges == 0 || out->ranges) && (h.num_consts == 0 || out->consts) &&
+         (h.num_relocs == 0 || out->relocs) && (h.num_links == 0 || out->links) &&
+         (h.num_backpatches == 0 || out->backpatches) && (h.num_ops == 0 || out->ops) &&
+         out->near_code &&
+         (h.far_size == 0 || out->far_code);
+}
+
+template <typename T>
+T Item(const T* array, size_t i)
+{
+  T value;
+  std::memcpy(&value, reinterpret_cast<const u8*>(array) + i * sizeof(T), sizeof(T));
+  return value;
+}
+
+template <typename JitState>
+u32 BlockKnowledge(const JitState& js, u32 em_address)
+{
+  return (js.pairedQuantizeAddresses.contains(em_address) ? KNOW_PAIRED_QUANTIZE : 0) |
+         (js.noSpeculativeConstantsAddresses.contains(em_address) ? KNOW_NO_SPECULATION : 0);
+}
+
+// The saved copy was compiled knowing what the JIT knows now about its instructions.
+template <typename JitState>
+bool SameKnowledge(const Parsed& p, const JitState& js)
+{
+  if (BlockKnowledge(js, p.header.em_address) != p.header.knowledge)
+    return false;
+  for (u16 i = 0; i < p.header.num_ops; i++)
+  {
+    const u32 op = Item(p.ops, i);
+    if (js.fifoWriteAddresses.contains(op & ~3u) != ((op & OP_FIFO_WRITE) != 0))
+      return false;
+  }
+  return true;
+}
+
+void PutSet(std::vector<u8>* out, const std::unordered_set<u32>& set)
+{
+  Writer w(out);
+  w.Put(static_cast<u32>(set.size()));
+  for (u32 address : set)
+    w.Put(address);
+}
+
+void GetSet(Reader* r, std::unordered_set<u32>* set)
+{
+  u32 count;
+  if (!r->Get(&count))
+    return;
+  for (u32 i = 0; i < count; i++)
+  {
+    u32 address;
+    if (!r->Get(&address))
+      return;
+    set->insert(address);
+  }
+}
+
+u32 BE32(const u8* p)
+{
+  return (u32(p[0]) << 24) | (u32(p[1]) << 16) | (u32(p[2]) << 8) | p[3];
+}
+
+std::vector<std::pair<u32, u32>> Ranges(const Parsed& p)
+{
+  std::vector<std::pair<u32, u32>> ranges(p.header.num_ranges);
+  for (size_t i = 0; i < ranges.size(); i++)
+  {
+    ranges[i].first = Item(p.ranges, i * 2);
+    ranges[i].second = Item(p.ranges, i * 2 + 1);
+  }
+  return ranges;
+}
+}  // namespace
+
+void CodeCache::Start()
+{
+  m_mode = ps4_jit_cache == 0 ? Mode::Off : ps4_jit_cache == 2 ? Mode::Check : Mode::On;
+  m_opened = false;
+  m_ready = false;
+  m_prepared = false;
+  m_disc_prepared = false;
+  m_disc_compiled = false;
+  m_dirty = false;
+  m_blobs.clear();
+  m_index.clear();
+  m_bytes = 0;
+  m_stats = {};
+}
+
+void CodeCache::Stop()
+{
+  if (m_ready)
+  {
+    Save();
+    Trace("stopped: " + std::to_string(m_stats.restored) + " blocks loaded from the cache, " +
+          std::to_string(m_stats.compiled) + " compiled");
+  }
+  m_ready = false;
+  m_opened = false;
+  m_blobs.clear();
+  m_index.clear();
+}
+
+bool CodeCache::Ready()
+{
+  if (m_mode == Mode::Off)
+    return false;
+  if (!m_opened)
+  {
+    m_opened = true;
+    // The game is known once its code runs (not when the JIT starts).
+    const std::string game = SConfig::GetInstance().GetGameID();
+    if (game.empty() || m_jit.jo.memcheck)
+      return false;
+    const std::string dir = "/data/DolphinPS4/cache/jit/";
+    File::CreateFullPath(dir);
+    m_path = dir + game + ".jitc";
+    m_config = ConfigHash();
+    m_ready = true;
+    Load();
+  }
+  return m_ready;
+}
+
+u64 CodeCache::ConfigHash()
+{
+  u64 h = 0xCBF29CE484222325ull;
+  h = Mix(h, FORMAT_VERSION);
+  // This exact emulator build: its code and constants (the saved code calls into it and its
+  // constants by address).
+  u64 build = 0;
+#ifndef DOLPHIN_PS4_HOST  // (the PC test bench has no such linker symbols; no cache there)
+  const u64* p = reinterpret_cast<const u64*>(__text_start);
+  const u64* end = reinterpret_cast<const u64*>(__eh_frame_start);
+  for (; p < end; p++)
+    build = (build ^ *p) * 0x100000001B3ull + 0x9E3779B97F4A7C15ull;
+#endif
+  h = Mix(h, build);
+  for (int v : {ps4_gp_fuse, ps4_lazy_lfs, ps4_jit_inline_dispatch, ps4_jit_lazy_pc,
+                ps4_jit_tlb_inline, ps4_lfs_forward, ps4_jit_accurate_singles,
+                ps4_jit_round_results, ps4_jit_round_operands, ps4_jit_fcmp_merge,
+                ps4_jit_msr_link, ps4_jit_gp_dynamic, ps4_fifo_batch, ps4_fifo_defer, ps4_jit_verify,
+                ps4_jit_unroll, ps4_jit_join, ps4_jit_trace, ps4_jit_pin[0], ps4_jit_pin[1], ps4_jit_pin[2], ps4_jit_pin[3]})
+  {
+    h = Mix(h, v);
+  }
+  const auto& jo = m_jit.jo;
+  for (bool v : {jo.enableBlocklink, jo.optimizeGatherPipe, jo.accurateSinglePrecision,
+                 jo.fastmem, jo.fastmem_arena, jo.memcheck, jo.fp_exceptions,
+                 jo.div_by_zero_exceptions, m_jit.m_low_dcbz_hack, m_jit.m_accurate_nans,
+                 m_jit.m_accurate_fmadds, m_jit.m_accurate_cpu_cache_enabled,
+                 m_jit.m_system.IsWii()})
+  {
+    h = Mix(h, v);
+  }
+  // The shared routines' size and position in the code space (the saved code jumps into them).
+  h = Mix(h, u64(m_jit.asm_routines.GetRegionStart() - m_jit.GetRegionStart()));
+  h = Mix(h, u64(m_jit.asm_routines.GetRegionSize()));
+  return h;
+}
+
+void CodeCache::RefreshRegions()
+{
+  auto& system = m_jit.m_system;
+  auto& memory = system.GetMemory();
+  const auto impl = system.PS4ImplRange();
+  m_regions = {
+      {static_cast<const u8*>(impl.first), impl.second},
+      {reinterpret_cast<const u8*>(&m_jit), sizeof(JitPS4)},
+      {reinterpret_cast<const u8*>(m_jit.blocks.GetBlockBitSet()), (1ull << 32) / 32 / 8},
+      {memory.GetRAM(), memory.GetRamSizeReal()},
+      {memory.GetEXRAM(), memory.GetEXRAM() ? memory.GetExRamSizeReal() : 0},
+      {memory.GetL1Cache(), memory.GetL1Cache() ? memory.GetL1CacheSize() : 0},
+      // The fastmem windows: only their exact base (MOV RMEM, base). A 4 GiB range would also
+      // catch plain numbers such as an exit's (CPU mode << 32 | PC).
+      {memory.GetLogicalBase(), memory.GetLogicalBase() ? 1u : 0u},
+      {memory.GetPhysicalBase(), memory.GetPhysicalBase() ? 1u : 0u},
+  };
+}
+
+bool CodeCache::GuestHash(const std::vector<std::pair<u32, u32>>& ranges, u64* hash)
+{
+  auto& memory = m_jit.m_system.GetMemory();
+  u64 h = 0xCBF29CE484222325ull;
+  for (const auto& [from, to] : ranges)
+  {
+    if (to <= from)
+      return false;
+    const u32 size = to - from;
+    const u8* p = nullptr;
+    if (u64(from) + size <= memory.GetRamSizeReal() && memory.GetRAM())
+      p = memory.GetRAM() + from;
+    else if ((from >> 28) == 1 && memory.GetEXRAM() &&
+             u64(from & 0x0FFFFFFF) + size <= memory.GetExRamSizeReal())
+      p = memory.GetEXRAM() + (from & 0x0FFFFFFF);
+    if (!p)
+      return false;
+    h = Mix(h, from);
+    h = Mix(h, to);
+    h = Fnv(h, p, size);
+  }
+  *hash = h;
+  return true;
+}
+
+void CodeCache::Load()
+{
+  File::IOFile file(m_path, "rb");
+  if (!file)
+  {
+    Trace("no saved code for this game yet (" + m_path + ")");
+    return;
+  }
+  const u64 size = file.GetSize();
+  FileHeader header;
+  if (size < sizeof(FileHeader) || !file.ReadBytes(&header, sizeof(header)))
+  {
+    Trace("unreadable file, starting over");
+    return;
+  }
+  if (header.magic != FILE_MAGIC || header.version != FORMAT_VERSION || header.config != m_config)
+  {
+    Trace("saved for another build or other JIT options, starting over");
+    m_dirty = true;  // the next save replaces it
+    return;
+  }
+  // Block by block straight from the file: no second copy of the whole cache in memory.
+  bool complete = true;
+  for (u32 i = 0; i < header.count; i++)
+  {
+    u32 blob_size;
+    if (!file.ReadBytes(&blob_size, sizeof(blob_size)) || blob_size < sizeof(BlobHeader) ||
+        blob_size > MAX_BLOB_BYTES || m_bytes + blob_size > MAX_BYTES)
+    {
+      complete = false;
+      break;
+    }
+    std::vector<u8> blob(blob_size);
+    if (!file.ReadBytes(blob.data(), blob_size))
+    {
+      complete = false;
+      break;
+    }
+    BlobHeader h;
+    std::memcpy(&h, blob.data(), sizeof(h));
+    m_index[Key(h.em_address, h.feature_flags)] = m_blobs.size();
+    m_bytes += blob_size;
+    m_blobs.push_back(std::move(blob));
+  }
+  // What the JIT learned in earlier runs: known from the start, so blocks compile the way they
+  // were saved. (A file cut short keeps its blocks; the next save writes it whole again.)
+  if (complete)
+  {
+    const u64 at = file.Tell();
+    std::vector<u8> rest(at < size ? size - at : 0);
+    if (!rest.empty() && file.ReadBytes(rest.data(), rest.size()))
+    {
+      Reader r(rest.data(), rest.size());
+      GetSet(&r, &m_jit.js.fifoWriteAddresses);
+      GetSet(&r, &m_jit.js.pairedQuantizeAddresses);
+      GetSet(&r, &m_jit.js.noSpeculativeConstantsAddresses);
+    }
+  }
+  else
+  {
+    Trace("file cut short after " + std::to_string(m_blobs.size()) + " blocks");
+    m_dirty = true;
+  }
+  m_stats.loaded = m_blobs.size();
+  Trace("loaded " + std::to_string(m_blobs.size()) + " blocks (" +
+        std::to_string(m_bytes / 1024) + " KiB) from " + m_path);
+}
+
+void CodeCache::Save()
+{
+  if (!m_ready || !m_dirty)
+    return;
+  std::vector<u8> sets;
+  PutSet(&sets, m_jit.js.fifoWriteAddresses);
+  PutSet(&sets, m_jit.js.pairedQuantizeAddresses);
+  PutSet(&sets, m_jit.js.noSpeculativeConstantsAddresses);
+  // Written beside, then renamed: a power cut mid-write leaves the old file. Block by block: no
+  // second copy of the whole cache in memory.
+  const std::string temp = m_path + ".new";
+  {
+    File::IOFile file(temp, "wb");
+    const FileHeader header{FILE_MAGIC, FORMAT_VERSION, m_config,
+                            static_cast<u32>(m_blobs.size()), 0};
+    bool written = file.IsOpen() && file.WriteBytes(&header, sizeof(header));
+    for (const auto& blob : m_blobs)
+    {
+      const u32 blob_size = static_cast<u32>(blob.size());
+      written = written && file.WriteBytes(&blob_size, sizeof(blob_size)) &&
+                file.WriteBytes(blob.data(), blob.size());
+    }
+    written = written && file.WriteBytes(sets.data(), sets.size());
+    if (!written)
+    {
+      Trace("couldn't write " + temp);
+      return;
+    }
+  }
+  if (!File::Rename(temp, m_path))
+  {
+    Trace("couldn't replace " + m_path);
+    return;
+  }
+  m_dirty = false;
+  char line[256];
+  snprintf(line, sizeof(line),
+           "saved %zu blocks (%zu KiB); this run: %llu loaded from the cache, %llu compiled (%llu "
+           "changed since saved, %llu recompiled with new knowledge), %llu not saveable (last: "
+           "%s), %llu no code space; check: %llu compared, %llu differed",
+           m_blobs.size(), m_bytes / 1024, static_cast<unsigned long long>(m_stats.restored),
+           static_cast<unsigned long long>(m_stats.compiled),
+           static_cast<unsigned long long>(m_stats.stale),
+           static_cast<unsigned long long>(m_stats.relearned),
+           static_cast<unsigned long long>(m_stats.unsaved), m_stats.last_unsaved,
+           static_cast<unsigned long long>(m_stats.no_space),
+           static_cast<unsigned long long>(m_stats.checked),
+           static_cast<unsigned long long>(m_stats.mismatched));
+  Trace(line);
+}
+
+void CodeCache::BeginBlock()
+{
+  if (!Ready())
+    return;
+  m_records.clear();
+  m_backpatches.clear();
+  m_recording = true;
+  Gen::XEmitter::s_reloc_sink = this;
+  Gen::XEmitter::s_reloc_emitter = static_cast<const Gen::XEmitter*>(&m_jit);
+  m_jit.m_ps4_backpatch_log = &m_backpatches;
+}
+
+void CodeCache::EndBlock()
+{
+  if (!m_recording)
+    return;
+  m_recording = false;
+  Gen::XEmitter::s_reloc_emitter = nullptr;
+  Gen::XEmitter::s_reloc_sink = nullptr;
+  m_jit.m_ps4_backpatch_log = nullptr;
+}
+
+void CodeCache::PrepareFromDisc()
+{
+  const auto start = std::chrono::steady_clock::now();
+  const char* path = ps4_boot_disc_path();
+  std::unique_ptr<DiscIO::Volume> volume = path && *path ? DiscIO::CreateVolume(path) : nullptr;
+  if (!volume)
+  {
+    Trace("no disc to read the game's code from");
+    return;
+  }
+  const DiscIO::Partition partition = volume->GetGamePartition();
+  const auto dol_offset = DiscIO::GetBootDOLOffset(*volume, partition);
+  const auto dol_size = dol_offset ? DiscIO::GetBootDOLSize(*volume, partition, *dol_offset) :
+                                     std::nullopt;
+  std::vector<u8> dol(dol_size.value_or(0));
+  if (dol.size() < 0x100 || !volume->Read(*dol_offset, dol.size(), dol.data(), partition))
+  {
+    Trace("couldn't read the game's main program from the disc");
+    return;
+  }
+
+  // Its code sections, put where the game will have them (what is there now is put back after).
+  auto& system = m_jit.m_system;
+  auto& memory = system.GetMemory();
+  struct Section
+  {
+    u32 address;
+    std::vector<u8> code;
+    std::vector<u8> before;
+  };
+  std::vector<Section> sections;
+  for (int i = 0; i < 7; i++)
+  {
+    const u32 offset = BE32(&dol[i * 4]);
+    const u32 address = BE32(&dol[0x48 + i * 4]);
+    const u32 size = BE32(&dol[0x90 + i * 4]);
+    const u32 ram = address & 0x3FFFFFFF;
+    if (size == 0 || u64(offset) + size > dol.size() || (address >> 28) != 0x8 ||
+        u64(ram) + size > memory.GetRamSizeReal() || !memory.GetRAM())
+    {
+      continue;
+    }
+    Section section{address, std::vector<u8>(dol.begin() + offset, dol.begin() + offset + size),
+                    std::vector<u8>(memory.GetRAM() + ram, memory.GetRAM() + ram + size)};
+    std::memcpy(memory.GetRAM() + ram, section.code.data(), size);
+    sections.push_back(std::move(section));
+  }
+  if (sections.empty())
+  {
+    Trace("the game's main program has no code sections in RAM");
+    return;
+  }
+
+  // The CPU as the game will run: translation on, the standard GameCube BATs (the BIOS hasn't set
+  // anything up yet).
+  auto& ppc = m_jit.m_ppc_state;
+  auto& mmu = m_jit.m_mmu;
+  const u32 saved_msr = ppc.msr.Hex;
+  u32 saved_bats[16];
+  for (int i = 0; i < 16; i++)
+    saved_bats[i] = ppc.spr[SPR_IBAT0U + i];
+  ppc.spr[SPR_IBAT0U] = 0x80001FFF;
+  ppc.spr[SPR_IBAT0L] = 0x00000002;
+  ppc.spr[SPR_DBAT0U] = 0x80001FFF;
+  ppc.spr[SPR_DBAT0L] = 0x00000002;
+  ppc.spr[SPR_DBAT1U] = 0xC0001FFF;
+  ppc.spr[SPR_DBAT1L] = 0x0000002A;
+  mmu.IBATUpdated();
+  mmu.DBATUpdated();
+  ppc.msr.IR = 1;
+  ppc.msr.DR = 1;
+  system.GetPowerPC().MSRUpdated();
+
+  // Every function in those sections: from the cache if saved before (unchanged), else compiled.
+  PPCSymbolDB db;
+  {
+    const Core::CPUThreadGuard guard(system);
+    for (const Section& section : sections)
+      PPCAnalyst::FindFunctions(guard, section.address, section.address + section.code.size(), &db);
+  }
+  std::vector<u32> functions;
+  db.ForEachSymbol([&](const Common::Symbol& symbol) {
+    if (symbol.address >= 0x80003100 && symbol.address < 0x81200000)
+      functions.push_back(symbol.address);
+  });
+  ps4_prepare_total = static_cast<int>(functions.size());
+  ps4_prepare_done = 0;
+  ps4_prepare_phase = 2;
+  const CPUEmuFeatureFlags flags = ppc.feature_flags;
+  u64 saved_already = 0, compiled = 0;
+  for (size_t i = 0; i < functions.size(); i++)
+  {
+    const auto it = m_index.find(Key(functions[i], flags));
+    Parsed p;
+    u64 hash;
+    if (it != m_index.end() && Parse(m_blobs[it->second], &p) &&
+        GuestHash(Ranges(p), &hash) && hash == p.header.guest_hash && SameKnowledge(p, m_jit.js))
+    {
+      saved_already++;
+    }
+    else
+    {
+      m_jit.FreeRanges();
+      const u64 before = m_stats.compiled;
+      if (!m_jit.PS4PrecompileBlock(functions[i]))
+        break;
+      compiled += m_stats.compiled - before;
+    }
+    ps4_prepare_done = static_cast<int>(i + 1);
+  }
+  Save();
+
+  // Everything back as the BIOS expects it; the compiled blocks leave the JIT (their code isn't
+  // in memory until the game loads it - then they come back from the cache).
+  m_jit.ClearCache();
+  for (const Section& section : sections)
+    std::memcpy(memory.GetRAM() + (section.address & 0x3FFFFFFF), section.before.data(),
+                section.before.size());
+  for (int i = 0; i < 16; i++)
+    ppc.spr[SPR_IBAT0U + i] = saved_bats[i];
+  mmu.IBATUpdated();
+  mmu.DBATUpdated();
+  ppc.msr.Hex = saved_msr;
+  system.GetPowerPC().MSRUpdated();
+  ps4_prepare_phase = 0;
+  m_disc_compiled = true;
+  const auto ms =
+      std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - start)
+          .count();
+  Trace("compiled the game's main program from the disc before the BIOS: " +
+        std::to_string(functions.size()) + " functions, " + std::to_string(saved_already) +
+        " already saved, " + std::to_string(compiled) + " compiled, in " + std::to_string(ms) +
+        " ms");
+}
+
+bool CodeCache::Prepare(u32 em_address)
+{
+  if (m_prepared || m_mode != Mode::On)
+    return false;
+  // The game's own code (its main program), not the BIOS (0x81300000+), the apploader
+  // (0x81200000+) or the exception vectors below 0x80003100.
+  const bool game_code = em_address >= 0x80003100 && em_address < 0x81200000;
+  if (!game_code)
+  {
+    // A GameCube BIOS is starting (the boot animation): first the game's main program, read
+    // from the disc, is compiled - before anything shows, like RPCS3.
+    if (!m_disc_prepared && !m_jit.m_system.IsWii() && Ready())
+    {
+      m_disc_prepared = true;
+      PrepareFromDisc();
+      return true;
+    }
+    return false;
+  }
+  if (!Ready())
+    return false;
+  m_prepared = true;
+  const auto start = std::chrono::steady_clock::now();
+  const CPUEmuFeatureFlags flags = m_jit.m_ppc_state.feature_flags;
+
+  // Everything saved for this CPU mode whose code is in memory now (code the game loads later is
+  // put in place when it gets there).
+  std::vector<u32> saved;
+  for (const auto& [key, index] : m_index)
+  {
+    if (u32(key >> 32) == flags)
+      saved.push_back(u32(key));
+  }
+  std::sort(saved.begin(), saved.end());
+  ps4_prepare_total = static_cast<int>(saved.size());
+  ps4_prepare_done = 0;
+  ps4_prepare_phase = 1;
+  const u64 restored_before = m_stats.restored;
+  for (size_t i = 0; i < saved.size(); i++)
+  {
+    if (!m_jit.blocks.GetBlockFromStartAddress(saved[i], flags))
+    {
+      m_jit.FreeRanges();
+      if (m_jit.SetEmitterStateToFreeCodeRegion())
+        Restore(saved[i]);
+    }
+    ps4_prepare_done = static_cast<int>(i + 1);
+  }
+  const u64 loaded = m_stats.restored - restored_before;
+  if (m_disc_compiled)
+  {
+    // Compiled from the disc before the BIOS ran: everything is in place already.
+    ps4_prepare_phase = 0;
+    Trace("game code in place when it started: " + std::to_string(loaded) + " blocks loaded");
+    return true;
+  }
+
+  // Then every function of the game not compiled yet (found the way Dolphin's debugger finds
+  // them: from its prologues and calls).
+  PPCSymbolDB db;
+  {
+    const Core::CPUThreadGuard guard(m_jit.m_system);
+    auto& memory = m_jit.m_system.GetMemory();
+    PPCAnalyst::FindFunctions(guard, Memory::MEM1_BASE_ADDR,
+                              Memory::MEM1_BASE_ADDR + memory.GetRamSizeReal(), &db);
+  }
+  std::vector<u32> functions;
+  db.ForEachSymbol([&](const Common::Symbol& symbol) {
+    if (symbol.address >= 0x80003100 && symbol.address < 0x81200000)
+      functions.push_back(symbol.address);
+  });
+  ps4_prepare_total = static_cast<int>(functions.size());
+  ps4_prepare_done = 0;
+  ps4_prepare_phase = 2;
+  const u64 compiled_before = m_stats.compiled;
+  for (size_t i = 0; i < functions.size(); i++)
+  {
+    m_jit.FreeRanges();
+    if (!m_jit.PS4PrecompileBlock(functions[i]))
+      break;
+    ps4_prepare_done = static_cast<int>(i + 1);
+  }
+  const u64 compiled = m_stats.compiled - compiled_before;
+  Save();
+  ps4_prepare_phase = 0;
+  const auto ms =
+      std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - start)
+          .count();
+  Trace("prepared the game's code before it started: " + std::to_string(loaded) +
+        " blocks loaded, " + std::to_string(compiled) + " compiled (" +
+        std::to_string(functions.size()) + " functions found) in " + std::to_string(ms) + " ms");
+  return true;
+}
+
+void CodeCache::Rel32(u8* disp, int extra, const void* target)
+{
+  m_records.push_back({disp, static_cast<const u8*>(target), static_cast<s8>(extra), false});
+}
+
+void CodeCache::Imm64(u8* at, u64 value)
+{
+  m_records.push_back({at, reinterpret_cast<const u8*>(value), 0, true});
+}
+
+bool CodeCache::Relocate(const std::vector<u8>& blob, u8* near_dest, u8* far_dest, u8* near_at,
+                         u8* far_at)
+{
+  Parsed p;
+  if (!Parse(blob, &p))
+    return false;
+  const BlobHeader& h = p.header;
+  std::memcpy(near_dest, p.near_code, h.near_size);
+  if (h.far_size)
+    std::memcpy(far_dest, p.far_code, h.far_size);
+  for (u16 i = 0; i < h.num_relocs; i++)
+  {
+    const BlobReloc rel = Item(p.relocs, i);
+    const u8* target = nullptr;
+    switch (rel.target_section)
+    {
+    case NEAR:
+      target = near_at + rel.target_offset;
+      break;
+    case FAR:
+      target = far_at + rel.target_offset;
+      break;
+    case ASM:
+      target = m_jit.asm_routines.GetRegionStart() + rel.target_offset;
+      break;
+    case CONSTANT:
+    {
+      if (rel.target_id >= h.num_consts)
+        return false;
+      const BlobConst c = Item(p.consts, rel.target_id);
+      const void* location = m_jit.m_const_pool.PS4TryGetConstant(
+          reinterpret_cast<const void*>(c.source), c.element_size, c.num_elements);
+      if (!location)
+        return false;
+      target = static_cast<const u8*>(location) + rel.target_offset;
+      break;
+    }
+    case REGION:
+      if (rel.target_id >= m_regions.size() || !m_regions[rel.target_id].base)
+        return false;
+      target = m_regions[rel.target_id].base + rel.target_offset;
+      break;
+    default:
+      return false;
+    }
+    const bool near = rel.section == NEAR;
+    if ((near ? h.near_size : h.far_size) < rel.site + (rel.abs64 ? 8u : 4u))
+      return false;
+    u8* dest = (near ? near_dest : far_dest) + rel.site;
+    if (rel.abs64)
+    {
+      const u64 value = reinterpret_cast<u64>(target);
+      std::memcpy(dest, &value, 8);
+    }
+    else
+    {
+      const u8* at = (near ? near_at : far_at) + rel.site;
+      const s64 distance = s64(target - (at + 4 + rel.extra));
+      if (distance < -0x80000000LL || distance >= 0x80000000LL)
+        return false;
+      const s32 d32 = static_cast<s32>(distance);
+      std::memcpy(dest, &d32, 4);
+    }
+  }
+  return true;
+}
+
+bool CodeCache::Restore(u32 em_address)
+{
+  if (m_mode != Mode::On || !Ready())
+    return false;
+  const auto it = m_index.find(Key(em_address, m_jit.m_ppc_state.feature_flags));
+  if (it == m_index.end())
+    return false;
+  const std::vector<u8>& blob = m_blobs[it->second];
+  Parsed p;
+  if (!Parse(blob, &p))
+    return false;
+  const BlobHeader& h = p.header;
+  const auto translated = m_jit.m_mmu.JitCache_TranslateAddress(em_address);
+  if (!translated.valid || translated.address != h.physical_address)
+    return false;
+  const auto ranges = Ranges(p);
+  u64 guest_hash;
+  if (!GuestHash(ranges, &guest_hash) || guest_hash != h.guest_hash)
+  {
+    m_stats.stale++;
+    return false;
+  }
+  if (!SameKnowledge(p, m_jit.js))
+  {
+    m_stats.relearned++;
+    return false;
+  }
+
+  // Into the free code space JitPS4::Jit has just chosen.
+  u8* near_code = m_jit.GetWritableCodePtr();
+  u8* far_code = m_jit.m_far_code.GetWritableCodePtr();
+  if (size_t(m_jit.GetWritableCodeEnd() - near_code) < h.near_size ||
+      size_t(m_jit.m_far_code.GetWritableCodeEnd() - far_code) < h.far_size)
+  {
+    m_stats.no_space++;
+    return false;
+  }
+  RefreshRegions();
+  if (!Relocate(blob, near_code, far_code, near_code, far_code))
+    return false;
+
+  JitBlock* b = m_jit.blocks.AllocateBlock(em_address);
+  b->near_begin = near_code;
+  b->near_end = near_code + h.near_size;
+  b->far_begin = far_code;
+  b->far_end = far_code + h.far_size;
+  b->normalEntry = near_code + h.entry_offset;
+  const auto at = [&](u8 section, u32 offset) -> u8* {
+    return section == NEAR ? near_code + offset :
+           section == FAR  ? far_code + offset :
+           section == ASM  ? m_jit.asm_routines.GetRegionStart() + offset :
+                             nullptr;
+  };
+  for (u16 i = 0; i < h.num_links; i++)
+  {
+    const BlobLink link = Item(p.links, i);
+    JitBlock::LinkData data{};
+    data.exitPtrs = at(link.ptr_section, link.ptr_offset);
+    data.unlinkedTarget = at(link.stub_section, link.stub_offset);
+    data.exitAddress = link.exit_address;
+    data.linkStatus = false;
+    data.call = link.call != 0;
+    b->linkData.push_back(data);
+  }
+  for (u16 i = 0; i < h.num_backpatches; i++)
+  {
+    const BlobBackPatch bp = Item(p.backpatches, i);
+    TrampolineInfo info = bp.info;
+    info.start = at(bp.start_section, bp.start_offset);
+    m_jit.m_back_patch_info[at(bp.key_section, bp.key_offset)] = info;
+  }
+  if (h.near_size)
+    m_jit.m_free_ranges_near.erase(near_code, near_code + h.near_size);
+  if (h.far_size)
+    m_jit.m_free_ranges_far.erase(far_code, far_code + h.far_size);
+
+  PPCAnalyst::CodeBlock code_block;
+  code_block.m_address = em_address;
+  code_block.m_num_instructions = h.original_size;
+  for (const auto& [from, to] : ranges)
+    code_block.m_physical_addresses.insert(from, to);
+  m_jit.blocks.FinalizeBlock(*b, m_jit.jo.enableBlocklink, code_block, m_jit.m_code_buffer);
+  m_stats.restored++;
+  return true;
+}
+
+void CodeCache::Add(JitBlock& block, const PPCAnalyst::CodeBlock& code_block)
+{
+  if (!m_ready)
+    return;
+  m_stats.compiled++;
+  const auto unsaveable = [&](const char* why) { m_stats.unsaved++, m_stats.last_unsaved = why; };
+
+  u8* const ns = block.near_begin;
+  u8* const ne = block.near_end;
+  u8* const fs = block.far_begin;
+  u8* const fe = block.far_end;
+  // Where a code address lies: this block (end included: a jump to just past it), the shared
+  // routines, or nowhere the file can describe.
+  const auto locate = [&](const u8* a, u8* section, u64* offset) {
+    if (a >= ns && a <= ne)
+      return *section = NEAR, *offset = u64(a - ns), true;
+    if (fs != fe && a >= fs && a <= fe)
+      return *section = FAR, *offset = u64(a - fs), true;
+    if (m_jit.asm_routines.IsInSpace(a))
+      return *section = ASM, *offset = u64(a - m_jit.asm_routines.GetRegionStart()), true;
+    return false;
+  };
+
+  std::vector<BlobConst> consts;
+  std::vector<BlobReloc> relocs;
+  RefreshRegions();
+  // The last record for a place wins (an address may be written more than once while compiling).
+  std::sort(m_records.begin(), m_records.end(),
+            [](const Record& a, const Record& b) { return a.site < b.site; });
+  for (size_t i = 0; i < m_records.size(); i++)
+  {
+    if (i + 1 < m_records.size() && m_records[i + 1].site == m_records[i].site)
+      continue;
+    const Record& rec = m_records[i];
+    BlobReloc rel{};
+    u8 site_section;
+    u64 site_offset;
+    if (!locate(rec.site, &site_section, &site_offset) || site_section == ASM)
+      return unsaveable("address written outside the block");
+    rel.site = static_cast<u32>(site_offset);
+    rel.section = site_section;
+    rel.abs64 = rec.abs64;
+    rel.extra = rec.extra;
+
+    u8 section;
+    u64 offset;
+    const void* source;
+    size_t element_size, num_elements, const_offset;
+    if (locate(rec.target, &section, &offset))
+    {
+      rel.target_section = section;
+      rel.target_offset = offset;
+    }
+    else if (m_jit.m_const_pool.PS4Find(rec.target, &source, &element_size, &num_elements,
+                                        &const_offset))
+    {
+      // Only constants stored in the emulator image itself (the same address every run).
+      if (reinterpret_cast<u64>(source) >= 0x100000000ull)
+        return unsaveable("constant outside the emulator image");
+      rel.target_section = CONSTANT;
+      rel.target_offset = const_offset;
+      const auto c = std::find_if(consts.begin(), consts.end(), [&](const BlobConst& x) {
+        return x.source == reinterpret_cast<u64>(source);
+      });
+      rel.target_id = static_cast<u32>(c - consts.begin());
+      if (c == consts.end())
+        consts.push_back({reinterpret_cast<u64>(source), static_cast<u32>(element_size),
+                          static_cast<u32>(num_elements)});
+    }
+    else if (rec.abs64)
+    {
+      bool found = false;
+      for (size_t r = 0; r < m_regions.size() && !found; r++)
+      {
+        const Region& region = m_regions[r];
+        if (region.base && rec.target >= region.base && u64(rec.target - region.base) < region.size)
+        {
+          rel.target_section = REGION;
+          rel.target_id = static_cast<u32>(r);
+          rel.target_offset = u64(rec.target - region.base);
+          found = true;
+        }
+      }
+      if (!found)
+        continue;  // a plain number (or something the same in every run)
+    }
+    else
+    {
+      return unsaveable("jump to another block or code space");
+    }
+    relocs.push_back(rel);
+  }
+
+  std::vector<BlobLink> links;
+  for (const auto& link : block.linkData)
+  {
+    BlobLink l{};
+    u64 offset;
+    l.exit_address = link.exitAddress;
+    l.call = link.call;
+    if (!locate(link.exitPtrs, &l.ptr_section, &offset))
+      return unsaveable("exit outside the block");
+    l.ptr_offset = static_cast<u32>(offset);
+    l.stub_section = NONE;
+    if (link.unlinkedTarget)
+    {
+      if (!locate(link.unlinkedTarget, &l.stub_section, &offset))
+        return unsaveable("exit stub outside the block");
+      l.stub_offset = static_cast<u32>(offset);
+    }
+    links.push_back(l);
+  }
+
+  std::vector<BlobBackPatch> backpatches;
+  for (u8* key : m_backpatches)
+  {
+    const auto it = m_jit.m_back_patch_info.find(key);
+    if (it == m_jit.m_back_patch_info.end())
+      continue;
+    BlobBackPatch bp{};
+    u64 offset;
+    if (!locate(key, &bp.key_section, &offset))
+      return unsaveable("memory access outside the block");
+    bp.key_offset = static_cast<u32>(offset);
+    if (!locate(it->second.start, &bp.start_section, &offset))
+      return unsaveable("memory access outside the block");
+    bp.start_offset = static_cast<u32>(offset);
+    bp.info = it->second;
+    bp.info.start = nullptr;
+    backpatches.push_back(bp);
+  }
+
+  std::vector<std::pair<u32, u32>> ranges;
+  for (const auto& [from, to] : code_block.m_physical_addresses)
+    ranges.emplace_back(from, to);
+  BlobHeader h{};
+  h.em_address = block.effectiveAddress;
+  h.physical_address = block.physicalAddress;
+  h.feature_flags = block.feature_flags;
+  h.original_size = code_block.m_num_instructions;
+  if (!GuestHash(ranges, &h.guest_hash))
+    return unsaveable("game code outside RAM");
+  h.entry_offset = static_cast<u32>(block.normalEntry - ns);
+  h.near_size = static_cast<u32>(ne - ns);
+  h.far_size = static_cast<u32>(fe - fs);
+  if (ranges.size() > 0xFFFF || consts.size() > 0xFFFF || relocs.size() > 0xFFFF ||
+      links.size() > 0xFFFF || backpatches.size() > 0xFFFF)
+  {
+    return unsaveable("block too big");
+  }
+  h.num_ranges = static_cast<u16>(ranges.size());
+  h.num_consts = static_cast<u16>(consts.size());
+  h.num_relocs = static_cast<u16>(relocs.size());
+  h.num_links = static_cast<u16>(links.size());
+  h.num_backpatches = static_cast<u16>(backpatches.size());
+  std::vector<u32> ops;
+  for (u32 i = 0; i < code_block.m_num_instructions && i < m_jit.m_code_buffer.size(); i++)
+  {
+    const u32 address = m_jit.m_code_buffer[i].address;
+    ops.push_back(address |
+                  (m_jit.js.fifoWriteAddresses.contains(address) ? OP_FIFO_WRITE : 0));
+  }
+  if (ops.size() > 0xFFFF)
+    return unsaveable("block too big");
+  h.num_ops = static_cast<u16>(ops.size());
+  h.knowledge = BlockKnowledge(m_jit.js, h.em_address);
+
+  std::vector<u8> blob;
+  Writer w(&blob);
+  w.Put(h);
+  for (const auto& [from, to] : ranges)
+  {
+    w.Put(from);
+    w.Put(to);
+  }
+  for (const auto& c : consts)
+    w.Put(c);
+  for (const auto& r : relocs)
+    w.Put(r);
+  for (const auto& l : links)
+    w.Put(l);
+  for (const auto& bp : backpatches)
+    w.Put(bp);
+  for (u32 op : ops)
+    w.Put(op);
+  w.Bytes(ns, h.near_size);
+  w.Bytes(fs, h.far_size);
+
+  const u64 key = Key(h.em_address, h.feature_flags);
+  const auto existing = m_index.find(key);
+  if (m_mode == Mode::Check && existing != m_index.end())
+  {
+    // What the saved copy would have put here, against what was just compiled.
+    Parsed saved;
+    if (Parse(m_blobs[existing->second], &saved) && saved.header.guest_hash == h.guest_hash &&
+        saved.header.physical_address == h.physical_address && SameKnowledge(saved, m_jit.js))
+    {
+      m_stats.checked++;
+      bool same = saved.header.near_size == h.near_size && saved.header.far_size == h.far_size &&
+                  saved.header.entry_offset == h.entry_offset;
+      std::vector<u8> near_copy(saved.header.near_size), far_copy(saved.header.far_size + 1);
+      if (same)
+        same = Relocate(m_blobs[existing->second], near_copy.data(), far_copy.data(), ns, fs) &&
+               std::memcmp(near_copy.data(), ns, h.near_size) == 0 &&
+               std::memcmp(far_copy.data(), fs, h.far_size) == 0;
+      if (!same)
+      {
+        m_stats.mismatched++;
+        if (m_stats.mismatched <= 20)
+        {
+          size_t diff = 0;
+          const size_t n = std::min<size_t>(near_copy.size(), h.near_size);
+          while (diff < n && near_copy[diff] == ns[diff])
+            diff++;
+          char line[200];
+          snprintf(line, sizeof(line),
+                   "check: block %08x differs (near %u/%u bytes, far %u/%u, first near difference "
+                   "at +%zu)",
+                   h.em_address, saved.header.near_size, h.near_size, saved.header.far_size,
+                   h.far_size, diff);
+          Trace(line);
+        }
+      }
+    }
+  }
+
+  if (existing != m_index.end())
+  {
+    m_bytes -= m_blobs[existing->second].size();
+    m_bytes += blob.size();
+    m_blobs[existing->second] = std::move(blob);
+  }
+  else
+  {
+    if (m_bytes + blob.size() > MAX_BYTES)
+      return unsaveable("cache full");
+    m_bytes += blob.size();
+    m_index[key] = m_blobs.size();
+    m_blobs.push_back(std::move(blob));
+  }
+  m_dirty = true;
+}
+}  // namespace PS4Jit
+
+// DolphinNoGUI/PS4IngameMenu.cpp: new blocks saved while the game is paused in the menu.
+extern "C" void ps4_jit_cache_save()
+{
+  auto* jit = PS4Jit::JitPS4::PS4Active();
+  if (jit)
+    jit->PS4CodeCache().Save();
+}
