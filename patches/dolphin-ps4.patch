+namespace PS4Glyphs
+{
+// Width of the icon for a PS4Pad input name ("Cross", "L2 Click", "Pad N", "Left X-") or stick
+// group ("Left Stick", "Right Stick", "D-Pad") at height h; 0 when it has no icon (show text).
+float Width(const std::string& name, float h);
