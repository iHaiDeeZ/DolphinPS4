+// One line per field: tabs and line breaks inside texts become spaces.
+std::string Clean(std::string text)
+{
+  for (char& c : text)
+  {
+    if (c == '\t' || c == '\n' || c == '\r')
+      c = ' ';
+  }
+  return text;
+}
+
+std::string FilePath(const std::string& data_dir, const std::string& game)
+{
+  const std::string name = FileKey(game);
