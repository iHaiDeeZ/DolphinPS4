+}
+
+// Multi-disc games: "Name (Disc 1).rvz", "Name (Disc 2).rvz" (the usual naming). Finds the disc
+// number in a file name: position and length of its digits, or false.
+bool FindDiscNumber(const std::string& name, size_t* digits, size_t* length, int* number)
+{
+  std::string lower = name;
+  std::transform(lower.begin(), lower.end(), lower.begin(), ::tolower);
+  for (size_t at = lower.find("(disc "); at != std::string::npos;
+       at = lower.find("(disc ", at + 1))
+  {
+    size_t end = at + 6;
+    while (end < lower.size() && std::isdigit(static_cast<unsigned char>(lower[end])))
+      end++;
+    if (end > at + 6 && end < lower.size() && lower[end] == ')')
+    {
+      *digits = at + 6;
+      *length = end - (at + 6);
+      *number = std::atoi(lower.substr(at + 6, *length).c_str());
+      return true;
+    }
+  }
+  return false;
+}
+
+// The game library: every disc image in the games folder (Settings -> Game Folder, by default
+// /data/DolphinPS4/games), identified by its own header
+// (game ID, revision, disc number, internal title) rather than its file name.
+struct LibraryEntry
+{
+  std::string path;
+  std::string game_id;
+  u16 revision = 0;
+  int disc = 0;  // 0 = Disc 1
+  std::string title;
+  bool wad = false;
+  bool homebrew = false;  // .dol / .elf
+  bool wii = false;       // homebrew built for the Wii
+};
+
+bool HasExtension(const std::string& name, const char* extension)
+{
+  std::string lower = name;
+  std::transform(lower.begin(), lower.end(), lower.begin(), ::tolower);
+  const size_t length = std::strlen(extension);
+  return lower.size() > length && lower.compare(lower.size() - length, length, extension) == 0;
+}
+
+// Disc images (.tgc: GameCube demo discs), Wii title packages (.wad: WiiWare, Virtual Console,
+// channels), homebrew programs (.dol, .elf) and FIFO recordings (.dff: frames recorded with a
+// PC Dolphin's FIFO Player, replayed without the game - for graphics tests).
+bool IsDiscImage(const std::string& name)
+{
+  static const std::array<std::string, 13> extensions = {
+      ".iso", ".gcm", ".ciso", ".gcz", ".wbfs", ".wia", ".rvz", ".nkit.iso", ".tgc",
+      ".wad", ".dol", ".elf", ".dff"};
+  std::string lower = name;
+  std::transform(lower.begin(), lower.end(), lower.begin(), ::tolower);
+  for (const std::string& extension : extensions)
+  {
+    if (lower.size() > extension.size() &&
+        lower.compare(lower.size() - extension.size(), extension.size(), extension) == 0)
+      return true;
+  }
+  return false;
+}
+
+// What the library read from the network shares' discs (data_dir/cache/network-library.txt): a
+// file whose size hasn't changed isn't read again, so the menu opens without reading every disc
+// over the network. One line per file: size, path, game ID, revision, disc, wad, homebrew, wii,
+// title (tab-separated).
+constexpr const char* NETWORK_LIBRARY_CACHE = "/cache/network-library.txt";
+
+std::map<std::string, std::pair<u64, LibraryEntry>> LoadNetworkLibrary()
+{
+  std::map<std::string, std::pair<u64, LibraryEntry>> cached;
+  std::ifstream file(std::string(PS4_DATA_DIR_PATH) + NETWORK_LIBRARY_CACHE);
+  std::string line;
+  while (std::getline(file, line))
+  {
+    std::vector<std::string> fields;
+    size_t start = 0;
+    for (size_t tab; (tab = line.find('\t', start)) != std::string::npos; start = tab + 1)
+      fields.push_back(line.substr(start, tab - start));
+    fields.push_back(line.substr(start));
+    if (fields.size() != 9)
+      continue;
+    LibraryEntry game;
+    game.path = fields[1];
+    game.game_id = fields[2];
+    game.revision = static_cast<u16>(std::atoi(fields[3].c_str()));
+    game.disc = std::atoi(fields[4].c_str());
+    game.wad = fields[5] == "1";
+    game.homebrew = fields[6] == "1";
+    game.wii = fields[7] == "1";
+    game.title = fields[8];
+    cached[game.path] = {std::strtoull(fields[0].c_str(), nullptr, 10), std::move(game)};
+  }
+  return cached;
+}
+
+void SaveNetworkLibrary(const std::vector<std::pair<u64, LibraryEntry>>& entries)
+{
+  std::string text;
+  for (const auto& [size, game] : entries)
+  {
+    std::string title = game.title;
+    std::replace_if(title.begin(), title.end(), [](char c) { return c == '\t' || c == '\n' || c == '\r'; }, ' ');
+    text += fmt::format("{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\n", size, game.path, game.game_id,
+                        game.revision, game.disc, game.wad ? 1 : 0, game.homebrew ? 1 : 0,
+                        game.wii ? 1 : 0, title);
+  }
+  const std::string path = std::string(PS4_DATA_DIR_PATH) + NETWORK_LIBRARY_CACHE;
+  File::CreateFullPath(path);
+  File::WriteStringToFile(path, text);
+}
+
+std::vector<LibraryEntry> ScanLibrary(const std::string& games_dir)
+{
+  std::vector<LibraryEntry> s_library;
+  // The files to look at: the games folder's, then each network share's (Settings -> Network
+  // Shares) and those of the folders in it ("Game [ID]/game.wbfs" layouts).
+  struct Candidate
+  {
+    std::string name;
+    std::string path;
+    u64 size = 0;
+    bool network = false;
+  };
+  std::vector<Candidate> candidates;
+  std::error_code error;
+  std::filesystem::directory_iterator it(games_dir, error);
+  if (error)
+    Platform::BootTrace(("library: can't read " + games_dir + ": " + error.message()).c_str());
+  for (const auto& entry : it)
+    candidates.push_back({entry.path().filename().string(), entry.path().string()});
+  const std::vector<std::string> shares = PS4XMB::NetworkShares(PS4_DATA_DIR_PATH);
+  Common::NetFS::SetShares(shares);
+  for (const std::string& share : shares)
+  {
+    std::string base = share;
+    while (!base.empty() && base.back() == '/')
+      base.pop_back();
+    std::vector<Common::NetFS::Entry> entries;
+    if (!Common::NetFS::List(base, &entries))
+    {
+      Platform::BootTrace(("library: share " + Common::NetFS::Redact(base) + " unreachable (" +
+                           Common::NetFS::LastError() + ")")
+                              .c_str());
+      continue;
+    }
+    const size_t before = candidates.size();
+    for (const Common::NetFS::Entry& entry : entries)
+    {
+      if (!entry.directory)
+      {
+        candidates.push_back({entry.name, base + "/" + entry.name, entry.size, true});
+        continue;
+      }
+      std::vector<Common::NetFS::Entry> inner;
+      if (!Common::NetFS::List(base + "/" + entry.name, &inner))
+        continue;
+      for (const Common::NetFS::Entry& file : inner)
+      {
+        if (!file.directory)
+        {
+          candidates.push_back(
+              {file.name, base + "/" + entry.name + "/" + file.name, file.size, true});
+        }
+      }
+    }
+    Platform::BootTrace(("library: share " + Common::NetFS::Redact(base) + ": " +
+                         std::to_string(candidates.size() - before) + " files")
+                            .c_str());
+  }
+  const auto cached = shares.empty() ? decltype(LoadNetworkLibrary()){} : LoadNetworkLibrary();
+  std::vector<std::pair<u64, LibraryEntry>> network_games;
+  for (const Candidate& candidate : candidates)
+  {
+    const std::string& name = candidate.name;
+    if (!IsDiscImage(name))
+      continue;
+    if (candidate.network)
+    {
+      const auto hit = cached.find(candidate.path);
+      if (hit != cached.end() && hit->second.first == candidate.size)
+      {
+        network_games.push_back(hit->second);
+        s_library.push_back(hit->second.second);
+        continue;
+      }
+    }
+    LibraryEntry game;
+    game.path = candidate.path;
+    if (HasExtension(name, ".dff"))
+    {
+      // A FIFO recording: no game ID; its file name is its title. Dolphin's FIFO player replays it.
+      game.homebrew = true;
+      game.title = std::filesystem::path(name).stem().string();
+      if (const auto file = FifoDataFile::Load(game.path, true))
+        game.wii = file->GetIsWii();
+    }
+    else if (HasExtension(name, ".dol") || HasExtension(name, ".elf"))
+    {
+      // Homebrew: no game ID; its file name is its title. Dolphin boots it directly.
+      game.homebrew = true;
+      game.title = std::filesystem::path(name).stem().string();
+      if (HasExtension(name, ".dol"))
+      {
+        const DolReader reader(game.path);
+        game.wii = reader.IsValid() && reader.IsWii();
+      }
+      else
+      {
+        const ElfReader reader(game.path);
+        game.wii = reader.IsValid() && reader.IsWii();
+      }
+    }
+    else if (HasExtension(name, ".wad"))
+    {
+      // Dolphin installs it into the emulated Wii's storage when it starts (BootParameters).
+      game.wad = true;
+      if (std::unique_ptr<DiscIO::VolumeWAD> wad = DiscIO::CreateWAD(game.path))
+      {
+        game.game_id = wad->GetGameID();
+        game.revision = wad->GetRevision().value_or(0);
+        const auto names = wad->GetLongNames();
+        const auto english = names.find(DiscIO::Language::English);
+        game.title = english != names.end() ? english->second :
+                     names.empty()           ? std::string() :
+                                               names.begin()->second;
+      }
+    }
+    else if (std::unique_ptr<DiscIO::VolumeDisc> disc = DiscIO::CreateDisc(game.path))
+    {
+      game.game_id = disc->GetGameID();
+      game.revision = disc->GetRevision().value_or(0);
+      game.disc = disc->GetDiscNumber().value_or(0);
+      game.title = disc->GetInternalName();
+      game.wii = disc->GetVolumeType() == DiscIO::Platform::WiiDisc;
+    }
+    // A network disc that couldn't be read (the connection dropped) is read again next time.
+    if (candidate.network && (!game.game_id.empty() || game.homebrew))
+      network_games.emplace_back(candidate.size, game);
+    s_library.push_back(std::move(game));
+  }
+  if (!shares.empty() || !cached.empty())
+    SaveNetworkLibrary(network_games);
+  std::sort(s_library.begin(), s_library.end(), [](const LibraryEntry& a, const LibraryEntry& b) {
+    return std::tie(a.title, a.game_id, a.disc, a.path) <
+           std::tie(b.title, b.game_id, b.disc, b.path);
+  });
+  for (const LibraryEntry& game : s_library)
+  {
+    char line[512];
+    snprintf(line, sizeof(line), "library: %s rev %u disc %d \"%s\" (%s)",
+             game.game_id.empty() ? "??????" : game.game_id.c_str(), game.revision, game.disc + 1,
+             game.title.c_str(), std::filesystem::path(game.path).filename().string().c_str());
+    Platform::BootTrace(line);
+  }
+  return s_library;
+}
+
+const std::vector<LibraryEntry>& GameLibrary()
+{
+  static const std::vector<LibraryEntry> s_library =
+      ScanLibrary(PS4XMB::GamesDir(PS4_DATA_DIR_PATH));
+  return s_library;
+}
+
+// All discs of the game `path` belongs to, `path` first, then the others in disc order (wrapping
+// around). Dolphin switches between them when the game asks for another disc, so players never
+// have to write an .m3u playlist. Discs belong together when their headers have the same game ID
+// and revision (file names don't matter); images whose header can't be read are grouped by a
+// "(Disc N)" in their names instead.
+std::vector<std::string> FindAllDiscs(const std::string& path)
+{
+  {
+    const std::vector<LibraryEntry>& library = GameLibrary();
+    const std::filesystem::path chosen_path(path);
+    const auto chosen = std::find_if(library.begin(), library.end(), [&](const LibraryEntry& game) {
+      return std::filesystem::path(game.path) == chosen_path;
+    });
+    if (chosen != library.end() && !chosen->game_id.empty())
+    {
+      std::vector<const LibraryEntry*> discs;
+      for (const LibraryEntry& game : library)
+      {
+        if (game.game_id == chosen->game_id && game.revision == chosen->revision)
+          discs.push_back(&game);
+      }
+      std::sort(discs.begin(), discs.end(),
+                [](const LibraryEntry* a, const LibraryEntry* b) { return a->disc < b->disc; });
+      std::vector<std::string> ordered;
+      for (const LibraryEntry* game : discs)
+      {
+        if (game->disc >= chosen->disc)
+          ordered.push_back(game->path);
+      }
+      for (const LibraryEntry* game : discs)
+      {
+        if (game->disc < chosen->disc)
+          ordered.push_back(game->path);
+      }
+      if (!ordered.empty() && ordered.front() == chosen->path)
+        return ordered;
+    }
+  }
+
+  const std::filesystem::path chosen(path);
+  const std::string name = chosen.filename().string();
+  size_t digits, length;
+  int number;
+  if (!FindDiscNumber(name, &digits, &length, &number))
+    return {path};
+  const std::string prefix = name.substr(0, digits);
+  const std::string suffix = name.substr(digits + length);
+  std::vector<std::pair<int, std::string>> discs;
+  std::error_code error;
+  for (const auto& entry : std::filesystem::directory_iterator(chosen.parent_path(), error))
+  {
+    const std::string other = entry.path().filename().string();
+    size_t other_digits, other_length;
+    int other_number;
+    if (FindDiscNumber(other, &other_digits, &other_length, &other_number) &&
+        other.substr(0, other_digits) == prefix &&
+        other.substr(other_digits + other_length) == suffix)
+    {
+      discs.emplace_back(other_number, entry.path().string());
+    }
+  }
+  std::sort(discs.begin(), discs.end());
+  std::vector<std::string> ordered;
+  for (const auto& [disc, file] : discs)
+  {
+    if (disc >= number)
+      ordered.push_back(file);
+  }
+  for (const auto& [disc, file] : discs)
+  {
+    if (disc < number)
+      ordered.push_back(file);
+  }
+  if (ordered.empty() || ordered.front() != chosen.string())
+    return {path};  // the chosen file wasn't found by the scan (odd path): just boot it
+  return ordered;
+}
+
+std::string FindGame()
+{
+  // /data/DolphinPS4/boot.txt: path of the game to start (first line).
+  if (FILE* file = fopen((std::string(PS4_DATA_DIR_PATH) + "/boot.txt").c_str(), "r"))
+  {
+    char line[1024] = {};
+    const bool read = fgets(line, sizeof(line), file) != nullptr;
+    fclose(file);
+    std::string path = read ? line : "";
+    while (!path.empty() && (path.back() == '\n' || path.back() == '\r' || path.back() == ' '))
+      path.pop_back();
+    if (!path.empty())
+      return path;
+  }
+
+  // Otherwise the first game of the library (by title), on its first disc.
+  for (const LibraryEntry& game : GameLibrary())
+  {
+    if (!game.game_id.empty() && game.disc == 0)
+      return game.path;
+  }
+
+  // Otherwise the first game in the games folder, in name order.
+  const std::array<std::string, 12> extensions = {".iso", ".gcm", ".ciso", ".gcz", ".wbfs",
+                                                  ".wia", ".rvz", ".dol", ".elf", ".wad", ".nkit.iso",
+                                                  ".m3u"};
+  std::vector<std::string> games;
+  std::error_code error;
+  for (const auto& entry :
+       std::filesystem::directory_iterator(PS4XMB::GamesDir(PS4_DATA_DIR_PATH), error))
+  {
+    std::string name = entry.path().filename().string();
+    // Only the first disc of a multi-disc game is a game to start (the others come with it).
+    size_t disc_digits, disc_length;
+    int disc_number;
+    if (FindDiscNumber(name, &disc_digits, &disc_length, &disc_number) && disc_number != 1)
+      continue;
+    std::string lower = name;
+    std::transform(lower.begin(), lower.end(), lower.begin(), ::tolower);
+    for (const std::string& extension : extensions)
+    {
+      if (lower.size() > extension.size() &&
+          lower.compare(lower.size() - extension.size(), extension.size(), extension) == 0)
+      {
+        games.push_back(entry.path().string());
+        break;
+      }
+    }
+  }
+  std::sort(games.begin(), games.end());
+  return games.empty() ? std::string() : games.front();
+}
+
+// Controller mappings for the DualShock 4 (ciface::PS4Pad), written on first launch only so that
+// user edits are kept.
+void WriteDefaultFile(const std::string& path, const char* contents)
+{
+  struct stat st;
+  if (stat(path.c_str(), &st) == 0)
+    return;
+  if (FILE* file = fopen(path.c_str(), "w"))
+  {
+    fputs(contents, file);
+    fclose(file);
+  }
+}
+
+void WriteDefaultConfig(const std::string& user_dir)
+{
+  mkdir(user_dir.c_str(), 0777);
+  mkdir((user_dir + "/Config").c_str(), 0777);
+  // The Wii SD card's folder (Settings -> System -> SD Card Folder), ready to copy files into.
+  mkdir((user_dir + "/Load").c_str(), 0777);
+  mkdir((user_dir + "/Load/WiiSDSync").c_str(), 0777);
+  mkdir((user_dir + "/Load/Riivolution").c_str(), 0777);
+  mkdir((user_dir + "/Load/Riivolution/riivolution").c_str(), 0777);
+  PS4Controls::SetUserDirectory(user_dir);
+  PS4Controls::WriteDefaultsIfMissing();
+}
+
+// The game stopped without the in-game menu's Quit Game: data_dir/last-stop.txt for the menu
+// (PS4XMB.cpp shows it once, then removes it): the panel's title, then its lines. The game's part
+// is prepared at its start, so the crash handler (a signal handler) only open()s and write()s.
+char s_stop_game[512] = {};
+// The app is restarting into the menu or closing (OnExit): a crash now is a thread of the
+// process being replaced - no note, and no crash report; the restart in progress finishes.
+volatile int s_exiting = 0;
+char s_stop_path[512] = {};
+char s_to_menu_path[512] = {};
+
+void SetStopGame(const std::string& title, const std::string& id)
+{
+  snprintf(s_stop_game, sizeof(s_stop_game), "%s%s%s\n", title.c_str(),
+           id.empty() ? "" : "  -  ", id.c_str());
+  snprintf(s_stop_path, sizeof(s_stop_path), "%s/last-stop.txt", PS4_DATA_DIR_PATH);
+  snprintf(s_to_menu_path, sizeof(s_to_menu_path), "%s/to-menu.txt", PS4_DATA_DIR_PATH);
+  ps4_self_path();  // its path made now: the crash handler mustn't allocate
+}
+
+void WriteStopNote(const char* title, const char* what, const char* where)
+{
+  if (!s_stop_game[0])
+    return;
+  const int fd = open(s_stop_path, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+  if (fd < 0)
+    return;
+  const auto put = [fd](const char* text) {
+    if (text)
+      write(fd, text, strlen(text));
+  };
+  put(title);
+  put("\n\n");
+  put(s_stop_game);
+  put("\n");
+  put(what);
+  put("\n\n");
+  put(where);
+  put("\n");
+  close(fd);
+  // Back to the game list, not into the default game again (to-menu.txt).
+  const int menu = open(s_to_menu_path, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+  if (menu >= 0)
+    close(menu);
+}
+
+// The game didn't start (MainNoGUI): its own note, kept by OnExit.
+bool s_boot_failed = false;
+
+void OnExit()
+{
+  s_exiting = 1;
+  ps4_sampler_shutdown();
+  // The raw exit syscall isn't allowed for apps: ask the system to close us, or restart into the
+  // XMB when the in-game menu's "Quit Game" stopped the emulation.
+  fflush(stderr);
+  if (PS4IngameMenu::RestartGame())
+  {
+    ps4_relaunch_game();
+    sceSystemServiceLoadExec(ps4_self_path(), nullptr);
+  }
+  if (PS4IngameMenu::ReturnToXMB())
+  {
+    ps4_return_to_menu();
+    sceSystemServiceLoadExec(ps4_self_path(), nullptr);
+  }
+  if (s_stop_game[0] && s_boot_failed && Platform::GetPS4Option("xmb", "on") == "on")
+  {
+    Platform::BootTrace("the game didn't start: back to the menu");
+    sceSystemServiceLoadExec(ps4_self_path(), nullptr);
+  }
+  if (s_stop_game[0] && Platform::GetPS4Option("xmb", "on") == "on")
+  {
+    // The emulation ended by itself (an error, or the game ended): back to the game list with why.
+    Platform::BootTrace("the game stopped by itself: back to the menu");
+    WriteStopNote("Game Stopped", "The game stopped unexpectedly.",
+                  "Details are in dolphin.log and boot-trace.log (in /data/DolphinPS4).");
+    sceSystemServiceLoadExec(ps4_self_path(), nullptr);
+  }
+  sceSystemServiceLoadExec("exit", nullptr);
+  for (;;)
+    sceKernelUsleep(100000);
+}
