diff --git a/Source/Core/VideoCommon/PS4Profile.h b/Source/Core/VideoCommon/PS4Profile.h
new file mode 100644
index 0000000..e39e130
--- /dev/null
+++ b/Source/Core/VideoCommon/PS4Profile.h
@@ -0,0 +1,75 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// PS4 port: cheap per-category timing of the video thread, reported by the DolphinNoGUI
+// monitor (boot-trace.log) as milliseconds per second. Timed with the TSC (rdtsc), so a scope
+// costs a few nanoseconds. Counters are shared between threads without locking: they are
+// approximate on purpose.
+
+#pragma once
+
+// PS4: one uniform block with the pixel and vertex constants (PixelShaderGen.cpp,
+// PS4WriteCombinedUniformBlock). Off: it halves the constant uploads, but every shader then
+// declares ~80 more uniforms, and Piglet's shader compiler ran out of libkernel internal memory
+// ("OUT OF MEMORY", "Internal Memory is running out") within a minute in Sonic Adventure DX.
+#define PS4_COMBINED_UNIFORM_BLOCK 0
+
+#ifdef __ORBIS__
+#include <x86intrin.h>
+
+enum PS4ProfileCategory
+{
+  PS4_PROF_FLUSH,           // VertexManagerBase::Flush: one whole game draw, all below included
+  PS4_PROF_VERTEX_UPLOAD,   // vertex + index stream upload
+  PS4_PROF_UNIFORMS,        // shader constant upload
+  PS4_PROF_DRAW,            // glDrawElements
+  PS4_PROF_PIPELINE,        // pipeline (program + state) switch
+  PS4_PROF_TEXTURE_CACHE,   // texture cache lookup/decode for a draw
+  PS4_PROF_TEXTURE_UPLOAD,  // glTexSubImage of decoded textures
+  PS4_PROF_SHADER_COMPILE,  // GLSL compile
+  PS4_PROF_PROGRAM_LINK,    // program link
+  PS4_PROF_EFB_COPY,        // EFB to texture/XFB copies
+  PS4_PROF_EFB_PEEK,        // CPU reads of the EFB (GPU readback)
+  PS4_PROF_PRESENT,         // swap
+  PS4_PROF_GPU_FIFO,        // video thread processing GX commands (includes the draws above)
+  PS4_PROF_CPU_WAIT,        // emulated CPU thread waiting for the video thread (Sync GPU)
+  PS4_PROF_TLBIE,           // tlbie instructions (count only)
+  PS4_PROF_PAGETABLE,       // page table rescans for fastmem mappings (MMU::PageTableUpdated)
+  PS4_PROF_CATEGORY_COUNT
+};
+
+// Live GL objects (Piglet takes kernel-internal memory per object; running out crashes it).
+extern "C" int ps4_gl_shaders, ps4_gl_programs, ps4_gl_textures;
+// Total GL objects created / textures reused from the recycle pool (OGLGfx.cpp).
+extern "C" int ps4_gl_texture_creations, ps4_gl_texture_reuses, ps4_gl_fbo_creations;
+
+// Free libkernel internal memory in bytes (sceKernelInternalMemoryGetAvailableSize): the pool
+// Piglet's objects and shader compiles draw from, whose exhaustion crashes the app.
+extern "C" unsigned long long ps4_internal_memory_free();
+
+extern "C" unsigned long long ps4_prof_ticks[PS4_PROF_CATEGORY_COUNT];
+extern "C" unsigned long long ps4_prof_count[PS4_PROF_CATEGORY_COUNT];
+
+struct PS4ProfileScope
+{
+  explicit PS4ProfileScope(int category) : m_category(category), m_start(__rdtsc()) {}
+  ~PS4ProfileScope()
+  {
+    ps4_prof_ticks[m_category] += __rdtsc() - m_start;
+    ps4_prof_count[m_category]++;
+  }
+  int m_category;
+  unsigned long long m_start;
+};
+
+// Each scope reads the TSC twice (~40 cycles each on Jaguar), and the hottest scopes run millions
+// of times per second (Crash: ~1.9M Flush calls/s, most returning at once), so the timers are only
+// compiled into profiling builds (-DPS4_PROFILE_TIMERS).
+#ifdef PS4_PROFILE_TIMERS
+#define PS4_PROFILE(category) PS4ProfileScope ps4_profile_scope(category)
+#else
+#define PS4_PROFILE(category)
+#endif
+#else
+#define PS4_PROFILE(category)
+#endif
