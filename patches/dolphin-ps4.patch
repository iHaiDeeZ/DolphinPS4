+void PS4WriteCombinedUniformBlock(ShaderCode& out)
+{
+  // std140 packs scalars tightly, the C++ struct is padded to 16 bytes after its last member:
+  // explicit padding keeps the vertex constants at sizeof(PixelShaderConstants).
+  constexpr size_t pixel_end = offsetof(PixelShaderConstants, time_ms) + sizeof(u32);
