+int TrophyTier(uint32_t points)
+{
+  return points >= 50 ? 4 : points >= 25 ? 3 : points >= 10 ? 2 : 1;
+}
+
+std::string ShortDate(int64_t when)
+{
+  if (when <= 0)
+    return {};
+  const std::time_t then = static_cast<std::time_t>(when);
+  std::tm day = {};
+  localtime_r(&then, &day);
+  char text[32];
+  std::strftime(text, sizeof(text), "%b %e, %Y", &day);
+  return text;
+}
+
+std::string FitText(const std::string& text, size_t max)
+{
+  return text.size() <= max ? text : text.substr(0, max - 3) + "...";
+}
