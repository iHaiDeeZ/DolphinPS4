+// Re-specifying a buffer with glBufferData for every draw led to random Piglet GPU crashes
+// (old storage released while the GPU still reads it), so each binding cycles through a ring
+// of buffers allocated once and filled with glBufferSubData. A buffer is only rewritten after
+// a fence shows the GPU is done with its previous contents.
+class PS4UniformRing
+{
+public:
+  static constexpr u32 CAPACITY = 8 * 1024;
+  static constexpr u32 GROUP = 32;  // buffers covered by one fence
+
+  // per_draw: the pixel and vertex rings, written for nearly every draw. Their size comes from
+  // ps4.ini uniform_ring (buffers per ring) and their buffers are sized to the block; a ring
+  // that comes back to a buffer too soon lets a write reach constants the GPU hasn't read yet.
+  explicit PS4UniformRing(bool per_draw) : m_per_draw(per_draw) {}
+
+  // Uploads data into the next buffer of the ring and binds it whole to binding point index.
+  // index < 0: store only; the caller binds (ranges of) the returned buffer.
+  GLuint Upload(int index, const void* data, u32 size)
+  {
+    if (m_buffers.empty())
+    {
+      // The other rings (utility draws, custom constants) see a few uploads per frame: 64 is
+      // plenty, and every GL buffer takes kernel-internal memory on Piglet.
+      m_count = m_per_draw ? std::max<u32>(GROUP, ps4_uniform_ring_count / GROUP * GROUP) : 32;
+      // Each GL buffer costs ~3.7 KiB of libkernel internal memory (~12.7 MiB in all).
+      const unsigned long long ps4_free_before = ps4_internal_memory_free();
+      m_alloc_size = m_per_draw ? (size + 255) / 256 * 256 : CAPACITY;
+      m_buffers.resize(m_count);
+      m_fences.resize(m_count / GROUP);
+      glGenBuffers(m_count, m_buffers.data());
+      for (GLuint buffer : m_buffers)
+      {
+        glBindBuffer(GL_UNIFORM_BUFFER, buffer);
+        glBufferData(GL_UNIFORM_BUFFER, m_alloc_size, nullptr, GL_DYNAMIC_DRAW);
+      }
+      char line[128];
+      snprintf(line, sizeof(line), "uniform ring: %u buffers of %u bytes, internal memory %+lld KiB",
+               m_count, m_alloc_size,
+               (static_cast<long long>(ps4_internal_memory_free()) -
+                static_cast<long long>(ps4_free_before)) /
+                   1024);
+      ps4_boot_trace(line);
+    }
+    if (size > m_alloc_size)
