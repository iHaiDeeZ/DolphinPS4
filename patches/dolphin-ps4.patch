+// ---------------------------------------------------------------------------------------------
+// Updates.
+
+void Menu::StartUpdateCheck(bool manual)
+{
+  m_update_manual = m_update_manual || manual;
+  const UpdateState state = m_update_state;
+  if (m_update_thread.joinable() || state == UpdateState::Downloading ||
+      state == UpdateState::Installing || state == UpdateState::Finished)
+  {
+    return;
+  }
+  m_update_state = UpdateState::Checking;
+  m_update_thread = std::thread([this] {
+    const PS4Updater::Release release =
+        PS4Updater::CheckLatest(m_assets_dir + "/xmb/cacert.pem");
+    std::lock_guard lock(m_update_mutex);
+    m_update_release = release;
+    m_update_error = release.error;
+    if (!release.ok)
+      m_update_state = UpdateState::Failed;
+    else if (PS4Updater::CompareVersions(release.version, m_version) > 0)
+      m_update_state = UpdateState::Available;
+    else
+      m_update_state = UpdateState::UpToDate;
+  });
+}
+
+void Menu::StartUpdateDownload()
+{
+  if (m_update_thread.joinable())
+    m_update_thread.join();
+  m_update_cancel = false;
+  m_update_done = 0;
+  m_update_total = m_update_release.size;
+  m_update_state = UpdateState::Downloading;
+  m_update_thread = std::thread([this] {
+    PS4Updater::Release release;
+    {
+      std::lock_guard lock(m_update_mutex);
+      release = m_update_release;
+    }
+    const std::string dir = m_data_dir + "/update";
+    mkdir(dir.c_str(), 0777);
+    const std::string path = dir + "/DolphinPS4-v" + release.version + ".pkg";
+    std::string error;
+    const bool downloaded = PS4Updater::Download(
+        release, path, m_assets_dir + "/xmb/cacert.pem",
+        [this](uint64_t done, uint64_t total) {
+          m_update_done = done;
+          if (total)
+            m_update_total = total;
+          return !m_update_cancel;
+        },
+        &error);
+    if (!downloaded)
+    {
+      std::lock_guard lock(m_update_mutex);
+      m_update_error = m_update_cancel ? "" : error;
+      m_update_state = m_update_cancel ? UpdateState::Available : UpdateState::Failed;
+      return;
+    }
+    m_update_state = UpdateState::Installing;
+    const std::string install_error = PS4Updater::Install(path);
+    std::lock_guard lock(m_update_mutex);
+    if (install_error.empty())
+    {
+      m_update_state = UpdateState::Finished;
+      return;
+    }
+    // The installer said no: keep the checked package where package installers look.
+    const std::string kept = "/data/pkg/DolphinPS4-v" + release.version + ".pkg";
+    mkdir("/data/pkg", 0777);
+    m_update_error = install_error;
+    if (std::rename(path.c_str(), kept.c_str()) == 0)
+      m_update_error += "\nThe package is saved as " + kept + ": install it with your package installer.";
+    m_update_state = UpdateState::Failed;
+  });
+}
+
+// The update panel shows the state: checking, the prompt, the download, the result.
+void Menu::ShowUpdatePanel()
+{
+  PS4Updater::Release release;
+  std::string error;
+  {
+    std::lock_guard lock(m_update_mutex);
+    release = m_update_release;
+    error = m_update_error;
+  }
+  const std::string latest = "Dolphin v" + release.version;
+  std::vector<std::string> lines, options;
+  std::string title = "Updates";
+  switch (m_update_state.load())
+  {
+  case UpdateState::Idle:
+  case UpdateState::Checking:
+    lines = {"", "Looking for a new version on GitHub..."};
+    break;
+  case UpdateState::UpToDate:
+    lines = {"", "You have the latest version.", "", "Installed: v" + m_version};
+    break;
+  case UpdateState::Available:
+  {
+    title = "Update Available";
+    char size[32];
+    snprintf(size, sizeof(size), "%.0f MB", release.size / (1024.0 * 1024.0));
+    lines = {"", latest + " is available.", "You have v" + m_version + ".", "",
+             "Download it (" + std::string(size) + ") and install it?"};
+    options = {"Yes", "No"};
+    break;
+  }
+  case UpdateState::Downloading:
+  {
+    title = "Downloading Update";
+    const uint64_t done = m_update_done, total = std::max<uint64_t>(m_update_total, 1);
+    char line[96];
+    snprintf(line, sizeof(line), "%d%%   %.0f of %.0f MB", static_cast<int>(done * 100 / total),
+             done / (1024.0 * 1024.0), total / (1024.0 * 1024.0));
+    lines = {"", latest, line, "", "Keep the app open until it's done."};
+    options = {"Cancel"};
+    break;
+  }
+  case UpdateState::Installing:
+    title = "Installing Update";
+    lines = {"", latest + " downloaded and checked.", "", "Starting the install..."};
+    break;
+  case UpdateState::Finished:
+    title = "Installing Update";
+    lines = {"", "The PS4 is installing " + latest, "in the background.", "",
+             "Dolphin closes now. Open it again from", "the home screen once the install is done."};
+    options = {"OK"};
+    break;
+  case UpdateState::Failed:
+  {
+    title = "Update";
+    lines = {"", m_update_prompted ? "The update didn't work:" : "Couldn't check for updates:"};
+    size_t start = 0;
+    while (start <= error.size())
+    {
+      const size_t end = error.find('\n', start);
+      lines.push_back(error.substr(start, end == std::string::npos ? std::string::npos :
+                                                                      end - start));
+      if (end == std::string::npos)
+        break;
+      start = end + 1;
+    }
+    options = {"OK"};
+    break;
+  }
+  }
+  const bool same_options = m_panel.options == options;
+  m_panel.open = true;
+  m_panel.setting = SET_UPDATE;
+  m_panel.title = title;
+  m_panel.lines = lines;
+  m_panel.rows.clear();
+  if (!same_options)
+  {
+    m_panel.options = options;
+    m_panel.selected = 0;
+  }
+}
+
+void Menu::UpdateUpdater(float dt)
+{
+  const UpdateState state = m_update_state;
+  const bool settled = state == UpdateState::UpToDate || state == UpdateState::Available ||
+                       state == UpdateState::Failed || state == UpdateState::Finished;
+  if (settled && m_update_thread.joinable())
+    m_update_thread.join();
+
+  // A new version found in the background: ask once, when nothing else is on screen.
+  if (state == UpdateState::Available && !m_update_prompted && !m_intro && m_launch < 0 &&
+      (!m_panel.open || m_panel.setting == SET_UPDATE))
+  {
+    m_update_prompted = true;
+    ShowUpdatePanel();
+    Play("menu");
+    return;
+  }
+  if (!m_panel.open || m_panel.setting != SET_UPDATE)
+  {
+    // Background results nobody asked to see stay quiet (they're in the log).
+    if (state == UpdateState::Finished)
+      ShowUpdatePanel();
+    return;
+  }
+  if (state == UpdateState::Available)
+    m_update_prompted = true;
+  ShowUpdatePanel();
+  if (state == UpdateState::Finished)
+  {
+    if (m_update_close_in < 0.0f)
+    {
+      m_update_close_in = 8.0f;
+      Play("confirm");
+    }
+    m_update_close_in -= dt;
+    if (m_update_close_in <= 0.0f)
+    {
+      m_update_exit = true;
+      m_quit = true;
+    }
+  }
+}
+
+// Update packages from earlier runs: once that version (or a newer one) is running, they're no
+// longer needed. A package for a newer version is kept, as its install may still be going on.
+void Menu::RemoveOldUpdates()
+{
+  std::error_code ec;
+  const std::string dir = m_data_dir + "/update";
+  for (const auto& entry : std::filesystem::directory_iterator(dir, ec))
+  {
+    const std::string name = entry.path().filename().string();
+    const bool partial = name.size() > 5 && name.compare(name.size() - 5, 5, ".part") == 0;
+    const size_t v = name.find("-v");
+    const std::string version = v == std::string::npos ? "" : name.substr(v + 2);
+    if (partial || version.empty() || PS4Updater::CompareVersions(version, m_version) <= 0)
+    {
+      std::filesystem::remove(entry.path(), ec);
+      Log("update: removed " + name);
+    }
+  }
+}
+
+std::string Menu::Run()
+{
+  s_log = fopen((m_data_dir + "/xmb.log").c_str(), "w");
+  File::SetUserPath(D_USER_IDX, m_data_dir + "/User/");
+  PS4Controls::SetUserDirectory(m_data_dir + "/User");
+  PS4Controls::WriteDefaultsIfMissing();
+  int user = 0;
+  sceUserServiceInitialize(nullptr);
+  sceUserServiceGetInitialUser(&user);
+
+  IMGUI_CHECKVERSION();
+  ImGui::CreateContext();
+  ImGuiIO& io = ImGui::GetIO();
+  io.IniFilename = nullptr;
+  io.LogFilename = nullptr;
+  io.DisplaySize = ImVec2(W, H);
+  if (!m_display.Initialize())
+  {
+    ImGui::DestroyContext();
+    return {};
+  }
+  m_audio.Start(user);
+  m_input.Open(user);
+  LoadAssets();
+  ApplyPreferences();
+  BuildItems();
+  // Start on the game played last.
+  auto& games = m_items[static_cast<int>(Category::Games)];
+  for (size_t i = 0; i < games.size(); i++)
+  {
+    if (games[i].game >= 0 && m_games[games[i].game].path == m_prefs.last_game)
+    {
+      m_selected[static_cast<int>(Category::Games)] = static_cast<int>(i);
+      m_item_pos[static_cast<int>(Category::Games)] = static_cast<float>(i);
+    }
+  }
+  RemoveOldUpdates();
+  if (m_prefs.auto_update)
+    StartUpdateCheck(false);
+  // Covers missing for any game are fetched in the background every time the app opens.
+  for (const Game& game : m_games)
+  {
+    if (!game.id.empty() && game.cover == ImTextureID{})
+    {
+      Log("covers: downloading the missing ones in the background");
+      StartCoverDownload();
+      break;
+    }
+  }
+  Log("menu: " + std::to_string(m_games.size()) + " games, " +
+      std::to_string(m_wallpapers.size()) + " wallpapers");
+
+  auto last = Clock::now();
+  std::string result;
+  while (!m_quit)
+  {
+    const auto now = Clock::now();
+    const float dt = std::clamp(std::chrono::duration<float>(now - last).count(), 0.0f, 0.1f);
+    last = now;
+    m_time += dt;
+    io.DeltaTime = dt > 0.0f ? dt : 1.0f / 60.0f;
+
+    UpdateCapture(dt);
+    if (m_intro)
+    {
+      // Any button: straight to the dissolve.
+      if (m_input.Poll(dt) != 0)
+        m_intro_time = std::max(m_intro_time, 1.9f);
+    }
+    else if (!m_capture)
+    {
+      HandleInput(m_input.Poll(dt));
+    }
+    UpdateCoverDownload();
+    UpdateUpdater(dt);
+
+    m_display.BeginFrame();
+    ImGui::NewFrame();
+    Draw(dt);
+    ImGui::Render();
+    m_display.EndFrame();
+
+    if (m_launch >= 0 && m_launch_time >= 0.75f)
+    {
+      result = m_games[m_launch].path;
+      break;
+    }
+  }
+
+  m_cover_cancel = true;
+  if (m_cover_thread.joinable())
+    m_cover_thread.join();
+  m_update_cancel = true;
+  if (m_update_thread.joinable())
+    m_update_thread.join();
+  if (m_update_exit)
+    result = EXIT_APP;
+  m_audio.Stop();
+  m_display.Shutdown();
+  ImGui::DestroyContext();
+  return result;
+}
+}  // namespace
+
+std::string GamesDir(const std::string& data_dir)
+{
+  Preferences prefs;
+  prefs.Load(data_dir + "/xmb.ini");
+  return prefs.games_dir.empty() ? data_dir + "/games" : prefs.games_dir;
+}
+
+std::string Run(const ScanFunction& scan, const std::string& data_dir,
+                const std::string& assets_dir, const std::string& version)
+{
+  Menu menu(scan, data_dir, assets_dir, version);
+  return menu.Run();
+}
+}  // namespace PS4XMB
diff --git a/Source/Core/DolphinNoGUI/PS4XMB.h b/Source/Core/DolphinNoGUI/PS4XMB.h
new file mode 100755
