+      m_ps4_idle_target = m_ps4_written.load(std::memory_order_relaxed);
+      break;
+    }
+  }
+  clock_gettime(CLOCK_MONOTONIC, &t1);
+  ps4_wait_add(0, (t1.tv_sec - t0.tv_sec) * 1000000000ll + (t1.tv_nsec - t0.tv_nsec));
