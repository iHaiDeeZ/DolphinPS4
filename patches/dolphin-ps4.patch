+
+std::vector<std::string> NetworkShares(const std::string& data_dir)
+{
+  std::vector<std::string> shares;
+  std::ifstream file(data_dir + "/shares.txt");
+  std::string line;
+  while (std::getline(file, line))
+  {
+    while (!line.empty() && (line.back() == '\r' || line.back() == ' ' || line.back() == '\t'))
+      line.pop_back();
+    const size_t start = line.find_first_not_of(" \t");
+    if (start == std::string::npos || line[start] == '#')
+      continue;
+    shares.push_back(line.substr(start));
+  }
+  return shares;
+}
+
+void SaveNetworkShares(const std::string& data_dir, const std::vector<std::string>& shares)
+{
+  // Written beside it, flushed, then renamed over it: a power cut leaves the old or the new file.
+  const std::string path = data_dir + "/shares.txt", temp = path + ".tmp";
+  {
+    std::ofstream file(temp, std::ios::trunc);
+    file << "# Network shares with games (Settings -> Network Shares), one per line:\n"
+            "#   nfs://192.168.0.10/export/games       (NFS 4: nfs://...?version=4)\n"
+            "#   smb://user:password@192.168.0.10/share/games   (no user: Guest)\n";
+    for (const std::string& share : shares)
+      file << share << '\n';
+  }
+  const int fd = open(temp.c_str(), O_RDONLY);
+  if (fd >= 0)
+  {
+    fsync(fd);
+    close(fd);
+  }
+  std::rename(temp.c_str(), path.c_str());
+}
+
+std::string Run(const ScanFunction& scan, const std::string& data_dir,
+                const std::string& assets_dir, const std::string& version)
+{
+  Menu menu(scan, data_dir, assets_dir, version);
+  return menu.Run();
+}
