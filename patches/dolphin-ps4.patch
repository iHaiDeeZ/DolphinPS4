+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// The PS4 in-game menu: L3+R3 pauses the game and shows an XMB-style overlay (resume, save and
+// load states, aspect ratio, FPS counter, quit to the XMB). Its logic runs on the host thread
+// (PlatformPS4's main loop); it is drawn by Dolphin's on-screen ImGui layer on the video thread,
+// which keeps redrawing the paused frame while the menu is open (VideoCommon/Fifo.cpp).
+
+#pragma once
+
+namespace Core
+{
+class System;
+}
+
+namespace PS4IngameMenu
+{
+// Called by PlatformPS4's main loop (~60 times a second).
+void Poll(Core::System& system);
+// Installs the overlay drawing hook (VideoCommon/OnScreenUI.cpp).
+void Install();
+// "Quit Game" was chosen: the app restarts into the XMB instead of closing.
+bool ReturnToXMB();
+// "Restart Game" stopped the emulation: the app restarts straight into the same game.
+bool RestartGame();
+}  // namespace PS4IngameMenu
diff --git a/Source/Core/DolphinNoGUI/PS4Lang.cpp b/Source/Core/DolphinNoGUI/PS4Lang.cpp
new file mode 100644
index 0000000..f5a5796
--- /dev/null
+++ b/Source/Core/DolphinNoGUI/PS4Lang.cpp
@@ -0,0 +1,413 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "DolphinNoGUI/PS4Lang.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <mutex>
+#include <unordered_map>
+#include <unordered_set>
+
+extern "C" void ps4_boot_trace(const char* line);  // port/ps4_crashlog.cpp
+
+// The right-to-left hook of ImGui's text drawing (Externals/imgui/imgui/imgui_draw.cpp).
+extern bool (*GImFontRtlReorder)(const char* begin, const char* end, char* out);
+
+namespace PS4Lang
+{
+namespace
+{
+// Wii system languages: 0 Japanese, 1 English, 2 German, 3 French, 4 Spanish, 5 Italian,
+// 6 Dutch, 7 Simplified Chinese, 8 Traditional Chinese, 9 Korean. GameCube: 0 English, 1 German,
+// 2 French, 3 Spanish, 4 Italian, 5 Dutch. Languages neither console has: English.
+const std::vector<Language> LANGUAGES = {
+    {"en", "English", 0, 1},       {"es", "Español", 3, 4},   {"fr", "Français", 2, 3},
+    {"de", "Deutsch", 1, 2},       {"it", "Italiano", 4, 5},  {"pt", "Português", 0, 1},
+    {"nl", "Nederlands", 5, 6},    {"pl", "Polski", 0, 1},    {"tr", "Türkçe", 0, 1},
+    {"ru", "Русский", 0, 1},       {"ja", "日本語", 0, 0},     {"zh", "中文 (简体)", 0, 7},
+    {"ko", "한국어", 0, 9},
+    // Arabic: neither console has it. The name in its joined letter shapes (make-lang.py).
+    {"ar", "\xef\xba\x8d\xef\xbb\x9f\xef\xbb\x8c\xef\xba\xae\xef\xba\x91\xef\xbb\xb4\xef\xba\x94", 0, 1},
+};
+
+struct Pattern
+{
+  std::vector<std::string> pieces;  // the English text around each {}
+  std::string translation;
+  size_t literal = 0;  // longer patterns are tried first
+};
+
+std::mutex s_mutex;
+const Language* s_current = &LANGUAGES[0];
+std::unordered_map<std::string, std::string> s_exact;
+std::vector<Pattern> s_patterns;
+std::unordered_map<std::string, std::string> s_cache;  // texts a pattern translated
+std::unordered_set<std::string> s_untranslated;        // texts without a translation
+
+std::string Unescape(std::string text)
+{
+  for (size_t at = 0; (at = text.find("\\n", at)) != std::string::npos;)
+    text.replace(at, 2, "\n");
+  return text;
+}
+
+std::vector<std::string> Split(const std::string& english)
+{
+  std::vector<std::string> pieces;
+  size_t start = 0;
+  for (size_t at; (at = english.find("{}", start)) != std::string::npos; start = at + 2)
+    pieces.push_back(english.substr(start, at - start));
+  pieces.push_back(english.substr(start));
+  return pieces;
+}
+
+// The pattern's {} parts in text, or false.
+bool Match(const Pattern& pattern, const std::string& text, std::vector<std::string>* parts)
+{
+  const auto& pieces = pattern.pieces;
+  const std::string& first = pieces.front();
+  const std::string& last = pieces.back();
+  if (text.size() < first.size() + last.size() + (pieces.size() - 1) ||
+      text.compare(0, first.size(), first) != 0 ||
+      text.compare(text.size() - last.size(), last.size(), last) != 0)
+  {
+    return false;
+  }
+  parts->clear();
+  size_t at = first.size();
+  const size_t end = text.size() - last.size();
+  for (size_t i = 1; i + 1 < pieces.size(); i++)
+  {
+    // Each part is at least one character; the piece after it is searched from there.
+    const size_t found = text.find(pieces[i], at + 1);
+    if (found == std::string::npos || found + pieces[i].size() > end)
+      return false;
+    parts->push_back(text.substr(at, found - at));
+    at = found + pieces[i].size();
+  }
+  if (at >= end)
+    return false;
+  parts->push_back(text.substr(at, end - at));
+  return true;
+}
+
+std::string Fill(const std::string& translation, const std::vector<std::string>& parts)
+{
+  std::string out;
+  size_t next = 0;
+  for (size_t i = 0; i < translation.size(); i++)
+  {
+    if (translation[i] == '{' && i + 1 < translation.size())
+    {
+      if (translation[i + 1] == '}')
+      {
+        if (next < parts.size())
+          out += parts[next];
+        next++;
+        i++;
+        continue;
+      }
+      if (translation[i + 1] >= '1' && translation[i + 1] <= '9' && i + 2 < translation.size() &&
+          translation[i + 2] == '}')
+      {
+        const size_t index = static_cast<size_t>(translation[i + 1] - '1');
+        if (index < parts.size())
+          out += parts[index];
+        i += 2;
+        continue;
+      }
+    }
+    out += translation[i];
+  }
+  return out;
+}
+}  // namespace
+
+const std::vector<Language>& All()
+{
+  return LANGUAGES;
+}
+
+const Language& Current()
+{
+  return *s_current;
+}
+
+void Load(const std::string& assets_dir, const std::string& code)
+{
+  std::lock_guard lock(s_mutex);
+  s_current = &LANGUAGES[0];
+  for (const Language& language : LANGUAGES)
+  {
+    if (code == language.code)
+      s_current = &language;
+  }
+  s_exact.clear();
+  s_patterns.clear();
+  s_cache.clear();
+  s_untranslated.clear();
+  if (std::string(s_current->code) == "en")
+    return;
+  const std::string path = assets_dir + "/xmb/lang/" + s_current->code + ".ini";
+  std::ifstream file(path);
+  std::string line;
+  while (std::getline(file, line))
+  {
+    while (!line.empty() && (line.back() == '\r' || line.back() == ' '))
+      line.pop_back();
+    if (line.empty() || line[0] == '#')
+      continue;
+    const size_t eq = line.find(" = ");
+    if (eq == std::string::npos)
+      continue;
+    const std::string english = Unescape(line.substr(0, eq));
+    const std::string translation = Unescape(line.substr(eq + 3));
+    if (english.find("{}") == std::string::npos)
+    {
+      s_exact[english] = translation;
+      continue;
+    }
+    Pattern pattern;
+    pattern.pieces = Split(english);
+    pattern.translation = translation;
+    for (const std::string& piece : pattern.pieces)
+      pattern.literal += piece.size();
+    s_patterns.push_back(std::move(pattern));
+  }
+  std::stable_sort(s_patterns.begin(), s_patterns.end(),
+                   [](const Pattern& a, const Pattern& b) { return a.literal > b.literal; });
+  char text[160];
+  snprintf(text, sizeof(text), "language: %s (%zu texts, %zu patterns from %s)", s_current->code,
+           s_exact.size(), s_patterns.size(), path.c_str());
+  ps4_boot_trace(text);
+}
+
+const std::string& T(const std::string& english)
+{
+  std::lock_guard lock(s_mutex);
+  if (s_exact.empty() && s_patterns.empty())
+    return english;
+  if (const auto it = s_exact.find(english); it != s_exact.end())
+    return it->second;
+  if (const auto it = s_cache.find(english); it != s_cache.end())
+    return it->second;
+  if (s_untranslated.count(english))
+    return english;
+  // Lines joined from pieces ("GameCube  -  Played today  -  2 discs", text over several lines):
+  // each piece on its own.
+  for (const char* separator : {"\n", "  -  "})
+  {
+    if (english.find(separator) == std::string::npos)
+      continue;
+    std::string joined;
+    bool changed = false;
+    size_t start = 0;
+    const size_t length = std::char_traits<char>::length(separator);
+    while (true)
+    {
+      const size_t at = english.find(separator, start);
+      const std::string piece = english.substr(start, at == std::string::npos ? at : at - start);
+      s_mutex.unlock();
+      const std::string translated = T(piece);
+      s_mutex.lock();
+      changed = changed || translated != piece;
+      joined += translated;
+      if (at == std::string::npos)
+        break;
+      joined += separator;
+      start = at + length;
+    }
+    if (changed)
+      return s_cache.emplace(english, joined).first->second;
+    break;
+  }
+  std::vector<std::string> parts;
+  for (const Pattern& pattern : s_patterns)
+  {
+    if (Match(pattern, english, &parts))
+    {
+      // The parts may be translatable themselves ("Settings: On").
+      for (std::string& part : parts)
+      {
+        if (const auto it = s_exact.find(part); it != s_exact.end())
+          part = it->second;
+      }
+      return s_cache.emplace(english, Fill(pattern.translation, parts)).first->second;
+    }
+  }
+  // Texts that change all the time (progress, clocks) would fill this up: start over now and then.
+  if (s_untranslated.size() > 20000)
+    s_untranslated.clear();
+  s_untranslated.insert(english);
+  return english;
+}
+
+const char* T(const char* english)
+{
+  if (!english)
+    return english;
+  {
+    std::lock_guard lock(s_mutex);
+    if (s_exact.empty() && s_patterns.empty())
+      return english;
+  }
+  const std::string text(english);
+  const std::string& translated = T(text);
+  // An untranslated text comes back as the temporary above: return the caller's pointer.
+  return &translated == &text ? english : translated.c_str();
+}
+
+// Right-to-left drawing (Arabic), for every ImGui text (imgui_draw.cpp, ImFont::RenderText): a
+// line is drawn right to left - runs of Arabic reversed, runs of left-to-right text (Latin words,
+// numbers, paths: neutral characters between two left-to-right ones join them) kept in order,
+// and the runs themselves in reverse order. Brackets inside Arabic runs are mirrored.
+namespace
+{
+bool IsRightToLeft(char32_t c)
+{
+  return (c >= 0x0600 && c <= 0x06FF) || (c >= 0xFB50 && c <= 0xFDFF) || (c >= 0xFE70 && c <= 0xFEFF);
+}
+
+bool IsLeftToRight(char32_t c)
+{
+  return (c >= '0' && c <= '9') || (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
+         (c >= 0xC0 && c < 0x0600) || (c >= 0x0700 && c < 0xFB50 && !(c >= 0x2000 && c <= 0x206F)) ||
+         c >= 0x10000;
+}
+
+char32_t Mirror(char32_t c)
+{
+  switch (c)
+  {
+  case '(': return ')';
+  case ')': return '(';
+  case '[': return ']';
+  case ']': return '[';
+  case '<': return '>';
+  case '>': return '<';
+  case 0xAB: return 0xBB;
+  case 0xBB: return 0xAB;
+  default: return c;
+  }
+}
+
+struct Char
+{
+  char32_t c;
+  const char* at;
+  int bytes;
+};
+
+bool ReorderRightToLeft(const char* begin, const char* end, char* out)
+{
+  std::vector<Char> chars;
+  bool any = false;
+  for (const char* p = begin; p < end;)
+  {
+    const unsigned char b = static_cast<unsigned char>(*p);
+    const int n = b < 0x80 ? 1 : b < 0xE0 ? 2 : b < 0xF0 ? 3 : 4;
+    if (p + n > end)
+      return false;
+    char32_t c = n == 1 ? b : n == 2 ? (b & 0x1F) : n == 3 ? (b & 0x0F) : (b & 0x07);
+    for (int i = 1; i < n; i++)
+      c = (c << 6) | (static_cast<unsigned char>(p[i]) & 0x3F);
+    any |= IsRightToLeft(c);
+    chars.push_back({c, p, n});
+    p += n;
+  }
+  if (!any)
+    return false;
+  // Each character's direction: neutrals take left-to-right only between two left-to-right ones.
+  const size_t count = chars.size();
+  std::vector<bool> ltr(count);
+  for (size_t i = 0; i < count; i++)
+    ltr[i] = IsLeftToRight(chars[i].c);
+  for (size_t i = 0; i < count; i++)
+  {
+    if (ltr[i] || IsRightToLeft(chars[i].c))
+      continue;
+    size_t a = i, b = i;
+    while (a > 0 && !ltr[a - 1] && !IsRightToLeft(chars[a - 1].c))
+      a--;
+    while (b + 1 < count && !ltr[b + 1] && !IsRightToLeft(chars[b + 1].c))
+      b++;
+    const bool between = a > 0 && b + 1 < count && ltr[a - 1] && ltr[b + 1];
+    for (size_t k = a; k <= b; k++)
+      ltr[k] = between;
+    i = b;
+  }
+  // Runs, last first; right-to-left runs reversed (and mirrored).
+  char* w = out;
+  size_t run_end = count;
+  while (run_end > 0)
+  {
+    size_t run_begin = run_end - 1;
+    while (run_begin > 0 && ltr[run_begin - 1] == ltr[run_end - 1])
+      run_begin--;
+    if (ltr[run_end - 1])
+    {
+      for (size_t k = run_begin; k < run_end; k++)
+      {
+        std::memcpy(w, chars[k].at, chars[k].bytes);
+        w += chars[k].bytes;
+      }
+    }
+    else
+    {
+      for (size_t k = run_end; k-- > run_begin;)
+      {
+        const char32_t m = Mirror(chars[k].c);
+        if (m != chars[k].c)
+          *w = static_cast<char>(m);  // the mirrored brackets are all one byte or Latin-1 pairs
+        if (m != chars[k].c && chars[k].bytes == 1)
+        {
+          w += 1;
+          continue;
+        }
+        if (m != chars[k].c && chars[k].bytes == 2)
+        {
+          w[0] = static_cast<char>(0xC0 | (m >> 6));
+          w[1] = static_cast<char>(0x80 | (m & 0x3F));
+          w += 2;
+          continue;
+        }
+        std::memcpy(w, chars[k].at, chars[k].bytes);
+        w += chars[k].bytes;
+      }
+    }
+    run_end = run_begin;
+  }
+  return true;
+}
+}  // namespace
+
+std::vector<std::string> ExtraFonts(const std::string& assets_dir, bool bold)
+{
+  // Japanese, Chinese and Korean draw the same Han characters differently: the current
+  // language's font first, so its shapes win; the others for the language names in Settings.
+  std::vector<std::string> order = {"ja", "zh", "ko"};
+  const std::string current = s_current->code;
+  if (const auto it = std::find(order.begin(), order.end(), current); it != order.end())
+    std::rotate(order.begin(), it, it + 1);
+  std::vector<std::string> fonts;
+  for (const std::string& code : order)
+  {
+    const char* name = code == "ja" ? "NotoSansJP" : code == "zh" ? "NotoSansSC" : "NotoSansKR";
+    const std::string path =
+        assets_dir + "/xmb/fonts/" + name + (bold ? "-Bold" : "-Regular") + ".ttf";
+    if (std::ifstream(path).good())
+      fonts.push_back(path);
+  }
+  // Arabic (DejaVu Sans, its joined letter shapes), for the language and its name in Settings.
+  const std::string arabic =
+      assets_dir + "/xmb/fonts/DejaVuSansArabic-" + (bold ? "Bold" : "Regular") + ".ttf";
+  if (std::ifstream(arabic).good())
+    fonts.push_back(arabic);
+  // Every text drawn from now on can hold Arabic: lines are drawn right to left where they do.
+  GImFontRtlReorder = &ReorderRightToLeft;
+  return fonts;
+}
+}  // namespace PS4Lang
diff --git a/Source/Core/DolphinNoGUI/PS4Lang.h b/Source/Core/DolphinNoGUI/PS4Lang.h
new file mode 100644
index 0000000..627595f
--- /dev/null
+++ b/Source/Core/DolphinNoGUI/PS4Lang.h
@@ -0,0 +1,40 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// Languages for the PS4 menus (Library/XMB, the in-game menu, settings): Settings -> Language.
+//
+// The menus are written in English and translated where they draw text: T() looks the text up in
+// <assets>/xmb/lang/<code>.ini ("English = translation" lines, UTF-8). "{}" in an English line
+// stands for any text (a number, a name), repeated in the translation as {} in order or as
+// {1}..{9}; "\n" is a line break. Text without a translation (game titles, file names) is drawn
+// as it is. The language also sets the GameCube / Wii system language where they have it.
+
+#pragma once
+
+#include <string>
+#include <vector>
+
+namespace PS4Lang
+{
+struct Language
+{
+  const char* code;  // "en", "ja", ...; the file xmb/lang/<code>.ini
+  const char* name;  // in its own language
+  int gc_language;   // GameCube system language (SRAM): English 0, German 1, French 2, ...
+  int wii_language;  // Wii system language (SYSCONF IPL.LNG): Japanese 0, English 1, ...
+};
+
+const std::vector<Language>& All();
+const Language& Current();
+
+// Loads the language (settings.ini "language"); English needs no file. Call before drawing.
+void Load(const std::string& assets_dir, const std::string& code);
+
+// The text in the current language (cached). The result stays valid until the next Load.
+const std::string& T(const std::string& english);
+const char* T(const char* english);
+
+// Font files with the glyphs the menus need beyond Nunito's (Japanese, Chinese, Korean - only
+// the characters the translations use), the current language's first. regular or bold.
+std::vector<std::string> ExtraFonts(const std::string& assets_dir, bool bold);
+}  // namespace PS4Lang
diff --git a/Source/Core/DolphinNoGUI/PS4MemoryCards.cpp b/Source/Core/DolphinNoGUI/PS4MemoryCards.cpp
new file mode 100644
index 0000000..4c4d3fd
--- /dev/null
+++ b/Source/Core/DolphinNoGUI/PS4MemoryCards.cpp
@@ -0,0 +1,217 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "DolphinNoGUI/PS4MemoryCards.h"
+
+#include <algorithm>
+#include <filesystem>
+#include <fstream>
+#include <variant>
+
+#include "Common/Config/Config.h"
+#include "Core/Config/MainSettings.h"
+#include "Core/HW/EXI/EXI_Device.h"
+#include "Core/HW/GCMemcard/GCMemcard.h"
+#include "Core/HW/GCMemcard/GCMemcardUtils.h"
+#include "Core/HW/Sram.h"
+
+namespace PS4MemoryCards
+{
+namespace
+{
+constexpr const char* FIRST_CARD = "Memory Card 1";  // Dolphin's own, User/GC/<region>/Card A
+constexpr const char* REGIONS[] = {"USA", "EUR", "JAP"};
+// GameCube save times count from 2000-01-01.
+constexpr int64_t GC_EPOCH = 946684800;
+
+std::string CardsDir(const std::string& data_dir)
+{
+  return data_dir + "/User/GC/Cards";
+}
+
+std::string Clean(const std::string& text)
+{
+  std::string out = text;
+  while (!out.empty() && (out.back() == ' ' || out.back() == '\0'))
+    out.pop_back();
+  out.erase(std::find(out.begin(), out.end(), '\0'), out.end());
+  return out;
+}
+
+Save ReadSave(const std::string& path, const std::string& region, bool icons)
+{
+  Save save;
+  save.path = path;
+  save.region = region;
+  save.title = std::filesystem::path(path).stem().string();
+  const auto read = Memcard::ReadSavefile(path);
+  if (!std::holds_alternative<Memcard::Savefile>(read))
+  {
+    save.description = "Unreadable save file";
+    return save;
+  }
+  const Memcard::Savefile& file = std::get<Memcard::Savefile>(read);
+  const Memcard::DEntry& entry = file.dir_entry;
+  save.game_id = std::string(entry.m_gamecode.begin(), entry.m_gamecode.end()) +
+                 std::string(entry.m_makercode.begin(), entry.m_makercode.end());
+  save.blocks = entry.m_block_count;
+  save.modified = static_cast<int64_t>(static_cast<u32>(entry.m_modification_time)) + GC_EPOCH;
+  const std::string file_name =
+      Clean(std::string(entry.m_filename.begin(), entry.m_filename.end()));
+  if (!file_name.empty())
+    save.title = file_name;
+
+  // The comments and the icon: Dolphin decodes them from a card, so the save goes on an empty
+  // one in memory, just big enough.
+  u16 mbits = 4;
+  while (mbits < 128 && mbits * Memcard::MBIT_TO_BLOCKS < file.blocks.size() + 5)
+    mbits *= 2;
+  std::optional<Memcard::GCMemcard> card = Memcard::GCMemcard::Create(
+      "", CardFlashId{}, mbits, region == "JAP", 0, 0, 0);
+  if (!card || card->ImportFile(file) != Memcard::GCMemcardImportFileRetVal::SUCCESS)
+    return save;
+  const u8 index = card->GetFileIndex(0);
+  if (const auto comments = card->GetSaveComments(index))
+  {
+    if (!Clean(comments->first).empty())
+      save.title = Clean(comments->first);
+    save.description = Clean(comments->second);
+  }
+  if (icons)
+  {
+    const auto frames = card->ReadAnimRGBA8(index);
+    if (frames && !frames->empty() &&
+        (*frames)[0].image_data.size() == Memcard::MEMORY_CARD_ICON_WIDTH *
+                                              Memcard::MEMORY_CARD_ICON_HEIGHT)
+    {
+      const std::vector<u32>& argb = (*frames)[0].image_data;
+      save.icon.resize(argb.size() * 4);
+      for (size_t i = 0; i < argb.size(); i++)
+      {
+        save.icon[i * 4] = (argb[i] >> 16) & 0xFF;
+        save.icon[i * 4 + 1] = (argb[i] >> 8) & 0xFF;
+        save.icon[i * 4 + 2] = argb[i] & 0xFF;
+        save.icon[i * 4 + 3] = argb[i] >> 24;
+      }
+    }
+  }
+  return save;
+}
+
+void ReadFolder(Card& card, const std::string& folder, const std::string& region, bool icons)
+{
+  std::error_code ec;
+  std::vector<std::string> files;
+  for (const auto& entry : std::filesystem::directory_iterator(folder, ec))
+  {
+    std::string name = entry.path().filename().string();
+    std::string lower = name;
+    std::transform(lower.begin(), lower.end(), lower.begin(), ::tolower);
+    // Dolphin renames saves the game deleted to *.gci.deleted: those are gone.
+    if (lower.size() > 4 && lower.compare(lower.size() - 4, 4, ".gci") == 0)
+      files.push_back(entry.path().string());
+  }
+  for (const std::string& file : files)
+  {
+    Save save = ReadSave(file, region, icons);
+    card.blocks += save.blocks;
+    card.saves.push_back(std::move(save));
+  }
+}
+}  // namespace
+
+std::vector<Card> List(const std::string& data_dir, bool icons)
+{
+  std::vector<Card> cards;
+  Card first;
+  first.name = FIRST_CARD;
+  for (const char* region : REGIONS)
+    ReadFolder(first, data_dir + "/User/GC/" + region + "/Card A", region, icons);
+  cards.push_back(std::move(first));
+
+  std::error_code ec;
+  std::vector<std::string> names;
+  for (const auto& entry : std::filesystem::directory_iterator(CardsDir(data_dir), ec))
+  {
+    std::error_code type_error;
+    if (entry.is_directory(type_error))
+      names.push_back(entry.path().filename().string());
+  }
+  // "Memory Card 2" before "Memory Card 10".
+  std::sort(names.begin(), names.end(), [](const std::string& a, const std::string& b) {
+    return a.size() != b.size() ? a.size() < b.size() : a < b;
+  });
+  for (const std::string& name : names)
+  {
+    Card card;
+    card.name = name;
+    card.folder = CardsDir(data_dir) + "/" + name + "/USA";
+    for (const char* region : REGIONS)
+      ReadFolder(card, CardsDir(data_dir) + "/" + name + "/" + region, region, icons);
+    cards.push_back(std::move(card));
+  }
+  for (Card& card : cards)
+  {
+    std::sort(card.saves.begin(), card.saves.end(),
+              [](const Save& a, const Save& b) { return a.modified > b.modified; });
+  }
+  return cards;
+}
+
+std::string Create(const std::string& data_dir, std::string* error)
+{
+  std::error_code ec;
+  for (int n = 2; n < 100; n++)
+  {
+    const std::string name = "Memory Card " + std::to_string(n);
+    const std::string dir = CardsDir(data_dir) + "/" + name;
+    if (std::filesystem::exists(dir, ec))
+      continue;
+    for (const char* region : REGIONS)
+      std::filesystem::create_directories(dir + "/" + region, ec);
+    if (ec)
+    {
+      *error = "Couldn't create " + dir + ": " + ec.message();
+      return {};
+    }
+    return name;
+  }
+  *error = "There are too many memory cards.";
+  return {};
+}
+
+std::string SlotA(const std::string& data_dir)
+{
+  std::ifstream file(data_dir + "/memcards.ini");
+  std::string line;
+  while (std::getline(file, line))
+  {
+    while (!line.empty() && (line.back() == '\r' || line.back() == ' '))
+      line.pop_back();
+    if (line.rfind("slot_a=", 0) == 0 && line.size() > 7)
+    {
+      const std::string name = line.substr(7);
+      std::error_code ec;
+      if (name == FIRST_CARD || std::filesystem::is_directory(CardsDir(data_dir) + "/" + name, ec))
+        return name;
+    }
+  }
+  return FIRST_CARD;
+}
+
+void SetSlotA(const std::string& data_dir, const std::string& name)
+{
+  std::ofstream file(data_dir + "/memcards.ini", std::ios::trunc);
+  file << "# Dolphin memory cards (edited by the menu)\nslot_a=" << name << "\n";
+}
+
+void ApplySlotA(const std::string& data_dir)
+{
+  const std::string name = SlotA(data_dir);
+  // A GCI folder in Slot A (Dolphin's default); a new card's folder ends in a region that Dolphin
+  // replaces with the game's.
+  Config::SetBase(Config::MAIN_SLOT_A, ExpansionInterface::EXIDeviceType::MemoryCardFolder);
+  Config::SetBase(Config::MAIN_GCI_FOLDER_A_PATH,
+                  name == FIRST_CARD ? std::string() : CardsDir(data_dir) + "/" + name + "/USA");
+}
+}  // namespace PS4MemoryCards
diff --git a/Source/Core/DolphinNoGUI/PS4MemoryCards.h b/Source/Core/DolphinNoGUI/PS4MemoryCards.h
new file mode 100644
index 0000000..d80c0ef
--- /dev/null
+++ b/Source/Core/DolphinNoGUI/PS4MemoryCards.h
@@ -0,0 +1,48 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// GameCube memory cards for the PS4 menus (PS4XMB.cpp): the cards there are, the saves on them,
+// new cards, and which card is in Slot A.
+//
+// A card is a GCI folder, Dolphin's default kind of memory card: one .gci file per save, one
+// folder per region. The first card is Dolphin's own (User/GC/<region>/Card A); new cards live in
+// User/GC/Cards/<name>/<region>, and Dolphin picks the region folder for each game.
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace PS4MemoryCards
+{
+struct Save
+{
