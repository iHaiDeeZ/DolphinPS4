+u32 PS4HostVisibleMemoryType(u32 type_bits)
+{
+  VkPhysicalDeviceMemoryProperties props;
+  vkGetPhysicalDeviceMemoryProperties(g_vulkan_context->GetPhysicalDevice(), &props);
+  const VkMemoryPropertyFlags want = VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT |
+                                     VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                                     VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+  for (u32 i = 0; i < props.memoryTypeCount; i++)
+  {
+    if ((type_bits & (1u << i)) && (props.memoryTypes[i].propertyFlags & want) == want)
+      return i;
+  }
+  return UINT32_MAX;
