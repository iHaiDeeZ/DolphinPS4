--- /dev/null
+++ b/Externals/curl/ps4_compat.h
@@ -0,0 +1,9 @@
+// PS4 build of curl (included first in every curl source file; see CMakeLists.txt).
+#pragma once
+#include <sys/types.h>
+#include <sys/socket.h>
+// The PS4 kernel (FreeBSD 9) has no SOCK_NONBLOCK / SOCK_CLOEXEC flags for socket(), and
+// OpenOrbis defines them with Linux values, which socket() rejects: every connection failed at
+// once. Without them curl makes sockets non-blocking with fcntl(O_NONBLOCK).
+#undef SOCK_NONBLOCK
+#undef SOCK_CLOEXEC
