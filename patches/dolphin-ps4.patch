+
+// The PS4 launcher: an XMB-style menu (categories across, items down) shown when the app starts.
+// Picking a game returns it; DolphinNoGUI/PlatformPS4.cpp then restarts the app into Dolphin
+// with that game (sceSystemServiceLoadExec), so the menu and the emulator never share a process.
+
+#pragma once
+
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <vector>
+
+namespace PS4XMB
+{
+// One disc image of the game library (PlatformPS4.cpp reads them from the disc headers).
+struct LibraryDisc
+{
+  std::string path;
+  std::string game_id;
+  uint16_t revision = 0;
+  int disc = 0;  // 0 = Disc 1
+  std::string title;
+  bool wad = false;  // a Wii title package (WiiWare, Virtual Console, channels)
+  bool homebrew = false;  // a .dol / .elf program (no game ID)
+  bool wii = false;       // homebrew: built for the Wii
+};
+
+// Returned by Run when the app should close (to install an update's package).
+inline constexpr const char* EXIT_APP = "\x01exit";
+// Returned by Run when the app should restart (an update is unpacked: it starts at once).
+inline constexpr const char* RESTART_APP = "\x01restart";
+
+// Finds the disc images in a folder (the game process's library scan).
+using ScanFunction = std::function<std::vector<LibraryDisc>(const std::string& games_dir)>;
+
+// The folder games are looked for in: Settings -> Game Folder (xmb.ini games_dir), by default
+// data_dir/games.
+std::string GamesDir(const std::string& data_dir);
+
+// Network shares (Settings -> Network Shares): data_dir/shares.txt, one nfs:// or smb:// address
+// per line. Their games join the library (Common/PS4NetFS.h reads them over the network).
+std::vector<std::string> NetworkShares(const std::string& data_dir);
+void SaveNetworkShares(const std::string& data_dir, const std::vector<std::string>& shares);
+
+// The game that starts by itself when the app is opened (Triangle on a game -> Set as Default
+// ISO; xmb.ini default_game), or empty.
+std::string DefaultGame(const std::string& data_dir);
+
+// Shows the XMB until a game is picked (returns its first disc) or the user quits (empty).
+// data_dir: /data/DolphinPS4 (xmb.ini, themes/); assets_dir: /app0 (xmb/, Sys/).
+std::string Run(const ScanFunction& scan, const std::string& data_dir,
+                const std::string& assets_dir, const std::string& version);
+}  // namespace PS4XMB
