+// The password goes to retroachievements.org once; only the token it answers with is kept.
+void Menu::StartAchievementLogin(const std::string& user, const std::string& password)
+{
+  if (m_ra_thread.joinable())
+    m_ra_thread.join();
+  m_ra_busy = true;
+  m_ra_thread = std::thread([this, user, password] {
+    Common::HttpRequest http{std::chrono::seconds{20}};
+    const std::string body = "r=login2&u=" + UrlEncode(user) + "&p=" + UrlEncode(password);
+    const auto response =
+        http.Post("https://retroachievements.org/dorequest.php", body,
+                  {{"Content-Type", "application/x-www-form-urlencoded"},
+                   {"User-Agent", "Dolphin-PS4/1.0"}},
+                  Common::HttpRequest::AllowedReturnCodes::All);
+    std::string status, token, name;
+    if (!response)
+    {
+      status = "No connection (PS4 date and time?)";
+    }
+    else
+    {
+      picojson::value json;
+      const std::string error = picojson::parse(json, std::string(response->begin(), response->end()));
+      if (!error.empty() || !json.is<picojson::object>())
+      {
+        status = "Unexpected answer from the server";
+      }
+      else
+      {
+        const auto& object = json.get<picojson::object>();
+        const auto success = object.find("Success");
+        if (success != object.end() && success->second.is<bool>() && success->second.get<bool>())
+        {
+          const auto t = object.find("Token");
+          const auto u = object.find("User");
+          token = t != object.end() ? t->second.to_str() : std::string();
+          name = u != object.end() ? u->second.to_str() : user;
+          status = token.empty() ? "No token in the answer" : "Logged in as " + name;
+        }
+        else
+        {
+          const auto e = object.find("Error");
+          status = e != object.end() && e->second.is<std::string>() ? e->second.get<std::string>() :
+                                                                     "Login failed";
+        }
+      }
+    }
+    std::lock_guard lock(m_ra_mutex);
+    m_ra_status = status;
+    m_ra_token_found = token;
+    m_ra_user_found = name;
+    m_ra_busy = false;
+  });
+}
+
+void Menu::UpdateAchievementLogin()
+{
+  if (m_ra_busy || !m_ra_thread.joinable())
+    return;
+  m_ra_thread.join();
+  std::string token, name, status;
+  {
+    std::lock_guard lock(m_ra_mutex);
+    token = std::move(m_ra_token_found);
+    name = std::move(m_ra_user_found);
+    status = m_ra_status;
+  }
+  Log("retroachievements: " + status);
+  if (!token.empty())
+  {
+    RaSet("Username", name);
+    RaSet("ApiToken", token);
+    RaSet("Enabled", "True");
+  }
+  if (m_panel.open && m_panel.setting == SET_ACHIEVEMENTS)
+    BuildAchievementRows();
+  BuildItems();  // the account beside the clock and in the Achievements category
+}
