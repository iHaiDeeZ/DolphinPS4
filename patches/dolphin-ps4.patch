+void Menu::BuildGames(const std::vector<LibraryDisc>& library)
+{
+  // Titles: GameTDB's list shipped in Sys (full names instead of the discs' internal ones).
+  std::map<std::string, std::string> titles;
+  {
+    std::ifstream file(m_assets_dir + "/Sys/wiitdb-en.txt");
+    std::string line;
+    while (std::getline(file, line))
+    {
+      const size_t eq = line.find(" = ");
+      if (eq != std::string::npos && eq <= 6)
+      {
+        std::string title = line.substr(eq + 3);
+        while (!title.empty() && (title.back() == '\r' || title.back() == ' '))
+          title.pop_back();
+        titles[line.substr(0, eq)] = title;
+      }
+    }
+  }
+  // One entry per game: discs with the same ID and revision belong together (disc 1 starts).
+  std::map<std::string, size_t> by_id;
+  for (const LibraryDisc& disc : library)
+  {
+    const std::string key =
+        disc.game_id.empty() ? disc.path : disc.game_id + "/" + std::to_string(disc.revision);
+    auto existing = by_id.find(key);
+    if (existing != by_id.end())
+    {
+      Game& game = m_games[existing->second];
+      game.discs++;
+      if (disc.disc == 0)
+        game.path = disc.path;
+      continue;
+    }
+    Game game;
+    game.path = disc.path;
+    game.id = disc.game_id;
+    game.revision = disc.revision;
+    game.wad = disc.wad;
+    game.homebrew = disc.homebrew;
+    game.wii = disc.wad || disc.wii;
+    game.title = disc.title.empty() ? std::filesystem::path(disc.path).stem().string() : disc.title;
+    for (const std::string& id : {disc.game_id, disc.game_id.substr(0, 4)})
+    {
+      auto title = titles.find(id);
+      if (!id.empty() && title != titles.end())
+      {
+        game.title = title->second;
+        break;
+      }
+    }
+    by_id[key] = m_games.size();
+    m_games.push_back(std::move(game));
+  }
+  std::sort(m_games.begin(), m_games.end(),
+            [](const Game& a, const Game& b) { return a.title < b.title; });
+}
+
+void Menu::LoadAssets()
+{
+  ImGuiIO& io = ImGui::GetIO();
+  const std::string fonts = m_assets_dir + "/xmb/fonts/";
+  // Nunito (Latin, Cyrillic), then the Japanese / Chinese / Korean glyphs merged in (PS4Lang).
+  auto add_font = [&](const char* file, bool bold) {
+    ImFont* font = io.Fonts->AddFontFromFileTTF((fonts + file).c_str(), 32.0f);
+    if (!font)
+      return font;
+    for (const std::string& extra : PS4Lang::ExtraFonts(m_assets_dir, bold))
+    {
+      ImFontConfig config;
+      config.MergeMode = true;
+      io.Fonts->AddFontFromFileTTF(extra.c_str(), 32.0f, &config);
+    }
+    return font;
+  };
+  m_font = add_font("Nunito-Regular.ttf", false);
+  m_bold = add_font("Nunito-ExtraBold.ttf", true);
+  if (!m_font)
+    m_font = io.Fonts->AddFontDefault();
+  if (!m_bold)
+    m_bold = m_font;
+
+  for (const char* name :
+       {"move", "category", "confirm", "back", "launch", "error", "menu", "intro"})
+  {
+    // A sound in data_dir/themes/sounds replaces the built-in one.
+    std::unique_ptr<Sound> sound = LoadWav(m_data_dir + "/themes/sounds/" + name + ".wav");
+    if (!sound)
+      sound = LoadWav(m_assets_dir + "/xmb/sounds/" + name + ".wav");
+    if (sound)
+      m_sounds[name] = std::move(sound);
+    else
+      Log(std::string("sound not loaded: ") + name);
+  }
+  Log("sounds loaded: " + std::to_string(m_sounds.size()));
+
+  const std::string resources = m_assets_dir + "/Sys/Resources/";
+  m_icon_gc = LoadPngTexture(resources + "Platform_Gamecube@4x.png");
+  m_icon_wii = LoadPngTexture(resources + "Platform_Wii@4x.png");
+  m_logo = LoadPngTexture(resources + "dolphin_logo@2x.png");
+  m_intro_dolphin =
+      LoadPngTexture(m_assets_dir + "/xmb/intro-dolphin.png", &m_intro_dolphin_aspect);
+  m_intro_title = LoadPngTexture(m_assets_dir + "/xmb/intro-title.png", &m_intro_title_aspect);
+  {
+    constexpr int SIZE = 64;
+    std::vector<u8> pixels(SIZE * SIZE * 4);
+    for (int y = 0; y < SIZE; y++)
+    {
+      for (int x = 0; x < SIZE; x++)
+      {
+        const float dx = (x + 0.5f) / SIZE * 2.0f - 1.0f, dy = (y + 0.5f) / SIZE * 2.0f - 1.0f;
+        u8* px = &pixels[(y * SIZE + x) * 4];
+        px[0] = px[1] = px[2] = 255;
+        px[3] = static_cast<u8>(std::exp(-(dx * dx + dy * dy) * 4.0f) * 255.0f);
+      }
+    }
+    m_glow = m_display.CreateTexture(pixels.data(), SIZE, SIZE);
+  }
+  LoadCovers();
+  LoadBanners();
+
+  std::error_code error;
+  for (const auto& entry :
+       std::filesystem::directory_iterator(m_data_dir + "/themes", error))
+  {
+    std::string name = entry.path().filename().string();
+    std::string lower = name;
+    std::transform(lower.begin(), lower.end(), lower.begin(), ::tolower);
+    if (lower.size() > 4 && lower.compare(lower.size() - 4, 4, ".png") == 0)
+      m_wallpapers.push_back(name);
+  }
+  std::sort(m_wallpapers.begin(), m_wallpapers.end());
+}
+
+// Banners from the discs (GameCube; Wii discs carry none Dolphin can read without a NAND).
+void Menu::LoadBanners()
+{
+  for (Game& game : m_games)
+  {
+    if (game.homebrew)
+      continue;  // no banner in a program file
+    // GameCube discs and Wii title packages carry a banner; Wii discs only in a NAND.
+    std::unique_ptr<DiscIO::Volume> volume =
+        game.wad ? std::unique_ptr<DiscIO::Volume>(DiscIO::CreateWAD(game.path)) :
+                   std::unique_ptr<DiscIO::Volume>(DiscIO::CreateDisc(game.path));
+    if (!volume)
+      continue;
+    if (!game.wad)
+      game.wii = volume->GetVolumeType() == DiscIO::Platform::WiiDisc;
+    if (game.wii && !game.wad)
+      continue;
+    u32 width = 0, height = 0;
+    const std::vector<u32> banner = volume->GetBanner(&width, &height);
+    if (banner.empty() || width == 0 || height == 0)
+      continue;
+    std::vector<u8> rgba(banner.size() * 4);
+    for (size_t i = 0; i < banner.size(); i++)
+    {
+      const u32 argb = banner[i];
+      rgba[i * 4] = (argb >> 16) & 0xFF;
+      rgba[i * 4 + 1] = (argb >> 8) & 0xFF;
+      rgba[i * 4 + 2] = argb & 0xFF;
+      rgba[i * 4 + 3] = argb >> 24;
+    }
+    game.banner = m_display.CreateTexture(rgba.data(), width, height);
+    game.banner_aspect = static_cast<float>(width) / static_cast<float>(height);
+  }
+}
