+void Toast(const std::string& text, int ms = 2200)
+{
+  std::lock_guard lock(s_mutex);
+  s_toast = text;
+  s_toast_until = Clock::now() + std::chrono::milliseconds(ms);
+}
+
+// Host thread, s_mutex not held (Core calls wait for the video thread, which takes s_mutex).
+void Close(Core::System& system)
+{
+  {
+    std::lock_guard lock(s_mutex);
+    s_open = false;
+  }
+  s_watch = false;
+  ps4_pad_block = 1;  // the game sees a neutral pad until the buttons are released
+  Core::SetState(system, Core::State::Running);
+  Log("closed");
+}
+
+void Open(Core::System& system)
+{
+  s_game_id = SConfig::GetInstance().GetGameID();
+  std::string title = SConfig::GetInstance().GetTitleName();
+  if (title.empty())
+    title = s_game_id;
+  s_page = Page::Main;
+  s_main_selected = 0;
+  s_wii = system.IsWii();
+  s_main_items = {MAIN_RESUME, MAIN_SAVE, MAIN_LOAD};
+  if (s_wii)
+  {
+    s_main_items.push_back(MAIN_WII_EXTENSION);
+    s_main_items.push_back(MAIN_WII_SIDEWAYS);
+    s_main_items.push_back(MAIN_WII_TILT);
+  }
+  s_main_items.insert(s_main_items.end(), {MAIN_CONTROLS, MAIN_SETTINGS, MAIN_CHEATS});
+  s_ach = {};
+  s_ach_loaded = CaptureAchievements(&s_ach);
+  if (s_ach_loaded)
+    SaveAchievements();
+#ifdef USE_RETRO_ACHIEVEMENTS
+  s_main_items.push_back(MAIN_ACHIEVEMENTS);
+#else
+  if (s_ach_loaded)
+    s_main_items.push_back(MAIN_ACHIEVEMENTS);
+#endif
+  s_main_items.insert(s_main_items.end(), {MAIN_RESTART, MAIN_QUIT});
+  BuildRows();
+  FlushPlayTime();
+  const std::string played = PS4PlayTime::Text(PS4PlayTime::Seconds(PlayKey()));
+  {
+    std::lock_guard lock(s_mutex);
+    s_playtime = played.empty() ? std::string() : "Play time: " + played;
+    s_title = std::move(title);
+    s_open = true;
+  }
+  ps4_pad_block = 1;
+  Core::SetState(system, Core::State::Paused);
+  s_watch = true;
+  Log("opened");
+}
