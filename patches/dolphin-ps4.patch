+// Game Folder: a folder browser. "" shows the places games can be (the console's storage and
+// USB drives); a folder shows "Use This Folder" (with how many games it holds), ".." and its
+// subfolders.
+void Menu::OpenFolderBrowser(const std::string& path)
+{
+  auto is_game = [](const std::string& name) {
+    std::string lower = name;
+    std::transform(lower.begin(), lower.end(), lower.begin(), ::tolower);
+    for (const char* extension :
+         {".iso", ".gcm", ".ciso", ".gcz", ".wbfs", ".wia", ".rvz", ".nkit.iso"})
+    {
+      const size_t length = std::strlen(extension);
+      if (lower.size() > length && lower.compare(lower.size() - length, length, extension) == 0)
+        return true;
+    }
+    return false;
+  };
+  const bool reopen = m_panel.open && m_panel.setting == SET_GAMES_DIR;
+  m_panel = {};
+  m_panel.open = true;
+  m_panel.setting = SET_GAMES_DIR;
+  m_panel.title = "Game Folder";
+  m_browse_dir = path;
+  std::vector<SettingRow> rows;
+  std::error_code ec;
+  if (path.empty())
+  {
+    rows.push_back({"Places", "", "", true});
+    std::vector<std::string> places = {"/data", m_data_dir + "/games"};
+    for (int i = 0; i < 8; i++)
+      places.push_back("/mnt/usb" + std::to_string(i));
+    places.push_back("/mnt/ext0");
+    places.push_back("/mnt/ext1");
+    for (const std::string& place : places)
+    {
+      if (std::filesystem::is_directory(place, ec))
+        rows.push_back({place, "", "dir:" + place});
+    }
+  }
+  else
+  {
+    rows.push_back({path, "", "", true});
+    std::vector<std::string> folders;
+    int games = 0;
+    bool readable = false;
+    for (const auto& entry : std::filesystem::directory_iterator(path, ec))
+    {
+      readable = true;
+      const std::string name = entry.path().filename().string();
+      std::error_code type_error;
+      if (entry.is_directory(type_error))
+      {
+        if (name.empty() || name[0] != '.')
+          folders.push_back(name);
+      }
+      else if (is_game(name))
+      {
+        games++;
+      }
+    }
+    std::sort(folders.begin(), folders.end());
+    rows.push_back({"Use This Folder", std::to_string(games) + (games == 1 ? " game" : " games"),
+                    "usedir"});
+    const std::filesystem::path parent = std::filesystem::path(path).parent_path();
+    const bool top = path == "/data" || (path.rfind("/mnt/", 0) == 0 &&
+                                             std::count(path.begin(), path.end(), '/') == 2);
+    rows.push_back({"..", top ? "Places" : "", top ? "dir:" : "dir:" + parent.string()});
+    if (!readable && ec)
+      rows.push_back({"(this folder can't be opened)", "", "", true});
+    for (const std::string& folder : folders)
+    {
+      const std::string full = path == "/" ? "/" + folder : path + "/" + folder;
+      rows.push_back({folder + "/", "", "dir:" + full});
+    }
+  }
+  m_panel.rows = std::move(rows);
+  m_panel.selected = 0;
+  MoveSettingRow(0);
+  if (!reopen)
+    Play("menu");
+}
