+// Banners from the discs (GameCube; Wii discs carry none Dolphin can read without a NAND).
+void Menu::LoadBanners()
+{
+  for (Game& game : m_games)
+  {
+    if (game.homebrew)
+      continue;  // no banner in a program file
+    // A network game's banner is kept in data_dir/cache/banners (width, height, RGBA): the menu
+    // doesn't read every disc over the network when it opens. Wii discs have none.
+    const bool network = Common::NetFS::IsNetPath(game.path);
+    if (network && game.wii && !game.wad)
+      continue;
+    const std::string cached_banner = m_data_dir + "/cache/banners/" + game.id + "-" +
+                                      std::to_string(game.revision) + (game.wad ? "-wad" : "") +
+                                      ".rgba";
+    if (network && !game.id.empty())
+    {
+      std::string data;
+      if (File::ReadFileToString(cached_banner, data) && data.size() > 8)
+      {
+        u32 width, height;
+        std::memcpy(&width, data.data(), 4);
+        std::memcpy(&height, data.data() + 4, 4);
+        if (width > 0 && height > 0 && data.size() == 8 + size_t(width) * height * 4)
+        {
+          game.banner = m_display.CreateTexture(reinterpret_cast<const u8*>(data.data() + 8), width,
+                                                height);
+          game.banner_aspect = static_cast<float>(width) / static_cast<float>(height);
+          continue;
+        }
+      }
+    }
+    // GameCube discs and Wii title packages carry a banner; Wii discs only in a NAND.
+    std::unique_ptr<DiscIO::Volume> volume =
+        game.wad ? std::unique_ptr<DiscIO::Volume>(DiscIO::CreateWAD(game.path)) :
+                   std::unique_ptr<DiscIO::Volume>(DiscIO::CreateDisc(game.path));
+    if (!volume)
+      continue;
+    if (!game.wad)
+      game.wii = volume->GetVolumeType() == DiscIO::Platform::WiiDisc;
+    if (game.wii && !game.wad)
+      continue;
+    u32 width = 0, height = 0;
+    const std::vector<u32> banner = volume->GetBanner(&width, &height);
+    if (banner.empty() || width == 0 || height == 0)
+      continue;
+    std::vector<u8> rgba(banner.size() * 4);
+    for (size_t i = 0; i < banner.size(); i++)
+    {
+      const u32 argb = banner[i];
+      rgba[i * 4] = (argb >> 16) & 0xFF;
+      rgba[i * 4 + 1] = (argb >> 8) & 0xFF;
+      rgba[i * 4 + 2] = argb & 0xFF;
+      rgba[i * 4 + 3] = argb >> 24;
+    }
+    if (network && !game.id.empty())
+    {
+      std::string data(8, '\0');
+      std::memcpy(data.data(), &width, 4);
+      std::memcpy(data.data() + 4, &height, 4);
+      data.append(reinterpret_cast<const char*>(rgba.data()), rgba.size());
+      File::CreateFullPath(cached_banner);
+      File::WriteStringToFile(cached_banner, data);
+    }
+    game.banner = m_display.CreateTexture(rgba.data(), width, height);
+    game.banner_aspect = static_cast<float>(width) / static_cast<float>(height);
+  }
+}
