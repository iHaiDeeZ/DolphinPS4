diff --git a/Source/Core/VideoBackends/Vulkan/PS4CommandRecorder.cpp b/Source/Core/VideoBackends/Vulkan/PS4CommandRecorder.cpp
new file mode 100755
index 0000000..dcfb8ca
--- /dev/null
+++ b/Source/Core/VideoBackends/Vulkan/PS4CommandRecorder.cpp
@@ -0,0 +1,1222 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// PS4: Vulkan command recording thread (ps4.ini vk_thread=on).
+//
+// The video thread emulates the GameCube GPU and records Vulkan commands. On the PS4's Jaguar
+// cores RADV's per-draw work (state emission, descriptors, the draw packets) was ~16% of the video
+// thread in draw-heavy scenes (Crash Bandicoot: ~4000 draws per frame), while three cores sat
+// idle. Here the video thread only queues the calls Dolphin makes (a few dozen bytes each, into a
+// ring buffer); a worker thread on its own core replays them into RADV and submits.
+//
+// Ordering: everything that records into or submits command buffers goes through the queue in
+// program order. Calls that observe the results (fence waits, query results, idle waits), destroy
+// objects queued commands may still reference, or present (the PS4 flip) first wait until the
+// worker has replayed everything queued ("drain"). Calls that only create objects or update
+// descriptor sets run directly: Dolphin never changes a descriptor set after binding it, and
+// resets descriptor pools only after waiting for the command buffers that used them.
+//
+// Only the video thread may record (Dolphin's own submission thread is disabled with this).
+
+#include "VideoBackends/Vulkan/PS4CommandRecorder.h"
+
+#include <pthread.h>
+#include <time.h>
+
+#include <atomic>
+#include <condition_variable>
+#include <cstring>
+#include <mutex>
+#include <thread>
+
+#include "Common/CommonTypes.h"
+#include "Common/Logging/Log.h"
+#include "Common/Thread.h"
+#include "VideoBackends/Vulkan/VulkanLoader.h"
+
+extern "C" {
+int ps4_vk_thread = 0;       // ps4.ini vk_thread=on
+int ps4_vk_thread_core = 5;  // ps4.ini vk_thread_core
+// ps4.ini vk_thread_mode (diagnostics): 0 async (the worker replays in parallel), 1 sync (the
+// worker replays each call while the video thread waits), 2 inline (recorded calls are replayed
+// right away on the video thread - tests the record/replay itself, no second thread).
+int ps4_vk_thread_mode = 0;
+}
+extern "C" void ps4_boot_trace(const char* stage);
+extern "C" void ps4_wait_add(int slot, long long ns);  // port/ps4_sampler.cpp
+
+namespace Vulkan
+{
+namespace
+{
+enum Op : u32
+{
+  OP_PAD,
+  OP_BeginCommandBuffer,
+  OP_EndCommandBuffer,
+  OP_ResetCommandPool,
+  OP_ResetFences,
+  OP_QueueSubmit,
+  OP_CmdBindPipeline,
+  OP_CmdBindDescriptorSets,
+  OP_CmdBindVertexBuffers,
+  OP_CmdBindIndexBuffer,
+  OP_CmdDraw,
+  OP_CmdDrawIndexed,
+  OP_CmdDispatch,
+  OP_CmdSetViewport,
+  OP_CmdSetScissor,
+  OP_CmdBeginRenderPass,
+  OP_CmdEndRenderPass,
+  OP_CmdPipelineBarrier,
+  OP_CmdClearAttachments,
+  OP_CmdUpdateBuffer,
+  OP_CmdResetQueryPool,
+  OP_CmdBeginQuery,
+  OP_CmdEndQuery,
+  OP_CmdCopyBufferToImage,
+  OP_CmdCopyImageToBuffer,
+  OP_CmdCopyImage,
+  OP_CmdCopyBuffer,
+  OP_CmdBlitImage,
+  OP_CmdResolveImage,
+  OP_Call,
+};
+
+// The real (RADV) entry points of the functions replaced here.
+#define PS4_RECORDED(X)                                                                            \
+  X(vkBeginCommandBuffer)                                                                          \
+  X(vkEndCommandBuffer)                                                                            \
+  X(vkResetCommandPool)                                                                            \
+  X(vkResetFences)                                                                                 \
+  X(vkQueueSubmit)                                                                                 \
+  X(vkCmdBindPipeline)                                                                             \
+  X(vkCmdBindDescriptorSets)                                                                       \
+  X(vkCmdBindVertexBuffers)                                                                        \
+  X(vkCmdBindIndexBuffer)                                                                          \
+  X(vkCmdDraw)                                                                                     \
+  X(vkCmdDrawIndexed)                                                                              \
+  X(vkCmdDispatch)                                                                                 \
+  X(vkCmdSetViewport)                                                                              \
+  X(vkCmdSetScissor)                                                                               \
+  X(vkCmdBeginRenderPass)                                                                          \
+  X(vkCmdEndRenderPass)                                                                            \
+  X(vkCmdPipelineBarrier)                                                                          \
+  X(vkCmdClearAttachments)                                                                         \
+  X(vkCmdUpdateBuffer)                                                                             \
+  X(vkCmdResetQueryPool)                                                                           \
+  X(vkCmdBeginQuery)                                                                               \
+  X(vkCmdEndQuery)                                                                                 \
+  X(vkCmdCopyBufferToImage)                                                                        \
+  X(vkCmdCopyImageToBuffer)                                                                        \
+  X(vkCmdCopyImage)                                                                                \
+  X(vkCmdCopyBuffer)                                                                               \
+  X(vkCmdBlitImage)                                                                                \
+  X(vkCmdResolveImage)
+
+#define PS4_DRAINED(X)                                                                             \
+  X(vkWaitForFences)                                                                               \
+  X(vkGetFenceStatus)                                                                              \
+  X(vkQueueWaitIdle)                                                                               \
+  X(vkDeviceWaitIdle)                                                                              \
+  X(vkGetQueryPoolResults)                                                                         \
+  X(vkResetDescriptorPool)                                                                         \
+  X(vkFreeCommandBuffers)                                                                          \
+  X(vkFreeMemory)                                                                                  \
+  X(vkDestroyPipeline)                                                                             \
+  X(vkDestroyImage)                                                                                \
+  X(vkDestroyImageView)                                                                            \
+  X(vkDestroyBuffer)                                                                               \
+  X(vkDestroyBufferView)                                                                           \
+  X(vkDestroyFramebuffer)                                                                          \
+  X(vkDestroyRenderPass)                                                                           \
+  X(vkDestroySampler)                                                                              \
+  X(vkDestroyDescriptorPool)                                                                       \
+  X(vkDestroyPipelineLayout)                                                                       \
+  X(vkDestroyDescriptorSetLayout)                                                                  \
+  X(vkDestroyQueryPool)                                                                            \
+  X(vkDestroySemaphore)                                                                            \
+  X(vkDestroyFence)                                                                                \
+  X(vkDestroyCommandPool)                                                                          \
+  X(vkDestroyDevice)
+
+#define PS4_DECLARE_REAL(name) PFN_##name real_##name = nullptr;
+struct RealFunctions
+{
+  PS4_RECORDED(PS4_DECLARE_REAL)
+  PS4_DRAINED(PS4_DECLARE_REAL)
+};
+#undef PS4_DECLARE_REAL
+RealFunctions s_real;
+
+// ---------------------------------------------------------------------------------------------
+// The queue: a single-producer (video thread), single-consumer (worker) ring of records
+// {u32 size, u32 op, payload}, 16-byte aligned, never wrapping inside a record.
+constexpr size_t RING_SIZE = 16u << 20;
+constexpr size_t RING_MASK = RING_SIZE - 1;
+
+struct Header
+{
+  u32 size;
+  u32 op;
+};
+
+u8* s_ring = nullptr;
+alignas(64) std::atomic<u64> s_write{0};  // published by the producer
+alignas(64) std::atomic<u64> s_read{0};   // published by the consumer
+alignas(64) u64 s_reserve = 0;            // producer-local
+u32 s_pending = 0;                        // size of the record being written
+std::atomic<bool> s_sleeping{false};
+std::atomic<bool> s_stop{false};
+std::mutex s_wake_mutex;
+std::condition_variable s_wake;
+std::thread s_worker;
+bool s_active = false;
+
+void WakeWorker()
+{
+  if (s_sleeping.load(std::memory_order_seq_cst))
+  {
+    std::lock_guard lk(s_wake_mutex);
+    s_wake.notify_one();
+  }
+}
+
+void Pause(u32& spins)
+{
+  if (++spins < 64)
+  {
+    __builtin_ia32_pause();
+  }
+  else if (spins < 256)
+  {
+    std::this_thread::yield();
+  }
+  else
+  {
+    const timespec ts{0, 20000};
+    nanosleep(&ts, nullptr);
+  }
+}
+
+void WaitForSpace(size_t size)
+{
+  u32 spins = 0;
+  while (s_reserve + size - s_read.load(std::memory_order_acquire) > RING_SIZE)
+  {
+    WakeWorker();
+    Pause(spins);
+  }
+}
+
+constexpr size_t Align16(size_t size)
+{
+  return (size + 15) & ~size_t(15);
+}
+
+// Starts a record with `payload` bytes; finish with Commit().
+u8* Begin(Op op, size_t payload)
+{
+  const size_t size = Align16(sizeof(Header) + payload);
+  size_t offset = s_reserve & RING_MASK;
+  if (offset + size > RING_SIZE)
+  {
+    const size_t pad = RING_SIZE - offset;
+    WaitForSpace(pad);
+    auto* h = reinterpret_cast<Header*>(s_ring + offset);
+    h->size = static_cast<u32>(pad);
+    h->op = OP_PAD;
+    s_reserve += pad;
+    s_write.store(s_reserve, std::memory_order_seq_cst);
+    offset = 0;
+  }
+  WaitForSpace(size);
+  auto* h = reinterpret_cast<Header*>(s_ring + offset);
+  h->size = static_cast<u32>(size);
+  h->op = op;
+  s_pending = static_cast<u32>(size);
+  return reinterpret_cast<u8*>(h + 1);
+}
+
+void ExecuteInline();
+
+void Commit()
+{
+  s_reserve += s_pending;
+  s_write.store(s_reserve, std::memory_order_seq_cst);
+  if (ps4_vk_thread_mode == 2)
+  {
+    ExecuteInline();
+    return;
+  }
+  WakeWorker();
+  if (ps4_vk_thread_mode == 1)
+    PS4CommandRecorderDrain();
+}
+
+// Writes a payload made of a fixed struct followed by arrays.
+class Writer
+{
+public:
+  explicit Writer(u8* p) : m_p(p) {}
+  template <typename T>
+  void Put(const T& v)
+  {
+    std::memcpy(m_p, &v, sizeof(T));
+    m_p += sizeof(T);
+  }
+  template <typename T>
+  void PutArray(const T* v, u32 count)
+  {
+    if (count)
+      std::memcpy(m_p, v, sizeof(T) * count);
+    m_p += sizeof(T) * count;
+  }
+
+private:
+  u8* m_p;
+};
+
+class Reader
+{
+public:
+  explicit Reader(const u8* p) : m_p(p) {}
+  template <typename T>
+  T Get()
+  {
+    T v;
+    std::memcpy(&v, m_p, sizeof(T));
+    m_p += sizeof(T);
+    return v;
+  }
+  template <typename T>
+  const T* GetArray(u32 count)
+  {
+    const T* v = reinterpret_cast<const T*>(m_p);
+    m_p += sizeof(T) * count;
+    return v;
+  }
+
+private:
+  const u8* m_p;
+};
+
+// ---------------------------------------------------------------------------------------------
+// Replay (worker thread).
+void Execute(const Header* h)
+{
+  Reader r(reinterpret_cast<const u8*>(h + 1));
+  switch (h->op)
+  {
+  case OP_PAD:
+    break;
+  case OP_Call:
+  {
+    using Fn = void (*)(u64, u64, u64, u64);
+    const auto fn = r.Get<Fn>();
+    const u64 a = r.Get<u64>(), b = r.Get<u64>(), c = r.Get<u64>(), d = r.Get<u64>();
+    fn(a, b, c, d);
+    break;
+  }
+  case OP_BeginCommandBuffer:
+  {
+    const auto cb = r.Get<VkCommandBuffer>();
+    VkCommandBufferBeginInfo info = {VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO, nullptr,
+                                     r.Get<VkCommandBufferUsageFlags>(), nullptr};
+    const VkResult res = s_real.real_vkBeginCommandBuffer(cb, &info);
+    if (res != VK_SUCCESS)
+      ERROR_LOG_FMT(VIDEO, "vk_thread: vkBeginCommandBuffer failed: {}", static_cast<int>(res));
+    break;
+  }
+  case OP_EndCommandBuffer:
+  {
+    const VkResult res = s_real.real_vkEndCommandBuffer(r.Get<VkCommandBuffer>());
+    if (res != VK_SUCCESS)
+      ERROR_LOG_FMT(VIDEO, "vk_thread: vkEndCommandBuffer failed: {}", static_cast<int>(res));
+    break;
+  }
+  case OP_ResetCommandPool:
+  {
+    const auto device = r.Get<VkDevice>();
+    const auto pool = r.Get<VkCommandPool>();
+    s_real.real_vkResetCommandPool(device, pool, r.Get<VkCommandPoolResetFlags>());
+    break;
+  }
+  case OP_ResetFences:
+  {
+    const auto device = r.Get<VkDevice>();
+    const u32 count = r.Get<u32>();
+    s_real.real_vkResetFences(device, count, r.GetArray<VkFence>(count));
+    break;
+  }
+  case OP_QueueSubmit:
+  {
+    const auto queue = r.Get<VkQueue>();
+    const auto fence = r.Get<VkFence>();
+    const u32 count = r.Get<u32>();
+    VkSubmitInfo submits[4];
+    for (u32 i = 0; i < count && i < 4; i++)
+    {
+      VkSubmitInfo& s = submits[i];
+      s = {VK_STRUCTURE_TYPE_SUBMIT_INFO};
+      s.waitSemaphoreCount = r.Get<u32>();
+      s.pWaitSemaphores = r.GetArray<VkSemaphore>(s.waitSemaphoreCount);
+      s.pWaitDstStageMask = r.GetArray<VkPipelineStageFlags>(s.waitSemaphoreCount);
+      s.commandBufferCount = r.Get<u32>();
+      s.pCommandBuffers = r.GetArray<VkCommandBuffer>(s.commandBufferCount);
+      s.signalSemaphoreCount = r.Get<u32>();
+      s.pSignalSemaphores = r.GetArray<VkSemaphore>(s.signalSemaphoreCount);
+    }
+    const VkResult res = s_real.real_vkQueueSubmit(queue, count, submits, fence);
+    if (res != VK_SUCCESS)
+      ERROR_LOG_FMT(VIDEO, "vk_thread: vkQueueSubmit failed: {}", static_cast<int>(res));
+    break;
+  }
+  case OP_CmdBindPipeline:
+  {
+    const auto cb = r.Get<VkCommandBuffer>();
+    const auto point = r.Get<VkPipelineBindPoint>();
+    s_real.real_vkCmdBindPipeline(cb, point, r.Get<VkPipeline>());
+    break;
+  }
+  case OP_CmdBindDescriptorSets:
+  {
+    const auto cb = r.Get<VkCommandBuffer>();
+    const auto point = r.Get<VkPipelineBindPoint>();
+    const auto layout = r.Get<VkPipelineLayout>();
+    const u32 first = r.Get<u32>();
+    const u32 count = r.Get<u32>();
+    const u32 dynamic_count = r.Get<u32>();
+    const VkDescriptorSet* sets = r.GetArray<VkDescriptorSet>(count);
+    const u32* offsets = r.GetArray<u32>(dynamic_count);
+    s_real.real_vkCmdBindDescriptorSets(cb, point, layout, first, count, sets, dynamic_count,
+                                        offsets);
+    break;
+  }
+  case OP_CmdBindVertexBuffers:
+  {
+    const auto cb = r.Get<VkCommandBuffer>();
+    const u32 first = r.Get<u32>();
+    const u32 count = r.Get<u32>();
+    const VkBuffer* buffers = r.GetArray<VkBuffer>(count);
+    const VkDeviceSize* offsets = r.GetArray<VkDeviceSize>(count);
+    s_real.real_vkCmdBindVertexBuffers(cb, first, count, buffers, offsets);
+    break;
+  }
+  case OP_CmdBindIndexBuffer:
+  {
+    const auto cb = r.Get<VkCommandBuffer>();
+    const auto buffer = r.Get<VkBuffer>();
+    const auto offset = r.Get<VkDeviceSize>();
+    s_real.real_vkCmdBindIndexBuffer(cb, buffer, offset, r.Get<VkIndexType>());
+    break;
+  }
+  case OP_CmdDraw:
+  {
+    const auto cb = r.Get<VkCommandBuffer>();
+    const u32 a = r.Get<u32>(), b = r.Get<u32>(), c = r.Get<u32>(), d = r.Get<u32>();
+    s_real.real_vkCmdDraw(cb, a, b, c, d);
+    break;
+  }
+  case OP_CmdDrawIndexed:
+  {
+    const auto cb = r.Get<VkCommandBuffer>();
+    const u32 a = r.Get<u32>(), b = r.Get<u32>(), c = r.Get<u32>();
+    const s32 d = r.Get<s32>();
+    const u32 e = r.Get<u32>();
+    s_real.real_vkCmdDrawIndexed(cb, a, b, c, d, e);
+    break;
+  }
+  case OP_CmdDispatch:
+  {
+    const auto cb = r.Get<VkCommandBuffer>();
+    const u32 x = r.Get<u32>(), y = r.Get<u32>(), z = r.Get<u32>();
+    s_real.real_vkCmdDispatch(cb, x, y, z);
+    break;
+  }
+  case OP_CmdSetViewport:
+  {
+    const auto cb = r.Get<VkCommandBuffer>();
+    const u32 first = r.Get<u32>();
+    const u32 count = r.Get<u32>();
+    s_real.real_vkCmdSetViewport(cb, first, count, r.GetArray<VkViewport>(count));
+    break;
+  }
+  case OP_CmdSetScissor:
+  {
+    const auto cb = r.Get<VkCommandBuffer>();
+    const u32 first = r.Get<u32>();
+    const u32 count = r.Get<u32>();
+    s_real.real_vkCmdSetScissor(cb, first, count, r.GetArray<VkRect2D>(count));
+    break;
+  }
