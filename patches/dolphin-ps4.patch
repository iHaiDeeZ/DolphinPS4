+extern "C" int ps4_bezel_area[4];  // VideoCommon/Present.cpp: the game picture beside a bezel
+
+void Draw()
+{
+  s_draws++;
+  if (ps4_bezel_area[2] > ps4_bezel_area[0])
+  {
+    // The bezel's bars, a little darker than the game so the picture stands out.
+    ImDrawList* bg = ImGui::GetBackgroundDrawList();
+    const ImVec2 size = ImGui::GetIO().DisplaySize;
+    const ImU32 shade = IM_COL32(0, 0, 0, 110);
+    const float l = static_cast<float>(ps4_bezel_area[0]), t = static_cast<float>(ps4_bezel_area[1]),
+                r = static_cast<float>(ps4_bezel_area[2]), b = static_cast<float>(ps4_bezel_area[3]);
+    if (l > 0.0f)
+      bg->AddRectFilled(ImVec2(0, 0), ImVec2(l, size.y), shade);
+    if (r < size.x)
+      bg->AddRectFilled(ImVec2(r, 0), ImVec2(size.x, size.y), shade);
+    if (t > 0.0f)
+      bg->AddRectFilled(ImVec2(l, 0), ImVec2(r, t), shade);
+    if (b < size.y)
+      bg->AddRectFilled(ImVec2(l, b), ImVec2(r, size.y), shade);
+  }
+  std::lock_guard lock(s_mutex);
+  const auto now = Clock::now();
+  const float dt =
+      std::clamp(std::chrono::duration<float>(now - s_last_draw).count(), 0.0f, 0.1f);
+  s_last_draw = now;
+  s_appear += ((s_open ? 1.0f : 0.0f) - s_appear) * (1.0f - std::exp(-14.0f * dt));
+  const bool toast = now < s_toast_until;
+  if (!s_hint_started)
+  {
+    s_hint_started = true;
+    s_hint_start = now;
+  }
+  // Shown from 3 s to 10 s after the game's first frame, fading in and out.
+  const float hint_time = std::chrono::duration<float>(now - s_hint_start).count();
+  const float hint_alpha =
+      hint_time < 3.0f || hint_time > 10.0f ?
+          0.0f :
+          std::min({1.0f, (hint_time - 3.0f) / 0.4f, (10.0f - hint_time) / 0.6f});
+  if (s_rewind_fx && now > s_rewind_fx_end)
+    s_rewind_fx = false;
+  const int prepare = ps4_prepare_phase.load(std::memory_order_relaxed);
+  if (s_appear < 0.01f && !toast && hint_alpha <= 0.0f && s_popups.empty() &&
+      s_banners.empty() && !s_rewind_fx && !prepare)
+    return;
+
+  ImDrawList* dl = ImGui::GetForegroundDrawList();
+  const ImVec2 size = ImGui::GetIO().DisplaySize;
+  ImFont* bold = ps4_overlay_font ? ps4_overlay_font : ImGui::GetFont();
