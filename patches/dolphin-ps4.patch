+void Menu::StartUpdateCheck(bool manual)
+{
+  m_update_manual = m_update_manual || manual;
+  const UpdateState state = m_update_state;
+  if (m_update_thread.joinable() || state == UpdateState::Downloading ||
+      state == UpdateState::Finished)
+  {
+    return;
+  }
+  m_update_state = UpdateState::Checking;
+  m_update_thread = std::thread([this] {
+    const PS4Updater::Release release =
+        PS4Updater::CheckLatest(m_assets_dir + "/xmb/cacert.pem");
+    std::lock_guard lock(m_update_mutex);
+    m_update_release = release;
+    // Updates are the package, downloaded into /data/pkg and installed with the package installer.
+    // The self-starting update archive (v03.04-v03.34) was set aside as "didn't start" on 13.52
+    // (v03.34 test); releases no longer carry it, and one that does is ignored.
+    m_update_release.update_url.clear();
+    m_update_error = release.error;
+    if (!release.ok)
+      m_update_state = UpdateState::Failed;
+    else if (PS4Updater::CompareVersions(release.version, m_version) > 0)
+      m_update_state = UpdateState::Available;
+    else
+      m_update_state = UpdateState::UpToDate;
+  });
+}
+
+void Menu::StartUpdateDownload()
+{
+  if (m_update_thread.joinable())
+    m_update_thread.join();
+  m_update_cancel = false;
+  m_update_done = 0;
+  m_update_total = m_update_release.update_url.empty() ? m_update_release.size :
+                                                         m_update_release.update_size;
+  m_update_state = UpdateState::Downloading;
+  m_update_thread = std::thread([this] {
+    PS4Updater::Release release;
+    {
+      std::lock_guard lock(m_update_mutex);
+      release = m_update_release;
+    }
+    const std::string dir = m_data_dir + "/update";
+    mkdir(dir.c_str(), 0777);
+    auto progress = [this](uint64_t done, uint64_t total) {
+      m_update_done = done;
+      if (total)
+        m_update_total = total;
+      return !m_update_cancel;
+    };
+    if (!release.update_url.empty())
+    {
+      // The update archive: unpacked next to the old update (app.new), checked, then put in
+      // place of it (data_dir/app). The installed app starts it from there.
+      PS4Updater::Release archive = release;
+      archive.package = release.update_name;
+      archive.url = release.update_url;
+      archive.size = release.update_size;
+      archive.sha256 = release.update_sha256;
+      const std::string tar = dir + "/DolphinLab-v" + release.version + "-update.tar";
+      const std::string unpacked = m_data_dir + "/app.new", target = m_data_dir + "/app";
+      std::string error;
+      std::error_code ec;
+      bool ok = PS4Updater::Download(archive, tar, m_assets_dir + "/xmb/cacert.pem", progress, &error);
+      if (ok)
+      {
+        File::DeleteDirRecursively(unpacked);
+        ok = PS4Updater::ExtractTar(tar, unpacked, &error);
+      }
+      if (ok)
+      {
+        std::ifstream version_file(unpacked + "/xmb/version.txt");
+        std::string version;
+        std::getline(version_file, version);
+        while (!version.empty() && (version.back() == '\r' || version.back() == ' '))
+          version.pop_back();
+        if (!std::filesystem::exists(unpacked + "/eboot.bin", ec) || version != release.version)
+        {
+          error = "the update archive is incomplete (version \"" + version + "\")";
+          ok = false;
+        }
+      }
+      if (ok)
+      {
+        // The running program may be the old update itself: its folder can't be deleted while it
+        // runs (v03.09), but it can be renamed. app-old goes at the next start (RemoveOldUpdates).
+        const std::string old_dir = m_data_dir + "/app-old";
+        File::DeleteDirRecursively(old_dir);
+        if (std::filesystem::exists(target, ec))
+        {
+          std::filesystem::rename(target, old_dir, ec);
+          if (ec)
+          {
+            error = "can't move the old update aside: " + ec.message();
+            ok = false;
+          }
+        }
+        if (ok)
+        {
+          std::filesystem::rename(unpacked, target, ec);
+          if (ec)
+          {
+            error = "can't move the update into place: " + ec.message();
+            // Put the old one back, so the version that runs now still starts next time.
+            std::error_code back;
+            if (std::filesystem::exists(old_dir, back))
+              std::filesystem::rename(old_dir, target, back);
+            ok = false;
+          }
+        }
+      }
+      std::filesystem::remove(tar, ec);
+      std::lock_guard lock(m_update_mutex);
+      if (!ok)
+      {
+        File::DeleteDirRecursively(unpacked);
+        m_update_error = m_update_cancel ? "" : error;
+        m_update_state = m_update_cancel ? UpdateState::Available : UpdateState::Failed;
+        Log("update: " + (m_update_cancel ? std::string("cancelled") : error));
+        return;
+      }
+      Log("update: v" + release.version + " unpacked into " + target);
+      m_update_unpacked = true;
+      m_update_state = UpdateState::Finished;
+      return;
+    }
+    const std::string path = dir + "/DolphinLab-v" + release.version + ".pkg";
+    std::string error;
+    const bool downloaded =
+        PS4Updater::Download(release, path, m_assets_dir + "/xmb/cacert.pem", progress, &error);
+    if (!downloaded)
+    {
+      std::lock_guard lock(m_update_mutex);
+      m_update_error = m_update_cancel ? "" : error;
+      m_update_state = m_update_cancel ? UpdateState::Available : UpdateState::Failed;
+      return;
+    }
+    // The app can't install over itself (see PS4Updater.h): the checked package goes where the
+    // PS4's package installers look, and the user installs it with Dolphin closed.
+    mkdir("/data/pkg", 0777);
+    const std::string ready = "/data/pkg/DolphinLab-v" + release.version + ".pkg";
+    const bool moved = std::rename(path.c_str(), ready.c_str()) == 0;
+    Log("update: " + (moved ? ready : path) + " ready for the package installer");
+    std::lock_guard lock(m_update_mutex);
+    m_update_ready = moved ? ready : path;
+    m_update_state = UpdateState::Finished;
+  });
+}
+
+// The update panel shows the state: checking, the prompt, the download, the result.
+void Menu::ShowUpdatePanel()
+{
+  PS4Updater::Release release;
+  std::string error;
+  {
+    std::lock_guard lock(m_update_mutex);
+    release = m_update_release;
+    error = m_update_error;
+  }
+  const std::string latest = "Dolphin v" + release.version;
+  std::vector<std::string> lines, options;
+  std::string title = "Updates";
+  switch (m_update_state.load())
+  {
+  case UpdateState::Idle:
+  case UpdateState::Checking:
+    lines = {"", "Looking for a new version on GitHub..."};
+    break;
+  case UpdateState::UpToDate:
+    lines = {"", "You have the latest version.", "", "Installed: v" + m_version};
+    break;
+  case UpdateState::Available:
+  {
+    title = "Update Available";
+    char size[32];
+    snprintf(size, sizeof(size), "%.0f MB",
+             (release.update_url.empty() ? release.size : release.update_size) / (1024.0 * 1024.0));
+    lines = {"", latest + " is available.", "You have v" + m_version + ".", "",
+             "Download it (" + std::string(size) + ")?"};
+    options = {"Yes", "No"};
+    break;
+  }
+  case UpdateState::Downloading:
+  {
+    title = "Downloading Update";
+    const uint64_t done = m_update_done, total = std::max<uint64_t>(m_update_total, 1);
+    char line[96];
+    snprintf(line, sizeof(line), "%d%%   %.0f of %.0f MB", static_cast<int>(done * 100 / total),
+             done / (1024.0 * 1024.0), total / (1024.0 * 1024.0));
+    lines = {"", latest, line, "", "Keep the app open until it's done."};
+    options = {"Cancel"};
+    break;
+  }
+  case UpdateState::Finished:
+  {
+    std::string ready;
+    {
+      std::lock_guard lock(m_update_mutex);
+      ready = m_update_ready;
+    }
+    if (m_update_unpacked)
+    {
+      title = "Update Installed";
+      lines = {"", latest + " is ready.", "", "It starts when Dolphin restarts.",
+               "Games, saves and settings are kept."};
+      options = {"Restart Now", "Later"};
+      break;
+    }
+    title = "Update Ready";
+    lines = {"",
+             latest + " is downloaded and checked.",
+             "",
+             "To install it, close Dolphin, then open",
+             "Debug Settings > Game > Package Installer",
+             "(or GoldHEN's) and pick Dolphin v" + release.version + ".",
+             "",
+             "Saved as " + ready,
+             "Games, saves and settings are kept."};
+    options = {"Close Dolphin", "Later"};
+    break;
+  }
+  case UpdateState::Failed:
+  {
+    title = "Update";
+    lines = {"", m_update_prompted ? "The update didn't work:" : "Couldn't check for updates:"};
+    size_t start = 0;
+    while (start <= error.size())
+    {
+      const size_t end = error.find('\n', start);
+      lines.push_back(error.substr(start, end == std::string::npos ? std::string::npos :
+                                                                      end - start));
+      if (end == std::string::npos)
+        break;
+      start = end + 1;
+    }
+    options = {"OK"};
+    break;
+  }
+  }
+  const bool same_options = m_panel.options == options;
+  m_panel.open = true;
+  m_panel.setting = SET_UPDATE;
+  m_panel.title = title;
+  m_panel.lines = lines;
+  m_panel.rows.clear();
+  if (!same_options)
+  {
+    m_panel.options = options;
+    m_panel.selected = 0;
+  }
+}
+
+void Menu::UpdateUpdater(float dt)
+{
+  const UpdateState state = m_update_state;
+  const bool settled = state == UpdateState::UpToDate || state == UpdateState::Available ||
+                       state == UpdateState::Failed || state == UpdateState::Finished;
+  if (settled && m_update_thread.joinable())
+    m_update_thread.join();
+
+  // A new version found in the background: ask once, when nothing else is on screen.
+  if (state == UpdateState::Available && !m_update_prompted && !m_intro && m_launch < 0 &&
+      (!m_panel.open || m_panel.setting == SET_UPDATE))
+  {
+    m_update_prompted = true;
+    ShowUpdatePanel();
+    Play("menu");
+    return;
+  }
+  if (!m_panel.open || m_panel.setting != SET_UPDATE)
+  {
+    // Background results nobody asked to see stay quiet (they're in the log); a finished download
+    // is shown once.
+    if (state == UpdateState::Finished && !m_update_ready_shown)
+    {
+      m_update_ready_shown = true;
+      ShowUpdatePanel();
+      Play("confirm");
+    }
+    return;
+  }
+  if (state == UpdateState::Available)
+    m_update_prompted = true;
+  if (state == UpdateState::Finished && !m_update_ready_shown)
+  {
+    m_update_ready_shown = true;
+    Play("confirm");
+  }
+  ShowUpdatePanel();
+}
+
+// Update packages from earlier runs: once that version (or a newer one) is running, they're no
+// longer needed. A package for a newer version is kept, as its install may still be going on.
+void Menu::RemoveOldUpdates()
+{
+  std::error_code ec;
+  File::DeleteDirRecursively(m_data_dir + "/app.new");  // an unpack that didn't finish
+  File::DeleteDirRecursively(m_data_dir + "/app-old");  // the update an update replaced
+  const std::string dir = m_data_dir + "/update";
+  for (const auto& entry : std::filesystem::directory_iterator(dir, ec))
+  {
+    const std::string name = entry.path().filename().string();
+    const bool partial = name.size() > 5 && name.compare(name.size() - 5, 5, ".part") == 0;
+    const size_t v = name.find("-v");
+    const std::string version = v == std::string::npos ? "" : name.substr(v + 2);
+    if (partial || version.empty() || PS4Updater::CompareVersions(version, m_version) <= 0)
+    {
+      std::filesystem::remove(entry.path(), ec);
+      Log("update: removed " + name);
+    }
+  }
+  // Packages the updater left in /data/pkg (DolphinLab-v<version>.pkg: the Lab app's own, never the
+  // stable app's DolphinPS4-v*.pkg), once installed.
+  for (const auto& entry : std::filesystem::directory_iterator("/data/pkg", ec))
+  {
+    const std::string name = entry.path().filename().string();
+    if (name.compare(0, 12, "DolphinLab-v") != 0 || name.size() < 17 ||
+        name.compare(name.size() - 4, 4, ".pkg") != 0)
+    {
+      continue;
+    }
+    const std::string version = name.substr(12, name.size() - 16);
+    if (PS4Updater::CompareVersions(version, m_version) <= 0)
+    {
+      std::filesystem::remove(entry.path(), ec);
+      Log("update: removed /data/pkg/" + name);
+    }
+  }
+}
+
+std::string Menu::Run()
+{
+  s_log = fopen((m_data_dir + "/xmb.log").c_str(), "w");
+  File::SetUserPath(D_USER_IDX, m_data_dir + "/User/");
+  PS4Controls::SetUserDirectory(m_data_dir + "/User");
+  // The normal layout back in place if a game's own was in use.
+  PS4Controls::RestoreGlobal();
+  PS4Controls::WriteDefaultsIfMissing();
+  int user = 0;
+  sceUserServiceInitialize(nullptr);
+  sceUserServiceGetInitialUser(&user);
+
+  IMGUI_CHECKVERSION();
+  ImGui::CreateContext();
+  ImGuiIO& io = ImGui::GetIO();
+  io.IniFilename = nullptr;
+  io.LogFilename = nullptr;
+  io.DisplaySize = ImVec2(W, H);
+  if (!m_display.Initialize())
+  {
+    ImGui::DestroyContext();
+    return {};
+  }
+  m_user_id = user;
+  m_audio.Start(user);
+  m_input.Open(user);
+  LoadAssets();
+  LoadPlayed();
+  LoadCards();
+  ApplyPreferences();
+  BuildItems();
+  // Start on the game played last.
+  auto& games = m_items[static_cast<int>(Category::Games)];
+  for (size_t i = 0; i < games.size(); i++)
+  {
+    if (games[i].game >= 0 && m_games[games[i].game].path == m_prefs.last_game)
+    {
+      m_selected[static_cast<int>(Category::Games)] = static_cast<int>(i);
+      m_item_pos[static_cast<int>(Category::Games)] = static_cast<float>(i);
+    }
+  }
+  m_tab_pos = static_cast<float>(LibraryTab());
+  // The first start (no language chosen yet): the language list first, on the PS4's own language.
+  {
+    bool chosen = false;
+    for (const auto& [key, value] : PS4Settings::GlobalValues())
+      chosen = chosen || key == "language";
+    if (!chosen)
+    {
+      // PS4 system languages: 0 Japanese, 1 English, 2 French, 3 Spanish, 4 German, 5 Italian,
+      // 6 Dutch, 7 Portuguese, 8 Russian, 9 Korean, 10/11 Chinese, 16 Polish, 17 Portuguese
+      // (Brazil), 18 English (UK), 19 Turkish, 20 Spanish (Latin America), 22 French (Canada).
+      int32_t system = 1;
+      sceSystemServiceParamGetInt(ORBIS_SYSTEM_SERVICE_PARAM_ID_LANG, &system);
+      const char* code = system == 0                  ? "ja" :
+                         system == 2 || system == 22  ? "fr" :
+                         system == 3 || system == 20  ? "es" :
+                         system == 4                  ? "de" :
+                         system == 5                  ? "it" :
+                         system == 6                  ? "nl" :
+                         system == 7 || system == 17  ? "pt" :
+                         system == 8                  ? "ru" :
+                         system == 9                  ? "ko" :
+                         system == 10 || system == 11 ? "zh" :
+                         system == 16                 ? "pl" :
+                         system == 19                 ? "tr" :
+                                                        "en";
+      PS4Lang::Load(m_assets_dir, code);
+      BuildItems();
+      OpenSettingPanel(SET_LANGUAGE);
+      m_first_language = true;
+      Log(std::string("first start: language list (PS4 language ") + std::to_string(system) +
+          ", suggested " + code + ")");
+    }
+  }
+  RemoveOldUpdates();
+  if (m_prefs.auto_update)
+    StartUpdateCheck(false);
+  LoadCenter();
+  FetchGameSettings();
+  // Covers missing for any game are fetched in the background every time the app opens.
+  for (const Game& game : m_games)
+  {
+    if (!game.id.empty() && game.cover == ImTextureID{})
+    {
+      Log("covers: downloading the missing ones in the background");
+      StartCoverDownload();
+      break;
+    }
+  }
+  Log("menu: " + std::to_string(m_games.size()) + " games, " +
+      std::to_string(m_wallpapers.size()) + " wallpapers");
+  {
+    // The last game crashed or stopped by itself (PlatformPS4.cpp wrote why): shown once.
+    const std::string note_path = m_data_dir + "/last-stop.txt";
+    std::ifstream note(note_path);
+    std::string line;
+    std::vector<std::string> lines;
+    while (std::getline(note, line))
+    {
+      while (!line.empty() && line.back() == '\r')
+        line.pop_back();
+      lines.push_back(line);
+    }
+    note.close();
+    if (!lines.empty())
+    {
+      std::error_code error;
+      std::filesystem::remove(note_path, error);
+      Log("last game: " + lines[0] + (lines.size() > 4 ? " - " + lines[4] : std::string()));
+      m_panel = {};
+      m_panel.open = true;
+      m_panel.title = lines[0];
+      m_panel.lines.assign(lines.begin() + 1, lines.end());
+      m_panel.lines.push_back("");
+      m_panel.lines.push_back("Circle closes this.");
+      Play("error");
+    }
+  }
+
+  auto last = Clock::now();
+  std::string result;
+  while (!m_quit)
+  {
+    const auto now = Clock::now();
+    const float dt = std::clamp(std::chrono::duration<float>(now - last).count(), 0.0f, 0.1f);
+    last = now;
+    m_time += dt;
+    io.DeltaTime = dt > 0.0f ? dt : 1.0f / 60.0f;
+
+    if (!m_direct_launch.empty())
+    {
+      result = m_direct_launch;
+      break;
+    }
+    UpdateCapture(dt);
+    UpdateComboCapture(dt);
+    UpdateKeyboard();
+    UpdateAchievementLogin();
+    UpdateWiimmfiDownload();
+    UpdateWiiMenu();
+    if (m_intro)
+    {
+      // Any button: straight to the dissolve.
+      if (m_input.Poll(dt) != 0)
+        m_intro_time = std::max(m_intro_time, 1.9f);
+    }
+    else if (!m_capture)
+    {
+      HandleInput(m_input.Poll(dt));
+    }
+    UpdateCoverDownload();
+    if (m_covers_pending)
+      m_covers_pending = LoadCovers(2);
+    UpdateUpdater(dt);
+    UpdateCheatDownload();
+    UpdatePatchDownload();
+    UpdateCenterFetch();
+
+    m_display.BeginFrame();
+    ImGui::NewFrame();
+    Draw(dt);
+    ImGui::Render();
+    m_display.EndFrame();
+    static bool s_reported = false;
+    if (!s_reported)
+    {
+      // The menu is on screen: a downloaded update that got this far works.
+      s_reported = true;
+      ps4_update_started_ok();
+    }
+
+    if (m_launch >= 0 && m_launch_time >= 0.75f)
+    {
+      result = m_launch_override.empty() ? m_games[m_launch].path : m_launch_override;
+      break;
+    }
+  }
+
+  m_cover_cancel = true;
+  if (m_cover_thread.joinable())
+    m_cover_thread.join();
+  m_update_cancel = true;
+  if (m_update_thread.joinable())
+    m_update_thread.join();
+  // A code download still going (a game was started): its few seconds, not a crash on exit.
+  if (m_cheat_dl_thread.joinable())
+    m_cheat_dl_thread.join();
+  if (m_patch_dl_thread.joinable())
+    m_patch_dl_thread.join();
+  if (m_settings_thread.joinable())
+    m_settings_thread.join();
+  if (m_ra_thread.joinable())
+    m_ra_thread.join();
+  if (m_wiimmfi_thread.joinable())
+    m_wiimmfi_thread.join();
+  m_nus_cancel = true;
+  if (m_nus_thread.joinable())
+    m_nus_thread.join();
+  if (m_update_exit)
+    result = EXIT_APP;
+  if (m_update_restart)
+    result = RESTART_APP;
+  m_audio.Stop();
+  m_display.Shutdown();
+  ImGui::DestroyContext();
+  return result;
+}
