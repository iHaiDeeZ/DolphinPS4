+++ b/Source/Core/DolphinNoGUI/PS4Settings.h
@@ -0,0 +1,78 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// PS4 user settings, shared by the XMB (PS4XMB.cpp) and the in-game menu (PS4IngameMenu.cpp).
+// The user's choices are kept in /data/DolphinPS4/settings.ini: a [global] section and one
+// section per game ID for games set to "custom". A setting the user never changed falls back to
+// ps4.ini (the port's tuned defaults), then to the built-in fallback below.
+//
+// Precedence when a game starts (PlatformPS4.cpp): ps4.ini global < settings.ini [global] <
+// ps4.ini per-game compatibility sections < settings.ini [GAMEID] (custom games only).
+
+#pragma once
+
+#include <functional>
+#include <string>
+#include <vector>
+
+namespace PS4Settings
+{
+struct Choice
+{
+  const char* value;  // stored in settings.ini / ps4.ini
+  const char* label;  // shown in the menus
+};
+
+struct Setting
+{
+  const char* key;
+  const char* label;
+  const char* category;
+  std::vector<Choice> choices;
+  const char* fallback;  // when neither settings.ini nor ps4.ini has a value
+  bool live;             // takes effect while a game runs (else: next game start)
+  const char* help;
+};
+
+const std::vector<Setting>& All();
+const std::vector<const char*>& Categories();
+const Setting* Find(const std::string& key);
+
+// settings.ini
+void Load(const std::string& data_dir);
+void Save();
+
+// ps4.ini lookup for unset settings (PlatformPS4: its global options).
+void SetBaseLookup(std::function<std::string(const std::string& key)> lookup);
+// A game's built-in / ps4.ini per-game value (compatibility fixes), or empty. Ranks above the
+// user's global settings, below the game's own custom values.
+void SetGameBaseLookup(
+    std::function<std::string(const std::string& game_id, const std::string& key)> lookup);
+
+// Effective value: the game's own (custom games), else global, else ps4.ini, else fallback.
+std::string Get(const std::string& key, const std::string& game_id = {});
+// Stores a value globally (game_id empty) or for a custom game.
+void Set(const std::string& key, const std::string& value, const std::string& game_id = {});
+// The user's global choices (only what was changed) / a custom game's own values.
+std::vector<std::pair<std::string, std::string>> GlobalValues();
+std::vector<std::pair<std::string, std::string>> GameValues(const std::string& game_id);
+bool IsCustom(const std::string& game_id);
+// Custom on: the game starts with a copy of the effective global values.
+void SetCustom(const std::string& game_id, bool custom);
+
+// Back to the defaults (ps4.ini's tuned values): one global setting, a game (it follows the
+// global settings again), or everything.
+void ResetGlobal(const std::string& key);
+void ResetGame(const std::string& game_id);
+void ResetAll();
+
+// Label of a value for display ("16:9" for "wide").
+std::string LabelOf(const Setting& setting, const std::string& value);
+// Next / previous choice (wrapping).
+std::string Step(const Setting& setting, const std::string& value, int direction);
+
+// Game process only: applies a live setting to the running emulator (Config / port globals).
+void ApplyLive(const std::string& key, const std::string& value);
+// A Diagnostics switch as applied (its own value and All Diagnostics), after ApplyLive.
+bool DiagnosticOn(const std::string& key);
+}  // namespace PS4Settings
diff --git a/Source/Core/DolphinNoGUI/PS4Updater.cpp b/Source/Core/DolphinNoGUI/PS4Updater.cpp
new file mode 100755
index 0000000..645c6a5
--- /dev/null
+++ b/Source/Core/DolphinNoGUI/PS4Updater.cpp
@@ -0,0 +1,328 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "DolphinNoGUI/PS4Updater.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+#include <mbedtls/sha256.h>
+#include <orbis/AppInstUtil.h>
+#include <orbis/Bgft.h>
+#include <orbis/Sysmodule.h>
+#include <picojson.h>
+
+#include "DolphinNoGUI/PS4Net.h"
+
+extern "C" void ps4_boot_trace(const char* line);  // port/ps4_crashlog.cpp
+
+namespace PS4Updater
+{
+namespace
+{
+constexpr const char* LATEST_RELEASE =
+    "https://api.github.com/repos/iHaiDeeZ/DolphinPS4/releases/latest";
+
+void Log(const std::string& text)
+{
+  fprintf(stderr, "[update] %s\n", text.c_str());
+  ps4_boot_trace(("update: " + text).c_str());
+}
+
+std::string Hex(const unsigned char* data, size_t size)
+{
+  static const char digits[] = "0123456789abcdef";
+  std::string text;
+  for (size_t i = 0; i < size; i++)
+  {
+    text += digits[data[i] >> 4];
+    text += digits[data[i] & 15];
+  }
+  return text;
+}
+
+std::string Lower(std::string text)
+{
+  for (char& c : text)
+    c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+  return text;
+}
+
+bool EndsWith(const std::string& text, const std::string& end)
+{
+  return text.size() >= end.size() && text.compare(text.size() - end.size(), end.size(), end) == 0;
+}
+}  // namespace
+
+Release CheckLatest(const std::string& ca_file)
+{
+  Release release;
+  std::string body, error;
+  PS4Net::Request request;
+  request.url = LATEST_RELEASE;
+  request.headers = {"Accept: application/vnd.github+json", "X-GitHub-Api-Version: 2022-11-28"};
+  request.ca_file = ca_file;
+  request.timeout_seconds = 30;
+  const long status = PS4Net::Get(
+      request,
+      [&body](const char* data, size_t size) {
+        body.append(data, size);
+        return body.size() < 4 * 1024 * 1024;
+      },
+      {}, &error);
+  if (status != 200)
+  {
+    release.error = status == 0 ? error : "GitHub answered " + std::to_string(status);
+    Log("check failed: " + release.error);
+    return release;
+  }
+
+  picojson::value json;
+  const std::string parse_error = picojson::parse(json, body);
+  if (!parse_error.empty() || !json.is<picojson::object>())
+  {
+    release.error = "unexpected answer from GitHub";
+    Log("check failed: " + release.error + " " + parse_error);
+    return release;
+  }
+  const picojson::object& root = json.get<picojson::object>();
+  auto text = [](const picojson::object& object, const char* key) {
+    const auto it = object.find(key);
+    return it != object.end() && it->second.is<std::string>() ? it->second.get<std::string>() :
+                                                                 std::string();
+  };
+  std::string tag = text(root, "tag_name");
+  if (!tag.empty() && (tag[0] == 'v' || tag[0] == 'V'))
+    tag.erase(0, 1);
+  release.version = tag;
+  release.title = text(root, "name");
+
+  const auto assets = root.find("assets");
+  if (assets != root.end() && assets->second.is<picojson::array>())
+  {
+    for (const picojson::value& value : assets->second.get<picojson::array>())
+    {
+      if (!value.is<picojson::object>())
+        continue;
+      const picojson::object& asset = value.get<picojson::object>();
+      const std::string name = text(asset, "name");
+      if (!EndsWith(Lower(name), ".pkg"))
+        continue;
+      release.package = name;
+      release.url = text(asset, "browser_download_url");
+      const auto size = asset.find("size");
+      if (size != asset.end() && size->second.is<double>())
+        release.size = static_cast<uint64_t>(size->second.get<double>());
+      const std::string digest = text(asset, "digest");
+      if (digest.compare(0, 7, "sha256:") == 0)
+        release.sha256 = Lower(digest.substr(7));
+      break;
+    }
+  }
+  if (release.version.empty() || release.url.empty())
+  {
+    release.error = "the latest release has no package";
+  }
+  else if (release.sha256.size() != 64)
+  {
+    // Without GitHub's checksum the download couldn't be checked: don't offer it.
+    release.error = "the latest release has no checksum";
+  }
+  else
+  {
+    release.ok = true;
+  }
+  Log("latest release " + release.version + " (" + release.package + ", " +
+      std::to_string(release.size) + " bytes)" + (release.ok ? "" : ": " + release.error));
+  return release;
+}
+
+int CompareVersions(const std::string& a, const std::string& b)
+{
+  auto parts = [](const std::string& text) {
+    std::vector<long> numbers;
+    size_t i = 0;
+    while (i < text.size())
+    {
+      if (std::isdigit(static_cast<unsigned char>(text[i])))
+      {
+        char* end = nullptr;
+        numbers.push_back(std::strtol(text.c_str() + i, &end, 10));
+        i = static_cast<size_t>(end - text.c_str());
+      }
+      else
+      {
+        i++;
+      }
+    }
+    return numbers;
+  };
+  const std::vector<long> x = parts(a), y = parts(b);
+  for (size_t i = 0; i < std::max(x.size(), y.size()); i++)
+  {
+    const long p = i < x.size() ? x[i] : 0, q = i < y.size() ? y[i] : 0;
+    if (p != q)
+      return p < q ? -1 : 1;
+  }
+  return 0;
+}
+
+bool Download(const Release& release, const std::string& path, const std::string& ca_file,
+              const std::function<bool(uint64_t, uint64_t)>& progress, std::string* error)
+{
+  const std::string part = path + ".part";
+  FILE* file = fopen(part.c_str(), "wb");
+  if (!file)
+  {
+    *error = "can't write " + part;
+    return false;
+  }
+  mbedtls_sha256_context sha;
+  mbedtls_sha256_init(&sha);
+  mbedtls_sha256_starts_ret(&sha, 0);
+  uint64_t written = 0;
+  bool write_failed = false;
+
+  PS4Net::Request request;
+  request.url = release.url;
+  request.ca_file = ca_file;
+  request.timeout_seconds = 0;  // a large file on a slow line; stalls end it instead
+  const long status = PS4Net::Get(
+      request,
+      [&](const char* data, size_t size) {
+        if (fwrite(data, 1, size, file) != size)
+        {
+          write_failed = true;
+          return false;
+        }
+        mbedtls_sha256_update_ret(&sha, reinterpret_cast<const unsigned char*>(data), size);
+        written += size;
+        return true;
+      },
+      [&](uint64_t done, uint64_t total) {
+        return progress(done, total ? total : release.size);
+      },
+      error);
+  fclose(file);
+  unsigned char digest[32];
+  mbedtls_sha256_finish_ret(&sha, digest);
+  mbedtls_sha256_free(&sha);
+
+  if (write_failed)
+    *error = "couldn't write the package (is the PS4's storage full?)";
+  else if (status != 200 && error->empty())
+    *error = "GitHub answered " + std::to_string(status);
+  else if (status == 200 && written != release.size)
+    *error = "the download is incomplete";
+  else if (status == 200 && Hex(digest, sizeof(digest)) != release.sha256)
+    *error = "the download doesn't match GitHub's checksum";
+  if (status != 200 || write_failed || !error->empty())
+  {
+    std::remove(part.c_str());
+    Log("download failed: " + *error);
+    return false;
+  }
+  std::remove(path.c_str());
+  if (std::rename(part.c_str(), path.c_str()) != 0)
+  {
+    *error = "can't rename " + part;
+    std::remove(part.c_str());
+    return false;
+  }
+  Log("downloaded " + path + " (" + std::to_string(written) + " bytes, checksum OK)");
+  return true;
+}
+
+std::string Install(const std::string& path)
+{
+  if (path.compare(0, 6, "/data/") != 0)
+    return "the package must be under /data";
+
+  // The content ID from the package's header (offset 0x40, 36 characters).
+  char content_id[0x30] = {};
+  if (FILE* file = fopen(path.c_str(), "rb"))
+  {
+    unsigned char header[0x70] = {};
+    const size_t read = fread(header, 1, sizeof(header), file);
+    fclose(file);
+    if (read != sizeof(header) || header[0] != 0x7F || header[1] != 'C' || header[2] != 'N' ||
+        header[3] != 'T')
+    {
+      return "the file isn't a PS4 package";
+    }
+    memcpy(content_id, header + 0x40, 36);
+  }
+  else
+  {
+    return "can't read " + path;
+  }
+
+  sceSysmoduleLoadModuleInternal(ORBIS_SYSMODULE_INTERNAL_APP_INST_UTIL);
+  sceSysmoduleLoadModuleInternal(ORBIS_SYSMODULE_INTERNAL_BGFT);
+  static bool s_initialized = false;
+  static std::vector<unsigned char> s_heap;
+  if (!s_initialized)
+  {
+    const int app_inst = sceAppInstUtilInitialize();
+    s_heap.assign(1024 * 1024, 0);
+    OrbisBgftInitParams params = {};
+    params.heap = s_heap.data();
+    params.heapSize = s_heap.size();
+    const int bgft = sceBgftServiceIntInit(&params);
+    char line[96];
+    snprintf(line, sizeof(line), "installer init: app inst util %#x, bgft %#x",
+             static_cast<unsigned>(app_inst), static_cast<unsigned>(bgft));
+    Log(line);
+    if (bgft != 0)
+      return "the PS4's installer is not available";
+    s_initialized = true;
+  }
+
+  const std::string system_path = "/user" + path;  // the installer's view of /data
+  OrbisBgftDownloadParamEx download = {};
+  download.params.entitlementType = 5;
+  download.params.id = content_id;
+  download.params.contentUrl = system_path.c_str();
+  download.params.contentName = "Dolphin";
+  download.params.iconPath = "";
+  download.params.playgoScenarioId = "0";
+  download.params.option = ORBIS_BGFT_TASK_OPT_FORCE_UPDATE;
+  download.slot = 0;
+
+  OrbisBgftTaskId task = -1;
+  int result = sceBgftServiceIntDownloadRegisterTaskByStorageEx(&download, &task);
+  char line[160];
+  snprintf(line, sizeof(line), "register %s (%s): %#x, task %d", system_path.c_str(), content_id,
+           static_cast<unsigned>(result), task);
+  Log(line);
+  if (result == static_cast<int>(0x80990088) || result == static_cast<int>(0x80990015))
+  {
+    // "Already installed": let the package replace the installed app, then try again. (Tools
+    // that install other apps uninstall the old one first; this is the running app itself.)
+    const int overwrite = sceAppInstUtilAppPrepareOverwritePkg(path.c_str());
+    result = sceBgftServiceIntDownloadRegisterTaskByStorageEx(&download, &task);
+    snprintf(line, sizeof(line), "prepare overwrite %#x, register again %#x, task %d",
+             static_cast<unsigned>(overwrite), static_cast<unsigned>(result), task);
+    Log(line);
+  }
+  if (result != 0)
+  {
+    snprintf(line, sizeof(line), "the PS4's installer refused it (%#x)",
+             static_cast<unsigned>(result));
+    return line;
+  }
+  result = sceBgftServiceDownloadStartTask(task);
+  if (result != 0)
+  {
+    snprintf(line, sizeof(line), "the install didn't start (%#x)", static_cast<unsigned>(result));
+    Log(line);
+    return line;
+  }
+  Log("install started");
+  return {};
+}
+}  // namespace PS4Updater
diff --git a/Source/Core/DolphinNoGUI/PS4Updater.h b/Source/Core/DolphinNoGUI/PS4Updater.h
new file mode 100755
index 0000000..dbf7077
--- /dev/null
+++ b/Source/Core/DolphinNoGUI/PS4Updater.h
@@ -0,0 +1,44 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// Updates from the project's GitHub releases: the latest release is compared with the running
+// version, its package is downloaded (the connection's certificate checked, the file checked
+// against the SHA-256 GitHub publishes for it) and handed to the PS4's own installer, which
+// installs it in the background.
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <functional>
+#include <string>
+
+namespace PS4Updater
+{
+struct Release
+{
+  bool ok = false;
+  std::string error;
+  std::string version;    // "02.99" (the tag without its "v")
+  std::string title;      // the release's name
+  std::string package;    // file name of the .pkg asset
+  std::string url;        // its download address
+  uint64_t size = 0;
+  std::string sha256;     // lower-case hex
+};
+
+// The latest release on GitHub.
+Release CheckLatest(const std::string& ca_file);
+
+// <0 if a is older than b, 0 if equal, >0 if newer ("02.99" < "03.00" < "03.10").
+int CompareVersions(const std::string& a, const std::string& b);
+
+// Downloads the release's package to path (through path + ".part"), checking its size and
+// SHA-256. progress(done, total) may return false to cancel. Returns false with *error set.
+bool Download(const Release& release, const std::string& path, const std::string& ca_file,
+              const std::function<bool(uint64_t, uint64_t)>& progress, std::string* error);
+
+// Hands the package (under /data) to the PS4's installer. Returns empty when the install has
+// started, else what went wrong.
+std::string Install(const std::string& path);
+}  // namespace PS4Updater
