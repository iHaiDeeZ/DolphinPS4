+// PS4: texture hash memo. Dolphin hashes a texture's memory every time it is looked up or
+// rebound (~7% of the video thread in Crash Bandicoot's busy scenes, ~4000 draws per frame).
+// Within one frame, a RAM texture at the same address and size is hashed once; later lookups
+// reuse the result. The memo is cleared every frame and on every EFB copy (which can write into
+// texture memory). Palettes and TMEM textures are never memoized. ps4.ini tex_hash_once=off
+// restores hashing on every lookup.
+// A memo also keeps eight 8-byte samples spread over the texture: a texture the CPU rewrote within
+// the frame is hashed again. Bink video players write a slice into one small texture, draw it and
+// write the next slice into the same memory (Chicken Little's cutscenes came out garbled).
+extern "C" int ps4_tex_hash_once;
+int ps4_tex_hash_once = 1;
+extern "C" u32 ps4_tex_hash_epoch;
+u32 ps4_tex_hash_epoch = 1;
+
+namespace
+{
+struct TextureHashMemo
+{
+  u32 address;
+  u32 size;
+  u32 samples;
+  u32 epoch;
+  u64 hash;
+  u64 content;
+};
+
+// Eight 8-byte samples spread over the texture, folded: a rewrite almost always changes one.
+u64 PS4TextureContentSample(const u8* data, u32 size)
+{
+  if (size < 8)
+    return 0;
+  u64 folded = size;
+  const u32 last = size - 8;
+  for (u32 i = 0; i < 8; i++)
+  {
+    u64 sample;
+    std::memcpy(&sample, data + static_cast<u64>(last) * i / 7, sizeof(sample));
+    folded = (folded ^ sample) * 0x9E3779B97F4A7C15ull;
+  }
+  return folded;
+}
+// 1024 sets of 4: a busy scene binds a few hundred textures a frame, and a single slot per
+// address made textures evict each other and be hashed again (texture hashing was still ~3.7% of
+// the video thread in Donald Duck's busy areas).
+constexpr u32 MEMO_SETS = 1024, MEMO_WAYS = 4;
+TextureHashMemo s_texture_hash_memo[MEMO_SETS * MEMO_WAYS];
+u8 s_texture_hash_memo_next[MEMO_SETS];
+}  // namespace
+
+// An EFB copy may write into texture memory: the memoized hashes of what it overlaps are dropped
+// (it used to drop them all - Donald Duck makes ~7 copies a frame, so most textures were hashed
+// again several times a frame).
+static void PS4ForgetTextureHashes(u32 address, u32 size)
+{
+  const u32 from = address & 0x3FFFFFFF, to = from + size;
+  for (TextureHashMemo& memo : s_texture_hash_memo)
+  {
+    const u32 memo_from = memo.address & 0x3FFFFFFF;
+    if (memo_from < to && memo_from + memo.size > from)
+      memo.epoch = 0;
+  }
+}
+
+static u64 PS4TextureHash(u32 address, const u8* data, u32 size, u32 samples)
+{
+  if (!ps4_tex_hash_once)
+    return Common::GetHash64(data, size, samples);
+  const u32 set = ((address >> 5) ^ (size << 3)) & (MEMO_SETS - 1);
+  TextureHashMemo* ways = &s_texture_hash_memo[set * MEMO_WAYS];
+  const u64 content = PS4TextureContentSample(data, size);
+  for (u32 i = 0; i < MEMO_WAYS; i++)
+  {
+    const TextureHashMemo& memo = ways[i];
+    if (memo.epoch == ps4_tex_hash_epoch && memo.address == address && memo.size == size &&
+        memo.samples == samples && memo.content == content)
+    {
+      return memo.hash;
+    }
+  }
+  const u64 hash = Common::GetHash64(data, size, samples);
+  // Into a way that is out of date, else the next one in turn.
+  u32 way = MEMO_WAYS;
+  for (u32 i = 0; i < MEMO_WAYS && way == MEMO_WAYS; i++)
+  {
+    if (ways[i].epoch != ps4_tex_hash_epoch ||
+        (ways[i].address == address && ways[i].size == size))
+      way = i;
+  }
+  if (way == MEMO_WAYS)
+    way = s_texture_hash_memo_next[set]++ % MEMO_WAYS;
+  ways[way] = {address, size, samples, ps4_tex_hash_epoch, hash, content};
+  return hash;
+}
