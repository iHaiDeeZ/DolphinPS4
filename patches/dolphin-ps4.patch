+
+namespace PS4Jit
+{
+class JitPS4;
+
+// Compiled game code kept on the hard drive between runs, as RPCS3 keeps its PPU cache:
+// /data/DolphinPS4/cache/jit/<GAME ID>.jitc, read in one go when the game first runs code. When
+// the game reaches a block that was compiled in an earlier run, the saved machine code is copied
+// into place and its addresses fixed (to this run's code space, constants and emulator objects)
+// instead of analysing and compiling it again - as long as the game's code there is unchanged
+// (hashed) and the emulator build and JIT options match (otherwise the file starts over).
+// New blocks are saved when the game stops and when the in-game menu opens. What the JIT learns
+// about a block while the game runs (GPU FIFO writes, changing GQRs) is saved with it: a copy
+// compiled before the JIT knew is not used.
+// Setting jit_cache: on (default), off, check (compiles everything and compares it with the saved
+// copies: a test that the saved code would have been right, logged to boot-trace.log).
+class CodeCache final : public Gen::XEmitter::RelocSink
+{
+public:
+  explicit CodeCache(JitPS4& jit) : m_jit(jit) {}
+
+  void Start();
+  void Stop();
+  void Save();
+
+  // JitPS4::Jit: the first time the game's own code runs (not the BIOS or apploader), before it
+  // goes on - like RPCS3 preparing PPU modules: every saved block of the game put in place, then
+  // the game's other functions compiled and saved, with a progress card on screen. True if this
+  // call did it.
+  bool Prepare(u32 em_address);
+  // JitPS4::Jit, before analysing: the saved copy of the block at em_address put in place.
+  bool Restore(u32 em_address);
+  // Around DoJit: records every address the new block's code refers to.
+  void BeginBlock();
+  void EndBlock();
+  // A block just compiled (before it is linked): kept for the file; in check mode compared with
+  // the copy saved in an earlier run first.
+  void Add(JitBlock& block, const PPCAnalyst::CodeBlock& code_block);
+
+  void Rel32(u8* disp, int extra, const void* target) override;
+  void Imm64(u8* at, u64 value) override;
+
+private:
+  enum class Mode
+  {
+    Off,
+    On,
+    Check,
+  };
+  struct Record
+  {
+    u8* site;
+    const u8* target;
+    s8 extra;
+    bool abs64;
+  };
+  struct Region
+  {
+    const u8* base;
+    u64 size;
+  };
+
+  bool Ready();
+  void Load();
+  void PrepareFromDisc();
+  u64 ConfigHash();
+  void RefreshRegions();
+  bool GuestHash(const std::vector<std::pair<u32, u32>>& ranges, u64* hash);
+  // Fixes the copied code's addresses; false if something it refers to can't be found.
+  bool Relocate(const std::vector<u8>& blob, u8* near_dest, u8* far_dest, u8* near_at,
+                u8* far_at);
+  static u64 Key(u32 em_address, u32 feature_flags)
+  {
+    return (u64(feature_flags) << 32) | em_address;
+  }
+
+  JitPS4& m_jit;
+  Mode m_mode = Mode::Off;
+  bool m_opened = false;
+  bool m_ready = false;
+  bool m_prepared = false;
+  bool m_disc_prepared = false;
+  bool m_disc_compiled = false;
+  bool m_dirty = false;
+  bool m_recording = false;
+  std::string m_path;
+  u64 m_config = 0;
+  std::vector<Record> m_records;
+  std::vector<u8*> m_backpatches;
+  std::vector<Region> m_regions;
+  // Every block's saved form (see CodeCache.cpp for the layout), by address and CPU mode.
+  std::vector<std::vector<u8>> m_blobs;
+  std::unordered_map<u64, size_t> m_index;
+  size_t m_bytes = 0;
+
+  struct Stats
+  {
+    u64 loaded = 0, restored = 0, compiled = 0, stale = 0, relearned = 0, unsaved = 0, checked = 0,
+        mismatched = 0, no_space = 0;
+    const char* last_unsaved = "";
+  } m_stats;
+};
+}  // namespace PS4Jit
