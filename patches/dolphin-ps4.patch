index 0000000..b38108d
--- /dev/null
+++ b/Source/Core/Core/PowerPC/JitPS4/Verify.cpp
@@ -0,0 +1,471 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "Core/PowerPC/JitPS4/Verify.h"
+
+#include <array>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include "Core/HLE/HLE.h"
+#include "Core/PowerPC/Interpreter/Interpreter.h"
+#include "Core/PowerPC/JitPS4/Jit.h"
+#include "Core/PowerPC/MMU.h"
+#include "Core/PowerPC/PowerPC.h"
+#include "Core/System.h"
+
+extern "C" void ps4_boot_trace(const char* line);  // DolphinPS4 port/ps4_crashlog.cpp
+extern "C" int ps4_jit_verify;
+int ps4_jit_verify = 0;
+
+namespace PS4Jit
+{
+namespace
+{
+using PowerPC::ConditionRegister;
+using PowerPC::PairedSingle;
+
+// Each block is checked this many times (the first runs), then left alone.
+constexpr int CHECKS_PER_BLOCK = 3;
+// The longest replay (a block is at most a few hundred instructions).
+constexpr int MAX_STEPS = 65536;  // more than any block's instructions
+
+// The registers a block can change (what the replay is compared on and what is put back).
+struct Regs
+{
+  std::array<u32, 32> gpr;
+  std::array<u64, 64> fpr;  // ps0, ps1 of each
+  std::array<u32, 8> cr;
+  u32 lr, ctr, xer_stringctrl;
+  u8 xer_ca, xer_so_ov;
+  std::array<u32, 8> gqr;
+  u32 msr, fpscr;
+  u32 pc, npc;
+  u32 reserve, reserve_address;
+
+  void Capture(const PowerPC::PowerPCState& s)
+  {
+    for (int i = 0; i < 32; i++)
+    {
+      gpr[i] = s.gpr[i];
+      fpr[i * 2] = s.ps[i].PS0AsU64();
+      fpr[i * 2 + 1] = s.ps[i].PS1AsU64();
+    }
+    for (u32 i = 0; i < 8; i++)
+      cr[i] = s.cr.GetField(i);
+    lr = s.spr[SPR_LR];
+    ctr = s.spr[SPR_CTR];
+    xer_stringctrl = s.xer_stringctrl;
+    xer_ca = s.xer_ca;
+    xer_so_ov = s.xer_so_ov;
+    for (int i = 0; i < 8; i++)
+      gqr[i] = s.spr[SPR_GQR0 + i];
+    msr = s.msr.Hex;
+    fpscr = s.fpscr.Hex;
+    pc = s.pc;
+    npc = s.npc;
+    reserve = s.reserve;
+    reserve_address = s.reserve_address;
+  }
+};
+
+// What a replay may change, saved before it and put back after (field by field: the state also
+// holds the caches, which own memory).
+struct SavedState
+{
+  u32 pc, npc;
+  u32 gpr[32];
+  PairedSingle ps[32];
+  ConditionRegister cr;
+  u32 msr;
+  u32 fpscr;
+  u32 exceptions;
+  int downcount;
+  u8 xer_ca, xer_so_ov;
+  u16 xer_stringctrl;
+  u32 reserve_address;
+  bool reserve;
+  std::array<u32, 16> sr;
+  u32 spr[1024];
+
+  void Save(const PowerPC::PowerPCState& s)
+  {
+    pc = s.pc;
+    npc = s.npc;
+    std::memcpy(gpr, s.gpr, sizeof(gpr));
+    for (int i = 0; i < 32; i++)
+      ps[i] = s.ps[i];
+    cr = s.cr;
+    msr = s.msr.Hex;
+    fpscr = s.fpscr.Hex;
+    exceptions = s.Exceptions;
+    downcount = s.downcount;
+    xer_ca = s.xer_ca;
+    xer_so_ov = s.xer_so_ov;
+    xer_stringctrl = s.xer_stringctrl;
+    reserve_address = s.reserve_address;
+    reserve = s.reserve;
+    sr = s.sr;
+    std::memcpy(spr, s.spr, sizeof(spr));
+  }
+  void Restore(PowerPC::PowerPCState& s) const
+  {
+    s.pc = pc;
+    s.npc = npc;
+    std::memcpy(s.gpr, gpr, sizeof(gpr));
+    for (int i = 0; i < 32; i++)
+      s.ps[i] = ps[i];
+    s.cr = cr;
+    s.msr.Hex = msr;
+    s.fpscr.Hex = fpscr;
+    s.Exceptions = exceptions;
+    s.downcount = downcount;
+    s.xer_ca = xer_ca;
+    s.xer_so_ov = xer_so_ov;
+    s.xer_stringctrl = xer_stringctrl;
+    s.reserve_address = reserve_address;
+    s.reserve = reserve;
+    s.sr = sr;
+    std::memcpy(s.spr, spr, sizeof(spr));
+  }
+};
+
+struct Checkpoint
+{
+  u32 next_pc;
+  size_t writes;
+  Regs regs;
+};
+
+struct State
+{
+  bool active = false;
+  bool failed = false;
+  const char* why = "";
+  u32 start = 0;
+  // The register state before the replay, put back before the compiled code runs.
+  SavedState saved;
+  std::vector<Checkpoint> checkpoints;
+  PowerPC::MMU::PS4Shadow shadow;
+  std::unordered_map<u64, int> checked;
+  u64 compared = 0, differed = 0, skipped = 0, lines = 0;
+  std::chrono::steady_clock::time_point last_report{};
+} s;
+
+// Instructions the replay can't do without side effects outside the registers and RAM.
+bool Replayable(UGeckoInstruction inst)
+{
+  switch (inst.OPCD)
+  {
+  case 3:   // twi
+  case 17:  // sc
+    return false;
+  case 4:
+    return inst.SUBOP10 != 1014;  // dcbz_l
+  case 19:
+    return inst.SUBOP10 != 50 && inst.SUBOP10 != 150;  // rfi, isync is fine but keep it simple
+  case 31:
+    switch (inst.SUBOP10)
+    {
+    case 4:     // tw
+    case 54:    // dcbst
+    case 86:    // dcbf
+    case 146:   // mtmsr
+    case 210:   // mtsr
+    case 242:   // mtsrin
+    case 306:   // tlbie
+    case 371:   // mftb
+    case 470:   // dcbi
+    case 566:   // tlbsync
+    case 982:   // icbi
+    case 1014:  // dcbz
+      return false;
+    case 339:  // mfspr
+    case 467:  // mtspr
+    {
+      const u32 spr = (inst.SPRU << 5) | (inst.SPRL & 0x1F);
+      return spr == SPR_LR || spr == SPR_CTR || spr == SPR_XER ||
+             (spr >= SPR_GQR0 && spr <= SPR_GQR0 + 7) || (spr >= SPR_SPRG0 && spr <= SPR_SPRG3);
+    }
+    default:
+      return true;
+    }
+  default:
+    return true;
+  }
+}
+
+void Line(const char* text)
+{
+  ps4_boot_trace((std::string("jit check: ") + text).c_str());
+}
+
+bool SameFloat(u64 a, u64 b)
+{
+  if (a == b)
+    return true;
+  double x, y;
+  std::memcpy(&x, &a, 8);
+  std::memcpy(&y, &b, 8);
+  if (std::isnan(x) && std::isnan(y))
+    return true;
+  const double scale = std::max(std::fabs(x), std::fabs(y));
+  return std::fabs(x - y) <= scale * 1e-5 || std::fabs(x - y) < 1e-30;
+}
+}  // namespace
+
+void Verifier::Begin(JitPS4& jit, u32 pc)
+{
+  s.active = false;
+  auto& ppc = jit.m_ppc_state;
+  const u64 key = (u64(ppc.feature_flags) << 32) | pc;
+  if (s.checked[key]++ >= CHECKS_PER_BLOCK)
+    return;
+  const JitBlock* block = jit.blocks.GetBlockFromStartAddress(pc, ppc.feature_flags);
+  if (!block)
+    return;
+  const u32 count = std::max<u32>(1, block->originalSize);
+
+  s.active = true;
+  s.failed = false;
+  s.why = "";
+  s.start = pc;
+  s.checkpoints.clear();
+  s.shadow.bytes.clear();
+  s.shadow.failed = false;
+  s.saved.Save(ppc);
+
+  auto& system = jit.m_system;
+  auto& mmu = system.GetMMU();
+  auto& interpreter = system.GetInterpreter();
+  mmu.m_ps4_shadow = &s.shadow;
+  u32 current = pc;
+  for (u32 step = 0; step < count && step < MAX_STEPS; step++)
+  {
+    if (HLE::TryReplaceFunction(jit.m_ppc_symbol_db, current, PowerPC::CoreMode::JIT))
+    {
+      s.failed = true, s.why = "HLE";
+      break;
+    }
+    const auto fetched = mmu.TryReadInstruction(current);
+    if (!fetched.valid)
+    {
+      s.failed = true, s.why = "fetch";
+      break;
+    }
+    const UGeckoInstruction inst{fetched.hex};
+    if (!Replayable(inst))
+    {
+      s.failed = true, s.why = "system instruction";
+      break;
+    }
+    ppc.pc = current;
+    ppc.npc = current + 4;
+    Interpreter::RunInterpreterOp(interpreter, inst);
+    if (ppc.Exceptions || s.shadow.failed)
+    {
+      s.failed = true, s.why = s.shadow.failed ? "hardware access" : "exception";
+      break;
+    }
+    const u32 next = ppc.npc;
+    // A place the compiled block can leave from: after a branch (also one to the next
+    // instruction - "b +4" can end a block), and after its last instruction.
+    const bool branch = inst.OPCD == 16 || inst.OPCD == 18 ||
+                        (inst.OPCD == 19 && (inst.SUBOP10 == 16 || inst.SUBOP10 == 528));
+    if (next != current + 4 || branch || step + 1 == count)
+    {
+      Checkpoint cp;
+      cp.next_pc = next;
+      cp.writes = s.shadow.bytes.size();
+      ppc.pc = next;
+      cp.regs.Capture(ppc);
+      s.checkpoints.push_back(cp);
+    }
+    current = next;
+  }
+  mmu.m_ps4_shadow = nullptr;
+  // Everything back as it was: the compiled block runs from the same state.
+  s.saved.Restore(ppc);
+}
+
+void Verifier::Exit(JitPS4& jit, u32 destination)
+{
+  if (!s.active)
+    return;
+  s.active = false;
+  if (s.failed)
+  {
+    s.skipped++;
+    return;
+  }
+  s.compared++;
+  char line[256];
+  // Every place the replay left to `destination` is a candidate: a block can reach the same
+  // address more than once (a function called twice through followed branches, a loop's copies).
+  // The compiled code matches one of them - the closest is reported if none matches exactly.
+  Regs now;
+  jit.m_ppc_state.pc = destination;
+  now.Capture(jit.m_ppc_state);
+  auto& mmu = jit.m_system.GetMMU();
+  const auto differences = [&](const Checkpoint& c, std::vector<std::string>* out) {
+    const auto add = [&](const char* text) {
+      if (out)
+        out->emplace_back(text);
+    };
+    size_t count = 0;
+    const Regs& want = c.regs;
+    for (int i = 0; i < 32; i++)
+    {
+      if (now.gpr[i] != want.gpr[i])
+      {
+        count++;
+        snprintf(line, sizeof(line), "r%d = %08x, interpreter %08x", i, now.gpr[i], want.gpr[i]);
+        add(line);
+      }
+    }
+    for (int i = 0; i < 64; i++)
+    {
+      if (!SameFloat(now.fpr[i], want.fpr[i]))
+      {
+        count++;
+        snprintf(line, sizeof(line), "f%d.ps%d = %016llx, interpreter %016llx", i / 2, i % 2,
+                 static_cast<unsigned long long>(now.fpr[i]),
+                 static_cast<unsigned long long>(want.fpr[i]));
+        add(line);
+      }
+    }
+    for (int i = 0; i < 8; i++)
+    {
+      // Not the SO bit: Dolphin's JITs don't emulate it for compares (on purpose).
+      if ((now.cr[i] & ~1u) != (want.cr[i] & ~1u))
+      {
+        count++;
+        snprintf(line, sizeof(line), "cr%d = %x, interpreter %x", i, now.cr[i], want.cr[i]);
+        add(line);
+      }
+    }
+    const auto check = [&](const char* name, u32 a, u32 b) {
+      if (a != b)
+      {
+        count++;
+        snprintf(line, sizeof(line), "%s = %08x, interpreter %08x", name, a, b);
+        add(line);
+      }
+    };
+    check("lr", now.lr, want.lr);
+    check("ctr", now.ctr, want.ctr);
+    check("xer.ca", now.xer_ca, want.xer_ca);
+    check("xer.so/ov", now.xer_so_ov, want.xer_so_ov);
+    check("xer.count", now.xer_stringctrl, want.xer_stringctrl);
+    check("msr", now.msr, want.msr);
+    for (int i = 0; i < 8; i++)
+    {
+      char name[8];
+      snprintf(name, sizeof(name), "gqr%d", i);
+      check(name, now.gqr[i], want.gqr[i]);
+    }
+    // Memory: the last value the replay wrote to each byte (before this exit).
+    std::unordered_map<u32, u8> last;
+    for (size_t i = 0; i < c.writes; i++)
+      last[s.shadow.bytes[i].first] = s.shadow.bytes[i].second;
+    int bad_bytes = 0;
+    u32 first_bad = 0;
+    for (const auto& [address, value] : last)
+    {
+      const u8* host = mmu.PS4RamByte(address);
+      if (host && *host != value)
+      {
+        if (bad_bytes++ == 0)
+          first_bad = address;
+      }
+    }
+    if (bad_bytes)
+    {
+      count++;
+      snprintf(line, sizeof(line), "%d of %zu written bytes differ (first at %08x)", bad_bytes,
+               last.size(), first_bad);
+      add(line);
+    }
+    return count;
+  };
+  const Checkpoint* cp = nullptr;
+  size_t best = SIZE_MAX;
+  for (const Checkpoint& c : s.checkpoints)
+  {
+    if (c.next_pc != destination)
+      continue;
+    const size_t count = differences(c, nullptr);
+    if (count < best)
+    {
+      best = count;
+      cp = &c;
+    }
+    if (count == 0)
+      break;
+  }
+  bool bad = false;
+  const auto report = [&](const char* what) {
+    bad = true;
+    if (s.lines++ < 200)
+    {
+      char full[320];
+      snprintf(full, sizeof(full), "block %08x exit %08x: %s", s.start, destination, what);
+      Line(full);
+    }
+  };
+  if (!cp)
+  {
+    std::string seen;
+    for (const Checkpoint& c : s.checkpoints)
+    {
+      snprintf(line, sizeof(line), " %08x", c.next_pc);
+      seen += line;
+    }
+    snprintf(line, sizeof(line), "left to an address the interpreter didn't (it went to%s)",
+             seen.c_str());
+    report(line);
+  }
+  else if (best != 0)
+  {
+    std::vector<std::string> lines;
+    differences(*cp, &lines);
+    for (const std::string& text : lines)
+      report(text.c_str());
+  }
+  if (bad)
+    s.differed++;
+
+  const auto now_time = std::chrono::steady_clock::now();
+  if (now_time - s.last_report > std::chrono::seconds(10))
+  {
+    s.last_report = now_time;
+    VerifySummary();
+  }
+}
+
+void VerifySummary()
+{
+  char line[256];
+  snprintf(line, sizeof(line),
+           "%llu block runs compared, %llu differed, %llu skipped (not replayable), %zu blocks "
+           "seen",
+           static_cast<unsigned long long>(s.compared), static_cast<unsigned long long>(s.differed),
+           static_cast<unsigned long long>(s.skipped), s.checked.size());
+  Line(line);
+}
+
+void VerifyBeginFromJit(JitPS4* jit, u32 pc)
+{
+  Verifier::Begin(*jit, pc);
+}
+
+void VerifyExitFromJit(JitPS4* jit, u32 destination)
+{
+  Verifier::Exit(*jit, destination);
+}
+}  // namespace PS4Jit
