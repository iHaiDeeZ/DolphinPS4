+extern "C" long long ps4_compile_internal_bytes, ps4_link_internal_bytes;  // ProgramShaderCache
+#include "Core/System.h"
+
+// The signed-in users (defined below; the main loop watches them for players joining).
+std::array<int32_t, 4> PS4LoginUsers();
+
+extern "C" int sceSystemServiceLoadExec(const char* path, char* const argv[]);
+extern "C" void ps4_boot_trace(const char* stage);
+extern "C" void ps4_dump_thread_stacks(const char* path, const char* reason);  // ps4_sampler.cpp
+// Settings > Diagnostics (PS4Settings.cpp): Performance Log (VideoCommon/Present.cpp) and Freeze
+// Reports (stall, slow start and hang stack dumps, below).
+extern "C" int ps4_perf_log;
+extern "C" {
+int ps4_freeze_reports = 1;
+}
+extern "C" int ps4_jit_in_system_pool;           // DolphinPS4 port/ps4_runtime.cpp
+extern "C" unsigned long long ps4_fault_count;
+
+#ifdef HAS_VULKAN
+// port/mesa/ac_ps4_drm.c (RADV on GNM).
+extern "C" void ac_ps4_get_gpu_busy(uint64_t* busy_ticks, uint64_t* span_ticks);
+extern "C" void ac_ps4_get_stats(uint64_t* submitted, uint64_t* completed, uint64_t* bo_bytes,
+                                 uint64_t* bo_count);
+#endif
+
+namespace
+{
+constexpr char PS4_DATA_DIR_PATH[] = "/data/DolphinPS4";
+
+// /data/DolphinPS4/ps4.ini: "key=value" lines, editable over FTP between runs. Lines after a
+// "[GAMEID]" header (a full game ID like G4BE08, or its first 3 characters for every region) only
+// apply to that game; they override the global lines (ApplyGameOptions).
+std::map<std::string, std::string> s_options;
+std::map<std::string, std::map<std::string, std::string>> s_game_options;
+
+// ps4.ini's global options as read (before settings.ini): the menus' defaults.
+std::map<std::string, std::string> s_ps4_global;
+
+// The app version (APP_VER of /app0/sce_sys/param.sfo), for the logs and the XMB's About.
+std::string AppVersion()
+{
+  // Written by scripts/package-dolphin.sh (param.sfo may not be readable from the sandbox).
+  {
+    std::ifstream version("/app0/xmb/version.txt");
+    std::string line;
+    if (std::getline(version, line) && !line.empty())
+    {
+      while (!line.empty() && (line.back() == '\r' || line.back() == ' '))
+        line.pop_back();
+      return line;
+    }
+  }
+  std::ifstream file("/app0/sce_sys/param.sfo", std::ios::binary);
+  const std::string sfo((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());
+  auto u32_at = [&](size_t at) {
+    u32 value = 0;
+    if (at + 4 <= sfo.size())
+      std::memcpy(&value, sfo.data() + at, 4);
+    return value;
+  };
+  if (sfo.size() < 20 || sfo.compare(0, 4, std::string("\0PSF", 4)) != 0)
+    return "?";
+  const u32 keys = u32_at(8), data = u32_at(12), count = u32_at(16);
+  for (u32 i = 0; i < count; i++)
+  {
+    const size_t entry = 20 + i * 16;
+    if (entry + 16 > sfo.size())
+      break;
+    u16 key_offset = 0;
+    std::memcpy(&key_offset, sfo.data() + entry, 2);
+    const size_t key_at = keys + key_offset;
+    if (key_at >= sfo.size() || std::strcmp(sfo.c_str() + key_at, "APP_VER") != 0)
+      continue;
+    const size_t value_at = data + u32_at(entry + 12);
+    if (value_at < sfo.size())
+      return std::string(sfo.c_str() + value_at);
+  }
+  return "?";
+}
+
+// Reads one options file into s_options / s_game_options (later files override earlier ones).
+void LoadOptionsFile(const std::string& path)
+{
+  FILE* file = fopen(path.c_str(), "r");
+  if (!file)
+    return;
+  char line[256];
+  std::string section;
+  while (fgets(line, sizeof(line), file))
+  {
+    std::string text = line;
+    while (!text.empty() && (text.back() == '\n' || text.back() == '\r' || text.back() == ' '))
+      text.pop_back();
+    if (text.size() > 2 && text.front() == '[' && text.back() == ']')
+    {
+      section = text.substr(1, text.size() - 2);
+      continue;
+    }
+    const size_t equals = text.find('=');
+    if (text.empty() || text[0] == '#' || text[0] == ';' || equals == std::string::npos)
+      continue;
+    if (section.empty())
+      s_options[text.substr(0, equals)] = text.substr(equals + 1);
+    else
+      s_game_options[section][text.substr(0, equals)] = text.substr(equals + 1);
+  }
+  fclose(file);
+}
+
+// The built-in defaults shipped with the app (tuned values, per-game fixes), then the user's
+// /data/DolphinPS4/ps4.ini on top.
+void LoadOptions()
+{
+  LoadOptionsFile("/app0/xmb/ps4-defaults.ini");
+  LoadOptionsFile(std::string(PS4_DATA_DIR_PATH) + "/ps4.ini");
+}
+
+// A game's per-game value of an option (3-character section, then the full ID), or empty.
+std::string GameOption(const std::string& game_id, const std::string& key)
+{
+  std::string value;
+  for (const std::string& id : {game_id.substr(0, 3), game_id})
+  {
+    const auto section = s_game_options.find(id);
+    if (section == s_game_options.end())
+      continue;
+    const auto it = section->second.find(key);
+    if (it != section->second.end())
+      value = it->second;
+  }
+  return value;
+}
