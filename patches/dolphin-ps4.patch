+      glBufferSubData(GL_UNIFORM_BUFFER, 0, size, data);
+    }
+    if (index >= 0)
+      glBindBufferBase(GL_UNIFORM_BUFFER, index, buffer);
+    std::memcpy(m_last, data, size);
+    m_last_size = size;
+    m_last_buffer = buffer;
+    return buffer;
+  }
+
+private:
+  u8 m_last[CAPACITY] = {};
+  u32 m_last_size = 0;
+  GLuint m_last_buffer = 0;
+  bool m_per_draw;
+  u32 m_count = 0;
+  u32 m_alloc_size = 0;
+  std::vector<GLuint> m_buffers;
+  std::vector<GLsync> m_fences;
+  GLuint m_oversized = 0;
+  u32 m_next = 0;
+  bool m_used = false;
