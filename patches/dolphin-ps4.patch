+// A demo achievement unlocks (host thread, while the game runs).
+void DemoUnlockNext()
+{
+  for (PS4Achievements::Entry& entry : s_demo_list.entries)
+  {
+    if (entry.unlocked)
+      continue;
+    entry.unlocked = true;
+    entry.unlock_time = static_cast<int64_t>(std::time(nullptr));
+    entry.progress.clear();
+    const std::string key = "U" + std::to_string(entry.id);
+    std::lock_guard lock(s_mutex);
+    s_badge_pixels[key] = DemoBadge(entry.id, false);
+    s_badge_textures.erase(key);
+    s_popups.push_back({entry.title, entry.description, key, entry.points, false});
+    break;
+  }
+  s_ach_dirty = true;
+}
