new file mode 100755
index 0000000..ffcbdde
--- /dev/null
+++ b/Source/Core/Core/HLE/HLE_PS4Games.cpp
@@ -0,0 +1,568 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// PS4 port: native versions of a few game routines that dominate the emulated CPU on the PS4's
+// 1.6 GHz Jaguar cores (ps4.ini game_hle=off disables them).
+//
+// Each hook replaces the inner loop of a game function - never a whole function, so the GX
+// library calls around it stay emulated - and is only installed when the game ID matches and
+// every instruction word of the loop is exactly the expected code (any other version or region
+// runs normally). The native loop performs the same memory reads and gather pipe writes in the
+// same order, leaves the registers the loop leaves (including dead temporaries, to be safe) and
+// continues at the loop's exit. It costs no emulated cycles: the game gets that CPU time for the
+// rest of its frame, like a faster CPU.
+
+#include "Core/HLE/HLE_PS4Games.h"
+
+#include <cstring>
+#include <span>
+
+#include "Common/CommonTypes.h"
+#include "Common/Logging/Log.h"
+#include "Common/Swap.h"
+#include "Core/ConfigManager.h"
+#include "Core/Core.h"
+#include "Core/HLE/HLE.h"
+#include "Core/HW/GPFifo.h"
+#include "Core/HW/Memmap.h"
+#include "Core/PowerPC/Interpreter/Interpreter_FPUtils.h"
+#include "Core/PowerPC/MMU.h"
+#include "Core/PowerPC/PowerPC.h"
+#include "Core/System.h"
+
+extern "C" int ps4_game_hle;
+int ps4_game_hle = 1;
+// game_hle_only=<name>: install only that hook (testing).
+extern "C" char ps4_game_hle_only[64];
+char ps4_game_hle_only[64] = "";
+namespace HLE_PS4Games
+{
+u32 ps4_hle_flushed = 0;
+}
+extern "C" void ps4_boot_trace(const char* stage);
+
+namespace HLE_PS4Games
+{
+namespace
+{
+// Guest memory: MEM1 through the default BATs (0x8xxxxxxx / 0xCxxxxxxx) directly, anything else
+// through the MMU.
+class Guest
+{
+public:
+  Guest(const Core::CPUThreadGuard& guard)
+      : m_guard(guard), m_system(guard.GetSystem()), m_ram(m_system.GetMemory().GetRAM()),
+        m_ram_size(m_system.GetMemory().GetRamSizeReal()), m_ppc(m_system.GetPPCState()),
+        m_gpfifo(m_system.GetGPFifo())
+  {
+  }
+
+  // The 4 bytes at `address` as stored (big-endian).
+  void ReadRaw32(u32 address, u8* out) const
+  {
+    const u32 segment = address >> 28;
+    const u32 offset = address & 0x0FFFFFFF;
+    if ((segment == 0x8 || segment == 0xC) && offset + 4 <= m_ram_size)
+    {
+      std::memcpy(out, m_ram + offset, 4);
+      return;
+    }
+    const u32 value = Common::swap32(PowerPC::MMU::HostRead<u32>(m_guard, address));
+    std::memcpy(out, &value, 4);
+  }
+
+  // Host pointer to [address, address + size) when it lies in MEM1, else nullptr.
+  const u8* Host(u32 address, u32 size) const
+  {
+    const u32 segment = address >> 28;
+    const u32 offset = address & 0x0FFFFFFF;
+    if ((segment == 0x8 || segment == 0xC) && offset <= m_ram_size && size <= m_ram_size - offset)
+      return m_ram + offset;
+    return nullptr;
+  }
+
+  // Copies `size` bytes of guest memory as stored (a multiple of 4).
+  void CopyGuest(u8* dst, u32 address, u32 size) const
+  {
+    if (const u8* src = Host(address, size))
+    {
+      std::memcpy(dst, src, size);
+      return;
+    }
+    for (u32 i = 0; i < size; i += 4)
+      ReadRaw32(address + i, dst + i);
+  }
+
+  bool Pipe() const { return m_pipe; }
+  u8*& PipePtr() { return m_ppc.gather_pipe_ptr; }
+
+  u32 Read32(u32 address) const
+  {
+    u8 raw[4];
+    ReadRaw32(address, raw);
+    u32 value;
+    std::memcpy(&value, raw, 4);
+    return Common::swap32(value);
+  }
+
+  s16 Read16s(u32 address) const
+  {
+    const u32 segment = address >> 28;
+    const u32 offset = address & 0x0FFFFFFF;
+    if ((segment == 0x8 || segment == 0xC) && offset + 2 <= m_ram_size)
+    {
+      u16 value;
+      std::memcpy(&value, m_ram + offset, 2);
+      return static_cast<s16>(Common::swap16(value));
+    }
+    return static_cast<s16>(PowerPC::MMU::HostRead<u16>(m_guard, address));
+  }
+
+  // The loops store to -0x8000(rX) with rX = 0xCC010000: the gather pipe. Any other rX (not seen)
+  // gets ordinary stores through the MMU.
+  void SetStoreBase(u32 base) { m_store = base - 0x8000; m_pipe = base == 0xCC010000; }
+
+  void PipeRaw32(const u8* bytes)
+  {
+    if (!m_pipe)
+    {
+      u32 value;
+      std::memcpy(&value, bytes, 4);
+      PowerPC::MMU::HostWrite<u32>(m_guard, Common::swap32(value), m_store);
+      return;
+    }
+    std::memcpy(m_ppc.gather_pipe_ptr, bytes, 4);
+    m_ppc.gather_pipe_ptr += 4;
+  }
+  void PipeMemory32(u32 address)
+  {
+    u8 raw[4];
+    ReadRaw32(address, raw);
+    PipeRaw32(raw);
+  }
+  void PipeValue32(u32 value)
+  {
+    const u32 be = Common::swap32(value);
+    PipeRaw32(reinterpret_cast<const u8*>(&be));
+  }
+  // Hands complete bursts to the command processor once a few have collected (the pipe buffer
+  // holds 512 bytes; callers write at most 64 bytes between checks).
+  //
+  // Returns true when the loop must stop for now: handing data to the command processor can
+  // raise the CP FIFO's high-watermark interrupt, which Dolphin delivers by ending the CPU's time
+  // slice (ForceExceptionCheck: downcount 0). The game's handler then waits for the GPU to catch
+  // up. A loop that kept going would overrun the FIFO (v02.55: 31 KB written in one call wrapped
+  // over data the GPU hadn't read). The caller then leaves the registers as the original loop has
+  // them at its head and continues there; the hook resumes after the interrupt.
+  bool PipeCheck()
+  {
+    if (m_pipe && m_ppc.gather_pipe_ptr - m_ppc.gather_pipe_base_ptr >= 256)
+    {
+      const u8* before = m_ppc.gather_pipe_ptr;
+      m_gpfifo.UpdateGatherPipe();
+      ps4_hle_flushed += static_cast<u32>(before - m_ppc.gather_pipe_ptr);
+      return m_ppc.downcount <= 0;
+    }
+    return false;
+  }
+
+  PowerPC::PowerPCState& ppc() { return m_ppc; }
+
+  // An lfs result: the single's bits as the double in both halves.
+  void SetFloatRegister(int reg, u32 address)
+  {
+    const u64 value = ConvertToDouble(Read32(address));
+    m_ppc.ps[reg].SetBoth(value, value);
+  }
+
+private:
+  const Core::CPUThreadGuard& m_guard;
+  Core::System& m_system;
+  u8* m_ram;
+  u32 m_ram_size;
+  PowerPC::PowerPCState& m_ppc;
+  GPFifo::GPFifoManager& m_gpfifo;
+  u32 m_store = 0;
+  bool m_pipe = true;
+};
+
+
+// -------------------------------------------------------------------------------------------
+// Crash Bandicoot: The Wrath of Cortex (GCBE7D)
+//
+// 0x800cb520 (submits skinned vertices, called with r3 = positions (24-byte stride),
+// r4 = count, r5 = attribute records (56 bytes), r6 = attribute indices):
+// loop A at 0x800cb5c4 - position, then normal, colour, texcoord through the index;
+// loop B at 0x800cb694 - position and a constant colour.
+}  // namespace
+
+// Diagnostics: the first calls of each hook log their inputs and output size.
+struct Snapshot
+{
+  u32 gpr[32];
+  u32 ctr;
+  u32 cr[8];
+  static Snapshot Of(PowerPC::PowerPCState& p)
+  {
+    Snapshot s;
+    std::memcpy(s.gpr, p.gpr, sizeof(s.gpr));
+    s.ctr = CTR(p);
+    for (int i = 0; i < 8; i++)
+      s.cr[i] = p.cr.GetField(i);
+    return s;
+  }
+};
+
+void LogCall(const char* name, int& calls, const Snapshot& in, PowerPC::PowerPCState& now,
+             u32 count, u32 base, const u8* pipe_before, u32 flushed_before)
+{
+  if (calls >= 4)
+    return;
+  calls++;
+  char line[512];
+  snprintf(line, sizeof(line),
+           "game HLE %s call %d: count %u base %08x r0 %08x r7 %08x r8 %08x r9 %08x r10 %08x "
+           "r11 %08x r28 %08x r29 %08x r30 %08x r31 %08x ctr %08x cr %x%x%x%x%x%x%x%x "
+           "pipe bytes %lld (+%u flushed)",
+           name, calls, count, base, in.gpr[0], in.gpr[7], in.gpr[8], in.gpr[9], in.gpr[10],
+           in.gpr[11], in.gpr[28], in.gpr[29], in.gpr[30], in.gpr[31], in.ctr, in.cr[0], in.cr[1],
+           in.cr[2], in.cr[3], in.cr[4], in.cr[5], in.cr[6], in.cr[7],
+           static_cast<long long>(now.gather_pipe_ptr - pipe_before),
+           ps4_hle_flushed - flushed_before);
+  ps4_boot_trace(line);
+}
+
+constexpr u32 CRASH_CB5C4 = 0x800cb5c4;
+constexpr u32 CRASH_CB5C4_EXIT = 0x800cb6b8;  // its "b" after the bdnz
+constexpr u32 CRASH_CB694 = 0x800cb694;
+constexpr u32 CRASH_CB694_EXIT = 0x800cb6b8;
+constexpr std::array<u32, 31> CRASH_CB5C4_CODE = {
+    0xc01f0000, 0xc1bf0004, 0xc19f0008, 0xd00b8000, 0x3bff0018, 0xd1ab8000, 0xd18b8000,
+    0x7d2aeaae, 0x1d290038, 0x7d29e214, 0xc1a90020, 0xc0090024, 0xc1890028, 0xd1ab8000,
+    0xd00b8000, 0xd18b8000, 0x7d2aeaae, 0x1d290038, 0x7d29e214, 0x8009002c, 0x900b8000,
+    0x7d2aeaae, 0x394a0002, 0x1d290038, 0x7d29e214, 0xc0090030, 0xc1a90034, 0xd00b8000,
+    0xd1ab8000, 0x4200ff8c, 0x4800007c};
+constexpr std::array<u32, 10> CRASH_CB694_CODE = {0xc01f0000, 0xc1bf0004, 0xc19f0008,
+                                                  0xd0098000, 0x3bff0018, 0xd1a98000,
+                                                  0xd1898000, 0x90098000, 0x4200ffe0,
+                                                  0x3860001a};
+
+void CrashLoopCB5C4(const Core::CPUThreadGuard& guard)
+{
+  Guest g(guard);
+  auto& ppc = g.ppc();
+  u32 positions = ppc.gpr[31];
+  u32 offset = ppc.gpr[10];
+  const u32 indices = ppc.gpr[29];
+  const u32 attributes = ppc.gpr[28];
+  u32 count = CTR(ppc);
+  u32 attribute = ppc.gpr[9];
+  u32 last_position = positions;
+  const u8* pipe_before = ppc.gather_pipe_ptr;
+  const u32 flushed_before = ps4_hle_flushed;
+  static int s_calls = 0;
+  const u32 log_count = CTR(ppc);
+  const Snapshot saved_for_log = Snapshot::Of(ppc);
+  g.SetStoreBase(ppc.gpr[11]);
+  if (count == 0)  // never: the function only enters the loop with a positive count
+  {
+    ppc.npc = CRASH_CB5C4_EXIT;
+    return;
+  }
+  if (g.Pipe())
+  {
+    // Fast path: per vertex, the position (12 bytes) and the attribute record's normal, colour
+    // and texcoord (24 contiguous bytes at +0x20) - two block copies into the pipe.
+    do
+    {
+      last_position = positions;
+      u8* dst = g.PipePtr();
+      g.CopyGuest(dst, positions, 12);
+      positions += 24;
+      attribute =
+          static_cast<u32>(static_cast<s32>(g.Read16s(offset + indices)) * 56) + attributes;
+      g.CopyGuest(dst + 12, attribute + 0x20, 24);
+      g.PipePtr() = dst + 36;
+      offset += 2;
+      if (g.PipeCheck() && count > 1)
+      {
+        count--;
+        break;  // yield at the loop head (see PipeCheck)
+      }
+    } while (--count != 0);
+  }
+  else
+  do
+  {
+    last_position = positions;
+    g.PipeMemory32(positions);
+    g.PipeMemory32(positions + 4);
+    g.PipeMemory32(positions + 8);
+    positions += 24;
+    attribute = static_cast<u32>(static_cast<s32>(g.Read16s(offset + indices)) * 56) + attributes;
+    g.PipeMemory32(attribute + 0x20);
+    g.PipeMemory32(attribute + 0x24);
+    g.PipeMemory32(attribute + 0x28);
+    g.PipeMemory32(attribute + 0x2c);
+    offset += 2;
+    g.PipeMemory32(attribute + 0x30);
+    g.PipeMemory32(attribute + 0x34);
+    if (g.PipeCheck() && count > 1)
+    {
+      count--;
+      break;  // yield at the loop head (see PipeCheck)
+    }
+  } while (--count != 0);
+
+  ppc.gpr[31] = positions;
+  ppc.gpr[10] = offset;
+  ppc.gpr[9] = attribute;
+  ppc.gpr[0] = g.Read32(attribute + 0x2c);
+  g.SetFloatRegister(0, attribute + 0x30);
+  g.SetFloatRegister(13, attribute + 0x34);
+  g.SetFloatRegister(12, attribute + 0x28);
+  (void)last_position;
+  CTR(ppc) = count;
+  ppc.npc = count != 0 ? CRASH_CB5C4 : CRASH_CB5C4_EXIT;
+  {
+    LogCall("cb5c4", s_calls, saved_for_log, ppc, log_count, saved_for_log.gpr[11], pipe_before, flushed_before);
+  }
+}
+
+void CrashLoopCB694(const Core::CPUThreadGuard& guard)
+{
+  Guest g(guard);
+  auto& ppc = g.ppc();
+  u32 positions = ppc.gpr[31];
+  u32 count = CTR(ppc);
+  const u32 colour = ppc.gpr[0];
+  const u8* pipe_before = ppc.gather_pipe_ptr;
+  const u32 flushed_before = ps4_hle_flushed;
+  static int s_calls = 0;
+  const u32 log_count = CTR(ppc);
+  const Snapshot saved_for_log = Snapshot::Of(ppc);
+  g.SetStoreBase(ppc.gpr[9]);
+  if (count == 0)
+  {
+    ppc.npc = CRASH_CB694_EXIT;
+    return;
+  }
+  u32 last = positions;
+  const u32 colour_be = Common::swap32(colour);
+  if (g.Pipe())
+  {
+    do
+    {
+      last = positions;
+      u8* dst = g.PipePtr();
+      g.CopyGuest(dst, positions, 12);
+      std::memcpy(dst + 12, &colour_be, 4);
+      g.PipePtr() = dst + 16;
+      positions += 24;
+      if (g.PipeCheck() && count > 1)
+      {
+        count--;
+        break;  // yield at the loop head (see PipeCheck)
+      }
+    } while (--count != 0);
+  }
+  else
+  do
+  {
+    last = positions;
+    g.PipeMemory32(positions);
+    g.PipeMemory32(positions + 4);
+    g.PipeMemory32(positions + 8);
+    positions += 24;
+    g.PipeValue32(colour);
+    if (g.PipeCheck() && count > 1)
+    {
+      count--;
+      break;  // yield at the loop head (see PipeCheck)
+    }
+  } while (--count != 0);
+
+  ppc.gpr[31] = positions;
+  g.SetFloatRegister(0, last);
+  g.SetFloatRegister(13, last + 4);
+  g.SetFloatRegister(12, last + 8);
+  CTR(ppc) = count;
+  ppc.npc = count != 0 ? CRASH_CB694 : CRASH_CB694_EXIT;
+  {
+    LogCall("cb694", s_calls, saved_for_log, ppc, log_count, saved_for_log.gpr[9], pipe_before, flushed_before);
+  }
+}
+
+// 0x800cae70 (submits indexed triangle strips; r30 = vertex records (36 bytes), r31 = strip
+// lengths and indices): the inner loop at 0x800caf2c writes position, normal, colour (one of
+// three sources, chosen by CR1/CR6/CR7 set before the loop) and texcoord per index.
+constexpr u32 CRASH_CAF2C = 0x800caf2c;
+constexpr u32 CRASH_CAF2C_EXIT = 0x800cafd0;
+constexpr std::array<u32, 41> CRASH_CAF2C_CODE = {
+    0xa93f0000, 0x1d290024, 0x7da9f42e, 0x7d29f214, 0xc1890008, 0xc0090004, 0xd1aa8000,
+    0xd00a8000, 0xd18a8000, 0xa93f0000, 0x1d290024, 0x7d29f214, 0xc1a9000c, 0xc1890014,
+    0xc0090010, 0xd1aa8000, 0xd00a8000, 0xd18a8000, 0xa93f0000, 0x1d290024, 0x7d29f214,
+    0x80090018, 0x40860008, 0x419a000c, 0x90ea8000, 0x48000014, 0x419e000c, 0x900a8000,
+    0x48000008, 0x916a8000, 0xa93f0000, 0x3bbdffff, 0x3bff0002, 0x3508ffff, 0x1d290024,
+    0x7d29f214, 0xc009001c, 0xc1a90020, 0xd00a8000, 0xd1aa8000, 0x4181ff60};
+
+void CrashLoopCAF2C(const Core::CPUThreadGuard& guard)
+{
+  Guest g(guard);
+  auto& ppc = g.ppc();
+  u32 list = ppc.gpr[31];
+  const u32 records = ppc.gpr[30];
+  u32 remaining = ppc.gpr[8];
+  u32 total = ppc.gpr[29];
+  const u32 colour_r7 = ppc.gpr[7];
+  const u32 colour_r11 = ppc.gpr[11];
+  const u8* pipe_before = ppc.gather_pipe_ptr;
+  const u32 flushed_before = ps4_hle_flushed;
+  static int s_calls = 0;
+  const u32 log_count = ppc.gpr[8];
+  const Snapshot saved_for_log = Snapshot::Of(ppc);
+  g.SetStoreBase(ppc.gpr[10]);
+  if (static_cast<s32>(remaining) <= 0)  // never: the loop is entered with a positive count
+  {
+    ppc.npc = CRASH_CAF2C_EXIT;
+    return;
+  }
+  constexpr u32 EQ = 0x2;  // CR field bits: LT 8, GT 4, EQ 2, SO 1
+  const bool cr1_eq = (ppc.cr.GetField(1) & EQ) != 0;
+  const bool cr6_eq = (ppc.cr.GetField(6) & EQ) != 0;
+  const bool cr7_eq = (ppc.cr.GetField(7) & EQ) != 0;
+  // bne cr1 -> r7; beq cr6 -> (beq cr7 -> r11 : vertex colour); else r7.
+  const int colour_source = (!cr1_eq || !cr6_eq) ? 0 : (cr7_eq ? 1 : 2);
+
+  u32 record = 0, last_colour = 0;
+  const u32 colour_r7_be = Common::swap32(colour_r7);
+  const u32 colour_r11_be = Common::swap32(colour_r11);
+  if (g.Pipe())
+  {
+    // Fast path: the record's position and normal (24 contiguous bytes), the colour, the
+    // texcoord (8 bytes at +0x1c) - all through the same index.
+    do
+    {
+      record = static_cast<u32>(static_cast<s32>(g.Read16s(list)) * 36) + records;
+      u8* dst = g.PipePtr();
+      g.CopyGuest(dst, record, 24);
+      if (colour_source == 0)
+        std::memcpy(dst + 24, &colour_r7_be, 4);
+      else if (colour_source == 1)
+        std::memcpy(dst + 24, &colour_r11_be, 4);
+      else
+        g.CopyGuest(dst + 24, record + 0x18, 4);
+      g.CopyGuest(dst + 28, record + 0x1c, 8);
+      g.PipePtr() = dst + 36;
+      total--;
+      list += 2;
+      remaining--;
+      if (g.PipeCheck() && static_cast<s32>(remaining) > 0)
+        break;  // yield at the loop head (see PipeCheck)
+    } while (static_cast<s32>(remaining) > 0);
+    last_colour = g.Read32(record + 0x18);
+  }
+  else
+  do
+  {
+    record = static_cast<u32>(static_cast<s32>(g.Read16s(list)) * 36) + records;
+    g.PipeMemory32(record + 0x00);
+    g.PipeMemory32(record + 0x04);
+    g.PipeMemory32(record + 0x08);
+    g.PipeMemory32(record + 0x0c);
+    g.PipeMemory32(record + 0x10);
+    g.PipeMemory32(record + 0x14);
+    last_colour = g.Read32(record + 0x18);
+    if (colour_source == 0)
+      g.PipeValue32(colour_r7);
+    else if (colour_source == 1)
+      g.PipeValue32(colour_r11);
+    else
+      g.PipeValue32(last_colour);
+    // The texcoord comes through the same index, read again by the game.
+    record = static_cast<u32>(static_cast<s32>(g.Read16s(list)) * 36) + records;
+    total--;
+    list += 2;
+    remaining--;
+    g.PipeMemory32(record + 0x1c);
+    g.PipeMemory32(record + 0x20);
+    if (g.PipeCheck() && static_cast<s32>(remaining) > 0)
+      break;  // yield at the loop head (see PipeCheck)
+  } while (static_cast<s32>(remaining) > 0);
+
+  ppc.gpr[31] = list;
+  ppc.gpr[29] = total;
+  ppc.gpr[8] = remaining;
+  ppc.gpr[9] = record;
+  ppc.gpr[0] = last_colour;
+  g.SetFloatRegister(0, record + 0x1c);
+  g.SetFloatRegister(13, record + 0x20);
+  g.SetFloatRegister(12, record + 0x14);
+  // subic. r8, r8, 1 (r8 was >= 1): carry set; result 0 (EQ, loop done) or positive (GT, the
+  // loop head follows - a yield).
+  constexpr u32 GT = 0x4;
+  ppc.cr.SetField(0, (remaining == 0 ? EQ : GT) | (ppc.GetXER_SO() ? 1 : 0));
+  ppc.SetCarry(1);
+  ppc.npc = remaining == 0 ? CRASH_CAF2C_EXIT : CRASH_CAF2C;
+  {
+    LogCall("caf2c", s_calls, saved_for_log, ppc, log_count, saved_for_log.gpr[10], pipe_before, flushed_before);
+  }
+}
+
+namespace
+{
+template <size_t N>
+bool CodeMatches(Core::System& system, u32 address, const std::array<u32, N>& code)
+{
+  auto& memory = system.GetMemory();
+  const u32 offset = address & 0x01FFFFFF;
+  if (offset + N * 4 > memory.GetRamSizeReal())
+    return false;
+  for (size_t i = 0; i < N; i++)
+  {
+    u32 word;
+    std::memcpy(&word, memory.GetRAM() + offset + i * 4, 4);
+    if (Common::swap32(word) != code[i])
+      return false;
+  }
+  return true;
+}
+}  // namespace
+
+const std::array<PS4Hook, 3> HOOKS = {{
+    {"PS4_Crash_cb5c4", CrashLoopCB5C4},
+    {"PS4_Crash_cb694", CrashLoopCB694},
+    {"PS4_Crash_caf2c", CrashLoopCAF2C},
+}};
+
+void PatchGame(Core::System& system)
+{
+  if (!ps4_game_hle)
+    return;
+  const std::string game_id = SConfig::GetInstance().GetGameID();
+  if (game_id != "GCBE7D")
+    return;
+  struct Site
+  {
+    u32 address;
+    const char* name;
+    bool ok;
+  };
+  const Site sites[] = {
+      {CRASH_CB5C4, "PS4_Crash_cb5c4", CodeMatches(system, CRASH_CB5C4, CRASH_CB5C4_CODE)},
+      {CRASH_CB694, "PS4_Crash_cb694", CodeMatches(system, CRASH_CB694, CRASH_CB694_CODE)},
+      {CRASH_CAF2C, "PS4_Crash_caf2c", CodeMatches(system, CRASH_CAF2C, CRASH_CAF2C_CODE)},
+  };
+  for (const Site& site : sites)
+  {
+    if (ps4_game_hle_only[0] && strcmp(ps4_game_hle_only, site.name) != 0)
+      continue;
+    if (site.ok)
+      HLE::Patch(system, site.address, site.name);
+    char line[160];
+    snprintf(line, sizeof(line), "game HLE: %s at %08x %s", site.name, site.address,
+             site.ok ? "installed" : "NOT installed (code differs)");
+    ps4_boot_trace(line);
+  }
+}
+}  // namespace HLE_PS4Games
