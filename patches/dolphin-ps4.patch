+      return m_oversized;
+    }
+    // Dolphin marks constants dirty far more often than they change: when the block is the
+    // same as the last upload, rebind that buffer (still intact: the ring only advances on
+    // uploads) instead of uploading again. Rebinding also undoes a utility draw's binding.
+    if (m_last_buffer && size == m_last_size && std::memcmp(m_last, data, size) == 0)
+    {
+      if (index >= 0)
+        glBindBufferBase(GL_UNIFORM_BUFFER, index, m_last_buffer);
+      return m_last_buffer;
+    }
+    // Fences only matter for unsynchronized maps: glBufferSubData already waits for (or copies
+    // around) a buffer the GPU still uses. They also cost kernel memory on Piglet: ~900 fences
+    // per second ran it out after ~5 minutes ("Internal Memory is running out").
