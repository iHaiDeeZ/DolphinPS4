+void Menu::OpenSettingPanel(int setting)
+{
+  m_panel = {};
+  m_panel.open = true;
+  m_panel.setting = setting;
+  switch (setting)
+  {
+  case SET_SOUNDS:
+    m_panel.title = "Sound Effects";
+    m_panel.options = {"On", "Off"};
+    m_panel.selected = m_prefs.sounds ? 0 : 1;
+    break;
+  case SET_VOLUME:
+    m_panel.title = "Volume";
+    for (int v = 100; v >= 0; v -= 10)
+      m_panel.options.push_back(std::to_string(v));
+    m_panel.selected = (100 - m_prefs.volume) / 10;
+    break;
+  case SET_LANGUAGE:
+  {
+    m_panel.title = "Language";
+    const auto& languages = PS4Lang::All();
+    for (size_t i = 0; i < languages.size(); i++)
+    {
+      m_panel.options.push_back(languages[i].name);
+      if (std::string(languages[i].code) == PS4Lang::Current().code)
+        m_panel.selected = static_cast<int>(i);
+    }
+    break;
+  }
+  case SET_STYLE:
+    m_panel.title = "Menu Style";
+    m_panel.options = {"Library", "XMB"};
+    m_panel.selected = Library() ? 0 : 1;
+    m_panel.lines = {"", "Library: your covers in a row,", "tabs switched with L1 / R1.", "",
+                     "XMB: the PSP-style columns."};
+    break;
+  case SET_CLOCK:
+    m_panel.title = "Clock";
+    m_panel.options = {"On", "Off"};
+    m_panel.selected = m_prefs.clock ? 0 : 1;
+    break;
+  case SET_CONTROLS:
+    m_panel.title = "Controls";
+    m_panel.options = {PS4Controls::DeviceName(PS4Controls::Device::GameCube),
+                       PS4Controls::DeviceName(PS4Controls::Device::Wii)};
+    break;
+  case SET_COVERS:
+    m_panel.title = "Download Covers";
+    StartCoverDownload();
+    break;
+  case SET_GAMES_DIR:
+    OpenFolderBrowser(GamesFolder());
+    return;
+  case SET_CENTER:
+    OpenCenterPage();
+    return;
+  case SET_ACHIEVEMENTS:
+    OpenAchievementsPage();
+    return;
+  case SET_WIIMENU:
+    OpenWiiMenuPage();
+    return;
+  case SET_UPDATE_CHECK:
+    m_panel.setting = SET_UPDATE;
+    StartUpdateCheck(true);
+    ShowUpdatePanel();
+    break;
+  case SET_AUTO_UPDATE:
+    m_panel.title = "Automatic Updates";
+    m_panel.options = {"On", "Off"};
+    m_panel.selected = m_prefs.auto_update ? 0 : 1;
+    m_panel.lines = {"", "Looks for a new version on GitHub", "when the app opens, and asks",
+                     "before installing it."};
+    break;
+  case SET_RESET_ALL:
+    m_panel.title = "Reset All Settings";
+    m_panel.options = {"Cancel", "Reset everything"};
+    m_panel.lines = {"", "All games, global and per game,", "go back to the default settings."};
+    break;
+  case SET_ABOUT:
+    m_panel.title = "About";
+    m_panel.lines = {"Dolphin for PS4",
+                     "GameCube and Wii emulator",
+                     "Ported to PS4 by ShiroKlein",
+                     "Version " + m_version + InstalledPackageNote(),
+                     "",
+                     "Games: " + m_data_dir + "/games",
+                     "Wallpapers (PNG): " + m_data_dir + "/themes",
+                     "Sounds (WAV): " + m_data_dir + "/themes/sounds",
+                     "",
+                     "Dolphin is free software (GPLv2+).",
+                     "Font: Nunito (SIL Open Font License)."};
+    break;
+  default:
+    if (setting >= SET_GROUP &&
+        setting < SET_GROUP + static_cast<int>(PS4Settings::Categories().size()))
+    {
+      OpenSettingsList(PS4Settings::Categories()[setting - SET_GROUP], {});
+      return;
+    }
+    m_panel.open = false;
+  }
+}
+
+// A settings list: one category of the global settings, or every setting of one game (with
+// "Apply To" first: all games = the game follows the global settings, this game = its own).
+void Menu::OpenSettingsList(const std::string& category, const std::string& game_id)
+{
+  m_panel = {};
+  m_panel.open = true;
+  m_panel.category = category;
+  m_panel.game_id = game_id;
+  m_panel.title = category.empty() ? "Game Settings" : category;
+  BuildSettingRows();
+  m_panel.selected = 0;
+  MoveSettingRow(0);
+}
+
+void Menu::BuildSettingRows()
+{
+  std::vector<SettingRow> rows;
+  const std::string& game = m_panel.game_id;
+  if (!game.empty() && CenterFor(game))
+  {
+    SettingRow row{"Recommended Settings",
+                   PS4Center::Choice(game) == "no" ? "Not used" : "Used", "center:this"};
+    row.tag = PS4Center::Choice(game) == "no" ? -1 : 1;
+    rows.push_back(std::move(row));
+  }
+  if (!game.empty())
+  {
+    rows.push_back({"Apply To", PS4Settings::IsCustom(game) ? "This Game" : "All Games", "", false,
+                    true});
+  }
+  // A GameCube game's own settings leave out the Wii ones (they don't apply to it).
+  bool gamecube_game = false;
+  for (const Game& entry : m_games)
+  {
+    if (!game.empty() && entry.id == game)
+    {
+      gamecube_game = !entry.wii && !entry.wad;
+      break;
+    }
+  }
+  static const std::set<std::string> WII_ONLY = {
+      "wii_extension", "wii_sideways", "wii_upright", "wii_tilt", "motion_controls", "wii_pointer",
+      "wii_controller",
+      "wii_input",
+      "sd_card",       "sd_sync",      "sd_writes",       "sd_size"};
+  for (const char* category : PS4Settings::Categories())
+  {
+    if (!m_panel.category.empty() && m_panel.category != category)
+      continue;
+    if (m_panel.category.empty())
+      rows.push_back({category, "", "", true});
+    for (const PS4Settings::Setting& setting : PS4Settings::All())
+    {
+      if (std::string(setting.category) != category)
+        continue;
+      if (gamecube_game && WII_ONLY.count(setting.key))
+        continue;
+      rows.push_back({setting.label,
+                      PS4Settings::LabelOf(setting, PS4Settings::Get(setting.key, game)),
+                      setting.key, false, false, !setting.live});
+    }
+  }
+  rows.push_back({"", "", "", true});
+  rows.push_back({game.empty() ? "Reset to Defaults" : "Reset This Game", "", "__reset__"});
+  m_panel.rows = std::move(rows);
+}
+
+// Moves the selection by direction (0: onto the nearest selectable row), skipping headers.
+void Menu::MoveSettingRow(int direction)
+{
+  const int count = static_cast<int>(m_panel.rows.size());
+  int row = std::clamp(m_panel.selected + direction, 0, std::max(0, count - 1));
+  const int step = direction < 0 ? -1 : 1;
+  while (row >= 0 && row < count && m_panel.rows[row].header)
+    row += step;
+  if (row >= 0 && row < count)
+    m_panel.selected = row;
+}
+
+void Menu::ChangeSettingRow(int direction)
+{
+  // 2: Cross (a capture on Hotkeys rows), otherwise the same as Right.
+  const bool cross = direction == 2;
+  if (cross)
+    direction = 1;
+  if (m_panel.selected < 0 || m_panel.selected >= static_cast<int>(m_panel.rows.size()))
+    return;
+  if (m_panel.setting == SET_ACHVIEW)
+    return;  // a list to read
+  if (m_panel.setting == SET_WIIMENU)
+  {
+    static const char* const REGIONS[] = {"USA", "EUR", "JPN", "KOR"};
+    const std::string key = m_panel.rows[m_panel.selected].key;
+    if (key == "wm:region" && !m_nus_busy)
+    {
+      m_nus_region = (m_nus_region + (direction < 0 ? 3 : 1)) % 4;
+    }
+    else if (key == "wm:update" && !m_nus_busy && !m_nus_thread.joinable())
+    {
+      m_nus_busy = true;
+      m_nus_cancel = false;
+      m_nus_done = 0;
+      m_nus_total = 0;
+      m_nus_result.clear();
+      const std::string region = REGIONS[m_nus_region];
+      Log("wii menu: online update, region " + region);
+      m_nus_thread = std::thread([this, region] {
+        const WiiUtils::UpdateResult result = WiiUtils::DoOnlineUpdate(
+            [this](size_t done, size_t total, u64) {
+              m_nus_done = done;
+              m_nus_total = total;
+              return !m_nus_cancel.load();
+            },
+            region);
+        switch (result)
+        {
+        case WiiUtils::UpdateResult::Succeeded:
+          m_nus_result = "Installed";
+          break;
+        case WiiUtils::UpdateResult::AlreadyUpToDate:
+          m_nus_result = "Already up to date";
+          break;
+        case WiiUtils::UpdateResult::ServerFailed:
+          m_nus_result = "Nintendo's server didn't answer";
+          break;
+        case WiiUtils::UpdateResult::DownloadFailed:
+          m_nus_result = "A download failed";
+          break;
+        case WiiUtils::UpdateResult::ImportFailed:
+          m_nus_result = "Installing a title failed";
+          break;
+        case WiiUtils::UpdateResult::Cancelled:
+          m_nus_result = "Cancelled";
+          break;
+        default:
+          m_nus_result = "Failed";
+          break;
+        }
+        if (result == WiiUtils::UpdateResult::Succeeded ||
+            result == WiiUtils::UpdateResult::AlreadyUpToDate)
+        {
+          // Online play's certificates (Wiimmfi's login), from the installed IOS13.
+          Log(std::string("wii menu: online certificates ") +
+              (DiscIO::NANDImporter().ExtractCertificates() ? "extracted" : "not found"));
+        }
+        m_nus_busy = false;
+      });
+    }
+    else if (key == "wm:menu" && TitleInstalled("00000001/00000002"))
+    {
+      m_direct_launch = "nand:0000000100000002";
+      Play("launch");
+    }
+    else if (key == "wm:mii" && TitleInstalled("00010002/48414341"))
+    {
+      m_direct_launch = "nand:0001000248414341";
+      Play("launch");
+    }
+    BuildWiiMenuRows();
+    return;
+  }
+  if (m_panel.setting == SET_ACHIEVEMENTS)
+  {
+    const std::string key = m_panel.rows[m_panel.selected].key;
+    if (key == "ra:user")
+    {
+      StartKeyboard(1, "RetroAchievements username", RaGet("Username"), false);
+    }
+    else if (key == "ra:login" && !m_ra_busy)
+    {
+      if (RaGet("Username").empty())
+        m_ra_status = "Set the username first";
+      else
+        StartKeyboard(2, "RetroAchievements password", "", true);
+    }
+    else if (key == "ra:logout")
+    {
+      RaSet("ApiToken", "");
+      m_ra_status = "Logged out";
+      Log("retroachievements: logged out");
+      BuildItems();
+    }
+    else if (key == "ra:demo")
+    {
+      const std::string flag = m_data_dir + "/achievements-demo";
+      if (std::filesystem::exists(flag))
+      {
+        std::error_code error;
+        std::filesystem::remove(flag, error);
+      }
+      else
+      {
+        File::WriteStringToFile(flag, "Achievements demo mode (Settings -> RetroAchievements)\n");
+      }
+      Log(std::string("retroachievements: demo mode ") +
+          (std::filesystem::exists(flag) ? "on" : "off"));
+    }
+    else if (key == "ra:enabled")
+    {
+      RaSet("Enabled", RaGet("Enabled") == "True" ? "False" : "True");
+    }
+    else if (key == "ra:hardcore")
+    {
+      RaSet("HardcoreEnabled", RaGet("HardcoreEnabled") == "True" ? "False" : "True");
+    }
+    BuildAchievementRows();
+    return;
+  }
+  const SettingRow& row = m_panel.rows[m_panel.selected];
+  const std::string& game = m_panel.game_id;
+  if (row.key == "center:update")
+  {
+    if (direction > 0 && !m_settings_busy && !m_settings_thread.joinable())
+      FetchGameSettings();
+    BuildCenterRows();
+    return;
+  }
+  if (row.key.rfind("center:game:", 0) == 0)
+  {
+    const size_t i = std::strtoul(row.key.c_str() + 12, nullptr, 10);
+    if (i < m_games.size())
+    {
+      PS4Center::SetChoice(m_games[i].id, PS4Center::Choice(m_games[i].id) == "no");
+      Log("game settings center: " + m_games[i].id + " " + PS4Center::Choice(m_games[i].id));
+    }
+    BuildCenterRows();
+    return;
+  }
+  if (row.key == "center:this")
+  {
+    PS4Center::SetChoice(game, PS4Center::Choice(game) == "no");
+    BuildSettingRows();
+    return;
+  }
+  if (row.key == "center:info")
+    return;
+  if (m_panel.setting == SET_MEMCARD)
+  {
+    // Cross on "Put in Slot A"; the saves are only shown (their details below the list).
+    if (direction > 0 && row.key == "card:use" && m_card_panel >= 0 &&
+        m_card_panel < static_cast<int>(m_cards.size()))
+    {
+      m_slot_a = m_cards[m_card_panel].name;
+      PS4MemoryCards::SetSlotA(m_data_dir, m_slot_a);
+      Log("memory cards: " + m_slot_a + " in Slot A");
+      BuildItems();
+      const int selected = m_panel.selected;
+      OpenCardPanel(m_card_panel);
+      m_panel.selected = selected;
+      MoveSettingRow(0);
+      Play("confirm");
+    }
+    return;
+  }
+  if (m_panel.setting == SET_GAMES_DIR)
+  {
+    if (direction <= 0)
+      return;  // Cross only (Left / Right do nothing here)
+    if (row.key.rfind("dir:", 0) == 0)
+    {
+      OpenFolderBrowser(row.key.substr(4));
+    }
+    else if (row.key == "usedir")
+    {
+      m_prefs.games_dir = m_browse_dir == m_data_dir + "/games" ? "" : m_browse_dir;
+      m_prefs.Save(m_data_dir + "/xmb.ini");
+      m_panel.open = false;
+      RefreshGames();
+      Play("confirm");
+    }
+    return;
+  }
+  if (row.key == "__ctlscope__")
+  {
+    // This Game: its own layout, starting from the normal one. All Games: back to the normal.
+    if (PS4Controls::HasGameProfile(m_controls_game))
+    {
+      PS4Controls::DeleteGameProfile(m_controls_game);
+      PS4Controls::EditGame("");
+    }
+    else
+    {
+      PS4Controls::CreateGameProfile(m_controls_game);
+      PS4Controls::EditGame(m_controls_game);
+    }
+    Log("controls: " + m_controls_game +
+        (PS4Controls::HasGameProfile(m_controls_game) ? " own layout" : " normal layout"));
+    BuildControlRows();
+    return;
+  }
+  if (row.key.rfind("ctl:", 0) == 0 || row.key == "__ctlreset__")
+  {
+    const auto device = static_cast<PS4Controls::Device>(m_controls_device);
+    if (row.key == "__ctlreset__")
+    {
+      if (direction > 0)
+        PS4Controls::ResetToDefault(device);
+      BuildControlRows();
+      return;
+    }
+    const auto& binding = PS4Controls::Bindings(device)[std::atoi(row.key.c_str() + 4)];
+    if (binding.stick_group)
+    {
+      // Sticks: Left Stick / Right Stick / D-Pad.
+      const auto choices = PS4Controls::StickChoices();
+      const std::string current = PS4Controls::Get(device, binding);
+      int index = 0;
+      for (size_t i = 0; i < choices.size(); i++)
+      {
+        if (choices[i] == current)
+          index = static_cast<int>(i);
+      }
+      const int count = static_cast<int>(choices.size());
+      index = ((index + direction) % count + count) % count;
+      PS4Controls::Set(device, binding, choices[index]);
+      BuildControlRows();
+    }
+    else if (direction > 0)
+    {
+      // Buttons: wait for the next press (UpdateCapture).
+      m_capture = true;
+      m_capture_released = false;
+      m_capture_time = 0.0f;
+      m_capture_row = m_panel.selected;
+    }
+    return;
+  }
+  if (row.key.rfind("cheat:", 0) == 0)
+  {
+    m_cheats.Toggle(static_cast<size_t>(std::atoi(row.key.c_str() + 6)));
+    BuildCheatRows();
+    return;
+  }
+  if (row.key.rfind("cheatall:", 0) == 0)
+  {
+    m_cheats.SetAll(row.key == "cheatall:on");
+    BuildCheatRows();
+    return;
+  }
+  if (row.key == "cheatdl")
+  {
+    if (m_cheat_dl_busy || direction <= 0)
+      return;
+    if (m_cheat_dl_thread.joinable())
+      m_cheat_dl_thread.join();
+    m_cheat_dl_busy = true;
+    m_cheat_dl_done = false;
+    const std::string game = m_cheats_game;
+    m_cheat_dl_thread = std::thread([this, game] {
+      m_cheat_dl = PS4Cheats::List::FetchOnline(game);
+      m_cheat_dl_done = true;
+    });
+    BuildCheatRows();
+    return;
+  }
+  if (row.key.rfind("riiv:", 0) == 0)
+  {
+    // riiv:<mod>:<section>:<option>: Off (0) and the option's choices (1-based), in turn.
+    size_t mod = 0, section = 0, option = 0;
+    if (std::sscanf(row.key.c_str() + 5, "%zu:%zu:%zu", &mod, &section, &option) == 3 &&
+        mod < m_riivolution.size() && section < m_riivolution[mod].m_sections.size() &&
+        option < m_riivolution[mod].m_sections[section].m_options.size())
+    {
+      auto& o = m_riivolution[mod].m_sections[section].m_options[option];
+      const int count = static_cast<int>(o.m_choices.size()) + 1;
+      const int next = ((static_cast<int>(o.m_selected_choice) + direction) % count + count) % count;
+      o.m_selected_choice = static_cast<u32>(next);
+      SaveRiivolutionConfig();
+      BuildRiivolutionRows();
+    }
+    return;
+  }
+  if (row.scope)
+  {
+    PS4Settings::SetCustom(game, !PS4Settings::IsCustom(game));
+  }
+  else if (row.key == "__reset__")
+  {
+    // A game: it follows the global settings again. A category: its global values go back to
+    // ps4.ini's tuned defaults.
+    if (direction <= 0)
+      return;
+    if (!game.empty())
+    {
+      PS4Settings::ResetGame(game);
+    }
+    else
+    {
+      for (const PS4Settings::Setting& setting : PS4Settings::All())
+      {
+        if (m_panel.category == setting.category)
+          PS4Settings::ResetGlobal(setting.key);
+      }
+    }
+  }
+  else if (!row.key.empty())
+  {
+    const PS4Settings::Setting* setting = PS4Settings::Find(row.key);
+    if (!setting)
+      return;
+    if (PS4Settings::IsHotkey(row.key) && cross)
+    {
+      m_combo_key = row.key;
+      m_combo_seen = 0;
+      m_combo_armed = false;
+      m_combo_time = 0.0f;
+      return;
+    }
+    // A game following the global settings: changing one of its values makes it custom
+    // (hotkeys are the same for every game).
+    if (!game.empty() && !PS4Settings::IsCustom(game) && !PS4Settings::IsHotkey(row.key))
+      PS4Settings::SetCustom(game, true);
+    PS4Settings::Set(row.key, PS4Settings::Step(*setting, PS4Settings::Get(row.key, game), direction),
+                     game);
+    if (row.key == "language")
+      SetLanguage(PS4Settings::Get("language"));
+  }
+  BuildSettingRows();
+}
+
+void Menu::OpenControlsList(PS4Controls::Device device, const std::string& game_id)
+{
+  m_panel = {};
+  m_panel.open = true;
+  m_panel.title = PS4Controls::DeviceName(device);
+  m_controls_device = static_cast<int>(device);
+  m_controls_game = game_id;
+  PS4Controls::EditGame(PS4Controls::HasGameProfile(game_id) ? game_id : "");
+  BuildControlRows();
+  m_panel.selected = 0;
+}
+
+void Menu::BuildControlRows()
+{
+  const auto device = static_cast<PS4Controls::Device>(m_controls_device);
+  std::vector<SettingRow> rows;
+  const auto& bindings = PS4Controls::Bindings(device);
+  if (!m_controls_game.empty())
+  {
+    rows.push_back({"Apply To",
+                    PS4Controls::HasGameProfile(m_controls_game) ? "This Game" : "All Games",
+                    "__ctlscope__", false, true});
+  }
+  for (size_t i = 0; i < bindings.size(); i++)
+  {
+    const std::string value = PS4Controls::Get(device, bindings[i]);
+    SettingRow row{bindings[i].label,
+                   bindings[i].stick_group ? value : PS4Controls::Describe(value),
+                   "ctl:" + std::to_string(i)};
+    row.glyph = value;
+    rows.push_back(std::move(row));
+  }
+  rows.push_back({"", "", "", true});
+  rows.push_back({"Reset to Default", "", "__ctlreset__"});
+  m_panel.rows = std::move(rows);
+}
+
+void Menu::OpenCheatsList(const Game& game)
+{
+  m_panel = {};
+  m_panel.open = true;
+  m_panel.title = "Cheats";
+  m_cheats_game = game.id;
+  m_cheats.Load(game.id, game.revision);
+  BuildCheatRows();
+  if (m_panel.rows.empty())
+    m_panel.lines = {"", "No cheats for this game.", "",
+                     "Dolphin's cheat database has none for " + game.id + "."};
+  m_panel.selected = 0;
+  MoveSettingRow(0);
+}
