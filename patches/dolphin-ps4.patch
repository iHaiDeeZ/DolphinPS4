+#ifdef __ORBIS__
+// Port measurement: what does each way of updating a 4 KiB uniform block (the size of Dolphin's
+// vertex constants) cost on Piglet, when each update is followed by a draw that reads it, as in
+// a game frame? Runs once at startup (~1 s) and logs microseconds per update + draw.
+static GLuint PS4BenchProgram(const char* vs_source, const char* fs_source = nullptr)
+{
+  if (!fs_source)
+    fs_source = "#version 300 es\nprecision mediump float;\nout vec4 c;\nvoid main() { c = "
+                "vec4(1.0); }\n";
+  const GLuint vs = glCreateShader(GL_VERTEX_SHADER);
+  glShaderSource(vs, 1, &vs_source, nullptr);
+  glCompileShader(vs);
+  const GLuint fs = glCreateShader(GL_FRAGMENT_SHADER);
+  glShaderSource(fs, 1, &fs_source, nullptr);
+  glCompileShader(fs);
+  const GLuint program = glCreateProgram();
+  glAttachShader(program, vs);
+  glAttachShader(program, fs);
+  glLinkProgram(program);
+  glDeleteShader(vs);
+  glDeleteShader(fs);
+  GLint linked = 0;
+  glGetProgramiv(program, GL_LINK_STATUS, &linked);
+  return linked ? program : 0;
+}
+
+static void PS4BenchmarkUniformUploads()
+{
+  constexpr int N = 200, RING = 256;
+  constexpr GLsizeiptr SIZE = 4112, VEC4S = 200;
+  // Points far outside the clip volume: the vertex shader runs and reads the block, nothing is
+  // rasterized.
+  const GLuint block_program = PS4BenchProgram(
+      "#version 300 es\nlayout(std140) uniform B { vec4 v[257]; };\n"
+      "void main() { gl_PointSize = 1.0; gl_Position = vec4(3.0 + v[gl_VertexID % 257].x, 3.0, "
+      "0.0, 1.0); }\n");
+  const GLuint plain_program = PS4BenchProgram(
+      "#version 300 es\nuniform vec4 u[200];\n"
+      "void main() { gl_PointSize = 1.0; gl_Position = vec4(3.0 + u[gl_VertexID % 200].x, 3.0, "
+      "0.0, 1.0); }\n");
+  if (!block_program || !plain_program)
+  {
+    ps4_boot_trace("uniform benchmark: programs failed to link");
+    return;
+  }
+  glUniformBlockBinding(block_program, glGetUniformBlockIndex(block_program, "B"), 6);
+  const GLint plain_location = glGetUniformLocation(plain_program, "u");
+
+  GLuint vao = 0;
+  glGenVertexArrays(1, &vao);
+  glBindVertexArray(vao);
+  GLuint ring[RING];
+  glGenBuffers(RING, ring);
+  for (GLuint buffer : ring)
+  {
+    glBindBuffer(GL_UNIFORM_BUFFER, buffer);
+    glBufferData(GL_UNIFORM_BUFFER, SIZE, nullptr, GL_DYNAMIC_DRAW);
+  }
+  static float data[SIZE / 4];
+  for (size_t i = 0; i < SIZE / 4; i++)
+    data[i] = static_cast<float>(i % 7) / 7.0f;
+
+  const auto map_upload = [&](GLuint buffer, GLbitfield flags) {
+    glBindBuffer(GL_UNIFORM_BUFFER, buffer);
+    if (void* mapped = glMapBufferRange(GL_UNIFORM_BUFFER, 0, SIZE, GL_MAP_WRITE_BIT | flags))
+    {
+      std::memcpy(mapped, data, SIZE);
+      glUnmapBuffer(GL_UNIFORM_BUFFER);
+    }
+  };
+  struct Method
+  {
+    const char* name;
+    std::function<void(int)> update;
+    bool plain;
+  };
+  const Method methods[] = {
+      {"draw only", [&](int) {}, false},
+      {"subdata ring", [&](int i) {
+         glBindBuffer(GL_UNIFORM_BUFFER, ring[i % RING]);
+         glBufferSubData(GL_UNIFORM_BUFFER, 0, SIZE, data);
+         glBindBufferBase(GL_UNIFORM_BUFFER, 6, ring[i % RING]);
+       }, false},
+      {"subdata same", [&](int) {
+         glBindBuffer(GL_UNIFORM_BUFFER, ring[0]);
+         glBufferSubData(GL_UNIFORM_BUFFER, 0, SIZE, data);
+         glBindBufferBase(GL_UNIFORM_BUFFER, 6, ring[0]);
+       }, false},
+      {"subdata 64B", [&](int) {
+         glBindBuffer(GL_UNIFORM_BUFFER, ring[0]);
+         glBufferSubData(GL_UNIFORM_BUFFER, 0, 64, data);
+         glBindBufferBase(GL_UNIFORM_BUFFER, 6, ring[0]);
+       }, false},
+      {"map unsync ring", [&](int i) {
+         map_upload(ring[i % RING], GL_MAP_UNSYNCHRONIZED_BIT);
+         glBindBufferBase(GL_UNIFORM_BUFFER, 6, ring[i % RING]);
+       }, false},
+      {"map sync ring", [&](int i) {
+         map_upload(ring[i % RING], 0);
+         glBindBufferBase(GL_UNIFORM_BUFFER, 6, ring[i % RING]);
+       }, false},
+      {"map orphan same", [&](int) {
+         map_upload(ring[0], GL_MAP_INVALIDATE_BUFFER_BIT);
+         glBindBufferBase(GL_UNIFORM_BUFFER, 6, ring[0]);
+       }, false},
+      {"bufferdata same", [&](int) {
+         glBindBuffer(GL_UNIFORM_BUFFER, ring[0]);
+         glBufferData(GL_UNIFORM_BUFFER, SIZE, data, GL_STREAM_DRAW);
+         glBindBufferBase(GL_UNIFORM_BUFFER, 6, ring[0]);
+       }, false},
+      {"glUniform4fv 3.2K", [&](int) { glUniform4fv(plain_location, VEC4S, data); }, true},
+  };
+  char line[512];
+  int len = snprintf(line, sizeof(line), "uniform benchmark (us per update + draw):");
+  for (const Method& method : methods)
+  {
+    glUseProgram(method.plain ? plain_program : block_program);
+    glFinish();
+    const auto start = std::chrono::steady_clock::now();
+    for (int i = 0; i < N; i++)
+    {
+      method.update(i);
+      glDrawArrays(GL_POINTS, 0, 1);
+    }
+    glFinish();
+    const double us =
+        std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() - start)
+            .count() / N;
+    len += snprintf(line + len, sizeof(line) - len, " %s %.1f;", method.name, us);
+  }
+  ps4_boot_trace(line);
+
+  glBindBufferBase(GL_UNIFORM_BUFFER, 6, 0);
+  glBindBuffer(GL_UNIFORM_BUFFER, 0);
+  glDeleteBuffers(RING, ring);
+  glBindVertexArray(0);
+  glDeleteVertexArrays(1, &vao);
+  glUseProgram(0);
+  glDeleteProgram(block_program);
+  glDeleteProgram(plain_program);
+}
