+// The files Dolphin reads (the normal layout, or a game's while that game runs).
+std::string LivePath(Device device)
+{
+  return s_user_dir + (device == Device::GameCube ? "/Config/GCPadNew.ini" :
+                                                    "/Config/WiimoteNew.ini");
+}
+
+std::string ProfileDir()
+{
+  return s_user_dir + "/Config/PS4Controls";
+}
+
+std::string GamePath(Device device, const std::string& game_id)
+{
+  return ProfileDir() + "/" + game_id + (device == Device::GameCube ? "-GCPad.ini" : "-Wiimote.ini");
+}
+
+// The normal layout while a game's own is in place.
+std::string BackupPath(Device device)
+{
+  return ProfileDir() + (device == Device::GameCube ? "/_normal-GCPad.ini" : "/_normal-Wiimote.ini");
+}
+
+std::string Path(Device device)
+{
+  return s_edit_game.empty() ? LivePath(device) : GamePath(device, s_edit_game);
+}
+
+bool Exists(const std::string& path)
+{
+  struct stat st;
+  return stat(path.c_str(), &st) == 0;
+}
+
+// Shake groups ("Shake", "Nunchuk/Shake") are three keys with the same input.
+bool IsShake(const Binding& binding)
+{
+  const std::string key = binding.key;
+  return key == "Shake" || key == "Nunchuk/Shake";
+}
+
+const char* Section(Device device)
+{
+  return device == Device::GameCube ? "GCPad1" : "Wiimote1";
+}
+
+// The four directions of a stick group, for each choice.
+struct StickChoice
+{
+  const char* name;
+  const char* up;
+  const char* down;
+  const char* left;
+  const char* right;
+};
+constexpr StickChoice STICKS[] = {
+    {"Left Stick", "`Left Y-`", "`Left Y+`", "`Left X-`", "`Left X+`"},
+    {"Right Stick", "`Right Y-`", "`Right Y+`", "`Right X-`", "`Right X+`"},
+    {"D-Pad", "`Pad N`", "`Pad S`", "`Pad W`", "`Pad E`"},
+};
+
+std::string ReadAll(const std::string& path)
+{
+  std::string text;
+  if (FILE* file = fopen(path.c_str(), "rb"))
+  {
+    char buffer[4096];
+    size_t got;
+    while ((got = fread(buffer, 1, sizeof(buffer), file)) > 0)
+      text.append(buffer, got);
+    fclose(file);
+  }
+  return text;
+}
+
+// Writes path only when its text changes, through path.new flushed to disk first: a power cut
+// (holding the power button on a frozen console) left GCPadNew.ini empty - no game input at all.
+void SaveIni(Common::IniFile& ini, const std::string& path)
+{
+  const std::string temp = path + ".new";
+  if (!ini.Save(temp))
+    return;
+  if (ReadAll(temp) == ReadAll(path))
+  {
+    std::remove(temp.c_str());
+    return;
+  }
+  const int fd = open(temp.c_str(), O_RDWR);
+  if (fd >= 0)
+  {
+    fsync(fd);
+    close(fd);
+  }
+  std::rename(temp.c_str(), path.c_str());
+}
+
+// Missing, empty, or player 1 without a device or button A (cut short by a power cut; the Wii
+// Remote setup then rebuilt the file around an empty player 1, and players 2-4 still had their
+// devices): the defaults.
+void WriteIfMissing(const std::string& path, const char* contents, const std::string& first)
+{
+  Common::IniFile ini;
+  ini.Load(path);
+  if (const Common::IniFile::Section* section = ini.GetSection(first))
+  {
+    std::string device, button_a;
+    section->Get("Device", &device);
+    section->Get("Buttons/A", &button_a);
+    if (!device.empty() && !button_a.empty())
+      return;
+  }
+  const std::string temp = path + ".new";
+  if (FILE* file = fopen(temp.c_str(), "w"))
+  {
+    fputs(contents, file);
+    fflush(file);
+    fsync(fileno(file));
+    fclose(file);
+    std::rename(temp.c_str(), path.c_str());
+  }
+}
+
+std::string Strip(std::string text)
+{
+  std::string out;
+  for (char c : text)
+  {
+    if (c != '`')
+      out += c;
+  }
+  return out;
+}
+}  // namespace
+
+const std::vector<Binding>& Bindings(Device device)
+{
+  return device == Device::GameCube ? GC_BINDINGS : WII_BINDINGS;
+}
+
+const char* DefaultsText(Device device)
+{
+  return device == Device::GameCube ? GCPAD_DEFAULTS : WIIMOTE_DEFAULTS;
+}
+
+const char* DeviceName(Device device)
+{
+  return device == Device::GameCube ? "GameCube Controller" : "Wii Remote + Nunchuk";
+}
+
+void SetUserDirectory(const std::string& user_dir)
+{
+  s_user_dir = user_dir;
+}
+
+void WriteDefaultsIfMissing()
+{
+  mkdir(s_user_dir.c_str(), 0777);
+  mkdir((s_user_dir + "/Config").c_str(), 0777);
+  mkdir(ProfileDir().c_str(), 0777);
+  // Layouts from before the Nunchuk shake input: L3, which nothing else uses in Wii games.
+  {
+    Common::IniFile ini;
+    if (ini.Load(LivePath(Device::Wii)))
+    {
+      Common::IniFile::Section* section = ini.GetSection("Wiimote1");
+      std::string shake;
+      if (section && !section->Get("Nunchuk/Shake/X", &shake))
+      {
+        section->Set("Nunchuk/Shake/X", std::string("L3"));
+        section->Set("Nunchuk/Shake/Y", std::string("L3"));
+        section->Set("Nunchuk/Shake/Z", std::string("L3"));
+        SaveIni(ini, LivePath(Device::Wii));
+      }
+    }
+  }
+  // Layouts from before Circle shook the Wii Remote ("Shake the Wii Remote" prompts): Circle,
+  // free in the Wii layout, as well as R3 - unless the player gave Circle to something else.
+  {
+    Common::IniFile ini;
+    if (ini.Load(LivePath(Device::Wii)))
+    {
+      Common::IniFile::Section* section = ini.GetSection("Wiimote1");
+      std::string shake;
+      bool circle_used = false;
+      if (section)
+      {
+        for (const auto& [key, value] : section->GetValues())
+          circle_used |= value.find("Circle") != std::string::npos;
+      }
+      if (section && section->Get("Shake/X", &shake) && Strip(shake) == "R3" && !circle_used)
+      {
+        for (const char* key : {"Shake/X", "Shake/Y", "Shake/Z"})
+          section->Set(key, std::string("`Circle | R3`"));
+        SaveIni(ini, LivePath(Device::Wii));
+      }
+    }
+  }
+  // Layouts from before the motion pointer: R1 (free in the Wii layout) re-centres it.
+  {
+    Common::IniFile ini;
+    if (ini.Load(LivePath(Device::Wii)))
+    {
+      Common::IniFile::Section* section = ini.GetSection("Wiimote1");
+      std::string recenter;
+      if (section && (!section->Get("IMUIR/Recenter", &recenter) || recenter.empty()))
+      {
+        section->Set("IMUIR/Recenter", std::string("R1"));
+        SaveIni(ini, LivePath(Device::Wii));
+      }
+    }
+  }
+  WriteIfMissing(Path(Device::GameCube), GCPAD_DEFAULTS, "GCPad1");
+  WriteIfMissing(Path(Device::Wii), WIIMOTE_DEFAULTS, "Wiimote1");
+  // The GameCube L / R clicks came from the DualShock 4's digital L2 / R2, which switch on early
+  // in the pull; Dolphin then reports the analog trigger as fully pressed (MixedTriggers), so half
+  // a press was a full one. Driven by the analog triggers instead, they click at Dolphin's
+  // threshold (90%) and the analog value follows the trigger until then. Older files are
+  // updated where they still have the old default.
+  {
+    Common::IniFile ini;
+    ini.Load(Path(Device::GameCube));
+    Common::IniFile::Section* section = ini.GetOrCreateSection(Section(Device::GameCube));
+    bool changed = false;
+    for (const auto& [key, old_value, new_value] :
+         {std::tuple{"Triggers/L", "`L2 Click`", "L2"}, std::tuple{"Triggers/R", "`R2 Click`", "R2"}})
+    {
+      std::string value;
+      if (section->Get(key, &value) && value == old_value)
+      {
+        section->Set(key, std::string(new_value));
+        changed = true;
+      }
+    }
+    if (changed)
+      SaveIni(ini, Path(Device::GameCube));
+  }
+  SyncPlayers(Device::GameCube);
+  SyncPlayers(Device::Wii);
+}
+
+// SetWiiMotion adds the PS Move to Wii Remote buttons as " | `PS4/0/PS Move N:...`"; the
+// Controls page shows and changes the DualShock 4 part only.
+std::string WithoutMove(std::string expression)
+{
+  const size_t at = expression.find(" | `PS4/0/PS Move");
+  if (at != std::string::npos)
+    expression.erase(at);
+  return expression;
+}
+
+// The last SetWiiMotion call (the game's start), redone after an in-game layout edit.
+static bool s_motion_set = false;
+static std::string s_motion_controller;
+static bool s_motion_on = false;
+static std::array<bool, 4> s_motion_moves{};
+static bool s_motion_pointer = false;
+static std::string s_tilt_mode = "both";     // SetWiiTilt
+static std::string s_touch_mode = "off";     // SetWiiTouchpad
+
+// A binding without the touchpad's inputs (they are added again by the Touchpad setting).
+static std::string WithoutTouch(const std::string& value)
+{
+  std::string out;
+  size_t start = 0;
+  while (start <= value.size())
+  {
+    size_t end = value.find(" | ", start);
+    if (end == std::string::npos)
+      end = value.size();
+    const std::string part = value.substr(start, end - start);
+    if (!part.empty() && part.rfind("`Touch", 0) != 0 && part.rfind("`Swipe", 0) != 0)
+      out += (out.empty() ? "" : " | ") + part;
+    start = end + 3;
+  }
+  return out;
+}
+
+void SetWiiTouchpad(const std::string& mode, bool write)
+{
+  s_touch_mode = mode;
+  if (write && s_motion_set)
+    SetWiiMotion(s_motion_controller, s_motion_on, s_motion_moves, s_motion_pointer);
+}
+static std::string s_extension = "nunchuk";  // SetWiiAttachment
+
+// The left stick on Tilt Left/Right: without a Nunchuk and unless only motion tilts. A tilt the
+// player set is kept.
+static void ApplyStickTilt(Common::IniFile::Section* section)
+{
+  constexpr const char* TILT[][2] = {{"Tilt/Left", "`Left X-`"}, {"Tilt/Right", "`Left X+`"}};
+  const bool stick = s_extension == "none" && s_tilt_mode != "motion";
+  for (const auto& [key, input] : TILT)
+  {
+    std::string value;
+    section->Get(key, &value);
+    if (stick && value.empty())
+      section->Set(key, std::string(input));
+    else if (!stick && value == input)
+      section->Set(key, std::string());
+  }
+}
+
+void SetWiiMotion(const std::string& controller, bool motion, const std::array<bool, 4>& moves,
+                  bool motion_pointer)
+{
+  s_motion_set = true;
+  s_motion_controller = controller;
+  s_motion_on = motion;
+  s_motion_moves = moves;
+  s_motion_pointer = motion_pointer;
+  Common::IniFile ini;
+  ini.Load(Path(Device::Wii));
+  constexpr const char* ACCEL[] = {"Up", "Down", "Left", "Right", "Forward", "Backward"};
+  constexpr const char* GYRO[] = {"Pitch Up", "Pitch Down", "Roll Left", "Roll Right", "Yaw Left",
+                                  "Yaw Right"};
+  // Wii Remote button -> the Move's.
+  constexpr const char* MOVE_BUTTONS[][2] = {{"Buttons/A", "Move"},  {"Buttons/B", "T"},
+                                             {"Buttons/1", "Cross"}, {"Buttons/2", "Circle"},
+                                             {"Buttons/-", "Select"}, {"Buttons/+", "Start"}};
+  for (int player = 1; player <= 4; player++)
+  {
+    Common::IniFile::Section* section = ini.GetSection("Wiimote" + std::to_string(player));
+    if (!section)
+      continue;
+    const bool move = moves[player - 1] && controller != "ds4";
+    const std::string device = "PS4/0/PS Move " + std::to_string(player);
+    auto from_move = [&](const std::string& input) { return "`" + device + ":" + input + "`"; };
+    for (const auto& [key, input] : MOVE_BUTTONS)
+    {
+      std::string value;
+      section->Get(key, &value);
+      value = WithoutMove(value);
+      if (move)
+        value = value.empty() ? from_move(input) : value + " | " + from_move(input);
+      section->Set(key, value);
+    }
+    // Tilt With: Left Stick leaves the accelerometer out (the stick tilts the Wii Remote alone).
+    const bool accel = motion && s_tilt_mode != "stick";
+    for (const char* direction : ACCEL)
+    {
+      const std::string input = std::string("Accel ") + direction;
+      section->Set(std::string("IMUAccelerometer/") + direction,
+                   move ? from_move(input) : accel ? "`" + input + "`" : std::string());
+    }
+    for (const char* direction : GYRO)
+    {
+      const std::string input = std::string("Gyro ") + direction;
+      section->Set(std::string("IMUGyroscope/") + direction,
+                   move ? from_move(input) : motion ? "`" + input + "`" : std::string());
+    }
+    // The pointer: the Move's gyroscope (Start + Select recentres it); with Pointer: Motion the
+    // DualShock 4's own (re-centred by the player's Pointer Re-centre button); else the right
+    // stick.
+    // Touchpad: Pointer - the finger aims (the motion pointer would override it); Swing - a
+    // swipe swings the Wii Remote that way.
+    const bool touch_pointer = s_touch_mode == "pointer" && !move;
+    constexpr const char* TOUCH_IR[][2] = {{"IR/Up", "`Touch Y-`"},
+                                           {"IR/Down", "`Touch Y+`"},
+                                           {"IR/Left", "`Touch X-`"},
+                                           {"IR/Right", "`Touch X+`"}};
+    constexpr const char* SWIPES[][2] = {{"Swing/Up", "`Swipe Up`"},
+                                         {"Swing/Down", "`Swipe Down`"},
+                                         {"Swing/Left", "`Swipe Left`"},
+                                         {"Swing/Right", "`Swipe Right`"}};
+    for (const auto& [key, input] : TOUCH_IR)
+    {
+      std::string value;
+      section->Get(key, &value);
+      value = WithoutTouch(value);
+      if (touch_pointer)
+        value = value.empty() ? std::string(input) : value + " | " + input;
+      section->Set(key, value);
+    }
+    for (const auto& [key, input] : SWIPES)
+    {
+      std::string value;
+      section->Get(key, &value);
+      value = WithoutTouch(value);
+      if (s_touch_mode == "swing")
+        value = value.empty() ? std::string(input) : value + " | " + input;
+      section->Set(key, value);
+    }
+    section->Set("IMUIR/Enabled",
+                 std::string(move || (motion && motion_pointer && !touch_pointer) ? "True" :
+                                                                                   "False"));
+    if (move)
+    {
+      section->Set("IMUIR/Recenter", from_move("Start") + " & " + from_move("Select"));
+    }
+    else
+    {
+      std::string recenter;
+      section->Get("IMUIR/Recenter", &recenter);
+      if (recenter.find("PS Move") != std::string::npos)
+        section->Set("IMUIR/Recenter", std::string());
+    }
+  }
+  SaveIni(ini, Path(Device::Wii));
+}
+
+std::string Get(Device device, const Binding& binding)
+{
+  Common::IniFile ini;
+  ini.Load(Path(device));
+  Common::IniFile::Section* section = ini.GetOrCreateSection(Section(device));
+  std::string value;
+  if (binding.stick_group)
+  {
+    std::string up, left;
+    section->Get(std::string(binding.key) + "/Up", &up);
+    section->Get(std::string(binding.key) + "/Left", &left);
+    for (const StickChoice& choice : STICKS)
+    {
+      if (up == choice.up && left == choice.left)
+        return choice.name;
+    }
+    return "Custom";
+  }
+  const std::string key = IsShake(binding) ? std::string(binding.key) + "/X" : binding.key;
+  section->Get(key, &value);
+  return WithoutMove(value);
+}
+
+std::string Describe(const std::string& expression)
+{
+  const std::string name = Strip(expression);
+  if (name.empty())
+    return "None";
+  // Either of two inputs ("Circle | R3"): each one by its shown name.
+  if (const size_t bar = name.find('|'); bar != std::string::npos)
+  {
+    std::string left = name.substr(0, bar), right = name.substr(bar + 1);
+    while (!left.empty() && left.back() == ' ')
+      left.pop_back();
+    while (!right.empty() && right.front() == ' ')
+      right.erase(0, 1);
+    return Describe(left) + " / " + Describe(right);
+  }
+  struct Name
+  {
+    const char* raw;
+    const char* shown;
+  };
+  constexpr Name NAMES[] = {
+      {"Pad N", "D-Pad Up"},           {"Pad S", "D-Pad Down"},
+      {"Pad W", "D-Pad Left"},         {"Pad E", "D-Pad Right"},
+      {"Left Y-", "Left Stick Up"},    {"Left Y+", "Left Stick Down"},
+      {"Left X-", "Left Stick Left"},  {"Left X+", "Left Stick Right"},
+      {"Right Y-", "Right Stick Up"},  {"Right Y+", "Right Stick Down"},
+      {"Right X-", "Right Stick Left"}, {"Right X+", "Right Stick Right"},
+      {"L2 Click", "L2"},              {"R2 Click", "R2"},
+      {"L2", "L2 (analog)"},           {"R2", "R2 (analog)"},
+  };
+  for (const Name& n : NAMES)
+  {
+    if (name == n.raw)
+      return n.shown;
+  }
+  return name;
+}
+
+void Set(Device device, const Binding& binding, const std::string& expression)
+{
+  Common::IniFile ini;
+  ini.Load(Path(device));
+  Common::IniFile::Section* section = ini.GetOrCreateSection(Section(device));
+  if (binding.stick_group)
+  {
+    for (const StickChoice& choice : STICKS)
+    {
+      if (expression != choice.name)
+        continue;
+      const std::string prefix = binding.key;
+      section->Set(prefix + "/Up", std::string(choice.up));
+      section->Set(prefix + "/Down", std::string(choice.down));
+      section->Set(prefix + "/Left", std::string(choice.left));
+      section->Set(prefix + "/Right", std::string(choice.right));
+    }
+  }
+  else if (IsShake(binding))
+  {
+    const std::string prefix = binding.key;
+    section->Set(prefix + "/X", expression);
+    section->Set(prefix + "/Y", expression);
+    section->Set(prefix + "/Z", expression);
+  }
+  else
+  {
+    section->Set(binding.key, expression);
+  }
+  SaveIni(ini, Path(device));
+  SyncPlayers(device);
+}
+
+std::vector<std::string> StickChoices()
+{
+  std::vector<std::string> choices;
+  for (const StickChoice& choice : STICKS)
+    choices.push_back(choice.name);
+  return choices;
+}
+
+void ResetToDefault(Device device)
+{
+  if (FILE* file = fopen(Path(device).c_str(), "w"))
+  {
+    fputs(DefaultsText(device), file);
+    fclose(file);
+  }
+  SyncPlayers(device);
+}
+
+void SetWiiAttachment(const std::string& extension, bool sideways, bool upright)
+{
+  Common::IniFile ini;
+  ini.Load(Path(Device::Wii));
+  Common::IniFile::Section* section = ini.GetOrCreateSection(Section(Device::Wii));
+  section->Set("Extension", std::string(extension == "none" ? "None" : "Nunchuk"));
+  section->Set("Options/Sideways Wiimote", std::string(sideways ? "True" : "False"));
+  // Dolphin turns the Wii Remote's motion (the DualShock 4's sensors included) by these two:
+  // Sideways and Upright together hold it like a steering wheel.
+  section->Set("Options/Upright Wiimote", std::string(upright ? "True" : "False"));
+  // Without a Nunchuk the left stick is free: it tilts the Wii Remote (steering in Mario Kart
+  // Wii, also for controllers without motion sensors), unless Tilt With is Motion.
+  s_extension = extension;
+  ApplyStickTilt(section);
+  SaveIni(ini, Path(Device::Wii));
+  SyncPlayers(Device::Wii);
+}
+
+void SetWiiTilt(const std::string& mode, bool write)
+{
+  s_tilt_mode = mode;
+  if (!write)
+    return;
+  Common::IniFile ini;
+  ini.Load(Path(Device::Wii));
+  ApplyStickTilt(ini.GetOrCreateSection(Section(Device::Wii)));
+  SaveIni(ini, Path(Device::Wii));
+  SyncPlayers(Device::Wii);
+  if (s_motion_set)
+    SetWiiMotion(s_motion_controller, s_motion_on, s_motion_moves, s_motion_pointer);
+}
+
+void SyncPlayers(Device device)
+{
+  Common::IniFile ini;
+  ini.Load(Path(device));
+  const Common::IniFile::Section* first = ini.GetSection(Section(device));
+  if (!first)
+    return;
+  const auto values = first->GetValues();  // a copy: the sections below are rewritten
+  const std::string base = device == Device::GameCube ? "GCPad" : "Wiimote";
+  for (int player = 2; player <= 4; player++)
+  {
+    const std::string name = base + std::to_string(player);
+    ini.DeleteSection(name);
+    Common::IniFile::Section* section = ini.GetOrCreateSection(name);
+    for (const auto& [key, value] : values)
+      section->Set(key, value);
+    section->Set("Device", "PS4/" + std::to_string(player - 1) + "/DualShock 4");
+  }
+  SaveIni(ini, Path(device));
+}
+
+bool IsAtRest(const OrbisPadData& now)
+{
+  auto centred = [](uint8_t v) { return v > 78 && v < 178; };
+  return now.buttons == 0 && now.analogButtons.l2 < 40 && now.analogButtons.r2 < 40 &&
+         centred(now.leftStick.x) && centred(now.leftStick.y) && centred(now.rightStick.x) &&
+         centred(now.rightStick.y);
+}
+
+std::string Capture(const OrbisPadData& now, bool for_analog_trigger)
+{
+  struct ButtonName
+  {
+    uint32_t bit;
+    const char* name;
+  };
+  constexpr ButtonName BUTTONS[] = {
+      {ORBIS_PAD_BUTTON_CROSS, "Cross"},       {ORBIS_PAD_BUTTON_CIRCLE, "Circle"},
+      {ORBIS_PAD_BUTTON_SQUARE, "Square"},     {ORBIS_PAD_BUTTON_TRIANGLE, "Triangle"},
+      {ORBIS_PAD_BUTTON_L1, "L1"},             {ORBIS_PAD_BUTTON_R1, "R1"},
+      {ORBIS_PAD_BUTTON_L3, "L3"},             {ORBIS_PAD_BUTTON_R3, "R3"},
+      {ORBIS_PAD_BUTTON_OPTIONS, "Options"},   {ORBIS_PAD_BUTTON_TOUCH_PAD, "Touchpad"},
+      {ORBIS_PAD_BUTTON_UP, "`Pad N`"},        {ORBIS_PAD_BUTTON_DOWN, "`Pad S`"},
+      {ORBIS_PAD_BUTTON_LEFT, "`Pad W`"},      {ORBIS_PAD_BUTTON_RIGHT, "`Pad E`"},
+  };
+  if ((now.buttons & ORBIS_PAD_BUTTON_L2) || now.analogButtons.l2 > 180)
+    return for_analog_trigger ? "L2" : "`L2 Click`";
+  if ((now.buttons & ORBIS_PAD_BUTTON_R2) || now.analogButtons.r2 > 180)
+    return for_analog_trigger ? "R2" : "`R2 Click`";
+  for (const ButtonName& button : BUTTONS)
+  {
+    if (now.buttons & button.bit)
+      return button.name;
+  }
+  if (now.leftStick.x < 40)
+    return "`Left X-`";
+  if (now.leftStick.x > 215)
+    return "`Left X+`";
+  if (now.leftStick.y < 40)
+    return "`Left Y-`";
+  if (now.leftStick.y > 215)
+    return "`Left Y+`";
+  if (now.rightStick.x < 40)
+    return "`Right X-`";
+  if (now.rightStick.x > 215)
+    return "`Right X+`";
+  if (now.rightStick.y < 40)
+    return "`Right Y-`";
+  if (now.rightStick.y > 215)
+    return "`Right Y+`";
+  return {};
+}
+
+void EditGame(const std::string& game_id)
+{
+  s_edit_game = game_id;
+}
+
+bool HasGameProfile(const std::string& game_id)
+{
+  return !game_id.empty() &&
+         (Exists(GamePath(Device::GameCube, game_id)) || Exists(GamePath(Device::Wii, game_id)));
+}
+
+void CreateGameProfile(const std::string& game_id)
+{
+  mkdir(ProfileDir().c_str(), 0777);
+  for (const Device device : {Device::GameCube, Device::Wii})
+  {
+    Common::IniFile ini;
+    ini.Load(LivePath(device));
+    SaveIni(ini, GamePath(device, game_id));
+  }
+}
+
+void DeleteGameProfile(const std::string& game_id)
+{
+  for (const Device device : {Device::GameCube, Device::Wii})
+    std::remove(GamePath(device, game_id).c_str());
+}
+
+void RestoreGlobal()
+{
+  for (const Device device : {Device::GameCube, Device::Wii})
+  {
+    if (Exists(BackupPath(device)))
+      std::rename(BackupPath(device).c_str(), LivePath(device).c_str());
+  }
+}
+
+void RefreshLive(const std::string& game_id)
+{
+  const std::string editing = s_edit_game;
+  s_edit_game.clear();
+  for (const Device device : {Device::GameCube, Device::Wii})
+  {
+    Common::IniFile mine;
+    if (HasGameProfile(game_id) && mine.Load(GamePath(device, game_id)))
+    {
+      if (const Common::IniFile::Section* own = mine.GetSection(Section(device)))
+      {
+        Common::IniFile live;
+        live.Load(LivePath(device));
+        live.DeleteSection(Section(device));
+        Common::IniFile::Section* target = live.GetOrCreateSection(Section(device));
+        for (const auto& [key, value] : own->GetValues())
+          target->Set(key, value);
+        SaveIni(live, LivePath(device));
+      }
+    }
+    SyncPlayers(device);
+  }
+  if (s_motion_set)
+    SetWiiMotion(s_motion_controller, s_motion_on, s_motion_moves, s_motion_pointer);
+  s_edit_game = editing;
+}
+
+bool UseGameProfile(const std::string& game_id)
+{
+  RestoreGlobal();
+  if (!HasGameProfile(game_id))
+    return false;
+  for (const Device device : {Device::GameCube, Device::Wii})
+  {
+    Common::IniFile mine;
+    if (!mine.Load(GamePath(device, game_id)))
+      continue;
+    const Common::IniFile::Section* own = mine.GetSection(Section(device));
+    if (!own)
+      continue;
+    // The normal layout aside, then player 1 from the game's layout; players 2-4 follow it.
+    Common::IniFile live;
+    live.Load(LivePath(device));
+    SaveIni(live, BackupPath(device));
+    live.DeleteSection(Section(device));
+    Common::IniFile::Section* target = live.GetOrCreateSection(Section(device));
+    for (const auto& [key, value] : own->GetValues())
+      target->Set(key, value);
+    SaveIni(live, LivePath(device));
+    SyncPlayers(device);
+  }
+  return true;
+}
+}  // namespace PS4Controls
diff --git a/Source/Core/DolphinNoGUI/PS4Controls.h b/Source/Core/DolphinNoGUI/PS4Controls.h
new file mode 100755
index 0000000..e1d4d2e
--- /dev/null
+++ b/Source/Core/DolphinNoGUI/PS4Controls.h
@@ -0,0 +1,87 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// PS4 controller mappings: the DualShock 4 as a GameCube controller (User/Config/GCPadNew.ini)
+// and as a Wii Remote with a Nunchuk (User/Config/WiimoteNew.ini), in Dolphin's own format.
+// The XMB remaps them; the defaults are the port's tuned layout.
+
+#pragma once
+
+#include <array>
+#include <string>
+#include <vector>
+
+struct OrbisPadData;
+
+namespace PS4Controls
+{
+enum class Device
+{
+  GameCube,
+  Wii,
+};
+
+// One mappable input. A stick group ("Main Stick") maps all four directions to one DualShock 4
+// stick or the D-pad at once; the others take a single button, trigger or stick direction.
+struct Binding
+{
+  const char* key;    // Dolphin's key ("Buttons/A"); for a stick group the key prefix
+  const char* label;  // shown in the menus
+  bool stick_group;
+};
+
+const std::vector<Binding>& Bindings(Device device);
+const char* DefaultsText(Device device);  // the default INI file contents
+const char* DeviceName(Device device);
+
+// user_dir: /data/DolphinPS4/User
+void SetUserDirectory(const std::string& user_dir);
+// Writes the default files if they don't exist yet.
+void WriteDefaultsIfMissing();
+
+// The binding's expression ("Cross", "`Left X-`") and how it's shown ("Cross", "Left Stick Left").
+std::string Get(Device device, const Binding& binding);
+std::string Describe(const std::string& expression);
+void Set(Device device, const Binding& binding, const std::string& expression);
+// Stick groups: "Left Stick", "Right Stick" or "D-Pad".
+std::vector<std::string> StickChoices();
+void ResetToDefault(Device device);
+
+// Per-game layouts: User/Config/PS4Controls/<GAME ID>-GCPad.ini / -Wiimote.ini. The menu edits
+// either the normal layout (game "") or a game's own (EditGame). A game process puts its own
+// layout in place (UseGameProfile); the normal one waits in a backup and the menu restores it
+// (RestoreGlobal), so a game's layout never reaches another game.
+void EditGame(const std::string& game_id);
+bool HasGameProfile(const std::string& game_id);
+void CreateGameProfile(const std::string& game_id);  // starts as a copy of the normal layout
+void DeleteGameProfile(const std::string& game_id);
+bool UseGameProfile(const std::string& game_id);     // game process; true when it had one
+void RestoreGlobal();
+// The Wii Remote's extension ("nunchuk" or "none") and sideways orientation.
+void SetWiiAttachment(const std::string& extension, bool sideways, bool upright = false);
+// "both", "motion" or "stick": what tilts the Wii Remote (the motion sensors' accelerometer, the
+// left stick without a Nunchuk). write=false only sets it for the next SetWii* call.
+void SetWiiTilt(const std::string& mode, bool write = true);
+// "off", "pointer" (the finger aims) or "swing" (a swipe swings the Wii Remote): applied with
+// the next SetWiiMotion (write: now, in the running game - Dolphin then reads the layout again).
+void SetWiiTouchpad(const std::string& mode, bool write = false);
+
+// Settings -> System -> Wii Remote / Motion Controls, before a game starts: per player, the
+// player's PS Move (moves[player - 1]) joins the Wii Remote (its buttons alongside the DualShock 4's,
+// its motion and gyroscope pointer), or the DualShock 4's motion is used (motion), or none.
+// controller: "auto" (the Move when it's on) or "ds4" (never the Move).
+void SetWiiMotion(const std::string& controller, bool motion, const std::array<bool, 4>& moves,
+                  bool motion_pointer = false);
+// In a running game (the in-game menu): the files Dolphin reads follow this game's own layout
+// again after it was edited, players 2-4 follow player 1, and the motion setup is redone.
+void RefreshLive(const std::string& game_id);
+// Players 2-4 (GCPad2-4, Wiimote2-4): player 1's mapping, each on their own DualShock 4
+// ("PS4/<player - 1>/DualShock 4"). Done after every change to player 1's mapping.
+void SyncPlayers(Device device);
+
+// Capture: the expression for the first input that differs from the resting state (a button
+// pressed, a trigger pulled or a stick pushed), or empty if nothing is pressed yet.
+std::string Capture(const OrbisPadData& now, bool for_analog_trigger);
+// True when nothing on the pad is pressed (to wait before a capture).
+bool IsAtRest(const OrbisPadData& now);
+}  // namespace PS4Controls
diff --git a/Source/Core/DolphinNoGUI/PS4Covers.cpp b/Source/Core/DolphinNoGUI/PS4Covers.cpp
new file mode 100755
index 0000000..e8cfd7f
--- /dev/null
+++ b/Source/Core/DolphinNoGUI/PS4Covers.cpp
@@ -0,0 +1,239 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "DolphinNoGUI/PS4Covers.h"
+
+#include <cstdio>
+#include <cstring>
+#include <sys/stat.h>
+
+#include <curl/curl.h>
+#include <orbis/Net.h>
+#include <orbis/Sysmodule.h>
+
+extern "C" void ps4_boot_trace(const char* line);  // port/ps4_crashlog.cpp
+
+namespace PS4Covers
+{
+namespace
+{
+constexpr const char* HOST = "art.gametdb.com";
+
+void Log(const std::string& text)
+{
+  fprintf(stderr, "[covers] %s\n", text.c_str());
+  ps4_boot_trace(("covers: " + text).c_str());
+}
+
+bool Exists(const std::string& path)
+{
+  struct stat st;
+  return stat(path.c_str(), &st) == 0 && st.st_size > 0;
+}
+
+// The PS4's network: libSceNet and its resolver (the C library's getaddrinfo has no DNS
+// configuration on the PS4). Returns GameTDB's address as text, or empty.
+std::string ResolveHost(std::string* error)
+{
+  static bool s_net = false;
+  static int s_pool = -1;
+  if (!s_net)
+  {
+    sceSysmoduleLoadModuleInternal(ORBIS_SYSMODULE_INTERNAL_NET);
+    const int init = sceNetInit();
+    s_pool = sceNetPoolCreate("dolphin-covers", 64 * 1024, 0);
+    char line[96];
+    snprintf(line, sizeof(line), "network: init %#x, pool %#x", static_cast<unsigned>(init),
+             static_cast<unsigned>(s_pool));
+    Log(line);
+    s_net = true;
+  }
+  const OrbisNetId resolver = sceNetResolverCreate("dolphin-covers", s_pool, 0);
+  if (resolver < 0)
+  {
+    *error = "the PS4 network is not available";
+    return {};
+  }
+  OrbisNetInAddr address = {};
+  const int result = sceNetResolverStartNtoa(resolver, HOST, &address, 5 * 1000 * 1000, 2, 0);
+  sceNetResolverDestroy(resolver);
+  if (result < 0)
+  {
+    char line[96];
+    snprintf(line, sizeof(line), "could not look up %s (%#x): is the PS4 online?", HOST,
+             static_cast<unsigned>(result));
+    *error = line;
+    return {};
+  }
+  const uint32_t a = address.s_addr;  // network byte order
+  char text[32];
+  snprintf(text, sizeof(text), "%u.%u.%u.%u", a & 0xFF, (a >> 8) & 0xFF, (a >> 16) & 0xFF,
+           (a >> 24) & 0xFF);
+  return text;
+}
+
+size_t Append(char* data, size_t size, size_t count, void* user)
+{
+  static_cast<std::string*>(user)->append(data, size * count);
+  return size * count;
+}
+
+// GET url into body; returns the HTTP status (0: no answer).
+long Fetch(CURL* curl, const std::string& url, std::string* body, std::string* error)
+{
+  body->clear();
+  char detail[CURL_ERROR_SIZE] = {};
+  curl_easy_setopt(curl, CURLOPT_ERRORBUFFER, detail);
+  curl_easy_setopt(curl, CURLOPT_URL, url.c_str());
+  curl_easy_setopt(curl, CURLOPT_WRITEDATA, body);
+  CURLcode code = curl_easy_perform(curl);
+  if (code == CURLE_PEER_FAILED_VERIFICATION || code == CURLE_SSL_CACERT_BADFILE ||
+      code == CURLE_SSL_CERTPROBLEM)
+  {
+    // The PS4's TLS library rejects GameTDB's certificate chain. Covers are public pictures
+    // (and checked to be PNGs before they are saved): fetch them without the check.
+    static bool s_logged = false;
+    if (!s_logged)
+    {
+      Log(std::string("certificate check failed (") + detail + "), downloading without it");
+      s_logged = true;
+    }
+    curl_easy_setopt(curl, CURLOPT_SSL_VERIFYPEER, 0L);
+    curl_easy_setopt(curl, CURLOPT_SSL_VERIFYHOST, 0L);
+    body->clear();
+    code = curl_easy_perform(curl);
+  }
+  if (code != CURLE_OK)
+  {
+    *error = std::string(curl_easy_strerror(code)) + (detail[0] ? std::string(": ") + detail : "");
+    return 0;
+  }
+  long status = 0;
+  curl_easy_getinfo(curl, CURLINFO_RESPONSE_CODE, &status);
+  return status;
+}
+
+// GameTDB's regions for a game ID's region letter (4th character), most likely first.
+std::vector<const char*> Regions(const std::string& id)
+{
+  const char region = id.size() >= 4 ? id[3] : 'E';
+  switch (region)
+  {
+  case 'E':
+  case 'N':
+    return {"US", "EN"};
+  case 'J':
+    return {"JA", "US"};
+  case 'K':
+  case 'Q':
+  case 'T':
+    return {"KO", "US"};
+  case 'D':
+    return {"DE", "EN", "US"};
+  case 'F':
+    return {"FR", "EN", "US"};
+  case 'S':
+    return {"ES", "EN", "US"};
+  case 'I':
+    return {"IT", "EN", "US"};
+  case 'H':
+    return {"NL", "EN", "US"};
+  case 'R':
+    return {"RU", "EN", "US"};
+  default:  // P, X, Y, ...: PAL
+    return {"EN", "US"};
+  }
+}
+}  // namespace
+
+Result Download(const std::vector<std::string>& game_ids, const std::string& covers_dir,
+                const std::string& ca_file,
+                const std::function<void(int, int, const std::string&)>& progress,
+                const std::atomic<bool>& cancel)
+{
+  Result result;
+  mkdir(covers_dir.c_str(), 0777);
+
+  std::vector<std::string> missing;
+  for (const std::string& id : game_ids)
+  {
+    if (id.empty())
+      continue;
+    if (Exists(covers_dir + "/" + id + ".png"))
+      result.already++;
+    else
+      missing.push_back(id);
+  }
+  if (missing.empty())
+    return result;
+
+  const std::string address = ResolveHost(&result.error);
+  if (address.empty())
+  {
+    result.failed = static_cast<int>(missing.size());
+    Log(result.error);
+    return result;
+  }
+  Log(std::string(HOST) + " is " + address);
+
+  curl_global_init(CURL_GLOBAL_DEFAULT);
+  CURL* curl = curl_easy_init();
+  const std::string resolve = std::string(HOST) + ":443:" + address;
+  curl_slist* resolves = curl_slist_append(nullptr, resolve.c_str());
+  curl_easy_setopt(curl, CURLOPT_RESOLVE, resolves);
+  curl_easy_setopt(curl, CURLOPT_CAINFO, ca_file.c_str());
+  curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 1L);
+  curl_easy_setopt(curl, CURLOPT_TIMEOUT, 20L);
+  curl_easy_setopt(curl, CURLOPT_CONNECTTIMEOUT, 10L);
+  curl_easy_setopt(curl, CURLOPT_USERAGENT, "Dolphin-PS4");
+  curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, Append);
+  curl_easy_setopt(curl, CURLOPT_NOSIGNAL, 1L);
+
+  for (size_t i = 0; i < missing.size() && !cancel; i++)
+  {
+    const std::string& id = missing[i];
+    progress(static_cast<int>(i), static_cast<int>(missing.size()), id);
+    bool saved = false, answered = false;
+    std::string body, error;
+    for (const char* region : Regions(id))
+    {
+      const std::string url = "https://" + std::string(HOST) + "/wii/cover/" + region + "/" + id +
+                              ".png";
+      const long status = Fetch(curl, url, &body, &error);
+      if (status == 0)
+        break;  // network trouble: don't try the other regions
+      answered = true;
+      if (status == 200 && body.size() > 8 && body.compare(1, 3, "PNG") == 0)
+      {
+        const std::string path = covers_dir + "/" + id + ".png";
+        if (FILE* file = fopen(path.c_str(), "wb"))
+        {
+          fwrite(body.data(), 1, body.size(), file);
+          fclose(file);
+          saved = true;
+        }
+        break;
+      }
+    }
+    if (saved)
+    {
+      result.downloaded++;
+    }
+    else if (answered)
+    {
+      result.not_found++;
+      Log("no cover for " + id);
+    }
+    else
+    {
+      result.failed++;
+      result.error = error;
+      Log("download failed for " + id + ": " + error);
+    }
+  }
+  progress(static_cast<int>(missing.size()), static_cast<int>(missing.size()), {});
+  curl_slist_free_all(resolves);
+  curl_easy_cleanup(curl);
+  return result;
+}
+}  // namespace PS4Covers
diff --git a/Source/Core/DolphinNoGUI/PS4Covers.h b/Source/Core/DolphinNoGUI/PS4Covers.h
new file mode 100755
index 0000000..d02913e
--- /dev/null
+++ b/Source/Core/DolphinNoGUI/PS4Covers.h
@@ -0,0 +1,31 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// Box art for the XMB, downloaded on demand from GameTDB (as Dolphin's own game list does) for
+// the games the user has, into /data/DolphinPS4/covers/<GAMEID>.png. A PNG the user puts there
+// is used as is.
+
+#pragma once
+
+#include <atomic>
+#include <functional>
+#include <string>
+#include <vector>
+
+namespace PS4Covers
+{
+struct Result
+{
+  int downloaded = 0;
+  int already = 0;   // a cover was there already
+  int not_found = 0;  // GameTDB has none for the ID
+  int failed = 0;
+  std::string error;  // why the last download failed (network, ...)
+};
+
+// Downloads the missing covers. progress(done, total, game_id) is called before each game.
+Result Download(const std::vector<std::string>& game_ids, const std::string& covers_dir,
+                const std::string& ca_file,
+                const std::function<void(int, int, const std::string&)>& progress,
+                const std::atomic<bool>& cancel);
+}  // namespace PS4Covers
diff --git a/Source/Core/DolphinNoGUI/PS4Glyphs.cpp b/Source/Core/DolphinNoGUI/PS4Glyphs.cpp
new file mode 100755
index 0000000..8713605
--- /dev/null
+++ b/Source/Core/DolphinNoGUI/PS4Glyphs.cpp
@@ -0,0 +1,294 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "DolphinNoGUI/PS4Glyphs.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+
+namespace PS4Glyphs
+{
+namespace
+{
+enum class Kind
+{
+  None,
+  Cross,
+  Circle,
+  Square,
+  Triangle,
+  Shoulder,  // L1 / R1
+  Trigger,   // L2 / R2 (click or analog)
+  StickPress,  // L3 / R3
+  StickDir,    // a stick pushed one way
+  Stick,       // a whole stick (stick groups)
+  DPadDir,
+  DPad,
+  Options,
+  Touchpad,
+};
+
+struct Info
+{
+  Kind kind = Kind::None;
+  const char* label = "";  // L1, R2, L, R...
+  int dir = -1;            // 0 up, 1 down, 2 left, 3 right
+  bool analog = false;     // L2 / R2 as an axis
+};
+
+Info Lookup(const std::string& name)
+{
+  struct Entry
+  {
+    const char* name;
+    Info info;
+  };
+  static const Entry ENTRIES[] = {
+      {"Cross", {Kind::Cross}},
+      {"Circle", {Kind::Circle}},
+      {"Square", {Kind::Square}},
+      {"Triangle", {Kind::Triangle}},
+      {"L1", {Kind::Shoulder, "L1"}},
+      {"R1", {Kind::Shoulder, "R1"}},
+      {"L2 Click", {Kind::Trigger, "L2"}},
+      {"R2 Click", {Kind::Trigger, "R2"}},
+      {"L2", {Kind::Trigger, "L2", -1, true}},
+      {"R2", {Kind::Trigger, "R2", -1, true}},
+      {"L3", {Kind::StickPress, "L"}},
+      {"R3", {Kind::StickPress, "R"}},
+      {"Options", {Kind::Options}},
+      {"Touchpad", {Kind::Touchpad}},
+      {"Pad N", {Kind::DPadDir, "", 0}},
+      {"Pad S", {Kind::DPadDir, "", 1}},
+      {"Pad W", {Kind::DPadDir, "", 2}},
+      {"Pad E", {Kind::DPadDir, "", 3}},
+      {"Left Y-", {Kind::StickDir, "L", 0}},
+      {"Left Y+", {Kind::StickDir, "L", 1}},
+      {"Left X-", {Kind::StickDir, "L", 2}},
+      {"Left X+", {Kind::StickDir, "L", 3}},
+      {"Right Y-", {Kind::StickDir, "R", 0}},
+      {"Right Y+", {Kind::StickDir, "R", 1}},
+      {"Right X-", {Kind::StickDir, "R", 2}},
+      {"Right X+", {Kind::StickDir, "R", 3}},
+      {"Left Stick", {Kind::Stick, "L"}},
+      {"Right Stick", {Kind::Stick, "R"}},
+      {"D-Pad", {Kind::DPad}},
+  };
+  std::string stripped;
+  for (char c : name)
+  {
+    if (c != '`')
+      stripped += c;
+  }
+  for (const Entry& entry : ENTRIES)
+  {
+    if (stripped == entry.name)
+      return entry.info;
+  }
+  return {};
+}
+
+ImU32 Colour(int r, int g, int b, float alpha)
+{
+  return IM_COL32(r, g, b, static_cast<int>(255 * alpha));
+}
+
+void CentredText(ImDrawList* dl, ImFont* font, float size, ImVec2 centre, ImU32 colour,
+                 const char* text)
+{
+  if (!font || !*text)
+    return;
+  const ImVec2 extent = font->CalcTextSizeA(size, 10000.0f, 0.0f, text);
+  dl->AddText(font, size, ImVec2(centre.x - extent.x * 0.5f, centre.y - extent.y * 0.5f), colour,
+              text);
+}
+
+// A filled triangle pointing in direction dir (0 up, 1 down, 2 left, 3 right).
+void Arrow(ImDrawList* dl, ImVec2 c, float s, int dir, ImU32 colour)
+{
+  const float dx[] = {0, 0, -1, 1}, dy[] = {-1, 1, 0, 0};
+  const ImVec2 tip(c.x + dx[dir] * s, c.y + dy[dir] * s);
+  const ImVec2 base(c.x - dx[dir] * s * 0.4f, c.y - dy[dir] * s * 0.4f);
+  const ImVec2 side(dy[dir] * s * 0.8f, dx[dir] * s * 0.8f);
+  dl->AddTriangleFilled(tip, ImVec2(base.x + side.x, base.y + side.y),
+                        ImVec2(base.x - side.x, base.y - side.y), colour);
+}
+
+void DPadShape(ImDrawList* dl, ImVec2 c, float r, int lit_dir, bool all_lit, float alpha)
+{
+  const float arm = r * 0.42f;
+  const ImU32 dim = Colour(255, 255, 255, 0.28f * alpha);
+  const ImU32 lit = Colour(255, 255, 255, alpha);
+  const ImVec2 mins[] = {{c.x - arm * 0.5f, c.y - r},
+                         {c.x - arm * 0.5f, c.y + arm * 0.5f},
+                         {c.x - r, c.y - arm * 0.5f},
+                         {c.x + arm * 0.5f, c.y - arm * 0.5f}};
+  const ImVec2 maxs[] = {{c.x + arm * 0.5f, c.y - arm * 0.5f},
+                         {c.x + arm * 0.5f, c.y + r},
+                         {c.x - arm * 0.5f, c.y + arm * 0.5f},
+                         {c.x + r, c.y + arm * 0.5f}};
+  for (int i = 0; i < 4; i++)
+    dl->AddRectFilled(mins[i], maxs[i], all_lit || i == lit_dir ? lit : dim, r * 0.12f);
+  dl->AddRectFilled(ImVec2(c.x - arm * 0.5f, c.y - arm * 0.5f),
+                    ImVec2(c.x + arm * 0.5f, c.y + arm * 0.5f), all_lit ? lit : dim);
+}
+}  // namespace
+
+float Width(const std::string& name, float h)
+{
+  switch (Lookup(name).kind)
+  {
+  case Kind::None:
+    return 0.0f;
+  case Kind::Shoulder:
+  case Kind::Trigger:
+    return h * 1.35f;
+  case Kind::Options:
+    return h * 1.15f;
+  case Kind::Touchpad:
+    return h * 1.7f;
+  default:
+    return h;
+  }
+}
+
+float Draw(ImDrawList* dl, ImFont* font, const std::string& name, float x, float cy, float h,
+           float alpha)
+{
+  const Info info = Lookup(name);
+  const float w = Width(name, h);
+  if (info.kind == Kind::None)
+    return 0.0f;
+  const float r = h * 0.5f;
+  const ImVec2 c(x + w * 0.5f, cy);
+  const ImU32 white = Colour(255, 255, 255, alpha);
+  const ImU32 disc = Colour(20, 24, 34, 0.85f * alpha);
+  const ImU32 rim = Colour(255, 255, 255, 0.35f * alpha);
+  const float line = std::max(1.5f, h * 0.085f);
+
+  switch (info.kind)
+  {
+  case Kind::Cross:
+  case Kind::Circle:
+  case Kind::Square:
+  case Kind::Triangle:
+  {
+    dl->AddCircleFilled(c, r, disc, 32);
+    dl->AddCircle(c, r, rim, 32, 1.5f);
+    const float s = r * 0.48f;
+    if (info.kind == Kind::Cross)
+    {
+      const ImU32 blue = Colour(124, 178, 232, alpha);
+      dl->AddLine(ImVec2(c.x - s, c.y - s), ImVec2(c.x + s, c.y + s), blue, line);
+      dl->AddLine(ImVec2(c.x - s, c.y + s), ImVec2(c.x + s, c.y - s), blue, line);
+    }
+    else if (info.kind == Kind::Circle)
+    {
+      dl->AddCircle(c, s, Colour(255, 102, 102, alpha), 28, line);
+    }
+    else if (info.kind == Kind::Square)
+    {
+      dl->AddRect(ImVec2(c.x - s * 0.9f, c.y - s * 0.9f), ImVec2(c.x + s * 0.9f, c.y + s * 0.9f),
+                  Colour(216, 143, 201, alpha), 0.0f, 0, line);
+    }
+    else
+    {
+      const ImU32 green = Colour(64, 224, 176, alpha);
+      dl->AddTriangle(ImVec2(c.x, c.y - s * 1.05f), ImVec2(c.x - s * 1.05f, c.y + s * 0.75f),
+                      ImVec2(c.x + s * 1.05f, c.y + s * 0.75f), green, line);
+    }
+    break;
+  }
+  case Kind::Shoulder:
+  {
+    // A flat bumper.
+    const ImVec2 a(x, cy - r * 0.62f), b(x + w, cy + r * 0.62f);
+    dl->AddRectFilled(a, b, disc, r * 0.5f);
+    dl->AddRect(a, b, rim, r * 0.5f, 0, 1.5f);
+    CentredText(dl, font, h * 0.55f, c, white, info.label);
+    break;
+  }
+  case Kind::Trigger:
+  {
+    // A trigger: rounded on top, square at the bottom; analog ones get a pressure bar.
+    const ImVec2 a(x, cy - r), b(x + w, cy + r);
+    dl->AddRectFilled(a, b, disc, r * 0.7f, ImDrawFlags_RoundCornersTop);
+    dl->AddRect(a, b, rim, r * 0.7f, ImDrawFlags_RoundCornersTop, 1.5f);
+    CentredText(dl, font, h * 0.55f, ImVec2(c.x, c.y - (info.analog ? r * 0.12f : 0.0f)), white,
+                info.label);
+    if (info.analog)
+    {
+      const float bar_y = cy + r * 0.62f;
+      dl->AddRectFilledMultiColor(ImVec2(x + w * 0.2f, bar_y - line * 0.5f),
+                                  ImVec2(x + w * 0.8f, bar_y + line * 0.5f),
+                                  Colour(255, 255, 255, 0.15f * alpha), white, white,
+                                  Colour(255, 255, 255, 0.15f * alpha));
+    }
+    break;
+  }
+  case Kind::StickPress:
+  case Kind::StickDir:
+  case Kind::Stick:
+  {
+    dl->AddCircleFilled(c, r, disc, 32);
+    dl->AddCircle(c, r, rim, 32, 1.5f);
+    dl->AddCircle(c, r * 0.68f, Colour(255, 255, 255, 0.5f * alpha), 28, 1.5f);
+    if (info.kind == Kind::StickPress)
+    {
+      // L3 / R3: the stick top pushed in.
+      CentredText(dl, font, h * 0.42f, ImVec2(c.x, c.y - r * 0.05f), white,
+                  info.label[0] == 'L' ? "L3" : "R3");
+    }
+    else
+    {
+      CentredText(dl, font, h * 0.42f, c, white, info.label);
+      if (info.kind == Kind::StickDir)
+      {
+        const float dx[] = {0, 0, -1, 1}, dy[] = {-1, 1, 0, 0};
+        Arrow(dl, ImVec2(c.x + dx[info.dir] * r * 0.84f, c.y + dy[info.dir] * r * 0.84f),
+              r * 0.26f, info.dir, Colour(255, 214, 102, alpha));
+      }
+      else
+      {
+        for (int d = 0; d < 4; d++)
+        {
+          const float dx[] = {0, 0, -1, 1}, dy[] = {-1, 1, 0, 0};
+          Arrow(dl, ImVec2(c.x + dx[d] * r * 0.84f, c.y + dy[d] * r * 0.84f), r * 0.18f, d,
+                Colour(255, 255, 255, 0.7f * alpha));
+        }
+      }
+    }
+    break;
+  }
+  case Kind::DPadDir:
+  case Kind::DPad:
+    DPadShape(dl, c, r * 0.95f, info.dir, info.kind == Kind::DPad, alpha);
+    break;
+  case Kind::Options:
+  {
+    // A small pill with the three-line OPTIONS mark.
+    const ImVec2 a(x + w * 0.18f, cy - r * 0.8f), b(x + w * 0.82f, cy + r * 0.8f);
+    dl->AddRectFilled(a, b, disc, r * 0.3f);
+    dl->AddRect(a, b, rim, r * 0.3f, 0, 1.5f);
+    for (int i = -1; i <= 1; i++)
+    {
+      const float y = cy + i * r * 0.32f;
+      dl->AddLine(ImVec2(c.x - r * 0.3f, y), ImVec2(c.x + r * 0.3f, y), white, line * 0.8f);
+    }
+    break;
+  }
+  case Kind::Touchpad:
+  {
+    const ImVec2 a(x, cy - r * 0.7f), b(x + w, cy + r * 0.7f);
+    dl->AddRectFilled(a, b, disc, r * 0.25f);
+    dl->AddRect(a, b, white, r * 0.25f, 0, line * 0.8f);
+    dl->AddCircleFilled(ImVec2(c.x, cy), r * 0.14f, white, 12);
+    break;
+  }
+  case Kind::None:
+    break;
+  }
+  return w;
+}
+}  // namespace PS4Glyphs
