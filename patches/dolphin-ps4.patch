diff --git a/Source/Core/Core/PowerPC/Interpreter/ParallelismOracle.cpp b/Source/Core/Core/PowerPC/Interpreter/ParallelismOracle.cpp
new file mode 100755
index 0000000..5f2eecc
--- /dev/null
+++ b/Source/Core/Core/PowerPC/Interpreter/ParallelismOracle.cpp
@@ -0,0 +1,571 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "Core/PowerPC/Interpreter/ParallelismOracle.h"
+
+#include <algorithm>
+#include <bitset>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <unordered_map>
+#include <vector>
+
+#include "Core/PowerPC/Gekko.h"
+#include "Core/PowerPC/PPCTables.h"
+#include "Core/PowerPC/PowerPC.h"
+
+namespace ParallelismOracle
+{
+bool g_active = false;
+
+namespace
+{
+// Register indices: GPRs, FPRs, CR fields, then special registers.
+constexpr int REG_GPR = 0, REG_FPR = 32, REG_CR = 64, REG_LR = 72, REG_CTR = 73, REG_XER = 74,
+              REG_SPR = 75, NUM_REGS = REG_SPR + 1024;
+constexpr u64 MIN_CALLEE = 64;     // shorter functions aren't worth a second core
+constexpr u64 MIN_OVERLAP = 64;    // below this the hand-over to the other core costs more
+constexpr size_t MAX_SCANS = 64;   // continuations measured at once
+constexpr size_t MAX_DEPTH = 512;  // call stack depth kept
+constexpr u64 REPORT_EVERY = 200'000'000;
+
+struct Frame
+{
+  u32 return_pc;
+  u32 sp;
+  u32 callee;
+  u64 t_call;
+  bool device_read;  // polled a device (a wait loop, not work): never overlapped
+  u32 gpr[32];
+  u64 fpr[32];
+  u32 cr;
+};
+
+struct Scan
+{
+  u32 callee;
+  u64 t_call, t_ret, budget;
+  // Two variants: strict (value validation only) and with the return value predicted.
+  u64 len[2] = {0, 0};
+  bool alive[2] = {true, true};
+  std::bitset<NUM_REGS> ignore;       // unchanged across the call
+  std::bitset<NUM_REGS> ignore_pred;  // also the predicted return registers
+};
+
+struct Candidate
+{
+  u64 start, end, weight;
+  u32 callee;
+};
+
+FILE* s_report = nullptr;
+bool s_init = false;
+u64 s_icount = 0;
+u64 s_reg_lw[NUM_REGS];
+std::vector<u64> s_mem1, s_mem2, s_locked;  // last write per 4-byte word
+std::vector<Frame> s_stack;
+std::vector<Scan> s_scans;
+std::vector<Candidate> s_candidates[2];
+std::unordered_map<u32, std::pair<u32, u64>> s_last_return;  // callee -> (r3, f1)
+u64 s_calls = 0, s_scanned = 0, s_barrier_ends = 0, s_dep_ends[2] = {0, 0}, s_full[2] = {0, 0};
+u64 s_polling = 0;  // calls skipped because they polled a device
+// Two-core schedules are computed per slice of REPORT_EVERY instructions (overlaps spanning two
+// slices are rare and ignored) and added up.
+u64 s_saved_total[2] = {0, 0};
+u64 s_slice_start = 0;
+std::map<u32, u64> s_by_callee_total[2];
+u64 s_next_report = REPORT_EVERY;
+
+// The current instruction.
+int s_reads[48];
+int s_nreads = 0;
+int s_writes[48];
+int s_nwrites = 0;
+u32 s_pc = 0;
+u32 s_msr = 0;
+bool s_is_call = false;
+bool s_barrier = false;
+
+void Init()
+{
+  s_init = true;
+  const char* path = std::getenv("DOLPHIN_ORACLE_OUT");
+  if (!path || !*path)
+    return;
+  s_report = std::fopen(path, "w");
+  if (!s_report)
+    return;
+  s_mem1.assign((32u << 20) / 4, 0);
+  s_mem2.assign((64u << 20) / 4, 0);
+  s_locked.assign((16u << 10) / 4, 0);
+  std::fprintf(s_report, "parallelism oracle: two cores, function-level speculation\n");
+  std::fflush(s_report);
+  g_active = true;
+}
+
+u64* WordSlot(u32 address)
+{
+  // Effective addresses through the BATs (0x8/0xC: MEM1, 0x9/0xD: MEM2) or physical ones (cache
+  // line clears pass those). Anything else - devices, the EFB - is not memory.
+  const u32 region = address >> 28;
+  const u32 offset = address & 0x0FFFFFFF;
+  if (region == 0x8 || region == 0xC || region == 0x0)
+    return offset < (24u << 20) ? &s_mem1[offset >> 2] : nullptr;
+  if (region == 0x9 || region == 0xD || region == 0x1)
+    return offset < (64u << 20) ? &s_mem2[offset >> 2] : nullptr;
+  if ((address & 0xFFFFC000) == 0xE0000000)
+    return &s_locked[(address & 0x3FFF) >> 2];
+  return nullptr;
+}
+
+void Add(int* list, int* n, int reg)
+{
+  if (*n < 48)
+    list[(*n)++] = reg;
+}
+
+// Instructions a speculative continuation can't run past.
+bool IsBarrier(UGeckoInstruction inst)
+{
+  switch (inst.OPCD)
+  {
+  case 17:  // sc
+    return true;
+  case 19:
+    return inst.SUBOP10 == 50 || inst.SUBOP10 == 150;  // rfi, isync
+  case 31:
+    switch (inst.SUBOP10)
+    {
+    case 146:  // mtmsr
+    case 210:  // mtsr
+    case 242:  // mtsrin
+    case 306:  // tlbie
+    case 470:  // dcbi
+    case 598:  // sync
+    case 854:  // eieio
+    case 982:  // icbi
+      return true;
+    case 467:  // mtspr: only LR, CTR, XER and the GQRs are plain registers
+    {
+      const u32 spr = ((inst.hex >> 16) & 0x1F) | (((inst.hex >> 11) & 0x1F) << 5);
+      return !(spr == 1 || spr == 8 || spr == 9 || (spr >= 912 && spr <= 919));
+    }
+    default:
+      return false;
+    }
+  default:
+    return false;
+  }
+}
+
+void Decode(UGeckoInstruction inst, const GekkoOPInfo* opinfo)
+{
+  s_nreads = s_nwrites = 0;
+  const u64 flags = opinfo->flags;
+  if ((flags & FL_IN_A) || ((flags & FL_IN_A0) && inst.RA != 0))
+    Add(s_reads, &s_nreads, REG_GPR + inst.RA);
+  if (flags & FL_IN_B)
+    Add(s_reads, &s_nreads, REG_GPR + inst.RB);
+  if (flags & FL_IN_C)
+    Add(s_reads, &s_nreads, REG_GPR + inst.RC);
+  if (flags & FL_IN_S)
+    Add(s_reads, &s_nreads, REG_GPR + inst.RS);
+  if (flags & FL_OUT_A)
+    Add(s_writes, &s_nwrites, REG_GPR + inst.RA);
+  if (flags & FL_OUT_D)
+    Add(s_writes, &s_nwrites, REG_GPR + inst.RD);
+  if (inst.OPCD == 46)  // lmw
+  {
+    for (u32 r = inst.RD; r < 32; r++)
+      Add(s_writes, &s_nwrites, REG_GPR + r);
+  }
+  else if (inst.OPCD == 47)  // stmw
+  {
+    for (u32 r = inst.RS; r < 32; r++)
+      Add(s_reads, &s_nreads, REG_GPR + r);
+  }
+  if (flags & FL_IN_FLOAT_A)
+    Add(s_reads, &s_nreads, REG_FPR + inst.FA);
+  if (flags & FL_IN_FLOAT_B)
+    Add(s_reads, &s_nreads, REG_FPR + inst.FB);
+  if (flags & FL_IN_FLOAT_C)
+    Add(s_reads, &s_nreads, REG_FPR + inst.FC);
+  if (flags & FL_IN_FLOAT_D)
+    Add(s_reads, &s_nreads, REG_FPR + inst.FD);
+  if (flags & FL_IN_FLOAT_S)
+    Add(s_reads, &s_nreads, REG_FPR + inst.FS);
+  if (flags & FL_OUT_FLOAT_D)
+    Add(s_writes, &s_nwrites, REG_FPR + inst.FD);
+  // Condition register fields.
+  if (flags & FL_READ_ALL_CR)
+  {
+    for (int f = 0; f < 8; f++)
+      Add(s_reads, &s_nreads, REG_CR + f);
+  }
+  else if (flags & FL_READ_CRn)
+    Add(s_reads, &s_nreads, REG_CR + inst.CRFS);
+  else if (flags & FL_READ_CR_BI)
+    Add(s_reads, &s_nreads, REG_CR + (inst.BI >> 2));
+  else if (opinfo->type == OpType::CR)
+  {
+    Add(s_reads, &s_nreads, REG_CR + (inst.CRBA >> 2));
+    Add(s_reads, &s_nreads, REG_CR + (inst.CRBB >> 2));
+    Add(s_reads, &s_nreads, REG_CR + (inst.CRBD >> 2));
+  }
+  if (flags & FL_SET_ALL_CR)
+  {
+    for (int f = 0; f < 8; f++)
+      Add(s_writes, &s_nwrites, REG_CR + f);
+  }
+  else if (flags & FL_SET_CRn)
+    Add(s_writes, &s_nwrites, REG_CR + inst.CRFD);
+  else if ((flags & FL_SET_CR0) || ((flags & FL_RC_BIT) && inst.Rc))
+    Add(s_writes, &s_nwrites, REG_CR + 0);
+  else if ((flags & FL_SET_CR1) || ((flags & FL_RC_BIT_F) && inst.Rc))
+    Add(s_writes, &s_nwrites, REG_CR + 1);
+  else if (opinfo->type == OpType::CR)
+    Add(s_writes, &s_nwrites, REG_CR + (inst.CRBD >> 2));
+  if (flags & FL_READ_CA)
+    Add(s_reads, &s_nreads, REG_XER);
+  if (flags & FL_SET_CA)
+    Add(s_writes, &s_nwrites, REG_XER);
+  // Branches: LR and CTR.
+  s_is_call = false;
+  if (inst.OPCD == 18 || inst.OPCD == 16 || (inst.OPCD == 19 && (inst.SUBOP10 == 16 ||
+                                                                 inst.SUBOP10 == 528)))
+  {
+    if (inst.LK)
+    {
+      Add(s_writes, &s_nwrites, REG_LR);
+      s_is_call = true;
+    }
+    if (inst.OPCD == 19 && inst.SUBOP10 == 16)
+      Add(s_reads, &s_nreads, REG_LR);
+    if (inst.OPCD == 19 && inst.SUBOP10 == 528)
+      Add(s_reads, &s_nreads, REG_CTR);
+    if ((inst.OPCD == 16 || (inst.OPCD == 19 && inst.SUBOP10 == 16)) &&
+        !(inst.BO & BO_DONT_DECREMENT_FLAG))
+    {
+      Add(s_reads, &s_nreads, REG_CTR);
+      Add(s_writes, &s_nwrites, REG_CTR);
+    }
+  }
+  // mfspr / mtspr
+  if (inst.OPCD == 31 && (inst.SUBOP10 == 339 || inst.SUBOP10 == 467))
+  {
+    const u32 spr = ((inst.hex >> 16) & 0x1F) | (((inst.hex >> 11) & 0x1F) << 5);
+    const int reg = spr == 8 ? REG_LR : spr == 9 ? REG_CTR : spr == 1 ? REG_XER : REG_SPR + spr;
+    if (inst.SUBOP10 == 339)
+      Add(s_reads, &s_nreads, reg);
+    else
+      Add(s_writes, &s_nwrites, reg);
+  }
+}
+
+void EndScan(Scan& scan, int variant)
+{
+  if (!scan.alive[variant])
+    return;
+  scan.alive[variant] = false;
+  const u64 overlap = std::min(scan.len[variant], scan.budget);
+  if (overlap >= MIN_OVERLAP)
+    s_candidates[variant].push_back({scan.t_call, scan.t_call + overlap, overlap, scan.callee});
+}
+
+void StopAll()
+{
+  for (Scan& scan : s_scans)
+  {
+    EndScan(scan, 0);
+    EndScan(scan, 1);
+  }
+  s_barrier_ends += s_scans.size();
+  s_scans.clear();
+}
+
+void CheckRead(int reg)
+{
+  const u64 lw = s_reg_lw[reg];
+  for (Scan& scan : s_scans)
+  {
+    if (lw < scan.t_call || lw >= scan.t_ret)
+      continue;
+    if (scan.alive[0] && !scan.ignore[reg])
+    {
+      EndScan(scan, 0);
+      s_dep_ends[0]++;
+    }
+    if (scan.alive[1] && !scan.ignore_pred[reg])
+    {
+      EndScan(scan, 1);
+      s_dep_ends[1]++;
+    }
+  }
+}
+
+// Weighted interval scheduling: the best set of non-overlapping overlaps for one extra core.
+u64 BestSchedule(std::vector<Candidate>& list, std::map<u32, u64>* by_callee)
+{
+  std::sort(list.begin(), list.end(),
+            [](const Candidate& a, const Candidate& b) { return a.end < b.end; });
+  const size_t n = list.size();
+  std::vector<u64> best(n + 1, 0);
+  std::vector<size_t> prev(n);
+  for (size_t i = 0; i < n; i++)
+  {
+    // The last candidate ending at or before this one starts.
+    size_t lo = 0, hi = i;
+    while (lo < hi)
+    {
+      const size_t mid = (lo + hi) / 2;
+      if (list[mid].end <= list[i].start)
+        lo = mid + 1;
+      else
+        hi = mid;
+    }
+    prev[i] = lo;  // candidates [0, lo) are compatible
+    best[i + 1] = std::max(best[i], list[i].weight + best[lo]);
+  }
+  if (by_callee)
+  {
+    for (size_t i = n; i > 0;)
+    {
+      if (best[i] == best[i - 1])
+      {
+        i--;
+        continue;
+      }
+      (*by_callee)[list[i - 1].callee] += list[i - 1].weight;
+      i = prev[i - 1];
+    }
+  }
+  return best[n];
+}
+
+void Report()
+{
+  if (!s_report)
+    return;
+  const u64 slice = s_icount - s_slice_start;
+  std::fprintf(s_report,
+               "\n== %llu instructions (slice of %llu): %llu calls, %llu continuations measured, "
+               "%llu polling calls skipped\n",
+               static_cast<unsigned long long>(s_icount), static_cast<unsigned long long>(slice),
+               static_cast<unsigned long long>(s_calls), static_cast<unsigned long long>(s_scanned),
+               static_cast<unsigned long long>(s_polling));
+  static const char* const names[2] = {"strict", "return-value prediction"};
+  for (int v = 0; v < 2; v++)
+  {
+    std::map<u32, u64> by_callee;
+    const u64 saved = BestSchedule(s_candidates[v], &by_callee);
+    s_candidates[v].clear();
+    s_saved_total[v] += saved;
+    for (const auto& [callee, weight] : by_callee)
+      s_by_callee_total[v][callee] += weight;
+    const auto speedup = [](u64 total, u64 overlapped) {
+      return total > overlapped ? static_cast<double>(total) / static_cast<double>(total - overlapped) :
+                                  0.0;
+    };
+    std::fprintf(s_report, "  %s: slice %.1f%% overlapped (%.3fx), whole run %.1f%% (%.3fx)\n",
+                 names[v], 100.0 * saved / std::max<u64>(slice, 1), speedup(slice, saved),
+                 100.0 * s_saved_total[v] / std::max<u64>(s_icount, 1),
+                 speedup(s_icount, s_saved_total[v]));
+    std::vector<std::pair<u64, u32>> top;
+    for (const auto& [callee, weight] : by_callee)
+      top.push_back({weight, callee});
+    std::sort(top.rbegin(), top.rend());
+    for (size_t i = 0; i < top.size() && i < 5; i++)
+    {
+      std::fprintf(s_report, "    function %08x: %.2f%% of the slice\n", top[i].second,
+                   100.0 * top[i].first / std::max<u64>(slice, 1));
+    }
+  }
+  s_slice_start = s_icount;
+  s_polling = 0;
+  std::fflush(s_report);
+}
+}  // namespace
+
+void BeforeInstruction(const PowerPC::PowerPCState& ppc, UGeckoInstruction inst,
+                       const GekkoOPInfo* opinfo)
+{
+  if (!s_init)
+    Init();
+  if (!g_active)
+    return;
+  s_pc = ppc.pc;
+  s_msr = ppc.msr.Hex;
+
+  // Returning from a function: its continuation starts here.
+  while (!s_stack.empty())
+  {
+    size_t match = s_stack.size();
+    for (size_t i = s_stack.size(); i > 0 && s_stack.size() - i < 8; i--)
+    {
+      if (s_stack[i - 1].return_pc == ppc.pc && s_stack[i - 1].sp == ppc.gpr[1])
+      {
+        match = i - 1;
+        break;
+      }
+    }
+    if (match == s_stack.size())
+      break;
+    const Frame frame = s_stack[match];
+    s_stack.resize(match);
+    const u64 duration = s_icount - frame.t_call;
+    if (frame.device_read)
+    {
+      s_polling++;
+      break;
+    }
+    if (duration < MIN_CALLEE)
+      break;
+    if (s_scans.size() >= MAX_SCANS)
+    {
+      EndScan(s_scans.front(), 0);
+      EndScan(s_scans.front(), 1);
+      s_scans.erase(s_scans.begin());
+    }
+    Scan scan;
+    scan.callee = frame.callee;
+    scan.t_call = frame.t_call;
+    scan.t_ret = s_icount;
+    scan.budget = duration;
+    for (int r = 0; r < 32; r++)
+    {
+      if (ppc.gpr[r] == frame.gpr[r])
+        scan.ignore[REG_GPR + r] = true;
+      if (ppc.ps[r].PS0AsU64() == frame.fpr[r])
+        scan.ignore[REG_FPR + r] = true;
+    }
+    const u32 cr = ppc.cr.Get();
+    for (int f = 0; f < 8; f++)
+    {
+      if (((cr ^ frame.cr) >> (28 - 4 * f) & 0xF) == 0)
+        scan.ignore[REG_CR + f] = true;
+    }
+    scan.ignore_pred = scan.ignore;
+    auto& last = s_last_return[frame.callee];
+    const u32 r3 = ppc.gpr[3];
+    const u64 f1 = ppc.ps[1].PS0AsU64();
+    if (last.first == r3)
+      scan.ignore_pred[REG_GPR + 3] = true;
+    if (last.second == f1)
+      scan.ignore_pred[REG_FPR + 1] = true;
+    last = {r3, f1};
+    s_scans.push_back(scan);
+    s_scanned++;
+    break;
+  }
+
+  Decode(inst, opinfo);
+  s_barrier = IsBarrier(inst);
+  if (s_barrier)
+  {
+    StopAll();
+    return;
+  }
+  for (int i = 0; i < s_nreads; i++)
+    CheckRead(s_reads[i]);
+}
+
+void OnMemory(u32 address, u32 size, bool write)
+{
+  u64* slot = WordSlot(address);
+  if (!slot)
+  {
+    StopAll();  // a device access: no speculation past it
+    if (!write)
+    {
+      for (Frame& frame : s_stack)
+        frame.device_read = true;
+    }
+    return;
+  }
+  const u32 words = (size + (address & 3) + 3) / 4;
+  for (u32 w = 0; w < words; w++)
+  {
+    u64* word = WordSlot((address & ~3u) + 4 * w);
+    if (!word)
+      continue;
+    if (write)
+    {
+      *word = s_icount;
+      continue;
+    }
+    const u64 lw = *word;
+    for (Scan& scan : s_scans)
+    {
+      if (lw < scan.t_call || lw >= scan.t_ret)
+        continue;
+      for (int v = 0; v < 2; v++)
+      {
+        if (scan.alive[v])
+        {
+          EndScan(scan, v);
+          s_dep_ends[v]++;
+        }
+      }
+    }
+  }
+}
+
+void AfterInstruction(const PowerPC::PowerPCState& ppc)
+{
+  if (!g_active)
+    return;
+  // Continuations that got past this instruction ran it on the second core.
+  for (Scan& scan : s_scans)
+  {
+    for (int v = 0; v < 2; v++)
+    {
+      if (!scan.alive[v])
+        continue;
+      if (++scan.len[v] >= scan.budget)
+      {
+        EndScan(scan, v);
+        s_full[v]++;
+      }
+    }
+  }
+  s_scans.erase(std::remove_if(s_scans.begin(), s_scans.end(),
+                               [](const Scan& s) { return !s.alive[0] && !s.alive[1]; }),
+                s_scans.end());
+  for (int i = 0; i < s_nwrites; i++)
+    s_reg_lw[s_writes[i]] = s_icount;
+
+  // An exception or interrupt (the machine state changed, or execution jumped to a vector).
+  if (ppc.msr.Hex != s_msr || (ppc.pc < 0x80003000 && (ppc.pc & 0xFF) == 0 && ppc.pc >= 0x80000100 &&
+                               !s_is_call))
+  {
+    StopAll();
+  }
+  else if (s_is_call && ppc.pc != s_pc + 4)
+  {
+    // A taken call: remember the state the function must give back.
+    s_calls++;
+    if (s_stack.size() >= MAX_DEPTH)
+      s_stack.erase(s_stack.begin());
+    Frame frame;
+    frame.return_pc = s_pc + 4;
+    frame.sp = ppc.gpr[1];
+    frame.callee = ppc.pc;
+    frame.t_call = s_icount + 1;
+    frame.device_read = false;
+    std::memcpy(frame.gpr, ppc.gpr, sizeof(frame.gpr));
+    for (int r = 0; r < 32; r++)
+      frame.fpr[r] = ppc.ps[r].PS0AsU64();
+    frame.cr = ppc.cr.Get();
+    s_stack.push_back(frame);
+  }
+
+  s_icount++;
+  if (s_icount >= s_next_report)
+  {
+    s_next_report += REPORT_EVERY;
+    Report();
+  }
+}
+}  // namespace ParallelismOracle
