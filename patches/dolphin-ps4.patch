+  // LZO states are from Dolphin 5.0 and older.
+  if (header.legacy_header.lzo_size != 0 || !f.ReadArray(&header.version_header, 1))
+    return PS4Slot::OtherVersion;
+  const u32 length = header.version_header.version_string_length;
+  if (made_by != nullptr && length < 256)
+  {
+    made_by->assign(length, '\0');
+    if (!f.ReadBytes(made_by->data(), length))
+      made_by->clear();
+  }
+  if (header.version_header.version_cookie != COOKIE_BASE + STATE_COOKIE_VERSION)
+    return PS4Slot::OtherVersion;
+  return PS4Slot::Ready;
+}
