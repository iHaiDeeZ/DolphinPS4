+// The running program: the installed one, or a downloaded update (restarts start it again).
+// Common/FileUtil.cpp (GetExePath, so the update's Sys is used), PS4IngameMenu.cpp.
+extern "C" const char* ps4_self_path()
+{
+  static const std::string path = s_running_update ? UPDATE_DIR + "/eboot.bin" : "/app0/eboot.bin";
+  return path.c_str();
+}
+
+// The running program's xmb/ and Sys/ (VideoCommon/OnScreenUI.cpp: the in-game menu's fonts).
+extern "C" const char* ps4_assets_dir()
+{
+  static const std::string dir = AssetsDir();
+  return dir.c_str();
+}
