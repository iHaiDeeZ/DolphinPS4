+extern "C" void ps4_boot_trace(const char* line);
+
+// PS4: a new thread runs on the cores of the thread that created it - for these workers the
+// video thread's single core. Shader compiles then competed with the video thread for it
+// (hitches while new effects appeared) and, with the system's scheduler letting a busy thread
+// keep its core, starved other threads the video thread started: Super Smash Bros. Melee
+// waited 16 s at boot while 619 cached pipelines compiled. The workers run on the cores that
+// the CPU, video, Vulkan and audio threads don't use (0 and 1 by default).
+static void PS4MoveToSpareCores()
+{
+  unsigned long long mask = 0x3F;  // the game cores, 0-5
+  for (const int core :
+       {ps4_cpu_thread_core, ps4_gpu_thread_core, ps4_vk_thread_core, ps4_audio_thread_core})
+  {
+    if (core >= 0 && core < 6)
+      mask &= ~(1ULL << core);
+  }
+  if (mask == 0)
+    mask = 0x3F;
+  // The seventh core (6), which the system partly lends to games, as well: one worker per
+  // spare core. If the system won't give it to this app, the game cores alone.
+  int result = Common::PS4SetCurrentThreadCoreMask(mask | (1ULL << 6));
+  if (result == 0)
+  {
+    mask |= 1ULL << 6;
+  }
+  else
+  {
+    const int with_core_6 = result;
+    result = Common::PS4SetCurrentThreadCoreMask(mask);
+    static std::atomic<bool> s_logged_refusal{false};
+    if (!s_logged_refusal.exchange(true))
+    {
+      char line[96];
+      snprintf(line, sizeof(line), "shader compiler workers: core 6 refused (0x%x)",
+               with_core_6);
+      ps4_boot_trace(line);
+    }
+  }
+  // Below the default priority (700): the system lets a busy thread keep its core against
+  // threads of the same priority, so two compiling workers held cores 0 and 1 until the whole
+  // shader cache was compiled and anything else waiting there (Melee's start: 5 s) waited too.
+  Common::PS4SetCurrentThreadCoreAndPriority(-1, 750);
+  static std::atomic<bool> s_logged{false};
+  if (!s_logged.exchange(true))
+  {
+    char line[96];
+    snprintf(line, sizeof(line), "shader compiler workers: cores mask 0x%llx (result 0x%x)", mask,
+             result);
+    ps4_boot_trace(line);
+  }
