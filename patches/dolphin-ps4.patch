+void Menu::BuildGames(const std::vector<LibraryDisc>& library)
+{
+  // Titles: GameTDB's list shipped in Sys (full names instead of the discs' internal ones).
+  std::map<std::string, std::string> titles;
+  {
+    std::ifstream file(m_assets_dir + "/Sys/wiitdb-en.txt");
+    std::string line;
+    while (std::getline(file, line))
+    {
+      const size_t eq = line.find(" = ");
+      if (eq != std::string::npos && eq <= 6)
+      {
+        std::string title = line.substr(eq + 3);
+        while (!title.empty() && (title.back() == '\r' || title.back() == ' '))
+          title.pop_back();
+        titles[line.substr(0, eq)] = title;
+      }
+    }
+  }
+  // One entry per game: discs with the same ID and revision belong together (disc 1 starts).
+  std::map<std::string, size_t> by_id;
+  for (const LibraryDisc& disc : library)
+  {
+    const std::string key =
+        disc.game_id.empty() ? disc.path : disc.game_id + "/" + std::to_string(disc.revision);
+    auto existing = by_id.find(key);
+    if (existing != by_id.end())
+    {
+      Game& game = m_games[existing->second];
+      game.discs++;
+      if (disc.disc == 0)
+        game.path = disc.path;
+      continue;
+    }
+    Game game;
+    game.path = disc.path;
+    game.id = disc.game_id;
+    game.revision = disc.revision;
+    game.title = disc.title.empty() ? std::filesystem::path(disc.path).stem().string() : disc.title;
+    for (const std::string& id : {disc.game_id, disc.game_id.substr(0, 4)})
+    {
+      auto title = titles.find(id);
+      if (!id.empty() && title != titles.end())
+      {
+        game.title = title->second;
+        break;
+      }
+    }
+    by_id[key] = m_games.size();
+    m_games.push_back(std::move(game));
+  }
+  std::sort(m_games.begin(), m_games.end(),
+            [](const Game& a, const Game& b) { return a.title < b.title; });
+}
