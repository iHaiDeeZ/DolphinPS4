+ImTextureID Menu::LoadPngTexture(const std::string& path, float* aspect)
+{
+  const std::string data = ReadFile(path);
+  if (data.empty())
+    return ImTextureID{};
+  Common::UniqueBuffer<u8> pixels;
+  u32 width = 0, height = 0;
+  if (!Common::LoadPNG(std::span(reinterpret_cast<const u8*>(data.data()), data.size()), &pixels,
+                       &width, &height))
+  {
+    Log("not a PNG: " + path);
+    return ImTextureID{};
+  }
+  if (aspect)
+    *aspect = static_cast<float>(width) / static_cast<float>(height);
+  return m_display.CreateTexture(pixels.data(), width, height);
+}
