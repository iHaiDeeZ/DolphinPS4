+// VideoCommon/OnScreenUI.cpp: fonts for Japanese, Chinese and Korean text (PS4Lang).
+extern "C" int ps4_lang_font_count(int bold)
+{
+  return static_cast<int>(PS4Lang::ExtraFonts(AssetsDir(), bold != 0).size());
+}
+extern "C" const char* ps4_lang_font(int bold, int index)
+{
+  static std::vector<std::string> s_fonts[2];
+  s_fonts[bold != 0] = PS4Lang::ExtraFonts(AssetsDir(), bold != 0);
+  return index < static_cast<int>(s_fonts[bold != 0].size()) ? s_fonts[bold != 0][index].c_str() :
+                                                                 nullptr;
+}
+
+// MainNoGUI: the game didn't start.
+extern "C" void ps4_boot_failed(int unreadable)
+{
+  s_boot_failed = true;
+  if (unreadable)
+  {
+    WriteStopNote("Something Is Wrong With This Game File",
+                  "Dolphin couldn't read it. The file is damaged, incomplete, or not a GameCube / Wii game.",
+                  "Check it in PC Dolphin (right-click > Properties > Verify) or convert it "
+                  "again, then copy it to the PS4 again.");
+  }
+  else
+  {
+    WriteStopNote("Game Not Started", "Dolphin couldn't start this game.",
+                  "Details are in dolphin.log and boot-trace.log (in /data/DolphinPS4).");
+  }
+}
+
+// port/ps4_crashlog.cpp, after crash.log.
+extern "C" void ps4_crash_note(int sig)
+{
+  if (s_exiting)
+    return;
+  const char* what = sig == 11 ? "The game crashed (invalid memory access)." :
+                     sig == 10 ? "The game crashed (bus error)." :
+                     sig == 4  ? "The game crashed (illegal instruction)." :
+                     sig == 8  ? "The game crashed (arithmetic error)." :
+                     sig == 6  ? "The game crashed (Dolphin stopped on an error)." :
+                                 "The game crashed.";
+  WriteStopNote("Game Crashed", what,
+                "Details are in crash.log and boot-trace.log (in /data/DolphinPS4).");
+}
+
+extern "C" void ps4_crash_restart()
+{
+  if (s_exiting)
+  {
+    // Already on the way out: wait for that restart rather than end in the crash report.
+    for (;;)
+      sceKernelUsleep(100000);
+  }
+  if (!s_stop_game[0])
+    return;
+  s_exiting = 1;
+  // A restart can be refused while the system is busy: once more after a moment.
+  for (int attempt = 0; attempt < 3; attempt++)
+  {
+    sceSystemServiceLoadExec(ps4_self_path(), nullptr);
+    sceKernelUsleep(500000);
+  }
+}
+
+// Restarts that should show the menu (a game quit to it, the menu restarted itself) leave this
+// note; without it the app was opened from the home screen, and the default game starts.
+const std::string TO_MENU = std::string(PS4_DATA_DIR_PATH) + "/to-menu.txt";
+extern "C" void ps4_return_to_menu()
+{
+  if (FILE* file = fopen(TO_MENU.c_str(), "w"))
+    fclose(file);
+}
+
+// The game this process booted (its first disc). The in-game menu's Restart Game: launch.txt
+// names it again, so the restarted app boots it the way the menu starts games.
+std::string s_booted_game;
+// launch.txt's "disc=" line: the disc in the drive while a homebrew program runs (Play Online
+// with Wiimmfi: the Wiimmfi Patcher patches that game and starts it).
+std::string s_launch_disc;
+extern "C" void ps4_relaunch_game()
+{
+  if (s_booted_game.empty())
+  {
+    ps4_return_to_menu();
+    return;
+  }
+  if (FILE* file = fopen((std::string(PS4_DATA_DIR_PATH) + "/launch.txt").c_str(), "w"))
+  {
+    fprintf(file, "%s\n", s_booted_game.c_str());
+    if (!s_launch_disc.empty())
+      fprintf(file, "disc=%s\n", s_launch_disc.c_str());
+    fclose(file);
+  }
+}
