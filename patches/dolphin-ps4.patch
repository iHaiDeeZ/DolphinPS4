+std::string Platform::GetPS4Option(const std::string& key, const std::string& default_value)
+{
+  const auto it = s_options.find(key);
+  return it == s_options.end() ? default_value : it->second;
+}
+
+extern "C" int ps4_pad_count;  // InputCommon/ControllerInterface/PS4Pad/PS4Pad.cpp
+
+// A game sees exactly the controllers that are there: player 1's port / Wii Remote always, and
+// one more for each other signed-in user with a DualShock 4. A player who joins mid-game gets
+// the next port (Dolphin checks the ports at every controller poll; a Wii Remote connects when
+// its player presses a button); one who signs out is unplugged.
+void Platform::ApplyPS4Players()
+{
+  const int players = std::clamp(ps4_pad_count, 1, 4);
+  for (int i = 0; i < 4; i++)
+  {
+    const auto si = i < players ? SerialInterface::SIDEVICE_GC_CONTROLLER :
+                                  SerialInterface::SIDEVICE_NONE;
+    if (Config::Get(Config::GetInfoForSIDevice(i)) != si)
+      Config::SetBase(Config::GetInfoForSIDevice(i), si);
+    const auto source = i < players ? WiimoteSource::Emulated : WiimoteSource::None;
+    if (Config::Get(Config::GetInfoForWiimoteSource(i)) != source)
+      Config::SetBase(Config::GetInfoForWiimoteSource(i), source);
+  }
+  BootTrace(fmt::format("players: {} (GameCube ports / Wii Remotes in use)", players).c_str());
+}
+
+// The signed-in users, to notice a player joining or leaving (cheap; checked about once a
+// second by the main loop).
+std::array<int32_t, 4> PS4LoginUsers()
+{
+  OrbisUserServiceLoginUserIdList users;
+  std::memset(&users, 0xFF, sizeof(users));
+  sceUserServiceGetLoginUserIdList(&users);
+  std::array<int32_t, 4> out;
+  for (size_t i = 0; i < out.size(); i++)
+    out[i] = users.userId[i];
+  return out;
+}
+
+std::vector<std::string> Platform::GetPS4Arguments()
+{
+  BootTrace("main");
+  mkdir(PS4_DATA_DIR_PATH, 0777);
+  mkdir((std::string(PS4_DATA_DIR_PATH) + "/games").c_str(), 0777);
+
+  // stdout/stderr go nowhere on PS4: send them to a file, unbuffered so it survives a crash.
+  // (Not freopen: the OpenOrbis libc's freopen frees the static stderr FILE and output is lost.)
+  const int log_fd =
+      open((std::string(PS4_DATA_DIR_PATH) +
+            (access((std::string(PS4_DATA_DIR_PATH) + "/launch.txt").c_str(), F_OK) == 0 ?
+                 "/dolphin.log" :      // starting a game (launch.txt from the XMB)
+                 "/xmb-stderr.log"))  // the XMB: keeps the last game's log
+               .c_str(),
+           O_WRONLY | O_CREAT | O_TRUNC, 0666);
+  if (log_fd >= 0)
+  {
+    dup2(log_fd, STDOUT_FILENO);
+    dup2(log_fd, STDERR_FILENO);
+    close(log_fd);
+  }
+  setvbuf(stdout, nullptr, _IONBF, 0);
+  setvbuf(stderr, nullptr, _IONBF, 0);
+  atexit(OnExit);
+  BootTrace("log opened");
+
+  BootTrace(("app version " + AppVersion()).c_str());
+  LoadOptions();
+  // The menus' settings (settings.ini) over ps4.ini's global options; settings never changed in
+  // the menus keep ps4.ini's values (PS4Settings.h has the full order).
+  s_ps4_global = s_options;
+  PS4Settings::Load(PS4_DATA_DIR_PATH);
+  PS4Settings::SetBaseLookup([](const std::string& key) {
+    const auto it = s_ps4_global.find(key);
+    return it == s_ps4_global.end() ? std::string() : it->second;
+  });
+  PS4Settings::SetGameBaseLookup(
+      [](const std::string& game_id, const std::string& key) { return GameOption(game_id, key); });
+  for (const auto& [key, value] : PS4Settings::GlobalValues())
+    s_options[key] = value;
+  for (const auto& [key, value] : s_options)
+    BootTrace(("option " + key + "=" + value).c_str());
+  ps4_jit_in_system_pool = GetPS4Option("jit_memory", "system") == "system" ? 1 : 0;
+
+  const std::string user_dir = std::string(PS4_DATA_DIR_PATH) + "/User";
+  WriteDefaultConfig(user_dir);
+  std::vector<std::string> args = {"dolphin-emu-nogui", "--platform=ps4", "--user=" + user_dir};
+  // The XMB (PS4XMB.cpp) runs first. The game it picks is written to launch.txt and the app
+  // restarts itself into Dolphin, so the menu and the emulator never share a process; the
+  // restarted app finds launch.txt and boots that game. ps4.ini xmb=off: the old automatic
+  // start (boot.txt or the first game).
+  std::string game;
+  const std::string launch_path = std::string(PS4_DATA_DIR_PATH) + "/launch.txt";
+  if (FILE* file = fopen(launch_path.c_str(), "r"))
+  {
+    char line[1024] = {};
+    if (fgets(line, sizeof(line), file))
+      game = line;
+    fclose(file);
+    std::remove(launch_path.c_str());
+    while (!game.empty() && (game.back() == '\n' || game.back() == '\r'))
+      game.pop_back();
+    BootTrace(("launch: " + game).c_str());
+  }
+  else if (GetPS4Option("xmb", "on") == "on")
+  {
+    LoadSystemModules();
+    // The XMB scans the games folder itself (again on a refresh or a new folder).
+    const PS4XMB::ScanFunction scan = [](const std::string& games_dir) {
+      std::vector<PS4XMB::LibraryDisc> library;
+      for (const LibraryEntry& entry : ScanLibrary(games_dir))
+        library.push_back({entry.path, entry.game_id, entry.revision, entry.disc, entry.title});
+      return library;
+    };
+    game = PS4XMB::Run(scan, PS4_DATA_DIR_PATH, "/app0", AppVersion());
+    if (game == PS4XMB::EXIT_APP)
+    {
+      // An update is installing in the background: the app closes so it can be replaced.
+      BootTrace("xmb: closing the app for an update");
+      fflush(stderr);
+      sceSystemServiceLoadExec("exit", nullptr);
+      for (;;)
+        sceKernelUsleep(100000);
+    }
+    if (game.empty())
+    {
+      // The menu couldn't start: the old automatic start, so the app stays usable.
+      BootTrace("xmb: unavailable, starting boot.txt / the first game");
+      game = FindGame();
+    }
+    else if (FILE* file = fopen(launch_path.c_str(), "w"))
+    {
+      fprintf(file, "%s\n", game.c_str());
+      fclose(file);
+      BootTrace("xmb: restarting into the game");
+      fflush(stderr);
+      const int result = sceSystemServiceLoadExec("/app0/eboot.bin", nullptr);
+      // Still here: the restart failed. Start the game in this process instead.
+      char text[96];
+      snprintf(text, sizeof(text), "xmb: sceSystemServiceLoadExec failed (%#x), booting here",
+               static_cast<unsigned>(result));
+      BootTrace(text);
+      std::remove(launch_path.c_str());
+    }
+  }
+  else
+  {
+    game = FindGame();
+  }
+  if (game.empty())
+  {
+    fprintf(stderr, "[dolphin] no game: put one in %s/games or its path in %s/boot.txt\n",
+            PS4_DATA_DIR_PATH, PS4_DATA_DIR_PATH);
+  }
+  else
+  {
+    for (const std::string& disc : FindAllDiscs(game))
+    {
+      fprintf(stderr, "[dolphin] booting %s\n", disc.c_str());
+      BootTrace(("boot: " + disc).c_str());
+      args.push_back("--exec=" + disc);
+    }
+    // Per-game ps4.ini sections: the game's 3-character ID first, then its full ID.
+    for (const LibraryEntry& entry : GameLibrary())
+    {
+      if (std::filesystem::path(entry.path) != std::filesystem::path(game) ||
+          entry.game_id.size() < 3)
+        continue;
+      for (const std::string& id : {entry.game_id.substr(0, 3), entry.game_id})
+      {
+        const auto section = s_game_options.find(id);
+        if (section == s_game_options.end())
+          continue;
+        for (const auto& [key, value] : section->second)
+        {
+          s_options[key] = value;
+          BootTrace(("option [" + id + "] " + key + "=" + value).c_str());
+        }
+      }
+      // The game's own menu settings, when it is set to custom.
+      if (PS4Settings::IsCustom(entry.game_id))
+      {
+        for (const auto& [key, value] : PS4Settings::GameValues(entry.game_id))
+        {
+          s_options[key] = value;
+          BootTrace(("setting [" + entry.game_id + "] " + key + "=" + value).c_str());
+        }
+      }
+      break;
+    }
+  }
+  // The Wii Remote's attachment and orientation for this game (WiimoteNew.ini, read by Dolphin
+  // when it starts).
+  PS4Controls::SetWiiAttachment(GetPS4Option("wii_extension", "nunchuk"),
+                                GetPS4Option("wii_sideways", "off") == "on");
+  // Speed Features: Compatible turns off the command-stream shortcuts (freezes and missing menu
+  // items in Crash Tag Team Racing and FIFA Street 2 came from them).
+  if (GetPS4Option("speed_mode", "fast") == "compatible")
+  {
+    for (const char* key : {"fifo_defer", "jit_gp_fuse", "jit_lazy_lfs", "fifo_batch"})
+      s_options[key] = "off";
+    BootTrace("speed features: compatible");
+  }
+  return args;
+}
