+void Menu::DrawHints(ImDrawList* dl)
+{
+  const Theme& theme = CurrentTheme();
+  const ImU32 text = Rgba(theme.text, 0.85f);
+  float x = W - 120;
+  const float y = H - 80;
+  auto hint = [&](const char* label, int glyph) {
+    const float tw = TextWidth(m_font, 28, label);
+    x -= tw;
+    Text(dl, m_font, 28, ImVec2(x, y - 17), text, label);
+    x -= 46;
+    const ImVec2 c(x + 18, y);
+    dl->AddCircleFilled(c, 17, Rgba(theme.text, 0.18f), 24);
+    const ImU32 g = text;
+    switch (glyph)
+    {
+    case 0:  // cross
+      dl->AddLine(ImVec2(c.x - 8, c.y - 8), ImVec2(c.x + 8, c.y + 8), g, 3.0f);
+      dl->AddLine(ImVec2(c.x - 8, c.y + 8), ImVec2(c.x + 8, c.y - 8), g, 3.0f);
+      break;
+    case 1:  // circle
+      dl->AddCircle(c, 8.5f, g, 20, 3.0f);
+      break;
+    case 2:  // triangle
+      dl->AddTriangle(ImVec2(c.x, c.y - 9), ImVec2(c.x + 9, c.y + 7), ImVec2(c.x - 9, c.y + 7), g,
+                      3.0f);
+      break;
+    case 3:  // square
+      dl->AddRect(ImVec2(c.x - 7.5f, c.y - 7.5f), ImVec2(c.x + 7.5f, c.y + 7.5f), g, 0.0f, 0, 3.0f);
+      break;
+    }
+    x -= 50;
+  };
+  if (m_panel.open)
+  {
+    hint("Back", 1);
+    if (!m_panel.options.empty())
+      hint("Select", 0);
+    if (!m_panel.rows.empty())
+      hint("Change", 0);
+  }
+  else
+  {
+    const auto& items = m_items[m_category];
+    const bool game = !items.empty() && items[m_selected[m_category]].game >= 0;
+    if (m_category == static_cast<int>(Category::Games))
+      hint("Refresh", 3);
+    if (game)
+      hint("Options", 2);
+    hint(game ? "Play" : "Select", 0);
+  }
+}
+
+void Menu::Draw(float dt)
+{
+  DrawBackground();
+  ImDrawList* dl = ImGui::GetForegroundDrawList();
+  const Theme& theme = CurrentTheme();
+
+  Approach(m_category_pos, static_cast<float>(m_category), 12.0f, dt);
+  for (int c = 0; c < CATEGORY_COUNT; c++)
+    Approach(m_item_pos[c], static_cast<float>(m_selected[c]), 14.0f, dt);
+
+  // Categories: the selected one sits at x = 470, the others spaced to the left and right.
+  const float row_y = 250.0f;
+  const float spacing = 240.0f;
+  for (int c = 0; c < CATEGORY_COUNT; c++)
+  {
+    const float offset = static_cast<float>(c) - m_category_pos;
+    const float x = 470.0f + offset * spacing;
+    const float focus = std::max(0.0f, 1.0f - std::abs(offset));
+    const float size = 92.0f + 34.0f * focus;
+    const float alpha = 0.55f + 0.45f * focus;
+    DrawCategoryIcon(dl, static_cast<Category>(c), ImVec2(x, row_y), size,
+                     Rgba(theme.text, alpha));
+    if (focus > 0.05f)
+    {
+      const float tw = TextWidth(m_font, 32, CATEGORY_NAMES[c]);
+      Text(dl, m_font, 32, ImVec2(x - tw * 0.5f, row_y + 76), Rgba(theme.text, focus),
+           CATEGORY_NAMES[c]);
+    }
+  }
+
+  // Items of the selected category (blended into the neighbour while switching).
+  const int c = m_category;
+  const float switch_alpha = std::max(0.0f, 1.0f - std::abs(m_category_pos - c) * 2.0f);
+  const auto& items = m_items[c];
+  for (int i = 0; i < static_cast<int>(items.size()); i++)
+  {
+    const float rel = static_cast<float>(i) - m_item_pos[c];
+    float y;
+    float alpha;
+    if (rel >= -0.5f)
+    {
+      // The selected item and the ones after it, below the category row.
+      y = 470.0f + rel * 120.0f + (rel > 0.5f ? 40.0f : rel * 80.0f);
+      alpha = rel < 0.5f ? 1.0f : std::max(0.0f, 0.85f - (rel - 1.0f) * 0.12f);
+    }
+    else
+    {
+      // Earlier items, stacked above the category row.
+      y = 120.0f + (rel + 1.0f) * 100.0f;
+      alpha = std::max(0.0f, 0.55f + (rel + 1.0f) * 0.2f);
+    }
+    if (y < -80.0f || y > H + 80.0f || alpha <= 0.01f)
+      continue;
+    DrawItem(dl, items[i], y, i == m_selected[c], alpha * switch_alpha);
+  }
+
+  // Clock (top right).
+  if (m_prefs.clock)
+  {
+    const std::time_t now = std::time(nullptr);
+    std::tm local = {};
+    localtime_r(&now, &local);
+    char clock[32];
+    std::strftime(clock, sizeof(clock), "%H:%M", &local);
+    const float tw = TextWidth(m_bold, 40, clock);
+    Text(dl, m_bold, 40, ImVec2(W - 110 - tw, 70), Rgba(theme.text, 0.95f), clock);
+  }
+  if (m_logo != ImTextureID{})
+  {
+    dl->AddImage(ImTextureRef(m_logo), ImVec2(80, 60), ImVec2(140, 120), ImVec2(0, 0),
+                 ImVec2(1, 1), IM_COL32(255, 255, 255, 200));
+  }
+
+  DrawSidePanel(dl, dt);
+  DrawHints(dl);
+
+  // Fades: in at start, out when a game launches.
+  if (m_launch >= 0)
+  {
+    m_launch_time += dt;
+    m_fade = std::min(1.0f, m_launch_time / 0.7f);
+  }
+  else
+  {
+    Approach(m_fade, 0.0f, 6.0f, dt);
+  }
+  if (m_fade > 0.005f)
+    dl->AddRectFilled(ImVec2(0, 0), ImVec2(W, H), IM_COL32(0, 0, 0, static_cast<int>(m_fade * 255)));
+  DrawIntro(dl, dt);
+}
+
+void Menu::DrawIntro(ImDrawList* dl, float dt)
+{
+  if (!m_intro)
+    return;
+  if (m_intro_dolphin == ImTextureID{})
+  {
+    m_intro = false;  // the images are missing: no intro
+    return;
+  }
+  if (m_intro_time == 0.0f)
+    Play("intro");
+  m_intro_time += dt;
+  const float t = m_intro_time;
+  constexpr float LAND = 0.95f, OUT_START = 1.9f, END = 2.5f;
+  if (t >= END)
+  {
+    m_intro = false;
+    return;
+  }
+  auto clamp01 = [](float v) { return std::clamp(v, 0.0f, 1.0f); };
+  auto smooth = [](float v) { return v * v * (3.0f - 2.0f * v); };
+  auto alpha = [](float a) { return static_cast<int>(std::clamp(a, 0.0f, 1.0f) * 255.0f); };
+  const float out = smooth(clamp01((t - OUT_START) / (END - OUT_START)));
+  const float vis = 1.0f - out;
+
+  // Night-sea background with a soft glow where the dolphin lands.
+  const ImVec2 centre(W * 0.5f, H * 0.40f);
+  dl->AddRectFilledMultiColor(ImVec2(0, 0), ImVec2(W, H), IM_COL32(4, 10, 28, alpha(vis)),
+                              IM_COL32(4, 10, 28, alpha(vis)), IM_COL32(0, 0, 0, alpha(vis)),
+                              IM_COL32(0, 0, 0, alpha(vis)));
+  const float glow = clamp01((t - 0.3f) / 0.8f) * vis;
+  for (int i = 0; i < 6; i++)
+  {
+    const float r = 260.0f + i * 70.0f;
+    dl->AddCircleFilled(centre, r, IM_COL32(60, 110, 190, alpha(0.05f * glow)), 64);
+  }
+
+  // The leap: from below the bottom-right corner, over an arc, head first (the artwork faces
+  // left), easing out into the centre; the body follows the arc and levels out as it lands.
+  const float p = 1.0f - std::pow(1.0f - clamp01((t - 0.05f) / (LAND - 0.05f)), 3.0f);
+  const ImVec2 p0(W * 0.98f, H * 1.10f), p1(W * 0.70f, H * -0.05f), p2 = centre;
+  const float u = 1.0f - p;
+  ImVec2 pos(u * u * p0.x + 2 * u * p * p1.x + p * p * p2.x,
+             u * u * p0.y + 2 * u * p * p1.y + p * p * p2.y);
+  const ImVec2 vel(2 * u * (p1.x - p0.x) + 2 * p * (p2.x - p1.x),
+                   2 * u * (p1.y - p0.y) + 2 * p * (p2.y - p1.y));
+  const float heading = std::atan2(vel.y, vel.x) - 3.14159265f;  // the head points -x
+  float angle = std::remainder(heading, 6.2831853f) * (1.0f - p);
+  // After landing it floats gently.
+  if (t > LAND)
+    pos.y += std::sin((t - LAND) * 3.2f) * 6.0f * clamp01((t - LAND) / 0.3f);
+  const float scale = (0.55f + 0.45f * p) * (1.0f + 0.12f * out);
+  const float dw = 760.0f * scale, dh = dw / m_intro_dolphin_aspect;
+  const float c = std::cos(angle), s = std::sin(angle);
+  auto corner = [&](float x, float y) {
+    return ImVec2(pos.x + x * c - y * s, pos.y + x * s + y * c);
+  };
+  const int dolphin_alpha = alpha(clamp01((t - 0.05f) / 0.25f) * vis);
+  dl->AddImageQuad(ImTextureRef(m_intro_dolphin), corner(-dw / 2, -dh / 2), corner(dw / 2, -dh / 2),
+                   corner(dw / 2, dh / 2), corner(-dw / 2, dh / 2), ImVec2(0, 0), ImVec2(1, 0),
+                   ImVec2(1, 1), ImVec2(0, 1), IM_COL32(255, 255, 255, dolphin_alpha));
+
+  // Ripples spreading out where it landed (flattened rings, cyan and pink like the artwork).
+  for (int i = 0; i < 3; i++)
+  {
+    const float q = clamp01((t - LAND - i * 0.18f) / 1.0f);
+    if (q <= 0.0f || q >= 1.0f)
+      continue;
+    const float r = 120.0f + 620.0f * (1.0f - (1.0f - q) * (1.0f - q));
+    const ImU32 colour = i % 2 == 0 ? IM_COL32(110, 220, 255, alpha(0.55f * (1.0f - q) * vis)) :
+                                      IM_COL32(255, 170, 210, alpha(0.45f * (1.0f - q) * vis));
+    dl->AddEllipse(ImVec2(centre.x, centre.y + 175.0f), ImVec2(r, r * 0.16f), colour, 0.0f, 96,
+                   3.0f);
+  }
+
+  // The title rises into place under the dolphin.
+  if (m_intro_title != ImTextureID{})
+  {
+    const float q = smooth(clamp01((t - 1.0f) / 0.45f));
+    const float tw = 820.0f, th = tw / m_intro_title_aspect;
+    const ImVec2 at(W * 0.5f - tw / 2, H * 0.71f + 24.0f * (1.0f - q));
+    dl->AddImage(ImTextureRef(m_intro_title), at, ImVec2(at.x + tw, at.y + th), ImVec2(0, 0),
+                 ImVec2(1, 1), IM_COL32(255, 255, 255, alpha(q * vis)));
+  }
+}
