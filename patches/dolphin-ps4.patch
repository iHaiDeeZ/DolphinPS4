+void Menu::DrawItem(ImDrawList* dl, const Item& item, float y, bool selected, float alpha)
+{
+  const Theme& theme = CurrentTheme();
+  const float x = 470.0f;  // under the selected category icon
+  const float icon_h = selected ? 96.0f : 72.0f;
+  const float icon_w = icon_h * 3.0f;
+  const ImVec2 icon_min(x - icon_w * 0.5f, y - icon_h * 0.5f);
+  const ImVec2 icon_max(x + icon_w * 0.5f, y + icon_h * 0.5f);
+  const ImU32 text = Rgba(theme.text, alpha);
+
+  if (item.game >= 0)
+  {
+    const Game& game = m_games[item.game];
+    if (game.cover != ImTextureID{})
+    {
+      // Box art, upright, centred where the banner would be.
+      const float ch = selected ? 150.0f : 112.0f;
+      const float cw = ch * game.cover_aspect;
+      const ImVec2 cmin(x - cw * 0.5f, y - ch * 0.5f), cmax(x + cw * 0.5f, y + ch * 0.5f);
+      dl->AddRectFilled(ImVec2(cmin.x + 4, cmin.y + 6), ImVec2(cmax.x + 4, cmax.y + 6),
+                        IM_COL32(0, 0, 0, static_cast<int>(alpha * 90)), 6.0f);
+      dl->AddImageRounded(ImTextureRef(game.cover), cmin, cmax, ImVec2(0, 0), ImVec2(1, 1),
+                          IM_COL32(255, 255, 255, static_cast<int>(alpha * 255)), 6.0f);
+      if (selected)
+        dl->AddRect(cmin, cmax, Rgba(theme.text, alpha * 0.9f), 6.0f, 0, 3.0f);
+      // (no banner frame below)
+    }
+    else if (game.banner != ImTextureID{})
+    {
+      dl->AddImageRounded(ImTextureRef(game.banner), icon_min, icon_max, ImVec2(0, 0),
+                          ImVec2(1, 1), IM_COL32(255, 255, 255, static_cast<int>(alpha * 255)),
+                          8.0f);
+    }
+    else
+    {
+      // No banner: a tile in the platform's colour with Dolphin's platform icon.
+      const ImU32 tile = game.wii ? Rgba(0xF4F6F8, alpha * 0.95f) : Rgba(0x5B3FC4, alpha * 0.95f);
+      dl->AddRectFilled(icon_min, icon_max, tile, 8.0f);
+      const ImTextureID platform = game.wii ? m_icon_wii : m_icon_gc;
+      if (platform != ImTextureID{})
+      {
+        const float s = icon_h * 0.8f;
+        const ImU32 tint = game.wii ? IM_COL32(60, 70, 85, static_cast<int>(alpha * 255)) :
+                                      IM_COL32(255, 255, 255, static_cast<int>(alpha * 255));
+        dl->AddImage(ImTextureRef(platform), ImVec2(x - s * 0.5f, y - s * 0.5f),
+                     ImVec2(x + s * 0.5f, y + s * 0.5f), ImVec2(0, 0), ImVec2(1, 1), tint);
+      }
+    }
+    if (selected && game.cover == ImTextureID{})
+      dl->AddRect(icon_min, icon_max, Rgba(theme.text, alpha * 0.9f), 8.0f, 0, 3.0f);
+  }
+  else if (!item.ach_key.empty())
+  {
+    const float b = icon_h * 0.95f;
+    if (item.icon != ImTextureID{})
+    {
+      dl->AddImageRounded(ImTextureRef(item.icon), ImVec2(x - b * 0.5f, y - b * 0.5f),
+                          ImVec2(x + b * 0.5f, y + b * 0.5f), ImVec2(0, 0), ImVec2(1, 1),
+                          IM_COL32(255, 255, 255, static_cast<int>(alpha * 255)), 8.0f);
+    }
+    else
+    {
+      DrawCategoryIcon(dl, Category::Achievements, ImVec2(x, y), b * 0.8f, text);
+    }
+    if (selected)
+    {
+      dl->AddRect(ImVec2(x - b * 0.5f, y - b * 0.5f), ImVec2(x + b * 0.5f, y + b * 0.5f),
+                  Rgba(theme.text, alpha * 0.9f), 8.0f, 0, 3.0f);
+    }
+  }
+  else if (item.theme != -1)
+  {
+    // Theme swatch.
+    if (item.theme >= 0)
+    {
+      const Theme& t = THEMES[item.theme];
+      dl->AddRectFilledMultiColor(icon_min, icon_max, Rgba(t.top, alpha), Rgba(t.top, alpha),
+                                  Rgba(t.bottom, alpha), Rgba(t.bottom, alpha));
+      dl->AddLine(ImVec2(icon_min.x + 10, y + 6), ImVec2(icon_max.x - 10, y - 8),
+                  Rgba(t.wave, alpha), 4.0f);
+    }
+    else
+    {
+      dl->AddRectFilled(icon_min, icon_max, Rgba(0x404650, alpha), 8.0f);
+      Text(dl, m_bold, 26, ImVec2(x - 40, y - 15), Rgba(0xFFFFFF, alpha), "PNG", false);
+    }
+    dl->AddRect(icon_min, icon_max, Rgba(theme.text, alpha * (selected ? 0.9f : 0.4f)), 6.0f, 0,
+                selected ? 3.0f : 1.5f);
+  }
+  else if (item.card != -1)
+  {
+    if (item.card == CARD_NEW)
+    {
+      dl->AddCircle(ImVec2(x, y), icon_h * 0.34f, text, 40, 4.0f);
+      dl->AddLine(ImVec2(x - icon_h * 0.16f, y), ImVec2(x + icon_h * 0.16f, y), text, 5.0f);
+      dl->AddLine(ImVec2(x, y - icon_h * 0.16f), ImVec2(x, y + icon_h * 0.16f), text, 5.0f);
+    }
+    else
+    {
+      const bool in_slot = m_cards[item.card].name == m_slot_a;
+      DrawMemoryCardIcon(dl, ImVec2(x, y), icon_h * 0.9f,
+                         in_slot ? Rgba(theme.wave, alpha) : Rgba(0x8A90A0, alpha),
+                         Rgba(0xFFFFFF, alpha * 0.85f));
+    }
+  }
+  else
+  {
+    // Settings: a small round icon.
+    dl->AddCircle(ImVec2(x, y), icon_h * 0.32f, text, 32, 4.0f);
+    dl->AddCircleFilled(ImVec2(x, y), icon_h * 0.12f, text, 20);
+  }
+
+  const float tx = x + icon_w * 0.5f + 36.0f;
+  const float title_size = selected ? 46.0f : 36.0f;
+  Text(dl, m_bold, title_size, ImVec2(tx, y - title_size * 0.62f), text, item.label);
+  float sx = tx;
+  const float sub_y = y + title_size * 0.42f;
+  if (item.game >= 0)
+  {
+    // Platform tag: purple GAMECUBE, white Wii.
+    const Game& game = m_games[item.game];
+    const char* tag = game.wii ? "Wii" : "GAMECUBE";
+    const float tag_size = 22.0f;
+    const float tw = TextWidth(m_bold, tag_size, tag);
+    const ImU32 bg = game.wii ? Rgba(0xFFFFFF, alpha) : Rgba(0x7B4DFF, alpha);
+    const ImU32 fg = game.wii ? Rgba(0x2A2F36, alpha) : Rgba(0xFFFFFF, alpha);
+    dl->AddRectFilled(ImVec2(sx, sub_y + 2), ImVec2(sx + tw + 24, sub_y + 32), bg, 15.0f);
+    Text(dl, m_bold, tag_size, ImVec2(sx + 12, sub_y + 4), fg, tag, false);
+    sx += tw + 40;
+  }
+  if (!item.detail.empty())
+    Text(dl, m_font, 26.0f, ImVec2(sx, sub_y + 1), Rgba(theme.text, alpha * 0.75f), item.detail);
+}
+
+void Menu::DrawSidePanel(ImDrawList* dl, float dt)
+{
+  Approach(m_panel.slide, m_panel.open ? 1.0f : 0.0f, 16.0f, dt);
+  if (m_panel.slide < 0.01f)
+    return;
+  if (m_panel.highlight < 0.0f)
+    m_panel.highlight = static_cast<float>(m_panel.selected);
+  Approach(m_panel.highlight, static_cast<float>(m_panel.selected), 18.0f, dt);
+  const Theme& theme = CurrentTheme();
+  const float width = m_panel.rows.empty() ? 620.0f : 860.0f;
+  const float x0 = W - width * m_panel.slide;
+  const bool light = theme.text != 0xFFFFFF;
+  dl->AddRectFilled(ImVec2(x0, 0), ImVec2(W, H),
+                    light ? Rgba(0xFFFFFF, 0.85f * m_panel.slide) :
+                            Rgba(0x000000, 0.72f * m_panel.slide));
+  dl->AddLine(ImVec2(x0, 0), ImVec2(x0, H), Rgba(theme.wave, 0.8f * m_panel.slide), 2.0f);
+  const ImU32 text = Rgba(theme.text, m_panel.slide);
+  float y = 230;
+  {
+    const std::string title = WrapText(m_bold, 40, PS4Lang::T(m_panel.title), width - 100);
+    float ty = 140;
+    size_t start = 0;
+    for (size_t end; start <= title.size(); start = end + 1)
+    {
+      end = title.find('\n', start);
+      if (end == std::string::npos)
+        end = title.size();
+      Text(dl, m_bold, 40, ImVec2(x0 + 50, ty), text, title.substr(start, end - start));
+      ty += 50;
+    }
+    y = std::max(y, ty + 40);
+  }
+  if (!m_panel.options.empty())
+  {
+    {
+      const float hy = y + m_panel.highlight * 62.0f;
+      RowBox(dl, ImVec2(x0 + 30, hy - 6), ImVec2(W - 30, hy + 52), true, m_panel.slide);
+    }
+    for (size_t i = 0; i < m_panel.options.size(); i++, y += 62)
+    {
+      const bool sel = static_cast<int>(i) == m_panel.selected;
+      Text(dl, sel ? m_bold : m_font, 34, ImVec2(x0 + 60, y), text, m_panel.options[i]);
+    }
+  }
+  for (const std::string& line : m_panel.rows.empty() ? m_panel.lines : std::vector<std::string>{})
+  {
+    const std::string wrapped = WrapText(m_font, 28, PS4Lang::T(line), width - 100);
+    size_t start = 0;
+    for (size_t end; start <= wrapped.size(); start = end + 1)
+    {
+      end = wrapped.find('\n', start);
+      if (end == std::string::npos)
+        end = wrapped.size();
+      Text(dl, m_font, 28, ImVec2(x0 + 50, y), text, wrapped.substr(start, end - start));
+      y += 42;
+    }
+  }
+  if (!m_panel.rows.empty())
+  {
+    // Settings list, scrolling with the selection; the setting's help text below it.
+    const float row_h = 58.0f, top = 220.0f, bottom = H - 200.0f;
+    const float visible = (bottom - top) / row_h;
+    const float target =
+        std::clamp(static_cast<float>(m_panel.selected) - visible * 0.5f + 1.0f, 0.0f,
+                   std::max(0.0f, static_cast<float>(m_panel.rows.size()) - visible));
+    Approach(m_panel.scroll, target, 16.0f, dt);
+    dl->PushClipRect(ImVec2(x0, top - 8), ImVec2(W, bottom + 8), true);
+    if (m_panel.selected >= 0 && m_panel.selected < static_cast<int>(m_panel.rows.size()) &&
+        !m_panel.rows[m_panel.selected].header)
+    {
+      const float hy = top + (m_panel.highlight - m_panel.scroll) * row_h;
+      RowBox(dl, ImVec2(x0 + 30, hy - 4), ImVec2(W - 30, hy + 50), true, m_panel.slide);
+    }
+    for (size_t i = 0; i < m_panel.rows.size(); i++)
+    {
+      const SettingRow& row = m_panel.rows[i];
+      const float ry = top + (static_cast<float>(i) - m_panel.scroll) * row_h;
+      if (ry < top - row_h || ry > bottom)
+        continue;
+      if (row.header)
+      {
+        Text(dl, m_bold, 26, ImVec2(x0 + 50, ry + 14), Rgba(theme.wave, m_panel.slide), row.label,
+             false);
+        dl->AddLine(ImVec2(x0 + 50, ry + 50), ImVec2(W - 50, ry + 50),
+                    Rgba(theme.wave, 0.35f * m_panel.slide), 1.5f);
+        continue;
+      }
+      const bool sel = static_cast<int>(i) == m_panel.selected;
+      // The label leans in as the selection reaches it.
+      const float focus = std::max(0.0f, 1.0f - std::abs(static_cast<float>(i) - m_panel.highlight));
+      float label_x = x0 + 60 + 8.0f * focus;
+      if (row.icon != ImTextureID{})
+      {
+        dl->AddImage(ImTextureRef(row.icon), ImVec2(label_x, ry + 3), ImVec2(label_x + 40, ry + 43),
+                     ImVec2(0, 0), ImVec2(1, 1), IM_COL32(255, 255, 255, static_cast<int>(255 * m_panel.slide)));
+        label_x += 54;
+      }
+      Text(dl, sel ? m_bold : m_font, sel ? 32.0f : 30.0f, ImVec2(label_x, ry + 4), text,
+           row.label);
+      // Controls: the DualShock 4 control's icon instead of its name (names without an icon,
+      // such as combinations, stay text).
+      constexpr float GLYPH_H = 38.0f;
+      const float gw = row.glyph.empty() || (sel && m_capture) ?
+                           0.0f :
+                           PS4Glyphs::Width(row.glyph, GLYPH_H);
+      if (row.tag != 0)
+      {
+        // Cheats: a green ON or red OFF tag.
+        const char* label = row.tag > 0 ? "ON" : "OFF";
+        const float tw = TextWidth(m_bold, 24, label);
+        const float right = W - 70, w = tw + 30;
+        const ImU32 fill = row.tag > 0 ? Rgba(0x28AA5A, 0.9f * m_panel.slide) :
+                                         Rgba(0xD23746, 0.9f * m_panel.slide);
+        dl->AddRectFilled(ImVec2(right - w, ry + 6), ImVec2(right, ry + 42), fill, 18.0f);
+        Text(dl, m_bold, 24, ImVec2(right - w + 15, ry + 11), Rgba(0xFFFFFF, m_panel.slide),
+             label);
+      }
+      else if (gw > 0.0f)
+      {
+        PS4Glyphs::Draw(dl, m_bold, row.glyph, W - 70 - gw, ry + 23, GLYPH_H, m_panel.slide);
+      }
+      else
+      {
+        const float tw = TextWidth(m_font, 28, row.value);
+        const ImU32 colour = row.note ? Rgba(0xFFC870, m_panel.slide) : text;
+        Text(dl, m_font, 28, ImVec2(W - 70 - tw, ry + 7), colour, row.value);
+      }
+    }
+    dl->PopClipRect();
+    if (m_panel.selected >= 0 && m_panel.selected < static_cast<int>(m_panel.rows.size()))
+    {
+      const SettingRow& row = m_panel.rows[m_panel.selected];
+      std::string help;
+      if (m_capture)
+        help = "Press the DualShock 4 button for " + row.label + "...  (5 s: cancel)";
+      else if (!m_combo_key.empty())
+        help = "Hold the buttons for " + row.label + " together, then let go (two or more; "
+               "Circle alone: cancel)";
+      else if (row.key.rfind("ctl:", 0) == 0)
+        help = "Cross: press a new button for it. Sticks: Left/Right to choose.";
+      else if (row.key == "__ctlreset__")
+        help = "Back to the default layout.";
+      else if (row.key.rfind("dir:", 0) == 0)
+        help = "Cross: open this folder.";
+      else if (row.key == "usedir")
+        help = "Cross: look for games in this folder.";
+      else if (row.key == "card:use")
+        help = "Cross: games use this card from their next start. Your other cards stay as they are.";
+      else if (row.key == "card:in")
+        help = "Games save to this card. Pick another card and put it in Slot A to switch.";
+      else if (row.key.rfind("save:", 0) == 0 && m_card_panel >= 0 &&
+               m_card_panel < static_cast<int>(m_cards.size()))
+      {
+        const auto& saves = m_cards[m_card_panel].saves;
+        const size_t index = std::strtoul(row.key.c_str() + 5, nullptr, 10);
+        if (index < saves.size())
+        {
+          const PS4MemoryCards::Save& save = saves[index];
+          help = save.description.empty() ? save.title : save.description;
+          help += "\n" + save.game_id + "  -  " + save.region + "  -  " +
+                  std::to_string(save.blocks) + (save.blocks == 1 ? " block" : " blocks") +
+                  "  -  saved " + DateText(save.modified);
+        }
+      }
+      else if (row.key == "center:update")
+        help = "Downloads the latest recommended settings from GitHub now (Dolphin also does it at every start).";
+      else if (row.key.rfind("center:game:", 0) == 0)
+      {
+        const size_t i = std::strtoul(row.key.c_str() + 12, nullptr, 10);
+        if (i < m_games.size())
+        {
+          if (const CenterEntry* entry = CenterFor(m_games[i].id))
+            help = CenterSummary(*entry) + ". " + entry->comment;
+        }
+      }
+      else if (row.key == "center:this")
+      {
+        if (const CenterEntry* entry = CenterFor(m_panel.game_id))
+          help = CenterSummary(*entry) + ". " + entry->comment;
+      }
+      else if (row.key == "cheatdl")
+        help = "Gets this game's Gecko codes from the internet (codes.rc24.xyz). New ones are added switched off.";
+      else if (row.key.rfind("cheat:", 0) == 0 || row.key.rfind("cheatall:", 0) == 0)
+        help = "Applies the next time the game starts, or now from the in-game menu (L3+R3).";
+      else if (row.key.rfind("riiv:", 0) == 0)
+        help = "Applies the next time the game starts.";
+      else if (row.key == "patchdl")
+        help = "Dolphin's newest patches for this game, checked on GitHub when this page opens; "
+               "new ones are added as Dolphin ships them.";
+      else if (row.key.rfind("patch:", 0) == 0)
+        help = "A fix or speed hack from Dolphin for this game. Applies the next time the game "
+               "starts.";
+      else if (row.key.rfind("gmod:", 0) == 0 && m_graphics_mods)
+      {
+        const size_t index = std::strtoul(row.key.c_str() + 5, nullptr, 10);
+        const auto& mods = m_graphics_mods->GetMods();
+        if (index < mods.size())
+        {
+          help = mods[index].m_description +
+                 " Costs speed: with any mod on, every draw is checked (Super Mario Galaxy ran at "
+                 "half speed with Bloom Removal). Applies the next time the game starts.";
+        }
+      }
+      else if (row.key.rfind("ach:", 0) == 0)
+      {
+        const size_t index = std::strtoul(row.key.c_str() + 4, nullptr, 10);
+        if (index < m_ach_view.entries.size())
+        {
+          const PS4Achievements::Entry& entry = m_ach_view.entries[index];
+          help = entry.description;
+          if (!entry.progress.empty())
+            help += "  (" + entry.progress + ")";
+          if (*PS4Achievements::TypeName(entry.type))
+            help += std::string("  -  ") + PS4Achievements::TypeName(entry.type);
+          if (entry.rarity >= 0.0f)
+          {
+            char rarity[48];
+            snprintf(rarity, sizeof(rarity), "  -  %.1f%% of players", entry.rarity);
+            help += rarity;
+          }
+          if (entry.unlocked && entry.unlock_time > 0)
+            help += "\nUnlocked " + DateText(entry.unlock_time);
+        }
+      }
+      else if (row.key == "ra:info")
+        help = "Your retroachievements.org account (free to make on the website).";
+      else if (row.key == "ra:user")
+        help = "Cross: type your retroachievements.org username.";
+      else if (row.key == "ra:login")
+        help = "Cross: type your password. It is sent once; only the login token is kept. "
+               "No connection? Check the PS4's date and time.";
+      else if (row.key == "ra:logout")
+        help = "Forgets the login on this PS4.";
+      else if (row.key == "ra:enabled")
+        help = "Achievements unlock while you play (needs a logged-in account). See them with "
+               "L3+R3 in the game, or Triangle on the game. Next game start.";
+      else if (row.key == "ra:demo")
+        help = "Sample achievements in every game, one unlocking every 25 seconds: to try the list "
+               "(L3+R3), the pop-ups and the Achievements pages. Next game start.";
+      else if (row.key == "ra:hardcore")
+        help = "No save states, cheats or slow motion - unlocks count double. Next game start.";
+      else if (row.scope)
+        help = "All Games: this game follows the global settings. This Game: its own.";
+      else if (const PS4Settings::Setting* setting = PS4Settings::Find(row.key))
+        help = std::string(setting->help) + (setting->live ? "" : " (Next game start.)");
+      if (help.empty())
+      {
+        // Pages with their own description (Wii Menu): shown here, under the list.
+        for (const std::string& line : m_panel.lines)
+          help += (help.empty() ? "" : " ") + line;
+      }
+      const std::string wrapped = WrapText(m_font, 25, PS4Lang::T(help), width - 100);
+      dl->AddText(m_font, 25, ImVec2(x0 + 50, bottom + 24), Rgba(theme.text, 0.8f * m_panel.slide),
+                  wrapped.c_str());
+    }
+  }
+}
+
+void Menu::DrawHints(ImDrawList* dl)
+{
+  const Theme& theme = CurrentTheme();
+  const ImU32 text = Rgba(theme.text, 0.85f);
+  float x = W - 120;
+  const float y = H - 80;
+  auto hint = [&](const char* label, int glyph) {
+    const float tw = TextWidth(m_font, 28, label);
+    x -= tw;
+    Text(dl, m_font, 28, ImVec2(x, y - 17), text, label);
+    x -= 46;
+    const ImVec2 c(x + 18, y);
+    dl->AddCircleFilled(c, 17, Rgba(theme.text, 0.18f), 24);
+    const ImU32 g = text;
+    switch (glyph)
+    {
+    case 0:  // cross
+      dl->AddLine(ImVec2(c.x - 8, c.y - 8), ImVec2(c.x + 8, c.y + 8), g, 3.0f);
+      dl->AddLine(ImVec2(c.x - 8, c.y + 8), ImVec2(c.x + 8, c.y - 8), g, 3.0f);
+      break;
+    case 1:  // circle
+      dl->AddCircle(c, 8.5f, g, 20, 3.0f);
+      break;
+    case 2:  // triangle
+      dl->AddTriangle(ImVec2(c.x, c.y - 9), ImVec2(c.x + 9, c.y + 7), ImVec2(c.x - 9, c.y + 7), g,
+                      3.0f);
+      break;
+    case 3:  // square
+      dl->AddRect(ImVec2(c.x - 7.5f, c.y - 7.5f), ImVec2(c.x + 7.5f, c.y + 7.5f), g, 0.0f, 0, 3.0f);
+      break;
+    }
+    x -= 50;
+  };
+  if (m_panel.open)
+  {
+    hint("Back", 1);
+    if (!m_panel.options.empty())
+      hint("Select", 0);
+    if (!m_panel.rows.empty())
+      hint("Change", 0);
+    if (m_panel.setting == SET_CONTROLS)
+      hint("Clear", 3);
+  }
+  else
+  {
+    const auto& items = m_items[m_category];
+    const bool game = !items.empty() && items[m_selected[m_category]].game >= 0;
+    if (m_category == static_cast<int>(Category::Games))
+      hint("Refresh", 3);
+    if (game)
+      hint("Options", 2);
+    hint(game ? "Play" : "Select", 0);
+  }
+}
+
+void Menu::Draw(float dt)
+{
+  if (Library() && m_prefs.style == "gamecube" && m_wallpaper == ImTextureID{})
+    DrawGameCubeBackground();
+  else if (Library() && m_prefs.style == "wii" && m_wallpaper == ImTextureID{})
+    DrawWiiBackground();
+  else if (Library())
+    DrawLibraryBackground();
+  else
+    DrawBackground();
+  ImDrawList* dl = ImGui::GetForegroundDrawList();
+  const Theme& theme = CurrentTheme();
+
+  Approach(m_category_pos, static_cast<float>(m_category), 12.0f, dt);
+  for (int c = 0; c < CATEGORY_COUNT; c++)
+    Approach(m_item_pos[c], static_cast<float>(m_selected[c]), 14.0f, dt);
+
+  if (Library())
+  {
+    DrawLibrary(dl, dt);
+  }
+  else
+  {
+    // Categories: the selected one sits at x = 470, the others spaced to the left and right.
+    const float row_y = 250.0f;
+    const float spacing = 240.0f;
+    for (int c = 0; c < CATEGORY_COUNT; c++)
+    {
+      const float offset = static_cast<float>(c) - m_category_pos;
+      const float x = 470.0f + offset * spacing;
+      const float focus = std::max(0.0f, 1.0f - std::abs(offset));
+      const float size = 92.0f + 34.0f * focus;
+      const float alpha = 0.55f + 0.45f * focus;
+      DrawCategoryIcon(dl, static_cast<Category>(c), ImVec2(x, row_y), size,
+                       Rgba(theme.text, alpha));
+      if (focus > 0.05f)
+      {
+        const float tw = TextWidth(m_font, 32, CATEGORY_NAMES[c]);
+        Text(dl, m_font, 32, ImVec2(x - tw * 0.5f, row_y + 76), Rgba(theme.text, focus),
+             CATEGORY_NAMES[c]);
+      }
+    }
+
+    // Items of the selected category (blended into the neighbour while switching).
+    const int c = m_category;
+    const float switch_alpha = std::max(0.0f, 1.0f - std::abs(m_category_pos - c) * 2.0f);
+    const auto& items = m_items[c];
+    for (int i = 0; i < static_cast<int>(items.size()); i++)
+    {
+      const float rel = static_cast<float>(i) - m_item_pos[c];
+      float y;
+      float alpha;
+      if (rel >= -0.5f)
+      {
+        // The selected item and the ones after it, below the category row.
+        y = 470.0f + rel * 120.0f + (rel > 0.5f ? 40.0f : rel * 80.0f);
+        alpha = rel < 0.5f ? 1.0f : std::max(0.0f, 0.85f - (rel - 1.0f) * 0.12f);
+      }
+      else
+      {
+        // Earlier items, stacked above the category row.
+        y = 120.0f + (rel + 1.0f) * 100.0f;
+        alpha = std::max(0.0f, 0.55f + (rel + 1.0f) * 0.2f);
+      }
+      if (y < -80.0f || y > H + 80.0f || alpha <= 0.01f)
+        continue;
+      DrawItem(dl, items[i], y, i == m_selected[c], alpha * switch_alpha);
+    }
+
+    // Clock (top right).
+    if (m_prefs.clock)
+    {
+      const std::time_t now = std::time(nullptr);
+      std::tm local = {};
+      localtime_r(&now, &local);
+      char clock[32];
+      std::strftime(clock, sizeof(clock), "%H:%M", &local);
+      const float tw = TextWidth(m_bold, 40, clock);
+      Text(dl, m_bold, 40, ImVec2(W - 110 - tw, 70), Rgba(theme.text, 0.95f), clock);
+      DrawAccountStatus(dl, W - 110 - tw - 44, 94);
+    }
+    else
+    {
+      DrawAccountStatus(dl, W - 110, 94);
+    }
+    if (m_logo != ImTextureID{})
+    {
+      dl->AddImage(ImTextureRef(m_logo), ImVec2(80, 60), ImVec2(140, 120), ImVec2(0, 0),
+                   ImVec2(1, 1), IM_COL32(255, 255, 255, 200));
+    }
+
+  }
+
+  DrawSidePanel(dl, dt);
+  if (Library() && m_panel.slide < 0.5f)
+    DrawLibraryHints(dl);
+  else
+    DrawHints(dl);
+
+  // Fades: in at start, out when a game launches.
+  if (m_launch >= 0)
+  {
+    m_launch_time += dt;
+    m_fade = std::min(1.0f, m_launch_time / 0.7f);
+  }
+  else
+  {
+    Approach(m_fade, 0.0f, 6.0f, dt);
+  }
+  if (m_fade > 0.005f)
+    dl->AddRectFilled(ImVec2(0, 0), ImVec2(W, H), IM_COL32(0, 0, 0, static_cast<int>(m_fade * 255)));
+  DrawIntro(dl, dt);
+}
+
+void Menu::DrawIntro(ImDrawList* dl, float dt)
+{
+  if (!m_intro)
+    return;
+  if (m_intro_dolphin == ImTextureID{})
+  {
+    m_intro = false;  // the images are missing: no intro
+    return;
+  }
+  if (m_intro_time == 0.0f)
+    Play("intro");
+  m_intro_time += dt;
+  const float t = m_intro_time;
+  constexpr float LAND = 0.95f, OUT_START = 1.9f, END = 2.5f;
+  if (t >= END)
+  {
+    m_intro = false;
+    return;
+  }
+  auto clamp01 = [](float v) { return std::clamp(v, 0.0f, 1.0f); };
+  auto smooth = [](float v) { return v * v * (3.0f - 2.0f * v); };
+  auto alpha = [](float a) { return static_cast<int>(std::clamp(a, 0.0f, 1.0f) * 255.0f); };
+  const float out = smooth(clamp01((t - OUT_START) / (END - OUT_START)));
+  const float vis = 1.0f - out;
+
+  // Night sky, deeper at the bottom.
+  const ImVec2 centre(W * 0.5f, H * 0.40f);
+  dl->AddRectFilledMultiColor(ImVec2(0, 0), ImVec2(W, H), IM_COL32(4, 10, 28, alpha(vis)),
+                              IM_COL32(4, 10, 28, alpha(vis)), IM_COL32(0, 0, 0, alpha(vis)),
+                              IM_COL32(0, 0, 0, alpha(vis)));
+
+  // The leap: from below the bottom-right corner, over an arc, head first (the artwork faces
+  // left), easing out into the centre; the body follows the arc and levels out as it lands.
+  const ImVec2 p0(W * 0.98f, H * 1.10f), p1(W * 0.70f, H * -0.05f), p2 = centre;
+  auto path = [&](float q, ImVec2* velocity) {
+    const float v = 1.0f - q;
+    if (velocity)
+    {
+      *velocity = ImVec2(2 * v * (p1.x - p0.x) + 2 * q * (p2.x - p1.x),
+                         2 * v * (p1.y - p0.y) + 2 * q * (p2.y - p1.y));
+    }
+    return ImVec2(v * v * p0.x + 2 * v * q * p1.x + q * q * p2.x,
+                  v * v * p0.y + 2 * v * q * p1.y + q * q * p2.y);
+  };
+  const float p = 1.0f - std::pow(1.0f - clamp01((t - 0.05f) / (LAND - 0.05f)), 3.0f);
+  ImVec2 vel;
+  ImVec2 pos = path(p, &vel);
+  // After landing it floats gently.
+  if (t > LAND)
+    pos.y += std::sin((t - LAND) * 3.2f) * 6.0f * clamp01((t - LAND) / 0.3f);
+
+  // Stardust around the dolphin: soft light (one blurred dot texture, tinted and stretched), no
+  // drawn shapes. Violet, pink, cyan and white; fixed per grain from a hash, so nothing is kept
+  // between frames.
+  static const int PALETTE[4][3] = {{150, 90, 255}, {255, 90, 190}, {70, 200, 255}, {255, 255, 255}};
+  auto hash = [](int i, float k) { return std::abs(std::fmod(std::sin(i * k) * 43758.5453f, 1.0f)); };
+  auto light = [&](float x, float y, float radius, const int* rgb, float a) {
+    if (a <= 0.004f || m_glow == ImTextureID{})
+      return;
+    dl->AddImage(ImTextureRef(m_glow), ImVec2(x - radius, y - radius), ImVec2(x + radius, y + radius),
+                 ImVec2(0, 0), ImVec2(1, 1), IM_COL32(rgb[0], rgb[1], rgb[2], alpha(a)));
+  };
+  const float neb = clamp01((t - 0.1f) / 0.5f) * vis;
+  // A nebula glow clustered around it, swirling slowly, spreading as it fades out.
+  for (int i = 0; i < 22; i++)
+  {
+    const float ang = i * 2.39996f + t * (i % 2 ? 0.35f : -0.28f);
+    const float dist = (70.0f + 190.0f * hash(i, 12.9898f)) * (1.0f + 1.2f * out);
+    light(pos.x + std::cos(ang) * dist * 1.3f, pos.y + std::sin(ang) * dist * 0.75f,
+          130.0f + 170.0f * hash(i, 78.233f), PALETTE[i % 3], 0.13f * neb);
+  }
+  // A swirl of tiny glowing grains (the inner ones faster), twinkling.
+  for (int i = 0; i < 320; i++)
+  {
+    float r = 40.0f + 300.0f * std::pow(hash(i, 39.425f), 0.8f);
+    const float ang = hash(i, 11.13f) * 6.2832f + t * (1.6f - r / 300.0f);
+    r *= 1.0f + 1.6f * out;
+    const float twinkle = 0.5f + 0.5f * std::sin(t * (3.0f + 4.0f * hash(i, 7.7f)) + i);
+    light(pos.x + std::cos(ang) * r * 1.35f, pos.y + std::sin(ang) * r * 0.7f,
+          3.0f + 6.0f * hash(i, 3.3f), PALETTE[i % 4], (0.35f + 0.6f * twinkle) * neb);
+  }
+  // A comet tail of dust along the path behind it, fading out.
+  for (int i = 0; i < 160; i++)
+  {
+    const float k = i / 160.0f;
+    const float q = p - k * 0.45f;
+    if (q < 0.0f)
+      continue;
+    ImVec2 at = path(q, nullptr);
+    const float jitter = 30.0f + 60.0f * k;
+    at.x += (hash(i, 5.1f) - 0.5f) * jitter * 2.0f + k * 40.0f * std::sin(t * 2.0f + i);
+    at.y += (hash(i, 9.7f) - 0.5f) * jitter * 2.0f - (t > LAND ? (t - LAND) * 40.0f * k : 0.0f);
+    light(at.x, at.y, 3.0f + 5.0f * hash(i, 2.2f), PALETTE[i % 4],
+          0.8f * std::pow(1.0f - k, 1.5f) * clamp01((t - 0.05f) / 0.2f) * vis);
+  }
+  // Where it lands: dust bursting out sideways.
+  if (t > LAND)
+  {
+    const float q = clamp01((t - LAND) / 1.1f);
+    for (int i = 0; i < 140; i++)
+    {
+      const float ang = hash(i, 21.7f) * 6.2832f;
+      const float r = (80.0f + 620.0f * hash(i, 4.4f)) * (1.0f - (1.0f - q) * (1.0f - q));
+      light(centre.x + std::cos(ang) * r,
+            centre.y + 175.0f + std::sin(ang) * r * 0.16f - q * 30.0f * hash(i, 8.8f),
+            3.0f + 4.0f * hash(i, 6.6f), PALETTE[(i + 1) % 4], (1.0f - q) * 0.9f * vis);
+    }
+  }
+
+  // The dolphin.
+  const float heading = std::atan2(vel.y, vel.x) - 3.14159265f;  // the head points -x
+  const float angle = std::remainder(heading, 6.2831853f) * (1.0f - p);
+  const float scale = (0.55f + 0.45f * p) * (1.0f + 0.12f * out);
+  const float dw = 760.0f * scale, dh = dw / m_intro_dolphin_aspect;
+  const float c = std::cos(angle), s = std::sin(angle);
+  auto corner = [&](float x, float y) {
+    return ImVec2(pos.x + x * c - y * s, pos.y + x * s + y * c);
+  };
+  const int dolphin_alpha = alpha(clamp01((t - 0.05f) / 0.25f) * vis);
+  dl->AddImageQuad(ImTextureRef(m_intro_dolphin), corner(-dw / 2, -dh / 2), corner(dw / 2, -dh / 2),
+                   corner(dw / 2, dh / 2), corner(-dw / 2, dh / 2), ImVec2(0, 0), ImVec2(1, 0),
+                   ImVec2(1, 1), ImVec2(0, 1), IM_COL32(255, 255, 255, dolphin_alpha));
+
+  // The title rises into place under the dolphin.
+  if (m_intro_title != ImTextureID{})
+  {
+    const float q = smooth(clamp01((t - 1.0f) / 0.45f));
+    const float tw = 820.0f, th = tw / m_intro_title_aspect;
+    const ImVec2 at(W * 0.5f - tw / 2, H * 0.71f + 24.0f * (1.0f - q));
+    dl->AddImage(ImTextureRef(m_intro_title), at, ImVec2(at.x + tw, at.y + th), ImVec2(0, 0),
+                 ImVec2(1, 1), IM_COL32(255, 255, 255, alpha(q * vis)));
+  }
+}
+
+// ---------------------------------------------------------------------------------------------
+// The Library style: the theme's gradient over a grid floor, tabs on top (L1 / R1), the games as
+// a row of covers with the selected one in front, memory cards, and the settings as lists.
+
+void Menu::DrawLibraryBackground()
+{
+  ImDrawList* dl = ImGui::GetBackgroundDrawList();
+  const Theme& theme = CurrentTheme();
+  if (m_wallpaper != ImTextureID{})
+  {
+    dl->AddImage(ImTextureRef(m_wallpaper), ImVec2(0, 0), ImVec2(W, H));
+    dl->AddRectFilled(ImVec2(0, 0), ImVec2(W, H), IM_COL32(0, 0, 0, 110));
+    return;
+  }
+  const ImU32 top = Rgba(theme.top), bottom = Rgba(theme.bottom);
+  const float horizon = 600.0f;
+  dl->AddRectFilledMultiColor(ImVec2(0, 0), ImVec2(W, horizon), bottom, bottom, top, top);
+  dl->AddRectFilledMultiColor(ImVec2(0, horizon), ImVec2(W, H), top, top, bottom, bottom);
+  // Light ribbons drifting slowly across the sky, very faint.
+  for (int r = 0; r < 3; r++)
+  {
+    const float base = 210.0f + r * 95.0f, amplitude = 50.0f + r * 18.0f;
+    const float k = 2.0f * 3.14159265f / (1500.0f + r * 400.0f);
+    const float speed = (r % 2 == 0 ? 0.12f : -0.09f), phase = r * 2.1f;
+    constexpr float STEP = 32.0f;
+    ImVec2 prev_top, prev_bottom;
+    for (float x = -STEP; x <= W + STEP; x += STEP)
+    {
+      const float y = base + amplitude * std::sin(x * k + m_time * speed + phase);
+      const float thick = 70.0f + 40.0f * std::sin(x * k * 0.7f + m_time * 0.2f + phase);
+      const ImVec2 p_top(x, y), p_bottom(x, y + thick);
+      if (x > -STEP)
+      {
+        // Brightest in the middle of the screen.
+        const float mid = 1.0f - std::min(1.0f, std::abs(x - W * 0.5f) / (W * 0.62f));
+        const float a = 0.055f * mid;
+        QuadMultiColor(dl, prev_top, p_top, p_bottom, prev_bottom, Rgba(theme.wave, 0.0f),
+                       Rgba(theme.wave, 0.0f), Rgba(theme.wave, a), Rgba(theme.wave, a));
+      }
+      prev_top = p_top;
+      prev_bottom = p_bottom;
+    }
+  }
+
+  // The floor: glossy, lit from the horizon, with a pool of light under the covers.
+  dl->AddRectFilledMultiColor(ImVec2(0, horizon), ImVec2(W, H), Rgba(theme.wave, 0.10f),
+                              Rgba(theme.wave, 0.10f), Rgba(theme.wave, 0.0f), Rgba(theme.wave, 0.0f));
+  for (int i = 0; i < 8; i++)
+  {
+    dl->AddEllipseFilled(ImVec2(W * 0.5f, 728.0f), ImVec2(160.0f + i * 70.0f, 26.0f + i * 9.0f),
+                         Rgba(theme.wave, 0.028f), 0.0f, 64);
+  }
+  for (int i = 0; i < 6; i++)
+  {
+    dl->AddEllipseFilled(ImVec2(W * 0.5f, horizon), ImVec2(300.0f + i * 140.0f, 110.0f + i * 40.0f),
+                         Rgba(theme.wave, 0.022f), 0.0f, 64);
+  }
+  // The horizon: a thin line of light, fading out towards the edges.
+  {
+    const ImU32 clear = Rgba(theme.wave, 0.0f), bright = Rgba(theme.wave, 0.55f);
+    QuadMultiColor(dl, ImVec2(0, horizon - 1), ImVec2(W * 0.5f, horizon - 1), ImVec2(W * 0.5f, horizon + 1),
+                   ImVec2(0, horizon + 1), clear, bright, bright, clear);
+    QuadMultiColor(dl, ImVec2(W * 0.5f, horizon - 1), ImVec2(W, horizon - 1), ImVec2(W, horizon + 1),
+                   ImVec2(W * 0.5f, horizon + 1), bright, clear, clear, bright);
+    const ImU32 haze = Rgba(theme.wave, 0.12f);
+    QuadMultiColor(dl, ImVec2(W * 0.15f, horizon - 18), ImVec2(W * 0.5f, horizon - 18),
+                   ImVec2(W * 0.5f, horizon), ImVec2(W * 0.15f, horizon), clear, clear, haze, clear);
+    QuadMultiColor(dl, ImVec2(W * 0.5f, horizon - 18), ImVec2(W * 0.85f, horizon - 18),
+                   ImVec2(W * 0.85f, horizon), ImVec2(W * 0.5f, horizon), clear, clear, clear, haze);
+  }
+
+  // Specks of light rising slowly and twinkling (fixed positions from a hash, so no state).
+  for (int i = 0; i < 46; i++)
+  {
+    const float h1 = std::fmod(std::sin(i * 12.9898f) * 43758.5453f, 1.0f);
+    const float h2 = std::fmod(std::sin(i * 78.233f) * 12345.6789f, 1.0f);
+    const float fx = std::abs(h1), fy = std::abs(h2);
+    const float speed = 8.0f + fx * 14.0f;
+    const float y = H - std::fmod(fy * H + m_time * speed, H + 40.0f);
+    const float x = fx * W + std::sin(m_time * 0.3f + i) * 18.0f;
+    const float twinkle = 0.5f + 0.5f * std::sin(m_time * (0.8f + fy) + i * 1.7f);
+    const float radius = 1.5f + fy * 3.0f;
+    const float a = (0.10f + 0.25f * twinkle) * std::clamp(y / H * 1.4f, 0.0f, 1.0f);
+    dl->AddCircleFilled(ImVec2(x, y), radius * 3.0f, Rgba(theme.wave, a * 0.18f), 16);
+    dl->AddCircleFilled(ImVec2(x, y), radius, Rgba(0xFFFFFF, a), 12);
+  }
+}
+
+// A cover (or, without one, a tile with the platform and the title) on the quad a-b-c-d
+// (top left, top right, bottom right, bottom left), with its reflection on the floor.
+// focus: 2 = the selected game, 1 = the others.
+void Menu::DrawCover(ImDrawList* dl, const Game& game, ImVec2 a, ImVec2 b, ImVec2 c, ImVec2 d,
+                     float alpha, int focus)
+{
+  const Theme& theme = CurrentTheme();
+  const int a255 = static_cast<int>(std::clamp(alpha, 0.0f, 1.0f) * 255.0f);
+  const ImU32 white = IM_COL32(255, 255, 255, a255);
+  const float h = d.y - a.y;
+  // Shadow.
+  dl->AddQuadFilled(ImVec2(a.x + 8, a.y + 12), ImVec2(b.x + 8, b.y + 12), ImVec2(c.x + 8, c.y + 12),
+                    ImVec2(d.x + 8, d.y + 12), IM_COL32(0, 0, 0, a255 * 45 / 100));
+  if (focus == 2)
+  {
+    // Glow around the selected cover.
+    for (int i = 6; i >= 1; i--)
+    {
+      const float g = i * 4.0f;
+      dl->AddQuad(ImVec2(a.x - g, a.y - g), ImVec2(b.x + g, b.y - g), ImVec2(c.x + g, c.y + g),
+                  ImVec2(d.x - g, d.y + g), Rgba(theme.wave, alpha * 0.07f * (7 - i)), 5.0f);
+    }
+  }
+  if (game.cover != ImTextureID{})
+  {
+    const float appear = std::clamp((m_time - game.cover_time) / 0.35f, 0.0f, 1.0f);
+    if (appear < 1.0f)
+    {
+      // The tile underneath while the cover fades in.
+      QuadMultiColor(dl, a, b, c, d, game.wii ? Rgba(0xF4F6F8, alpha) : Rgba(0x5B3FC4, alpha),
+                     game.wii ? Rgba(0xF4F6F8, alpha) : Rgba(0x5B3FC4, alpha),
+                     game.wii ? Rgba(0xC8D0DA, alpha) : Rgba(0x2A1C66, alpha),
+                     game.wii ? Rgba(0xC8D0DA, alpha) : Rgba(0x2A1C66, alpha));
+    }
+    dl->AddImageQuad(ImTextureRef(game.cover), a, b, c, d, ImVec2(0, 0), ImVec2(1, 0), ImVec2(1, 1),
+                     ImVec2(0, 1), IM_COL32(255, 255, 255, static_cast<int>(a255 * appear)));
+    // Reflection: the cover upside down under it, fading out.
+    const float r = 0.30f;
+    const ImVec2 ra(d.x, d.y + 6), rb(c.x, c.y + 6);
+    const ImVec2 rc(c.x + (c.x - b.x) * 0.0f, c.y + 6 + (c.y - b.y) * r),
+        rd(d.x, d.y + 6 + (d.y - a.y) * r);
+    ImageQuadColors(dl, game.cover, ra, rb, rc, rd, ImVec2(0, 1), ImVec2(1, 1), ImVec2(1, 1 - r),
+                    ImVec2(0, 1 - r), IM_COL32(255, 255, 255, a255 * 28 / 100),
+                    IM_COL32(255, 255, 255, a255 * 28 / 100), IM_COL32(255, 255, 255, 0),
+                    IM_COL32(255, 255, 255, 0));
+  }
+  else
+  {
+    const ImU32 tile_top = game.wii ? Rgba(0xF4F6F8, alpha) : Rgba(0x5B3FC4, alpha);
+    const ImU32 tile_bottom = game.wii ? Rgba(0xC8D0DA, alpha) : Rgba(0x2A1C66, alpha);
+    QuadMultiColor(dl, a, b, c, d, tile_top, tile_top, tile_bottom, tile_bottom);
+    const ImTextureID platform = game.wii ? m_icon_wii : m_icon_gc;
+    const float cx = (a.x + b.x) * 0.5f, cy = a.y + h * 0.36f, s = (b.x - a.x) * 0.42f;
+    if (platform != ImTextureID{})
+    {
+      dl->AddImage(ImTextureRef(platform), ImVec2(cx - s, cy - s), ImVec2(cx + s, cy + s),
+                   ImVec2(0, 0), ImVec2(1, 1),
+                   game.wii ? IM_COL32(60, 70, 85, a255) : IM_COL32(255, 255, 255, a255));
+    }
+    const ImU32 ink = game.wii ? IM_COL32(40, 46, 56, a255) : white;
+    const float size = std::max(18.0f, h * 0.075f);
+    dl->AddText(m_bold, size, ImVec2(a.x + 14, a.y + h * 0.66f), ink, game.title.c_str(), nullptr,
+                b.x - a.x - 28);
+  }
+  // Frame: bright for the selected game, the platform's colour for the others.
+  if (focus == 2)
+  {
+    dl->AddQuad(a, b, c, d, Rgba(theme.wave, alpha), 5.0f);
+    dl->AddQuad(ImVec2(a.x + 4, a.y + 4), ImVec2(b.x - 4, b.y + 4), ImVec2(c.x - 4, c.y - 4),
+                ImVec2(d.x + 4, d.y - 4), Rgba(0xFFFFFF, alpha * 0.55f), 1.5f);
+  }
+  else
+  {
+    dl->AddQuad(a, b, c, d, game.wii ? Rgba(0xDDE6F0, alpha * 0.55f) : Rgba(0x8C6CFF, alpha * 0.8f),
+                3.0f);
+  }
+}
+
+void Menu::DrawLibrary(ImDrawList* dl, float dt)
+{
+  const Theme& theme = CurrentTheme();
+  const int tab = LibraryTab();
+  Approach(m_tab_pos, static_cast<float>(tab), 14.0f, dt);
+  if (m_sort_shown > 0.0f)
+    m_sort_shown -= dt;
+
+  // Top bar: the logo, the tabs between L1 and R1, the clock.
+  if (m_logo != ImTextureID{})
+  {
+    dl->AddImage(ImTextureRef(m_logo), ImVec2(70, 46), ImVec2(136, 112), ImVec2(0, 0), ImVec2(1, 1),
+                 IM_COL32(255, 255, 255, 235));
+  }
+  {
+    float x = 152.0f;
+    for (const char ch : std::string("DOLPHIN"))
+    {
+      const std::string letter(1, ch);
+      Text(dl, m_bold, 30, ImVec2(x, 62), Rgba(theme.text, 0.95f), letter);
+      x += TextWidth(m_bold, 30, letter) + 7.0f;
+    }
+  }
+  constexpr float TAB_FONT = 28.0f, TAB_PAD = 34.0f, BAR_Y = 52.0f, BAR_H = 58.0f;
+  float tab_x[TAB_COUNT], tab_w[TAB_COUNT], total = 0.0f;
+  for (int i = 0; i < TAB_COUNT; i++)
+  {
+    tab_w[i] = TextWidth(m_bold, TAB_FONT, TAB_NAMES[i]) + TAB_PAD * 2;
+    total += tab_w[i];
+  }
+  const float bar_x = W * 0.5f - total * 0.5f;
+  {
+    float x = bar_x;
+    for (int i = 0; i < TAB_COUNT; i++)
+    {
+      tab_x[i] = x;
+      x += tab_w[i];
+    }
+  }
+  RowBox(dl, ImVec2(bar_x - 8, BAR_Y - 6), ImVec2(bar_x + total + 8, BAR_Y + BAR_H + 6), false,
+         1.0f);
+  {
+    // The highlight slides between the tabs.
+    const int i0 = std::clamp(static_cast<int>(std::floor(m_tab_pos)), 0, TAB_COUNT - 1);
+    const int i1 = std::min(i0 + 1, TAB_COUNT - 1);
+    const float f = std::clamp(m_tab_pos - i0, 0.0f, 1.0f);
+    const float hx = tab_x[i0] + (tab_x[i1] - tab_x[i0]) * f;
+    const float hw = tab_w[i0] + (tab_w[i1] - tab_w[i0]) * f;
+    const ImVec2 h0(hx + 2, BAR_Y), h1(hx + hw - 2, BAR_Y + BAR_H);
+    RowBox(dl, h0, h1, true, 1.0f);
+  }
+  for (int i = 0; i < TAB_COUNT; i++)
+  {
+    const bool sel = i == tab;
+    Text(dl, sel ? m_bold : m_font, TAB_FONT, ImVec2(tab_x[i] + TAB_PAD, BAR_Y + 12),
+         Rgba(theme.text, sel ? 1.0f : 0.72f), TAB_NAMES[i], sel);
+  }
+  PS4Glyphs::Draw(dl, m_bold, "L1", bar_x - 8 - 30 - PS4Glyphs::Width("L1", 40), BAR_Y + BAR_H * 0.5f,
+                  40, 0.9f);
+  PS4Glyphs::Draw(dl, m_bold, "R1", bar_x + total + 8 + 30, BAR_Y + BAR_H * 0.5f, 40, 0.9f);
+  if (m_prefs.clock)
+  {
+    const std::time_t now = std::time(nullptr);
+    std::tm local = {};
+    localtime_r(&now, &local);
+    char clock[32];
+    std::strftime(clock, sizeof(clock), "%H:%M", &local);
+    const float tw = TextWidth(m_bold, 36, clock);
+    Text(dl, m_bold, 36, ImVec2(W - 90 - tw, 62), Rgba(theme.text, 0.95f), clock);
+    DrawAccountStatus(dl, W - 90 - tw - 40, 82);
+  }
+  else
+  {
+    DrawAccountStatus(dl, W - 90, 82);
+  }
+
+  // The tab's page; it fades in while the highlight moves.
+  const float alpha = std::clamp(1.0f - std::abs(m_tab_pos - tab) * 1.6f, 0.0f, 1.0f);
+  switch (TABS[tab])
+  {
+  case Category::Games:
+    if (m_prefs.style == "gamecube")
+      DrawGameCubeGames(dl, alpha, dt);
+    else if (m_prefs.style == "wii")
+      DrawWiiGames(dl, alpha, dt);
+    else
+      DrawLibraryGames(dl, alpha);
+    break;
+  case Category::MemoryCards:
+    DrawLibraryCards(dl, alpha);
+    break;
+  default:
+    DrawLibraryList(dl, alpha);
+    break;
+  }
+}
+
+void Menu::DrawLibraryGames(ImDrawList* dl, float alpha)
+{
+  const Theme& theme = CurrentTheme();
+  const int c = static_cast<int>(Category::Games);
+  const auto& items = m_items[c];
+  const int count = static_cast<int>(items.size());
+  const bool any = count > 0 && items[0].game >= 0;
+  Text(dl, m_bold, 50, ImVec2(90, 150), Rgba(theme.text, alpha), "Your games");
+  std::string sub = any ? std::to_string(count) + (count == 1 ? " game" : " games") : "No games yet";
+  if (any)
+    sub += "  -  " + SortName();
+  Text(dl, m_bold, 26, ImVec2(92, 214), Rgba(theme.wave, alpha * (m_sort_shown > 0.0f ? 1.0f : 0.85f)),
+       sub, false);
+  if (!any)
+  {
+    const std::string line1 = "Copy your games to " + GamesFolder();
+    const std::string line2 = "then press Square to look again (or pick a folder in Settings).";
+    Text(dl, m_bold, 36, ImVec2(W * 0.5f - TextWidth(m_bold, 36, line1) * 0.5f, 470),
+         Rgba(theme.text, alpha), line1);
+    Text(dl, m_font, 28, ImVec2(W * 0.5f - TextWidth(m_font, 28, line2) * 0.5f, 530),
+         Rgba(theme.text, alpha * 0.75f), line2);
+    return;
+  }
+
+  // The row: neighbours smaller and turned slightly towards the middle, farther ones behind.
+  const float pos = m_item_pos[c];
+  const int selected = m_selected[c];
+  constexpr float BASE_H = 420.0f, FLOOR_Y = 720.0f;
+  std::vector<std::pair<float, int>> order;
+  for (int i = 0; i < count; i++)
+  {
+    const float d = static_cast<float>(i) - pos;
+    if (std::abs(d) < 6.5f)
+      order.push_back({std::abs(d), i});
+  }
+  std::sort(order.begin(), order.end(), [](const auto& x, const auto& y) { return x.first > y.first; });
+  float selected_top = FLOOR_Y - BASE_H;
+  for (const auto& [ad, i] : order)
+  {
+    const Game& game = m_games[items[i].game];
+    const float d = static_cast<float>(i) - pos;
+    const float near = std::min(ad, 1.0f), far = std::max(0.0f, ad - 1.0f);
+    const float scale = 1.0f - 0.24f * near - 0.05f * far;
+    const float h = BASE_H * scale;
+    const float aspect = game.cover != ImTextureID{} ? std::clamp(game.cover_aspect, 0.55f, 1.0f) : 0.7f;
+    const float w = h * aspect;
+    const float side = d < 0.0f ? -1.0f : 1.0f;
+    const float cx = W * 0.5f + side * (near * 320.0f + far * 230.0f);
+    const float bottom = FLOOR_Y - 14.0f * near;
+    // The outer edge a little shorter: the cover faces the middle.
+    const float tilt = h * 0.045f * near;
+    ImVec2 a(cx - w * 0.5f, bottom - h), b(cx + w * 0.5f, bottom - h);
+    ImVec2 cc(cx + w * 0.5f, bottom), dd(cx - w * 0.5f, bottom);
+    if (side > 0)
+    {
+      b.y += tilt;
+      cc.y -= tilt;
+    }
+    else
+    {
+      a.y += tilt;
+      dd.y -= tilt;
+    }
+    const float fade = std::clamp((6.0f - ad) / 1.5f, 0.0f, 1.0f);
+    const float dim = 1.0f - 0.22f * near;
+    DrawCover(dl, game, a, b, cc, dd, alpha * fade * dim, i == selected && ad < 0.5f ? 2 : 1);
+    if (i == selected)
+      selected_top = a.y;
+  }
+
+  // Triangle above the selected cover (its options), its title, platform, last played, Play.
+  const float pulse = 0.65f + 0.35f * std::sin(m_time * 3.0f);
+  const float gw = PS4Glyphs::Width("Triangle", 40);
+  PS4Glyphs::Draw(dl, m_bold, "Triangle", W * 0.5f - gw * 0.5f, selected_top - 44, 40, alpha * pulse);
+  const Game& game = m_games[items[selected].game];
+  const float title_size = TextWidth(m_bold, 46, game.title) > W - 200 ? 36.0f : 46.0f;
+  const float tw = TextWidth(m_bold, title_size, game.title);
+  Text(dl, m_bold, title_size, ImVec2(W * 0.5f - tw * 0.5f, 800), Rgba(theme.text, alpha), game.title);
+  std::string info = std::string(game.wii ? "Wii" : "GameCube") + "  -  " + PlayedText(Played(game.path));
+  const std::string played = PS4PlayTime::Text(PlayTime(game));
+  if (!played.empty())
+    info += "  -  " + played;
+  const std::string achieved = AchievementText(game);
+  if (!achieved.empty())
+    info += "  -  " + achieved;
+  if (game.discs > 1)
+    info += "  -  " + std::to_string(game.discs) + " discs";
+  if (!m_prefs.default_game.empty() && game.path == m_prefs.default_game)
+    info += "  -  Starts when Dolphin opens";
+  const float iw = TextWidth(m_font, 26, info);
+  Text(dl, m_font, 26, ImVec2(W * 0.5f - iw * 0.5f, 860), Rgba(theme.text, alpha * 0.72f), info);
+  const float bw = 210.0f, bh = 62.0f, by = 908.0f;
+  const ImVec2 b0(W * 0.5f - bw * 0.5f, by), b1(W * 0.5f + bw * 0.5f, by + bh);
+  dl->AddRectFilled(b0, b1, Rgba(theme.wave, alpha * 0.18f), 14.0f);
+  dl->AddRect(b0, b1, Rgba(theme.wave, alpha * 0.95f), 14.0f, 0, 2.5f);
+  const float cw = PS4Glyphs::Width("Cross", 38);
+  const float pw = TextWidth(m_bold, 32, "Play");
+  const float px = W * 0.5f - (cw + 14 + pw) * 0.5f;
+  PS4Glyphs::Draw(dl, m_bold, "Cross", px, by + bh * 0.5f, 38, alpha);
+  Text(dl, m_bold, 32, ImVec2(px + cw + 14, by + 12), Rgba(theme.text, alpha), "Play");
+}
+
+
+void Menu::RowBox(ImDrawList* dl, ImVec2 a, ImVec2 b, bool selected, float alpha) const
+{
+  const Theme& theme = CurrentTheme();
+  float rounding = 14.0f;
+  uint32_t top, bottom, edge;
+  float ta, ba, ea;
+  if (m_prefs.style == "gamecube")
+  {
+    // Chunky purple slabs, nearly square corners.
+    rounding = 7.0f;
+    if (selected)
+      top = 0xA48CFF, bottom = 0x4A2FB0, edge = 0xE0D6FF, ta = 0.9f, ba = 0.9f, ea = 0.95f;
+    else
+      top = 0x3E2C96, bottom = 0x1C1248, edge = 0x7A5CF0, ta = 0.6f, ba = 0.65f, ea = 0.45f;
+  }
+  else if (m_prefs.style == "wii")
+  {
+    // White glass, round ends, the Wii's light blue for the selection.
+    rounding = std::min(26.0f, (b.y - a.y) * 0.5f);
+    if (selected)
+      top = 0xFFFFFF, bottom = 0xCDEBFF, edge = 0x34BEED, ta = 0.98f, ba = 0.98f, ea = 1.0f;
+    else
+      top = 0xFFFFFF, bottom = 0xE2E8EE, edge = 0xB4BFCA, ta = 0.85f, ba = 0.85f, ea = 0.8f;
+  }
+  else if (selected)
+  {
+    top = theme.wave, bottom = theme.wave, edge = theme.wave, ta = 0.45f, ba = 0.16f, ea = 0.95f;
+  }
+  else
+  {
+    top = 0xFFFFFF, bottom = 0x000000, edge = theme.text, ta = 0.07f, ba = 0.28f, ea = 0.10f;
+  }
+  DrawBevelBox(dl, a, b, Rgba(top, ta * alpha), Rgba(bottom, ba * alpha), Rgba(edge, ea * alpha),
+               rounding, alpha, selected);
+}
