+  bool IsSimpleReg() const { return Location().IsSimpleReg(); }
+  bool IsSimpleReg(Gen::X64Reg reg) const { return Location().IsSimpleReg(reg); }
+  Gen::X64Reg GetSimpleReg() const { return Location().GetSimpleReg(); }
