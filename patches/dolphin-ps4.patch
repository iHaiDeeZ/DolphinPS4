+// The system keyboard over the menu (the PS4 draws it; the menu keeps running underneath).
+void Menu::StartKeyboard(int purpose, const char* title, const std::string& initial, bool password)
+{
+  if (!m_ime_loaded)
+  {
+    const int loaded = sceSysmoduleLoadModule(ORBIS_SYSMODULE_IME_DIALOG);
+    Log("ime dialog module: " + std::to_string(loaded));
+    m_ime_loaded = true;
+  }
+  std::fill(std::begin(m_ime_text), std::end(m_ime_text), u'\0');
+  std::fill(std::begin(m_ime_title), std::end(m_ime_title), u'\0');
+  for (size_t i = 0; i < initial.size() && i < 128; i++)
+    m_ime_text[i] = static_cast<unsigned char>(initial[i]);
+  for (size_t i = 0; title[i] && i < 63; i++)
+    m_ime_title[i] = static_cast<unsigned char>(title[i]);
+  OrbisImeDialogSetting setting{};
+  setting.userId = static_cast<uint32_t>(m_user_id);
+  setting.type = ORBIS_TYPE_BASIC_LATIN;
+  setting.enterLabel = ORBIS_BUTTON_LABEL_DEFAULT;
+  setting.inputMethod = ORBIS__DEFAULT;
+  // 2: no auto-capitalization, 4: password (dots). The keyboard uses UTF-16 text.
+  setting.option = password ? 0x6 : 0x2;
+  setting.maxTextLength = 128;
+  setting.inputTextBuffer = reinterpret_cast<wchar_t*>(m_ime_text);
+  setting.posx = 1920.0f / 2;
+  setting.posy = 1080.0f / 2;
+  setting.horizontalAlignment = ORBIS_H_CENTER;
+  setting.verticalAlignment = ORBIS_V_CENTER;
+  setting.title = reinterpret_cast<const wchar_t*>(m_ime_title);
+  const int result = sceImeDialogInit(&setting, nullptr);
+  if (result < 0)
+  {
+    Log("ime dialog init failed: " + std::to_string(result));
+    std::lock_guard lock(m_ra_mutex);
+    m_ra_status = "The keyboard didn't open";
+    return;
+  }
+  m_ime_purpose = purpose;
+  m_ime_last_status = -1;
+}
+
+void Menu::UpdateKeyboard()
+{
+  if (!m_ime_purpose)
+    return;
+  // Only a finished keyboard (2) or a gone one (0) ends it: anything else (it reports other
+  // states while typing) is still open - ending it then closed it after the first letter.
+  const int status = static_cast<int>(sceImeDialogGetStatus());
+  if (status != m_ime_last_status)
+  {
+    Log("ime dialog status: " + std::to_string(status));
+    m_ime_last_status = status;
+  }
+  if (status != ORBIS_DIALOG_STATUS_STOPPED && status != ORBIS_DIALOG_STATUS_NONE)
+    return;
+  OrbisDialogResult result{};
+  const int got = sceImeDialogGetResult(&result);
+  if (status == ORBIS_DIALOG_STATUS_STOPPED)
+    sceImeDialogTerm();
+  const int purpose = m_ime_purpose;
+  m_ime_purpose = 0;
+  m_input.Poll(0.0f);  // the keyboard's own presses don't reach the menu
+  Log("ime dialog result: " + std::to_string(got) + ", end " +
+      std::to_string(static_cast<int>(result.endstatus)));
+  if (got >= 0 && result.endstatus == ORBIS_DIALOG_OK)
+  {
+    const std::string text = Utf8(m_ime_text);
+    std::fill(std::begin(m_ime_text), std::end(m_ime_text), u'\0');
+    if (purpose == 1)
+    {
+      RaSet("Username", text);
+      Log("retroachievements: username " + text);
+    }
+    else if (purpose == 2 && !text.empty())
+    {
+      StartAchievementLogin(RaGet("Username"), text);
+    }
+  }
+  if (m_panel.open && m_panel.setting == SET_ACHIEVEMENTS)
+    BuildAchievementRows();
+}
+
+// The password goes to retroachievements.org once; only the token it answers with is kept.
+void Menu::StartAchievementLogin(const std::string& user, const std::string& password)
+{
+  if (m_ra_thread.joinable())
+    m_ra_thread.join();
+  m_ra_busy = true;
+  m_ra_thread = std::thread([this, user, password] {
+    Common::HttpRequest http{std::chrono::seconds{20}};
+    const std::string body = "r=login2&u=" + UrlEncode(user) + "&p=" + UrlEncode(password);
+    const auto response =
+        http.Post("https://retroachievements.org/dorequest.php", body,
+                  {{"Content-Type", "application/x-www-form-urlencoded"},
+                   {"User-Agent", "Dolphin-PS4/1.0"}},
+                  Common::HttpRequest::AllowedReturnCodes::All);
+    std::string status, token, name;
+    if (!response)
+    {
+      status = "No connection (PS4 date and time?)";
+    }
+    else
+    {
+      picojson::value json;
+      const std::string error = picojson::parse(json, std::string(response->begin(), response->end()));
+      if (!error.empty() || !json.is<picojson::object>())
+      {
+        status = "Unexpected answer from the server";
+      }
+      else
+      {
+        const auto& object = json.get<picojson::object>();
+        const auto success = object.find("Success");
+        if (success != object.end() && success->second.is<bool>() && success->second.get<bool>())
+        {
+          const auto t = object.find("Token");
+          const auto u = object.find("User");
+          token = t != object.end() ? t->second.to_str() : std::string();
+          name = u != object.end() ? u->second.to_str() : user;
+          status = token.empty() ? "No token in the answer" : "Logged in as " + name;
+        }
+        else
+        {
+          const auto e = object.find("Error");
+          status = e != object.end() && e->second.is<std::string>() ? e->second.get<std::string>() :
+                                                                     "Login failed";
+        }
+      }
+    }
+    std::lock_guard lock(m_ra_mutex);
+    m_ra_status = status;
+    m_ra_token_found = token;
+    m_ra_user_found = name;
+    m_ra_busy = false;
+  });
+}
+
+void Menu::UpdateAchievementLogin()
+{
+  if (m_ra_busy || !m_ra_thread.joinable())
+    return;
+  m_ra_thread.join();
+  std::string token, name, status;
+  {
+    std::lock_guard lock(m_ra_mutex);
+    token = std::move(m_ra_token_found);
+    name = std::move(m_ra_user_found);
+    status = m_ra_status;
+  }
+  Log("retroachievements: " + status);
+  if (!token.empty())
+  {
+    RaSet("Username", name);
+    RaSet("ApiToken", token);
+    RaSet("Enabled", "True");
+  }
+  if (m_panel.open && m_panel.setting == SET_ACHIEVEMENTS)
+    BuildAchievementRows();
+  BuildItems();  // the account beside the clock and in the Achievements category
+}
