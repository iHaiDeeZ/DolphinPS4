+}
+
+// Video thread time per category since the last call (VideoCommon/PS4Profile.h), as
+// milliseconds per second of real time, with calls per second.
+static void LogProfile()
+{
+  static const char* const names[PS4_PROF_CATEGORY_COUNT] = {
+      "flush", "vtx-upload", "uniforms", "draw", "pipeline", "tex-cache",
+      "tex-upload", "compile", "link", "efb-copy", "efb-peek", "present",
+      "gpu-fifo", "cpu-wait", "tlbie", "pagetable"};
+  static unsigned long long s_ticks[PS4_PROF_CATEGORY_COUNT], s_count[PS4_PROF_CATEGORY_COUNT];
+  static unsigned long long s_tsc = 0;
+  static auto s_time = std::chrono::steady_clock::now();
+
+  const unsigned long long tsc = __rdtsc();
+  const auto time = std::chrono::steady_clock::now();
+  const double seconds = std::chrono::duration<double>(time - s_time).count();
+  if (s_tsc != 0 && seconds > 0.1)
+  {
+    const double ticks_per_ms = static_cast<double>(tsc - s_tsc) / (seconds * 1000.0);
+    char line[512];
+    int len = snprintf(line, sizeof(line), "prof (ms/s, calls/s):");
+    for (int i = 0; i < PS4_PROF_CATEGORY_COUNT; i++)
+    {
+      const unsigned long long ticks = ps4_prof_ticks[i], count = ps4_prof_count[i];
+      len += snprintf(line + len, sizeof(line) - len, " %s %.0f/%.0f", names[i],
+                      static_cast<double>(ticks - s_ticks[i]) / ticks_per_ms / seconds,
+                      static_cast<double>(count - s_count[i]) / seconds);
+      s_ticks[i] = ticks;
+      s_count[i] = count;
+    }
+    Platform::BootTrace(line);
+  }
+  else
+  {
+    for (int i = 0; i < PS4_PROF_CATEGORY_COUNT; i++)
+    {
+      s_ticks[i] = ps4_prof_ticks[i];
+      s_count[i] = ps4_prof_count[i];
+    }
+  }
+  s_tsc = tsc;
+  s_time = time;
+}
+
+void PlatformPS4::MainLoop()
+{
+  BootTrace("main loop");
+  PS4IngameMenu::Install();
+  int frame = 0;
+  const auto start = std::chrono::steady_clock::now();
+  // Hang watchdog: if emulated time stops advancing for ~10 s while running, every Dolphin
+  // thread's stack goes to /data/DolphinPS4/hang-stacks.txt (once per hang).
+  u64 watchdog_ticks = 0;
+  int watchdog_stalled = 0;
+  // Stall catcher: while running, no frame for 0.8 s (loading freezes, hitches) writes every
+  // thread's stack to /data/DolphinPS4/stall-stacks.txt, mid-stall (at most 3 per session).
+  unsigned long long stall_presents = 0;
+  auto stall_since = std::chrono::steady_clock::now();
+  int stall_dumps = 0;
+  bool stall_dumped = false;
+  // Slow start: still starting after 4 s and 12 s -> boot-stacks-N.txt (where the boot waits).
+  const auto boot_since = std::chrono::steady_clock::now();
+  int boot_dumps = 0;
+  // Players joining / leaving (another DualShock 4 signed in or out).
+  auto login_users = PS4LoginUsers();
+  while (m_running.IsSet())
+  {
+    UpdateRunningFlag();
+    Core::HostDispatchJobs(Core::System::GetInstance());
+    if (frame % 60 == 30)
+    {
+      const auto users = PS4LoginUsers();
+      if (users != login_users)
+      {
+        login_users = users;
+        g_controller_interface.RefreshDevices();
+        ApplyPS4Players();
+      }
+    }
+    {
+      const auto now = std::chrono::steady_clock::now();
+      if (ps4_freeze_reports && boot_dumps < 2 &&
+          Core::GetState(Core::System::GetInstance()) == Core::State::Starting &&
+          now - boot_since > std::chrono::seconds(boot_dumps == 0 ? 4 : 12))
+      {
+        boot_dumps++;
+        char reason[96];
+        snprintf(reason, sizeof(reason), "slow start %d: still starting after %d s", boot_dumps,
+                 boot_dumps == 1 ? 4 : 12);
+        BootTrace(reason);
+        const std::string path = std::string(PS4_DATA_DIR_PATH) + "/boot-stacks-" +
+                                 std::to_string(boot_dumps) + ".txt";
+        ps4_dump_thread_stacks(path.c_str(), reason);
+      }
+      if (ps4_present_counter != stall_presents ||
+          Core::GetState(Core::System::GetInstance()) != Core::State::Running)
+      {
+        stall_presents = ps4_present_counter;
+        stall_since = now;
+        stall_dumped = false;
+      }
+      else if (ps4_freeze_reports && !stall_dumped && stall_dumps < 3 &&
+               now - stall_since > std::chrono::milliseconds(800))
+      {
+        stall_dumped = true;
+        stall_dumps++;
+        char reason[96];
+        snprintf(reason, sizeof(reason), "stall %d: no frame for 0.8 s while running",
+                 stall_dumps);
+        BootTrace(reason);
+        const std::string path = std::string(PS4_DATA_DIR_PATH) + "/stall-stacks-" +
+                                 std::to_string(stall_dumps) + ".txt";
+        ps4_dump_thread_stacks(path.c_str(), reason);
+      }
+    }
+    PS4IngameMenu::Poll(Core::System::GetInstance());
+    std::this_thread::sleep_for(std::chrono::milliseconds(16));
+    // Keeps the FPS average fresh for the on-screen counter (VideoCommon/Present.cpp) - only
+    // with OpenGL. On Vulkan, Dolphin's on-screen layer updates it on the video thread every
+    // frame (OnScreenUI::Finalize -> DrawImGuiStats), and the counters take one updating thread
+    // (a single-consumer queue and a deque): updating from here as well corrupted the heap and
+    // crashed games at random (Super Smash Bros. Melee, after closing the in-game menu).
+    static const bool s_update_stats_here = Config::Get(Config::MAIN_GFX_BACKEND) == "OGL";
+    if (s_update_stats_here && frame % 30 == 29)
+      Core::System::GetInstance().GetPerfMetrics().UpdateStats();
+    // cpu_clock=auto: the emulated CPU clock follows what the PS4 can run at full speed. A game
+    // gets as much of the GameCube's CPU as possible (up to cpu_clock_max, normally the real
+    // 100%), so light scenes reach the frame rates of real hardware, while heavy scenes get a lower
+    // clock (fewer frames) instead of running in slow motion. Checked every ~1 s: below 97%
+    // speed and the CPU thread at least 90% busy (it is the limit) -> down to what it sustains; enough spare time for 5 points
+    // more (the CPU thread's work grows with the clock) -> 5 points higher, at most every ~2 s.
+    if (ps4_auto_clock > 0 && frame % 60 == 59)
+    {
+      static int s_since_change = 0;
+      auto& system = Core::System::GetInstance();
+      auto& perf = system.GetPerfMetrics();
+      const double speed = perf.GetSpeed(), max_speed = perf.GetMaxSpeed();
+      int clock = ps4_auto_clock;
+      s_since_change++;
+      // The CPU thread's own CPU time per wall time since the last check.
+      static double s_last_wall = 0, s_last_cpu = 0;
+      const double wall =
+          std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch())
+              .count();
+      const double cpu = ps4_thread_cpu_seconds(0);
+      const double cpu_busy = (s_last_wall > 0 && cpu > 0 && s_last_cpu > 0) ?
+                                  (cpu - s_last_cpu) / (wall - s_last_wall) :
+                                  1.0;
+      // Time the CPU thread spent waiting for the GPU thread (FlushGpu) per wall time: when a game
+      // waits for its GPU work every frame, the CPU thread's work and the GPU thread's run one
+      // after the other - the CPU thread is the limit even though it isn't busy all the time
+      // (Donald Duck's busy areas: 64% busy + 37% waiting, 47% speed at an 85% clock).
+      static long long s_last_gpu_wait = 0;
+      const long long gpu_wait_ns = ps4_wait_total(0);
+      const double gpu_wait = (s_last_wall > 0 && wall > s_last_wall) ?
+                                  (gpu_wait_ns - s_last_gpu_wait) / 1e9 / (wall - s_last_wall) :
+                                  0.0;
+      s_last_gpu_wait = gpu_wait_ns;
+      const double cpu_chain = cpu_busy + gpu_wait;
+      s_last_wall = wall;
+      s_last_cpu = cpu;
+      // Too low a clock shows differently: the emulator keeps up (full speed) but the game
+      // itself drops frames, because its own code no longer fits in a frame's worth of the
+      // emulated CPU (Super Smash Bros. Melee: ~25 FPS at 30%, ~46 at 35%, 60 from 40%). Then the
+      // clock goes up again and stays at least there for ~30 s. The game's usual frame rate (60
+      // or 30) is learnt from what it shows at full speed with time to spare, and follows the
+      // game: Bully runs its menus at 60 and plays at 30, and taking 30 for dropped frames
+      // pushed its clock up and the game into slow motion. A steady 30 (twice in a row, within
+      // 0.3) means a 30 FPS game; a game dropping frames wanders around it.
+      static int s_normal_fps = 0, s_steady_30 = 0;
+      static int s_lag_floor = 0, s_lag_floor_checks = 0;
+      // Each raise for dropped frames is checked at the next look: no more frames (Call of Duty 2:
+      // Big Red One kept losing speed while the clock climbed 50 -> 90%) -> back down, and no such
+      // raise for about a minute.
+      static int s_raised_from = -1, s_lag_block_checks = 0;
+      static double s_fps_before_raise = 0.0;
+      const double fps = perf.GetFPS();
+      if (s_lag_floor_checks > 0 && --s_lag_floor_checks == 0)
+        s_lag_floor = 0;
+      if (Core::GetState(system) == Core::State::Running && speed >= 0.97 && max_speed > 1.05)
+      {
+        s_steady_30 = (fps >= 29.7 && fps <= 30.3) ? s_steady_30 + 1 : 0;
+        if (fps >= 57.0)
+          s_normal_fps = 60;
+        else if (s_steady_30 >= 2)
+          s_normal_fps = 30;
+      }
+      if (s_lag_block_checks > 0)
+        s_lag_block_checks--;
+      const bool running = Core::GetState(system) == Core::State::Running && speed > 0.1;
+      bool reverted = false;
+      if (running && s_raised_from >= 0 && s_since_change >= 2)
+      {
+        if (fps < s_fps_before_raise + 1.0 || speed < 0.95)
+        {
+          char line[160];
+          snprintf(line, sizeof(line),
+                   "auto clock: raising to %d%% didn't help (%.0f FPS, speed %.0f%%) -> %d%%",
+                   clock, fps, speed * 100.0, s_raised_from);
+          BootTrace(line);
+          clock = s_raised_from;
+          s_lag_floor = 0;
+          s_lag_floor_checks = 0;
+          s_lag_block_checks = 60;
+          reverted = true;
+        }
+        s_raised_from = -1;
+      }
+      const int floor = std::max(ps4_auto_clock_min, s_lag_floor);
+      if (running && !reverted)
+      {
+        if (s_normal_fps > 0 && speed >= 0.97 && fps > 5.0 && fps < s_normal_fps * 0.85 &&
+            cpu_chain >= 0.90 && s_since_change >= 2 && clock < ps4_auto_clock_max &&
+            s_lag_block_checks == 0)
+        {
+          s_raised_from = clock;
+          s_fps_before_raise = fps;
+          clock = std::min(ps4_auto_clock_max, clock + 5);
+          s_lag_floor = clock;
+          s_lag_floor_checks = 30;
+          char line[128];
+          snprintf(line, sizeof(line),
+                   "auto clock: game dropping frames at full speed (%.0f of %d FPS) -> %d%%", fps,
+                   s_normal_fps, clock);
+          BootTrace(line);
+        }
+        else if (speed < 0.97 && max_speed < 1.0 && cpu_chain >= 0.90 && clock > floor)
+        {
+          // Straight to what the CPU thread sustains (its speed scales with the clock), not 5
+          // points per second: a match starting at a clock raised during a menu stuttered for
+          // ~15 s in Super Smash Bros. Melee while the clock came down.
+          const int target = static_cast<int>(clock * max_speed * 0.98) / 5 * 5;
+          clock = std::max(floor, std::min(clock - 5, target));
+        }
+        else if (s_since_change >= 3 && perf.GetFPS() > 5.0 &&
+                 max_speed * clock / (clock + 5.0) > 1.06 && clock < ps4_auto_clock_max)
+        {
+          // Up only while frames are being drawn (not during loading, when the CPU idles).
+          clock = std::min(ps4_auto_clock_max, clock + 5);
+        }
+      }
+      if (clock != ps4_auto_clock)
+      {
+        ps4_auto_clock = clock;
+        s_since_change = 0;
+        Config::SetBase(Config::MAIN_OVERCLOCK_ENABLE, clock != 100);
+        Config::SetBase(Config::MAIN_OVERCLOCK, clock / 100.0f);
+      }
+    }
+    // Monitor for the port: emulation speed, and flexible memory (what Piglet allocates from).
+    if (++frame % 120 == 0)
+    {
+      size_t flexible = 0;
+      using AvailableFlexibleFn = int32_t (*)(size_t*);
+      reinterpret_cast<AvailableFlexibleFn>(&sceKernelAvailableFlexibleMemorySize)(&flexible);
+      auto& perf = Core::System::GetInstance().GetPerfMetrics();
+      if (s_update_stats_here)
+        perf.UpdateStats();
+      const auto seconds = std::chrono::duration_cast<std::chrono::seconds>(
+                               std::chrono::steady_clock::now() - start)
+                               .count();
+      // Plugins can also be loaded once the game runs: listed again after ~10 s and ~60 s.
+      {
+        static int s_module_checks = 0;
+        if ((s_module_checks == 0 && seconds >= 10) || (s_module_checks == 1 && seconds >= 60))
+        {
+          ps4_log_injected_modules(s_module_checks == 0 ? "after 10 s" : "after 60 s");
+          s_module_checks++;
+        }
+      }
+      char line[2048];
+      // speed: emulated time per real time; max speed: what the CPU thread could reach if it
+      // never waited (below 100% means the emulated CPU itself is the bottleneck).
+      snprintf(line, sizeof(line),
+               "monitor: %lld s, speed %.0f%% (max %.0f%%), %.1f FPS, %.1f VPS, %zu MiB flexible "
+               "free, CPU core %d, %llu fastmem faults, GL shaders %d programs %d textures %d "
+               "(created %d, reused %d) fbos created %d, internal memory %llu KiB free, heap %zu "
+               "MiB, maps %lld unmaps %lld costing %lld KiB, compiles %lld KiB, links %lld KiB",
+               static_cast<long long>(seconds), perf.GetSpeed() * 100.0,
+               perf.GetMaxSpeed() * 100.0, perf.GetFPS(), perf.GetVPS(),
+               flexible / (1024 * 1024), static_cast<int>(Config::Get(Config::MAIN_CPU_CORE)),
+               ps4_fault_count, ps4_gl_shaders, ps4_gl_programs, ps4_gl_textures,
+               ps4_gl_texture_creations, ps4_gl_texture_reuses, ps4_gl_fbo_creations,
+               ps4_internal_memory_free() / 1024, ps4_heap_footprint() / (1024 * 1024),
+               ps4_map_count, ps4_unmap_count,
+               ps4_map_internal_bytes / 1024, ps4_compile_internal_bytes / 1024,
+               ps4_link_internal_bytes / 1024);
+#ifdef HAS_VULKAN
+      {
+        // RADV on GNM: GPU progress (a stalled GPU shows completed falling behind) and memory.
+        u64 submitted, completed, bo_bytes, bo_count;
+        ac_ps4_get_stats(&submitted, &completed, &bo_bytes, &bo_count);
+        // GPU busy: share of GPU time spent on our submissions since the last report (from GPU
+        // timestamps; port/mesa/ac_ps4_drm.c).
+        static uint64_t s_last_busy = 0, s_last_span = 0;
+        uint64_t busy_ticks, span_ticks;
+        ac_ps4_get_gpu_busy(&busy_ticks, &span_ticks);
+        const double gpu_busy = span_ticks > s_last_span ?
+                                    100.0 * (busy_ticks - s_last_busy) / (span_ticks - s_last_span) :
+                                    -1.0;
+        s_last_busy = busy_ticks;
+        s_last_span = span_ticks;
+        const size_t used = strlen(line);
+        snprintf(line + used, sizeof(line) - used,
+                 ", gpu busy %.0f%%, gpu submitted %llu completed %llu, gpu memory %llu MiB in "
+                 "%llu buffers",
+                 gpu_busy,
+                 static_cast<unsigned long long>(submitted),
+                 static_cast<unsigned long long>(completed),
+                 static_cast<unsigned long long>(bo_bytes >> 20),
+                 static_cast<unsigned long long>(bo_count));
+      }
+#endif
+      {
+        // Page table fastmem: 16 KiB host pages that could / couldn't be fast-mapped.
+        const size_t used = strlen(line);
+        snprintf(line + used, sizeof(line) - used,
+                 ", page groups mapped %lld refused %lld, soft TLB hits %llu misses %llu"
+                 " fills %llu flushes %llu (sr %llu) page inv %llu",
+                 ps4_pt_groups_mapped, ps4_pt_groups_refused, ps4_soft_tlb_hits,
+                 ps4_soft_tlb_misses, ps4_soft_tlb_fills, ps4_soft_tlb_flushes,
+                 ps4_soft_tlb_sr_flushes, ps4_soft_tlb_page_inv);
+      }
+      {
+        // How busy the CPU and video threads really are (their own CPU time per wall time):
+        // under ~95% at full speed means room for a higher cpu_clock.
+        static double s_last_wall = 0, s_last_cpu[2] = {};
+        const double wall = std::chrono::duration<double>(
+                                std::chrono::steady_clock::now().time_since_epoch())
+                                .count();
+        double busy[2] = {-1, -1};
+        for (int i = 0; i < 2; i++)
+        {
+          const double cpu = ps4_thread_cpu_seconds(i);
+          if (s_last_wall > 0 && cpu > 0 && s_last_cpu[i] > 0)
+            busy[i] = 100.0 * (cpu - s_last_cpu[i]) / (wall - s_last_wall);
+          s_last_cpu[i] = cpu;
+        }
+        s_last_wall = wall;
+        const size_t used = strlen(line);
+        snprintf(line + used, sizeof(line) - used,
+                 ", thread busy: cpu %.0f%% video %.0f%%, cpu clock %d%%", busy[0], busy[1],
+                 ps4_auto_clock > 0 ?
+                     ps4_auto_clock :
+                     static_cast<int>(Config::Get(Config::MAIN_OVERCLOCK_ENABLE) ?
+                                          Config::Get(Config::MAIN_OVERCLOCK) * 100 + 0.5f :
+                                          100));
+        // Scene composition, per second: what the video thread is working through.
+        static unsigned long long s_last_stats[8] = {};
+        unsigned long long rate[8];
+        const double period = s_last_wall > 0 ? 2.0 : 1.0;
+        for (int i = 0; i < 8; i++)
+        {
+          rate[i] = static_cast<unsigned long long>((ps4_scene_stats[i] - s_last_stats[i]) / period);
+          s_last_stats[i] = ps4_scene_stats[i];
+        }
+        // Where the threads wait, ms per second: the CPU thread for the GPU thread (FlushGpu), the
+        // GPU thread for work, the video thread for the Vulkan recording thread, GPU fences.
+        {
+          static long long s_last_waits[6] = {};
+          const size_t used3 = strlen(line);
+          long long ms[6];
+          for (int i = 0; i < 6; i++)
+          {
+            const long long total = ps4_wait_total(i);
+            const long long delta = total - s_last_waits[i];
+            ms[i] = static_cast<long long>(i == 5 ? delta / period : delta / period / 1000000);
+            s_last_waits[i] = total;
+          }
+          snprintf(line + used3, sizeof(line) - used3,
+                   ", waits ms/s: cpu-for-gpu %lld gpu-idle %lld vk-drain %lld fences %lld, "
+                   "compiles %lld/s %lld ms/s",
+                   ms[0], ms[1], ms[2], ms[3], ms[5], ms[4]);
+        }
+#ifdef HAS_VULKAN
+        {
+          // Inside the flip (the video thread): a free flip slot, the submit-and-flip system call,
+          // sceGnmSubmitDone - ms per second.
+          static uint64_t s_last_flip[3] = {};
+          long long fms[3];
+          for (int i = 0; i < 3; i++)
+          {
+            const uint64_t total = ac_ps4_flip_ns[i];
+            fms[i] = static_cast<long long>((total - s_last_flip[i]) / period / 1000000);
+            s_last_flip[i] = total;
+          }
+          const size_t usedf = strlen(line);
+          snprintf(line + usedf, sizeof(line) - usedf, ", flip ms/s: slot %lld submit %lld done %lld",
+                   fms[0], fms[1], fms[2]);
+        }
+#endif
+        {
+          // Monotonic clock reads served from the time stamp counter (port/ps4_runtime.cpp).
+          static unsigned long long s_last_reads = 0;
+          const unsigned long long reads = ps4_clock_reads;
+          const size_t used4 = strlen(line);
+          snprintf(line + used4, sizeof(line) - used4, ", clock reads %llu/s",
+                   static_cast<unsigned long long>((reads - s_last_reads) / period));
+          s_last_reads = reads;
+        }
+        const size_t used2 = strlen(line);
+        snprintf(line + used2, sizeof(line) - used2,
+                 ", per s: draws %llu prims %llu vertices %llu efb copies %llu peeks %llu "
+                 "pokes %llu reg loads %llu tex uploads %llu",
+                 rate[0], rate[1], rate[2], rate[6], rate[3], rate[4], rate[5], rate[7]);
+      }
+      if (ps4_perf_log)
+      {
+        BootTrace(line);
+        LogProfile();
+      }
+      // Profiler "Automatic": a slow stretch profiles itself - 4 s below full speed, or the frame
+      // rate 20% under the best the game showed at full speed, starts the sampler for 30 s (at most
+      // 5 times a session, 2 minutes apart), so "it's slow here" comes with samples-<ID>.log.
+      if (ps4_profile_auto)
+      {
+        static int s_slow = 0, s_bursts = 0;
+        static long long s_burst_end = -1, s_next_allowed = 30;
+        static double s_best_fps = 0;
+        auto& emu = Core::System::GetInstance();
+        const bool running = Core::GetState(emu) == Core::State::Running;
+        const double speed = perf.GetSpeed(), fps = perf.GetFPS();
+        if (running && speed >= 0.97)
+          s_best_fps = std::max(s_best_fps, fps);
+        if (s_burst_end >= 0)
+        {
+          if (seconds >= s_burst_end)
+          {
+            ps4_sampler_set_enabled(0);
+            s_burst_end = -1;
+            s_next_allowed = seconds + 120;
+            BootTrace("auto profile: done");
+          }
+        }
+        else if (running && seconds >= s_next_allowed && s_bursts < 5)
+        {
+          const bool slow = speed < 0.95 || (s_best_fps >= 25.0 && fps < s_best_fps * 0.8);
+          s_slow = slow ? s_slow + 1 : 0;
+          if (s_slow >= 2)
+          {
+            s_slow = 0;
+            s_bursts++;
+            s_burst_end = seconds + 30;
+            char reason[160];
+            snprintf(reason, sizeof(reason),
+                     "auto profile %d/5: slow (speed %.0f%%, %.1f FPS, best %.0f) - profiling 30 s",
+                     s_bursts, speed * 100.0, fps, s_best_fps);
+            BootTrace(reason);
+            ps4_sampler_set_enabled(1);
+          }
+        }
+      }
+
+      auto& system = Core::System::GetInstance();
+      const u64 ticks = system.GetCoreTiming().GetTicks();
+      // Armed after 40 s: emulation legitimately stands still for a few seconds while booting.
+      if (seconds > 40 && Core::GetState(system) == Core::State::Running && ticks == watchdog_ticks)
+      {
+        if (++watchdog_stalled == 2 && ps4_freeze_reports)  // ~4 s: people close a frozen app quickly
+        {
+          char reason[96];
+          snprintf(reason, sizeof(reason), "emulation stalled ~4 s at %lld s",
+                   static_cast<long long>(seconds));
+          BootTrace("watchdog: emulation stalled, writing hang-stacks.txt");
+          ps4_dump_thread_stacks("/data/DolphinPS4/hang-stacks.txt", reason);
+        }
+      }
+      else
+      {
+        watchdog_stalled = 0;
+      }
+      watchdog_ticks = ticks;
+      // One self-test dump during normal play, so a broken dump shows up long before a real hang.
+      // (Self-test off: it signals every thread, and signals can make waits miss notifications.)
+      static bool s_dump_tested = true;
+      if (!s_dump_tested && seconds >= 60)
+      {
+        s_dump_tested = true;
+        BootTrace("watchdog: self-test dump");
+        ps4_dump_thread_stacks("/data/DolphinPS4/hang-stacks.txt", "self-test at 60 s (not a hang)");
+        BootTrace("watchdog: self-test dump done");
+      }
+    }
+    // Port diagnostics: a screenshot every ~10 s (User/ScreenShots) shows what Dolphin renders,
+    // independently of what reaches the TV.
+    static const bool s_screenshots = GetPS4Option("screenshots", "off") == "on";
+    if (s_screenshots && frame % 600 == 0 &&
+        Core::GetState(Core::System::GetInstance()) == Core::State::Running)
+    {
+      Core::SaveScreenShot(fmt::format("diag_{:03d}", frame / 60));
+      BootTrace("screenshot requested");
+    }
+  }
+}
