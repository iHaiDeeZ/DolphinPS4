+    {119, &JitPS4::lXXx},  // lbzux
+
+    // load byte reverse
+    {534, &JitPS4::lXXx},  // lwbrx
+    {790, &JitPS4::lXXx},  // lhbrx
+
+    // Conditional load/store (Wii SMP)
+    {150, &JitPS4::FallBackToInterpreter},  // stwcxd
+    {20, &JitPS4::FallBackToInterpreter},   // lwarx
+
+    // load string (interpret these)
+    {533, &JitPS4::FallBackToInterpreter},  // lswx
+    {597, &JitPS4::FallBackToInterpreter},  // lswi
+
+    // store word
+    {151, &JitPS4::stXx},  // stwx
+    {183, &JitPS4::stXx},  // stwux
+
+    // store halfword
+    {407, &JitPS4::stXx},  // sthx
+    {439, &JitPS4::stXx},  // sthux
+
+    // store byte
+    {215, &JitPS4::stXx},  // stbx
+    {247, &JitPS4::stXx},  // stbux
+
+    // store bytereverse
+    {662, &JitPS4::stXx},  // stwbrx
+    {918, &JitPS4::stXx},  // sthbrx
+
+    {661, &JitPS4::FallBackToInterpreter},  // stswx
+    {725, &JitPS4::FallBackToInterpreter},  // stswi
+
+    // fp load/store
+    {535, &JitPS4::lfXXX},  // lfsx
+    {567, &JitPS4::lfXXX},  // lfsux
+    {599, &JitPS4::lfXXX},  // lfdx
+    {631, &JitPS4::lfXXX},  // lfdux
+
+    {663, &JitPS4::stfXXX},  // stfsx
+    {695, &JitPS4::stfXXX},  // stfsux
+    {727, &JitPS4::stfXXX},  // stfdx
+    {759, &JitPS4::stfXXX},  // stfdux
+    {983, &JitPS4::stfiwx},  // stfiwx
+
+    {19, &JitPS4::mfcr},                    // mfcr
+    {83, &JitPS4::mfmsr},                   // mfmsr
+    {144, &JitPS4::mtcrf},                  // mtcrf
+    {146, &JitPS4::mtmsr},                  // mtmsr
+    {210, &JitPS4::FallBackToInterpreter},  // mtsr
+    {242, &JitPS4::FallBackToInterpreter},  // mtsrin
+    {339, &JitPS4::mfspr},                  // mfspr
+    {467, &JitPS4::mtspr},                  // mtspr
+    {371, &JitPS4::mftb},                   // mftb
+    {512, &JitPS4::mcrxr},                  // mcrxr
+    {595, &JitPS4::FallBackToInterpreter},  // mfsr
+    {659, &JitPS4::FallBackToInterpreter},  // mfsrin
+
+    {4, &JitPS4::twX},                      // tw
+    {598, &JitPS4::PS4SyncPageTable},              // sync
+    {982, &JitPS4::FallBackToInterpreter},  // icbi
+
+    // Unused instructions on GC
+    {310, &JitPS4::FallBackToInterpreter},  // eciwx
+    {438, &JitPS4::FallBackToInterpreter},  // ecowx
+    {854, &JitPS4::eieio},                  // eieio
+    {306, &JitPS4::FallBackToInterpreter},  // tlbie
+    {566, &JitPS4::PS4SyncPageTable},              // tlbsync
+}};
+
+constexpr std::array<Jit64OpTemplate, 9> s_table59{{
+    {18, &JitPS4::fp_arith},  // fdivsx
+    {20, &JitPS4::fp_arith},  // fsubsx
+    {21, &JitPS4::fp_arith},  // faddsx
+    {24, &JitPS4::fresx},     // fresx
+    {25, &JitPS4::fp_arith},  // fmulsx
+    {28, &JitPS4::fmaddXX},   // fmsubsx
+    {29, &JitPS4::fmaddXX},   // fmaddsx
+    {30, &JitPS4::fmaddXX},   // fnmsubsx
+    {31, &JitPS4::fmaddXX},   // fnmaddsx
+}};
+
+constexpr std::array<Jit64OpTemplate, 15> s_table63{{
+    {264, &JitPS4::fsign},  // fabsx
+    {32, &JitPS4::fcmpX},   // fcmpo
+    {0, &JitPS4::fcmpX},    // fcmpu
+    {14, &JitPS4::fctiwx},  // fctiwx
+    {15, &JitPS4::fctiwx},  // fctiwzx
+    {72, &JitPS4::fmrx},    // fmrx
+    {136, &JitPS4::fsign},  // fnabsx
+    {40, &JitPS4::fsign},   // fnegx
+    {12, &JitPS4::frspx},   // frspx
+
+    {64, &JitPS4::mcrfs},     // mcrfs
+    {583, &JitPS4::mffsx},    // mffsx
+    {70, &JitPS4::mtfsb0x},   // mtfsb0x
+    {38, &JitPS4::mtfsb1x},   // mtfsb1x
+    {134, &JitPS4::mtfsfix},  // mtfsfix
+    {711, &JitPS4::mtfsfx},   // mtfsfx
+}};
+
+constexpr std::array<Jit64OpTemplate, 10> s_table63_2{{
+    {18, &JitPS4::fp_arith},  // fdivx
+    {20, &JitPS4::fp_arith},  // fsubx
+    {21, &JitPS4::fp_arith},  // faddx
+    {23, &JitPS4::fselx},     // fselx
+    {25, &JitPS4::fp_arith},  // fmulx
+    {26, &JitPS4::frsqrtex},  // frsqrtex
+    {28, &JitPS4::fmaddXX},   // fmsubx
+    {29, &JitPS4::fmaddXX},   // fmaddx
+    {30, &JitPS4::fmaddXX},   // fnmsubx
+    {31, &JitPS4::fmaddXX},   // fnmaddx
+}};
+
+constexpr std::array<JitPS4::Instruction, 64> s_dyna_op_table = []() consteval {
+  std::array<JitPS4::Instruction, 64> table{};
+  table.fill(&JitPS4::FallBackToInterpreter);
+
+  for (auto& tpl : s_primary_table)
+  {
+    ASSERT(table[tpl.opcode] == &JitPS4::FallBackToInterpreter);
+    table[tpl.opcode] = tpl.fn;
+  }
+
+  return table;
+}();
+
+constexpr std::array<JitPS4::Instruction, 1024> s_dyna_op_table4 = []() consteval {
+  std::array<JitPS4::Instruction, 1024> table{};
+  table.fill(&JitPS4::FallBackToInterpreter);
+
+  for (u32 i = 0; i < 32; i++)
+  {
+    const u32 fill = i << 5;
+    for (const auto& tpl : s_table4_2)
+    {
+      const u32 op = fill + tpl.opcode;
+      ASSERT(table[op] == &JitPS4::FallBackToInterpreter);
+      table[op] = tpl.fn;
+    }
+  }
+
+  for (u32 i = 0; i < 16; i++)
+  {
+    const u32 fill = i << 6;
+    for (const auto& tpl : s_table4_3)
+    {
+      const u32 op = fill + tpl.opcode;
+      ASSERT(table[op] == &JitPS4::FallBackToInterpreter);
+      table[op] = tpl.fn;
+    }
+  }
+
+  for (const auto& tpl : s_table4)
+  {
+    const u32 op = tpl.opcode;
+    ASSERT(table[op] == &JitPS4::FallBackToInterpreter);
+    table[op] = tpl.fn;
+  }
+
+  return table;
+}();
+
+constexpr std::array<JitPS4::Instruction, 1024> s_dyna_op_table19 = []() consteval {
+  std::array<JitPS4::Instruction, 1024> table{};
+  table.fill(&JitPS4::FallBackToInterpreter);
+
+  for (const auto& tpl : s_table19)
+  {
+    ASSERT(table[tpl.opcode] == &JitPS4::FallBackToInterpreter);
+    table[tpl.opcode] = tpl.fn;
+  }
+
+  return table;
+}();
+
+constexpr std::array<JitPS4::Instruction, 1024> s_dyna_op_table31 = []() consteval {
+  std::array<JitPS4::Instruction, 1024> table{};
+  table.fill(&JitPS4::FallBackToInterpreter);
+
+  for (const auto& tpl : s_table31)
+  {
+    ASSERT(table[tpl.opcode] == &JitPS4::FallBackToInterpreter);
+    table[tpl.opcode] = tpl.fn;
+  }
+
+  return table;
+}();
+
+constexpr std::array<JitPS4::Instruction, 32> s_dyna_op_table59 = []() consteval {
+  std::array<JitPS4::Instruction, 32> table{};
+  table.fill(&JitPS4::FallBackToInterpreter);
+
+  for (const auto& tpl : s_table59)
+  {
+    ASSERT(table[tpl.opcode] == &JitPS4::FallBackToInterpreter);
+    table[tpl.opcode] = tpl.fn;
+  }
+
+  return table;
+}();
+
+constexpr std::array<JitPS4::Instruction, 1024> s_dyna_op_table63 = []() consteval {
+  std::array<JitPS4::Instruction, 1024> table{};
+  table.fill(&JitPS4::FallBackToInterpreter);
+
+  for (const auto& tpl : s_table63)
+  {
+    ASSERT(table[tpl.opcode] == &JitPS4::FallBackToInterpreter);
+    table[tpl.opcode] = tpl.fn;
+  }
+
+  for (u32 i = 0; i < 32; i++)
+  {
+    const u32 fill = i << 5;
+    for (const auto& tpl : s_table63_2)
+    {
+      const u32 op = fill + tpl.opcode;
+      ASSERT(table[op] == &JitPS4::FallBackToInterpreter);
+      table[op] = tpl.fn;
+    }
+  }
+
+  return table;
+}();
+
+}  // Anonymous namespace
+
+void JitPS4::DynaRunTable4(UGeckoInstruction inst)
+{
+  (this->*s_dyna_op_table4[inst.SUBOP10])(inst);
+}
+
+void JitPS4::DynaRunTable19(UGeckoInstruction inst)
+{
+  (this->*s_dyna_op_table19[inst.SUBOP10])(inst);
+}
+
+void JitPS4::DynaRunTable31(UGeckoInstruction inst)
+{
+  (this->*s_dyna_op_table31[inst.SUBOP10])(inst);
+}
+
+void JitPS4::DynaRunTable59(UGeckoInstruction inst)
+{
+  (this->*s_dyna_op_table59[inst.SUBOP5])(inst);
+}
+
+void JitPS4::DynaRunTable63(UGeckoInstruction inst)
+{
+  (this->*s_dyna_op_table63[inst.SUBOP10])(inst);
+}
+
+void JitPS4::CompileInstruction(PPCAnalyst::CodeOp& op)
+{
+  (this->*s_dyna_op_table[op.inst.OPCD])(op.inst);
+
+  PPCTables::CountInstructionCompile(op.opinfo, js.compilerPC);
+}
+}  // namespace PS4Jit
