+// ---------------------------------------------------------------------------------------------
+// Updates.
+
+// The game settings center: the best settings per game, kept on GitHub so tuning reaches every
+// console without a new release. Fetched in the background at every start; the game process reads
+// /data/DolphinPS4/game-settings.ini (PlatformPS4.cpp LoadOptions). Only a file that starts with
+// the center's header line replaces the copy, written through a temporary file.
+void Menu::FetchGameSettings()
+{
+  m_settings_busy = true;
+  m_settings_thread = std::thread([this] {
+    PS4Net::Request request;
+    request.url = "https://raw.githubusercontent.com/iHaiDeeZ/DolphinPS4/main/xmb/game-settings.ini";
+    request.ca_file = m_assets_dir + "/xmb/cacert.pem";
+    request.timeout_seconds = 20;
+    std::string text, error;
+    const long status = PS4Net::Get(
+        request,
+        [&](const char* data, size_t size) {
+          text.append(data, size);
+          return text.size() < 512 * 1024;
+        },
+        nullptr, &error);
+    auto report = [this](const std::string& status_text) {
+      std::lock_guard lock(m_center_mutex);
+      m_center_status = status_text;
+      m_settings_done = true;
+    };
+    if (status != 200)
+    {
+      Log("game settings: not fetched (" + (error.empty() ? "HTTP " + std::to_string(status) : error) +
+          ")");
+      report("Failed (no connection)");
+      return;
+    }
+    if (text.rfind("# Dolphin for PS4 - game settings center", 0) != 0)
+    {
+      Log("game settings: the download isn't a settings center file, kept the old one");
+      report("Failed (not a settings file)");
+      return;
+    }
+    const std::string path = m_data_dir + "/game-settings.ini";
+    if (ReadFile(path) == text)
+    {
+      Log("game settings: up to date");
+      report("Up to date");
+      return;
+    }
+    const std::string temp = path + ".new";
+    if (FILE* file = fopen(temp.c_str(), "wb"))
+    {
+      const bool written = fwrite(text.data(), 1, text.size(), file) == text.size();
+      fflush(file);
+      fsync(fileno(file));
+      fclose(file);
+      if (written && std::rename(temp.c_str(), path.c_str()) == 0)
+        Log("game settings: updated from GitHub (" + std::to_string(text.size()) + " bytes)");
+    }
+    report("Updated");
+  });
+}
+
+// --- Game settings center --------------------------------------------------------------------
+// The best settings per game (xmb/game-settings.ini on GitHub, fetched at every start). Shown in
+// Settings -> Game Settings Center; before a covered game's first start the player is asked
+// whether to use them (PlatformPS4.cpp applies them unless the answer was No).
+
+void Menu::LoadCenter()
+{
+  m_center.clear();
+  const std::string fetched = m_data_dir + "/game-settings.ini";
+  std::string text = ReadFile(fetched);
+  m_center_fetched_copy = text.rfind("# Dolphin for PS4 - game settings center", 0) == 0;
+  if (!m_center_fetched_copy)
+    text = ReadFile(m_assets_dir + "/xmb/game-settings.ini");
+  CenterEntry* current = nullptr;
+  size_t start = 0;
+  while (start < text.size())
+  {
+    size_t end = text.find('\n', start);
+    if (end == std::string::npos)
+      end = text.size();
+    std::string line = text.substr(start, end - start);
+    start = end + 1;
+    while (!line.empty() && (line.back() == '\r' || line.back() == ' '))
+      line.pop_back();
+    if (line.size() > 2 && line.front() == '[' && line.back() == ']')
+    {
+      m_center.push_back({line.substr(1, line.size() - 2), {}, {}});
+      current = &m_center.back();
+      continue;
+    }
+    if (!current || line.empty())
+      continue;
+    if (line[0] == '#')
+    {
+      if (current->values.empty())
+        current->comment += (current->comment.empty() ? "" : " ") + line.substr(line.size() > 1 ? 2 : 1);
+      continue;
+    }
+    const size_t equals = line.find('=');
+    if (equals != std::string::npos)
+      current->values.emplace_back(line.substr(0, equals), line.substr(equals + 1));
+  }
+}
+
+// The entry for a game: its own ID, else its 3-character (every region) one.
+const Menu::CenterEntry* Menu::CenterFor(const std::string& game_id) const
+{
+  const CenterEntry* found = nullptr;
+  for (const CenterEntry& entry : m_center)
+  {
+    if (entry.id == game_id)
+      return &entry;
+    if (game_id.size() >= 3 && entry.id == game_id.substr(0, 3))
+      found = &entry;
+  }
+  return found;
+}
+
+// What an entry changes, in words.
+std::string Menu::CenterSummary(const CenterEntry& entry)
+{
+  std::vector<std::string> parts;
+  bool shortcut = false;
+  for (const auto& [key, value] : entry.values)
+  {
+    if (key == "speed_mode")
+      parts.push_back(value == "fast" ? "Speed Features Fast" : "Speed Features Compatible");
+    else if (key == "fifo_defer" || key == "jit_gp_fuse" || key == "jit_lazy_lfs" || key == "fifo_batch")
+    {
+      if (value == "off" && !shortcut)
+      {
+        parts.push_back("speed shortcuts adjusted");
+        shortcut = true;
+      }
+    }
+    else if (key == "flip_thread")
+      parts.push_back(value == "on" ? "frames shown from their own thread" : "frames shown by the video thread");
+    else if (key == "display_buffers")
+      parts.push_back(value + " display buffers");
+    else if (key == "sync_on_idle")
+      parts.push_back(value == "off"   ? "idle sync off" :
+                      value == "frame" ? "idle sync one frame behind" :
+                                         "idle sync on");
+    else if (key == "cpu_clock_min")
+      parts.push_back("clock floor " + value + "%");
+    else if (key == "cpu_clock")
+      parts.push_back("CPU clock " + value + "%");
+    else if (key == "dual_core")
+      parts.push_back("dual core");
+    else if (key == "jit_accurate_singles")
+      parts.push_back(value == "off" ? "fast float rounding" : "accurate float rounding");
+    else if (key == "cpu_core")
+      parts.push_back(value == "jitps4" ? "PS4 JIT" : "Dolphin JIT");
+    else if (key == "jit_cache")
+      parts.push_back("code cache " + value);
+    else if (key == "vertex_rounding")
+      parts.push_back(value == "on" ? "vertex rounding" : "no vertex rounding");
+    else if (key == "sync_gpu")
+      parts.push_back(value == "on" ? "GPU thread synchronized" : "GPU thread not synchronized");
+    else if (key == "perfmon")
+      parts.push_back("performance counters " + value);
+    else if (key == "zoom")
+      parts.push_back("letterbox zoom");
+    else if (key == "manual_texture_sampling")
+      parts.push_back("exact texture sampling");
+    else if (key == "tex_hash_once")
+      continue;
+    else if (key == "wii_extension")
+      parts.push_back(value == "none" ? "no Nunchuk" : "Nunchuk");
+    else if (key == "wii_sideways")
+      parts.push_back(value == "on" ? "sideways Wii Remote" : "Wii Remote pointed at the TV");
+    else if (key == "wii_upright")
+      parts.push_back(value == "on" ? "Wii Remote held like a wheel" : "Wii Remote held flat");
+    else if (key == "wii_touchpad")
+      parts.push_back(value == "pointer" ? "touchpad aims" :
+                      value == "swing"   ? "touchpad swipes swing" :
+                                           "touchpad off");
+    else if (key == "wii_tilt")
+      parts.push_back(value == "stick"  ? "tilt with the stick" :
+                      value == "motion" ? "tilt with motion" :
+                                          "tilt with motion and stick");
+    else
+      parts.push_back(key + " " + value);
+  }
+  std::string text;
+  for (const std::string& part : parts)
+    text += (text.empty() ? "" : ", ") + part;
+  return text;
+}
