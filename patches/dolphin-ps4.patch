+
+// Multi-disc games: "Name (Disc 1).rvz", "Name (Disc 2).rvz" (the usual naming). Finds the disc
+// number in a file name: position and length of its digits, or false.
+bool FindDiscNumber(const std::string& name, size_t* digits, size_t* length, int* number)
+{
+  std::string lower = name;
+  std::transform(lower.begin(), lower.end(), lower.begin(), ::tolower);
+  for (size_t at = lower.find("(disc "); at != std::string::npos;
+       at = lower.find("(disc ", at + 1))
+  {
+    size_t end = at + 6;
+    while (end < lower.size() && std::isdigit(static_cast<unsigned char>(lower[end])))
+      end++;
+    if (end > at + 6 && end < lower.size() && lower[end] == ')')
+    {
+      *digits = at + 6;
+      *length = end - (at + 6);
+      *number = std::atoi(lower.substr(at + 6, *length).c_str());
+      return true;
+    }
+  }
+  return false;
+}
+
+// The game library: every disc image in the games folder (Settings -> Game Folder, by default
+// /data/DolphinPS4/games), identified by its own header
+// (game ID, revision, disc number, internal title) rather than its file name.
+struct LibraryEntry
+{
+  std::string path;
+  std::string game_id;
+  u16 revision = 0;
+  int disc = 0;  // 0 = Disc 1
+  std::string title;
+};
+
+bool IsDiscImage(const std::string& name)
+{
+  static const std::array<std::string, 8> extensions = {".iso", ".gcm",  ".ciso", ".gcz",
+                                                        ".wbfs", ".wia", ".rvz",  ".nkit.iso"};
+  std::string lower = name;
+  std::transform(lower.begin(), lower.end(), lower.begin(), ::tolower);
+  for (const std::string& extension : extensions)
+  {
+    if (lower.size() > extension.size() &&
+        lower.compare(lower.size() - extension.size(), extension.size(), extension) == 0)
+      return true;
+  }
+  return false;
+}
+
+std::vector<LibraryEntry> ScanLibrary(const std::string& games_dir)
+{
+  std::vector<LibraryEntry> s_library;
+  std::error_code error;
+  for (const auto& entry : std::filesystem::directory_iterator(games_dir, error))
+  {
+    const std::string name = entry.path().filename().string();
+    if (!IsDiscImage(name))
+      continue;
+    LibraryEntry game;
+    game.path = entry.path().string();
+    if (std::unique_ptr<DiscIO::VolumeDisc> disc = DiscIO::CreateDisc(game.path))
+    {
+      game.game_id = disc->GetGameID();
+      game.revision = disc->GetRevision().value_or(0);
+      game.disc = disc->GetDiscNumber().value_or(0);
+      game.title = disc->GetInternalName();
+    }
+    s_library.push_back(std::move(game));
+  }
+  std::sort(s_library.begin(), s_library.end(), [](const LibraryEntry& a, const LibraryEntry& b) {
+    return std::tie(a.title, a.game_id, a.disc, a.path) <
+           std::tie(b.title, b.game_id, b.disc, b.path);
+  });
+  for (const LibraryEntry& game : s_library)
+  {
+    char line[512];
+    snprintf(line, sizeof(line), "library: %s rev %u disc %d \"%s\" (%s)",
+             game.game_id.empty() ? "??????" : game.game_id.c_str(), game.revision, game.disc + 1,
+             game.title.c_str(), std::filesystem::path(game.path).filename().string().c_str());
+    Platform::BootTrace(line);
+  }
+  return s_library;
+}
+
+const std::vector<LibraryEntry>& GameLibrary()
+{
+  static const std::vector<LibraryEntry> s_library =
+      ScanLibrary(PS4XMB::GamesDir(PS4_DATA_DIR_PATH));
+  return s_library;
+}
+
+// All discs of the game `path` belongs to, `path` first, then the others in disc order (wrapping
+// around). Dolphin switches between them when the game asks for another disc, so players never
+// have to write an .m3u playlist. Discs belong together when their headers have the same game ID
+// and revision (file names don't matter); images whose header can't be read are grouped by a
+// "(Disc N)" in their names instead.
+std::vector<std::string> FindAllDiscs(const std::string& path)
+{
+  {
+    const std::vector<LibraryEntry>& library = GameLibrary();
+    const std::filesystem::path chosen_path(path);
+    const auto chosen = std::find_if(library.begin(), library.end(), [&](const LibraryEntry& game) {
+      return std::filesystem::path(game.path) == chosen_path;
+    });
+    if (chosen != library.end() && !chosen->game_id.empty())
+    {
+      std::vector<const LibraryEntry*> discs;
+      for (const LibraryEntry& game : library)
+      {
+        if (game.game_id == chosen->game_id && game.revision == chosen->revision)
+          discs.push_back(&game);
+      }
+      std::sort(discs.begin(), discs.end(),
+                [](const LibraryEntry* a, const LibraryEntry* b) { return a->disc < b->disc; });
+      std::vector<std::string> ordered;
+      for (const LibraryEntry* game : discs)
+      {
+        if (game->disc >= chosen->disc)
+          ordered.push_back(game->path);
+      }
+      for (const LibraryEntry* game : discs)
+      {
+        if (game->disc < chosen->disc)
+          ordered.push_back(game->path);
+      }
+      if (!ordered.empty() && ordered.front() == chosen->path)
+        return ordered;
+    }
+  }
+
+  const std::filesystem::path chosen(path);
+  const std::string name = chosen.filename().string();
+  size_t digits, length;
+  int number;
+  if (!FindDiscNumber(name, &digits, &length, &number))
+    return {path};
+  const std::string prefix = name.substr(0, digits);
+  const std::string suffix = name.substr(digits + length);
+  std::vector<std::pair<int, std::string>> discs;
+  std::error_code error;
+  for (const auto& entry : std::filesystem::directory_iterator(chosen.parent_path(), error))
+  {
+    const std::string other = entry.path().filename().string();
+    size_t other_digits, other_length;
+    int other_number;
+    if (FindDiscNumber(other, &other_digits, &other_length, &other_number) &&
+        other.substr(0, other_digits) == prefix &&
+        other.substr(other_digits + other_length) == suffix)
+    {
+      discs.emplace_back(other_number, entry.path().string());
+    }
+  }
+  std::sort(discs.begin(), discs.end());
+  std::vector<std::string> ordered;
+  for (const auto& [disc, file] : discs)
+  {
+    if (disc >= number)
+      ordered.push_back(file);
+  }
+  for (const auto& [disc, file] : discs)
+  {
+    if (disc < number)
+      ordered.push_back(file);
+  }
+  if (ordered.empty() || ordered.front() != chosen.string())
+    return {path};  // the chosen file wasn't found by the scan (odd path): just boot it
+  return ordered;
+}
+
+std::string FindGame()
+{
+  // /data/DolphinPS4/boot.txt: path of the game to start (first line).
+  if (FILE* file = fopen((std::string(PS4_DATA_DIR_PATH) + "/boot.txt").c_str(), "r"))
+  {
+    char line[1024] = {};
+    const bool read = fgets(line, sizeof(line), file) != nullptr;
+    fclose(file);
+    std::string path = read ? line : "";
+    while (!path.empty() && (path.back() == '\n' || path.back() == '\r' || path.back() == ' '))
+      path.pop_back();
+    if (!path.empty())
+      return path;
+  }
+
+  // Otherwise the first game of the library (by title), on its first disc.
+  for (const LibraryEntry& game : GameLibrary())
+  {
+    if (!game.game_id.empty() && game.disc == 0)
+      return game.path;
+  }
+
+  // Otherwise the first game in the games folder, in name order.
+  const std::array<std::string, 12> extensions = {".iso", ".gcm", ".ciso", ".gcz", ".wbfs",
+                                                  ".wia", ".rvz", ".dol", ".elf", ".wad", ".nkit.iso",
+                                                  ".m3u"};
+  std::vector<std::string> games;
+  std::error_code error;
+  for (const auto& entry :
+       std::filesystem::directory_iterator(PS4XMB::GamesDir(PS4_DATA_DIR_PATH), error))
+  {
+    std::string name = entry.path().filename().string();
+    // Only the first disc of a multi-disc game is a game to start (the others come with it).
+    size_t disc_digits, disc_length;
+    int disc_number;
+    if (FindDiscNumber(name, &disc_digits, &disc_length, &disc_number) && disc_number != 1)
+      continue;
+    std::string lower = name;
+    std::transform(lower.begin(), lower.end(), lower.begin(), ::tolower);
+    for (const std::string& extension : extensions)
+    {
+      if (lower.size() > extension.size() &&
+          lower.compare(lower.size() - extension.size(), extension.size(), extension) == 0)
+      {
+        games.push_back(entry.path().string());
+        break;
+      }
+    }
+  }
+  std::sort(games.begin(), games.end());
+  return games.empty() ? std::string() : games.front();
+}
+
+// Controller mappings for the DualShock 4 (ciface::PS4Pad), written on first launch only so that
+// user edits are kept.
+void WriteDefaultFile(const std::string& path, const char* contents)
+{
+  struct stat st;
+  if (stat(path.c_str(), &st) == 0)
+    return;
+  if (FILE* file = fopen(path.c_str(), "w"))
+  {
+    fputs(contents, file);
+    fclose(file);
+  }
+}
+
+void WriteDefaultConfig(const std::string& user_dir)
+{
+  mkdir(user_dir.c_str(), 0777);
+  mkdir((user_dir + "/Config").c_str(), 0777);
+  PS4Controls::SetUserDirectory(user_dir);
+  PS4Controls::WriteDefaultsIfMissing();
+}
+
+void OnExit()
+{
+  // The raw exit syscall isn't allowed for apps: ask the system to close us, or restart into the
+  // XMB when the in-game menu's "Quit Game" stopped the emulation.
+  fflush(stderr);
+  if (PS4IngameMenu::ReturnToXMB())
+    sceSystemServiceLoadExec("/app0/eboot.bin", nullptr);
+  sceSystemServiceLoadExec("exit", nullptr);
+  for (;;)
+    sceKernelUsleep(100000);
+}
