+
+void AXUCode::PS4StartCommandList()
+{
+  if (!m_ps4_worker.joinable())
+  {
+    m_ps4_worker = std::thread([this] {
+      std::unique_lock lock(m_ps4_mutex);
+      for (;;)
+      {
+        m_ps4_cv.wait(lock, [this] { return m_ps4_job || m_ps4_quit; });
+        if (m_ps4_quit)
+          return;
+        lock.unlock();
+        HandleCommandList();
+        lock.lock();
+        m_ps4_job = false;
+        m_ps4_cv.notify_all();
+      }
+    });
+    ps4_boot_trace("audio: AX command lists on their own thread (dsp_async)");
+  }
+  m_ps4_list_mails.clear();
+  m_ps4_list_async = true;
+  m_ps4_list_pending = true;
+  m_ps4_list_updates = 0;
+  s_ps4_pending_ucode = this;
+  {
+    std::lock_guard lock(m_ps4_mutex);
+    m_ps4_job = true;
+  }
+  m_ps4_cv.notify_all();
+}
+
+void AXUCode::PS4WaitForWorker()
+{
+  std::unique_lock lock(m_ps4_mutex);
+  m_ps4_cv.wait(lock, [this] { return !m_ps4_job; });
+}
+
+void AXUCode::PS4FinishCommandList()
+{
+  if (!m_ps4_list_pending)
+    return;
+  PS4WaitForWorker();
+  m_ps4_list_pending = false;
+  m_ps4_list_async = false;
+  if (s_ps4_pending_ucode == this)
+    s_ps4_pending_ucode = nullptr;
+  for (const u32 mail : m_ps4_list_mails)
+    m_mail_handler.PushMail(mail, true);
+  m_ps4_list_mails.clear();
+  SignalWorkEnd();
+}
+
+void AXUCode::PS4FlushForState(bool loading)
+{
+  if (!m_ps4_list_pending)
+    return;
+  if (!loading)
+  {
+    PS4FinishCommandList();
+    return;
+  }
+  PS4WaitForWorker();  // the loaded state replaces everything it did
+  m_ps4_list_pending = false;
+  m_ps4_list_async = false;
+  m_ps4_list_mails.clear();
+  if (s_ps4_pending_ucode == this)
+    s_ps4_pending_ucode = nullptr;
+}
+
+void AXUCode::PS4StopWorker()
+{
+  if (!m_ps4_worker.joinable())
+    return;
+  PS4WaitForWorker();
+  {
+    std::lock_guard lock(m_ps4_mutex);
+    m_ps4_quit = true;
+  }
+  m_ps4_cv.notify_all();
+  m_ps4_worker.join();
+  if (s_ps4_pending_ucode == this)
+    s_ps4_pending_ucode = nullptr;
+}
+
+AXUCode::~AXUCode()
+{
+  PS4StopWorker();
+}
