+// Rebuilds the rows for the current page (host thread, s_mutex not held while computing).
+void BuildRows()
+{
+  std::vector<Row> rows;
+  std::vector<std::string> keys;
+  std::vector<std::pair<Glyph, std::string>> hints;
+  int selected;
+  std::string subtitle;
+  if (s_page == Page::Main)
+  {
+    const std::string slot = "Slot " + std::to_string(s_slot);
+    for (const int item : s_main_items)
+    {
+      switch (item)
+      {
+      case MAIN_RESUME:
+        rows.push_back({"Resume Game"});
+        break;
+      case MAIN_SAVE:
+        rows.push_back({"Save State", slot});
+        break;
+      case MAIN_LOAD:
+        rows.push_back({"Load State", slot});
+        break;
+      case MAIN_WII_EXTENSION:
+        rows.push_back({"Wii Extension",
+                        PS4Settings::Get("wii_extension", s_game_id) == "none" ? "None" :
+                                                                                 "Nunchuk"});
+        break;
+      case MAIN_WII_SIDEWAYS:
+        rows.push_back({"Sideways Wii Remote",
+                        PS4Settings::Get("wii_sideways", s_game_id) == "on" ? "On" : "Off"});
+        break;
+      case MAIN_SETTINGS:
+        rows.push_back({"Settings"});
+        break;
+      case MAIN_CHEATS:
+        rows.push_back({"Cheats"});
+        break;
+      case MAIN_QUIT:
+        rows.push_back({"Quit Game"});
+        break;
+      }
+    }
+    selected = s_main_selected;
+    subtitle = "PAUSED";
+    hints = {{Glyph::Cross, "Select"}};
+    const int item = s_main_items.empty() ? MAIN_RESUME : s_main_items[s_main_selected];
+    if (item == MAIN_SAVE || item == MAIN_LOAD)
+      hints.push_back({Glyph::LeftRight, "Slot"});
+    if (item == MAIN_WII_EXTENSION || item == MAIN_WII_SIDEWAYS)
+      hints.push_back({Glyph::LeftRight, "Change"});
+    hints.push_back({Glyph::Circle, "Resume"});
+    hints.push_back({Glyph::L3R3, "Resume"});
+  }
+  else if (s_page == Page::Cheats)
+  {
+    const auto entries = s_cheats.Entries();
+    if (!entries.empty())
+    {
+      rows.push_back({"Enable All"});
+      keys.push_back("cheatall:on");
+      rows.push_back({"Disable All"});
+      keys.push_back("cheatall:off");
+    }
+    bool last_gecko = false;
+    for (size_t i = 0; i < entries.size(); i++)
+    {
+      if (i == 0 || entries[i].gecko != last_gecko)
+      {
+        rows.push_back({entries[i].gecko ? "Gecko Codes" : "Action Replay Codes", "", true});
+        keys.push_back("");
+      }
+      last_gecko = entries[i].gecko;
+      Row row{entries[i].name};
+      row.tag = entries[i].enabled ? 1 : -1;
+      rows.push_back(row);
+      keys.push_back("cheat:" + std::to_string(i));
+    }
+    if (entries.empty())
+    {
+      rows.push_back({"No cheats for this game", "", true});
+      keys.push_back("");
+    }
+    selected = s_settings_selected;
+    subtitle = "CHEATS";
+    hints = {{Glyph::Cross, "On/Off"}, {Glyph::UpDown, "Move"}, {Glyph::Circle, "Back"}};
+  }
+  else
+  {
+    const bool custom = Custom();
+    rows.push_back({"Apply To", custom ? "This Game" : "All Games"});
+    keys.push_back("");
+    for (const char* category : PS4Settings::Categories())
+    {
+      rows.push_back({category, "", true});
+      keys.push_back("");
+      for (const PS4Settings::Setting& setting : PS4Settings::All())
+      {
+        if (std::string(setting.category) != category)
+          continue;
+        const std::string value = PS4Settings::Get(setting.key, s_game_id);
+        rows.push_back({setting.label, PS4Settings::LabelOf(setting, value), false,
+                        !setting.live});
+        keys.push_back(setting.key);
+      }
+    }
+    rows.push_back({"", "", true});
+    keys.push_back("");
+    rows.push_back({custom ? "Reset This Game" : "Reset to Defaults", ""});
+    keys.push_back("__reset__");
+    selected = s_settings_selected;
+    subtitle = custom ? "SETTINGS - THIS GAME" : "SETTINGS - ALL GAMES";
+    hints = {{Glyph::LeftRight, "Change"}, {Glyph::UpDown, "Move"}, {Glyph::Circle, "Back"}};
+  }
+  s_row_keys = std::move(keys);
+  std::lock_guard lock(s_mutex);
+  s_rows = std::move(rows);
+  s_selected = selected;
+  s_subtitle = subtitle;
+  s_hints = std::move(hints);
+}
+
+void Toast(const std::string& text)
+{
+  std::lock_guard lock(s_mutex);
+  s_toast = text;
+  s_toast_until = Clock::now() + std::chrono::milliseconds(2200);
+}
+
+// Host thread, s_mutex not held (Core calls wait for the video thread, which takes s_mutex).
+void Close(Core::System& system)
+{
+  {
+    std::lock_guard lock(s_mutex);
+    s_open = false;
+  }
+  s_watch = false;
+  ps4_pad_block = 1;  // the game sees a neutral pad until the buttons are released
+  Core::SetState(system, Core::State::Running);
+  Log("closed");
+}
+
+void Open(Core::System& system)
+{
+  s_game_id = SConfig::GetInstance().GetGameID();
+  std::string title = SConfig::GetInstance().GetTitleName();
+  if (title.empty())
+    title = s_game_id;
+  s_page = Page::Main;
+  s_main_selected = 0;
+  s_wii = system.IsWii();
+  s_main_items = {MAIN_RESUME, MAIN_SAVE, MAIN_LOAD};
+  if (s_wii)
+  {
+    s_main_items.push_back(MAIN_WII_EXTENSION);
+    s_main_items.push_back(MAIN_WII_SIDEWAYS);
+  }
+  s_main_items.insert(s_main_items.end(), {MAIN_SETTINGS, MAIN_CHEATS, MAIN_QUIT});
+  BuildRows();
+  {
+    std::lock_guard lock(s_mutex);
+    s_title = std::move(title);
+    s_open = true;
+  }
+  ps4_pad_block = 1;
+  Core::SetState(system, Core::State::Paused);
+  s_watch = true;
+  Log("opened");
+}
+
+// Changes the setting on a settings row (direction -1/+1) and saves it.
+void ChangeSetting(int row, int direction)
+{
+  if (row < 0 || row >= static_cast<int>(s_row_keys.size()))
+    return;
+  if (s_page == Page::Cheats)
+  {
+    const std::string& key = s_row_keys[row];
+    if (key.rfind("cheatall:", 0) == 0)
+    {
+      const bool on = key == "cheatall:on";
+      s_cheats.SetAll(on);
+      s_cheats.ApplyToRunningGame();
+      Toast(on ? "All cheats on" : "All cheats off");
+      Log(on ? "cheats: all on" : "cheats: all off");
+      return;
+    }
+    if (key.rfind("cheat:", 0) != 0)
+      return;
+    const size_t index = static_cast<size_t>(std::atoi(key.c_str() + 6));
+    s_cheats.Toggle(index);
+    s_cheats.ApplyToRunningGame();
+    const auto entries = s_cheats.Entries();
+    if (index < entries.size())
+    {
+      Toast(entries[index].name + (entries[index].enabled ? ": on" : ": off"));
+      Log("cheat " + entries[index].name + (entries[index].enabled ? " on" : " off"));
+    }
+    return;
+  }
+  if (row == 0)
+  {
+    // Apply To: this game (its own copy of the settings) or all games (global).
+    const bool custom = !Custom();
+    PS4Settings::SetCustom(s_game_id, custom);
+    if (!custom)
+    {
+      // Back to the global values: apply them to the running game.
+      for (const PS4Settings::Setting& setting : PS4Settings::All())
+      {
+        if (setting.live)
+          PS4Settings::ApplyLive(setting.key, PS4Settings::Get(setting.key, s_game_id));
+      }
+    }
+    Toast(custom ? "Settings for this game only" : "This game follows the global settings");
+    Log(custom ? "settings: custom for " + s_game_id : "settings: global for " + s_game_id);
+    return;
+  }
+  const std::string key = s_row_keys[row];
+  if (key == "__reset__")
+  {
+    // This game: back to the global settings. All games: back to ps4.ini's tuned defaults.
+    if (direction <= 0)
+      return;  // Cross or Right only
+    const bool custom = Custom();
+    if (custom)
+    {
+      PS4Settings::ResetGame(s_game_id);
+    }
+    else
+    {
+      for (const PS4Settings::Setting& setting : PS4Settings::All())
+        PS4Settings::ResetGlobal(setting.key);
+    }
+    for (const PS4Settings::Setting& setting : PS4Settings::All())
+    {
+      if (setting.live)
+        PS4Settings::ApplyLive(setting.key, PS4Settings::Get(setting.key, s_game_id));
+    }
+    Toast(custom ? "This game uses the global settings again" : "Settings reset to defaults");
+    Log(custom ? "settings: reset " + s_game_id : "settings: reset global");
+    return;
+  }
+  const PS4Settings::Setting* setting = PS4Settings::Find(key);
+  if (!setting)
+    return;
+  const std::string value =
+      PS4Settings::Step(*setting, PS4Settings::Get(key, s_game_id), direction);
+  PS4Settings::Set(key, value, Custom() ? s_game_id : std::string());
+  if (setting->live)
+    PS4Settings::ApplyLive(key, value);
+  else
+    Toast(std::string(setting->label) + ": next time a game starts");
+  Log("setting " + key + "=" + value + (Custom() ? " (" + s_game_id + ")" : " (global)"));
+}
+
+void SelectableMove(int direction)
+{
+  if (s_page == Page::Main)
+  {
+    s_main_selected = std::clamp(s_main_selected + direction, 0,
+                                 static_cast<int>(s_main_items.size()) - 1);
+    return;
+  }
+  const int count = static_cast<int>(s_row_keys.size());
+  int row = s_settings_selected + direction;
+  // Skip category headers (row 0, "Apply To", is selectable).
+  while (row > 0 && row < count && s_row_keys[row].empty())
+    row += direction;
+  if (row >= 0 && row < count && (row > 0 || s_page == Page::Settings))
+    s_settings_selected = row;
+}
+
+// Wii games: the Wii Remote's Nunchuk / sideways orientation, changed in the running game (the
+// game sees the Nunchuk plugged in or out, as on a Wii) and kept for this game.
+void ToggleWiiRemote(int item)
+{
+  const bool extension_row = item == MAIN_WII_EXTENSION;
+  const char* key = extension_row ? "wii_extension" : "wii_sideways";
+  const std::string current = PS4Settings::Get(key, s_game_id);
+  const std::string value = extension_row ? (current == "none" ? "nunchuk" : "none") :
+                                            (current == "on" ? "off" : "on");
+  PS4Settings::Set(key, value, s_game_id);
+  const bool nunchuk = PS4Settings::Get("wii_extension", s_game_id) != "none";
+  const bool sideways = PS4Settings::Get("wii_sideways", s_game_id) == "on";
+  {
+    const auto lock = ControllerEmu::EmulatedController::GetStateLock();
+    auto* attachments = static_cast<ControllerEmu::Attachments*>(
+        Wiimote::GetWiimoteGroup(0, WiimoteEmu::WiimoteGroup::Attachments));
+    attachments->SetSelectedAttachment(nunchuk ? WiimoteEmu::ExtensionNumber::NUNCHUK :
+                                                 WiimoteEmu::ExtensionNumber::NONE);
+    auto* options = Wiimote::GetWiimoteGroup(0, WiimoteEmu::WiimoteGroup::Options);
+    for (auto& setting : options->numeric_settings)
+    {
+      if (std::string(setting->GetININame()) == "Sideways Wiimote")
+        static_cast<ControllerEmu::NumericSetting<bool>*>(setting.get())->SetValue(sideways);
+    }
+  }
+  Toast(extension_row ? (nunchuk ? "Nunchuk plugged in" : "Nunchuk unplugged") :
+                        (sideways ? "Wii Remote held sideways" : "Wii Remote held upright"));
+  Log(std::string("wii remote: ") + key + "=" + value + " (" + s_game_id + ")");
+}
+
+// A clean stop writes the memory cards; the app then restarts into the XMB (PlatformPS4).
+void QuitToXMB(Core::System& system, const char* why)
+{
+  Log(why);
+  s_quit = true;
+  s_quit_time = Clock::now();
+  {
+    std::lock_guard lock(s_mutex);
+    s_open = false;
+  }
+  s_watch = false;
+  Core::Stop(system);
+}
+
+void Activate(Core::System& system)
+{
+  if (s_page != Page::Main)
+  {
+    ChangeSetting(s_settings_selected, 1);
+    return;
+  }
+  switch (s_main_items[s_main_selected])
+  {
+  case MAIN_WII_EXTENSION:
+  case MAIN_WII_SIDEWAYS:
+    ToggleWiiRemote(s_main_items[s_main_selected]);
+    break;
+  case MAIN_RESUME:
+    Close(system);
+    break;
+  case MAIN_SAVE:
+    if (ps4_state_busy > 0)
+    {
+      Toast("Still saving, please wait...");
+      break;
+    }
+    Log("saving state " + std::to_string(s_slot));
+    s_saving_slot = s_slot;
+    State::Save(system, static_cast<u32>(s_slot));
+    Toast("Saving to slot " + std::to_string(s_slot) + "...");
+    break;
+  case MAIN_LOAD:
+    if (ps4_state_busy > 0)
+    {
+      Toast("Still saving, please wait...");
+      break;
+    }
+    Log("loading state " + std::to_string(s_slot));
+    State::Load(system, static_cast<u32>(s_slot));
+    Log("load requested " + std::to_string(s_slot));
+    Close(system);
+    break;
+  case MAIN_SETTINGS:
+    s_page = Page::Settings;
+    s_settings_selected = 0;
+    break;
+  case MAIN_CHEATS:
+    s_page = Page::Cheats;
+    s_cheats.Load(s_game_id, SConfig::GetInstance().GetRevision());
+    s_settings_selected = 0;
+    BuildRows();
+    // First selectable row (row 0 is the first header).
+    SelectableMove(1);
+    if (!s_row_keys.empty() && s_row_keys[s_settings_selected].empty())
+      s_settings_selected = 0;
+    break;
+  case MAIN_QUIT:
+    QuitToXMB(system, "quit to the XMB");
+    break;
+  }
+}
+
+// ---- Drawing (video thread) ----
+
+void DrawGlyph(ImDrawList* dl, Glyph glyph, ImVec2 c, float r, float a)
+{
+  const ImU32 ring = IM_COL32(255, 255, 255, static_cast<int>(60 * a));
+  auto colour = [a](int rr, int g, int b) {
+    return IM_COL32(rr, g, b, static_cast<int>(255 * a));
+  };
+  switch (glyph)
+  {
+  case Glyph::Cross:
+    dl->AddCircleFilled(c, r, ring, 28);
+    dl->AddLine(ImVec2(c.x - r * 0.45f, c.y - r * 0.45f), ImVec2(c.x + r * 0.45f, c.y + r * 0.45f),
+                colour(120, 170, 255), r * 0.22f);
+    dl->AddLine(ImVec2(c.x - r * 0.45f, c.y + r * 0.45f), ImVec2(c.x + r * 0.45f, c.y - r * 0.45f),
+                colour(120, 170, 255), r * 0.22f);
+    break;
+  case Glyph::Circle:
+    dl->AddCircleFilled(c, r, ring, 28);
+    dl->AddCircle(c, r * 0.48f, colour(255, 100, 110), 24, r * 0.2f);
+    break;
+  case Glyph::LeftRight:
+  case Glyph::UpDown:
+  {
+    // A D-pad with the two arrows in use lit.
+    const float s = r * 0.42f;
+    const ImU32 dim = IM_COL32(255, 255, 255, static_cast<int>(70 * a));
+    const ImU32 lit = colour(255, 255, 255);
+    const bool lr = glyph == Glyph::LeftRight;
+    dl->AddRectFilled(ImVec2(c.x - s * 0.5f, c.y - r), ImVec2(c.x + s * 0.5f, c.y - s * 0.5f),
+                      lr ? dim : lit, 2.0f);
+    dl->AddRectFilled(ImVec2(c.x - s * 0.5f, c.y + s * 0.5f), ImVec2(c.x + s * 0.5f, c.y + r),
+                      lr ? dim : lit, 2.0f);
+    dl->AddRectFilled(ImVec2(c.x - r, c.y - s * 0.5f), ImVec2(c.x - s * 0.5f, c.y + s * 0.5f),
+                      lr ? lit : dim, 2.0f);
+    dl->AddRectFilled(ImVec2(c.x + s * 0.5f, c.y - s * 0.5f), ImVec2(c.x + r, c.y + s * 0.5f),
+                      lr ? lit : dim, 2.0f);
+    break;
+  }
+  case Glyph::L3R3:
+  {
+    // Two round buttons, "L3" and "R3" written in them, with a "+" between.
+    ImFont* font = ps4_overlay_font ? ps4_overlay_font : ImGui::GetFont();
+    const float button_r = r * 0.95f, offset = r * 1.45f;
+    for (int i = 0; i < 2; i++)
+    {
+      const ImVec2 p(c.x + (i == 0 ? -offset : offset), c.y);
+      dl->AddCircleFilled(p, button_r, IM_COL32(20, 24, 34, static_cast<int>(230 * a)), 28);
+      dl->AddCircle(p, button_r, colour(255, 255, 255), 28, r * 0.1f);
+      const char* label = i == 0 ? "L3" : "R3";
+      const float fs = r * 0.95f;
+      const ImVec2 ts = font->CalcTextSizeA(fs, FLT_MAX, 0, label);
+      dl->AddText(font, fs, ImVec2(p.x - ts.x * 0.5f, p.y - ts.y * 0.5f), colour(255, 255, 255),
+                  label);
+    }
+    const float plus = r * 0.22f;
+    dl->AddLine(ImVec2(c.x - plus, c.y), ImVec2(c.x + plus, c.y), colour(255, 255, 255),
+                r * 0.1f);
+    dl->AddLine(ImVec2(c.x, c.y - plus), ImVec2(c.x, c.y + plus), colour(255, 255, 255),
+                r * 0.1f);
+    break;
+  }
+  }
+}
+
+void Draw()
+{
+  s_draws++;
+  std::lock_guard lock(s_mutex);
+  const auto now = Clock::now();
+  const float dt =
+      std::clamp(std::chrono::duration<float>(now - s_last_draw).count(), 0.0f, 0.1f);
+  s_last_draw = now;
+  s_appear += ((s_open ? 1.0f : 0.0f) - s_appear) * (1.0f - std::exp(-14.0f * dt));
+  const bool toast = now < s_toast_until;
+  if (!s_hint_started)
+  {
+    s_hint_started = true;
+    s_hint_start = now;
+  }
+  // Shown from 3 s to 10 s after the game's first frame, fading in and out.
+  const float hint_time = std::chrono::duration<float>(now - s_hint_start).count();
+  const float hint_alpha =
+      hint_time < 3.0f || hint_time > 10.0f ?
+          0.0f :
+          std::min({1.0f, (hint_time - 3.0f) / 0.4f, (10.0f - hint_time) / 0.6f});
+  if (s_appear < 0.01f && !toast && hint_alpha <= 0.0f)
+    return;
+
+  ImDrawList* dl = ImGui::GetForegroundDrawList();
+  const ImVec2 size = ImGui::GetIO().DisplaySize;
+  ImFont* bold = ps4_overlay_font ? ps4_overlay_font : ImGui::GetFont();
+  ImFont* regular = ps4_overlay_font_regular ? ps4_overlay_font_regular : bold;
+  const float s = size.y / 1080.0f;  // layout in 1080p units
+  const float a = s_appear;
+
+  if (a > 0.01f)
+  {
+    dl->AddRectFilled(ImVec2(0, 0), size, IM_COL32(0, 0, 0, static_cast<int>(150 * a)));
+    const float panel_w = 860.0f * s;
+    const float x0 = -panel_w * (1.0f - a);
+    dl->AddRectFilledMultiColor(ImVec2(x0, 0), ImVec2(x0 + panel_w, size.y),
+                                IM_COL32(8, 20, 46, static_cast<int>(240 * a)),
+                                IM_COL32(8, 20, 46, static_cast<int>(150 * a)),
+                                IM_COL32(2, 6, 16, static_cast<int>(150 * a)),
+                                IM_COL32(2, 6, 16, static_cast<int>(240 * a)));
+    dl->AddLine(ImVec2(x0 + panel_w, 0), ImVec2(x0 + panel_w, size.y),
+                IM_COL32(91, 184, 255, static_cast<int>(200 * a)), 2.0f * s);
+    const ImU32 white = IM_COL32(255, 255, 255, static_cast<int>(255 * a));
+    const ImU32 dim = IM_COL32(255, 255, 255, static_cast<int>(165 * a));
+    const ImU32 accent = IM_COL32(120, 196, 255, static_cast<int>(255 * a));
+    dl->AddText(regular, 26 * s, ImVec2(x0 + 70 * s, 90 * s), accent, s_subtitle.c_str());
+    dl->AddText(bold, 40 * s, ImVec2(x0 + 70 * s, 122 * s), white, s_title.c_str(), nullptr,
+                panel_w - 120 * s);
+
+    // The list scrolls to keep the selection in view.
+    const float row_h = 62.0f * s;
+    const float top = 220.0f * s, bottom = size.y - 160.0f * s;
+    const float visible = (bottom - top) / row_h;
+    const float target = std::clamp(static_cast<float>(s_selected) - visible * 0.5f + 1.0f, 0.0f,
+                                    std::max(0.0f, static_cast<float>(s_rows.size()) - visible));
+    s_scroll += (target - s_scroll) * (1.0f - std::exp(-16.0f * dt));
+    dl->PushClipRect(ImVec2(x0, top - 10 * s), ImVec2(x0 + panel_w, bottom + 10 * s), true);
+    for (size_t i = 0; i < s_rows.size(); i++)
+    {
+      const Row& row = s_rows[i];
+      const float y = top + (static_cast<float>(i) - s_scroll) * row_h;
+      if (y < top - row_h || y > bottom)
+        continue;
+      if (row.header)
+      {
+        dl->AddText(bold, 26 * s, ImVec2(x0 + 70 * s, y + 16 * s), accent, row.label.c_str());
+        dl->AddLine(ImVec2(x0 + 70 * s, y + 52 * s), ImVec2(x0 + panel_w - 60 * s, y + 52 * s),
+                    IM_COL32(120, 196, 255, static_cast<int>(70 * a)), 1.5f * s);
+        continue;
+      }
+      const bool sel = static_cast<int>(i) == s_selected;
+      if (sel)
+      {
+        dl->AddRectFilled(ImVec2(x0 + 40 * s, y - 4 * s),
+                          ImVec2(x0 + panel_w - 40 * s, y + 54 * s),
+                          IM_COL32(91, 184, 255, static_cast<int>(70 * a)), 12 * s);
+      }
+      dl->AddText(sel ? bold : regular, (sel ? 36 : 32) * s, ImVec2(x0 + 70 * s, y + 4 * s),
+                  sel ? white : dim, row.label.c_str());
+      if (row.tag != 0)
+      {
+        // Cheats: a green ON or red OFF tag.
+        const char* label = row.tag > 0 ? "ON" : "OFF";
+        const float ts = 24 * s;
+        const float tw = bold->CalcTextSizeA(ts, FLT_MAX, 0, label).x;
+        const float right = x0 + panel_w - 80 * s, w = tw + 30 * s;
+        const ImU32 fill = row.tag > 0 ? IM_COL32(40, 170, 90, static_cast<int>(230 * a)) :
+                                         IM_COL32(210, 55, 70, static_cast<int>(230 * a));
+        dl->AddRectFilled(ImVec2(right - w, y + 8 * s), ImVec2(right, y + 44 * s), fill, 18 * s);
+        dl->AddText(bold, ts, ImVec2(right - w + 15 * s, y + 13 * s), white, label);
+      }
+      else if (!row.value.empty())
+      {
+        const float vs = 30 * s;
+        const float tw = regular->CalcTextSizeA(vs, FLT_MAX, 0, row.value.c_str()).x;
+        const ImU32 colour =
+            row.note ? IM_COL32(255, 210, 120, static_cast<int>((sel ? 255 : 170) * a)) :
+            sel      ? white :
+                       dim;
+        dl->AddText(regular, vs, ImVec2(x0 + panel_w - 80 * s - tw, y + 7 * s), colour,
+                    row.value.c_str());
+      }
+    }
+    dl->PopClipRect();
+
+    // Button hints with icons.
+    float hx = x0 + 70 * s;
+    const float hy = size.y - 90 * s;
+    for (const auto& [glyph, text] : s_hints)
+    {
+      const float r = 18 * s;
+      const float w = glyph == Glyph::L3R3 ? r * 2.4f : r;
+      DrawGlyph(dl, glyph, ImVec2(hx + w, hy), r, a);
+      hx += w * 2 + 14 * s;
+      dl->AddText(regular, 28 * s, ImVec2(hx, hy - 17 * s), dim, text.c_str());
+      hx += regular->CalcTextSizeA(28 * s, FLT_MAX, 0, text.c_str()).x + 40 * s;
+    }
+  }
+  if (toast)
+  {
+    const float tw = bold->CalcTextSizeA(32 * s, FLT_MAX, 0, s_toast.c_str()).x;
+    const ImVec2 p(size.x - tw - 120 * s, size.y - 150 * s);
+    dl->AddRectFilled(ImVec2(p.x - 30 * s, p.y - 18 * s), ImVec2(p.x + tw + 30 * s, p.y + 56 * s),
+                      IM_COL32(8, 20, 46, 225), 14 * s);
+    dl->AddText(bold, 32 * s, p, IM_COL32(255, 255, 255, 255), s_toast.c_str());
+  }
+  if (hint_alpha > 0.0f && s_appear < 0.5f && !toast)
+  {
+    // "L3 + R3 for the menu", with the two stick icons, in the bottom-right corner.
+    const char* label = "Menu";
+    const float ts = 30 * s, r = 20 * s;
+    const float tw = bold->CalcTextSizeA(ts, FLT_MAX, 0, label).x;
+    const float icon_w = r * 4.9f, pad = 22 * s, gap = 16 * s;
+    const float right = size.x - 60 * s, bottom = size.y - 60 * s, height = 70 * s;
+    const float left = right - pad - tw - gap - icon_w - pad;
+    const auto alpha = [hint_alpha](int a) { return static_cast<int>(a * hint_alpha); };
+    dl->AddRectFilled(ImVec2(left, bottom - height), ImVec2(right, bottom),
+                      IM_COL32(8, 20, 46, alpha(215)), 16 * s);
+    dl->AddRect(ImVec2(left, bottom - height), ImVec2(right, bottom),
+                IM_COL32(120, 196, 255, alpha(90)), 16 * s, 0, 1.5f * s);
+    DrawGlyph(dl, Glyph::L3R3, ImVec2(left + pad + icon_w * 0.5f, bottom - height * 0.5f), r,
+              hint_alpha);
+    dl->AddText(bold, ts, ImVec2(left + pad + icon_w + gap, bottom - height * 0.5f - ts * 0.55f),
+                IM_COL32(255, 255, 255, alpha(255)), label);
+  }
+}
+
+// While the menu is open: if the drawing or the polling stops for 3 s, every thread's stack goes
+// to /data/DolphinPS4/menu-hang.txt (once).
+void Watchdog()
+{
+  unsigned last_draws = 0, last_polls = 0;
+  int stalled = 0;
+  bool dumped = false;
+  for (;;)
+  {
+    std::this_thread::sleep_for(std::chrono::milliseconds(500));
+    const unsigned draws = s_draws, polls = s_polls;
+    if (s_watch && !dumped && (draws == last_draws || polls == last_polls))
+    {
+      if (++stalled >= 6)
+      {
+        char reason[160];
+        snprintf(reason, sizeof(reason), "in-game menu stalled (%s%s), last action: %s",
+                 draws == last_draws ? "drawing " : "", polls == last_polls ? "polling" : "",
+                 s_last_action.load());
+        ps4_boot_trace(reason);
+        ps4_dump_thread_stacks("/data/DolphinPS4/menu-hang.txt", reason);
+        dumped = true;
+      }
+    }
+    else
+    {
+      stalled = 0;
+    }
+    last_draws = draws;
+    last_polls = polls;
+  }
+}
+}  // namespace
+
+void Install()
+{
+  ps4_overlay_draw = Draw;
+  std::thread(Watchdog).detach();
+}
+
+bool ReturnToXMB()
+{
+  return s_quit;
+}
+}  // namespace PS4IngameMenu
+
+// IOS ES (Core/IOS/ES/ES.cpp), any thread: a game chose "Wii Menu" in its HOME Menu.
+extern "C" void ps4_request_quit_to_menu()
+{
+  PS4IngameMenu::s_quit_requested = true;
+}
+
+namespace PS4IngameMenu
+{
+
+void Poll(Core::System& system)
+{
+  s_polls++;
+  if (s_saving_slot != 0 && ps4_state_busy == 0)
+  {
+    Toast("Saved to slot " + std::to_string(s_saving_slot));
+    Log("saved state " + std::to_string(s_saving_slot));
+    s_saving_slot = 0;
+  }
+  if (s_quit_requested.exchange(false) && !s_quit)
+    QuitToXMB(system, "the game asked for the Wii Menu: quit to the XMB");
+  if (s_quit)
+  {
+    // The clean stop normally ends the main loop quickly; don't wait forever on it.
+    if (Clock::now() - s_quit_time > std::chrono::seconds(6))
+    {
+      Log("stop took too long, restarting into the XMB");
+      sceSystemServiceLoadExec("/app0/eboot.bin", nullptr);
+    }
+    return;
+  }
+  if (ps4_pad_handle < 0)
+    return;
+  OrbisPadData data = {};
+  if (scePadReadState(ps4_pad_handle, &data) != 0 || !data.connected)
+    return;
+  const uint32_t held = data.buttons;
+  const uint32_t pressed = held & ~s_held;
+  s_held = held;
+  bool open;
+  {
+    std::lock_guard lock(s_mutex);
+    open = s_open;
+  }
+  // Releasing every button ends the post-menu input block.
+  if (ps4_pad_block && !open && held == 0)
+    ps4_pad_block = 0;
+
+  constexpr uint32_t COMBO = ORBIS_PAD_BUTTON_L3 | ORBIS_PAD_BUTTON_R3;
+  const bool combo = (held & COMBO) == COMBO && (pressed & COMBO);
+  if (!open)
+  {
+    if (combo && Core::GetState(system) == Core::State::Running)
+    {
+      s_last_action = "open";
+      Open(system);
+    }
+  }
+  else
+  {
+    // Directions repeat while held.
+    uint32_t nav = pressed;
+    constexpr uint32_t DIRS = ORBIS_PAD_BUTTON_UP | ORBIS_PAD_BUTTON_DOWN |
+                              ORBIS_PAD_BUTTON_LEFT | ORBIS_PAD_BUTTON_RIGHT;
+    if (held & DIRS)
+    {
+      if (pressed & DIRS)
+      {
+        s_repeat = 0.35f;
+      }
+      else
+      {
+        s_repeat -= 1.0f / 60.0f;
+        if (s_repeat <= 0.0f)
+        {
+          nav |= held & DIRS;
+          s_repeat = 0.08f;
+        }
+      }
+    }
+    bool rebuild = false;
+    if (nav & ORBIS_PAD_BUTTON_UP)
+    {
+      SelectableMove(-1);
+      rebuild = true;
+    }
+    if (nav & ORBIS_PAD_BUTTON_DOWN)
+    {
+      SelectableMove(1);
+      rebuild = true;
+    }
+    if (nav & (ORBIS_PAD_BUTTON_LEFT | ORBIS_PAD_BUTTON_RIGHT))
+    {
+      const int direction = (nav & ORBIS_PAD_BUTTON_LEFT) ? -1 : 1;
+      // Main page: Left/Right pick the slot, on Save State and Load State only.
+      if (s_page == Page::Main)
+      {
+        const int item = s_main_items[s_main_selected];
+        if (item == MAIN_SAVE || item == MAIN_LOAD)
+          s_slot = (s_slot - 1 + direction + 8) % 8 + 1;
+        else if (item == MAIN_WII_EXTENSION || item == MAIN_WII_SIDEWAYS)
+          ToggleWiiRemote(item);
+      }
+      else
+      {
+        ChangeSetting(s_settings_selected, direction);
+      }
+      s_last_action = "change";
+      rebuild = true;
+    }
+    if (pressed & ORBIS_PAD_BUTTON_CROSS)
+    {
+      s_last_action = "activate";
+      Log("activate " +
+          std::to_string(s_page == Page::Main ? s_main_selected : s_settings_selected));
+      Activate(system);
+      rebuild = true;
+    }
+    else if (combo)
+    {
+      Close(system);
+    }
+    else if (pressed & ORBIS_PAD_BUTTON_CIRCLE)
+    {
+      if (s_page != Page::Main)
+      {
+        s_page = Page::Main;
+        rebuild = true;
+      }
+      else
+      {
+        Close(system);
+      }
+    }
+    if (rebuild && !s_quit)
+      BuildRows();
+  }
+
+  // While the menu is open (or a toast is showing) the paused frame is redrawn with it.
+  bool redraw;
+  {
+    std::lock_guard lock(s_mutex);
+    redraw = s_open || s_appear > 0.01f || Clock::now() < s_toast_until;
+  }
+  if (redraw)
+  {
+    ps4_overlay_repaint = 1;
+    system.GetFifo().PS4WakeGpu();
+  }
+}
+}  // namespace PS4IngameMenu
