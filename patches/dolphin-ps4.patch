+#if defined(__ORBIS__) || defined(DOLPHIN_PS4_HOST)
+// Soft TLB (PS4 port). An entry maps one 4 KiB guest page to its host RAM page. It is filled only
+// by a successful translated guest read (read table) or write (write table) of plain RAM, so the
+// R and C bits in the page table are already set exactly as the full path would set them. The tag
+// holds the translation mode (MSR.DR) and the entry the segment register it was translated with,
+// so mode and segment changes need no flush; tlbie, BAT, SDR1, segment-register and page table
+// updates, resets and state loads flush everything. Memory checks, the data cache emulation and
+// write-through/cache-inhibited pages always take the full path.
+static inline u32 SoftTlbTag(const PowerPC::PowerPCState& ppc_state, u32 address)
+{
+  return (address >> HW_PAGE_INDEX_SHIFT) | (ppc_state.msr.DR ? 0x100000u : 0u) | 0x200000u;
+}
+
+// ps4.ini soft_tlb=flush: every tlbie and page table update empties the whole soft TLB (the old
+// behaviour). Default: a tlbie removes only that page's entries.
+extern "C" int ps4_soft_tlb_precise;
+int ps4_soft_tlb_precise = 1;
+
+// Lookups that hit / fell back to the full path (DolphinNoGUI monitor). Lookups the JIT does
+// inline (Jit64Common/EmuCodeBlock.cpp) aren't counted: with it, every C lookup is a miss.
+extern "C" unsigned long long ps4_soft_tlb_hits, ps4_soft_tlb_misses;
+unsigned long long ps4_soft_tlb_hits = 0, ps4_soft_tlb_misses = 0;
+// Why entries go (monitor): whole-table flushes (all reasons), segment register writes among
+// them, single-page invalidations (tlbie), and fills.
+extern "C" unsigned long long ps4_soft_tlb_flushes, ps4_soft_tlb_sr_flushes, ps4_soft_tlb_page_inv,
+    ps4_soft_tlb_fills;
+unsigned long long ps4_soft_tlb_flushes = 0, ps4_soft_tlb_sr_flushes = 0, ps4_soft_tlb_page_inv = 0,
+                   ps4_soft_tlb_fills = 0;
+
+u8* MMU::PS4RamByte(u32 physical)
+{
+  if ((physical & 0xF8000000) == 0 && m_memory.GetRAM())
+    return &m_memory.GetRAM()[physical & m_memory.GetRamMask()];
+  if ((physical >> 28) == 0x1 && m_memory.GetEXRAM() &&
+      (physical & 0x0FFFFFFF) < m_memory.GetExRamSizeReal())
+    return &m_memory.GetEXRAM()[physical & 0x0FFFFFFF];
+  return nullptr;
+}
+
+u8* MMU::SoftTlbLookup(bool write, u32 address, u32 size)
+{
+  ps4_soft_tlb_misses++;  // undone on a hit
+  if ((address & HW_PAGE_MASK) + size > HW_PAGE_SIZE)
+    return nullptr;
+  const SoftTlbEntry& e =
+      (write ? m_soft_tlb_write : m_soft_tlb_read)[(address >> HW_PAGE_INDEX_SHIFT) &
+                                                   (SOFT_TLB_SIZE - 1)];
+  if (e.tag != SoftTlbTag(m_ppc_state, address))
+    return nullptr;
+  if (m_ppc_state.msr.DR && e.sr != m_ppc_state.sr[address >> 28])
+    return nullptr;
+  if (m_ppc_state.m_enable_dcache || m_power_pc.GetMemChecks().HasAny())
+    return nullptr;
+  ps4_soft_tlb_misses--;
+  ps4_soft_tlb_hits++;
+  return e.host + (address & HW_PAGE_MASK);
+}
+
+void MMU::SoftTlbFill(bool write, u32 logical_address, u8* host_page)
+{
+  SoftTlbEntry& e =
