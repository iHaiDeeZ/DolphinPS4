+// " (installed package v03.08)" when a downloaded update runs (the PS4 shows the package's version).
+std::string Menu::InstalledPackageNote() const
+{
+  std::ifstream file("/app0/xmb/version.txt");
+  std::string installed;
+  std::getline(file, installed);
+  while (!installed.empty() && (installed.back() == '\r' || installed.back() == ' '))
+    installed.pop_back();
+  return installed.empty() || installed == m_version ? "" : " (installed package " + installed + ")";
+}
