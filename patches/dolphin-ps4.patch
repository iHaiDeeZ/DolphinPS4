+// A badge's texture, made from its copied pixels the first time it is drawn (s_mutex held).
+AbstractTexture* BadgeTexture(const std::string& key)
+{
+  if (key.empty() || !g_gfx)
+    return nullptr;
+  const auto made = s_badge_textures.find(key);
+  if (made != s_badge_textures.end())
+    return made->second.get();
+  const auto pixels = s_badge_pixels.find(key);
+  if (pixels == s_badge_pixels.end())
+    return nullptr;
+  const BadgePixels& p = pixels->second;
+  TextureConfig config(p.width, p.height, 1, 1, 1, AbstractTextureFormat::RGBA8, 0,
+                       AbstractTextureType::Texture_2DArray);
+  std::unique_ptr<AbstractTexture> texture = g_gfx->CreateTexture(config);
+  if (texture)
+    texture->Load(0, p.width, p.height, p.width, p.rgba.data(), p.rgba.size());
+  AbstractTexture* result = texture.get();
+  s_badge_textures[key] = std::move(texture);
+  return result;
+}
+
+// A trophy cup (the achievement's points: bronze, silver, gold, platinum).
+void DrawTrophy(ImDrawList* dl, ImVec2 c, float s, ImU32 color)
+{
+  const float r = s * 0.5f;
+  const float w = r * 0.56f, top = c.y - r * 0.78f, mid = c.y - r * 0.3f;
+  dl->PathArcTo(ImVec2(c.x, mid), w, 0.0f, 3.14159265f, 20);
+  dl->PathLineTo(ImVec2(c.x - w, top));
+  dl->PathLineTo(ImVec2(c.x + w, top));
+  dl->PathFillConvex(color);
+  dl->AddCircle(ImVec2(c.x - w, c.y - r * 0.5f), r * 0.24f, color, 16, r * 0.1f);
+  dl->AddCircle(ImVec2(c.x + w, c.y - r * 0.5f), r * 0.24f, color, 16, r * 0.1f);
+  dl->AddRectFilled(ImVec2(c.x - r * 0.09f, c.y + r * 0.2f), ImVec2(c.x + r * 0.09f, c.y + r * 0.6f),
+                    color);
+  dl->AddRectFilled(ImVec2(c.x - r * 0.42f, c.y + r * 0.58f), ImVec2(c.x + r * 0.42f, c.y + r * 0.82f),
+                    color, r * 0.08f);
+}
+
+// The text cut to a width, with "...".
+std::string Ellipsize(ImFont* font, float size, const std::string& text, float width)
+{
+  if (font->CalcTextSizeA(size, FLT_MAX, 0, text.c_str()).x <= width)
+    return text;
+  std::string cut = text;
+  while (!cut.empty() && font->CalcTextSizeA(size, FLT_MAX, 0, (cut + "...").c_str()).x > width)
+  {
+    cut.pop_back();
+    while (!cut.empty() && (static_cast<unsigned char>(cut.back()) & 0xC0) == 0x80)
+      cut.pop_back();  // a whole UTF-8 character
+  }
+  return cut + "...";
+}
+
+// An achievement as on the PS3's trophy list: badge, name, description, status, type, trophy.
+void DrawAchievementRow(ImDrawList* dl, const Row& row, float x0, float y, float panel_w, float s,
+                        float a, bool sel, ImFont* bold, ImFont* regular)
+{
+  const int alpha = static_cast<int>(255 * a);
+  const float b = 84 * s;
+  float tx = x0 + 60 * s;
+  if (AbstractTexture* badge = BadgeTexture(row.badge))
+  {
+    dl->AddImageRounded(ImTextureRef(*badge), ImVec2(tx, y + 6 * s), ImVec2(tx + b, y + 6 * s + b),
+                        ImVec2(0, 0), ImVec2(1, 1),
+                        IM_COL32(255, 255, 255, row.locked ? alpha * 3 / 4 : alpha), 8 * s);
+  }
+  else
+  {
+    dl->AddRectFilled(ImVec2(tx, y + 6 * s), ImVec2(tx + b, y + 6 * s + b),
+                      IM_COL32(40, 50, 70, alpha), 8 * s);
+  }
+  tx += b + 20 * s;
+  const float right = x0 + panel_w - 130 * s;
+  const float width = right - tx;
+  const ImU32 white = IM_COL32(255, 255, 255, row.locked ? alpha * 7 / 10 : alpha);
+  const ImU32 dim = IM_COL32(255, 255, 255, static_cast<int>(150 * a));
+  dl->AddText(bold, (sel ? 31 : 29) * s, ImVec2(tx, y + 6 * s), white,
+              Ellipsize(bold, (sel ? 31 : 29) * s, row.label, width).c_str());
+  dl->AddText(regular, 22 * s, ImVec2(tx, y + 42 * s), dim,
+              Ellipsize(regular, 22 * s, row.sub, width).c_str());
+  // Status, then the type and rarity tags.
+  const ImU32 gold = IM_COL32(255, 200, 70, alpha);
+  float sx = tx;
+  const float ss = 21 * s, sy = y + 70 * s;
+  dl->AddText(regular, ss, ImVec2(sx, sy), row.locked ? dim : gold, row.status.c_str());
+  sx += regular->CalcTextSizeA(ss, FLT_MAX, 0, row.status.c_str()).x + 16 * s;
+  const char* type = PS4Achievements::TypeName(row.ach_type);
+  if (*type)
+  {
+    const ImU32 fill = row.ach_type == 1 ? IM_COL32(200, 60, 70, static_cast<int>(220 * a)) :
+                       row.ach_type == 3 ? IM_COL32(200, 150, 30, static_cast<int>(220 * a)) :
+                                           IM_COL32(50, 120, 220, static_cast<int>(220 * a));
+    const float tw = bold->CalcTextSizeA(18 * s, FLT_MAX, 0, type).x;
+    dl->AddRectFilled(ImVec2(sx, sy), ImVec2(sx + tw + 18 * s, sy + 24 * s), fill, 12 * s);
+    dl->AddText(bold, 18 * s, ImVec2(sx + 9 * s, sy + 3 * s), IM_COL32(255, 255, 255, alpha), type);
+    sx += tw + 30 * s;
+  }
+  if (row.rarity >= 0.0f && sx < right - 60 * s)
+  {
+    char rarity[32];
+    snprintf(rarity, sizeof(rarity), "%.1f%%", row.rarity);
+    dl->AddText(regular, ss, ImVec2(sx, sy), dim, rarity);
+  }
+  // The trophy and the points.
+  static const ImU32 TIERS[] = {IM_COL32(205, 127, 50, 255), IM_COL32(205, 127, 50, 255),
+                                IM_COL32(200, 205, 215, 255), IM_COL32(255, 200, 70, 255),
+                                IM_COL32(170, 215, 255, 255)};
+  ImU32 tier = TIERS[std::clamp(row.tier, 0, 4)];
+  const int tier_alpha = row.locked ? static_cast<int>(90 * a) : alpha;
+  tier = (tier & 0x00FFFFFF) | (static_cast<ImU32>(tier_alpha) << 24);
+  const float cx = x0 + panel_w - 85 * s;
+  DrawTrophy(dl, ImVec2(cx, y + 34 * s), 46 * s, tier);
+  const float pw = regular->CalcTextSizeA(22 * s, FLT_MAX, 0, row.value.c_str()).x;
+  dl->AddText(regular, 22 * s, ImVec2(cx - pw * 0.5f, y + 66 * s), row.locked ? dim : white,
+              row.value.c_str());
+}
+
+float Smooth(float x)
+{
+  x = std::clamp(x, 0.0f, 1.0f);
+  return x * x * (3.0f - 2.0f * x);
+}
+
+// The Xbox-style banner at the bottom centre: the circle pops in, the bar opens to the right of
+// it, the text fades in; 6 s later it closes the same way.
+bool DrawBanner(ImDrawList* dl, ImFont* bold, ImFont* regular, float s, Clock::time_point now)
+{
+  if (s_banners.empty())
+    return false;
+  if (!s_banner_showing)
+  {
+    s_banner_showing = true;
+    s_banner_start = now;
+  }
+  constexpr float SHOW = 6.0f;
+  const float t = std::chrono::duration<float>(now - s_banner_start).count();
+  if (t > SHOW)
+  {
+    s_banners.erase(s_banners.begin());
+    s_banner_showing = false;
+    return !s_banners.empty();
+  }
+  const Banner& banner = s_banners.front();
+  {
+    static const Banner* s_logged = nullptr;
+    if (s_logged != &banner)
+    {
+      s_logged = &banner;
+      Log("achievements: banner drawn");
+    }
+  }
+  const ImVec2 size = ImGui::GetIO().DisplaySize;
+  const float circle = std::min(Smooth(t / 0.3f), Smooth((SHOW - t) / 0.3f));
+  const float open = std::min(Smooth((t - 0.25f) / 0.45f), Smooth((SHOW - 0.3f - t) / 0.45f));
+  const float text_a = std::min(Smooth((t - 0.55f) / 0.3f), Smooth((SHOW - 0.55f - t) / 0.25f));
+  const float h = 104 * s;
+  const float title_w = bold->CalcTextSizeA(32 * s, FLT_MAX, 0, banner.title.c_str()).x;
+  const float line_w = regular->CalcTextSizeA(24 * s, FLT_MAX, 0, banner.line.c_str()).x;
+  const float full = std::min(size.x - 200 * s,
+                              std::max(520 * s, h + 30 * s + std::max(title_w, line_w) + 48 * s));
+  const float w = h + (full - h) * open;
+  const float x = size.x * 0.5f - full * 0.5f, y = size.y - 140 * s - h;
+  // The bar (it opens from behind the circle).
+  if (open > 0.0f)
+  {
+    dl->AddRectFilled(ImVec2(x, y), ImVec2(x + w, y + h),
+                      IM_COL32(28, 30, 34, static_cast<int>(238 * std::max(open, 0.2f))), h * 0.5f);
+    dl->PushClipRect(ImVec2(x + h * 0.5f, y), ImVec2(x + w - 10 * s, y + h), true);
+    const int ta = static_cast<int>(255 * text_a);
+    const float tx = x + h + 26 * s;
+    dl->AddText(bold, 32 * s, ImVec2(tx, y + 16 * s), IM_COL32(255, 255, 255, ta),
+                Ellipsize(bold, 32 * s, banner.title, full - h - 70 * s).c_str());
+    dl->AddText(regular, 24 * s, ImVec2(tx, y + 56 * s), IM_COL32(200, 205, 215, ta),
+                Ellipsize(regular, 24 * s, banner.line, full - h - 70 * s).c_str());
+    if (banner.progress >= 0.0f)
+    {
+      const float bx0 = tx, bx1 = x + full - 46 * s, by = y + h - 16 * s;
+      dl->AddRectFilled(ImVec2(bx0, by), ImVec2(bx1, by + 5 * s),
+                        IM_COL32(255, 255, 255, static_cast<int>(50 * text_a)), 3 * s);
+      if (banner.progress > 0.0f)
+      {
+        dl->AddRectFilled(ImVec2(bx0, by),
+                          ImVec2(bx0 + (bx1 - bx0) * std::min(banner.progress, 1.0f), by + 5 * s),
+                          IM_COL32(16, 190, 90, ta), 3 * s);
+      }
+    }
+    dl->PopClipRect();
+  }
+  // The circle: the game's badge, or a trophy.
+  const ImVec2 c(x + h * 0.5f, y + h * 0.5f);
+  const float r = h * 0.5f * (0.6f + 0.4f * circle);
+  const int ca = static_cast<int>(255 * circle);
+  dl->AddCircleFilled(c, r, IM_COL32(16, 124, 16, ca), 48);
+  if (AbstractTexture* badge = BadgeTexture(banner.badge))
+  {
+    const float b = r - 7 * s;
+    dl->AddImageRounded(ImTextureRef(*badge), ImVec2(c.x - b, c.y - b), ImVec2(c.x + b, c.y + b),
+                        ImVec2(0, 0), ImVec2(1, 1), IM_COL32(255, 255, 255, ca), b);
+  }
+  else
+  {
+    DrawTrophy(dl, c, r * 1.1f, IM_COL32(255, 255, 255, ca));
+  }
+  return true;
+}
+
+// The unlock pop-up: slides in at the top right, stays 5 s, slides out; the next one follows.
+bool DrawPopup(ImDrawList* dl, ImFont* bold, ImFont* regular, float s, Clock::time_point now)
+{
+  if (s_popups.empty())
+    return false;
+  if (!s_popup_showing)
+  {
+    s_popup_showing = true;
+    s_popup_start = now;
+  }
+  const float t = std::chrono::duration<float>(now - s_popup_start).count();
+  constexpr float SHOW = 5.5f;
+  if (t > SHOW)
+  {
+    s_popups.erase(s_popups.begin());
+    s_popup_showing = false;
+    return !s_popups.empty();
+  }
+  const Popup& popup = s_popups.front();
+  const float in = std::clamp(t / 0.35f, 0.0f, 1.0f), out = std::clamp((SHOW - t) / 0.35f, 0.0f, 1.0f);
+  const float k = std::min(in, out);
+  const float ease = 1.0f - (1.0f - k) * (1.0f - k) * (1.0f - k);
+  const ImVec2 size = ImGui::GetIO().DisplaySize;
+  const float w = 640 * s, h = 128 * s;
+  const float x = size.x - 50 * s - w + (1.0f - ease) * (w + 80 * s), y = 50 * s;
+  const int a = static_cast<int>(255 * k);
+  const ImU32 gold = IM_COL32(255, 200, 70, a);
+  dl->AddRectFilled(ImVec2(x, y), ImVec2(x + w, y + h), IM_COL32(8, 20, 46, static_cast<int>(235 * k)),
+                    18 * s);
+  dl->AddRect(ImVec2(x, y), ImVec2(x + w, y + h),
+              popup.hardcore ? gold : IM_COL32(91, 184, 255, a), 18 * s, 0, 2.5f * s);
+  float tx = x + 28 * s;
+  if (AbstractTexture* badge = BadgeTexture(popup.badge))
+  {
+    const float b = 88 * s;
+    dl->AddImageRounded(ImTextureRef(*badge), ImVec2(x + 20 * s, y + 20 * s),
+                        ImVec2(x + 20 * s + b, y + 20 * s + b), ImVec2(0, 0), ImVec2(1, 1),
+                        IM_COL32(255, 255, 255, a), 10 * s);
+    tx = x + 20 * s + b + 22 * s;
+  }
+  const float tw = w - (tx - x) - 24 * s;
+  dl->AddText(regular, 24 * s, ImVec2(tx, y + 18 * s), gold,
+              (std::string(PS4Lang::T("Achievement Unlocked")) + "  -  " +
+               std::to_string(popup.points) + " " + PS4Lang::T("points"))
+                  .c_str());
+  dl->AddText(bold, 32 * s, ImVec2(tx, y + 46 * s), IM_COL32(255, 255, 255, a),
+              FitText(popup.title, 34).c_str(), nullptr, tw);
+  dl->AddText(regular, 22 * s, ImVec2(tx, y + 88 * s), IM_COL32(255, 255, 255, static_cast<int>(170 * k)),
+              FitText(popup.description, 52).c_str());
+  return true;
+}
+
+void DrawGlyph(ImDrawList* dl, Glyph glyph, ImVec2 c, float r, float a)
+{
+  const ImU32 ring = IM_COL32(255, 255, 255, static_cast<int>(60 * a));
+  auto colour = [a](int rr, int g, int b) {
+    return IM_COL32(rr, g, b, static_cast<int>(255 * a));
+  };
+  switch (glyph)
+  {
+  case Glyph::Cross:
+    dl->AddCircleFilled(c, r, ring, 28);
+    dl->AddLine(ImVec2(c.x - r * 0.45f, c.y - r * 0.45f), ImVec2(c.x + r * 0.45f, c.y + r * 0.45f),
+                colour(120, 170, 255), r * 0.22f);
+    dl->AddLine(ImVec2(c.x - r * 0.45f, c.y + r * 0.45f), ImVec2(c.x + r * 0.45f, c.y - r * 0.45f),
+                colour(120, 170, 255), r * 0.22f);
+    break;
+  case Glyph::Circle:
+    dl->AddCircleFilled(c, r, ring, 28);
+    dl->AddCircle(c, r * 0.48f, colour(255, 100, 110), 24, r * 0.2f);
+    break;
+  case Glyph::LeftRight:
+  case Glyph::UpDown:
+  {
+    // A D-pad with the two arrows in use lit.
+    const float s = r * 0.42f;
+    const ImU32 dim = IM_COL32(255, 255, 255, static_cast<int>(70 * a));
+    const ImU32 lit = colour(255, 255, 255);
+    const bool lr = glyph == Glyph::LeftRight;
+    dl->AddRectFilled(ImVec2(c.x - s * 0.5f, c.y - r), ImVec2(c.x + s * 0.5f, c.y - s * 0.5f),
+                      lr ? dim : lit, 2.0f);
+    dl->AddRectFilled(ImVec2(c.x - s * 0.5f, c.y + s * 0.5f), ImVec2(c.x + s * 0.5f, c.y + r),
+                      lr ? dim : lit, 2.0f);
+    dl->AddRectFilled(ImVec2(c.x - r, c.y - s * 0.5f), ImVec2(c.x - s * 0.5f, c.y + s * 0.5f),
+                      lr ? lit : dim, 2.0f);
+    dl->AddRectFilled(ImVec2(c.x + s * 0.5f, c.y - s * 0.5f), ImVec2(c.x + r, c.y + s * 0.5f),
+                      lr ? lit : dim, 2.0f);
+    break;
+  }
+  case Glyph::L3R3:
+  {
+    // Two round buttons, "L3" and "R3" written in them, with a "+" between.
+    ImFont* font = ps4_overlay_font ? ps4_overlay_font : ImGui::GetFont();
+    const float button_r = r * 0.95f, offset = r * 1.45f;
+    for (int i = 0; i < 2; i++)
+    {
+      const ImVec2 p(c.x + (i == 0 ? -offset : offset), c.y);
+      dl->AddCircleFilled(p, button_r, IM_COL32(20, 24, 34, static_cast<int>(230 * a)), 28);
+      dl->AddCircle(p, button_r, colour(255, 255, 255), 28, r * 0.1f);
+      const char* label = i == 0 ? "L3" : "R3";
+      const float fs = r * 0.95f;
+      const ImVec2 ts = font->CalcTextSizeA(fs, FLT_MAX, 0, label);
+      dl->AddText(font, fs, ImVec2(p.x - ts.x * 0.5f, p.y - ts.y * 0.5f), colour(255, 255, 255),
+                  label);
+    }
+    const float plus = r * 0.22f;
+    dl->AddLine(ImVec2(c.x - plus, c.y), ImVec2(c.x + plus, c.y), colour(255, 255, 255),
+                r * 0.1f);
+    dl->AddLine(ImVec2(c.x, c.y - plus), ImVec2(c.x, c.y + plus), colour(255, 255, 255),
+                r * 0.1f);
+    break;
+  }
+  }
+}
+
+void Draw()
+{
+  s_draws++;
+  std::lock_guard lock(s_mutex);
+  const auto now = Clock::now();
+  const float dt =
+      std::clamp(std::chrono::duration<float>(now - s_last_draw).count(), 0.0f, 0.1f);
+  s_last_draw = now;
+  s_appear += ((s_open ? 1.0f : 0.0f) - s_appear) * (1.0f - std::exp(-14.0f * dt));
+  const bool toast = now < s_toast_until;
+  if (!s_hint_started)
+  {
+    s_hint_started = true;
+    s_hint_start = now;
+  }
+  // Shown from 3 s to 10 s after the game's first frame, fading in and out.
+  const float hint_time = std::chrono::duration<float>(now - s_hint_start).count();
+  const float hint_alpha =
+      hint_time < 3.0f || hint_time > 10.0f ?
+          0.0f :
+          std::min({1.0f, (hint_time - 3.0f) / 0.4f, (10.0f - hint_time) / 0.6f});
+  if (s_appear < 0.01f && !toast && hint_alpha <= 0.0f && s_popups.empty() &&
+      s_banners.empty())
+    return;
+
+  ImDrawList* dl = ImGui::GetForegroundDrawList();
+  const ImVec2 size = ImGui::GetIO().DisplaySize;
+  ImFont* bold = ps4_overlay_font ? ps4_overlay_font : ImGui::GetFont();
+  ImFont* regular = ps4_overlay_font_regular ? ps4_overlay_font_regular : bold;
+  const float s = size.y / 1080.0f;  // layout in 1080p units
+  if (DrawPopup(dl, bold, regular, s, now))
+    ps4_overlay_repaint = 1;  // keep animating while paused
+  if (s_appear < 0.5f && DrawBanner(dl, bold, regular, s, now))
+    ps4_overlay_repaint = 1;
+  const float a = s_appear;
+
+  if (a > 0.01f)
+  {
+    dl->AddRectFilled(ImVec2(0, 0), size, IM_COL32(0, 0, 0, static_cast<int>(150 * a)));
+    const float panel_w = 860.0f * s;
+    const float x0 = -panel_w * (1.0f - a);
+    dl->AddRectFilledMultiColor(ImVec2(x0, 0), ImVec2(x0 + panel_w, size.y),
+                                IM_COL32(8, 20, 46, static_cast<int>(240 * a)),
+                                IM_COL32(8, 20, 46, static_cast<int>(150 * a)),
+                                IM_COL32(2, 6, 16, static_cast<int>(150 * a)),
+                                IM_COL32(2, 6, 16, static_cast<int>(240 * a)));
+    dl->AddLine(ImVec2(x0 + panel_w, 0), ImVec2(x0 + panel_w, size.y),
+                IM_COL32(91, 184, 255, static_cast<int>(200 * a)), 2.0f * s);
+    const ImU32 white = IM_COL32(255, 255, 255, static_cast<int>(255 * a));
+    const ImU32 dim = IM_COL32(255, 255, 255, static_cast<int>(165 * a));
+    const ImU32 accent = IM_COL32(120, 196, 255, static_cast<int>(255 * a));
+    dl->AddText(regular, 26 * s, ImVec2(x0 + 70 * s, 90 * s), accent, PS4Lang::T(s_subtitle).c_str());
+    dl->AddText(bold, 40 * s, ImVec2(x0 + 70 * s, 122 * s), white, s_title.c_str(), nullptr,
+                panel_w - 120 * s);
+    if (s_bar >= 0.0f)
+    {
+      // Achievements: how far along, as on the PS3's trophy list.
+      dl->AddText(regular, 22 * s, ImVec2(x0 + 70 * s, 168 * s),
+                  IM_COL32(255, 200, 70, static_cast<int>(255 * a)), s_bar_text.c_str());
+      const float bx0 = x0 + 70 * s, bx1 = x0 + panel_w - 70 * s, by = 200 * s;
+      dl->AddRectFilled(ImVec2(bx0, by), ImVec2(bx1, by + 10 * s),
+                        IM_COL32(255, 255, 255, static_cast<int>(40 * a)), 5 * s);
+      if (s_bar > 0.0f)
+      {
+        dl->AddRectFilled(ImVec2(bx0, by), ImVec2(bx0 + (bx1 - bx0) * std::min(s_bar, 1.0f), by + 10 * s),
+                          IM_COL32(255, 200, 70, static_cast<int>(255 * a)), 5 * s);
+      }
+    }
+    else if (!s_playtime.empty())
+    {
+      dl->AddText(regular, 24 * s, ImVec2(x0 + 70 * s, 172 * s), dim,
+                  PS4Lang::T(s_playtime).c_str());
+    }
+
+    // The list scrolls to keep the selection in view.
+    const float row_h = (s_tall ? 108.0f : 62.0f) * s;
+    const float top = (s_tall ? 232.0f : 220.0f) * s,
+                bottom = size.y - (s_detail.empty() ? 160.0f : 280.0f) * s;
+    const float visible = (bottom - top) / row_h;
+    const float target = std::clamp(static_cast<float>(s_selected) - visible * 0.5f + 1.0f, 0.0f,
+                                    std::max(0.0f, static_cast<float>(s_rows.size()) - visible));
+    s_scroll += (target - s_scroll) * (1.0f - std::exp(-16.0f * dt));
+    dl->PushClipRect(ImVec2(x0, top - 10 * s), ImVec2(x0 + panel_w, bottom + 10 * s), true);
+    for (size_t i = 0; i < s_rows.size(); i++)
+    {
+      const Row& row = s_rows[i];
+      const float y = top + (static_cast<float>(i) - s_scroll) * row_h;
+      if (y < top - row_h || y > bottom)
+        continue;
+      if (row.header && s_tall)
+      {
+        // The Achievements page's message (not logged in, not supported, ...).
+        dl->AddText(regular, 28 * s, ImVec2(x0 + 70 * s, y + 10 * s), dim,
+                    PS4Lang::T(row.label).c_str(), nullptr, panel_w - 140 * s);
+        continue;
+      }
+      if (s_tall)
+      {
+        const bool sel_row = static_cast<int>(i) == s_selected;
+        if (sel_row)
+        {
+          dl->AddRectFilled(ImVec2(x0 + 40 * s, y - 2 * s), ImVec2(x0 + panel_w - 40 * s, y + 100 * s),
+                            IM_COL32(91, 184, 255, static_cast<int>(70 * a)), 12 * s);
+        }
+        DrawAchievementRow(dl, row, x0, y, panel_w, s, a, sel_row, bold, regular);
+        continue;
+      }
+      if (row.header)
+      {
+        dl->AddText(bold, 26 * s, ImVec2(x0 + 70 * s, y + 16 * s), accent, PS4Lang::T(row.label).c_str());
+        dl->AddLine(ImVec2(x0 + 70 * s, y + 52 * s), ImVec2(x0 + panel_w - 60 * s, y + 52 * s),
+                    IM_COL32(120, 196, 255, static_cast<int>(70 * a)), 1.5f * s);
+        continue;
+      }
+      const bool sel = static_cast<int>(i) == s_selected;
+      if (sel)
+      {
+        dl->AddRectFilled(ImVec2(x0 + 40 * s, y - 4 * s),
+                          ImVec2(x0 + panel_w - 40 * s, y + 54 * s),
+                          IM_COL32(91, 184, 255, static_cast<int>(70 * a)), 12 * s);
+      }
+      float label_x = x0 + 70 * s;
+      if (AbstractTexture* badge = BadgeTexture(row.badge))
+      {
+        dl->AddImageRounded(ImTextureRef(*badge), ImVec2(label_x, y + 2 * s),
+                            ImVec2(label_x + 46 * s, y + 48 * s), ImVec2(0, 0), ImVec2(1, 1),
+                            IM_COL32(255, 255, 255, static_cast<int>(255 * a)), 6 * s);
+        label_x += 60 * s;
+      }
+      dl->AddText(sel ? bold : regular, (sel ? 36 : 32) * s, ImVec2(label_x, y + 4 * s),
+                  sel ? white : dim, PS4Lang::T(row.label).c_str());
+      if (row.tag != 0)
+      {
+        // Cheats: a green ON or red OFF tag.
+        const char* label = row.tag > 0 ? "ON" : "OFF";
+        const float ts = 24 * s;
+        const float tw = bold->CalcTextSizeA(ts, FLT_MAX, 0, PS4Lang::T(label)).x;
+        const float right = x0 + panel_w - 80 * s, w = tw + 30 * s;
+        const ImU32 fill = row.tag > 0 ? IM_COL32(40, 170, 90, static_cast<int>(230 * a)) :
+                                         IM_COL32(210, 55, 70, static_cast<int>(230 * a));
+        dl->AddRectFilled(ImVec2(right - w, y + 8 * s), ImVec2(right, y + 44 * s), fill, 18 * s);
+        dl->AddText(bold, ts, ImVec2(right - w + 15 * s, y + 13 * s), white, PS4Lang::T(label));
+      }
+      else if (!row.value.empty())
+      {
+        const float vs = 30 * s;
+        const float tw = regular->CalcTextSizeA(vs, FLT_MAX, 0, PS4Lang::T(row.value).c_str()).x;
+        const ImU32 colour =
+            row.note ? IM_COL32(255, 210, 120, static_cast<int>((sel ? 255 : 170) * a)) :
+            sel      ? white :
+                       dim;
+        dl->AddText(regular, vs, ImVec2(x0 + panel_w - 80 * s - tw, y + 7 * s), colour,
+                    PS4Lang::T(row.value).c_str());
+      }
+    }
+    dl->PopClipRect();
+    if (!s_detail.empty())
+    {
+      dl->AddText(regular, 26 * s, ImVec2(x0 + 70 * s, bottom + 26 * s), dim, s_detail.c_str(),
+                  nullptr, panel_w - 140 * s);
+    }
+
+    // Button hints with icons.
+    float hx = x0 + 70 * s;
+    const float hy = size.y - 90 * s;
+    for (const auto& [glyph, text] : s_hints)
+    {
+      const float r = 18 * s;
+      const float w = glyph == Glyph::L3R3 ? r * 2.4f : r;
+      DrawGlyph(dl, glyph, ImVec2(hx + w, hy), r, a);
+      hx += w * 2 + 14 * s;
+      dl->AddText(regular, 28 * s, ImVec2(hx, hy - 17 * s), dim, PS4Lang::T(text).c_str());
+      hx += regular->CalcTextSizeA(28 * s, FLT_MAX, 0, PS4Lang::T(text).c_str()).x + 40 * s;
+    }
+  }
+  if (toast)
+  {
+    const float tw = bold->CalcTextSizeA(32 * s, FLT_MAX, 0, PS4Lang::T(s_toast).c_str()).x;
+    const ImVec2 p(size.x - tw - 120 * s, size.y - 150 * s);
+    dl->AddRectFilled(ImVec2(p.x - 30 * s, p.y - 18 * s), ImVec2(p.x + tw + 30 * s, p.y + 56 * s),
+                      IM_COL32(8, 20, 46, 225), 14 * s);
+    dl->AddText(bold, 32 * s, p, IM_COL32(255, 255, 255, 255), PS4Lang::T(s_toast).c_str());
+  }
+  if (hint_alpha > 0.0f && s_appear < 0.5f && !toast)
+  {
+    // "L3 + R3 for the menu", with the two stick icons, in the bottom-right corner.
+    const char* label = "Menu";
+    const float ts = 30 * s, r = 20 * s;
+    const float tw = bold->CalcTextSizeA(ts, FLT_MAX, 0, PS4Lang::T(label)).x;
+    const float icon_w = r * 4.9f, pad = 22 * s, gap = 16 * s;
+    const float right = size.x - 60 * s, bottom = size.y - 60 * s, height = 70 * s;
+    const float left = right - pad - tw - gap - icon_w - pad;
+    const auto alpha = [hint_alpha](int a) { return static_cast<int>(a * hint_alpha); };
+    dl->AddRectFilled(ImVec2(left, bottom - height), ImVec2(right, bottom),
+                      IM_COL32(8, 20, 46, alpha(215)), 16 * s);
+    dl->AddRect(ImVec2(left, bottom - height), ImVec2(right, bottom),
+                IM_COL32(120, 196, 255, alpha(90)), 16 * s, 0, 1.5f * s);
+    DrawGlyph(dl, Glyph::L3R3, ImVec2(left + pad + icon_w * 0.5f, bottom - height * 0.5f), r,
+              hint_alpha);
+    dl->AddText(bold, ts, ImVec2(left + pad + icon_w + gap, bottom - height * 0.5f - ts * 0.55f),
+                IM_COL32(255, 255, 255, alpha(255)), PS4Lang::T(label));
+  }
+}
+
+// While the menu is open: if the drawing or the polling stops for 3 s, every thread's stack goes
+// to /data/DolphinPS4/menu-hang.txt (once).
+void Watchdog()
+{
+  unsigned last_draws = 0, last_polls = 0;
+  int stalled = 0;
+  bool dumped = false;
+  for (;;)
+  {
+    std::this_thread::sleep_for(std::chrono::milliseconds(500));
+    const unsigned draws = s_draws, polls = s_polls;
+    if (s_watch && !dumped && (draws == last_draws || polls == last_polls))
+    {
+      if (++stalled >= 6)
+      {
+        char reason[160];
+        snprintf(reason, sizeof(reason), "in-game menu stalled (%s%s), last action: %s",
+                 draws == last_draws ? "drawing " : "", polls == last_polls ? "polling" : "",
+                 s_last_action.load());
+        ps4_boot_trace(reason);
+        ps4_dump_thread_stacks("/data/DolphinPS4/menu-hang.txt", reason);
+        dumped = true;
+      }
+    }
+    else
+    {
+      stalled = 0;
+    }
+    last_draws = draws;
+    last_polls = polls;
+  }
+}
+}  // namespace
+
+void Install()
+{
+  ps4_overlay_draw = Draw;
+#ifdef USE_RETRO_ACHIEVEMENTS
+  ps4_achievement_unlocked = OnAchievementUnlocked;
+  ps4_achievement_login = OnAchievementLogin;
+  ps4_achievement_game = OnAchievementGame;
+#endif
+  State::PS4SetLoadResultCallback([](State::PS4Slot result, const std::string& made_by) {
+    {
+      std::lock_guard lock(s_mutex);
+      s_load_made_by = made_by;
+    }
+    s_load_result = result;
+    s_load_done = true;
+  });
+  std::thread(Watchdog).detach();
+}
+
+bool ReturnToXMB()
+{
+  return s_quit;
+}
+
+bool RestartGame()
+{
+  return s_quit && s_restart;
+}
+}  // namespace PS4IngameMenu
+
+// IOS ES / STM (Core/IOS/ES/ES.cpp, Core/IOS/STM/STM.cpp), any thread: a game chose "Wii Menu"
+// or power off in its HOME Menu.
+extern "C" void ps4_request_quit_to_menu()
+{
+  PS4IngameMenu::s_quit_requested = true;
+}
+
+namespace PS4IngameMenu
+{
+
+void Poll(Core::System& system)
+{
+  s_polls++;
+  static bool s_jit_notice = false;
+  if (ps4_jit_unavailable && !s_jit_notice && s_polls > 120)
+  {
+    s_jit_notice = true;
+    Toast("This console doesn't allow Dolphin's fast CPU mode (JIT): games run slowly.", 9000);
+  }
+  if (s_saving_slot != 0 && ps4_state_busy == 0)
+  {
+    Toast("Saved to slot " + std::to_string(s_saving_slot));
+    Log("saved state " + std::to_string(s_saving_slot));
+    s_saving_slot = 0;
+  }
+  if (s_load_done.exchange(false))
+  {
+    const State::PS4Slot result = s_load_result;
+    std::string made_by;
+    {
+      std::lock_guard lock(s_mutex);
+      made_by = s_load_made_by;
+    }
+    Log("state " + std::to_string(s_loading_slot) + " load result " +
+        std::to_string(int(result)));
+    Toast(SlotProblem(s_loading_slot, result, made_by),
+          result == State::PS4Slot::Ready ? 2200 : 6000);
+    if (result == State::PS4Slot::Broken && !s_broken)
+    {
+      s_broken = true;
+      s_broken_time = Clock::now();
+    }
+  }
+  if (s_broken)
+  {
+    // The game can't go on (its CPU thread has stopped): show why, then restart into the XMB.
+    // No Core::Stop: it would wait for that thread forever.
+    if (Clock::now() - s_broken_time > std::chrono::seconds(5))
+    {
+      Log("state load failed halfway: restarting into the XMB");
+      ps4_return_to_menu();
+      sceSystemServiceLoadExec(ps4_self_path(), nullptr);
+    }
+    ps4_overlay_repaint = 1;
+    system.GetFifo().PS4WakeGpu();
+    return;
+  }
+  if (s_quit_requested.exchange(false) && !s_quit)
+    QuitToXMB(system, "the game asked for the Wii Menu, a reset or power off: quit to the XMB");
+  if (s_quit)
+  {
+    // The clean stop normally ends the main loop quickly; don't wait forever on it.
+    if (Clock::now() - s_quit_time > std::chrono::seconds(6))
+    {
+      Log(s_restart ? "stop took too long, restarting the game" :
+                      "stop took too long, restarting into the XMB");
+      if (s_restart)
+        ps4_relaunch_game();
+      else
+        ps4_return_to_menu();
+      sceSystemServiceLoadExec(ps4_self_path(), nullptr);
+    }
+    return;
+  }
+  if (ps4_pad_handle < 0)
+    return;
+  OrbisPadData data = {};
+  if (scePadReadState(ps4_pad_handle, &data) != 0 || !data.connected)
+    return;
+  const uint32_t held = data.buttons;
+  const uint32_t pressed = held & ~s_held;
+  s_held = held;
+  bool open;
+  {
+    std::lock_guard lock(s_mutex);
+    open = s_open;
+  }
+  // Play time: running with the menu closed (at most half a second per poll, so a stall or a
+  // console sleep adds nothing), written every minute.
+  {
+    const Clock::time_point now = Clock::now();
+    if (s_play_last != Clock::time_point{} && !open &&
+        Core::GetState(system) == Core::State::Running)
+    {
+      s_play_pending += std::min(0.5, std::chrono::duration<double>(now - s_play_last).count());
+    }
+    s_play_last = now;
+    {
+      // The game's progress banner: when RetroAchievements answered (the demo: at the start),
+      // after a moment for the game's badge to download.
+      static bool s_banner_pending = false, s_demo_banner = false;
+      static Clock::time_point s_banner_when, s_banner_try;
+      if (s_ach_game_ready.exchange(false) || (DemoMode() && !s_demo_banner))
+      {
+        s_demo_banner = true;
+        s_banner_pending = true;
+        s_banner_when = s_banner_try = now;
+      }
+      // After 1.5 s (the game badge's download), then every second while RetroAchievements
+      // still reports the game as loading; given up after 15 s.
+      if (s_banner_pending && now - s_banner_when > std::chrono::milliseconds(1500) &&
+          now - s_banner_try >= std::chrono::seconds(1))
+      {
+        s_banner_try = now;
+        if (ShowProgressBanner())
+        {
+          s_banner_pending = false;
+        }
+        else if (now - s_banner_when > std::chrono::seconds(15))
+        {
+          s_banner_pending = false;
+          Log("achievements: banner skipped: the game's achievements never finished loading");
+        }
+      }
+    }
+    {
+      // ps4.ini crash_test=on: the game crashes 20 s in (a write to address 0), to try the crash
+      // handler's way back to the game list.
+      static int s_crash_test = -1;
+      static Clock::time_point s_crash_start;
+      if (s_crash_test < 0)
+      {
+        s_crash_test = Platform::GetPS4Option("crash_test", "off") == "on";
+        s_crash_start = now;
+      }
+      if (s_crash_test > 0 && now - s_crash_start > std::chrono::seconds(20))
+      {
+        Log("crash_test: crashing now");
+        *static_cast<volatile int*>(nullptr) = 1;
+      }
+    }
+    if (DemoMode() && now - s_demo_last > std::chrono::seconds(25))
+    {
+      s_demo_last = now;
+      DemoUnlockNext();
+    }
+    if (s_ach_dirty.exchange(false))
+      SaveAchievements();
+    if (now - s_play_flushed > std::chrono::seconds(60))
+    {
+      s_play_flushed = now;
+      FlushPlayTime();
+      SaveAchievements();
+    }
+  }
+
+  // Releasing every button ends the post-menu input block.
+  if (ps4_pad_block && !open && held == 0)
+    ps4_pad_block = 0;
+
+  constexpr uint32_t COMBO = ORBIS_PAD_BUTTON_L3 | ORBIS_PAD_BUTTON_R3;
+  const bool combo = (held & COMBO) == COMBO && (pressed & COMBO);
+  if (!open)
+  {
+    if (combo && Core::GetState(system) == Core::State::Running)
+    {
+      s_last_action = "open";
+      Open(system);
+    }
+    else if (!ps4_pad_block && Core::GetState(system) == Core::State::Running)
+    {
+      CheckHotkeys(system, held, pressed);
+    }
+  }
+  else if (!s_capture_key.empty())
+  {
+    UpdateCapture(held);
+  }
+  else if (s_ctl_capture_row >= 0)
+  {
+    UpdateControlCapture(data);
+  }
+  else
+  {
+    // Directions repeat while held.
+    uint32_t nav = pressed;
+    constexpr uint32_t DIRS = ORBIS_PAD_BUTTON_UP | ORBIS_PAD_BUTTON_DOWN |
+                              ORBIS_PAD_BUTTON_LEFT | ORBIS_PAD_BUTTON_RIGHT;
+    if (held & DIRS)
+    {
+      if (pressed & DIRS)
+      {
+        s_repeat = 0.35f;
+      }
+      else
+      {
+        s_repeat -= 1.0f / 60.0f;
+        if (s_repeat <= 0.0f)
+        {
+          nav |= held & DIRS;
+          s_repeat = 0.08f;
+        }
+      }
+    }
+    bool rebuild = false;
+    if (nav & ORBIS_PAD_BUTTON_UP)
+    {
+      SelectableMove(-1);
+      rebuild = true;
+    }
+    if (nav & ORBIS_PAD_BUTTON_DOWN)
+    {
+      SelectableMove(1);
+      rebuild = true;
+    }
+    if (nav & (ORBIS_PAD_BUTTON_LEFT | ORBIS_PAD_BUTTON_RIGHT))
+    {
+      const int direction = (nav & ORBIS_PAD_BUTTON_LEFT) ? -1 : 1;
+      // Main page: Left/Right pick the slot, on Save State and Load State only.
+      if (s_page == Page::Main)
+      {
+        const int item = s_main_items[s_main_selected];
+        if (item == MAIN_SAVE || item == MAIN_LOAD)
+          s_slot = (s_slot - 1 + direction + 8) % 8 + 1;
+        else if (item == MAIN_WII_EXTENSION || item == MAIN_WII_SIDEWAYS || item == MAIN_WII_TILT)
+          ToggleWiiRemote(item, direction);
+      }
+      else
+      {
+        ChangeSetting(s_settings_selected, direction);
+      }
+      s_last_action = "change";
+      rebuild = true;
+    }
+    if (pressed & ORBIS_PAD_BUTTON_CROSS)
+    {
+      s_last_action = "activate";
+      Log("activate " +
+          std::to_string(s_page == Page::Main ? s_main_selected : s_settings_selected));
+      Activate(system);
+      rebuild = true;
+    }
+    else if (combo)
+    {
+      Close(system);
+    }
+    else if (pressed & ORBIS_PAD_BUTTON_CIRCLE)
+    {
+      if (s_page != Page::Main)
+      {
+        s_page = Page::Main;
+        rebuild = true;
+      }
+      else
+      {
+        Close(system);
+      }
+    }
+    if (rebuild && !s_quit)
+      BuildRows();
+  }
+
+  // While the menu is open (or a toast is showing) the paused frame is redrawn with it.
+  bool redraw;
+  {
+    std::lock_guard lock(s_mutex);
+    redraw = s_open || s_appear > 0.01f || Clock::now() < s_toast_until;
+  }
+  if (redraw)
+  {
+    ps4_overlay_repaint = 1;
+    system.GetFifo().PS4WakeGpu();
+  }
+}
+}  // namespace PS4IngameMenu
