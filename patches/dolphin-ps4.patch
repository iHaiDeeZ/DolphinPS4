+void Menu::ApplySettingOption(int setting, int option)
+{
+  switch (setting)
+  {
+  case SET_SOUNDS:
+    m_prefs.sounds = option == 0;
+    break;
+  case SET_VOLUME:
+    m_prefs.volume = 100 - option * 10;
+    break;
+  case SET_CLOCK:
+    m_prefs.clock = option == 0;
+    break;
+  case SET_AUTO_UPDATE:
+    m_prefs.auto_update = option == 0;
+    break;
+  case SET_LANGUAGE:
+    if (option >= 0 && option < static_cast<int>(PS4Lang::All().size()))
+      SetLanguage(PS4Lang::All()[option].code);
+    m_first_language = false;
+    break;
+  case SET_STYLE:
+    m_prefs.style = option == 1 ? "xmb" : option == 2 ? "gamecube" : option == 3 ? "wii" : "library";
+    Log("menu style: " + m_prefs.style);
+    break;
+  case SET_RESET_ALL:
+    if (option == 1)
+      PS4Settings::ResetAll();
+    return;
+  case SET_CONTROLS:
+    OpenControlsList(option == 0 ? PS4Controls::Device::GameCube : PS4Controls::Device::Wii);
+    return;
+  default:
+    return;
+  }
+  ApplyPreferences();
+  BuildItems();
+}
+
+void Menu::HandleInput(uint32_t pressed)
+{
+  if (m_launch >= 0 || pressed == 0)
+    return;
+
+  if (m_capture || !m_combo_key.empty() || m_ime_purpose)
+    return;  // a button capture or the system keyboard takes the pad
+  if (m_panel.open)
+  {
+    if (pressed & BTN_CIRCLE)
+    {
+      if (m_first_language && m_panel.setting == SET_LANGUAGE)
+      {
+        // The first start's language list closed without a choice: the highlighted one.
+        ApplySettingOption(SET_LANGUAGE, m_panel.selected);
+      }
+      if (m_panel.setting == SET_UPDATE && m_update_state == UpdateState::Downloading)
+        m_update_cancel = true;
+      m_controls_device = -1;
+      m_controls_game.clear();
+      PS4Controls::EditGame("");  // a game's own layout is only edited while its page is open
+      m_panel.open = false;
+      Play("back");
+      return;
+    }
+    if (!m_panel.rows.empty())
+    {
+      // Settings list: Up/Down pick, Left/Right (or Cross) change the value.
+      if (pressed & BTN_UP)
+      {
+        MoveSettingRow(-1);
+        Play("move");
+      }
+      if (pressed & BTN_DOWN)
+      {
+        MoveSettingRow(1);
+        Play("move");
+      }
+      if (pressed & (BTN_LEFT | BTN_RIGHT | BTN_CROSS))
+      {
+        ChangeSettingRow((pressed & BTN_LEFT) ? -1 : (pressed & BTN_CROSS) ? 2 : 1);
+        Play("category");
+      }
+      return;
+    }
+    if (m_panel.options.empty())
+    {
+      if (pressed & BTN_CROSS)
+      {
+        m_panel.open = false;
+        Play("back");
+      }
+      return;
+    }
+    const int count = static_cast<int>(m_panel.options.size());
+    if ((pressed & BTN_UP) && m_panel.selected > 0)
+    {
+      m_panel.selected--;
+      Play("move");
+    }
+    if ((pressed & BTN_DOWN) && m_panel.selected < count - 1)
+    {
+      m_panel.selected++;
+      Play("move");
+    }
+    if ((pressed & BTN_CROSS) && m_panel.title == "Delete Game" && m_delete_game >= 0 &&
+        m_delete_game < static_cast<int>(m_games.size()))
+    {
+      const Game game = m_games[m_delete_game];
+      m_delete_game = -1;
+      if (m_panel.options[m_panel.selected] != "Yes")
+      {
+        m_panel.open = false;
+        Play("back");
+        return;
+      }
+      // Every disc of the game (the list shows one entry for all of them).
+      std::vector<std::string> paths;
+      for (const auto& disc : m_scan(GamesFolder()))
+      {
+        if (game.id.empty() ? disc.path == game.path :
+                              disc.game_id == game.id && disc.revision == game.revision)
+          paths.push_back(disc.path);
+      }
+      if (paths.empty())
+        paths.push_back(game.path);
+      std::string failed;
+      for (const std::string& path : paths)
+      {
+        std::error_code ec;
+        if (std::filesystem::remove(path, ec) && !ec)
+          Log("deleted " + path);
+        else
+          failed = std::filesystem::path(path).filename().string() + ": " + ec.message();
+      }
+      if (m_prefs.default_game == game.path)
+      {
+        m_prefs.default_game.clear();
+        m_prefs.Save(m_data_dir + "/xmb.ini");
+      }
+      RefreshGames();
+      m_panel = {};
+      m_panel.open = true;
+      m_panel.title = "Delete Game";
+      if (failed.empty())
+        m_panel.lines = {"", game.title, "", "Deleted."};
+      else
+        m_panel.lines = {"", "Couldn't delete", failed};
+      Play(failed.empty() ? "confirm" : "back");
+      return;
+    }
+    if ((pressed & BTN_CROSS) && m_panel.title == "Recommended Settings" &&
+        m_center_ask_game >= 0 && m_center_ask_game < static_cast<int>(m_games.size()))
+    {
+      const int game = m_center_ask_game;
+      m_center_ask_game = -1;
+      const bool use = m_panel.options[m_panel.selected] == "Yes";
+      PS4Center::SetChoice(m_games[game].id, use);
+      Log("game settings center: " + m_games[game].id + (use ? " yes" : " no"));
+      m_panel.open = false;
+      Item item;
+      item.game = game;
+      ActivateItem(item);  // answered: starts now
+      return;
+    }
+    if ((pressed & BTN_CROSS) && m_panel.setting == SET_UPDATE)
+    {
+      const std::string& choice = m_panel.options[m_panel.selected];
+      if (choice == "Yes")
+      {
+        StartUpdateDownload();
+        Play("confirm");
+      }
+      else if (choice == "Cancel")
+      {
+        m_update_cancel = true;
+        Play("back");
+      }
+      else if (choice == "Restart Now")
+      {
+        m_update_restart = true;
+        m_quit = true;
+        Play("confirm");
+      }
+      else if (choice == "Close Dolphin")
+      {
+        m_update_exit = true;
+        m_quit = true;
+        Play("confirm");
+      }
+      else
+      {
+        m_panel.open = false;
+        Play("back");
+      }
+      return;
+    }
+    // Settings: Square unbinds the selected hotkey.
+    if ((pressed & BTN_SQUARE) && !m_capture && m_combo_key.empty() &&
+        m_panel.selected >= 0 && m_panel.selected < static_cast<int>(m_panel.rows.size()) &&
+        PS4Settings::IsHotkey(m_panel.rows[m_panel.selected].key))
+    {
+      PS4Settings::Set(m_panel.rows[m_panel.selected].key, "off", {});
+      Log("hotkey " + m_panel.rows[m_panel.selected].key + "=off");
+      BuildSettingRows();
+      Play("back");
+      return;
+    }
+    // Controls: Square clears the selected button's mapping (it then does nothing).
+    if ((pressed & BTN_SQUARE) && m_panel.setting == SET_CONTROLS && !m_capture &&
+        m_panel.selected < static_cast<int>(m_panel.rows.size()) &&
+        m_panel.rows[m_panel.selected].key.rfind("ctl:", 0) == 0)
+    {
+      const auto device = static_cast<PS4Controls::Device>(m_controls_device);
+      const auto& binding =
+          PS4Controls::Bindings(device)[std::atoi(m_panel.rows[m_panel.selected].key.c_str() + 4)];
+      if (!binding.stick_group)
+      {
+        PS4Controls::Set(device, binding, "");
+        BuildControlRows();
+        Log(std::string("controls: cleared ") + binding.label);
+        Play("back");
+        return;
+      }
+    }
+    if (pressed & BTN_CROSS)
+    {
+      if (m_panel.setting == SET_CONTROLS)
+      {
+        ApplySettingOption(m_panel.setting, m_panel.selected);
+        Play("confirm");
+        return;
+      }
+      if (m_panel.setting >= 0)
+      {
+        ApplySettingOption(m_panel.setting, m_panel.selected);
+      }
+      else if (m_panel.title == "Game" && m_panel.selected == 0)
+      {
+        m_panel.open = false;
+        HandleInput(BTN_CROSS);  // start it, as Cross on the game does
+        return;
+      }
+      else if (m_panel.title == "Game" && m_panel.selected == 1)
+      {
+        const Item& item = m_items[m_category][m_selected[m_category]];
+        OpenSettingsList({}, m_games[item.game].id);
+        Play("confirm");
+        return;
+      }
+      else if (m_panel.title == "Game" && m_panel.selected == 2)
+      {
+        const Item& item = m_items[m_category][m_selected[m_category]];
+        OpenCheatsList(m_games[item.game]);
+        Play("confirm");
+        return;
+      }
+      else if (m_panel.title == "Game" && m_panel.options[m_panel.selected] == "Controls")
+      {
+        const Item& item = m_items[m_category][m_selected[m_category]];
+        const Game& game = m_games[item.game];
+        OpenControlsList(game.wii ? PS4Controls::Device::Wii : PS4Controls::Device::GameCube, game.id);
+        Play("confirm");
+        return;
+      }
+      else if (m_panel.title == "Game" &&
+               m_panel.options[m_panel.selected] == "Play Online (Wiimmfi)")
+      {
+        const Item& item = m_items[m_category][m_selected[m_category]];
+        m_wiimmfi_game = item.game;
+        // Wiimmfi's login is a secure connection with the Wii's own client certificate, which
+        // comes from the Wii system software (Settings -> Wii Menu -> Install from Nintendo).
+        const std::string wii_root = m_data_dir + "/User/Wii";
+        if (!std::filesystem::exists(wii_root + "/clientca.pem") &&
+            !DiscIO::NANDImporter().ExtractCertificates())
+        {
+          Log("play online: no online certificates (IOS13 not installed)");
+          m_panel = {};
+          m_panel.open = true;
+          m_panel.title = "Play Online (Wiimmfi)";
+          m_panel.lines = {"",
+                           "Online play needs the Wii's system software first.",
+                           "",
+                           "Go to Settings -> Wii Menu -> Install from Nintendo, wait until it "
+                           "says Installed, then choose Play Online again.",
+                           "",
+                           "Circle closes this."};
+          Play("error");
+          return;
+        }
+        if (std::filesystem::exists(WiimmfiPatcherPath()))
+        {
+          LaunchWiimmfi();
+          return;
+        }
+        m_panel = {};
+        m_panel.open = true;
+        m_panel.title = "Play Online (Wiimmfi)";
+        m_panel.lines = {"", "Downloading the Wiimmfi Patcher", "(Open Shop Channel)..."};
+        StartWiimmfiDownload();
+        Play("menu");
+        return;
+      }
+      else if (m_panel.title == "Game" && m_panel.options[m_panel.selected] == "Delete Game")
+      {
+        const Item& item = m_items[m_category][m_selected[m_category]];
+        const Game& game = m_games[item.game];
+        m_delete_game = item.game;
+        m_panel = {};
+        m_panel.open = true;
+        m_panel.title = "Delete Game";
+        m_panel.lines = {"", game.title, "",
+                         game.discs > 1 ? std::to_string(game.discs) + " discs" :
+                                          std::filesystem::path(game.path).filename().string(),
+                         "", "Delete it from the console?", "This can't be undone."};
+        m_panel.options = {"No", "Yes"};
+        Play("menu");
+        return;
+      }
+      else if (m_panel.title == "Game" && m_panel.options[m_panel.selected] == "Achievements")
+      {
+        const Item& item = m_items[m_category][m_selected[m_category]];
+        OpenAchievementList(m_games[item.game]);
+        Play("confirm");
+        return;
+      }
+      else if (m_panel.title == "Game" && m_panel.options[m_panel.selected] == "Patches")
+      {
+        const Item& item = m_items[m_category][m_selected[m_category]];
+        OpenPatchesList(m_games[item.game]);
+        Play("confirm");
+        return;
+      }
+      else if (m_panel.title == "Game" && m_panel.options[m_panel.selected] == "Graphics Mods")
+      {
+        const Item& item = m_items[m_category][m_selected[m_category]];
+        OpenGraphicsModsList(m_games[item.game]);
+        Play("confirm");
+        return;
+      }
+      else if (m_panel.title == "Game" && m_panel.options[m_panel.selected] == "Riivolution Patches")
+      {
+        const Item& item = m_items[m_category][m_selected[m_category]];
+        OpenRiivolutionList(m_games[item.game]);
+        Play("confirm");
+        return;
+      }
+      else if (m_panel.title == "Game" && m_panel.selected == 4)
+      {
+        // One default game: setting another replaces it, the same game again removes it.
+        const Item& item = m_items[m_category][m_selected[m_category]];
+        const Game& game = m_games[item.game];
+        const bool remove = m_prefs.default_game == game.path;
+        m_prefs.default_game = remove ? "" : game.path;
+        m_prefs.Save(m_data_dir + "/xmb.ini");
+        Log(remove ? "default game removed" : "default game: " + game.path);
+        BuildItems();
+        m_panel.title = remove ? "Remove Default ISO" : "Set as Default ISO";
+        m_panel.options.clear();
+        if (remove)
+          m_panel.lines = {"", "No game starts by itself anymore."};
+        else
+          m_panel.lines = {"", game.title, "", "starts when Dolphin opens.", "",
+                           "Hold L1 while Dolphin starts", "to open the menu instead."};
+        Play("confirm");
+        return;
+      }
+      else if (m_panel.title == "Game" && m_panel.selected == 3)
+      {
+        const Item& item = m_items[m_category][m_selected[m_category]];
+        const Game& game = m_games[item.game];
+        m_panel.title = "Information";
+        m_panel.options.clear();
+        m_panel.lines = {game.title,
+                         "",
+                         std::string("Platform: ") +
+                             (game.homebrew ? (game.wii ? "Homebrew (Wii)" : "Homebrew (GameCube)") :
+                              game.wad      ? "Wii (WiiWare / Virtual Console / channel)" :
+                              game.wii      ? "Wii" :
+                                              "GameCube"),
+                         "Game ID: " + game.id,
+                         "Discs: " + std::to_string(game.discs),
+                         "Play time: " + (PS4PlayTime::Text(PlayTime(game)).empty() ?
+                                              std::string("None yet") :
+                                              PS4PlayTime::Text(PlayTime(game))),
+                         "Achievements: " + (AchievementText(game).empty() ?
+                                                 std::string("None yet") :
+                                                 AchievementText(game)),
+                         "File: " + std::filesystem::path(game.path).filename().string()};
+        Play("confirm");
+        return;
+      }
+      m_panel.open = false;
+      Play("confirm");
+    }
+    return;
+  }
+
+  auto& items = m_items[m_category];
+  int& selected = m_selected[m_category];
+  const int count = static_cast<int>(items.size());
+  const bool games = m_category == static_cast<int>(Category::Games);
+  // XMB: Left / Right switch the columns, Up / Down the items, L1 / R1 jump five.
+  // Library: L1 / R1 switch the tabs; the games scroll sideways, the other tabs up and down.
+  int prev_category = m_category > 0 ? m_category - 1 : -1;
+  int next_category = m_category < CATEGORY_COUNT - 1 ? m_category + 1 : -1;
+  uint32_t prev_tab = BTN_LEFT, next_tab = BTN_RIGHT, prev_item = BTN_UP, next_item = BTN_DOWN;
+  uint32_t prev_page = BTN_L1, next_page = BTN_R1;
+  if (Library())
+  {
+    const int tab = LibraryTab();
+    prev_category = tab > 0 ? static_cast<int>(TABS[tab - 1]) : -1;
+    next_category = tab < TAB_COUNT - 1 ? static_cast<int>(TABS[tab + 1]) : -1;
+    prev_tab = BTN_L1;
+    next_tab = BTN_R1;
+    prev_item = games ? BTN_LEFT : BTN_UP;
+    next_item = games ? BTN_RIGHT : BTN_DOWN;
+    prev_page = next_page = 0;
+    if (games && m_prefs.style == "gamecube")
+    {
+      prev_item = BTN_UP | BTN_LEFT;
+      next_item = BTN_DOWN | BTN_RIGHT;
+    }
+  }
+  // Wii style: Up / Down move a row of the grid (four channels).
+  const bool wii_grid = games && Library() && m_prefs.style == "wii";
+  if ((pressed & prev_tab) && prev_category >= 0)
+  {
+    m_category = prev_category;
+    Play("category");
+  }
+  else if ((pressed & next_tab) && next_category >= 0)
+  {
+    m_category = next_category;
+    Play("category");
+  }
+  else if (wii_grid && (pressed & BTN_UP))
+  {
+    if (selected >= 4)
+    {
+      selected -= 4;
+      Play("move");
+    }
+  }
+  else if (wii_grid && (pressed & BTN_DOWN))
+  {
+    if (selected / 4 < (count - 1) / 4)
+    {
+      selected = std::min(count - 1, selected + 4);
+      Play("move");
+    }
+  }
+  else if ((pressed & prev_item) && selected > 0)
+  {
+    selected--;
+    Play("move");
+  }
+  else if ((pressed & next_item) && selected < count - 1)
+  {
+    selected++;
+    Play("move");
+  }
+  else if ((pressed & prev_page) && selected > 0)
+  {
+    selected = std::max(0, selected - 5);
+    Play("move");
+  }
+  else if ((pressed & next_page) && selected < count - 1)
+  {
+    selected = std::min(count - 1, selected + 5);
+    Play("move");
+  }
+  else if (pressed & BTN_CROSS)
+  {
+    if (!items.empty())
+      ActivateItem(items[selected]);
+  }
+  else if ((pressed & BTN_SQUARE) && games)
+  {
+    RefreshGames();
+    Play("confirm");
+  }
+  else if ((pressed & BTN_OPTIONS) && games && Library())
+  {
+    // The next game order; the selected game stays selected.
+    size_t sort = 0;
+    while (sort < std::size(SORT_NAMES) && m_prefs.sort != SORT_NAMES[sort][0])
+      sort++;
+    m_prefs.sort = SORT_NAMES[(sort + 1) % std::size(SORT_NAMES)][0];
+    m_prefs.Save(m_data_dir + "/xmb.ini");
+    const int game = items.empty() ? -1 : items[selected].game;
+    BuildItems();
+    const auto& sorted = m_items[m_category];
+    for (size_t i = 0; i < sorted.size(); i++)
+    {
+      if (game >= 0 && sorted[i].game == game)
+        m_selected[m_category] = static_cast<int>(i);
+    }
+    m_item_pos[m_category] = static_cast<float>(m_selected[m_category]);
+    m_sort_shown = 2.5f;
+    Play("category");
+  }
+  else if (pressed & BTN_TRIANGLE)
+  {
+    if (!items.empty() && items[selected].game >= 0)
+    {
+      m_panel = {};
+      m_panel.open = true;
+      m_panel.title = "Game";
+      m_panel.options = {"Start", "Game Settings", "Cheats", "Information",
+                         m_prefs.default_game == m_games[items[selected].game].path ?
+                             "Remove Default ISO" :
+                             "Set as Default ISO"};
+      if (m_games[items[selected].game].wii && !m_games[items[selected].game].homebrew &&
+          !m_games[items[selected].game].wad)
+      {
+        m_panel.options.push_back("Riivolution Patches");
+        m_panel.options.push_back("Play Online (Wiimmfi)");
+      }
+      m_panel.options.push_back("Controls");
+      m_panel.options.push_back("Graphics Mods");
+      m_panel.options.push_back("Patches");
+      {
+        const Game& game = m_games[items[selected].game];
+        if (PS4Achievements::Load(m_data_dir, game.id.empty() ? game.title : game.id, nullptr))
+          m_panel.options.push_back("Achievements");
+      }
+      m_panel.options.push_back("Delete Game");
+      Play("menu");
+    }
+  }
+  else if (pressed & BTN_CIRCLE)
+  {
+    Play("back");
+  }
+}
+
+// A disc image whose header couldn't be read (no game ID): damaged, incomplete or not a disc.
+static bool UnreadableDisc(const Game& game)
+{
+  if (!game.id.empty() || game.wad || game.homebrew)
+    return false;
+  std::string ext = std::filesystem::path(game.path).extension().string();
+  for (char& c : ext)
+    c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+  return ext == ".iso" || ext == ".gcm" || ext == ".rvz" || ext == ".wia" || ext == ".wbfs" ||
+         ext == ".ciso" || ext == ".gcz" || ext == ".tgc";
+}
+
+// Cross on an item (both styles).
+void Menu::ActivateItem(const Item& item)
+{
+  if (item.game >= 0 && UnreadableDisc(m_games[item.game]))
+  {
+    const Game& game = m_games[item.game];
+    Log("game list: unreadable game file " + game.path);
+    m_panel = {};
+    m_panel.open = true;
+    m_panel.title = "Something Is Wrong With This Game File";
+    m_panel.lines = {std::filesystem::path(game.path).filename().string(),
+                     "",
+                     "Dolphin couldn't read it. The file is damaged, incomplete, or not a GameCube / Wii game.",
+                     "",
+                     "Check it in PC Dolphin (right-click > Properties > Verify) or convert it "
+                     "again, then copy it to the PS4 again.",
+                     "",
+                     "Circle closes this."};
+    Play("error");
+    return;
+  }
+  if (!item.ach_key.empty())
+  {
+    OpenAchievementKey(item.ach_key);
+    Play("menu");
+    return;
+  }
+  if (item.game >= 0 && CenterFor(m_games[item.game].id) &&
+      PS4Center::Choice(m_games[item.game].id).empty())
+  {
+    AskCenter(item.game);
+    return;
+  }
+  if (item.game >= 0)
+  {
+    m_launch = item.game;
+    m_launch_time = 0.0f;
+    m_prefs.last_game = m_games[item.game].path;
+    m_prefs.Save(m_data_dir + "/xmb.ini");
+    m_played[m_games[item.game].path] = static_cast<int64_t>(std::time(nullptr));
+    SavePlayed();
+    Play("launch");
+  }
+  else if (item.setting >= 0)
+  {
+    OpenSettingPanel(item.setting);
+    Play("menu");
+  }
+  else if (item.theme != -1)
+  {
+    if (item.theme >= 0)
+    {
+      m_prefs.theme = THEMES[item.theme].name;
+      m_prefs.wallpaper.clear();
+    }
+    else
+    {
+      m_prefs.wallpaper = m_wallpapers[-2 - item.theme];
+    }
+    ApplyPreferences();
+    BuildItems();
+    Play("confirm");
+  }
+  else if (item.card == CARD_NEW)
+  {
+    CreateCard();
+  }
+  else if (item.card >= 0)
+  {
+    OpenCardPanel(item.card);
+    Play("menu");
+  }
+  else
+  {
+    Play("error");
+  }
+}
+
+int Menu::LibraryTab() const
+{
+  for (int i = 0; i < TAB_COUNT; i++)
+  {
+    if (static_cast<int>(TABS[i]) == m_category)
+      return i;
+  }
+  return 0;
+}
+
+std::string Menu::SortName() const
+{
+  for (const auto& [key, name] : SORT_NAMES)
+  {
+    if (m_prefs.sort == key)
+      return name;
+  }
+  return SORT_NAMES[0][1];
+}
+
+// data_dir/played.ini: "<Unix time> <game path>" per line.
+void Menu::LoadPlayed()
+{
+  std::ifstream file(m_data_dir + "/played.ini");
+  std::string line;
+  while (std::getline(file, line))
+  {
+    while (!line.empty() && (line.back() == '\r' || line.back() == ' '))
+      line.pop_back();
+    const size_t space = line.find(' ');
+    if (space != std::string::npos && space > 0)
+      m_played[line.substr(space + 1)] = std::atoll(line.c_str());
+  }
+}
+
+void Menu::SavePlayed() const
+{
+  std::ofstream file(m_data_dir + "/played.ini", std::ios::trunc);
+  for (const auto& [path, when] : m_played)
+    file << when << ' ' << path << '\n';
+}
+
+// ---------------------------------------------------------------------------------------------
+// Memory cards.
+
+void Menu::LoadCards()
+{
+  for (auto& icons : m_card_icons)
+  {
+    for (ImTextureID icon : icons)
+    {
+      if (icon != ImTextureID{})
+        m_display.DestroyTexture(icon);
+    }
+  }
+  m_card_icons.clear();
+  m_cards = PS4MemoryCards::List(m_data_dir, true);
+  m_slot_a = PS4MemoryCards::SlotA(m_data_dir);
+  size_t saves = 0;
+  for (const PS4MemoryCards::Card& card : m_cards)
+  {
+    std::vector<ImTextureID> icons;
+    for (const PS4MemoryCards::Save& save : card.saves)
+    {
+      icons.push_back(save.icon.empty() ?
+                          ImTextureID{} :
+                          m_display.CreateTexture(save.icon.data(),
+                                                  32, 32));
+    }
+    saves += card.saves.size();
+    m_card_icons.push_back(std::move(icons));
+  }
+  Log("memory cards: " + std::to_string(m_cards.size()) + " cards, " + std::to_string(saves) +
+      " saves, " + m_slot_a + " in Slot A");
+}
+
+ImTextureID Menu::SaveIcon(int card, int save) const
+{
+  if (card < 0 || card >= static_cast<int>(m_card_icons.size()) || save < 0 ||
+      save >= static_cast<int>(m_card_icons[card].size()))
+  {
+    return ImTextureID{};
+  }
+  return m_card_icons[card][save];
+}
+
+// A card's panel: Slot A, then its saves with their icons (details under the list).
+void Menu::OpenCardPanel(int index)
+{
+  if (index < 0 || index >= static_cast<int>(m_cards.size()))
+    return;
+  const PS4MemoryCards::Card& card = m_cards[index];
+  m_panel = {};
+  m_panel.open = true;
+  m_panel.setting = SET_MEMCARD;
+  m_panel.title = card.name;
+  m_card_panel = index;
+  std::vector<SettingRow> rows;
+  if (card.name == m_slot_a)
+    rows.push_back({"In Slot A", "In use", "card:in"});
+  else
+    rows.push_back({"Put in Slot A", "", "card:use"});
+  const size_t count = card.saves.size();
+  rows.push_back({std::to_string(count) + (count == 1 ? " Save" : " Saves") + "  -  " +
+                      std::to_string(card.blocks) + " blocks",
+                  "", "", true});
+  if (count == 0)
+    rows.push_back({"No saves on this card yet", "", "", true});
+  for (size_t i = 0; i < count; i++)
+  {
+    const PS4MemoryCards::Save& save = card.saves[i];
+    SettingRow row{save.title, std::to_string(save.blocks) + (save.blocks == 1 ? " block" : " blocks"),
+                   "save:" + std::to_string(i)};
+    row.icon = SaveIcon(index, static_cast<int>(i));
+    rows.push_back(row);
+  }
+  m_panel.rows = std::move(rows);
+  m_panel.selected = 0;
+  MoveSettingRow(0);
+}
+
+void Menu::CreateCard()
+{
+  std::string error;
+  const std::string name = PS4MemoryCards::Create(m_data_dir, &error);
+  if (name.empty())
+  {
+    Log("memory cards: " + error);
+    m_panel = {};
+    m_panel.open = true;
+    m_panel.title = "New Memory Card";
+    m_panel.lines = {"", error};
+    Play("error");
+    return;
+  }
+  Log("memory cards: created " + name);
+  LoadCards();
+  BuildItems();
+  auto& cards = m_items[static_cast<int>(Category::MemoryCards)];
+  for (size_t i = 0; i < cards.size(); i++)
+  {
+    if (cards[i].card >= 0 && m_cards[cards[i].card].name == name)
+    {
+      m_selected[static_cast<int>(Category::MemoryCards)] = static_cast<int>(i);
+      OpenCardPanel(cards[i].card);
+    }
+  }
+  Play("confirm");
+}
