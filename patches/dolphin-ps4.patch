+void Menu::OpenSettingPanel(int setting)
+{
+  m_panel = {};
+  m_panel.open = true;
+  m_panel.setting = setting;
+  switch (setting)
+  {
+  case SET_SOUNDS:
+    m_panel.title = "Sound Effects";
+    m_panel.options = {"On", "Off"};
+    m_panel.selected = m_prefs.sounds ? 0 : 1;
+    break;
+  case SET_VOLUME:
+    m_panel.title = "Volume";
+    for (int v = 100; v >= 0; v -= 10)
+      m_panel.options.push_back(std::to_string(v));
+    m_panel.selected = (100 - m_prefs.volume) / 10;
+    break;
+  case SET_CLOCK:
+    m_panel.title = "Clock";
+    m_panel.options = {"On", "Off"};
+    m_panel.selected = m_prefs.clock ? 0 : 1;
+    break;
+  case SET_CONTROLS:
+    m_panel.title = "Controls";
+    m_panel.options = {PS4Controls::DeviceName(PS4Controls::Device::GameCube),
+                       PS4Controls::DeviceName(PS4Controls::Device::Wii)};
+    break;
+  case SET_COVERS:
+    m_panel.title = "Download Covers";
+    StartCoverDownload();
+    break;
+  case SET_GAMES_DIR:
+    OpenFolderBrowser(GamesFolder());
+    return;
+  case SET_UPDATE_CHECK:
+    m_panel.setting = SET_UPDATE;
+    StartUpdateCheck(true);
+    ShowUpdatePanel();
+    break;
+  case SET_AUTO_UPDATE:
+    m_panel.title = "Automatic Updates";
+    m_panel.options = {"On", "Off"};
+    m_panel.selected = m_prefs.auto_update ? 0 : 1;
+    m_panel.lines = {"", "Looks for a new version on GitHub", "when the app opens, and asks",
+                     "before installing it."};
+    break;
+  case SET_RESET_ALL:
+    m_panel.title = "Reset All Settings";
+    m_panel.options = {"Cancel", "Reset everything"};
+    m_panel.lines = {"", "All games, global and per game,", "go back to the default settings."};
+    break;
+  case SET_ABOUT:
+    m_panel.title = "About";
+    m_panel.lines = {"Dolphin for PS4",
+                     "GameCube and Wii emulator",
+                     "Ported to PS4 by ShiroKlein",
+                     "Version " + m_version,
+                     "",
+                     "Games: " + m_data_dir + "/games",
+                     "Wallpapers (PNG): " + m_data_dir + "/themes",
+                     "Sounds (WAV): " + m_data_dir + "/themes/sounds",
+                     "",
+                     "Dolphin is free software (GPLv2+).",
+                     "Font: Nunito (SIL Open Font License)."};
+    break;
+  default:
+    if (setting >= SET_GROUP &&
+        setting < SET_GROUP + static_cast<int>(PS4Settings::Categories().size()))
+    {
+      OpenSettingsList(PS4Settings::Categories()[setting - SET_GROUP], {});
+      return;
+    }
+    m_panel.open = false;
+  }
+}
