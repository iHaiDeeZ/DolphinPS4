+extern "C" void ps4_draw_counter(int width, int height, float fps, float speed_percent);
+
+// The same FPS / speed counter for the other backends (Vulkan): seven-segment digits as region
+// clears of the bound backbuffer (AbstractGfx::ClearRegion, colour 0xAARRGGBB).
+static void PS4DrawCounterGeneric(int height, float fps, float speed_percent)
+{
+  const auto rect = [](int x, int y, int w, int h, u32 color) {
+    g_gfx->ClearRegion(MathUtil::Rectangle<int>(x, y, x + w, y + h), true, true, false, color, 0);
+  };
+  // Segments a..g: top, top right, bottom right, bottom, bottom left, top left, middle.
+  static constexpr u8 digits[10] = {0x3F, 0x06, 0x5B, 0x4F, 0x66, 0x6D, 0x7D, 0x07, 0x7F, 0x6F};
+  const int u = std::max(2, height / 200);  // segment thickness
+  const int dw = 4 * u, dh = 7 * u, advance = dw + 2 * u;
+
+  char fps_text[16], speed_text[16];
+  snprintf(fps_text, sizeof(fps_text), "%.1f", fps);
+  snprintf(speed_text, sizeof(speed_text), "%d", static_cast<int>(speed_percent + 0.5f));
+  const int chars = static_cast<int>(std::strlen(fps_text) + std::strlen(speed_text)) + 1;
+  const int x0 = 6 * u, y0 = 6 * u;
+  rect(x0 - 2 * u, y0 - 2 * u, chars * advance + 3 * u, dh + 4 * u, 0xFF000000);
+
+  int x = x0;
+  const auto draw_text = [&](const char* text, u32 color) {
+    for (const char* c = text; *c; c++, x += advance)
+    {
+      if (*c == '.')
+      {
+        rect(x + u, y0 + dh - u, u, u, color);
+        x -= advance / 2;
+        continue;
+      }
+      if (*c < '0' || *c > '9')
+        continue;
+      const u8 seg = digits[*c - '0'];
+      const int half = dh / 2;
+      if (seg & 0x01) rect(x, y0, dw, u, color);                          // a
+      if (seg & 0x02) rect(x + dw - u, y0, u, half + 1, color);           // b
+      if (seg & 0x04) rect(x + dw - u, y0 + half, u, dh - half, color);   // c
+      if (seg & 0x08) rect(x, y0 + dh - u, dw, u, color);                 // d
+      if (seg & 0x10) rect(x, y0 + half, u, dh - half, color);            // e
+      if (seg & 0x20) rect(x, y0, u, half + 1, color);                    // f
+      if (seg & 0x40) rect(x, y0 + half - u / 2, dw, u, color);           // g
+    }
+  };
+  draw_text(fps_text, 0xFFFFFFFF);
+  x += advance / 2;
+  draw_text(speed_text, 0xFFFFD91A);
+}
