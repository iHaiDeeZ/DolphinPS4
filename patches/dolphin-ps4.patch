+static void PS4FlipThread()
+{
+  ps4_boot_trace("display: flip thread started");
+  for (;;)
+  {
+    PS4PendingFlip flip;
+    {
+      std::unique_lock lock(s_flip_mutex);
+      s_flip_cv.wait(lock, [] { return !s_flip_queue_items.empty(); });
+      flip = s_flip_queue_items.front();
+      s_flip_queue_items.pop_front();
