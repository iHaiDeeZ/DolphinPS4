+++ b/Source/Core/DolphinNoGUI/PS4Covers.cpp
@@ -0,0 +1,239 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "DolphinNoGUI/PS4Covers.h"
+
+#include <cstdio>
+#include <cstring>
+#include <sys/stat.h>
+
+#include <curl/curl.h>
+#include <orbis/Net.h>
+#include <orbis/Sysmodule.h>
+
+extern "C" void ps4_boot_trace(const char* line);  // port/ps4_crashlog.cpp
+
+namespace PS4Covers
+{
+namespace
+{
+constexpr const char* HOST = "art.gametdb.com";
+
+void Log(const std::string& text)
+{
+  fprintf(stderr, "[covers] %s\n", text.c_str());
+  ps4_boot_trace(("covers: " + text).c_str());
+}
+
+bool Exists(const std::string& path)
+{
+  struct stat st;
+  return stat(path.c_str(), &st) == 0 && st.st_size > 0;
+}
+
+// The PS4's network: libSceNet and its resolver (the C library's getaddrinfo has no DNS
+// configuration on the PS4). Returns GameTDB's address as text, or empty.
+std::string ResolveHost(std::string* error)
+{
+  static bool s_net = false;
+  static int s_pool = -1;
+  if (!s_net)
+  {
+    sceSysmoduleLoadModuleInternal(ORBIS_SYSMODULE_INTERNAL_NET);
+    const int init = sceNetInit();
+    s_pool = sceNetPoolCreate("dolphin-covers", 64 * 1024, 0);
+    char line[96];
+    snprintf(line, sizeof(line), "network: init %#x, pool %#x", static_cast<unsigned>(init),
+             static_cast<unsigned>(s_pool));
+    Log(line);
+    s_net = true;
+  }
+  const OrbisNetId resolver = sceNetResolverCreate("dolphin-covers", s_pool, 0);
+  if (resolver < 0)
+  {
+    *error = "the PS4 network is not available";
+    return {};
+  }
+  OrbisNetInAddr address = {};
+  const int result = sceNetResolverStartNtoa(resolver, HOST, &address, 5 * 1000 * 1000, 2, 0);
+  sceNetResolverDestroy(resolver);
+  if (result < 0)
+  {
+    char line[96];
+    snprintf(line, sizeof(line), "could not look up %s (%#x): is the PS4 online?", HOST,
+             static_cast<unsigned>(result));
+    *error = line;
+    return {};
+  }
+  const uint32_t a = address.s_addr;  // network byte order
+  char text[32];
+  snprintf(text, sizeof(text), "%u.%u.%u.%u", a & 0xFF, (a >> 8) & 0xFF, (a >> 16) & 0xFF,
+           (a >> 24) & 0xFF);
+  return text;
+}
+
+size_t Append(char* data, size_t size, size_t count, void* user)
+{
+  static_cast<std::string*>(user)->append(data, size * count);
+  return size * count;
+}
+
+// GET url into body; returns the HTTP status (0: no answer).
+long Fetch(CURL* curl, const std::string& url, std::string* body, std::string* error)
+{
+  body->clear();
+  char detail[CURL_ERROR_SIZE] = {};
+  curl_easy_setopt(curl, CURLOPT_ERRORBUFFER, detail);
+  curl_easy_setopt(curl, CURLOPT_URL, url.c_str());
+  curl_easy_setopt(curl, CURLOPT_WRITEDATA, body);
+  CURLcode code = curl_easy_perform(curl);
+  if (code == CURLE_PEER_FAILED_VERIFICATION || code == CURLE_SSL_CACERT_BADFILE ||
+      code == CURLE_SSL_CERTPROBLEM)
+  {
+    // The PS4's TLS library rejects GameTDB's certificate chain. Covers are public pictures
+    // (and checked to be PNGs before they are saved): fetch them without the check.
+    static bool s_logged = false;
+    if (!s_logged)
+    {
+      Log(std::string("certificate check failed (") + detail + "), downloading without it");
+      s_logged = true;
+    }
+    curl_easy_setopt(curl, CURLOPT_SSL_VERIFYPEER, 0L);
+    curl_easy_setopt(curl, CURLOPT_SSL_VERIFYHOST, 0L);
+    body->clear();
+    code = curl_easy_perform(curl);
+  }
+  if (code != CURLE_OK)
+  {
+    *error = std::string(curl_easy_strerror(code)) + (detail[0] ? std::string(": ") + detail : "");
+    return 0;
+  }
+  long status = 0;
+  curl_easy_getinfo(curl, CURLINFO_RESPONSE_CODE, &status);
+  return status;
+}
+
+// GameTDB's regions for a game ID's region letter (4th character), most likely first.
+std::vector<const char*> Regions(const std::string& id)
+{
+  const char region = id.size() >= 4 ? id[3] : 'E';
+  switch (region)
+  {
+  case 'E':
+  case 'N':
+    return {"US", "EN"};
+  case 'J':
+    return {"JA", "US"};
+  case 'K':
+  case 'Q':
+  case 'T':
+    return {"KO", "US"};
+  case 'D':
+    return {"DE", "EN", "US"};
+  case 'F':
+    return {"FR", "EN", "US"};
+  case 'S':
+    return {"ES", "EN", "US"};
+  case 'I':
+    return {"IT", "EN", "US"};
+  case 'H':
+    return {"NL", "EN", "US"};
+  case 'R':
+    return {"RU", "EN", "US"};
+  default:  // P, X, Y, ...: PAL
+    return {"EN", "US"};
+  }
+}
+}  // namespace
+
+Result Download(const std::vector<std::string>& game_ids, const std::string& covers_dir,
+                const std::string& ca_file,
+                const std::function<void(int, int, const std::string&)>& progress,
+                const std::atomic<bool>& cancel)
+{
+  Result result;
+  mkdir(covers_dir.c_str(), 0777);
+
+  std::vector<std::string> missing;
+  for (const std::string& id : game_ids)
+  {
+    if (id.empty())
+      continue;
+    if (Exists(covers_dir + "/" + id + ".png"))
+      result.already++;
+    else
+      missing.push_back(id);
+  }
+  if (missing.empty())
+    return result;
+
+  const std::string address = ResolveHost(&result.error);
+  if (address.empty())
+  {
+    result.failed = static_cast<int>(missing.size());
+    Log(result.error);
+    return result;
+  }
+  Log(std::string(HOST) + " is " + address);
+
+  curl_global_init(CURL_GLOBAL_DEFAULT);
+  CURL* curl = curl_easy_init();
+  const std::string resolve = std::string(HOST) + ":443:" + address;
+  curl_slist* resolves = curl_slist_append(nullptr, resolve.c_str());
+  curl_easy_setopt(curl, CURLOPT_RESOLVE, resolves);
+  curl_easy_setopt(curl, CURLOPT_CAINFO, ca_file.c_str());
+  curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 1L);
+  curl_easy_setopt(curl, CURLOPT_TIMEOUT, 20L);
+  curl_easy_setopt(curl, CURLOPT_CONNECTTIMEOUT, 10L);
+  curl_easy_setopt(curl, CURLOPT_USERAGENT, "Dolphin-PS4");
+  curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, Append);
+  curl_easy_setopt(curl, CURLOPT_NOSIGNAL, 1L);
+
+  for (size_t i = 0; i < missing.size() && !cancel; i++)
+  {
+    const std::string& id = missing[i];
+    progress(static_cast<int>(i), static_cast<int>(missing.size()), id);
+    bool saved = false, answered = false;
+    std::string body, error;
+    for (const char* region : Regions(id))
+    {
+      const std::string url = "https://" + std::string(HOST) + "/wii/cover/" + region + "/" + id +
+                              ".png";
+      const long status = Fetch(curl, url, &body, &error);
+      if (status == 0)
+        break;  // network trouble: don't try the other regions
+      answered = true;
+      if (status == 200 && body.size() > 8 && body.compare(1, 3, "PNG") == 0)
+      {
+        const std::string path = covers_dir + "/" + id + ".png";
+        if (FILE* file = fopen(path.c_str(), "wb"))
+        {
+          fwrite(body.data(), 1, body.size(), file);
+          fclose(file);
+          saved = true;
+        }
+        break;
+      }
+    }
+    if (saved)
+    {
+      result.downloaded++;
+    }
+    else if (answered)
+    {
+      result.not_found++;
+      Log("no cover for " + id);
+    }
+    else
+    {
+      result.failed++;
+      result.error = error;
+      Log("download failed for " + id + ": " + error);
+    }
+  }
+  progress(static_cast<int>(missing.size()), static_cast<int>(missing.size()), {});
+  curl_slist_free_all(resolves);
+  curl_easy_cleanup(curl);
+  return result;
+}
+}  // namespace PS4Covers
diff --git a/Source/Core/DolphinNoGUI/PS4Covers.h b/Source/Core/DolphinNoGUI/PS4Covers.h
new file mode 100755
index 0000000..d02913e
