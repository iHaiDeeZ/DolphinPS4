+// ---------------------------------------------------------------------------------------------
+// Preferences (data_dir/xmb.ini, "key=value" lines).
+
+struct Preferences
+{
+  std::string theme = THEMES[0].name;
+  std::string wallpaper;  // file name in data_dir/themes, empty = the theme's waves
+  bool sounds = true;
+  int volume = 80;
+  bool clock = true;
+  bool auto_update = true;  // look for a new version on GitHub when the app opens
+  std::string games_dir;    // Settings -> Game Folder; empty = data_dir/games
+  std::string last_game;
+
+  void Load(const std::string& path)
+  {
+    std::ifstream file(path);
+    std::string line;
+    while (std::getline(file, line))
+    {
+      while (!line.empty() && (line.back() == '\r' || line.back() == ' '))
+        line.pop_back();
+      const size_t eq = line.find('=');
+      if (eq == std::string::npos)
+        continue;
+      const std::string key = line.substr(0, eq), value = line.substr(eq + 1);
+      if (key == "theme")
+        theme = value;
+      else if (key == "wallpaper")
+        wallpaper = value;
+      else if (key == "sounds")
+        sounds = value == "on";
+      else if (key == "volume")
+        volume = std::clamp(std::atoi(value.c_str()), 0, 100);
+      else if (key == "clock")
+        clock = value == "on";
+      else if (key == "auto_update")
+        auto_update = value == "on";
+      else if (key == "games_dir")
+        games_dir = value;
+      else if (key == "last_game")
+        last_game = value;
+    }
+  }
+  void Save(const std::string& path) const
+  {
+    std::ofstream file(path, std::ios::trunc);
+    file << "# Dolphin XMB preferences (edited by the menu)\n";
+    file << "theme=" << theme << "\nwallpaper=" << wallpaper << "\nsounds="
+         << (sounds ? "on" : "off") << "\nvolume=" << volume << "\nclock="
+         << (clock ? "on" : "off") << "\nauto_update=" << (auto_update ? "on" : "off")
+         << "\ngames_dir=" << games_dir << "\nlast_game=" << last_game << "\n";
+  }
+};
